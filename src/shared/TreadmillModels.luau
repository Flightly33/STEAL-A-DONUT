--[[
	TreadmillModels: what every treadmill is made of - GENERATED by art/treadmills/treadmills.py (a
	Blender script that also renders them all). Don't edit this file: change the treadmills there and
	run it again.

	Models[tier name] = { Parts, Groups, Vfx }, in treadmill space (studs; y up from the ground, the
	console at -z, the belt 6 x 13 with its top at 1.5, centred on z = 0.5).
	A part: Shape (Block unless said: Cylinder runs along X, Ball, Wedge), Pos, Size, Rot (degrees, like
	CFrame.Angles), Color, Material (an Enum.Material name; SmoothPlastic unless said), Transparency,
	Collide (only the deck and belt), Tag (Belt, Slat, LED, Screen, Rainbow, Flicker), Index (slats and
	LEDs, in order), Group (it turns with that group).
	Groups[name] = { Pivot, Axis (X / Y / Z of the pivot), Idle, Run (how fast, standing / while someone
	runs), Mode (Spin: turns, radians a second; Swing: rocks Amp degrees to and fro; Wobble: rattles),
	Amp, Dir (+1 / -1: which way a swing goes first) }.
	Vfx: the effects (built by server/TreadmillFX, animated by client/Treadmill). Idle / Run: how strong
	standing still / while the owner runs (particles a second, brightness, size, seconds; 0 = off).
	  Emit: Preset (TreadmillFX.Presets), Pos, Area (a box, or a sphere with Shape = Sphere), Colors,
	        Size, Dir (the way they fly: Top, Bottom, Front, Back...), Boost (allowed more particles),
	        Every / EveryIdle (bursts: seconds between them, running / standing)
	  Beam: From, To, Colors, Width, Width1, Style (Ray: a soft shaft of light; Arc: crackling
	        electricity; Strike: a lightning bolt every Every seconds while running), Transparency
	  Light: Pos, Color, Range, Idle, Run, Flicker, Spot (a turning spotlight, Angle)
	  Pulse: Pos, Color, Radius, Idle, Run (seconds a ring takes to spread; 0 = off), Phase
	  Fire: Pos, Color, Idle, Run (its size);  Sparkles: Pos, Color
]]

export type Part = {
	Shape: string?,
	Name: string?,
	Pos: Vector3,
	Size: Vector3,
	Rot: Vector3?,
	Color: Color3,
	Material: string?,
	Transparency: number?,
	Collide: boolean?,
	Tag: string?,
	Index: number?,
	Group: string?,
}
export type Group = { Pivot: CFrame, Axis: string, Idle: number, Run: number, Mode: string?, Amp: number?, Dir: number? }
export type Vfx = {
	Kind: string,
	Preset: string?,
	Pos: Vector3?,
	Area: Vector3?,
	Shape: string?,
	Colors: { Color3 }?,
	Color: Color3?,
	Size: number?,
	Idle: number?,
	Run: number?,
	Dir: string?,
	Boost: boolean?,
	Every: number?,
	EveryIdle: number?,
	From: Vector3?,
	To: Vector3?,
	Width: number?,
	Width1: number?,
	Style: string?,
	Transparency: number?,
	Range: number?,
	Flicker: boolean?,
	Spot: boolean?,
	Angle: number?,
	Radius: number?,
	Phase: number?,
	Group: string?,
}
export type Model = { Parts: { Part }, Groups: { [string]: Group }, Vfx: { Vfx } }

