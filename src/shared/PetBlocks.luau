--[[
	PetBlocks: what every pet is made of - GENERATED by art/studded_pets/studded_pets.py (a Blender
	script that also renders them all). Don't edit this file: change the pets there and run it again.

	Shapes[body plan] = { Blocks, Anchors }; Features[feature][body plan] = blocks. A block is a box
	(Pos, Size, Rot in degrees like CFrame.Angles) or a rod (From, To, Thick). Color: a colour, or a
	role PetModel fills in from the pet (Body, Accent, Pale, Shade, AccentLight, Snout, ShellPlate).
	Studs: studs on its top (every StudPitch). Limb: the client swings it. Eye / Pupil: blinking.
	Only / Unless: a feature the pet must / mustn't have for this block.
]]

export type Block = {
	Name: string,
	Pos: Vector3?,
	Size: Vector3?,
	Rot: Vector3?,
	From: Vector3?,
	To: Vector3?,
	Thick: number?,
	Color: Color3 | string,
	Material: string?,
	Studs: boolean?,
	Limb: { Kind: string, Side: number, Pivot: Vector3 }?,
	Eye: boolean?,
	Pupil: boolean?,
	Transparency: number?,
	Only: string?,
	Unless: string?,
}

