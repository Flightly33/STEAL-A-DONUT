	Saturation = 0.2,
	Contrast = 0.22,
	Ambient = Color3.fromRGB(95, 75, 150),
	AtmosphereColor = Color3.fromRGB(110, 60, 190),
	AtmosphereDensity = 0.2,
	Haze = 0.3,
	Bloom = 0.85,
})

