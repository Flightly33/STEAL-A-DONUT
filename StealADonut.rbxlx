-- Tell the server the UI is listening (it then sends the welcome-back popup, etc.)
require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Remotes")).Event("ClientReady"):FireServer()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">AreaTracker</string>
            <string name="Source"><![CDATA[--[[
	Tracks which area the local player is standing in (0 = safe hub).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Layout)
local Signal = require(Shared.Signal)

local player = Players.LocalPlayer :: Player

local AreaTracker = {}
AreaTracker.Current = -1
AreaTracker.Changed = Signal.new() -- (newArea, oldArea)

function AreaTracker.Position(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

task.spawn(function()
	while true do
		local position = AreaTracker.Position()
		if position then
			local area = Layout.AreaAt(position)
			if area ~= AreaTracker.Current then
				local old = AreaTracker.Current
				AreaTracker.Current = area
				AreaTracker.Changed:Fire(area, old)
			end
		end
		task.wait(0.2)
	end
end)

return AreaTracker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Bases</string>
            <string name="Source"><![CDATA[--[[
	Bases: find base plots in the map from the client. Every world's hub has the same plots, and the
	local player's base is in the world they're in (player attributes PlotIndex + BaseWorld).
]]

local Players = game:GetService("Players")

local player = Players.LocalPlayer :: Player

local Bases = {}

function Bases.GetPlot(plotIndex: any, worldId: any): Model?
	local map = workspace:FindFirstChild("Map")
	if not map or type(plotIndex) ~= "number" then
		return nil
	end
	local world = if type(worldId) == "number" then worldId else 1
	local plots: Instance? = nil
	if world == 1 then
		plots = map:FindFirstChild("Plots")
	else
		local worlds = map:FindFirstChild("Worlds")
		local hub = worlds and worlds:FindFirstChild("World" .. world)
		plots = hub and hub:FindFirstChild("Plots")
	end
	local plot = plots and plots:FindFirstChild("Plot" .. plotIndex)
	return if plot and plot:IsA("Model") then plot else nil
end

-- The local player's base plot right now.
function Bases.Mine(): Model?
	return Bases.GetPlot(player:GetAttribute("PlotIndex"), player:GetAttribute("BaseWorld"))
end

return Bases
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">BlackHoleFX</string>
            <string name="Source"><![CDATA[--[[
	BlackHoleFX: brings the black holes (server/BlackHoleModel) to life on the client.
	  * the lens rings (the photon ring and the light bent round the shadow) turn to face your camera
	  * hot spots orbit in the disk, the inner ones faster
	  * the swirl of infalling sparks and dust turns (the sparks are locked to it, so they spiral in)
	  * the glow breathes
	  * the lab's containment rings spin and wobble, and its containment reading flickers
	  * in The Black Hole the colour grading throbs slowly, as if space itself were pulsing
	Only black holes the camera is near enough to see are animated.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local AreaTracker = require(script.Parent.AreaTracker)

local BlackHoleFX = {}

local AREA = 34 -- The Black Hole
local VIEW_DISTANCE = 2500
local LAB_DISTANCE = 300

type Spot = { Part: BasePart, Radius: number, Angle: number, Speed: number }
type Hole = {
	Center: Vector3,
	Disk: CFrame,
	Lens: BasePart?,
	Inflow: BasePart?,
	Spin: number,
	Spots: { Spot },
	Glow: PointLight?,
	GlowBase: number,
}
type Gyro = { Model: Model, Center: Vector3, Tilt: CFrame, Spin: number, Precess: number }

local function track<T>(tag: string, onAdd: (Instance) -> T?): { [Instance]: T }
	local set: { [Instance]: T } = {}
	local function add(instance: Instance)
		local value = onAdd(instance)
		if value ~= nil and instance.Parent then
			set[instance] = value
		end
	end
	for _, instance in CollectionService:GetTagged(tag) do
		task.spawn(add, instance)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance)
		set[instance] = nil
	end)
	return set
end

local function number(instance: Instance, name: string): number
	local value = instance:GetAttribute(name)
	return if type(value) == "number" then value else 0
end

-- A frame at `center` whose -Z looks at `target`, with Y as close to `up` as it can be.
local function facing(center: Vector3, target: Vector3, up: Vector3): CFrame
	local look = target - center
	if look.Magnitude < 0.01 then
		return CFrame.new(center)
	end
	local back = -look.Unit
	local right = up:Cross(back)
	if right.Magnitude < 0.01 then
		right = Vector3.zAxis:Cross(back)
	end
	right = right.Unit
	return CFrame.fromMatrix(center, right, back:Cross(right), back)
end

local function addHole(instance: Instance): Hole?
	if not instance:IsA("Model") then
		return nil
	end
	local core = instance:WaitForChild("Core", 10)
	local frame = instance:WaitForChild("DiskFrame", 10)
	if not (core and core:IsA("BasePart") and frame and frame:IsA("BasePart")) then
		return nil
	end
	local lens = instance:FindFirstChild("Lens")
	local inflow = instance:FindFirstChild("Inflow")
	local glow = core:FindFirstChild("Glow")
	local spots: { Spot } = {}
	for _, child in instance:GetChildren() do
		if child:IsA("BasePart") and child.Name == "HotSpot" then
			table.insert(spots, { Part = child, Radius = number(child, "Radius"), Angle = number(child, "Angle"), Speed = number(child, "Speed") })
		end
	end
	return {
		Center = core.Position,
		Disk = frame.CFrame,
		Lens = if lens and lens:IsA("BasePart") then lens else nil,
		Inflow = if inflow and inflow:IsA("BasePart") then inflow else nil,
		Spin = if inflow then number(inflow, "Spin") else 0,
		Spots = spots,
		Glow = if glow and glow:IsA("PointLight") then glow else nil,
		GlowBase = if glow and glow:IsA("PointLight") then glow.Brightness else 0,
	}
end

local function addGyro(instance: Instance): Gyro?
	if not instance:IsA("Model") then
		return nil
	end
	local hub = instance.PrimaryPart or instance:WaitForChild("Hub", 10)
	if not hub or not hub:IsA("BasePart") then
		return nil
	end
	instance.PrimaryPart = hub
	local pivot = hub.CFrame
	return { Model = instance, Center = pivot.Position, Tilt = pivot - pivot.Position, Spin = number(instance, "Spin"), Precess = number(instance, "Precess") }
end

function BlackHoleFX.Init()
	local holes: { [Instance]: Hole } = track("BlackHole", addHole)
	local gyros: { [Instance]: Gyro } = track("GyroRing", addGyro)
	local readouts: { [Instance]: TextLabel } = track("LabReadout", function(instance): TextLabel?
		return if instance:IsA("TextLabel") then instance else nil
	end)

	-- Space throbbing in The Black Hole (fades in and out as you arrive and leave)
	local pulse = Instance.new("ColorCorrectionEffect")
	pulse.Name = "GravityPulse"
	pulse.Enabled = false
	pulse.Parent = Lighting
	local strength = 0

	local nextReading = 0
	RunService.RenderStepped:Connect(function(dt: number)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local cam = camera.CFrame.Position
		local t = os.clock()

		for model, hole in holes do
			if not model.Parent then
				holes[model] = nil
				continue
			end
			if (hole.Center - cam).Magnitude > VIEW_DISTANCE then
				continue
			end
			if hole.Lens then
				hole.Lens.CFrame = facing(hole.Center, cam, hole.Disk.UpVector)
			end
			for _, spot in hole.Spots do
				spot.Part.CFrame = hole.Disk * CFrame.Angles(0, spot.Angle + t * spot.Speed, 0) * CFrame.new(spot.Radius, 0, 0)
			end
			if hole.Inflow then
				hole.Inflow.CFrame = hole.Disk * CFrame.Angles(0, t * hole.Spin, 0)
			end
			if hole.Glow then
				hole.Glow.Brightness = hole.GlowBase * (1 + 0.18 * math.sin(t * 1.7))
			end
		end

		-- The lab (under the floor): containment rings and the flickering reading
		for model, gyro in gyros do
			if not model.Parent then
				gyros[model] = nil
			elseif cam.Y < gyro.Center.Y + 40 and (gyro.Center - cam).Magnitude < LAB_DISTANCE then
				gyro.Model:PivotTo(CFrame.new(gyro.Center) * CFrame.Angles(0, t * gyro.Precess, 0) * gyro.Tilt * CFrame.Angles(0, t * gyro.Spin, 0))
			end
		end
		if t >= nextReading then
			nextReading = t + 0.4
			for label in readouts do
				local text = label :: TextLabel
				local reading = 96 + math.random() * 3.9
				text.Text = string.format("CONTAINMENT FIELD: %.1f%%", reading)
				text.TextColor3 = if reading < 97 then Color3.fromRGB(255, 210, 0) else Color3.fromRGB(80, 255, 170)
			end
		end

		local target = if AreaTracker.Current == AREA then 1 else 0
		strength += (target - strength) * math.min(1, dt * 1.5)
		pulse.Enabled = strength > 0.01
		if pulse.Enabled then
			local wave = math.sin(t * 1.1)
			pulse.Contrast = strength * (0.05 + 0.05 * wave)
			pulse.Saturation = strength * 0.06 * math.sin(t * 1.1 + 1)
			pulse.TintColor = Color3.new(1, 1 - strength * 0.03 * (1 + wave), 1)
		end
	end)
end

return BlackHoleFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">ChatTags</string>
            <string name="Source"><![CDATA[--[[
	Chat tags: players with a donor title (from tipping, see ProductService) get it in front of
	their name in chat, in the title's colour, e.g. "[Ultimate Donor] Flightly33: hi".
	The server sets the "DonorTitle" / "DonorTitleColor" attributes on each player.
]]

local Players = game:GetService("Players")

local ChatTags = {}

function ChatTags.Init()
	local ok, TextChatService = pcall(game.GetService, game, "TextChatService")
	if not ok or not TextChatService then
		return
	end
	(TextChatService :: TextChatService).OnIncomingMessage = function(message: TextChatMessage): TextChatMessageProperties?
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local sender = if source then Players:GetPlayerByUserId(source.UserId) else nil
		local title = if sender then sender:GetAttribute("DonorTitle") else nil
		if sender and type(title) == "string" then
			local color = sender:GetAttribute("DonorTitleColor")
			local hex = if typeof(color) == "Color3" then color:ToHex() else "ff8ad0"
			properties.PrefixText = `<font color="#{hex}">[{title}]</font> {message.PrefixText}`
		end
		return properties
	end
end

return ChatTags
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">DonutFX</string>
            <string name="Source"><![CDATA[--[[
	DonutFX: the moving parts of the mystical donut themes (see FXThemes.luau), animated by every client
	for the rare donuts near its camera - in the lane, on bases, on podiums and on players' heads:
	  * lightning: crackling arcs (Secret / Rainbow), bolts rising from the ground (Mythic),
	    strikes from the sky with a shockwave (Divine)
	  * magic circles on the ground: rings, dashed arcs and glyphs turning in opposite directions
	  * comets with glowing trails orbiting the donut
	  * shockwaves bursting along the ground
	  * pulsing lights (a heartbeat for Mythic, rainbow for Secret / Rainbow), glowing outlines,
	    spinning light rays, and the donut itself changing colour (galaxy, rainbow, throbbing red)
	Everything here exists only on this client (nothing is replicated) and is removed again when you
	walk away. Only the closest donuts get the full show.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local FXThemes = require(Shared.FXThemes)

local DonutFX = {}

local player = Players.LocalPlayer :: Player
local RANGE = 170 -- studs from the camera
local MAX_ACTIVE = 14 -- closest donuts that get lightning, circles and comets
local MAX_OUTLINES = 6 -- Roblox can only draw a limited number of outlines at once
local MAX_BOLTS = 40
local TAU = math.pi * 2
local FLAT = CFrame.Angles(math.rad(90), 0, 0) -- lays a cylinder adornment flat on the ground

type Theme = FXThemes.Theme

type ThemeState = { Theme: Theme, Index: number, NextBolt: number, NextWave: number }

type Spinner = { Adornment: GuiBase3d, Base: CFrame, Speed: number, Theme: Theme, Hue: number, Pulse: boolean? }

type Wisp = { Part: BasePart, Trail: Trail, Axis: CFrame, Radius: number, Speed: number, Offset: number, Theme: Theme, Hue: number }

type Wave = { Adornment: CylinderHandleAdornment, Start: number, Theme: Theme, Scale: number }

type Visuals = {
	Folder: Folder,
	Anchor: BasePart?,
	Spinners: { Spinner },
	Wisps: { Wisp },
	Waves: { Wave },
	Outline: Highlight?,
}

type FX = {
	Model: Model,
	Root: BasePart,
	Scale: number,
	Ground: CFrame?, -- where the magic circle goes (nil while a donut is being carried)
	Themes: { ThemeState },
	Light: PointLight?,
	LightBrightness: number,
	LightColor: Color3,
	Bursts: { { Weld: Weld, Base: CFrame, Spin: number } },
	Frosting: { BasePart },
	FrostingColors: { Color3 },
	Dough: { BasePart },
	DoughColors: { Color3 },
	Tint: string?,
	Pulse: string?,
	OutlineTheme: Theme?,
	Visuals: Visuals?,
	Distance: number,
}

type Bolt = { Parts: { BasePart }, Light: PointLight, Born: number }

local fxs: { [Model]: FX } = {}
local bolts: { Bolt } = {}
local boltPool: { BasePart } = {}
local folder: Folder
local rng = Random.new()
local clock = 0

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------
local function heartbeat(t: number): number
	local u = t % 1.15
	return math.exp(-(u / 0.07) ^ 2) + 0.75 * math.exp(-((u - 0.25) / 0.07) ^ 2)
end

local function themeColor(theme: Theme, index: number, hue: number): Color3
	if theme.Rainbow then
		return Color3.fromHSV((clock * 0.18 + hue) % 1, 0.7, 1)
	end
	return theme.Colors[(index - 1) % #theme.Colors + 1]
end

local function randomColor(theme: Theme): Color3
	if theme.Rainbow then
		return Color3.fromHSV(rng:NextNumber(), 0.75, 1)
	end
	return theme.Colors[rng:NextInteger(1, #theme.Colors)]
end

local function localPart(name: string, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

--------------------------------------------------------------------------------
-- Lightning
--------------------------------------------------------------------------------
local function takeBoltPart(): BasePart
	local p = table.remove(boltPool)
	if p then
		return p
	end
	local part = localPart("Bolt", folder)
	part.Transparency = 1
	return part
end

local function spawnBolt(from: Vector3, to: Vector3, color: Color3, width: number, branch: boolean, flash: number)
	local direction = to - from
	local distance = direction.Magnitude
	if distance < 0.2 or #bolts >= MAX_BOLTS then
		return
	end
	local right = direction:Cross(Vector3.yAxis)
	if right.Magnitude < 0.01 then
		right = direction:Cross(Vector3.xAxis)
	end
	right = right.Unit
	local up = right:Cross(direction).Unit
	local segments = math.clamp(math.floor(distance / 0.9), 4, 12)
	local parts = {}
	local previous = from
	for i = 1, segments do
		local point = if i == segments
			then to
			else from + direction * (i / segments) + (right * rng:NextNumber(-1, 1) + up * rng:NextNumber(-1, 1)) * distance * 0.08
		local step = point - previous
		local part = takeBoltPart()
		part.Size = Vector3.new(width, width, step.Magnitude + width * 0.5)
		part.CFrame = CFrame.lookAt(previous + step / 2, point)
		part.Color = color
		part.Transparency = 0
		table.insert(parts, part)
		if branch and i == segments // 2 and rng:NextNumber() < 0.7 then
			spawnBolt(point, point + rng:NextUnitVector() * distance * 0.35, color, width * 0.6, false, 0)
		end
		previous = point
	end
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10 + flash * 12
	light.Brightness = 3 + flash * 3
	light.Shadows = false
	light.Parent = parts[#parts]
	table.insert(bolts, { Parts = parts, Light = light, Born = clock })
end

local function updateBolts()
	for i = #bolts, 1, -1 do
		local bolt = bolts[i]
		local age = clock - bolt.Born
		if age > 0.17 then
			for _, part in bolt.Parts do
				part.Transparency = 1
				table.insert(boltPool, part)
			end
			bolt.Light:Destroy()
			table.remove(bolts, i)
		else
			-- flicker: on, dim, on, fade
			local transparency = if age < 0.05 then 0 elseif age < 0.08 then 0.7 elseif age < 0.13 then 0 else 0.5
			for _, part in bolt.Parts do
				part.Transparency = transparency
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Magic circles, comets, shockwaves
--------------------------------------------------------------------------------
local function ring(anchor: BasePart, radius: number, width: number, angle: number, color: Color3, transparency: number): CylinderHandleAdornment
	local a = Instance.new("CylinderHandleAdornment")
	a.Adornee = anchor
	a.Radius = radius
	a.InnerRadius = math.max(0, radius - width)
	a.Height = 0.05
	a.Angle = angle
	a.Color3 = color
	a.Transparency = transparency
	a.CFrame = FLAT
	a.Parent = anchor
	return a
end

local function buildCircle(fx: FX, visuals: Visuals, anchor: BasePart, state: ThemeState)
	local theme = state.Theme
	local sc = fx.Scale
	local radius = (3.2 + (state.Index - 1) * 1.15) * sc
	local direction = if state.Index % 2 == 0 then -1 else 1
	local function add(adornment: GuiBase3d, base: CFrame, speed: number, hue: number, pulse: boolean?)
		table.insert(visuals.Spinners, { Adornment = adornment, Base = base, Speed = speed * direction, Theme = theme, Hue = hue, Pulse = pulse })
	end
	-- Outer ring + a thin ring around it
	add(ring(anchor, radius, 0.16 * sc, 360, theme.Colors[1], 0.15), CFrame.identity, 0.4, 0)
	add(ring(anchor, radius + 0.3 * sc, 0.06 * sc, 360, themeColor(theme, 2, 0.3), 0.35), CFrame.identity, 0, 0.3)
	-- Dashed ring
	for i = 0, 5 do
		add(ring(anchor, radius - 0.45 * sc, 0.12 * sc, 30, themeColor(theme, 2, i / 6), 0.2), CFrame.Angles(0, 0, i * TAU / 6), -0.7, i / 6)
	end
	-- Inner arcs
	for i = 0, 2 do
		add(ring(anchor, radius - 1.05 * sc, 0.1 * sc, 80, themeColor(theme, 3, i / 3), 0.25), CFrame.Angles(0, 0, i * TAU / 3), 1.1, i / 3)
	end
	-- Glyph marks around the outer ring
	for i = 0, 7 do
		local glyph = Instance.new("BoxHandleAdornment")
		glyph.Adornee = anchor
		glyph.Size = Vector3.new(0.12 * sc, 0.04, 0.5 * sc)
		glyph.Color3 = theme.Colors[1]
		glyph.Transparency = 0.1
		glyph.Parent = anchor
		-- (spinners rotate their Base about the vertical; glyphs sit out on the ring)
		table.insert(visuals.Spinners, {
			Adornment = glyph,
			Base = CFrame.Angles(0, i * TAU / 8, 0) * CFrame.new(0, 0, -(radius - 0.25 * sc)),
			Speed = 0.4 * direction,
			Theme = theme,
			Hue = i / 8,
		})
	end
	-- Soft glow in the middle
	add(ring(anchor, 1.3 * sc, 1.3 * sc, 360, theme.Colors[1], 0.8), CFrame.identity, 0, 0, true)
end

local function buildWisps(fx: FX, visuals: Visuals, state: ThemeState)
	local theme = state.Theme
	local count = theme.Wisps or 0
	local sc = fx.Scale
	for i = 1, count do
		local color = themeColor(theme, i, i / count)
		local part = localPart("Comet", visuals.Folder)
		part.Shape = Enum.PartType.Ball
		part.Size = Vector3.one * 0.32 * sc
		part.Color = color
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.14 * sc, 0)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.14 * sc, 0)
		a1.Parent = part
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.45
		trail.LightEmission = 1
		trail.Brightness = 3
		trail.FaceCamera = true
		trail.Color = ColorSequence.new(color)
		trail.Transparency = NumberSequence.new(0, 1)
		trail.WidthScale = NumberSequence.new(1, 0)
		trail.Parent = part
		table.insert(visuals.Wisps, {
			Part = part,
			Trail = trail,
			Axis = CFrame.Angles(rng:NextNumber(-1, 1), rng:NextNumber(0, TAU), rng:NextNumber(-1, 1)),
			Radius = (2.4 + rng:NextNumber() * 1.1) * sc,
			Speed = (1.6 + rng:NextNumber()) * (if rng:NextNumber() < 0.5 then -1 else 1),
			Offset = i / count * TAU,
			Theme = theme,
			Hue = i / count,
		})
	end
end

local function spawnWave(fx: FX, state: ThemeState)
	local visuals = fx.Visuals
	local anchor = visuals and visuals.Anchor
	if not visuals or not anchor then
		return
	end
	local a = ring(anchor, fx.Scale, 0.3 * fx.Scale, 360, randomColor(state.Theme), 0.15)
	table.insert(visuals.Waves, { Adornment = a, Start = clock, Theme = state.Theme, Scale = fx.Scale })
end

--------------------------------------------------------------------------------
-- Build / drop the per-donut visuals
--------------------------------------------------------------------------------
local function restoreColors(fx: FX)
	if fx.Tint == "Heartbeat" then
		for i, part in fx.Frosting do
			part.Color = fx.FrostingColors[i]
		end
	elseif fx.Tint then
		for i, part in fx.Dough do
			part.Color = fx.DoughColors[i]
		end
	end
end

local function dropVisuals(fx: FX)
	local visuals = fx.Visuals
	if visuals then
		visuals.Folder:Destroy()
		if visuals.Outline then
			visuals.Outline:Destroy()
		end
		fx.Visuals = nil
		restoreColors(fx)
	end
end

local function ensureVisuals(fx: FX)
	if fx.Visuals then
		return
	end
	local visualsFolder = Instance.new("Folder")
	visualsFolder.Name = fx.Model.Name
	visualsFolder.Parent = folder
	local visuals: Visuals = { Folder = visualsFolder, Anchor = nil, Spinners = {}, Wisps = {}, Waves = {}, Outline = nil }
	if fx.Ground then
		local anchor = localPart("CircleAnchor", visualsFolder)
		anchor.Transparency = 1
		anchor.Size = Vector3.one * 0.2
		anchor.CFrame = (fx.Ground :: CFrame) + Vector3.new(0, 0.07, 0)
		visuals.Anchor = anchor
	end
	for _, state in fx.Themes do
		if state.Theme.Runes and visuals.Anchor then
			buildCircle(fx, visuals, visuals.Anchor :: BasePart, state)
		end
		buildWisps(fx, visuals, state)
	end
	fx.Visuals = visuals
end

local function setOutline(fx: FX, wanted: boolean)
	local visuals = fx.Visuals
	if not visuals then
		return
	end
	if wanted and not visuals.Outline and fx.OutlineTheme then
		local highlight = Instance.new("Highlight")
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.FillTransparency = 0.82
		highlight.OutlineTransparency = 0
		highlight.Parent = fx.Model
		visuals.Outline = highlight
	elseif not wanted and visuals.Outline then
		visuals.Outline:Destroy()
		visuals.Outline = nil
	end
end

--------------------------------------------------------------------------------
-- Per-frame updates
--------------------------------------------------------------------------------
-- Cheap things for every rare donut in range: spinning rays and the pulsing light.
local function updateCheap(fx: FX)
	for _, burst in fx.Bursts do
		burst.Weld.C0 = burst.Base * CFrame.Angles(0, 0, (clock * burst.Spin) % TAU)
	end
	local light = fx.Light
	if light then
		local base = fx.LightBrightness
		local pulse = fx.Pulse
		if pulse == "Heartbeat" then
			light.Brightness = base * (0.7 + 2.6 * heartbeat(clock))
		elseif pulse == "Shimmer" then
			light.Brightness = base * (1.1 + 0.45 * math.sin(clock * 3.3) + 0.2 * math.sin(clock * 7.1))
		elseif pulse == "Hue" then
			light.Color = Color3.fromHSV((clock * 0.25) % 1, 0.8, 1)
			light.Brightness = base * 1.4
		elseif pulse == "Glow" then
			light.Brightness = base * (1 + 0.35 * math.sin(clock * 2))
		end
	end
end

local function lightningPoints(fx: FX, mode: string): (Vector3, Vector3, number, boolean, number)
	local sc = fx.Scale
	local center = fx.Root.Position + Vector3.new(0, 0.3 * sc, 0)
	local ground = fx.Ground
	local function groundPoint(radius: number): Vector3
		local angle = rng:NextNumber(0, TAU)
		if ground then
			return ground.Position + Vector3.new(math.cos(angle) * radius, 0.1, math.sin(angle) * radius)
		end
		return center + rng:NextUnitVector() * radius
	end
	if mode == "Rise" then
		return groundPoint(3 * sc), center + rng:NextUnitVector() * 1.1 * sc, 0.14 * sc, true, 0.5
	elseif mode == "Strike" then
		local from = center + Vector3.new(rng:NextNumber(-4, 4) * sc, 16 * sc, rng:NextNumber(-4, 4) * sc)
		return from, center + rng:NextUnitVector() * 0.5 * sc, 0.22 * sc, true, 1
	end
	-- Arc: crackles around the donut, sometimes grounding into the magic circle
	local from = center + rng:NextUnitVector() * 1.8 * sc
	local to = if ground and rng:NextNumber() < 0.3 then groundPoint(rng:NextNumber(2.5, 3.5) * sc) else center + rng:NextUnitVector() * 3.9 * sc
	return from, to, 0.1 * sc, rng:NextNumber() < 0.4, 0.3
end

-- The full show (only for the closest donuts).
local function updateFull(fx: FX)
	local visuals = fx.Visuals
	if not visuals then
		return
	end
	-- Magic circles
	for _, spinner in visuals.Spinners do
		local adornment = spinner.Adornment :: any
		local turn = CFrame.Angles(0, 0, (clock * spinner.Speed) % TAU)
		if adornment:IsA("BoxHandleAdornment") then
			adornment.CFrame = CFrame.Angles(0, (clock * spinner.Speed) % TAU, 0) * spinner.Base
		else
			adornment.CFrame = FLAT * turn * spinner.Base
		end
		if spinner.Theme.Rainbow then
			adornment.Color3 = Color3.fromHSV((clock * 0.18 + spinner.Hue) % 1, 0.7, 1)
		end
		if spinner.Pulse then
			adornment.Transparency = 0.8 + 0.1 * math.sin(clock * 3)
		end
	end
	-- Comets
	local center = fx.Root.Position + Vector3.new(0, 0.3 * fx.Scale, 0)
	for _, wisp in visuals.Wisps do
		local angle = clock * wisp.Speed + wisp.Offset
		local offset = wisp.Axis:VectorToWorldSpace(Vector3.new(math.cos(angle), 0, math.sin(angle))) * wisp.Radius
		wisp.Part.CFrame = CFrame.new(center + offset)
		if wisp.Theme.Rainbow then
			local color = Color3.fromHSV((clock * 0.3 + wisp.Hue) % 1, 0.7, 1)
			wisp.Part.Color = color
			wisp.Trail.Color = ColorSequence.new(color)
		end
	end
	-- Shockwaves
	for i = #visuals.Waves, 1, -1 do
		local wave = visuals.Waves[i]
		local a = (clock - wave.Start) / 0.8
		if a >= 1 then
			wave.Adornment:Destroy()
			table.remove(visuals.Waves, i)
		else
			local eased = 1 - (1 - a) ^ 3
			local radius = (0.8 + eased * 8.5) * wave.Scale
			wave.Adornment.Radius = radius
			wave.Adornment.InnerRadius = math.max(0, radius - 0.35 * wave.Scale)
			wave.Adornment.Transparency = 0.15 + 0.85 * a
		end
	end
	-- Lightning + shockwave timers
	for _, state in fx.Themes do
		local theme = state.Theme
		local lightning = theme.Lightning
		if lightning and clock >= state.NextBolt then
			state.NextBolt = clock + rng:NextNumber(lightning.Min, lightning.Max)
			local from, to, width, branch, flash = lightningPoints(fx, lightning.Mode)
			spawnBolt(from, to, randomColor(theme), width, branch, flash)
			if lightning.Mode == "Strike" then
				spawnWave(fx, state)
			end
		end
		local shock = theme.Shockwave
		if shock and clock >= state.NextWave then
			state.NextWave = clock + rng:NextNumber(shock.Min, shock.Max)
			spawnWave(fx, state)
		end
	end
	-- The donut's own colours
	local tint = fx.Tint
	if tint == "Heartbeat" and not CollectionService:HasTag(fx.Model, "DonutRainbow") then
		local beat = heartbeat(clock)
		for i, part in fx.Frosting do
			part.Color = fx.FrostingColors[i]:Lerp(Color3.fromRGB(255, 190, 190), beat * 0.7)
		end
	elseif tint == "Galaxy" then
		for i, part in fx.Dough do
			local wave = math.sin(clock * 0.9 + i * 0.55)
			part.Color = Color3.fromHSV((0.72 + 0.1 * math.sin(clock * 0.5 + i * 0.4)) % 1, 0.8, 0.32 + 0.14 * wave)
		end
	elseif tint == "Rainbow" then
		local count = #fx.Dough
		for i, part in fx.Dough do
			part.Color = Color3.fromHSV((clock * 0.2 + i / count) % 1, 0.55, 1)
		end
	end
	-- Outline colour
	local outline = visuals.Outline
	local outlineTheme = fx.OutlineTheme
	if outline and outlineTheme then
		local color = themeColor(outlineTheme, 1, 0)
		outline.OutlineColor = color
		outline.FillColor = color
		outline.OutlineTransparency = 0.15 + 0.15 * math.sin(clock * 4)
	end
end

--------------------------------------------------------------------------------
-- Registration
--------------------------------------------------------------------------------
local function register(instance: Instance)
	if not instance:IsA("Model") or fxs[instance] then
		return
	end
	local model = instance
	local root = model.PrimaryPart or model:WaitForChild("Root", 5)
	if not root or not root:IsA("BasePart") or not model.Parent then
		return
	end
	local rarity = model:GetAttribute("Rarity")
	local mutation = model:GetAttribute("Mutation")
	local themes = FXThemes.For(if type(rarity) == "string" then rarity else "", if type(mutation) == "string" then mutation else nil)
	if #themes == 0 then
		return
	end
	local scale = model:GetAttribute("FXScale")
	local bottom = model:GetAttribute("Bottom")
	local sc = if type(scale) == "number" then scale else 1
	-- Read the resting position straight away (other effects start moving the donut right after).
	local ground: CFrame? = nil
	if root.Anchored and not model:GetAttribute("Follower") then
		ground = CFrame.new(root.Position - Vector3.new(0, if type(bottom) == "number" then bottom else 1.5, 0))
	end

	local states: { ThemeState } = {}
	local tint, pulse, outlineTheme = nil, nil, nil
	for i, theme in themes do
		table.insert(states, { Theme = theme, Index = i, NextBolt = clock + rng:NextNumber(0.2, 1.5), NextWave = clock + rng:NextNumber(0.5, 3) })
		tint = theme.Tint or tint
		pulse = theme.Pulse or pulse
		if theme.Outline then
			outlineTheme = theme
		end
	end

	local bursts = {}
	local frosting, frostingColors, dough, doughColors = {}, {}, {}, {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local spin = part:GetAttribute("FXSpin")
			local weld = part:FindFirstChildOfClass("Weld")
			if type(spin) == "number" and weld then
				table.insert(bursts, { Weld = weld, Base = weld.C0, Spin = spin })
			end
			if part.Name == "Frosting" then
				table.insert(frosting, part)
				table.insert(frostingColors, part.Color)
			elseif part.Name == "Dough" then
				table.insert(dough, part)
				table.insert(doughColors, part.Color)
			end
		end
	end
	local light = root:FindFirstChildOfClass("PointLight")
	fxs[model] = {
		Model = model,
		Root = root,
		Scale = sc,
		Ground = ground,
		Themes = states,
		Light = light,
		LightBrightness = if light then light.Brightness else 1,
		LightColor = if light then light.Color else Color3.new(1, 1, 1),
		Bursts = bursts,
		Frosting = frosting,
		FrostingColors = frostingColors,
		Dough = dough,
		DoughColors = doughColors,
		Tint = tint,
		Pulse = pulse,
		OutlineTheme = outlineTheme,
		Visuals = nil,
		Distance = math.huge,
	}
end

local function unregister(instance: Instance)
	local fx = if instance:IsA("Model") then fxs[instance] else nil
	if fx then
		dropVisuals(fx)
		fxs[instance :: Model] = nil
	end
end

local function focusPosition(): Vector3?
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

function DonutFX.Init()
	folder = Instance.new("Folder")
	folder.Name = "DonutFXLocal"
	folder.Parent = workspace

	for _, instance in CollectionService:GetTagged("DonutFX") do
		task.spawn(register, instance)
	end
	CollectionService:GetInstanceAddedSignal("DonutFX"):Connect(register)
	CollectionService:GetInstanceRemovedSignal("DonutFX"):Connect(unregister)

	RunService.RenderStepped:Connect(function(dt: number)
		clock += dt
		updateBolts()
		local focus = focusPosition()
		if not focus then
			return
		end
		local near: { FX } = {}
		for model, fx in fxs do
			if not model.Parent then
				unregister(model)
				continue
			end
			fx.Distance = (fx.Root.Position - focus).Magnitude
			if fx.Distance < RANGE then
				table.insert(near, fx)
			elseif fx.Visuals then
				dropVisuals(fx)
			end
		end
		table.sort(near, function(a, b)
			return a.Distance < b.Distance
		end)
		local outlines = 0
		for rank, fx in near do
			updateCheap(fx)
			if rank <= MAX_ACTIVE then
				ensureVisuals(fx)
				local wantsOutline = fx.OutlineTheme ~= nil and outlines < MAX_OUTLINES
				if wantsOutline then
					outlines += 1
				end
				setOutline(fx, wantsOutline)
				updateFull(fx)
			elseif fx.Visuals then
				dropVisuals(fx)
			end
		end
	end)
end

return DonutFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">DonutIdle</string>
            <string name="Source"><![CDATA[--[[
	DonutIdle: idle animations for the donuts standing on bases (every base, all client-side, so the
	server never has to replicate any of it).

	Every donut gets its own personality, picked from its id and the stand it's on:
	  Bounce - happy little hops (feet kick, arms flop)
	  Sway   - rocks side to side, arms swinging
	  Dance  - bops to a beat, arms up in turn, feet stepping
	  Look   - stands still, breathing, looking around
	  Float  - rare / mutated donuts that float: hover, spin and flap their wings
	Every few seconds a donut does something special: a twirl, a big jump (crouch, leap, land), a
	backflip, a wave, a cheer, a wiggle, a look around, or a little doze. They blink, their eyes wander,
	and when you walk past they watch you (eyes first, then they turn a little) - and when you come
	close they wave or jump to say hi. Their mouths open while they jump, twirl and cheer.
	Propellers spin, orbiting orbs orbit, tentacles wiggle and capes flutter.

	How it works: a donut is one anchored Root with every other part welded to it (DonutModel), so
	moving Root moves the whole donut, and changing a limb's weld (C0) bends that limb around the
	"Pivot" the server stored on it. Eyes ("EyeWhite") are squashed to blink, pupils ("Pupil") slide
	inside the eyes, and the middle of the smile ("Mouth" = "Middle") stretches into an open mouth.
	Only donuts near the camera are animated.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DonutIdle = {}

local player = Players.LocalPlayer :: Player
local RANGE = 110 -- studs from the camera; further donuts stand still
local NEAR = 45 -- closer than this: every frame, otherwise 30 times a second
local WATCH_RANGE = 30 -- donuts this close to you watch you
local GREET_RANGE = 13 -- ...and say hi when you come this close
local GREET_COOLDOWN = 25
local TAU = math.pi * 2
local STYLES = { "Bounce", "Sway", "Dance", "Look" }
local ACTION_LENGTH: { [string]: number } = {
	Twirl = 0.9,
	Jump = 0.95,
	Flip = 1.15,
	Wiggle = 0.8,
	Wave = 1.6,
	Cheer = 1.3,
	LookAround = 2.2,
	Doze = 2.8,
}
local OPEN_MOUTH: { [string]: boolean } = { Twirl = true, Jump = true, Flip = true, Cheer = true, Wave = true }
local LOOK_TARGETS = { -0.55, 0, 0.55, 0, -0.3, 0.3 }
local CLOSED_EYE = Color3.fromRGB(70, 35, 40)
local GAZE = 0.075 -- how far pupils slide (studs, before the donut's scale)
local EYE_HEIGHT = 1.6 -- eyes above the middle of the donut (before its scale)

type Limb = { Weld: Weld, Base: CFrame, Pivot: CFrame, Kind: string, Side: number, Phase: number }
type Eye = { Part: BasePart, Size: Vector3, Color: Color3 }
type Pupil = { Part: BasePart, Weld: Weld, Base: CFrame }
type Mouth = { Part: BasePart, Weld: Weld, Base: CFrame, Size: Vector3, Corners: { BasePart } }

type Idle = {
	Model: Model,
	Root: BasePart,
	Base: CFrame,
	Bottom: number,
	Scale: number,
	Style: string,
	Rng: Random,
	Phase: number,
	Limbs: { Limb },
	Eyes: { Eye },
	Pupils: { Pupil },
	Mouth: Mouth?,
	HasArms: boolean,
	Blinking: boolean,
	NextBlink: number,
	BlinkUntil: number,
	MouthOpen: boolean,
	Gaze: Vector2,
	GazeTarget: Vector2,
	NextGaze: number,
	Action: string?,
	ActionStart: number,
	NextAction: number,
	Yaw: number,
	Turn: number,
	LookTarget: number,
	NextLook: number,
	Near: boolean,
	GreetAt: number?,
	NextGreet: number,
	LastY: number,
	Flop: number,
	Active: boolean,
	Accum: number,
}

local idles: { [Model]: Idle } = {}
local clock = 0 -- animation time: rendered seconds (pauses when the game does)

local function hashString(text: string): number
	local hash = 7
	for i = 1, #text do
		hash = (hash * 31 + string.byte(text, i)) % 2147483647
	end
	return hash
end

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

local function approach(current: number, target: number, rate: number, dt: number): number
	return current + (target - current) * (1 - math.exp(-rate * dt))
end

local function setBlink(idle: Idle, closed: boolean)
	if idle.Blinking == closed then
		return
	end
	idle.Blinking = closed
	for _, eye in idle.Eyes do
		eye.Part.Size = if closed then Vector3.new(eye.Size.X * 1.05, eye.Size.Y * 0.14, eye.Size.Z * 0.8) else eye.Size
		eye.Part.Color = if closed then CLOSED_EYE else eye.Color
	end
	for _, pupil in idle.Pupils do
		pupil.Part.Transparency = if closed then 1 else 0
	end
end

local function setMouth(idle: Idle, open: boolean)
	local mouth = idle.Mouth
	if not mouth or idle.MouthOpen == open then
		return
	end
	idle.MouthOpen = open
	-- The middle of the smile grows into a round "wheee!" mouth, the corners hide
	mouth.Part.Size = if open then Vector3.new(mouth.Size.X * 1.25, mouth.Size.Y * 2.6, mouth.Size.Z) else mouth.Size
	mouth.Weld.C0 = if open then mouth.Base * CFrame.new(0, -mouth.Size.Y * 0.6, 0) else mouth.Base
	for _, corner in mouth.Corners do
		corner.Transparency = if open then 1 else 0
	end
end

local function setGaze(idle: Idle, gaze: Vector2)
	if (gaze - idle.Gaze).Magnitude < 0.004 then
		return
	end
	idle.Gaze = gaze
	local offset = CFrame.new(gaze.X * GAZE * idle.Scale, gaze.Y * GAZE * idle.Scale, 0)
	for _, pupil in idle.Pupils do
		pupil.Weld.C0 = pupil.Base * offset
	end
end

-- Back to the pose the server built (when the donut goes out of range).
local function reset(idle: Idle)
	idle.Root.CFrame = idle.Base
	for _, limb in idle.Limbs do
		limb.Weld.C0 = limb.Base
	end
	setBlink(idle, false)
	setMouth(idle, false)
	setGaze(idle, Vector2.zero)
end

local function register(instance: Instance)
	if not instance:IsA("Model") or idles[instance] then
		return
	end
	local model = instance
	task.wait(0.3) -- let every part of the donut arrive
	if not model.Parent then
		return
	end
	local root = model.PrimaryPart or model:FindFirstChild("Root")
	if not root or not root:IsA("BasePart") then
		return
	end
	local donutId = model:GetAttribute("DonutId")
	local stand = model:GetAttribute("IdleSeed")
	local seed = hashString(if type(donutId) == "string" then donutId else model.Name) + (if type(stand) == "number" then stand * 7919 else 0)
	local rng = Random.new(seed)

	local limbs: { Limb } = {}
	local eyes: { Eye } = {}
	local pupils: { Pupil } = {}
	local mouth: Mouth? = nil
	local corners: { BasePart } = {}
	local phases: { [string]: number } = {} -- parts swinging around the same pivot move together
	local hasArms = false
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local kind = part:GetAttribute("Limb")
			local weld = part:FindFirstChildOfClass("Weld")
			if type(kind) == "string" and weld then
				local pivot = part:GetAttribute("Pivot")
				local pivotPosition = if typeof(pivot) == "Vector3" then pivot else Vector3.zero
				local side = part:GetAttribute("Side")
				local key = string.format("%.2f,%.2f,%.2f", pivotPosition.X, pivotPosition.Y, pivotPosition.Z)
				local phase = phases[key] or rng:NextNumber(0, TAU)
				phases[key] = phase
				table.insert(limbs, {
					Weld = weld,
					Base = weld.C0,
					Pivot = CFrame.new(pivotPosition),
					Kind = kind,
					Side = if type(side) == "number" then side else 0,
					Phase = phase,
				})
				hasArms = hasArms or kind == "Arm"
			end
			if part:GetAttribute("EyeWhite") then
				table.insert(eyes, { Part = part, Size = part.Size, Color = part.Color })
			elseif part:GetAttribute("Pupil") and weld then
				table.insert(pupils, { Part = part, Weld = weld, Base = weld.C0 })
			end
			local mouthPart = part:GetAttribute("Mouth")
			if mouthPart == "Middle" and weld then
				mouth = { Part = part, Weld = weld, Base = weld.C0, Size = part.Size, Corners = corners }
			elseif mouthPart == "Corner" then
				table.insert(corners, part)
			end
		end
	end

	local now = clock
	local bottom = model:GetAttribute("Bottom")
	idles[model] = {
		Model = model,
		Root = root,
		Base = root.CFrame,
		Bottom = if type(bottom) == "number" then bottom else 1.5,
		Scale = root.Size.Y / 3,
		Style = if CollectionService:HasTag(model, "DonutFloat") then "Float" else STYLES[rng:NextInteger(1, #STYLES)],
		Rng = rng,
		Phase = rng:NextNumber(0, 10),
		Limbs = limbs,
		Eyes = eyes,
		Pupils = pupils,
		Mouth = mouth,
		HasArms = hasArms,
		Blinking = false,
		NextBlink = now + rng:NextNumber(0.5, 4),
		BlinkUntil = 0,
		MouthOpen = false,
		Gaze = Vector2.zero,
		GazeTarget = Vector2.zero,
		NextGaze = now + rng:NextNumber(0.5, 2),
		Action = nil,
		ActionStart = 0,
		NextAction = now + rng:NextNumber(2, 10),
		Yaw = 0,
		Turn = 0,
		LookTarget = 0,
		NextLook = now + rng:NextNumber(0.5, 2),
		Near = false,
		GreetAt = nil,
		NextGreet = 0,
		LastY = 0,
		Flop = 0,
		Active = false,
		Accum = 0,
	}
end

local function startAction(idle: Idle, action: string, now: number)
	idle.Action = action
	idle.ActionStart = now
end

local function animate(idle: Idle, now: number, dt: number, target: Vector3?)
	local t = now + idle.Phase
	local k = idle.Scale
	local y, yaw, pitch, roll, flip = 0, 0, 0, 0, 0
	-- Limb amounts. Arms: 0 = relaxed, 0.5 = the built "hands up" pose, 1 = straight up.
	-- Legs: positive kicks the feet forward. Wings: positive = tips up.
	local legL, legR, armL, armR, wing = 0, 0, 0.2, 0.2, 0
	local eyesClosed = false
	local floppy = true -- arms flop with the bounce (off while waving)

	-- Where you are, seen from the donut's stand: angle to turn to face you, and how close you are
	local watching = false
	local faceYaw = 0
	if target then
		local fromStand = idle.Base:PointToObjectSpace(target)
		local distance = Vector3.new(fromStand.X, 0, fromStand.Z).Magnitude
		watching = distance < WATCH_RANGE * math.max(1, k)
		faceYaw = math.atan2(-fromStand.X, -fromStand.Z)
		-- Say hi when you walk up (once in a while, not every donut at once)
		local near = distance < GREET_RANGE * math.max(1, k)
		if near and not idle.Near and now >= idle.NextGreet and idle.Rng:NextNumber() < 0.7 then
			idle.GreetAt = now + idle.Rng:NextNumber(0, 0.6)
			idle.NextGreet = now + GREET_COOLDOWN
		end
		idle.Near = distance < (GREET_RANGE + 6) * math.max(1, k)
	end
	if idle.GreetAt and now >= idle.GreetAt and not idle.Action then
		idle.GreetAt = nil
		startAction(idle, if idle.HasArms then "Wave" else "Jump", now)
	end

	-- Turn a little towards you while you're around (not all the way round if you're behind it)
	local turnTarget = if watching and math.abs(faceYaw) < 2 then math.clamp(faceYaw, -0.7, 0.7) * 0.6 else 0
	idle.Turn = approach(idle.Turn, turnTarget, 2.5, dt)

	local style = idle.Style
	if style == "Float" then
		y = 0.35 * k * math.sin(t * 2)
		yaw = (t * 0.9) % TAU
		wing = 0.35 * math.sin(t * 7)
		legL = 0.25 * math.sin(t * 3)
		legR = -legL
		armL = 0.45 + 0.15 * math.sin(t * 2.5)
		armR = 0.45 + 0.15 * math.sin(t * 2.5 + 1)
		floppy = false
	elseif style == "Bounce" then
		local u = (t * 0.75) % 1 -- one hop every 1.33 s
		local hop = if u < 0.45 then math.sin(u / 0.45 * math.pi) else 0
		y = 0.45 * k * hop
		if u > 0.8 then
			y -= 0.07 * k * math.sin((u - 0.8) / 0.2 * math.pi) -- little squat before the next hop
		elseif u > 0.45 and u < 0.58 then
			y -= 0.05 * k * math.sin((u - 0.45) / 0.13 * math.pi) -- and a soft landing
		end
		pitch = -0.08 * hop
		legL = 0.5 * hop
		legR = legL
		armL = 0.2 + 0.4 * hop
		armR = armL
		wing = 0.3 * hop
	elseif style == "Sway" then
		local w = 1.7
		roll = 0.13 * math.sin(t * w)
		yaw = 0.1 * math.sin(t * w * 0.5)
		y = 0.05 * k * math.abs(math.sin(t * w))
		legL = 0.15 * math.sin(t * w)
		legR = -legL
		armL = 0.3 + 0.25 * math.sin(t * w)
		armR = 0.3 - 0.25 * math.sin(t * w)
		wing = 0.15 * math.sin(t * w * 2)
	elseif style == "Dance" then
		local w = TAU * 1.1 -- beats per second
		local beat = math.abs(math.sin(t * w / 2))
		y = 0.14 * k * beat
		roll = 0.14 * math.sin(t * w / 2)
		yaw = 0.3 * math.sin(t * w / 4)
		legL = 0.35 * math.sin(t * w / 2)
		legR = -legL
		armL = 0.2 + 0.7 * math.max(0, math.sin(t * w / 2))
		armR = 0.2 + 0.7 * math.max(0, -math.sin(t * w / 2))
		wing = 0.25 * beat
		floppy = false
	else -- Look: breathe, and turn to look at things now and then (at you, if you're close)
		y = 0.04 * k * math.sin(t * 1.8)
		if now >= idle.NextLook then
			idle.LookTarget = LOOK_TARGETS[idle.Rng:NextInteger(1, #LOOK_TARGETS)]
			idle.NextLook = now + idle.Rng:NextNumber(1.2, 3.5)
		end
		local lookAt = if watching and math.abs(faceYaw) < 2 then math.clamp(faceYaw, -0.8, 0.8) else idle.LookTarget
		idle.Yaw = approach(idle.Yaw, lookAt, 5, dt)
		yaw = idle.Yaw
		pitch = 0.03 * math.sin(t * 1.8)
		legL = 0.06 * math.sin(t * 0.9) -- shifting its weight from foot to foot
		legR = -legL
		armL = 0.15 + 0.06 * math.sin(t * 1.8)
		armR = armL
		wing = 0.08 * math.sin(t * 1.8)
	end
	if style ~= "Float" and style ~= "Look" then
		yaw += idle.Turn
	end

	-- A special move every few seconds
	if not idle.Action and now >= idle.NextAction then
		local options = { "Twirl", "Jump", "Jump", "Wiggle", "LookAround", "Flip", "Doze" }
		if idle.HasArms then
			table.insert(options, "Wave")
			table.insert(options, "Cheer")
			table.insert(options, "Cheer")
		end
		startAction(idle, options[idle.Rng:NextInteger(1, #options)], now)
	end
	local action = idle.Action
	if action then
		local a = (now - idle.ActionStart) / ACTION_LENGTH[action]
		if a >= 1 then
			idle.Action = nil
			idle.NextAction = now + idle.Rng:NextNumber(6, 14)
			action = nil
		elseif action == "Twirl" then
			yaw += TAU * smooth(a)
			y += 0.35 * k * math.sin(a * math.pi)
			armL, armR = 0.7, 0.7
		elseif action == "Jump" or action == "Flip" then
			-- crouch... leap... land
			local high = if action == "Flip" then 1.45 else 0.95
			if a < 0.22 then
				local c = math.sin(a / 0.22 * math.pi * 0.5)
				y -= 0.14 * k * c
				legL, legR = 0.3 * c, 0.3 * c
				armL, armR = 0, 0
				pitch += 0.1 * c
			elseif a < 0.82 then
				local air = (a - 0.22) / 0.6
				local h = math.sin(air * math.pi)
				y += high * k * h
				legL = 0.7 * h
				legR = legL
				armL = 0.2 + 0.8 * h
				armR = armL
				wing = 0.6 * h * math.sin(air * TAU * 3)
				if action == "Flip" then
					flip = -TAU * smooth(air)
				end
			else
				local land = (a - 0.82) / 0.18
				y -= 0.1 * k * math.sin(land * math.pi)
				armL, armR = 0.5 * (1 - land), 0.5 * (1 - land)
			end
		elseif action == "Wiggle" then
			roll += 0.25 * math.sin(a * TAU * 3) * (1 - a)
		elseif action == "Wave" then
			local up = math.min(1, a * 4, (1 - a) * 4)
			armR = armR + (0.85 - armR) * up + 0.3 * up * math.sin(a * TAU * 3)
			roll += 0.05 * up
			floppy = false
		elseif action == "Cheer" then
			local pump = math.abs(math.sin(a * TAU * 1.5))
			y += 0.28 * k * pump
			armL = 0.55 + 0.45 * pump
			armR = armL
			legL, legR = 0.3 * pump, 0.3 * pump
			floppy = false
		elseif action == "LookAround" then
			yaw += 0.75 * math.sin(a * TAU) * math.sin(a * math.pi)
		elseif action == "Doze" then
			-- a stretch and a yawn, then a quick nap
			if a < 0.25 then
				local stretch = math.sin(a / 0.25 * math.pi)
				armL, armR = 0.2 + 0.8 * stretch, 0.2 + 0.8 * stretch
				y += 0.12 * k * stretch
				setMouth(idle, stretch > 0.3)
			else
				eyesClosed = true
				roll += 0.07 * math.sin((a - 0.25) * TAU * 0.8)
				y -= 0.05 * k * (0.5 + 0.5 * math.sin((a - 0.25) * TAU * 1.2))
				armL, armR = 0.05, 0.05
			end
			floppy = false
		end
	end

	-- Arms flop with the bounce: they lag behind, flying up as the donut drops
	local velocity = (y - idle.LastY) / math.max(dt, 1 / 120) / math.max(k, 0.1)
	idle.LastY = y
	idle.Flop = approach(idle.Flop, if floppy then math.clamp(-velocity * 0.12, -0.25, 0.3) else 0, 12, dt)
	armL += idle.Flop
	armR += idle.Flop

	-- Mouth: open for the big moves (the Doze yawn sets it above)
	if action ~= "Doze" then
		setMouth(idle, action ~= nil and OPEN_MOUTH[action] == true)
	end

	-- Blink (and keep them shut while dozing)
	if #idle.Eyes > 0 then
		if eyesClosed then
			setBlink(idle, true)
			idle.BlinkUntil = now + 0.1
		elseif idle.Blinking then
			if now >= idle.BlinkUntil then
				setBlink(idle, false)
			end
		elseif now >= idle.NextBlink then
			setBlink(idle, true)
			idle.BlinkUntil = now + 0.13
			-- sometimes a quick double blink
			idle.NextBlink = now + (if idle.Rng:NextNumber() < 0.2 then 0.3 else idle.Rng:NextNumber(2, 5))
		end
	end

	-- Body: rock around the feet, turn and flip around the middle
	local b = idle.Bottom
	local body = idle.Base
		* CFrame.new(0, y, 0)
		* CFrame.Angles(0, yaw, 0)
		* CFrame.Angles(flip, 0, 0)
		* CFrame.new(0, -b, 0)
		* CFrame.Angles(pitch, 0, roll)
		* CFrame.new(0, b, 0)
	idle.Root.CFrame = body

	-- Eyes: follow you while you're close, otherwise wander now and then
	if #idle.Pupils > 0 and not idle.Blinking then
		if watching and target then
			local seen = body:PointToObjectSpace(target)
			if seen.Z < 0 then
				idle.GazeTarget = Vector2.new(math.clamp(seen.X / -seen.Z * 1.6, -1, 1), math.clamp((seen.Y - EYE_HEIGHT * k) / -seen.Z * 1.6, -1, 1))
			else
				idle.GazeTarget = Vector2.new(if seen.X > 0 then 1 else -1, 0)
			end
		elseif action == "LookAround" then
			idle.GazeTarget = Vector2.new(math.clamp(math.sin((now - idle.ActionStart) / ACTION_LENGTH.LookAround * TAU) * 2, -1, 1), 0.2)
		elseif now >= idle.NextGaze then
			idle.GazeTarget = if idle.Rng:NextNumber() < 0.4 then Vector2.zero else Vector2.new(idle.Rng:NextNumber(-1, 1), idle.Rng:NextNumber(-0.6, 0.8))
			idle.NextGaze = now + idle.Rng:NextNumber(0.8, 3)
		end
		-- eyes dart quickly towards what they look at
		local gaze = idle.Gaze:Lerp(idle.GazeTarget, 1 - math.exp(-18 * dt))
		setGaze(idle, gaze)
	end

	-- Limbs: swing each one around its pivot
	for _, limb in idle.Limbs do
		local kind = limb.Kind
		local rotation: CFrame
		if kind == "Leg" then
			rotation = CFrame.Angles(if limb.Side < 0 then legL else legR, 0, 0)
		elseif kind == "Arm" then
			rotation = CFrame.Angles(0, 0, limb.Side * ((if limb.Side < 0 then armL else armR) - 0.5))
		elseif kind == "Wing" then
			rotation = CFrame.Angles(0, 0, limb.Side * wing)
		elseif kind == "Spin" then
			rotation = CFrame.Angles(0, (t * 14) % TAU, 0)
		elseif kind == "Orbit" then
			rotation = CFrame.Angles(0, (t * 1.3) % TAU, 0)
		elseif kind == "Tentacle" then
			rotation = CFrame.Angles(0, 0, 0.18 * math.sin(t * 3 + limb.Phase) - limb.Side * 0.12 * math.max(0, y / math.max(k, 0.1)))
		elseif kind == "Cape" then
			rotation = CFrame.Angles(0.12 + 0.08 * math.sin(t * 2.2) + math.clamp(velocity * 0.05, -0.2, 0.2), 0, 0.03 * math.sin(t * 1.3))
		else
			rotation = CFrame.identity
		end
		limb.Weld.C0 = limb.Pivot * rotation * limb.Pivot:Inverse() * limb.Base
	end
end

local function focusPosition(): Vector3?
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

-- What donuts look at: your head (or where it would be).
local function watchedPosition(): Vector3?
	local character = player.Character
	if not character then
		return nil
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position + Vector3.new(0, 1.5, 0)
	end
	return nil
end

function DonutIdle.Init()
	for _, instance in CollectionService:GetTagged("BaseDonut") do
		task.spawn(register, instance)
	end
	CollectionService:GetInstanceAddedSignal("BaseDonut"):Connect(register)
	CollectionService:GetInstanceRemovedSignal("BaseDonut"):Connect(function(instance)
		if instance:IsA("Model") then
			idles[instance] = nil
		end
	end)

	RunService.RenderStepped:Connect(function(dt: number)
		local focus = focusPosition()
		if not focus then
			return
		end
		clock += dt
		local now = clock
		local target = watchedPosition()
		for model, idle in idles do
			if not model.Parent then
				idles[model] = nil
				continue
			end
			local distance = (idle.Base.Position - focus).Magnitude
			if distance < RANGE then
				idle.Active = true
				idle.Accum += dt
				if distance < NEAR or idle.Accum >= 1 / 30 then
					animate(idle, now, idle.Accum, target)
					idle.Accum = 0
				end
			elseif idle.Active then
				idle.Active = false
				reset(idle)
			end
		end
	end)
end

return DonutIdle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	Effects: purely cosmetic, client-side animation so the server never has to replicate it.
	  DonutFloat / PodiumSpin  - rare donuts bob and spin (base donuts are animated by DonutIdle)
	  DonutRainbow             - frosting cycles through the rainbow (Celestial, Secret)
	  RainbowPart / RainbowText- rainbow parts and labels
	  SpinSlow                 - floating crystals and halo rings
	  TreadmillBelt            - belt slats scroll backwards
	  Area ambience            - lighting, fog and colour grading change per area
	  Owner-only prompts       - hide Upgrade/Sell prompts on other people's donuts
	  Popups                   - "+$" above your donuts
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Areas = require(Shared.Areas)
local Format = require(Shared.Format)

local Theme = require(script.Parent.UI.Theme)
local State = require(script.Parent.State)
local AreaTracker = require(script.Parent.AreaTracker)
local Bases = require(script.Parent.Bases)

local Effects = {}

local player = Players.LocalPlayer :: Player
local ANIMATE_DISTANCE = 180

--------------------------------------------------------------------------------
-- Tag tracking helper
--------------------------------------------------------------------------------
local function track<T>(tag: string, onAdd: (Instance) -> T?): { [Instance]: T }
	local set: { [Instance]: T } = {}
	local function add(instance: Instance)
		local value = onAdd(instance)
		if value ~= nil then
			set[instance] = value
		end
	end
	for _, instance in CollectionService:GetTagged(tag) do
		task.spawn(add, instance)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance)
		set[instance] = nil
	end)
	return set
end

local function cameraPosition(): Vector3
	local camera = workspace.CurrentCamera
	return if camera then camera.CFrame.Position else Vector3.zero
end

--------------------------------------------------------------------------------
-- Donut motion + rainbow
--------------------------------------------------------------------------------
type Floater = { Root: BasePart, Base: CFrame, Phase: number, Spin: number, Bob: number }

local function makeFloater(spin: number, bob: number): (Instance) -> Floater?
	return function(instance: Instance): Floater?
		if not instance:IsA("Model") or CollectionService:HasTag(instance, "BaseDonut") or instance:GetAttribute("Follower") then
			return nil
		end
		local root = instance.PrimaryPart or instance:WaitForChild("Root", 5)
		if not root or not root:IsA("BasePart") then
			return nil
		end
		return { Root = root, Base = root.CFrame, Phase = math.random() * 6, Spin = spin, Bob = bob }
	end
end

type Rainbow = { Parts: { BasePart }, Center: BasePart? }

local function makeRainbowModel(instance: Instance): Rainbow?
	local parts = {}
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") and (descendant.Name == "Frosting" or descendant.Name == "Aura" or descendant.Name == "Pillar") then
			table.insert(parts, descendant)
		end
	end
	local center = if instance:IsA("Model") then instance.PrimaryPart else nil
	return { Parts = parts, Center = center or parts[1] }
end

local function startDonutEffects()
	local floaters = track("DonutFloat", makeFloater(0.9, 0.35))
	local podiums = track("PodiumSpin", makeFloater(0.6, 0.25))
	local rainbows: { [Instance]: Rainbow } = track("DonutRainbow", makeRainbowModel)
	local rainbowParts = track("RainbowPart", function(instance)
		return if instance:IsA("BasePart") then instance else nil
	end)
	local rainbowTexts = track("RainbowText", function(instance)
		return if instance:IsA("TextLabel") then instance else nil
	end)
	type Spinner = { Model: Model, Base: CFrame }
	local spinners: { [Instance]: Spinner } = track("SpinSlow", function(instance): Spinner?
		if instance:IsA("Model") and instance.PrimaryPart then
			return { Model = instance, Base = instance:GetPivot() }
		end
		return nil
	end)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local cam = cameraPosition()

		local function animate(set: { [Instance]: Floater })
			for model, f in set do
				local root = f.Root
				-- Only animate anchored donuts (a carried donut is welded to its owner's head).
				if root.Parent and root.Anchored and (root.Position - cam).Magnitude < ANIMATE_DISTANCE then
					root.CFrame = f.Base * CFrame.new(0, math.sin(t * 2 + f.Phase) * f.Bob, 0) * CFrame.Angles(0, t * f.Spin + f.Phase, 0)
				elseif not model.Parent then
					set[model] = nil
				end
			end
		end
		animate(floaters)
		animate(podiums)

		local hue = (t * 0.2) % 1
		for model, r in rainbows do
			if not model.Parent then
				rainbows[model] = nil
			elseif r.Center and (r.Center.Position - cam).Magnitude < ANIMATE_DISTANCE * 1.5 then
				for i, part in r.Parts do
					part.Color = Color3.fromHSV((hue + i * 0.07) % 1, 0.7, 1)
				end
			end
		end
		for part in rainbowParts do
			local p = part :: BasePart
			if (p.Position - cam).Magnitude < 400 then
				p.Color = Color3.fromHSV((hue + p.Position.Z * 0.002) % 1, 0.8, 1)
			end
		end
		for label in rainbowTexts do
			(label :: TextLabel).TextColor3 = Color3.fromHSV(hue, 0.6, 1)
		end
		for model, s in spinners do
			if not model.Parent then
				spinners[model] = nil
			elseif (s.Base.Position - cam).Magnitude < 350 then
				s.Model:PivotTo(s.Base * CFrame.Angles(0, t * 0.5, math.sin(t) * 0.2))
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Treadmill belts
--------------------------------------------------------------------------------
local function startTreadmills()
	type Belt = { Belt: BasePart, Slats: { BasePart } }
	local belts: { [Instance]: Belt } = track("TreadmillBelt", function(instance): Belt?
		if not instance:IsA("BasePart") then
			return nil
		end
		task.wait(0.5) -- let the slats replicate
		local treadmill = instance.Parent
		if not treadmill then
			return nil -- rebuilt already (the base moved worlds)
		end
		local slats: { BasePart } = {}
		for _, child in treadmill:GetChildren() do
			if child:IsA("BasePart") and child.Name == "Slat" then
				table.insert(slats, child)
			end
		end
		table.sort(slats, function(a, b)
			return ((a:GetAttribute("SlatIndex") :: number?) or 0) < ((b:GetAttribute("SlatIndex") :: number?) or 0)
		end)
		return { Belt = instance, Slats = slats }
	end)
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local cam = cameraPosition()
		for belt, info in belts do
			local part = info.Belt
			if not belt.Parent then
				belts[belt] = nil
			elseif (part.Position - cam).Magnitude < 150 and #info.Slats > 0 then
				local length = part.Size.Z
				local spacing = length / #info.Slats
				local offset = (t * Config.Treadmill.BeltSpeed) % spacing
				for i, slat in info.Slats do
					local z = ((i - 1) * spacing + offset) % length - length / 2
					slat.CFrame = part.CFrame * CFrame.new(0, part.Size.Y / 2 + 0.03, z)
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Owner-only prompts (Upgrade / Sell / Podium on other players' bases are hidden),
-- and raid "Steal" prompts on your OWN base are hidden from you.
--------------------------------------------------------------------------------
local function startPromptFilter()
	local function filter(prompt: Instance)
		if not prompt:IsA("ProximityPrompt") then
			return
		end
		local function apply()
			local owner = prompt:GetAttribute("OwnerUserId")
			local hideFor = prompt:GetAttribute("HideForUserId")
			if prompt.Enabled and ((owner ~= nil and owner ~= player.UserId) or hideFor == player.UserId) then
				prompt.Enabled = false
			end
		end
		apply()
		prompt:GetAttributeChangedSignal("OwnerUserId"):Connect(apply)
		prompt:GetPropertyChangedSignal("Enabled"):Connect(apply)
	end
	for _, descendant in workspace:GetDescendants() do
		filter(descendant)
	end
	workspace.DescendantAdded:Connect(filter)
end

--------------------------------------------------------------------------------
-- Area ambience: brighter/basic near the hub, darker and more magical further out
--------------------------------------------------------------------------------
local function startAmbience()
	local tint = Lighting:WaitForChild("AreaTint", 10) :: ColorCorrectionEffect?
	local atmosphere = Lighting:WaitForChild("Atmosphere", 10) :: Atmosphere?
	local bloom = Lighting:WaitForChild("Bloom", 10) :: BloomEffect?
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	-- World 2's galaxy skybox (Config.GalaxySky), put back to the normal sky everywhere else
	local sky = Lighting:WaitForChild("Sky", 10) :: Sky?
	local faces = { "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }
	local normalSky: { [string]: string } = {}
	if sky then
		for _, face in faces do
			local ok, id = pcall(function()
				return (sky :: any)[face]
			end)
			normalSky[face] = if ok and type(id) == "string" then id else ""
		end
	end
	local function setSky(world: number)
		local galaxy = world == Areas.UltimateWorld and Config.GalaxySky.SkyboxBk ~= ""
		if sky then
			for _, face in faces do
				local id = if galaxy then (Config.GalaxySky :: any)[face] else normalSky[face]
				if id ~= "" then
					(sky :: any)[face] = id
				end
			end
		end
	end

	local function apply(areaId: number)
		-- In a world's safe hub, use that world's own look (its first area), not World 1's daylight
		local world = math.max(1, State.Number("World"))
		setSky(world)
		local hubAmbience = if world > 1 and Areas.ByWorld[world] then Areas.ByWorld[world][1].Ambience else Areas.Hub
		local amb = if areaId > 0 then Areas.List[areaId].Ambience else hubAmbience
		-- Day -> night goes forwards through sunset (ClockTime wraps at 24) instead of rewinding the sun.
		local clock = amb.ClockTime
		if clock < 6 and Lighting.ClockTime > 6 then
			clock += 24
		end
		TweenService:Create(Lighting, info, { ClockTime = clock, Ambient = amb.Ambient, OutdoorAmbient = amb.Ambient:Lerp(Color3.new(1, 1, 1), 0.2) }):Play()
		local look = Config.Graphics
		if tint then
			TweenService:Create(tint, info, { TintColor = amb.Tint, Saturation = amb.Saturation + look.SaturationBoost, Contrast = amb.Contrast + look.ContrastBoost }):Play()
		end
		if atmosphere then
			-- Decay is the colour far-away things fade to: match it to the area's air, so distant
			-- scenery melts into a coloured fog instead of ending against grey
			TweenService:Create(atmosphere, info, { Color = amb.AtmosphereColor, Decay = amb.AtmosphereColor:Lerp(Color3.new(0, 0, 0), 0.45), Density = amb.AtmosphereDensity, Haze = amb.Haze }):Play()
		end
		if bloom then
			TweenService:Create(bloom, info, { Intensity = amb.Bloom + look.BloomBoost }):Play()
		end
	end
	AreaTracker.Changed:Connect(apply)
	State.OnAttribute("World", function()
		if AreaTracker.Current >= 0 then
			apply(AreaTracker.Current)
		end
	end)
	if AreaTracker.Current >= 0 then
		apply(AreaTracker.Current)
	end
end

--------------------------------------------------------------------------------
-- Floating number popups
--------------------------------------------------------------------------------
local function popup(adornee: BasePart, text: string, color: Color3, offset: Vector3)
	local gui = Theme.new("BillboardGui", {
		Adornee = adornee,
		Size = UDim2.fromOffset(160, 40),
		StudsOffsetWorldSpace = offset,
		AlwaysOnTop = false,
		LightInfluence = 0,
		MaxDistance = 90,
		Parent = Theme.PlayerGui(),
	})
	local label = Theme.Label({ Text = text, TextColor3 = color, Size = UDim2.fromScale(1, 1), StrokeThickness = 2.5, Parent = gui })
	TweenService:Create(gui, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = offset + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
	task.delay(1.25, function()
		gui:Destroy()
	end)
end

local function startPopups()
	-- (Treadmill "+speed" popups live in client/Treadmill.luau.)
	-- "+$X" above your own donuts every few seconds
	task.spawn(function()
		local interval = 3
		while true do
			task.wait(interval)
			local plot = Bases.Mine()
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if plot and root and (root.Position - plot:GetPivot().Position).Magnitude < 120 then
				local mult = math.max(1, State.Number("MoneyMultiplier"))
				for _, child in plot:GetChildren() do
					local income = child:GetAttribute("Income")
					if child:IsA("Model") and child.PrimaryPart and type(income) == "number" then
						local top = (child:GetAttribute("Top") :: number?) or 3
						popup(child.PrimaryPart, "+" .. Format.Money(income * interval * mult), Theme.Colors.Money, Vector3.new(0, top + 3, 0))
					end
				end
			end
		end
	end)
end

function Effects.Init()
	startDonutEffects()
	startTreadmills()
	startPromptFilter()
	startAmbience()
	startPopups()
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Flight</string>
            <string name="Source"><![CDATA[--[[
	Flight and noclip (admin panel): the server sets your "FlyMode" attribute to "Fly" or "Carpet"; this flies.

	  Move with the normal controls (WASD / thumbstick); the way you face follows the camera.
	  Space / the ⬆ button = up, Shift or Ctrl / the ⬇ button = down. Looking up or down while moving
	  forward also climbs or dives.
	  "Carpet" puts a magic carpet (with tassels and sparkles) under your feet.
	Speed: your walk speed x Config.Admin.FlySpeed (at least 60).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Theme = require(script.Parent.UI.Theme)

local Flight = {}

local player = Players.LocalPlayer :: Player
local rgb = Color3.fromRGB

type Rig = { Velocity: LinearVelocity, Align: AlignOrientation, Attachment: Attachment, Carpet: Model?, Humanoid: Humanoid }
local rig: Rig? = nil
local vertical = 0 -- -1 down, 0, 1 up (keys / buttons)
local buttons: Frame? = nil

local function buildCarpet(root: BasePart): Model
	local model = Instance.new("Model")
	model.Name = "MagicCarpet"
	local function piece(size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?): Part
		local p = Instance.new("Part")
		p.Size = size
		p.CFrame = root.CFrame * offset
		p.Color = color
		p.Material = material or Enum.Material.Fabric
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
		p.Parent = model
		return p
	end
	local base = CFrame.new(0, -3.1, 0)
	local rug = piece(Vector3.new(6, 0.25, 8), base, rgb(170, 30, 60))
	piece(Vector3.new(5, 0.27, 7), base, rgb(230, 170, 40))
	piece(Vector3.new(4, 0.29, 6), base, rgb(120, 20, 90))
	for _, z in { -4.2, 4.2 } do
		for x = -2.5, 2.5, 1 do
			piece(Vector3.new(0.25, 0.25, 0.6), base * CFrame.new(x, 0, z), rgb(255, 215, 80))
		end
	end
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = rgb(255, 220, 120)
	sparkles.Parent = rug
	model.Parent = root.Parent
	return model
end

local function stop()
	if rig then
		rig.Velocity:Destroy()
		rig.Align:Destroy()
		rig.Attachment:Destroy()
		if rig.Carpet then
			rig.Carpet:Destroy()
		end
		rig.Humanoid.PlatformStand = false
		rig = nil
	end
	if buttons then
		buttons.Visible = false
	end
end

local function start(mode: string)
	stop()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "FlightAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.MaxTorque = math.huge
	align.Responsiveness = 30
	align.CFrame = root.CFrame.Rotation
	align.Parent = root
	humanoid.PlatformStand = true
	rig = {
		Velocity = velocity,
		Align = align,
		Attachment = attachment,
		Carpet = if mode == "Carpet" then buildCarpet(root) else nil,
		Humanoid = humanoid,
	}
	if buttons then
		buttons.Visible = UserInputService.TouchEnabled
	end
end

local function apply()
	local mode = player:GetAttribute("FlyMode")
	if mode == "Fly" or mode == "Carpet" then
		start(mode)
	else
		stop()
	end
end

-- ⬆ / ⬇ buttons for phones and tablets
local function buildButtons()
	local gui = Theme.ScreenGui("FlightButtons", 5)
	local frame = Theme.new("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -170, 1, -150), Size = UDim2.fromOffset(70, 150), BackgroundTransparency = 1, Visible = false, Parent = gui })
	Theme.AutoScale(frame)
	type Info = { Text: string, Direction: number }
	local infos: { Info } = { { Text = "⬆", Direction = 1 }, { Text = "⬇", Direction = -1 } }
	for i, info in infos do
		local button = Theme.Button({ Text = info.Text, Color = Theme.Colors.Blue, Size = UDim2.fromOffset(66, 66), Position = UDim2.fromOffset(0, (i - 1) * 76), Parent = frame })
		button.MouseButton1Down:Connect(function()
			vertical = info.Direction
		end)
		button.MouseButton1Up:Connect(function()
			vertical = 0
		end)
		button.MouseLeave:Connect(function()
			vertical = 0
		end)
	end
	buttons = frame
end

function Flight.Init()
	-- Noclip (admin panel): walk through walls while the "Noclip" attribute is on.
	local noclipParts: { [BasePart]: boolean } = {}
	RunService.Stepped:Connect(function()
		local character = player.Character
		if player:GetAttribute("Noclip") and character then
			for _, part in character:GetDescendants() do
				if part:IsA("BasePart") and part.CanCollide then
					noclipParts[part] = true
					part.CanCollide = false
				end
			end
		elseif next(noclipParts) then
			for part in noclipParts do
				if part.Parent then
					part.CanCollide = true
				end
			end
			table.clear(noclipParts)
		end
	end)
	buildButtons()
	player:GetAttributeChangedSignal("FlyMode"):Connect(apply)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		apply()
	end)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Space then
			vertical = 1
		elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.LeftControl then
			vertical = -1
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.LeftControl then
			vertical = 0
		end
	end)
	RunService.RenderStepped:Connect(function()
		local current = rig
		if not current then
			return
		end
		if not current.Humanoid.Parent or current.Humanoid.Health <= 0 then
			stop()
			return
		end
		local camera = workspace.CurrentCamera
		local look = if camera then camera.CFrame.LookVector else Vector3.new(0, 0, -1)
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 then
			current.Align.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit)
		end
		local walk = player:GetAttribute("WalkSpeed")
		local speed = math.max(60, (if type(walk) == "number" then walk else 16) * Config.Admin.FlySpeed)
		local move = current.Humanoid.MoveDirection
		-- Moving towards where the camera looks also climbs / dives with it
		local forward = if flat.Magnitude > 0.01 then flat.Unit else Vector3.zero
		local climb = if move.Magnitude > 0.1 then move:Dot(forward) * look.Y else 0
		current.Velocity.VectorVelocity = (move + Vector3.new(0, vertical + climb, 0)) * speed
		current.Humanoid.PlatformStand = true
	end)
	task.defer(apply)
end

return Flight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Followers</string>
            <string name="Source"><![CDATA[--[[
	Followers: every player's favourite donut and equipped pets, following them around.

	Drawn by each client from the player's attributes (nothing is simulated or replicated):
	  "Favorite" -> "donutId|mutation|size" of their favourite base donut: a copy at
	                Config.Favorite.Scale (1/3) of its size on the stand, mutation look included
	  "Pets"     -> comma-separated ids of their equipped pets
	Walkers hop along behind you, flyers and blobs float. Wings flap, tails wag (faster while you're
	on the move), whale flukes paddle, tentacles wiggle and everyone blinks - all by swinging the
	parts PetModel marked ("Limb") around their joints ("Pivot"). Only followers near the camera are
	animated.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Donuts = require(Shared.Donuts)
local Pets = require(Shared.Pets)
local DonutModel = require(Shared.DonutModel)
local PetModel = require(Shared.PetModel)

local Followers = {}

local RANGE = 220
-- Where followers walk, relative to their owner (behind them, spread out)
local SLOTS = {
	Vector3.new(4, 0, 3.5), -- favourite donut (pushed further out when it's a big one)
	Vector3.new(-4, 0, 3.5),
	Vector3.new(0, 0, 6),
	Vector3.new(-4.5, 0, 8),
	Vector3.new(4.5, 0, 8),
}

-- Limbs that move while following (a favourite donut's arms and legs stay put)
local ANIMATED = { Wing = true, Tail = true, Fluke = true, Fin = true, Tentacle = true, Spin = true, Orbit = true }

type Limb = { Weld: Weld, Base: CFrame, Pivot: CFrame, Kind: string, Side: number }
type Eye = { Part: BasePart, Size: Vector3, Color: Color3 }
type Follower = {
	Model: Model,
	Root: BasePart,
	Slot: number,
	Offset: Vector3, -- where it walks, relative to its owner
	Floats: boolean,
	Height: number, -- root height above the ground
	Phase: number,
	CFrame: CFrame,
	Limbs: { Limb },
	Eyes: { Eye },
	Pupils: { BasePart },
	Blinking: boolean,
	NextBlink: number,
	Rainbow: { BasePart },
	Glitch: boolean,
}

local folder: Folder
local byPlayer: { [Player]: { Follower } } = {}

local function prepare(model: Model, slot: number, floats: boolean, spread: number?): Follower
	local root = model.PrimaryPart :: BasePart
	model:SetAttribute("Follower", true)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	local limbs: { Limb } = {}
	local eyes: { Eye } = {}
	local pupils: { BasePart } = {}
	local rainbow: { BasePart } = {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local weld = part:FindFirstChildOfClass("Weld")
			local kind = part:GetAttribute("Limb")
			if weld and type(kind) == "string" and ANIMATED[kind] then
				local pivot = part:GetAttribute("Pivot")
				local side = part:GetAttribute("Side")
				table.insert(limbs, {
					Weld = weld,
					Base = weld.C0,
					Pivot = CFrame.new(if typeof(pivot) == "Vector3" then pivot else Vector3.zero),
					Kind = kind,
					Side = if type(side) == "number" then side else 0,
				})
			end
			if part:GetAttribute("EyeWhite") then
				table.insert(eyes, { Part = part, Size = part.Size, Color = part.Color })
			elseif part:GetAttribute("Pupil") then
				table.insert(pupils, part)
			end
			if model:GetAttribute("Rainbow") and (part.Name == "Body" or part.Name == "Wing") then
				table.insert(rainbow, part)
			end
		end
	end
	local bottom = (model:GetAttribute("Bottom") :: number?) or 1
	return {
		Model = model,
		Root = root,
		Slot = slot,
		Offset = SLOTS[slot] * (spread or 1),
		Floats = floats,
		Height = bottom + (if floats then 2.2 else 0.05),
		Phase = math.random() * 6,
		CFrame = CFrame.new(),
		Limbs = limbs,
		Eyes = eyes,
		Pupils = pupils,
		Blinking = false,
		NextBlink = os.clock() + math.random() * 4,
		Rainbow = rainbow,
		Glitch = model:GetAttribute("Glitch") == true,
	}
end

local function clear(player: Player)
	local list = byPlayer[player]
	if list then
		for _, follower in list do
			follower.Model:Destroy()
		end
	end
	byPlayer[player] = nil
end

local function rebuild(player: Player)
	clear(player)
	local list: { Follower } = {}
	local favorite = player:GetAttribute("Favorite")
	local parts = if type(favorite) == "string" then string.split(favorite, "|") else {}
	local donut = Donuts.ById[parts[1] or ""]
	if donut then
		-- Same build as the donut on the stand, just smaller
		local model = DonutModel.Build(donut, { Scale = Config.Plots.DonutScale * Config.Favorite.Scale, Mutation = parts[2], Size = parts[3] })
		local _, size = model:GetBoundingBox()
		table.insert(list, prepare(model, 1, true, math.max(1, math.max(size.X, size.Z) / 3)))
	end
	local pets = player:GetAttribute("Pets")
	if type(pets) == "string" and pets ~= "" then
		local slot = 2
		for _, id in string.split(pets, ",") do
			local pet = Pets.ById[id]
			if pet and slot <= #SLOTS then
				local model = PetModel.BuildPet(pet, { Scale = 0.7 })
				local floats = pet.Shape == "Blob" or pet.Shape == "Whale" or Pets.HasFeature(pet, "Wings")
				table.insert(list, prepare(model, slot, floats))
				slot += 1
			end
		end
	end
	for _, follower in list do
		follower.Model.Parent = folder
	end
	byPlayer[player] = list
end

local function watch(player: Player)
	player:GetAttributeChangedSignal("Favorite"):Connect(function()
		rebuild(player)
	end)
	player:GetAttributeChangedSignal("Pets"):Connect(function()
		rebuild(player)
	end)
	rebuild(player)
end

local function update(dt: number)
	local camera = workspace.CurrentCamera
	local cam = if camera then camera.CFrame.Position else Vector3.zero
	local t = os.clock()
	local alpha = 1 - math.exp(-dt * 9)
	for player, list in byPlayer do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local visible = root ~= nil and (root.Position - cam).Magnitude < RANGE
		for _, follower in list do
			local model = follower.Model
			if not visible or not root then
				if model.Parent then
					model.Parent = nil
				end
				continue
			end
			if not model.Parent then
				model.Parent = folder
				follower.CFrame = CFrame.new(root.Position)
			end
			-- Stand behind the owner, on the ground (feet ~3 studs below the root part)
			local hip = if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then humanoid.HipHeight + root.Size.Y / 2 else 3
			local ground = root.Position.Y - hip
			local flat = CFrame.new(root.Position) * CFrame.Angles(0, select(2, root.CFrame:ToEulerAnglesYXZ()), 0)
			local target = (flat * CFrame.new(follower.Offset)).Position
			local moving = root.AssemblyLinearVelocity.Magnitude > 2
			local bob = if follower.Floats then math.sin(t * 2.5 + follower.Phase) * 0.35 elseif moving then math.abs(math.sin(t * 9 + follower.Phase)) * 0.6 else 0
			target = Vector3.new(target.X, ground + follower.Height + bob, target.Z)
			local position = follower.CFrame.Position:Lerp(target, alpha)
			-- Face where the owner is going (or the owner, when standing still)
			local look = if moving then root.CFrame.LookVector else (root.Position - position)
			look = Vector3.new(look.X, 0, look.Z)
			local facing = if look.Magnitude > 0.01 then CFrame.lookAt(position, position + look) else CFrame.new(position)
			if (target - position).Magnitude > 80 then
				facing = CFrame.new(target) -- teleported: snap
			end
			follower.CFrame = facing
			local finalCf = facing
			if follower.Glitch and math.random() < 0.03 then
				finalCf = facing * CFrame.new(math.random() - 0.5, 0, math.random() - 0.5)
			end
			follower.Root.CFrame = finalCf
			local phase = t + follower.Phase
			for _, limb in follower.Limbs do
				local kind = limb.Kind
				local rotation
				if kind == "Wing" then
					rotation = CFrame.Angles(0, 0, math.sin(phase * 12) * 0.45 * limb.Side)
				elseif kind == "Tail" then
					rotation = CFrame.Angles(0, math.sin(phase * (if moving then 16 else 8)) * 0.4, 0)
				elseif kind == "Fluke" then
					rotation = CFrame.Angles(math.sin(phase * 3) * 0.22, 0, 0)
				elseif kind == "Fin" then
					rotation = CFrame.Angles(0, 0, math.sin(phase * 4) * 0.25 * limb.Side)
				elseif kind == "Tentacle" then
					rotation = CFrame.Angles(0, 0, math.sin(phase * 3 + limb.Side) * 0.2)
				elseif kind == "Spin" then
					rotation = CFrame.Angles(0, (t * 14) % (math.pi * 2), 0)
				elseif kind == "Orbit" then
					rotation = CFrame.Angles(0, (t * 1.3) % (math.pi * 2), 0)
				else
					rotation = CFrame.identity
				end
				limb.Weld.C0 = limb.Pivot * rotation * limb.Pivot:Inverse() * limb.Base
			end
			-- Blink: squash the eyes shut for a moment every few seconds
			local shut = t < follower.NextBlink + 0.12 and t >= follower.NextBlink
			if shut ~= follower.Blinking then
				follower.Blinking = shut
				for _, eye in follower.Eyes do
					eye.Part.Size = if shut then Vector3.new(eye.Size.X * 1.05, eye.Size.Y * 0.14, eye.Size.Z * 0.8) else eye.Size
					eye.Part.Color = if shut then Color3.fromRGB(40, 25, 30) else eye.Color
				end
				for _, pupil in follower.Pupils do
					pupil.Transparency = if shut then 1 else 0
				end
			end
			if t >= follower.NextBlink + 0.12 then
				follower.NextBlink = t + 2 + math.random() * 3.5
			end
			if #follower.Rainbow > 0 then
				local color = Color3.fromHSV((t * 0.25) % 1, 0.55, 1)
				for _, part in follower.Rainbow do
					part.Color = color
				end
			end
		end
	end
end

function Followers.Init()
	folder = Instance.new("Folder")
	folder.Name = "Followers"
	folder.Parent = workspace
	for _, player in Players:GetPlayers() do
		task.spawn(watch, player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(clear)
	RunService.RenderStepped:Connect(update)
end

return Followers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Guards</string>
            <string name="Source"><![CDATA[--[[
	Guards (client side)
	====================
	* Builds YOUR sleeping guard on every blanket (only you can see him; everyone has their own).
	* When you steal a donut the server spawns your chasing guard: your sleeping one disappears in a
	  puff of smoke, and pops back onto the blanket when the chase is over.
	* Other players' chasing guards are hidden, so you never see anyone else's Domers.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local GuardModel = require(Shared.GuardModel)

local player = Players.LocalPlayer :: Player

local Guards = {}

type Sleeper = { Model: Model, Status: TextLabel, Home: CFrame, Hidden: boolean }

local sleepers: { [number]: Sleeper } = {}
local folder: Folder

--------------------------------------------------------------------------------
-- Poof
--------------------------------------------------------------------------------
function Guards.Poof(position: Vector3, color: Color3?)
	local part = Instance.new("Part")
	part.Name = "Poof"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(4, 6, 4)
	part.CFrame = CFrame.new(position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color or Color3.fromRGB(255, 255, 255))
	emitter.LightEmission = 0.3
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Speed = NumberRange.new(6, 12)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 5
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 3.5) })
	emitter.Transparency = NumberSequence.new(0.2, 1)
	emitter.Rate = 0
	emitter.Parent = part
	part.Parent = folder
	emitter:Emit(28)
	task.delay(1.5, function()
		part:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- Sleeping guards (local only)
--------------------------------------------------------------------------------
local function setHidden(sleeper: Sleeper, hidden: boolean)
	if sleeper.Hidden == hidden then
		return
	end
	sleeper.Hidden = hidden
	sleeper.Model.Parent = if hidden then nil else folder
	Guards.Poof(sleeper.Home.Position + Vector3.new(0, 2, 0))
end

local function buildSleeper(areaId: number)
	local map = workspace:WaitForChild("Map")
	local lane = map:WaitForChild("Lane")
	local area = lane:WaitForChild("Area" .. areaId, 30)
	local marker = area and area:FindFirstChild("GuardHome", true)
	if not marker or not marker:IsA("BasePart") then
		return
	end
	local model, status = GuardModel.Build(areaId)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	local home = CFrame.new(marker.Position.X, 0, marker.Position.Z)
	model:PivotTo(GuardModel.SleepCFrame(home))
	model.Parent = folder
	sleepers[areaId] = { Model = model, Status = status, Home = home, Hidden = false }
end

--------------------------------------------------------------------------------
-- Chasing guards (server side): hide other players', swap ours with the sleeper
--------------------------------------------------------------------------------
local function hideForMe(model: Instance)
	local function hide(d: Instance)
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = 1
		elseif d:IsA("Decal") then
			d.LocalTransparencyModifier = 1
		elseif d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Highlight") or d:IsA("Fire") or d:IsA("Sparkles") or d:IsA("Smoke") then
			(d :: any).Enabled = false
		elseif d:IsA("Sound") then
			d.Volume = 0
		end
	end
	for _, d in model:GetDescendants() do
		hide(d)
	end
	model.DescendantAdded:Connect(hide)
end

local function onGuardAdded(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	local owner = instance:GetAttribute("OwnerUserId")
	if owner ~= player.UserId then
		hideForMe(instance)
		return
	end
	local areaId = instance:GetAttribute("Area")
	local sleeper = if type(areaId) == "number" then sleepers[areaId] else nil
	if sleeper then
		setHidden(sleeper, true)
	end
	local lastPosition = instance:GetPivot().Position
	local connection: RBXScriptConnection
	connection = RunService.Heartbeat:Connect(function()
		if instance.Parent then
			lastPosition = instance:GetPivot().Position
		else
			connection:Disconnect()
			-- The chase is over: he teleports back to his blanket.
			Guards.Poof(lastPosition + Vector3.new(0, 2, 0))
			if sleeper then
				setHidden(sleeper, false)
			end
		end
	end)
end

function Guards.Init()
	folder = Instance.new("Folder")
	folder.Name = "MyGuards"
	folder.Parent = workspace

	task.spawn(function()
		for areaId = 1, #Areas.List do
			buildSleeper(areaId)
		end
	end)

	for _, instance in CollectionService:GetTagged("Guard") do
		task.spawn(onGuardAdded, instance)
	end
	CollectionService:GetInstanceAddedSignal("Guard"):Connect(onGuardAdded)

	-- Snoring "Zzz"
	task.spawn(function()
		local frames = { "z", "zZ", "zZz", "zZzZ" }
		local frame = 0
		while true do
			task.wait(0.45)
			frame = frame % #frames + 1
			for _, sleeper in sleepers do
				if not sleeper.Hidden then
					sleeper.Status.Text = frames[frame]
				end
			end
		end
	end)
end

return Guards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">PetFX</string>
            <string name="Source"><![CDATA[--[[
	PetFX: animates pet eggs on this client (see PetModel.BuildEgg):
	  * eggs wobble (more and more as they get close to hatching), ready ones bounce
	  * rune rings orbit, light rays turn
	  * rainbow eggs cycle colours
	  * incubator eggs show a live countdown ("4m 12s" -> "READY! Open Pets 🐾")
	Only eggs near the camera are animated.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Format = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Format"))

local PetFX = {}

local RANGE = 160

type Spinner = { Weld: Weld, Base: CFrame, Speed: number, AxisZ: boolean }
type Egg = {
	Model: Model,
	Root: BasePart,
	Base: CFrame,
	Phase: number,
	Spinners: { Spinner },
	Rainbow: { BasePart },
	Countdown: TextLabel?,
}

local eggs: { [Instance]: Egg } = {}

local function register(instance: Instance)
	if not instance:IsA("Model") or eggs[instance] then
		return
	end
	local root = instance.PrimaryPart or instance:WaitForChild("Root", 5)
	if not root or not root:IsA("BasePart") then
		return
	end
	local spinners: { Spinner } = {}
	local rainbow: { BasePart } = {}
	for _, part in instance:GetDescendants() do
		if part:IsA("BasePart") then
			local speed = part:GetAttribute("Spin")
			local weld = part:FindFirstChildOfClass("Weld")
			if type(speed) == "number" and weld then
				table.insert(spinners, { Weld = weld, Base = weld.C0, Speed = speed, AxisZ = part.Name == "Rays" })
			end
			if instance:GetAttribute("Rainbow") and (part.Name == "Crack" or part.Name == "Spot" or part.Name == "Rune") then
				table.insert(rainbow, part)
			end
		end
	end
	local timer = root:FindFirstChild("EggTimer")
	local countdown = timer and timer:FindFirstChild("Countdown")
	eggs[instance] = {
		Model = instance,
		Root = root,
		Base = root.CFrame,
		Phase = math.random() * 6,
		Spinners = spinners,
		Rainbow = rainbow,
		Countdown = if countdown and countdown:IsA("TextLabel") then countdown else nil,
	}
end

function PetFX.Init()
	for _, instance in CollectionService:GetTagged("PetEgg") do
		task.spawn(register, instance)
	end
	CollectionService:GetInstanceAddedSignal("PetEgg"):Connect(function(instance)
		task.wait() -- let its children (the countdown label) arrive
		register(instance)
	end)
	CollectionService:GetInstanceRemovedSignal("PetEgg"):Connect(function(instance)
		eggs[instance] = nil
	end)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local now = workspace:GetServerTimeNow()
		local camera = workspace.CurrentCamera
		local cam = if camera then camera.CFrame.Position else Vector3.zero
		for instance, egg in eggs do
			if not instance.Parent then
				eggs[instance] = nil
				continue
			end
			if (egg.Root.Position - cam).Magnitude > RANGE then
				continue
			end
			local hatchAt = instance:GetAttribute("HatchAt")
			local left = if type(hatchAt) == "number" then hatchAt - now else nil
			if egg.Root.Anchored then
				-- Wobble: gentle normally, frantic in the last minute, bouncing when ready
				local strength = 0.08
				local speed = 2.2
				local lift = math.sin(t * 1.6 + egg.Phase) * 0.15
				if left and left <= 0 then
					strength, speed = 0.18, 9
					lift = math.abs(math.sin(t * 5 + egg.Phase)) * 0.6
				elseif left and left < 60 then
					strength, speed = 0.14, 7
				end
				egg.Root.CFrame = egg.Base * CFrame.new(0, lift, 0) * CFrame.Angles(math.sin(t * speed + egg.Phase) * strength, t * 0.3, math.cos(t * speed * 0.8 + egg.Phase) * strength)
			end
			for _, spinner in egg.Spinners do
				local angle = t * spinner.Speed
				spinner.Weld.C0 = spinner.Base * (if spinner.AxisZ then CFrame.Angles(0, 0, angle) else CFrame.Angles(0, angle, 0))
			end
			if #egg.Rainbow > 0 then
				for i, part in egg.Rainbow do
					part.Color = Color3.fromHSV((t * 0.3 + i * 0.08) % 1, 0.8, 1)
				end
			end
			if egg.Countdown and left then
				if left <= 0 then
					egg.Countdown.Text = "READY! Open Pets 🐾"
					egg.Countdown.TextColor3 = Color3.fromRGB(120, 255, 130)
				else
					egg.Countdown.Text = "⏳ " .. Format.Duration(left)
					egg.Countdown.TextColor3 = Color3.fromRGB(255, 255, 255)
				end
			end
		end
	end)
end

return PetFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--[[
	Client-side view of the local player's state.
	Numbers come from Player attributes (Money, Speed, Income...); tables come from the State remote.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local player = Players.LocalPlayer :: Player

export type Snapshot = {
	Passes: { [string]: boolean },
	OwnedSkins: { [string]: boolean },
	EquippedSkin: string,
	Discovered: { [string]: boolean },
	DiscoveredMutations: { [string]: { [string]: boolean } }?,
	IndexClaims: { [string]: string }?,
	PodiumMode: string,
	MusicVolume: number?,
	MusicOn: boolean?,
	Items: { [string]: boolean }?,
	PlotIndex: number?,
	Eggs: { { Uid: string, Id: string, HatchAt: number } }?,
	Pets: { { Uid: string, Id: string } }?,
	EquippedPets: { string }?,
	Favorite: string?, -- slot key of your favourite donut
	Donated: number?,
	HiddenItems: { [string]: boolean }?, -- items taken off the hotbar
	PermaLock: boolean?, -- admin: permanent Base Lock
	SeenTutorial: boolean?,
	SeenUpdate: number?,
	NotesOnLogin: boolean?,
	TutorialEggClaimed: boolean?,
	Admin: boolean?,
	GodMode: boolean?,
}

local State = {}

State.Data = {
	Passes = {},
	OwnedSkins = { Classic = true },
	EquippedSkin = "Classic",
	Discovered = {},
	PodiumMode = "Rarest",
	PlotIndex = nil,
	Eggs = {},
	Pets = {},
	EquippedPets = {},
} :: Snapshot

State.Changed = Signal.new()

function State.Get(name: string): any
	return player:GetAttribute(name)
end

function State.Number(name: string): number
	local value = player:GetAttribute(name)
	return if type(value) == "number" then value else 0
end

function State.OnAttribute(name: string, callback: (any) -> ())
	player:GetAttributeChangedSignal(name):Connect(function()
		callback(player:GetAttribute(name))
	end)
	callback(player:GetAttribute(name))
end

function State.Action(name: string, arg: any?)
	Remotes.Event("Action"):FireServer(name, arg)
end

Remotes.Event("State").OnClientEvent:Connect(function(snapshot: Snapshot)
	State.Data = snapshot
	State.Changed:Fire(snapshot)
end)

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Treadmill</string>
            <string name="Source"><![CDATA[--[[
	Treadmill (client): step onto your own treadmill and you're locked onto the belt, running in
	place automatically. Press Space / Jump (or the "Get off" button) to step off.
	While running: a "+speed" popup every second, the camera zooms out a little (FOV kick), speed
	lines streak across the screen, a trail in your treadmill's colour follows you, and every time
	you gain a whole point of WalkSpeed (every Config.Speed.SpeedPerWalk Speed) a "+1 WALK SPEED!"
	burst pops up.
	Every treadmill's LED strips and fan are animated here too (faster while someone runs on it).

	The server decides how much speed you actually get (TreadmillService); this only handles the
	feel.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Theme = require(script.Parent.UI.Theme)
local State = require(script.Parent.State)
local Bases = require(script.Parent.Bases)

local Treadmill = {}

local player = Players.LocalPlayer :: Player

local BELT_HALF_WIDTH = 3.3
local BELT_HALF_LENGTH = 6.8
local R6_RUN = "rbxassetid://180426354"
local R15_RUN = "rbxassetid://913376220"

local running = false
local pinned: CFrame? = nil
local track: AnimationTrack? = nil
local cooldownUntil = 0
local hint: Frame
local popupLayer: Frame
local rateLabel: TextLabel
local speedLines: Frame
local trail: Trail? = nil
local trailAttachments: { Attachment } = {}
local baseFov = 70
local lastWalkPoint = 0

local function getCharacter(): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return character, root, humanoid
end

local function getBelt(): BasePart?
	local plot = Bases.Mine()
	local treadmill = plot and plot:FindFirstChild("Treadmill")
	local belt = treadmill and treadmill:FindFirstChild("Belt")
	return if belt and belt:IsA("BasePart") then belt else nil
end

local function currentRate(): number
	local level = math.max(1, State.Number("TreadmillLevel"))
	return Economy.TreadmillRate(level, State.Number("SpeedMultLevel"), math.max(1, State.Number("SpeedPassMultiplier")), State.Number("Rebirths"), State.Number("IndexBonus"), State.Number("PetSpeedBonus"))
end

local function tierColor(): Color3
	return Economy.TreadmillTier(math.max(1, State.Number("TreadmillLevel"))).Accent
end

-- Trail + FOV kick + speed lines while running
local function setRunFX(on: boolean, root: BasePart?)
	local camera = workspace.CurrentCamera
	if camera then
		if on then
			baseFov = camera.FieldOfView
		end
		TweenService:Create(camera, TweenInfo.new(0.5, Enum.EasingStyle.Sine), { FieldOfView = if on then baseFov + 10 else baseFov }):Play()
	end
	speedLines.Visible = on
	if trail then
		trail:Destroy()
		trail = nil
	end
	for _, attachment in trailAttachments do
		attachment:Destroy()
	end
	trailAttachments = {}
	if on and root then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 1, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -1.5, 0)
		a1.Parent = root
		local t = Instance.new("Trail")
		t.Attachment0 = a0
		t.Attachment1 = a1
		t.Color = ColorSequence.new(tierColor(), Color3.new(1, 1, 1))
		t.LightEmission = 0.8
		t.Lifetime = 0.35
		t.Transparency = NumberSequence.new(0.3, 1)
		t.FaceCamera = true
		t.Parent = root
		trail = t
		trailAttachments = { a0, a1 }
	end
end

-- Streaks flying across the screen while you run
local function buildSpeedLines(parent: Instance)
	speedLines = Theme.new("Frame", { Name = "SpeedLines", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = parent })
	local lines = {}
	for i = 1, 14 do
		local line = Theme.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.75,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(math.random(80, 220), 3),
			Position = UDim2.fromScale(math.random(), (i - 0.5) / 14),
			Parent = speedLines,
		})
		table.insert(lines, { Frame = line, Speed = math.random(9, 16) / 10, Y = (i - 0.5) / 14 })
	end
	RunService.RenderStepped:Connect(function(dt: number)
		if not speedLines.Visible then
			return
		end
		for _, line in lines do
			local x = line.Frame.Position.X.Scale - dt * line.Speed
			if x < -0.15 then
				x = 1.15
				line.Frame.BackgroundColor3 = tierColor():Lerp(Color3.new(1, 1, 1), 0.5)
			end
			-- keep the middle of the screen clear
			local edge = math.abs(line.Y - 0.5) > 0.22
			line.Frame.BackgroundTransparency = if edge then 0.7 else 1
			line.Frame.Position = UDim2.fromScale(x, line.Y)
		end
	end)
end

-- "+1 WALK SPEED!" every time the Speed stat crosses a whole WalkSpeed point
local function walkSpeedBurst(points: number)
	local label = Theme.Label({
		Text = `+{points} WALK SPEED! 🏃`,
		TextColor3 = Color3.fromRGB(120, 255, 140),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(360, 56),
		StrokeThickness = 3.5,
		Parent = popupLayer,
	})
	local scale = Theme.new("UIScale", { Scale = 0.2, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = Theme.CurrentScale() * 1.1 }):Play()
	TweenService:Create(label, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.22) }):Play()
	task.delay(0.9, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.45)
		label:Destroy()
	end)
end

-- LED strips chase along every treadmill, the fans spin (both faster while someone runs on it)
local function startTreadmillAnimations()
	type LED = { Part: BasePart, Index: number, Model: Instance }
	local leds: { [Instance]: LED } = {}
	local fans: { [Instance]: { Model: Model, Base: CFrame } } = {}
	local function addLED(instance: Instance)
		if instance:IsA("BasePart") then
			leds[instance] = { Part = instance, Index = (instance:GetAttribute("LEDIndex") :: number?) or 0, Model = instance.Parent :: Instance }
		end
	end
	local function addFan(instance: Instance)
		if instance:IsA("Model") and instance.PrimaryPart then
			fans[instance] = { Model = instance, Base = instance:GetPivot() }
		end
	end
	for _, led in CollectionService:GetTagged("TreadmillLED") do
		addLED(led)
	end
	for _, fan in CollectionService:GetTagged("TreadmillFan") do
		addFan(fan)
	end
	CollectionService:GetInstanceAddedSignal("TreadmillLED"):Connect(addLED)
	CollectionService:GetInstanceAddedSignal("TreadmillFan"):Connect(function(instance)
		task.wait(0.2)
		addFan(instance)
	end)
	CollectionService:GetInstanceRemovedSignal("TreadmillLED"):Connect(function(instance)
		leds[instance] = nil
	end)
	CollectionService:GetInstanceRemovedSignal("TreadmillFan"):Connect(function(instance)
		fans[instance] = nil
	end)
	local fanAngle: { [Instance]: number } = {}
	RunService.RenderStepped:Connect(function(dt: number)
		local t = os.clock()
		local camera = workspace.CurrentCamera
		local cam = if camera then camera.CFrame.Position else Vector3.zero
		for instance, led in leds do
			if not instance.Parent then
				leds[instance] = nil
				continue
			end
			if (led.Part.Position - cam).Magnitude < 120 then
				local running = led.Model:GetAttribute("Running") == true
				local speed = if running then 14 else 3
				local wave = math.sin(t * speed - led.Index * 0.8)
				led.Part.Transparency = if running then 0.5 - wave * 0.5 else 0.35 - wave * 0.3
			end
		end
		for instance, fan in fans do
			if not instance.Parent then
				fans[instance] = nil
				continue
			end
			if (fan.Base.Position - cam).Magnitude < 120 then
				local running = (fan.Model.Parent :: Instance):GetAttribute("Running") == true
				fanAngle[instance] = (fanAngle[instance] or 0) + dt * (if running then 22 else 3)
				fan.Model:PivotTo(fan.Base * CFrame.Angles(fanAngle[instance], 0, 0))
			end
		end
	end)
end

-- Disable / enable walking input (so holding W doesn't fight the treadmill).
-- The controls object is looked up once in the background so this never yields.
local controls: any = nil
local function setControls(enabled: boolean)
	if not controls then
		return
	end
	pcall(function()
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end)
end

local function runAnimationId(character: Model, humanoid: Humanoid): string
	local animate = character:FindFirstChild("Animate")
	local runFolder = animate and animate:FindFirstChild("run")
	local anim = runFolder and runFolder:FindFirstChildOfClass("Animation")
	if anim and anim.AnimationId ~= "" then
		return anim.AnimationId
	end
	return if humanoid.RigType == Enum.HumanoidRigType.R15 then R15_RUN else R6_RUN
end

local function start(belt: BasePart, character: Model, root: BasePart, humanoid: Humanoid)
	running = true
	-- Stand in the middle of the belt, facing the console.
	local hip = if humanoid.RigType == Enum.HumanoidRigType.R15 then humanoid.HipHeight + root.Size.Y / 2 else 3
	local top = belt.Position.Y + belt.Size.Y / 2 + hip
	local center = Vector3.new(belt.Position.X, top, belt.Position.Z)
	pinned = CFrame.lookAt(center, center + belt.CFrame.LookVector * Vector3.new(1, 0, 1))
	humanoid.AutoRotate = false
	setControls(false)

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		local animation = Instance.new("Animation")
		animation.AnimationId = runAnimationId(character, humanoid)
		local ok, loaded = pcall(animator.LoadAnimation, animator, animation)
		if ok and loaded then
			loaded.Priority = Enum.AnimationPriority.Action
			loaded.Looped = true
			loaded:Play(0.2)
			loaded:AdjustSpeed(1.4)
			track = loaded
		end
	end
	rateLabel.Text = `🏃 RUNNING!  +{Format.Rate(currentRate())} ⚡/s`
	hint.Visible = true
	lastWalkPoint = math.floor(State.Number("Speed") / Config.Speed.SpeedPerWalk)
	setRunFX(true, root)
end

local function stop(stepOff: boolean)
	if not running then
		return
	end
	-- Everything here is instant (no yields) so the belt can't re-grab you mid-step.
	running = false
	cooldownUntil = os.clock() + 1
	local _, root, humanoid = getCharacter()
	if stepOff and root and pinned then
		-- Hop off the back so you don't instantly step back on.
		root.CFrame = pinned * CFrame.new(0, 0, BELT_HALF_LENGTH + 3)
	end
	pinned = nil
	hint.Visible = false
	if humanoid then
		humanoid.AutoRotate = true
	end
	if track then
		track:Stop(0.2)
		track = nil
	end
	setControls(true)
	setRunFX(false, nil)
end

local function isOnBelt(belt: BasePart, position: Vector3): boolean
	local localPos = belt.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) < BELT_HALF_WIDTH and math.abs(localPos.Z) < BELT_HALF_LENGTH and localPos.Y > 0 and localPos.Y < 8
end

local function popup()
	local amount = currentRate()
	local label = Theme.Label({
		Text = "+" .. Format.Rate(amount) .. " ⚡",
		TextColor3 = Color3.fromRGB(200, 150, 255),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(math.random(10, 90) / 100, math.random(18, 78) / 100),
		Size = UDim2.fromOffset(190, 54),
		Rotation = math.random(-12, 12),
		StrokeThickness = 3,
		Parent = popupLayer,
	})
	local scale = Theme.new("UIScale", { Scale = 0.2, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = Theme.CurrentScale() }):Play()
	TweenService:Create(label, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = label.Position - UDim2.fromOffset(0, 60) }):Play()
	task.delay(0.6, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.4), { Transparency = 1 }):Play()
		end
		task.wait(0.45)
		label:Destroy()
	end)
end

function Treadmill.IsRunning(): boolean
	return running
end

function Treadmill.Init()
	task.spawn(function()
		pcall(function()
			local playerModule = require((player :: any).PlayerScripts:WaitForChild("PlayerModule", 10)) :: any
			controls = playerModule:GetControls()
		end)
	end)
	local gui = Theme.ScreenGui("Treadmill", 4)
	buildSpeedLines(gui)
	popupLayer = Theme.new("Frame", { Name = "Popups", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
	startTreadmillAnimations()
	State.OnAttribute("Speed", function(value)
		if running and type(value) == "number" then
			local point = math.floor(value / Config.Speed.SpeedPerWalk)
			if point > lastWalkPoint then
				walkSpeedBurst(point - lastWalkPoint)
			end
			lastWalkPoint = point
		end
	end)

	hint = Theme.new("Frame", {
		Name = "RunningHint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, if Theme.IsTouch then -150 else -24),
		Size = UDim2.fromOffset(420, 110),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	Theme.AutoScale(hint)
	rateLabel = Theme.Label({ Text = "", TextColor3 = Color3.fromRGB(210, 170, 255), Size = UDim2.new(1, 0, 0, 44), StrokeThickness = 3, Parent = hint })
	local getOff = Theme.Button({
		Text = if Theme.IsTouch then "GET OFF" else "GET OFF (Space)",
		Color = Theme.Colors.Red,
		Size = UDim2.fromOffset(260, 56),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 50),
		Parent = hint,
	})
	getOff.Activated:Connect(function()
		stop(true)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if running and not processed and (input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA) then
			stop(true)
		end
	end)
	UserInputService.JumpRequest:Connect(function()
		if running then
			stop(true)
		end
	end)

	-- Keep the character pinned to the belt (before physics and before rendering).
	local function pin()
		if not running or not pinned then
			return
		end
		local _, root = getCharacter()
		if root then
			root.CFrame = pinned
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end
	RunService.Stepped:Connect(pin)
	RunService.RenderStepped:Connect(pin)

	-- Detect stepping on / leaving the treadmill
	task.spawn(function()
		while true do
			task.wait(0.1)
			local character, root, humanoid = getCharacter()
			local belt = getBelt()
			if running then
				if not character or not root or not humanoid or humanoid.Health <= 0 or not belt or player:GetAttribute("CarryingDonut") then
					stop(false)
				end
			elseif character and root and humanoid and belt and os.clock() > cooldownUntil and humanoid.Health > 0 then
				if isOnBelt(belt, root.Position) and not player:GetAttribute("CarryingDonut") then
					start(belt, character, root, humanoid)
				end
			end
		end
	end)

	-- One popup per second while running
	task.spawn(function()
		while true do
			task.wait(1)
			if running then
				popup()
				rateLabel.Text = `🏃 RUNNING!  +{Format.Rate(currentRate())} ⚡/s`
			end
		end
	end)

	player.CharacterAdded:Connect(function()
		running = false
		pinned = nil
		track = nil
		hint.Visible = false
		setControls(true)
		setRunFX(false, nil)
	end)
end

return Treadmill
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="66">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Admin</string>
              <string name="Source"><![CDATA[--[[
	Admin panel: opens when you type the admin code in chat (the server spots it, hides it from
	everyone else and replies with AdminPanel). Every button just asks the server
	(Action "Admin" { Cmd, Arg }); the server decides (AdminService).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Areas = require(Shared.Areas)
local Donuts = require(Shared.Donuts)
local Rarities = require(Shared.Rarities)
local Pets = require(Shared.Pets)
local Crates = require(Shared.Crates)
local Events = require(Shared.Events)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Admin = {}

local modal: Modal.Modal
local scroll: ScrollingFrame
local order = 0

local function command(cmd: string, arg: any?)
	State.Action("Admin", { Cmd = cmd, Arg = arg })
end

local function section(title: string, cellWidth: number?): Frame
	order += 1
	Theme.Label({ Text = title, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = order, Parent = scroll })
	order += 1
	return Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = scroll }, {
		Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(cellWidth or 128, 40), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
end

local function button(parent: Instance, text: string, color: Color3, onClick: () -> ()): TextButton
	local b = Theme.Button({ Text = text, Color = color, Size = UDim2.new(), Parent = parent })
	b.Activated:Connect(onClick)
	return b
end

-- HD Admin-style commands: pick who (me / everyone / others / a player), type a value if the
-- command needs one, press the command.
local function buildHD()
	order += 1
	Theme.Label({ Text = "👥 PLAYER COMMANDS (HD Admin)", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = order, Parent = scroll })
	order += 1
	local row = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = order, Parent = scroll })
	local choices: { { Label: string, Target: any } } = {}
	local choice = 1
	local targetButton = Theme.Button({ Text = "", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(250, 40), Parent = row })
	local function refreshChoices()
		local current = choices[choice]
		choices = { { Label = "🙋 Me", Target = "me" }, { Label = "🌍 Everyone", Target = "all" }, { Label = "👥 Everyone else", Target = "others" } }
		for _, other in Players:GetPlayers() do
			if other ~= Players.LocalPlayer then
				table.insert(choices, { Label = "👤 " .. other.DisplayName, Target = other.UserId })
			end
		end
		choice = 1
		for i, entry in choices do
			if current and entry.Target == current.Target then
				choice = i
			end
		end
		Theme.SetButtonText(targetButton, "Target: " .. choices[choice].Label .. "  ▸")
	end
	targetButton.Activated:Connect(function()
		refreshChoices()
		choice = choice % #choices + 1
		Theme.SetButtonText(targetButton, "Target: " .. choices[choice].Label .. "  ▸")
	end)
	Players.PlayerAdded:Connect(refreshChoices)
	Players.PlayerRemoving:Connect(function()
		task.defer(refreshChoices)
	end)
	refreshChoices()
	local valueBox = Theme.new("TextBox", {
		Size = UDim2.new(1, -262, 0, 40), Position = UDim2.fromOffset(262, 0),
		BackgroundColor3 = Theme.Colors.PanelLight, TextColor3 = Color3.new(1, 1, 1), PlaceholderText = "value: number or message",
		PlaceholderColor3 = Color3.fromRGB(170, 170, 190), Text = "", Font = Theme.Font, TextScaled = true, ClearTextOnFocus = false, Parent = row,
	}, { Theme.Corner(10), Theme.Stroke(2) })
	local function run(action: string)
		command("HD", { Action = action, Target = choices[choice].Target, Value = if valueBox.Text ~= "" then (tonumber(valueBox.Text) or valueBox.Text) else nil })
	end
	type Entry = { Text: string, Action: string, Color: Color3, Cmd: string? }
	local groups: { { Title: string, Entries: { Entry } } } = {
		{ Title = "Health", Entries = {
			{ Text = "💀 Kill", Action = "kill", Color = Theme.Colors.Red }, { Text = "🔄 Respawn", Action = "respawn", Color = Theme.Colors.Gray },
			{ Text = "❤️ Heal", Action = "heal", Color = Theme.Colors.Green }, { Text = "😇 God", Action = "god", Color = Theme.Colors.Yellow },
			{ Text = "🙂 Ungod", Action = "ungod", Color = Theme.Colors.Gray }, { Text = "🛡 Forcefield", Action = "ff", Color = Theme.Colors.Blue },
			{ Text = "❌ Unforcefield", Action = "unff", Color = Theme.Colors.Gray }, { Text = "💥 Explode", Action = "explode", Color = Theme.Colors.Orange },
		} },
		{ Title = "Control", Entries = {
			{ Text = "🧊 Freeze", Action = "freeze", Color = Theme.Colors.Blue }, { Text = "🔥 Thaw", Action = "thaw", Color = Theme.Colors.Orange },
			{ Text = "🔒 Jail", Action = "jail", Color = Theme.Colors.Gray }, { Text = "🔓 Unjail", Action = "unjail", Color = Theme.Colors.Green },
			{ Text = "🧲 Bring", Action = "bring", Color = Theme.Colors.Purple }, { Text = "🚀 Go to", Action = "goto", Color = Theme.Colors.Purple },
			{ Text = "🌪 Fling", Action = "fling", Color = Theme.Colors.Red }, { Text = "🪑 Sit", Action = "sit", Color = Theme.Colors.Gray },
		} },
		{ Title = "Body (value = number)", Entries = {
			{ Text = "🏃 Speed", Action = "speed", Color = Theme.Colors.Green }, { Text = "🚶 Normal speed", Action = "unspeed", Color = Theme.Colors.Gray },
			{ Text = "🦘 Jump power", Action = "jump", Color = Theme.Colors.Green }, { Text = "📏 Size", Action = "size", Color = Theme.Colors.Purple },
			{ Text = "👻 Invisible", Action = "invisible", Color = Theme.Colors.Gray }, { Text = "👀 Visible", Action = "visible", Color = Theme.Colors.Blue },
			{ Text = "🧱 Noclip", Action = "noclip", Color = Theme.Colors.Purple }, { Text = "🧍 Clip", Action = "clip", Color = Theme.Colors.Gray },
		} },
		{ Title = "Effects", Entries = {
			{ Text = "✨ Sparkles", Action = "sparkles", Color = Theme.Colors.Yellow }, { Text = "🔥 Fire", Action = "fire", Color = Theme.Colors.Orange },
			{ Text = "💨 Smoke", Action = "smoke", Color = Theme.Colors.Gray }, { Text = "🧹 Remove effects", Action = "unfx", Color = Theme.Colors.Gray },
		} },
		{ Title = "🛡 Admin access (owner only; saved, the code stops working for them)", Entries = {
			{ Text = "🚫 Remove admin", Action = "", Cmd = "RevokeAdmin", Color = Theme.Colors.Red },
			{ Text = "✅ Give admin back", Action = "", Cmd = "RestoreAdmin", Color = Theme.Colors.Green },
		} },
		{ Title = "Moderation", Entries = {
			{ Text = "👢 Kick", Action = "kick", Color = Theme.Colors.Red }, { Text = "⛔ Ban (this server)", Action = "ban", Color = Theme.Colors.Red },
			{ Text = "✅ Unban all", Action = "unbanall", Color = Theme.Colors.Green },
		} },
		{ Title = "Server (value = message / hour / gravity)", Entries = {
			{ Text = "📢 Announce", Action = "announce", Color = Theme.Colors.Yellow }, { Text = "🕒 Time of day", Action = "time", Color = Theme.Colors.Blue },
			{ Text = "🌙 Gravity", Action = "gravity", Color = Theme.Colors.Purple }, { Text = "🛑 Shut down", Action = "shutdown", Color = Theme.Colors.Red },
		} },
	}
	for _, group in groups do
		local grid = section(group.Title, 150)
		for _, entry in group.Entries do
			button(grid, entry.Text, entry.Color, function()
				if entry.Cmd then
					command(entry.Cmd, choices[choice].Target)
				else
					run(entry.Action)
				end
			end)
		end
	end
end

local function build()
	buildHD()
	-- Money
	local money = section("💵 Money")
	for _, entry in { { Text = "+1K", Amount = 1e3 }, { Text = "+1M", Amount = 1e6 }, { Text = "+1B", Amount = 1e9 }, { Text = "+1T", Amount = 1e12 }, { Text = "+1Qa", Amount = 1e15 }, { Text = "+1Qi", Amount = 1e18 } } do
		button(money, entry.Text, Theme.Colors.Green, function()
			command("Money", entry.Amount)
		end)
	end
	button(money, "x10 money", Theme.Colors.Green, function()
		command("Money", "x10")
	end)

	-- Speed + upgrades
	local speed = section("⚡ Speed & upgrades")
	for _, amount in { 10, 90, 500 } do
		button(speed, `+{amount} speed`, Theme.Colors.Purple, function()
			command("Speed", amount)
		end)
	end
	button(speed, "Reset speed", Theme.Colors.Gray, function()
		command("ResetSpeed")
	end)
	button(speed, "Max treadmill", Theme.Colors.Orange, function()
		command("MaxTreadmill")
	end)
	button(speed, "+1 Rebirth", Theme.Colors.Yellow, function()
		command("Rebirth")
	end)
	button(speed, "+Expansion / floor", Theme.Colors.Blue, function()
		command("Expand")
	end)

	-- Your base
	local base = section("🏠 Your base", 170)
	local lock = button(base, "🔒 Permanent lock", Theme.Colors.Red, function()
		command("PermaLock")
	end)
	State.Changed:Connect(function()
		Theme.SetButtonText(lock, if State.Data.PermaLock then "🔓 Unlock base" else "🔒 Permanent lock")
		Theme.SetButtonColor(lock, if State.Data.PermaLock then Theme.Colors.Green else Theme.Colors.Red)
	end)
	button(base, "💸 Reset money", Theme.Colors.Gray, function()
		command("ResetMoney")
	end)
	button(base, "🍩 Clear all donuts", Theme.Colors.Gray, function()
		command("ClearDonuts")
	end)

	-- Donuts: pick one, a mutation and a size
	local donutSection = section("🍩 Donuts (pick one, then give or spawn it)", 150)
	local mutations = { "None" }
	for _, mutation in Rarities.Mutations do
		if mutation.Order > 0 then
			table.insert(mutations, mutation.Id)
		end
	end
	local sizes = {}
	for _, size in Rarities.Sizes do
		table.insert(sizes, size.Id)
	end
	local selected = Donuts.List[1].Id
	local mutationIndex, sizeIndex = 1, 2
	local selectedLabel: TextButton
	local mutationButton: TextButton
	local sizeButton: TextButton
	local function refreshSelection()
		local donut = Donuts.ById[selected]
		Theme.SetButtonText(selectedLabel, donut.Name)
		Theme.SetButtonColor(selectedLabel, Rarities.Get(donut.Rarity).Color)
		Theme.SetButtonText(mutationButton, "Mutation: " .. mutations[mutationIndex])
		Theme.SetButtonText(sizeButton, "Size: " .. sizes[sizeIndex])
	end
	selectedLabel = button(donutSection, "", Theme.Colors.Gray, function() end)
	mutationButton = button(donutSection, "", Theme.Colors.Pink, function()
		mutationIndex = mutationIndex % #mutations + 1
		refreshSelection()
	end)
	sizeButton = button(donutSection, "", Theme.Colors.Blue, function()
		sizeIndex = sizeIndex % #sizes + 1
		refreshSelection()
	end)
	button(donutSection, "➕ Give to base", Theme.Colors.Green, function()
		command("Donut", { DonutId = selected, Mutation = mutations[mutationIndex], Size = sizes[sizeIndex] })
	end)
	button(donutSection, "📍 Spawn in lane", Theme.Colors.Orange, function()
		command("SpawnDonut", { DonutId = selected, Mutation = mutations[mutationIndex], Size = sizes[sizeIndex] })
	end)
	local list = section("", 150)
	local sorted = table.clone(Donuts.List)
	table.sort(sorted, function(a, b)
		local ra, rb = Rarities.Get(a.Rarity).Order, Rarities.Get(b.Rarity).Order
		if ra ~= rb then
			return ra > rb
		end
		return a.Income > b.Income
	end)
	for _, donut in sorted do
		local b = button(list, donut.Name, Rarities.Get(donut.Rarity).Color, function()
			selected = donut.Id
			refreshSelection()
		end)
		b.LayoutOrder = Rarities.Get(donut.Rarity).Order * -1000 + donut.Index
	end
	refreshSelection()

	-- Eggs & pets
	local eggs = section("🥚 Eggs & pets", 150)
	for _, egg in Pets.Eggs do
		button(eggs, "+ " .. egg.Name, egg.Accent, function()
			command("Egg", egg.Id)
		end)
	end
	button(eggs, "Hatch all NOW", Theme.Colors.Green, function()
		command("HatchAll")
	end)
	button(eggs, "Clear incubator", Theme.Colors.Gray, function()
		command("ClearEggs")
	end)
	local pets = section("", 150)
	for _, pet in Pets.List do
		button(pets, "+ " .. pet.Name, Pets.Rarity(pet.Rarity).Color, function()
			command("Pet", pet.Id)
		end)
	end

	-- Crates
	local crates = section("🎁 Crates (open = free, spawn = in the area you're in)", 150)
	for _, crate in Crates.List do
		button(crates, "Open " .. crate.Name, crate.Color, function()
			command("OpenCrate", crate.Id)
		end)
	end
	for _, crate in Crates.List do
		button(crates, "Spawn " .. crate.Id, crate.Color:Lerp(Color3.new(0, 0, 0), 0.3), function()
			command("SpawnCrate", crate.Id)
		end)
	end

	-- Fun
	local fun = section("✨ Fun", 150)
	button(fun, "🍀 Luck Event", Theme.Colors.Green, function()
		command("Luck")
	end)
	button(fun, "🎲 Random event", Theme.Colors.Orange, function()
		command("Event")
	end)
	button(fun, "🕊 Fly", Theme.Colors.Blue, function()
		command("Fly", "Fly")
	end)
	button(fun, "🧞 Magic carpet", Theme.Colors.Pink, function()
		command("Fly", "Carpet")
	end)
	button(fun, "🚶 Stop flying", Theme.Colors.Gray, function()
		command("Fly", "Off")
	end)
	local god = button(fun, `🛡 {Config.Guard.Name} can't catch me`, Theme.Colors.Purple, function()
		command("GodMode")
	end)
	State.Changed:Connect(function()
		Theme.SetButtonColor(god, if State.Data.GodMode then Theme.Colors.Green else Theme.Colors.Purple)
	end)

	-- Server events (whole server, one at a time)
	local events = section("🌍 Start a server event (for the whole server)", 150)
	for _, event in Events.List do
		button(events, `{event.Icon} {event.Name}`, event.Color, function()
			command("Event", event.Id)
		end)
	end

	-- Teleport
	local teleport = section("🌀 Teleport to area", 60)
	for _, area in Areas.List do
		button(teleport, tostring(area.Id), area.Trim, function()
			command("Teleport", area.Id)
		end)
	end
end

function Admin.Open()
	if State.Get("Admin") == true then
		modal:Open()
	end
end

function Admin.Init()
	modal = Modal.new("🛠 ADMIN PANEL", Theme.Colors.Red, Vector2.new(720, 520))
	scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		Parent = modal.Body,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
	})
	local built = false
	modal.OnOpen = function()
		if not built then
			built = true
			build()
		end
	end
	Remotes.Event("AdminPanel").OnClientEvent:Connect(function()
		modal:Open()
	end)
	-- Admin taken away: close the panel
	State.OnAttribute("Admin", function(value)
		if value ~= true and modal:IsOpen() then
			modal:Close()
		end
	end)
end

return Admin
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Chase</string>
              <string name="Source"><![CDATA[--[[
	Chase UI: everything that happens during a steal.
	  - "RUN!" banner with live distance to the guard and to the safe zone, red screen edges
	  - Domer's footsteps: heavy thuds that get louder as he closes in, and the camera shakes when
	    he's right behind you (Config.Guard FootstepRange / ShakeRange / MaxShake)
	  - "SAFE!" message and a glowing path to your base while you carry the donut home
	  - "CAUGHT!" screen (with a comedic fling) or a celebration when the donut is secured
	  - Base alarm: a siren, red edges and a red outline on the thief when someone steals from you
	  - "Welcome back" popup for offline earnings
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Donuts = require(Shared.Donuts)
local Rarities = require(Shared.Rarities)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Pets = require(Shared.Pets)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Bases = require(script.Parent.Parent.Bases)

local Chase = {}

local player = Players.LocalPlayer :: Player

local STEP_SOUND = "rbxasset://sounds/action_jump_land.mp3"
local SIREN_SOUND = "rbxasset://sounds/electronicpingshort.wav"

local gui: ScreenGui
local banner: Frame
local bannerTitle: TextLabel
local bannerInfo: TextLabel
local edges: { Frame } = {}
local chaseConnection: RBXScriptConnection? = nil
local beam: Beam? = nil
local beamAttachments: { Attachment } = {}
local alarmConnection: RBXScriptConnection? = nil
local thiefHighlight: Highlight? = nil

local function rootPart(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function humanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function setEdges(visible: boolean, color: Color3?)
	for _, edge in edges do
		edge.Visible = visible
		if color then
			edge.BackgroundColor3 = color
		end
	end
end

local function setEdgeStrength(alpha: number)
	for _, edge in edges do
		local gradient = edge:FindFirstChildOfClass("UIGradient")
		if gradient then
			gradient.Transparency = NumberSequence.new(alpha, 1)
		end
	end
end

local function showBanner(visible: boolean)
	banner.Visible = visible
	Notifications.SetToastOffset(if visible then 84 else 0)
end

local function clearBeam()
	if beam then
		beam:Destroy()
		beam = nil
	end
	for _, attachment in beamAttachments do
		attachment:Destroy()
	end
	beamAttachments = {}
end

-- Glowing guide line from you to your base (it's in the world you're in).
local function showPathHome()
	clearBeam()
	local root = rootPart()
	local plot = Bases.Mine()
	local target = plot and plot:FindFirstChild("Spawn")
	if not root or not target or not target:IsA("BasePart") then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 1, 0)
	a1.Parent = target
	local b = Instance.new("Beam")
	b.Attachment0 = a0
	b.Attachment1 = a1
	b.Color = ColorSequence.new(Theme.Colors.Yellow)
	b.Width0 = 1.2
	b.Width1 = 1.2
	b.FaceCamera = true
	b.LightEmission = 1
	b.Transparency = NumberSequence.new(0.3)
	b.Parent = root
	beam = b
	beamAttachments = { a0, a1 }
end

local function resetShake()
	local h = humanoid()
	if h then
		h.CameraOffset = Vector3.zero
	end
end

local function stopChaseLoop()
	if chaseConnection then
		chaseConnection:Disconnect()
		chaseConnection = nil
	end
	resetShake()
end

local function hideBanner()
	stopChaseLoop()
	showBanner(false)
	setEdges(false)
end

-- One heavy footstep from the guard (a 3D sound on him, so you hear where he is).
local function footstep(guardRoot: BasePart, volume: number)
	local sound = Instance.new("Sound")
	sound.SoundId = STEP_SOUND
	sound.Volume = volume
	sound.PlaybackSpeed = 0.42 + math.random() * 0.08
	sound.RollOffMinDistance = 20
	sound.RollOffMaxDistance = Config.Guard.FootstepRange * 2
	sound.Parent = guardRoot
	sound:Play()
	task.delay(2, function()
		sound:Destroy()
	end)
end

type ChaseInfo = { DonutId: string, AreaId: number, Kind: string?, Guard: Model?, GuardSpeed: number?, Raid: boolean?, Mutation: string?, Size: string?, Victim: Player? }

local function onChaseStarted(info: ChaseInfo)
	local kind = info.Kind or (if info.Raid then "Raid" else "Lane")
	local donut = Donuts.ById[info.DonutId]
	local rarity = donut and Rarities.Get(donut.Rarity)
	local size = Rarities.Size(info.Size)
	showBanner(true)
	if kind == "Raid" then
		local owner = if info.Victim then info.Victim.DisplayName else "the owner"
		bannerTitle.Text = `🐌 SLOW MODE! GET HOME BEFORE {string.upper(owner)} HITS YOU!`
	else
		bannerTitle.Text = `🏃 RUN! {string.upper(Config.Guard.Name)} IS AFTER YOU!`
	end
	bannerTitle.TextColor3 = Color3.fromRGB(255, 80, 80)
	setEdges(true, Color3.fromRGB(255, 0, 0))
	Theme.PlaySound("Grab")
	Theme.PlaySound("Steal")
	if kind == "Egg" then
		local egg = Pets.EggById[info.DonutId]
		if egg then
			Notifications.Toast(`You grabbed a {egg.Name}! Bring it to your incubator!`, "rare")
		end
	elseif donut and rarity then
		Notifications.Toast(`You grabbed {Rarities.DisplayName(donut.Name, info.Mutation, info.Size)} ({rarity.Id})!`, "rare")
		if size.CarrySpeed < 1 then
			Notifications.Toast(`🐌 It's {string.lower(size.Id)}! You're {math.floor((1 - size.CarrySpeed) * 100 + 0.5)}% slower while carrying it.`, "error")
		end
	end

	stopChaseLoop()
	if kind == "Raid" then
		showPathHome()
	end
	local pulse = 0
	local nextStep = 0
	chaseConnection = RunService.RenderStepped:Connect(function(dt)
		pulse += dt
		local root = rootPart()
		if not root then
			return
		end
		local text
		if kind == "Raid" then
			local beamTarget = beamAttachments[2]
			local home = beamTarget and beamTarget.WorldPosition
			text = if home then `🏠 Your base: {math.floor((home - root.Position).Magnitude)} studs` else "🏠 Get to your base!"
		else
			local toSafe = math.max(0, root.Position.Z - Config.Map.SafeZoneZ)
			text = `🛡 Safe zone: {math.floor(toSafe)} studs`
		end
		local closeness = 0
		local guard = info.Guard
		local guardRoot = guard and guard.Parent and guard.PrimaryPart
		if guardRoot then
			local offset = guardRoot.Position - root.Position
			local gap = Vector2.new(offset.X, offset.Z).Magnitude
			text ..= `   •   😡 {Config.Guard.Name}: {math.floor(gap)} studs behind`
			-- Footsteps (faster the faster he runs) and screen shake when he's close
			local speed = Vector2.new(guardRoot.AssemblyLinearVelocity.X, guardRoot.AssemblyLinearVelocity.Z).Magnitude
			if gap < Config.Guard.FootstepRange and speed > 2 and pulse >= nextStep then
				local stride = 2.2 * Config.Guard.Scale
				nextStep = pulse + math.clamp(stride / speed, 0.17, 0.6)
				footstep(guardRoot, math.clamp(1.4 * (1 - gap / Config.Guard.FootstepRange), 0.15, 1.4))
			end
			closeness = math.clamp(1 - gap / Config.Guard.ShakeRange, 0, 1)
		end
		local h = humanoid()
		if h then
			if closeness > 0 then
				local strength = Config.Guard.MaxShake * closeness ^ 1.4
				h.CameraOffset = Vector3.new(math.noise(pulse * 18, 0.3) * strength, math.noise(pulse * 18, 7.1) * strength, 0)
			elseif h.CameraOffset ~= Vector3.zero then
				h.CameraOffset = Vector3.zero
			end
		end
		bannerInfo.Text = text
		-- The red glow pulses faster and stronger the closer he gets
		local rate = 5 + closeness * 10
		setEdgeStrength(0.6 - closeness * 0.35 + math.sin(pulse * rate) * 0.1)
	end)
end

local function flingSelf(velocity: Vector3?)
	local character = player.Character
	local root = rootPart()
	local h = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not h then
		return
	end
	h:ChangeState(Enum.HumanoidStateType.FallingDown)
	-- Caught: launched high and far back towards the hub, spinning (like getting bonked in Steal an Egg)
	root.AssemblyLinearVelocity = velocity or Vector3.new(math.random(-25, 25), 95, -130)
	root.AssemblyAngularVelocity = Vector3.new(math.random(-12, 12), math.random(-12, 12), math.random(-12, 12))
	Theme.PlaySound("Fling")
	task.delay(if velocity then 1.2 else 1.9, function()
		if h.Parent then
			h:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

local function bigText(text: string, color: Color3, duration: number)
	local label = Theme.Label({
		Text = text,
		TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.fromScale(0.7, 0.12),
		StrokeThickness = 5,
		Parent = gui,
	})
	local scale = Theme.new("UIScale", { Scale = 0.3, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(duration, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.4)
		label:Destroy()
	end)
end

type ChaseResult = { Result: string, DonutId: string?, IsNew: boolean?, Reason: string?, Mutation: string?, Size: string?, Kind: string?, EggId: string? }

local function onChaseEnded(result: ChaseResult)
	if result.Result == "Safe" then
		stopChaseLoop()
		setEdges(true, Color3.fromRGB(0, 170, 255))
		bannerTitle.Text = if result.Kind == "Egg" then "🛡 SAFE! Bring the egg to your base!" else "🛡 SAFE! Bring the donut to your base!"
		bannerTitle.TextColor3 = Color3.fromRGB(110, 210, 255)
		bannerInfo.Text = "Follow the yellow line ⬇"
		task.delay(1.2, function()
			if bannerTitle.Text:find("SAFE") then
				setEdges(false)
			end
		end)
		showPathHome()
	elseif result.Result == "Deposited" then
		hideBanner()
		clearBeam()
		if result.Kind == "Egg" then
			local egg = result.EggId and Pets.EggById[result.EggId]
			bigText("🥚 EGG SECURED!", if egg then egg.Accent else Theme.Colors.Pink, 2)
			Theme.PlaySound("Deposit")
			return
		end
		local donut = result.DonutId and Donuts.ById[result.DonutId]
		if donut then
			local rarity = Rarities.Get(donut.Rarity)
			local mutation = Rarities.Mutation(result.Mutation)
			local color = if mutation.Order > 0 then mutation.Color else rarity.Color
			bigText(if result.IsNew then "✨ NEW DONUT! ✨" else "🍩 DONUT SECURED!", color, 2)
			local income = Economy.DonutIncome(donut.Id, 1, result.Mutation, result.Size)
			Notifications.Banner(Rarities.DisplayName(donut.Name, result.Mutation, result.Size), color, 2.5, `{rarity.Id} • {Format.Money(income)}/s`)
		end
		Theme.PlaySound("Deposit")
	elseif result.Result == "Caught" then
		hideBanner()
		clearBeam()
		setEdges(true, Color3.fromRGB(255, 0, 0))
		bigText(`CAUGHT BY {string.upper(Config.Guard.Name)}!`, Color3.fromRGB(255, 70, 70), 1.8)
		Notifications.Toast("It went back where you found it. Try again!", "error")
		Theme.PlaySound("Caught")
		flingSelf()
		task.delay(1.5, function()
			setEdges(false)
		end)
	else -- Lost
		hideBanner()
		clearBeam()
		if result.Reason then
			Notifications.Toast(result.Reason, "error")
		end
	end
end

--------------------------------------------------------------------------------
-- Base alarm (someone is stealing from you)
--------------------------------------------------------------------------------
local function siren(seconds: number)
	local custom = Config.Raid.AlarmSoundId
	if custom ~= "" then
		local sound = Instance.new("Sound")
		sound.SoundId = custom
		sound.Volume = 0.6
		SoundService:PlayLocalSound(sound)
		task.delay(seconds + 3, function()
			sound:Destroy()
		end)
		return
	end
	-- A two-tone siren made of Roblox's built-in ping
	task.spawn(function()
		local steps = math.floor(seconds / 0.3)
		for i = 1, steps do
			local sound = Instance.new("Sound")
			sound.SoundId = SIREN_SOUND
			sound.Volume = 0.45
			sound.PlaybackSpeed = if i % 2 == 0 then 1.7 else 1.25
			SoundService:PlayLocalSound(sound)
			task.delay(1, function()
				sound:Destroy()
			end)
			task.wait(0.3)
		end
	end)
end

local function stopAlarm()
	if alarmConnection then
		alarmConnection:Disconnect()
		alarmConnection = nil
	end
	if thiefHighlight then
		thiefHighlight:Destroy()
		thiefHighlight = nil
	end
	if not chaseConnection and bannerTitle.Text:find("STOLE") then
		showBanner(false)
		setEdges(false)
	end
end

type AlarmInfo = { Stage: string, Thief: Player?, Name: string? }

local function onAlarm(info: AlarmInfo)
	local thief = info.Thief
	local thiefName = if thief then thief.DisplayName else "Someone"
	if info.Stage == "Started" then
		siren(1.2)
		setEdges(true, Color3.fromRGB(255, 40, 40))
		setEdgeStrength(0.45)
		task.delay(1.5, function()
			if not chaseConnection and not alarmConnection then
				setEdges(false)
			end
		end)
	elseif info.Stage == "Stolen" then
		siren(2.4)
		bigText(`🚨 {string.upper(thiefName)} STOLE YOUR DONUT! 🚨`, Color3.fromRGB(255, 60, 60), 2.5)
		if chaseConnection then
			return -- you're busy running yourself: the toast is enough
		end
		stopAlarm()
		showBanner(true)
		bannerTitle.Text = `🚨 {string.upper(thiefName)} STOLE YOUR {string.upper(info.Name or "DONUT")}!`
		bannerTitle.TextColor3 = Color3.fromRGB(255, 80, 80)
		setEdges(true, Color3.fromRGB(255, 0, 0))
		local character = thief and thief.Character
		if character then
			local highlight = Instance.new("Highlight")
			highlight.FillColor = Color3.fromRGB(255, 40, 40)
			highlight.FillTransparency = 0.6
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.Adornee = character
			highlight.Parent = gui
			thiefHighlight = highlight
		end
		local pulse = 0
		alarmConnection = RunService.RenderStepped:Connect(function(dt)
			pulse += dt
			local root = rootPart()
			local thiefRoot = thief and thief.Character and thief.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not thief or not thief.Parent or thief:GetAttribute("CarryKind") ~= "Raid" then
				stopAlarm()
				return
			end
			if root and thiefRoot then
				bannerInfo.Text = `⚔️ Hit them with your Slap Hand! They're {math.floor((thiefRoot.Position - root.Position).Magnitude)} studs away`
			end
			setEdgeStrength(0.5 + math.sin(pulse * 8) * 0.15)
		end)
	elseif info.Stage == "Recovered" then
		stopAlarm()
		bigText("🛡 YOU GOT IT BACK!", Color3.fromRGB(120, 255, 120), 2)
		Theme.PlaySound("Deposit")
	elseif info.Stage == "Lost" then
		stopAlarm()
		bigText(`😱 {string.upper(thiefName)} GOT AWAY...`, Color3.fromRGB(255, 150, 150), 2)
	end
end

local function buildOfflinePopup()
	local modal = Modal.new("🌙 WELCOME BACK!", Theme.Colors.Purple, Vector2.new(500, 290))
	local text = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, Size = UDim2.new(1, 0, 0, 120), StrokeThickness = 1.5, Parent = modal.Body })
	local collect = Theme.Button({ Text = "COLLECT!", Icon = "💰", Color = Theme.Colors.Green, Size = UDim2.fromOffset(230, 58), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Parent = modal.Body })
	collect.Activated:Connect(function()
		modal:Close()
		Theme.PlaySound("Collect")
	end)
	Remotes.Event("OfflineEarnings").OnClientEvent:Connect(function(amount: number, seconds: number, capped: boolean?)
		local capText = if capped then `\n<font size="18">(offline earnings are capped at {Config.Offline.MaxHours}h)</font>` else ""
		text.Text = `Your donuts kept working while you were away for <b>{Format.Duration(seconds)}</b>!\n\n<font color="#8dff6a" size="40"><b>+{Format.Money(amount)}</b></font>{capText}`
		modal:Open()
	end)
end

function Chase.Init()
	gui = Theme.ScreenGui("Chase", 5)

	-- Small "Drop donut" button, only while you carry a donut stolen from someone's base. Kept small
	-- and away from the other buttons (right side, under the middle) so it isn't hit by accident.
	local dropHolder = Theme.new("Frame", {
		Name = "DropDonut", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.64, 0),
		Size = UDim2.fromOffset(112, 32), BackgroundTransparency = 1, Visible = false, Parent = gui,
	})
	Theme.AutoScale(dropHolder)
	local drop = Theme.Button({ Text = "✋ Drop donut", Color = Theme.Colors.Gray, Size = UDim2.fromScale(1, 1), Parent = dropHolder })
	drop.Activated:Connect(function()
		Remotes.Event("Action"):FireServer("DropCarried")
	end)
	local function updateDrop()
		dropHolder.Visible = player:GetAttribute("CarryKind") == "Raid"
	end
	player:GetAttributeChangedSignal("CarryKind"):Connect(updateDrop)
	updateDrop()

	-- Red/blue glow around the screen edges. Its own ScreenGui that ignores the top bar and the
	-- phone notch/safe area, so the glow reaches every edge of the screen.
	local edgeGui = Theme.ScreenGui("ChaseGlow", 3)
	edgeGui.IgnoreGuiInset = true
	edgeGui.ScreenInsets = Enum.ScreenInsets.None
	local edgeDefs = {
		{ Size = UDim2.new(1, 0, 0.18, 0), Position = UDim2.fromScale(0, 0), Rotation = 90 },
		{ Size = UDim2.new(1, 0, 0.18, 0), Position = UDim2.fromScale(0, 0.82), Rotation = -90 },
		{ Size = UDim2.new(0.12, 0, 1, 0), Position = UDim2.fromScale(0, 0), Rotation = 0 },
		{ Size = UDim2.new(0.12, 0, 1, 0), Position = UDim2.fromScale(0.88, 0), Rotation = 180 },
	}
	for _, def in edgeDefs do
		local edge = Theme.new("Frame", {
			Size = def.Size,
			Position = def.Position,
			BackgroundColor3 = Color3.fromRGB(255, 0, 0),
			BorderSizePixel = 0,
			Visible = false,
			Parent = edgeGui,
		}, {
			Theme.new("UIGradient", { Rotation = def.Rotation, Transparency = NumberSequence.new(0.5, 1) }),
		})
		table.insert(edges, edge)
	end

	banner = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 186),
		Size = UDim2.fromOffset(780, 78),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	Theme.AutoScale(banner)
	bannerTitle = Theme.Label({ Text = "", Size = UDim2.new(1, 0, 0, 46), StrokeThickness = 4, Parent = banner })
	bannerInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 49), StrokeThickness = 2, Parent = banner })

	Remotes.Event("ChaseStarted").OnClientEvent:Connect(onChaseStarted)
	Remotes.Event("Flung").OnClientEvent:Connect(function(velocity: Vector3)
		flingSelf(velocity)
		Theme.PlaySound("Caught")
	end)
	Remotes.Event("ChaseEnded").OnClientEvent:Connect(onChaseEnded)
	Remotes.Event("Alarm").OnClientEvent:Connect(onAlarm)
	player.CharacterAdded:Connect(function()
		hideBanner()
		clearBeam()
	end)
	buildOfflinePopup()
end

return Chase
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">CrateOpen</string>
              <string name="Source"><![CDATA[--[[
	Crate opening animation (Remotes "CrateOpened", sent by the server's CrateService after it has
	already given the reward): the crate shakes harder and harder, flashes open, and what you got
	pops out - an egg or pet in 3D, or a big icon for coins / Speed Boost / Luck Event.
	Several crates in a row are queued and played one after another.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Crates = require(Shared.Crates)
local CrateModel = require(Shared.CrateModel)
local PetModel = require(Shared.PetModel)
local Pets = require(Shared.Pets)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)

local CrateOpen = {}

type Info = { Crate: string, Kind: string, Amount: number?, Seconds: number?, Egg: string?, Pet: string? }

local overlay: Frame

-- A 3D model in a ViewportFrame, framed by its Top / Bottom attributes.
local function preview(parent: Instance, model: Model): ViewportFrame
	local viewport = Theme.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(180, 180, 180),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		Parent = parent,
	})
	model:PivotTo(CFrame.Angles(0, math.rad(200), 0))
	model.Parent = viewport
	local top = (model:GetAttribute("Top") :: number?) or 1.5
	local bottom = (model:GetAttribute("Bottom") :: number?) or 1.5
	local centerY = (top - bottom) / 2
	local height = top + bottom
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(Vector3.new(0, centerY + height * 0.3, -(height * 1.7 + 3)), Vector3.new(0, centerY, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

-- Big text for what you got: (icon, title, detail)
local function describe(info: Info): (string, string, string)
	if info.Kind == "Coins" then
		return "💰", Format.Money(info.Amount or 0), "Coins!"
	elseif info.Kind == "SpeedBoost" then
		return "⚡", "SPEED BOOST", `Run {math.floor((Config.Crates.SpeedBoostMultiplier - 1) * 100 + 0.5)}% faster for {Format.Duration(info.Seconds or 600)}`
	elseif info.Kind == "Luck" then
		return "🍀", "LUCK EVENT", `Better donuts for the whole server for {Format.Duration(info.Seconds or 600)}`
	elseif info.Kind == "Egg" and info.Egg and Pets.EggById[info.Egg] then
		local egg = Pets.EggById[info.Egg]
		return "🥚", string.upper(egg.Name), `In your incubator - hatches in {Format.Duration(egg.HatchSeconds)}`
	elseif info.Kind == "Pet" and info.Pet and Pets.ById[info.Pet] then
		local pet = Pets.ById[info.Pet]
		return "🐾", string.upper(pet.Name), `{pet.Rarity} pet! {Pets.BonusText(pet)}`
	end
	return "🎁", "SURPRISE", ""
end

local function play(info: Info)
	local crate = Crates.ById[info.Crate] or Crates.List[1]
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	TweenService:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 0.35 }):Play()
	local stage = Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(320, 320), BackgroundTransparency = 1, Parent = overlay })
	Theme.AutoScale(stage)
	Theme.Label({ Text = string.upper(crate.Name), TextColor3 = crate.Color:Lerp(Color3.new(1, 1, 1), 0.3), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -64), Size = UDim2.fromOffset(420, 44), StrokeThickness = 4, Parent = stage })

	-- Shake harder and harder
	local crateView = preview(stage, CrateModel.Build(crate.Id, { NoEffects = true }))
	local startedAt = os.clock()
	local shake = RunService.RenderStepped:Connect(function()
		local p = math.clamp((os.clock() - startedAt) / 1.8, 0, 1)
		crateView.Rotation = math.sin(os.clock() * (10 + p * 30)) * (3 + p * 18)
		crateView.Position = UDim2.fromOffset(math.sin(os.clock() * 45) * p * 7, 0)
	end)
	for i = 1, 3 do
		task.delay(0.5 * i, function()
			Theme.PlaySound("Crack")
		end)
	end
	task.wait(1.8)
	shake:Disconnect()

	-- Flash open
	local flash = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 5, Parent = overlay })
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	task.delay(0.7, function()
		flash:Destroy()
	end)
	Theme.PlaySound("Hatch")
	crateView:Destroy()
	if crate.Order >= 2 then
		for i = 1, 8 do
			local ray = Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(18, 440), Rotation = i * 22.5, BackgroundColor3 = crate.Color, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = stage }, {
				Theme.new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) }) }),
			})
			TweenService:Create(ray, TweenInfo.new(6, Enum.EasingStyle.Linear), { Rotation = ray.Rotation + 90 }):Play()
		end
	end

	-- What you got
	local icon, title, detail = describe(info)
	local reveal: GuiObject
	if info.Kind == "Egg" and info.Egg and Pets.EggById[info.Egg] then
		reveal = preview(stage, PetModel.BuildEgg(Pets.EggById[info.Egg], { NoEffects = true }))
	elseif info.Kind == "Pet" and info.Pet and Pets.ById[info.Pet] then
		reveal = preview(stage, PetModel.BuildPet(Pets.ById[info.Pet], { NoEffects = true }))
	else
		reveal = Theme.Label({ Text = icon, Font = Enum.Font.GothamBold, Size = UDim2.fromScale(0.6, 0.6), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Parent = stage })
	end
	local pop = Theme.new("UIScale", { Scale = 0.2, Parent = reveal })
	TweenService:Create(pop, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local titleLabel = Theme.Label({ Text = title, TextColor3 = if info.Kind == "Coins" then Theme.Colors.Money else Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.fromOffset(460, 46), StrokeThickness = 3.5, Parent = stage })
	Theme.Label({ Text = detail, Font = Theme.Font, TextColor3 = Color3.fromRGB(255, 240, 180), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 48), Size = UDim2.fromOffset(460, 26), StrokeThickness = 2, Parent = stage })
	if info.Kind == "Pet" then
		task.spawn(function()
			while titleLabel.Parent do
				titleLabel.TextColor3 = Color3.fromHSV((os.clock() * 0.4) % 1, 0.7, 1)
				task.wait()
			end
		end)
	end
	-- Spin 3D rewards slowly
	local camera = reveal:FindFirstChildOfClass("Camera")
	local spin = RunService.RenderStepped:Connect(function(dt: number)
		if camera then
			camera.CFrame = CFrame.Angles(0, dt * 0.8, 0) * camera.CFrame
		end
	end)
	task.wait(3)
	spin:Disconnect()
	TweenService:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
	stage:Destroy()
	task.wait(0.3)
	overlay.Visible = false
end

function CrateOpen.Init()
	local gui = Theme.ScreenGui("CrateOpening", 31)
	gui.IgnoreGuiInset = true
	overlay = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Visible = false, Parent = gui })
	local queue: { Info } = {}
	local playing = false
	Remotes.Event("CrateOpened").OnClientEvent:Connect(function(info: Info)
		table.insert(queue, info)
		if playing then
			return
		end
		playing = true
		while #queue > 0 do
			local nextInfo = table.remove(queue, 1)
			if nextInfo then
				play(nextInfo)
			end
		end
		playing = false
	end)
end

return CrateOpen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Donate</string>
              <string name="Source"><![CDATA[--[[
	Donate window: tip buttons (Robux developer products, Config.Donations) and the Luck Event.
	Tips go on the TOP DONATORS leaderboard (the board in the hub) and each one gives a title shown
	above your head and in chat (your biggest tip's title is the one you keep).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Donate = {}

local modal: Modal.Modal

function Donate.Open()
	modal:Open()
end

function Donate.Init()
	modal = Modal.new("💖 SUPPORT THE GAME", Theme.Colors.Pink, Vector2.new(560, 430))
	local body = modal.Body
	local total = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 44), StrokeThickness = 1.5, Parent = body })

	local grid = Theme.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 140), Parent = body }, {
		Theme.new("UIGridLayout", { CellSize = UDim2.new(1 / 3, -8, 0, 66), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for order, product in Config.Donations.Products do
		local button = Theme.Button({ Text = `R$ {Format.Commas(product.Amount)}`, Icon = "💖", Color = Theme.Colors.Pink, Size = UDim2.new(), LayoutOrder = order, Parent = grid })
		-- the title this tip gives, under the price
		Theme.Label({
			Text = product.Title, Font = Theme.Font, TextColor3 = product.Color, StrokeThickness = 1.5,
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -2), Size = UDim2.new(1, -8, 0, 16), ZIndex = 5, Parent = button,
		})
		button.Activated:Connect(function()
			State.Action("Donate", product.Amount)
		end)
	end

	-- Luck Event
	local luck = Theme.new("Frame", { BackgroundColor3 = Theme.Colors.PanelLight, Position = UDim2.fromOffset(0, 196), Size = UDim2.new(1, 0, 0, 150), Parent = body }, {
		Theme.Corner(14),
		Theme.Stroke(3, Color3.fromRGB(60, 200, 90)),
	})
	Theme.Label({ Text = "🍀 LUCK EVENT", TextColor3 = Color3.fromRGB(130, 255, 150), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 8), Parent = luck })
	Theme.Label({
		Text = `For {Format.Duration(Config.LuckEvent.Duration)} EVERY donut in this server is better: rare donuts x{Config.LuckEvent.RarityLuck}, mutations x{Config.LuckEvent.MutationLuck}, big sizes x{Config.LuckEvent.BigSizeLuck}, eggs x2. Everyone in the server gets it!`,
		Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 42), StrokeThickness = 1.2, Parent = luck,
	})
	local buy = Theme.Button({ Text = `START IT! R$ {Config.LuckEvent.SuggestedPrice}`, Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 44), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Parent = luck })
	buy.Activated:Connect(function()
		State.Action("BuyLuck")
	end)

	local function refresh()
		local donated = State.Number("Donated")
		local title = game:GetService("Players").LocalPlayer:GetAttribute("DonorTitle")
		local titleText = if type(title) == "string" then `  •  Your title: <b>{title}</b>` else "  •  Every tip gives a title!"
		total.Text = `Thank you for playing! Tips go on the <b>TOP DONATORS</b> board.\nYou've tipped <font color="#ff8ad0"><b>R$ {Format.Commas(donated)}</b></font>{titleText}`
		local endsAt = workspace:GetAttribute("LuckEndsAt")
		local left = if type(endsAt) == "number" then endsAt - workspace:GetServerTimeNow() else 0
		Theme.SetButtonText(buy, if left > 0 then `ADD 10 MIN! R$ {Config.LuckEvent.SuggestedPrice} ({Format.Duration(left)} left)` else `START IT! R$ {Config.LuckEvent.SuggestedPrice}`)
	end
	modal.OnOpen = refresh
	State.OnAttribute("Donated", function()
		if modal:IsOpen() then
			refresh()
		end
	end)
	workspace:GetAttributeChangedSignal("LuckEndsAt"):Connect(function()
		if modal:IsOpen() then
			refresh()
		end
	end)
end

return Donate
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">EventBanner</string>
              <string name="Source"><![CDATA[--[[
	Server event announcement (EventService / Events.luau).

	When an event starts, a BIG card drops in near the top of the screen (the event's colour, a huge
	icon, its name and what it does) with a little fanfare, and pulses so nobody misses it. After a
	few seconds it shrinks into a pill at the top of the screen with a countdown, which stays until
	the event ends. Players who join mid-event just get the pill.
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Events = require(Shared.Events)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)

local EventBanner = {}

local gui: ScreenGui
local holder: Frame -- screen-size scaling for the big card (the card has its own pop-in scale)
local pill: Frame
local pillLabel: TextLabel
local card: Frame? = nil

local function endsIn(): number
	local endsAt = workspace:GetAttribute("EventEndsAt")
	return if type(endsAt) == "number" then math.max(0, endsAt - workspace:GetServerTimeNow()) else 0
end

local function fanfare()
	task.spawn(function()
		for _, pitch in { 0.8, 1, 1.25, 1.6 } do
			local sound = Instance.new("Sound")
			sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
			sound.Volume = 0.35
			sound.PlaybackSpeed = pitch
			sound.Parent = gui
			sound:Play()
			task.delay(2, sound.Destroy, sound)
			task.wait(0.12)
		end
	end)
end

local function showCard(event: Events.Event)
	if card then
		card:Destroy()
	end
	local frame = Theme.new("Frame", {
		Name = "EventCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = event.Color,
		Parent = holder,
	}, {
		Theme.Corner(22),
		Theme.Stroke(5),
		Theme.Gradient(event.Color:Lerp(Color3.new(1, 1, 1), 0.25), event.Color:Lerp(Color3.new(0, 0, 0), 0.45)),
	})
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	Theme.Label({ Text = event.Icon, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(130, 130), Position = UDim2.fromOffset(16, 20), Parent = frame })
	Theme.Label({ Text = "⚡ SERVER EVENT ⚡", Font = Theme.Font, TextColor3 = Color3.fromRGB(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 28), Position = UDim2.fromOffset(156, 14), StrokeThickness = 2.5, Parent = frame })
	Theme.Label({ Text = string.upper(event.Name), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 60), Position = UDim2.fromOffset(156, 42), StrokeThickness = 4.5, Parent = frame })
	Theme.Label({ Text = event.Description, Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 30), Position = UDim2.fromOffset(156, 104), StrokeThickness = 2.5, Parent = frame })
	local timer = Theme.Label({ Text = "", Font = Theme.Font, TextColor3 = Color3.fromRGB(255, 255, 200), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 24), Position = UDim2.fromOffset(156, 136), StrokeThickness = 2, Parent = frame })
	card = frame

	-- Pop in, then pulse
	local scale = Theme.new("UIScale", { Scale = 0.2, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	fanfare()
	local startedAt = os.clock()
	task.spawn(function()
		while frame.Parent and os.clock() - startedAt < 7 do
			local t = os.clock() - startedAt
			if t > 0.5 then
				scale.Scale = 1 + math.sin(t * 6) * 0.03
			end
			if stroke then
				stroke.Color = Color3.fromHSV((t * 0.5) % 1, 0.6, 1)
			end
			timer.Text = `⏱ {Format.Duration(endsIn())} left`
			task.wait()
		end
		if frame.Parent then
			-- Shrink into the pill at the top
			TweenService:Create(scale, TweenInfo.new(0.35), { Scale = 0.1 }):Play()
			TweenService:Create(frame, TweenInfo.new(0.35), { Position = UDim2.new(0.5, 0, 0, -60), BackgroundTransparency = 1 }):Play()
			task.wait(0.35)
			frame:Destroy()
			if card == frame then
				card = nil
			end
		end
	end)
end

function EventBanner.Init()
	gui = Theme.ScreenGui("EventBanner", 25)
	holder = Theme.new("Frame", {
		Name = "CardHolder",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 60),
		Size = UDim2.fromOffset(680, 170),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.AutoScale(holder)
	pill = Theme.new("Frame", {
		Name = "EventPill",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(470, 38),
		BackgroundColor3 = Color3.fromRGB(60, 60, 90),
		Visible = false,
		Parent = gui,
	}, {
		Theme.Corner(19),
		Theme.Stroke(3),
	})
	Theme.AutoScale(pill)
	pillLabel = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -8), Position = UDim2.fromOffset(10, 4), StrokeThickness = 2, Parent = pill })

	local shownId: string? = workspace:GetAttribute("EventId") :: string? -- (joined mid-event: pill only)
	workspace:GetAttributeChangedSignal("EventId"):Connect(function()
		local id = workspace:GetAttribute("EventId")
		local event = if type(id) == "string" then Events.ById[id] else nil
		if event and id ~= shownId then
			showCard(event)
		end
		shownId = if type(id) == "string" then id else nil
	end)

	task.spawn(function()
		while true do
			local id = workspace:GetAttribute("EventId")
			local event = if type(id) == "string" then Events.ById[id] else nil
			local left = endsIn()
			pill.Visible = event ~= nil and left > 0 and card == nil
			if event and pill.Visible then
				pill.BackgroundColor3 = event.Color:Lerp(Color3.new(0, 0, 0), 0.35)
				pillLabel.Text = `{event.Icon} {string.upper(event.Name)}  •  {Format.Duration(left)}`
				-- Sit under the Luck Event pill when both are running
				local luckEndsAt = workspace:GetAttribute("LuckEndsAt")
				local luck = type(luckEndsAt) == "number" and luckEndsAt > workspace:GetServerTimeNow()
				pill.Position = UDim2.new(0.5, 0, 0, if luck then 46 else 4)
			end
			task.wait(0.5)
		end
	end)
end

return EventBanner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	HUD: always-on screen UI in the chunky "Steal an Egg" style, kept away from Roblox's own UI
	(chat top-left, player list top-right, hotbar bottom-centre):
	  left   - big Shop / Index / Pets / Rebirth buttons + the speed slider (middle of the screen)
	  right  - a grid of square buttons: Home / Worlds / Boosts / Skins / Donate / Music / Settings
	           (+ Admin), centred on the right edge
	  stats  - Speed, Money, income per second (bottom-left)
	  area   - where you are, how your speed compares to that area's guard, and any event (bottom-right)
	  luck   - a pill at the top while a Luck Event runs (anyone can add 10 more minutes)
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Areas = require(Shared.Areas)
local Economy = require(Shared.Economy)
local Events = require(Shared.Events)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)
local Notifications = require(script.Parent.Notifications)
local State = require(script.Parent.Parent.State)
local AreaTracker = require(script.Parent.Parent.AreaTracker)
local Bases = require(script.Parent.Parent.Bases)
local Settings = require(script.Parent.Settings)

local HUD = {}

export type Callbacks = {
	OpenShop: (tab: string?) -> (),
	OpenIndex: () -> (),
	OpenSettings: () -> (),
	OpenRebirth: () -> (),
	OpenWorlds: () -> (),
	OpenPets: () -> (),
	OpenDonate: () -> (),
	OpenAdmin: () -> (),
	UnclaimedIndex: () -> number,
	RebirthReady: () -> boolean,
	ReadyEggs: () -> number,
}

-- Little red number bubble in a button's corner.
local function badge(button: GuiObject): TextLabel
	local bubble = Theme.Label({
		Name = "Badge",
		Text = "",
		Font = Theme.Font,
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Red,
		Size = UDim2.fromOffset(26, 26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		ZIndex = 5,
		StrokeThickness = 1.5,
		Visible = false,
		Parent = button,
	})
	Theme.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bubble })
	return bubble
end

local function buildLeft(gui: ScreenGui, callbacks: Callbacks)
	local left = Theme.new("Frame", {
		Name = "LeftButtons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(196, 340),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Theme.AutoScale(left)

	-- Shop and Index are the big ones; Pets and Rebirth a bit smaller underneath
	local big, small = UDim2.fromOffset(190, 64), UDim2.fromOffset(190, 50)
	local shop = Theme.Button({ Text = "Shop", Icon = "🛒", Color = Theme.Colors.Green, Size = big, LayoutOrder = 1, Parent = left })
	local index = Theme.Button({ Text = "Index", Icon = "📖", Color = Theme.Colors.Blue, Size = big, LayoutOrder = 2, Parent = left })
	local pets = Theme.Button({ Text = "Pets", Icon = "🐾", Color = Theme.Colors.Pink, Size = small, LayoutOrder = 3, Parent = left })
	local rebirth = Theme.Button({ Text = "Rebirth", Icon = "🔄", Color = Theme.Colors.Yellow, Size = small, LayoutOrder = 5, Parent = left })
	shop.Activated:Connect(function()
		callbacks.OpenShop("Upgrades")
	end)
	pets.Activated:Connect(callbacks.OpenPets)
	index.Activated:Connect(callbacks.OpenIndex)
	rebirth.Activated:Connect(callbacks.OpenRebirth)

	-- Badges: unclaimed Index rewards, eggs ready to hatch, rebirth ready
	local indexBadge = badge(index)
	local petsBadge = badge(pets)
	local rebirthBadge = badge(rebirth)
	local function updateBadges()
		local unclaimed = callbacks.UnclaimedIndex()
		indexBadge.Visible = unclaimed > 0
		indexBadge.Text = if unclaimed > 99 then "99+" else tostring(unclaimed)
		local ready = callbacks.ReadyEggs()
		petsBadge.Visible = ready > 0
		petsBadge.Text = tostring(ready)
		rebirthBadge.Visible = callbacks.RebirthReady()
		rebirthBadge.Text = "!"
	end
	State.Changed:Connect(updateBadges)
	for _, name in { "Money", "Speed", "Rebirths" } do
		State.OnAttribute(name, updateBadges)
	end
	task.spawn(function()
		while true do
			task.wait(2) -- eggs finish hatching on their own
			updateBadges()
		end
	end)

	-- Speed slider: anything from normal walking speed (16) up to your full speed. Handy on your
	-- base or on the treadmill when you're very fast.
	local sliderRow = Theme.new("Frame", { Name = "SpeedSlider", BackgroundTransparency = 1, Size = UDim2.fromOffset(196, 52), LayoutOrder = 6, Parent = left })
	local sliderLabel = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 2, Parent = sliderRow })
	local bar = Theme.new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, -12, 0, 16), Position = UDim2.fromOffset(6, 26), BackgroundColor3 = Theme.Colors.Outline, BackgroundTransparency = 0.3, Parent = sliderRow }, { Theme.Corner(8), Theme.Stroke(2.5) })
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Colors.Green, Parent = bar }, { Theme.Corner(8) })
	local knob = Theme.new("Frame", { Size = UDim2.fromOffset(18, 26), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = Color3.fromRGB(255, 255, 255), ZIndex = 3, Parent = bar }, { Theme.Corner(6), Theme.Stroke(2) })
	local choice = 1
	local dragging = false
	local lastSent = 0
	local function render()
		fill.Size = UDim2.fromScale(choice, 1)
		knob.Position = UDim2.fromScale(choice, 0.5)
		fill.BackgroundColor3 = Theme.Colors.Gray:Lerp(Theme.Colors.Green, choice)
		local full = math.max(State.Number("WalkSpeed"), 16)
		local chosen = 16 + (full - 16) * choice
		sliderLabel.Text = `🏃 Speed <font color="#9dff7a">{math.floor(chosen)}</font> / {math.floor(full)}`
	end
	local function send(force: boolean?)
		local now = os.clock()
		if force or now - lastSent > 0.2 then
			lastSent = now
			State.Action("SetSpeedChoice", choice)
		end
	end
	local function setFromX(x: number)
		local width = math.max(bar.AbsoluteSize.X, 1)
		choice = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
		render()
		send()
	end
	bar.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			send(true)
		end
	end)
	State.OnAttribute("SpeedChoice", function(value)
		if type(value) == "number" and not dragging then
			choice = math.clamp(value, 0, 1)
			render()
		end
	end)
	State.OnAttribute("WalkSpeed", render)
	render()
end

local function buildRight(gui: ScreenGui, callbacks: Callbacks)
	local right = Theme.new("Frame", {
		Name = "RightButtons",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(160, 330),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(74, 74),
			CellPadding = UDim2.fromOffset(9, 9),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
	Theme.AutoScale(right)

	local function square(icon: string, caption: string, color: Color3, order: number, onClick: () -> ()): TextButton
		local button = Theme.Button({ Text = "", Color = color, Size = UDim2.fromOffset(74, 74), LayoutOrder = order, Parent = right })
		Theme.Label({ Text = icon, Font = Enum.Font.GothamBold, Size = UDim2.new(1, 0, 0.62, 0), Position = UDim2.fromScale(0, 0.06), Parent = button })
		Theme.Label({ Name = "Caption", Text = caption, Font = Theme.Title, Size = UDim2.new(1, -6, 0.26, 0), Position = UDim2.new(0, 3, 0.7, 0), StrokeThickness = 2, Parent = button })
		button.Activated:Connect(onClick)
		return button
	end
	local admin = square("🛠", "ADMIN", Theme.Colors.Red, 0, callbacks.OpenAdmin)
	admin.Visible = false
	square("🏠", "HOME", Theme.Colors.Red, 1, function()
		State.Action("TeleportHome")
	end)
	square("🌀", "WORLDS", Theme.Colors.Blue, 2, callbacks.OpenWorlds)
	square("🚀", "BOOSTS", Theme.Colors.Orange, 3, function()
		callbacks.OpenShop("Passes")
	end)
	square("🎨", "SKINS", Theme.Colors.Purple, 4, function()
		callbacks.OpenShop("Skins")
	end)
	square("💖", "DONATE", Theme.Colors.Pink, 5, callbacks.OpenDonate)
	-- Music on/off in one tap (saved), and Settings for the volume. Both only when there are songs.
	local hasMusic = #Config.Music.Tracks > 0
	local music: TextButton
	music = square("🎵", "MUSIC ON", Theme.Colors.Green, 6, function()
		Settings.SetMusicOn(not Settings.MusicOn())
	end)
	local function showMusic(on: boolean)
		local caption = music:FindFirstChild("Caption") :: TextLabel?
		if caption then
			caption.Text = if on then "MUSIC ON" else "MUSIC OFF"
		end
		Theme.SetButtonColor(music, if on then Theme.Colors.Green else Theme.Colors.Gray)
	end
	Settings.MusicChanged:Connect(showMusic)
	showMusic(Settings.MusicOn())
	music.Visible = hasMusic
	local settings = square("⚙️", "SETTINGS", Theme.Colors.Gray, 7, callbacks.OpenSettings)
	settings.Visible = hasMusic
	State.OnAttribute("Admin", function(value)
		admin.Visible = value == true
	end)
end

local function buildStats(gui: ScreenGui)
	local stats = Theme.new("Frame", {
		Name = "Stats",
		AnchorPoint = if Theme.IsTouch then Vector2.new(1, 0) else Vector2.new(0, 1),
		Position = if Theme.IsTouch then UDim2.new(1, -10, 0, 4) else UDim2.new(0, 10, 1, -10),
		Size = UDim2.fromOffset(380, 136),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.AutoScale(stats)
	local align = if Theme.IsTouch then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left

	-- Big outlined numbers with an icon, like the reference game
	local function row(icon: string, color: Color3, y: number): TextLabel
		local holder = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, y), Parent = stats })
		Theme.Label({ Text = icon, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(50, 50), Position = if Theme.IsTouch then UDim2.new(1, -50, 0, 0) else UDim2.new(), Parent = holder })
		return Theme.Label({
			Text = "0",
			TextColor3 = color,
			Size = UDim2.new(1, -58, 1, 0),
			Position = if Theme.IsTouch then UDim2.new() else UDim2.fromOffset(56, 0),
			TextXAlignment = align,
			StrokeThickness = 4,
			Parent = holder,
		})
	end
	local speedLabel = row("👟", Theme.Colors.Speed, 0)
	local moneyLabel = row("💵", Theme.Colors.Money, 52)
	local incomeLabel = Theme.Label({ Text = "", TextColor3 = Color3.fromRGB(255, 255, 255), Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 106), TextXAlignment = align, StrokeThickness = 3, Parent = stats })

	local function updateSpeed()
		local walk = State.Number("WalkSpeed")
		-- A crate Speed Boost shows its countdown next to your speed
		local endsAt = State.Get("SpeedBoostEndsAt")
		local left = if type(endsAt) == "number" then endsAt - workspace:GetServerTimeNow() else 0
		local boost = if left > 0
			then `  <font size="20" color="#ffe14a">⚡+{math.floor((Config.Crates.SpeedBoostMultiplier - 1) * 100 + 0.5)}% {Format.Duration(left)}</font>`
			else ""
		speedLabel.Text = `{Format.Number(State.Number("Speed"))}  <font size="22">(🏃 {math.floor(walk)})</font>{boost}`
	end
	speedLabel.RichText = true
	State.OnAttribute("Speed", updateSpeed)
	State.OnAttribute("WalkSpeed", updateSpeed)
	State.OnAttribute("SpeedBoostEndsAt", updateSpeed)
	task.spawn(function()
		while true do
			task.wait(1)
			if State.Get("SpeedBoostEndsAt") ~= nil then
				updateSpeed()
			end
		end
	end)
	State.OnAttribute("Money", function(value)
		moneyLabel.Text = Format.Money(value or 0)
	end)
	local function updateIncome()
		local mult = State.Number("MoneyMultiplier")
		local multText = if mult > 1 then `  (x{Format.Multiplier(mult)} money)` else ""
		incomeLabel.Text = `+{Format.Money(State.Number("Income"))}/s{multText}`
	end
	State.OnAttribute("Income", updateIncome)
	State.OnAttribute("MoneyMultiplier", updateIncome)
end

local function buildAreaInfo(gui: ScreenGui)
	local panel = Theme.new("Frame", {
		Name = "AreaInfo",
		AnchorPoint = if Theme.IsTouch then Vector2.new(0, 0) else Vector2.new(1, 1),
		Position = if Theme.IsTouch then UDim2.new(0, 10, 0, 4) else UDim2.new(1, -10, 1, -10),
		Size = UDim2.fromOffset(290, 88),
		BackgroundColor3 = Theme.Colors.Outline,
		BackgroundTransparency = 0.45,
		Parent = gui,
	}, {
		Theme.Corner(12),
	})
	Theme.AutoScale(panel)
	local nameLabel = Theme.Label({ Text = "", Size = UDim2.new(1, -18, 0, 30), Position = UDim2.fromOffset(9, 4), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 2.5, Parent = panel })
	local detail = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, Size = UDim2.new(1, -18, 0, 24), Position = UDim2.fromOffset(9, 36), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 1.5, Parent = panel })
	local eventLabel = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -18, 0, 22), Position = UDim2.fromOffset(9, 62), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 1.5, Parent = panel })

	local function refresh()
		local areaId = AreaTracker.Current
		local walk = State.Number("WalkSpeed")
		local world = Areas.World(math.max(1, State.Number("World")))
		if areaId <= 0 then
			nameLabel.Text = if world.Id > 1 then `🛡 {world.Icon} {world.Name}` else "🛡 SAFE ZONE"
			nameLabel.TextColor3 = Color3.fromRGB(110, 200, 255)
			detail.Text = `Your walk speed: <font color="#9dff7a">{math.floor(walk)}</font>`
			return
		end
		local area = Areas.List[areaId]
		local guard = math.floor(Economy.GuardWalkSpeed(areaId))
		local recommended = Economy.RecommendedWalkSpeed(areaId)
		local color = if walk >= recommended then "#7dff6a" elseif walk + 8 >= recommended then "#ffd54a" else "#ff5a5a"
		nameLabel.Text = `📍 {area.Name}`
		nameLabel.TextColor3 = area.Trim:Lerp(Color3.new(1, 1, 1), 0.3)
		detail.Text = `😴 {Config.Guard.Name}: <b>{guard}</b>   •   🏃 You: <font color="{color}"><b>{math.floor(walk)}</b></font>`
	end

	-- The server event that's running (with a countdown)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local eventId = workspace:GetAttribute("EventId")
			local endsAt = workspace:GetAttribute("EventEndsAt")
			local event = if type(eventId) == "string" then Events.ById[eventId] else nil
			if event and type(endsAt) == "number" then
				eventLabel.Text = `{event.Icon} {event.Name}: {Format.Duration(endsAt - workspace:GetServerTimeNow())} left`
				eventLabel.TextColor3 = event.Color
			else
				eventLabel.Text = ""
			end
		end
	end)
	AreaTracker.Changed:Connect(function(areaId: number, old: number)
		refresh()
		if old == -1 then
			return
		end
		if areaId == 0 then
			Notifications.Banner("🛡 SAFE ZONE", Color3.fromRGB(110, 200, 255), 1.5)
		else
			local area = Areas.List[areaId]
			local recommended = Economy.RecommendedSpeed(areaId)
			local rec = if recommended > 0 then `Recommended speed ⚡{Format.Number(recommended)} (🏃 {math.floor(Economy.RecommendedWalkSpeed(areaId))})` else "Anyone can make it back from here!"
			Notifications.Banner(`AREA {areaId}: {string.upper(area.Name)}`, area.Trim:Lerp(Color3.new(1, 1, 1), 0.25), 2.5, `{Config.Guard.Name} speed {math.floor(Economy.GuardWalkSpeed(areaId))} • {rec}`)
		end
	end)
	State.OnAttribute("WalkSpeed", function()
		refresh()
	end)
	State.OnAttribute("World", function()
		refresh()
	end)
end

-- Luck Event pill at the top of the screen (only while one is running).
local function buildLuck(gui: ScreenGui)
	local pill = Theme.new("Frame", {
		Name = "LuckEvent",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(430, 38),
		BackgroundColor3 = Color3.fromRGB(30, 120, 50),
		Visible = false,
		Parent = gui,
	}, {
		Theme.Corner(19),
		Theme.Stroke(3),
		Theme.Gradient(Color3.fromRGB(80, 220, 110), Color3.fromRGB(20, 110, 50)),
	})
	Theme.AutoScale(pill)
	local label = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -140, 1, -8), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 2, Parent = pill })
	local extend = Theme.Button({ Text = `+10 MIN R$ {Config.LuckEvent.SuggestedPrice}`, Color = Theme.Colors.Yellow, Size = UDim2.fromOffset(124, 30), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), Parent = pill })
	extend.Activated:Connect(function()
		State.Action("BuyLuck")
	end)
	task.spawn(function()
		while true do
			local endsAt = workspace:GetAttribute("LuckEndsAt")
			local left = if type(endsAt) == "number" then endsAt - workspace:GetServerTimeNow() else 0
			pill.Visible = left > 0
			if left > 0 then
				local by = workspace:GetAttribute("LuckBy")
				label.Text = `🍀 LUCK EVENT {Format.Duration(left)}{if type(by) == "string" then " • by " .. by else ""}`
			end
			task.wait(0.5)
		end
	end)
end

-- "YOUR BASE" marker visible through walls, so you always know where to run.
local function buildBaseMarker()
	local marker: BillboardGui? = nil
	local function place()
		local plot: Model? = nil
		for _ = 1, 60 do
			plot = Bases.Mine()
			if plot then
				break
			end
			task.wait(0.5)
		end
		local anchor = plot and plot:FindFirstChild("SignAnchor")
		if not anchor or not anchor:IsA("BasePart") then
			return
		end
		if marker then
			marker:Destroy()
		end
		local gui = Theme.new("BillboardGui", {
			Name = "YourBaseMarker",
			Adornee = anchor,
			AlwaysOnTop = true,
			Size = UDim2.fromOffset(150, 38),
			StudsOffsetWorldSpace = Vector3.new(0, 7, 0),
			LightInfluence = 0,
			Parent = Theme.PlayerGui(),
		})
		Theme.Label({ Text = "⬇ YOUR BASE ⬇", TextColor3 = Theme.Colors.Yellow, Size = UDim2.fromScale(1, 1), StrokeThickness = 3, Parent = gui })
		marker = gui
	end
	State.OnAttribute("PlotIndex", function()
		task.spawn(place)
	end)
	State.OnAttribute("BaseWorld", function()
		task.spawn(place)
	end)
end

function HUD.Init(callbacks: Callbacks)
	local gui = Theme.ScreenGui("HUD", 1)
	buildLeft(gui, callbacks)
	buildRight(gui, callbacks)
	buildStats(gui)
	buildAreaInfo(gui)
	buildLuck(gui)
	buildBaseMarker()
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">Index</string>
              <string name="Source"><![CDATA[--[[
	Donut Index: every donut in the game grouped by world and area, with 3D previews.
	Donuts you haven't stolen yet show as black silhouettes named "???".

	Rewards: every donut you've found can be claimed once for cash. Epic and rarer donuts let you
	pick a permanent treadmill speed bonus instead. The dots under a donut show which mutations
	of it you've found.

	Global rarity scale: Legendary and rarer donuts show how many times they've spawned and been
	found in the WHOLE game (every server), and what share of all spawns that is. The line at the
	top does the same for every mutation. (StatsService on the server keeps the counts.)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Donuts = require(Shared.Donuts)
local Rarities = require(Shared.Rarities)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local DonutModel = require(Shared.DonutModel)
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Index = {}

type Card = {
	Viewport: ViewportFrame,
	Name: TextLabel,
	Info: TextLabel,
	Rarity: TextLabel,
	Global: TextLabel,
	Dots: { [string]: Frame },
	Cash: TextButton,
	Speed: TextButton?,
	Status: TextLabel,
}

local modal: Modal.Modal
local pages: { [number]: ScrollingFrame } = {}
local cards: { [string]: Card } = {}
local counter: TextLabel
local legend: TextLabel
local selectWorld: (string) -> ()
local currentWorld = 1

type Counts = { [string]: { number } }
local globalStats: { D: Counts, M: Counts }? = nil

-- Share of all spawns, as a readable percentage ("0.0031%")
local function percent(part: number, total: number): string
	if total <= 0 or part <= 0 then
		return "0%"
	end
	local p = part / total * 100
	return if p >= 1 then string.format("%.1f%%", p) elseif p >= 0.01 then string.format("%.2f%%", p) else string.format("%.2g%%", p)
end

-- Donuts found but not claimed yet (the HUD shows this as a badge on the Index button).
function Index.UnclaimedCount(): number
	local discovered: { [string]: boolean } = State.Data.Discovered or {}
	local claims: { [string]: string } = State.Data.IndexClaims or {}
	local count = 0
	for id in discovered do
		if Donuts.ById[id] and not claims[id] then
			count += 1
		end
	end
	return count
end

local function preview(parent: Instance, donut: Donuts.Donut): ViewportFrame
	local viewport = Theme.new("ViewportFrame", {
		BackgroundColor3 = Color3.fromRGB(25, 25, 40),
		Size = UDim2.new(1, -12, 0, 96),
		Position = UDim2.fromOffset(6, 6),
		Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		Parent = parent,
	}, { Theme.Corner(10) })
	local model = DonutModel.Build(donut, { NoEffects = true })
	model.Parent = viewport
	local top = (model:GetAttribute("Top") :: number?) or 2.5
	local bottom = (model:GetAttribute("Bottom") :: number?) or 2.5
	local centerY = (top - bottom) / 2
	local height = top + bottom
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(Vector3.new(2.2, centerY + 1, -(height * 1.35 + 4)), Vector3.new(0, centerY, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

local function refresh()
	local discovered: { [string]: boolean } = State.Data.Discovered or {}
	local claims: { [string]: string } = State.Data.IndexClaims or {}
	local mutations: { [string]: { [string]: boolean } } = State.Data.DiscoveredMutations or {}
	local found = 0
	for _ in discovered do
		found += 1
	end
	local stats = globalStats
	local totalSpawns = 0
	if stats then
		for _, counts in stats.D do
			totalSpawns += counts[1] or 0
		end
	end
	-- While a Luck Event runs, show the boosted odds too (Roblox wants boosted odds shown when the
	-- boost was paid for).
	local luckEndsAt = workspace:GetAttribute("LuckEndsAt")
	local lucky = type(luckEndsAt) == "number" and luckEndsAt > workspace:GetServerTimeNow()
	for id, card in cards do
		local donut = Donuts.ById[id]
		local rarity = Rarities.Get(donut.Rarity)
		local cash = Economy.IndexCashReward(id)
		local speed = Economy.IndexSpeedReward(id)
		local chance = `{string.format("%.2g", Donuts.Chance(donut) * 100)}% here`
		if lucky then
			chance ..= ` (🍀 {string.format("%.2g", Donuts.Chance(donut, Config.LuckEvent.RarityLuck) * 100)}% now)`
		end
		card.Rarity.Text = `{rarity.Id} • {chance}`
		local counts = stats and stats.D[id]
		if rarity.Order >= Config.GlobalStats.ShowFromRarity then
			local spawned = if counts then counts[1] or 0 else 0
			local gotHome = if counts then counts[2] or 0 else 0
			card.Global.Text = if stats then `🌍 {Format.Number(spawned)} spawned ({percent(spawned, totalSpawns)}) • {Format.Number(gotHome)} found` else "🌍 loading..."
		else
			card.Global.Text = ""
		end
		for mutationId, dot in card.Dots do
			local has = mutations[id] and mutations[id][mutationId]
			dot.BackgroundTransparency = if has then 0 else 0.75
		end
		if discovered[id] then
			card.Viewport.ImageColor3 = Color3.new(1, 1, 1)
			card.Name.Text = donut.Name
			card.Info.Text = `{Format.Money(donut.Income)}/s`
		else
			card.Viewport.ImageColor3 = Color3.new(0, 0, 0)
			card.Name.Text = "???"
			card.Info.Text = "Not found yet"
		end
		local claimed = claims[id]
		local canClaim = discovered[id] and not claimed
		card.Cash.Visible = canClaim == true
		if card.Speed then
			card.Speed.Visible = canClaim == true
		end
		card.Status.Visible = not canClaim
		if claimed == "Speed" then
			card.Status.Text = `✓ +{speed or 0}% speed`
			card.Status.TextColor3 = Color3.fromRGB(200, 160, 255)
		elseif claimed then
			card.Status.Text = `✓ Claimed {Format.Money(cash)}`
			card.Status.TextColor3 = Theme.Colors.Money
		else
			card.Status.Text = if speed then `🎁 {Format.Money(cash)} or +{speed}% speed` else `🎁 {Format.Money(cash)}`
			card.Status.TextColor3 = Color3.fromRGB(200, 200, 210)
		end
	end
	local bonus = State.Number("IndexBonus")
	counter.Text = `Discovered {found}/{#Donuts.List}   •   📖 Speed bonus: +{bonus}%   •   🎁 {Index.UnclaimedCount()} to claim`
	-- Mutations: chance per spawn + how many were found in the whole game
	local parts = {}
	for _, mutation in Rarities.Mutations do
		if mutation.Order > 0 then
			local counts = stats and stats.M[mutation.Id]
			local foundCount = if counts then counts[2] or 0 else 0
			local boosted = if lucky then ` → 🍀 {percent(mutation.Chance * Config.LuckEvent.MutationLuck, 1)}` else ""
			table.insert(parts, `<font color="#{mutation.Color:ToHex()}">{mutation.Id}</font> {percent(mutation.Chance, 1)}{boosted} ({if stats then Format.Number(foundCount) else "?"} found)`)
		end
	end
	legend.Text = "🌍 " .. table.concat(parts, "  ")
end

local function fetchStats()
	local ok, result = pcall(function()
		return Remotes.Function("GetGlobalStats"):InvokeServer()
	end)
	if ok and type(result) == "table" and type(result.D) == "table" and type(result.M) == "table" then
		globalStats = result
		refresh()
	end
end

local function buildCard(grid: Instance, donut: Donuts.Donut, order: number)
	local rarity = Rarities.Get(donut.Rarity)
	local cardFrame = Theme.new("Frame", { BackgroundColor3 = Theme.Colors.PanelLight, LayoutOrder = order, Parent = grid }, {
		Theme.Corner(12),
		Theme.Stroke(3, rarity.Color),
	})
	local viewport = preview(cardFrame, donut)
	local rarityLabel = Theme.Label({ Text = rarity.Id, TextColor3 = rarity.Color, Font = Theme.Font, Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 104), StrokeThickness = 1.5, Parent = cardFrame })
	local nameLabel = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 122), StrokeThickness = 1.5, Parent = cardFrame })
	local info = Theme.Label({ Text = "", Font = Theme.Font, TextColor3 = Theme.Colors.Money, Size = UDim2.new(1, -8, 0, 17), Position = UDim2.fromOffset(4, 148), StrokeThickness = 1.2, Parent = cardFrame })
	local global = Theme.Label({ Text = "", Font = Theme.Font, TextColor3 = Color3.fromRGB(170, 220, 255), Size = UDim2.new(1, -8, 0, 15), Position = UDim2.fromOffset(4, 166), StrokeThickness = 1, Parent = cardFrame })
	-- Mutation dots
	local dotRow = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 14), Position = UDim2.fromOffset(4, 185), Parent = cardFrame }, {
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local dots: { [string]: Frame } = {}
	for _, mutation in Rarities.Mutations do
		if mutation.Order > 0 then
			dots[mutation.Id] = Theme.new("Frame", { Size = UDim2.fromOffset(14, 14), BackgroundColor3 = mutation.Color, BackgroundTransparency = 0.75, LayoutOrder = mutation.Order, Parent = dotRow }, {
				Theme.Corner(7),
				Theme.Stroke(1.5),
			})
		end
	end
	-- Reward buttons
	local speed = Economy.IndexSpeedReward(donut.Id)
	local cash = Theme.Button({ Text = "💵 " .. Format.Money(Economy.IndexCashReward(donut.Id)), Color = Theme.Colors.Green, Size = UDim2.new(if speed then 0.5 else 1, -8, 0, 32), Position = UDim2.new(0, 5, 1, -38), Parent = cardFrame })
	cash.Activated:Connect(function()
		State.Action("ClaimIndex", { DonutId = donut.Id, Kind = "Cash" })
	end)
	local speedButton: TextButton? = nil
	if speed then
		local button = Theme.Button({ Text = `⚡ +{speed}%`, Color = Theme.Colors.Purple, Size = UDim2.new(0.5, -8, 0, 32), Position = UDim2.new(0.5, 3, 1, -38), Parent = cardFrame })
		button.Activated:Connect(function()
			State.Action("ClaimIndex", { DonutId = donut.Id, Kind = "Speed" })
		end)
		speedButton = button
	end
	local status = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -8, 0, 26), Position = UDim2.new(0, 4, 1, -34), StrokeThickness = 1.2, Parent = cardFrame })
	cards[donut.Id] = { Viewport = viewport, Name = nameLabel, Info = info, Rarity = rarityLabel, Global = global, Dots = dots, Cash = cash, Speed = speedButton, Status = status }
end

-- Build one world's page (previews are only built the first time you look at it).
local function buildWorld(worldId: number)
	if pages[worldId] then
		return
	end
	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 104),
		Size = UDim2.new(1, 0, 1, -104),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Visible = false,
		Parent = modal.Body,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingLeft = UDim.new(0, 2), PaddingBottom = UDim.new(0, 10) }),
	})
	pages[worldId] = scroll
	for _, area in Areas.ByWorld[worldId] do
		local section = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = area.Id, Parent = scroll })
		Theme.Label({ Text = `AREA {area.Id} • {string.upper(area.Name)}`, TextColor3 = area.Trim:Lerp(Color3.new(1, 1, 1), 0.3), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 30), Parent = section })
		local grid = Theme.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = section }, {
			Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(170, 242), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		local areaDonuts: { Donuts.Donut } = Donuts.ByArea[area.Id] or {}
		for order, donut in areaDonuts do
			buildCard(grid, donut, order)
		end
	end
end

function Index.Open()
	modal:Open()
end

function Index.Init()
	modal = Modal.new("📖 DONUT INDEX", Theme.Colors.Blue, Vector2.new(780, 540))
	counter = Theme.Label({ Text = "", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 50), Parent = modal.Body })
	legend = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 76), StrokeThickness = 1.2, Parent = modal.Body })
	local tabs = {}
	for _, world in Areas.Worlds do
		table.insert(tabs, { Name = tostring(world.Id), Text = `{world.Icon} {world.Name}`, Color = world.Color })
	end
	selectWorld = Modal.Tabs(modal.Body, tabs, function(name)
		currentWorld = tonumber(name) or 1
		buildWorld(currentWorld)
		for worldId, page in pages do
			page.Visible = worldId == currentWorld
		end
		refresh()
	end)
	modal.OnOpen = function()
		selectWorld(tostring(currentWorld))
		task.spawn(fetchStats)
	end
	-- Keep the global numbers fresh while the Index is open
	task.spawn(function()
		while true do
			task.wait(60)
			if modal:IsOpen() then
				fetchStats()
			end
		end
	end)
	State.Changed:Connect(refresh)
	State.OnAttribute("IndexBonus", function()
		if modal:IsOpen() then
			refresh()
		end
	end)
	workspace:GetAttributeChangedSignal("LuckEndsAt"):Connect(function()
		if modal:IsOpen() then
			refresh()
		end
	end)
end

return Index
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">Leaderboards</string>
              <string name="Source"><![CDATA[--[[
	Leaderboards: the physical boards next to the shop (scrollable, top 500). Leaderboards.Open()
	shows the same data in a full-screen window; nothing on the HUD opens it any more (the Top 500
	button was removed), but it's kept so a button can be added back in one line.
	The donation board starts with a pinned row (a crown instead of a rank, with a note under the name).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local VirtualList = require(script.Parent.VirtualList)

local Leaderboards = {}

local player = Players.LocalPlayer :: Player

type Entry = { Rank: number, UserId: number, Name: string, Display: string, Color: Color3?, Score: number?, Note: string?, Pinned: boolean? }
type BoardData = { Entries: { Entry }, UpdatedAt: number, Live: boolean }

local boardConfigs: { [string]: { Id: string, Title: string, Subtitle: string, Color: Color3 } } = {}
for _, board in Config.Leaderboards.Boards do
	boardConfigs[board.Id] = board
end

local data: { [string]: BoardData } = {}
local listeners: { [string]: { (BoardData) -> () } } = {}

local RANK_COLORS = { Color3.fromRGB(255, 215, 0), Color3.fromRGB(210, 220, 235), Color3.fromRGB(215, 140, 70) }

local function fetch(boardId: string)
	local ok, result = pcall(function()
		return Remotes.Function("GetLeaderboard"):InvokeServer(boardId)
	end)
	if ok and type(result) == "table" then
		data[boardId] = result
		local callbacks: { (BoardData) -> () } = listeners[boardId] or {}
		for _, callback in callbacks do
			task.spawn(callback, result)
		end
	end
end

local function listen(boardId: string, callback: (BoardData) -> ())
	listeners[boardId] = listeners[boardId] or {}
	table.insert(listeners[boardId], callback)
	if data[boardId] then
		callback(data[boardId])
	end
end

-- Builds a scrolling list inside `parent`. Returns a function to feed it a board.
local function makeList(parent: Instance, rowHeight: number, textScale: number, accent: Color3): (BoardData) -> ()
	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = math.floor(10 * textScale),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	})
	local function buildRow(): GuiObject
		local row = Theme.new("Frame", { Size = UDim2.new(1, -math.floor(14 * textScale), 0, rowHeight - 4), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.93 }, { Theme.Corner(6) })
		Theme.Label({ Name = "Rank", Font = Theme.Title, Size = UDim2.new(0.16, 0, 0.8, 0), Position = UDim2.fromScale(0.01, 0.1), StrokeThickness = 2 * textScale, Parent = row })
		Theme.Label({ Name = "PlayerName", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.45, 0, 0.75, 0), Position = UDim2.fromScale(0.18, 0.125), StrokeThickness = 1.5 * textScale, Parent = row })
		Theme.Label({ Name = "Note", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 170, 170), Size = UDim2.new(0.45, 0, 0.36, 0), Position = UDim2.fromScale(0.18, 0.6), StrokeThickness = 1.2 * textScale, Visible = false, Parent = row })
		Theme.Label({ Name = "Value", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.35, 0, 0.75, 0), Position = UDim2.fromScale(0.63, 0.125), StrokeThickness = 1.5 * textScale, Parent = row })
		return row
	end
	local function bindRow(row: GuiObject, entry: Entry)
		local rank = row:FindFirstChild("Rank") :: TextLabel
		local name = row:FindFirstChild("PlayerName") :: TextLabel
		local value = row:FindFirstChild("Value") :: TextLabel
		local note = row:FindFirstChild("Note") :: TextLabel
		rank.Text = if entry.Pinned then "👑" else "#" .. entry.Rank
		rank.TextColor3 = RANK_COLORS[entry.Rank] or Color3.fromRGB(230, 230, 230)
		name.Text = entry.Name
		-- A note under the name (the pinned donation row): squeeze the name into the top part
		note.Visible = entry.Note ~= nil
		note.Text = entry.Note or ""
		name.Size = if entry.Note then UDim2.new(0.45, 0, 0.5, 0) else UDim2.new(0.45, 0, 0.75, 0)
		name.Position = if entry.Note then UDim2.fromScale(0.18, 0.08) else UDim2.fromScale(0.18, 0.125)
		value.Text = entry.Display
		value.TextColor3 = entry.Color or accent:Lerp(Color3.new(1, 1, 1), 0.35)
		local isMe = entry.UserId == player.UserId
		row.BackgroundColor3 = if isMe or entry.Pinned then Theme.Colors.Yellow else Color3.new(1, 1, 1)
		row.BackgroundTransparency = if entry.Pinned then 0.75 elseif isMe then 0.6 else (if entry.Rank % 2 == 0 then 0.96 else 0.9)
	end
	local list = VirtualList.new(scroll, rowHeight, buildRow, bindRow :: any)
	return function(board: BoardData)
		list:SetEntries(board.Entries)
	end
end

local function findMe(board: BoardData): Entry?
	for _, entry in board.Entries do
		if entry.UserId == player.UserId and not entry.Pinned then
			return entry
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Physical boards next to the shop
--------------------------------------------------------------------------------
local function buildWorldBoard(screen: BasePart, boardId: string)
	local cfg = boardConfigs[boardId]
	if not cfg then
		return
	end
	local surface = Theme.new("SurfaceGui", {
		Name = "Board_" .. boardId,
		Adornee = screen,
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 25,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = Theme.PlayerGui(),
	})
	local root = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(20, 20, 32), Parent = surface }, { Theme.Padding(14) })
	local header = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = cfg.Color, Parent = root }, {
		Theme.Corner(14),
		Theme.Gradient(Theme.Lighten(cfg.Color, 0.2), Theme.Darken(cfg.Color, 0.15)),
	})
	Theme.Label({ Text = "🏆 " .. cfg.Title, Size = UDim2.new(1, -20, 0, 64), Position = UDim2.fromOffset(10, 6), StrokeThickness = 4, Parent = header })
	Theme.Label({ Text = `{cfg.Subtitle} • TOP {Config.Leaderboards.Size}`, Font = Theme.Font, Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 70), StrokeThickness = 2, Parent = header })
	local listHolder = Theme.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 122), Size = UDim2.new(1, 0, 1, -178), Parent = root })
	local footer = Theme.Label({ Text = "Loading...", Font = Theme.Font, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 1, -44), TextColor3 = Theme.Colors.Yellow, StrokeThickness = 2, Parent = root })
	local feed = makeList(listHolder, 52, 2, cfg.Color)
	listen(boardId, function(board)
		feed(board)
		local me = findMe(board)
		if #board.Entries == 0 then
			footer.Text = "No scores yet - be the first!"
		elseif me then
			footer.Text = `You are #{me.Rank}! • scroll for more`
		else
			footer.Text = if board.Live then "Showing this server (global board loading...)" else "Scroll to see the top " .. Config.Leaderboards.Size
		end
	end)
end

--------------------------------------------------------------------------------
-- Full-screen window
--------------------------------------------------------------------------------
local modal: Modal.Modal

local function buildModal()
	modal = Modal.new("🏆 TOP 500", Theme.Colors.Orange, Vector2.new(640, 540))
	local body = modal.Body
	local current = Config.Leaderboards.Boards[1].Id
	local subtitle = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 50), StrokeThickness = 1.5, Parent = body })
	local listHolder = Theme.new("Frame", { BackgroundColor3 = Color3.fromRGB(20, 20, 32), Position = UDim2.fromOffset(0, 80), Size = UDim2.new(1, 0, 1, -120), Parent = body }, { Theme.Corner(12), Theme.Padding(6) })
	local footer = Theme.Label({ Text = "", Font = Theme.Font, TextColor3 = Theme.Colors.Yellow, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -32), StrokeThickness = 1.5, Parent = body })
	local feeds: { [string]: (BoardData) -> () } = {}
	local holders: { [string]: Frame } = {}

	local function show(boardId: string)
		current = boardId
		for id, holder in holders do
			holder.Visible = id == boardId
		end
		local cfg = boardConfigs[boardId]
		subtitle.Text = cfg.Subtitle
		local board = data[boardId]
		local me = board and findMe(board)
		footer.Text = if me then `Your rank: #{me.Rank}` else "Keep playing to reach the top 500!"
	end

	for _, cfg in Config.Leaderboards.Boards do
		local holder = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = listHolder })
		holders[cfg.Id] = holder
		feeds[cfg.Id] = makeList(holder, 40, 1, cfg.Color)
		listen(cfg.Id, function(board)
			feeds[cfg.Id](board)
			if current == cfg.Id then
				show(cfg.Id)
			end
		end)
	end

	local tabs = {}
	for _, cfg in Config.Leaderboards.Boards do
		table.insert(tabs, { Name = cfg.Id, Text = cfg.Id, Color = cfg.Color })
	end
	local selectTab = Modal.Tabs(body, tabs, show)
	modal.OnOpen = function()
		selectTab(current)
		task.spawn(fetch, current)
	end
end

function Leaderboards.Open()
	modal:Open()
end

function Leaderboards.Init()
	buildModal()

	task.spawn(function()
		local map = workspace:WaitForChild("Map")
		local folder = map:WaitForChild("Hub"):WaitForChild("Leaderboards")
		for _, cfg in Config.Leaderboards.Boards do
			local board = folder:WaitForChild("Board_" .. cfg.Id, 30)
			local screen = board and board:WaitForChild("Screen", 30)
			if screen and screen:IsA("BasePart") then
				buildWorldBoard(screen, cfg.Id)
			end
		end
	end)

	Remotes.Event("LeaderboardUpdated").OnClientEvent:Connect(function(boardId: string)
		task.wait(math.random() * 3) -- spread requests from many clients
		fetch(boardId)
	end)

	task.spawn(function()
		task.wait(3)
		while true do
			for _, cfg in Config.Leaderboards.Boards do
				fetch(cfg.Id)
				task.wait(1)
			end
			task.wait(60)
		end
	end)
end

return Leaderboards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">Modal</string>
              <string name="Source"><![CDATA[--[[
	Modal: a centred pop-up window (Shop, Index, Leaderboards...). Only one is open at a time.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Modal = {}
Modal.__index = Modal

export type Modal = {
	Frame: Frame,
	Body: Frame,
	Title: TextLabel,
	OnOpen: (() -> ())?,
	Open: (self: Modal) -> (),
	Close: (self: Modal) -> (),
	Toggle: (self: Modal) -> (),
	IsOpen: (self: Modal) -> boolean,
}

local gui: ScreenGui? = nil
local current: Modal? = nil

local function getGui(): ScreenGui
	if not gui then
		gui = Theme.ScreenGui("Modals", 10)
	end
	return gui :: ScreenGui
end

function Modal.new(title: string, color: Color3, size: Vector2): Modal
	local holder = Theme.new("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = getGui(),
	}, {
		Theme.Corner(18),
		Theme.Stroke(4),
		Theme.Gradient(Theme.Colors.PanelLight, Theme.Colors.Panel),
	})
	Theme.AutoScale(holder) -- (only one UIScale per object works, so the open "pop" tweens this one too)

	local header = Theme.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = color,
		Parent = holder,
	}, {
		Theme.Corner(18),
		Theme.Gradient(Theme.Lighten(color, 0.2), Theme.Darken(color, 0.1)),
	})
	-- Square off the header's bottom corners
	Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -18), BackgroundColor3 = Theme.Darken(color, 0.1), BorderSizePixel = 0, Parent = header })
	local titleLabel = Theme.Label({ Name = "Title", Text = title, Size = UDim2.new(1, -120, 0, 44), Position = UDim2.fromOffset(20, 7), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 3, Parent = header })

	local close = Theme.Button({ Name = "Close", Text = "X", Color = Theme.Colors.Red, Size = UDim2.fromOffset(46, 46), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 6), Parent = header })

	local body = Theme.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 68),
		Size = UDim2.new(1, -28, 1, -80),
		Parent = holder,
	})

	local self = setmetatable({ Frame = holder, Body = body, Title = titleLabel, OnOpen = nil }, Modal) :: any
	close.Activated:Connect(function()
		self:Close()
	end)
	return self
end

function Modal.Open(self: Modal)
	if current and current ~= self then
		current:Close()
	end
	current = self
	local scale = self.Frame:FindFirstChild("AutoScale") :: UIScale
	local target = Theme.CurrentScale()
	scale.Scale = target * 0.85
	self.Frame.Visible = true
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
	if self.OnOpen then
		task.spawn(self.OnOpen)
	end
end

function Modal.Close(self: Modal)
	self.Frame.Visible = false
	if current == self then
		current = nil
	end
end

function Modal.Toggle(self: Modal)
	if self.Frame.Visible then
		self:Close()
	else
		self:Open()
	end
end

-- Is any window open right now?
function Modal.AnyOpen(): boolean
	return current ~= nil and current.Frame.Visible
end

function Modal.IsOpen(self: Modal): boolean
	return self.Frame.Visible
end

-- Row of tab buttons; returns a function to select a tab by name.
function Modal.Tabs(parent: Instance, tabs: { { Name: string, Text: string, Color: Color3 } }, onSelect: (string) -> ()): (string) -> ()
	local bar = Theme.new("Frame", { Name = "Tabs", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = parent }, {
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local buttons: { [string]: TextButton } = {}
	local function select(name: string)
		for tabName, button in buttons do
			local tab
			for _, t in tabs do
				if t.Name == tabName then
					tab = t
				end
			end
			Theme.SetButtonColor(button, if tabName == name then tab.Color else Theme.Colors.Gray)
		end
		onSelect(name)
	end
	for i, tab in tabs do
		local button = Theme.Button({ Text = tab.Text, Color = tab.Color, Size = UDim2.new(1 / #tabs, -8, 1, 0), LayoutOrder = i, Parent = bar })
		buttons[tab.Name] = button
		button.Activated:Connect(function()
			select(tab.Name)
		end)
	end
	return select
end

return Modal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	Notifications: small toasts and big server-wide announcements. Top of the screen, from the top:
	  y 4    Luck Event pill (HUD) and the server event pill under it (EventBanner, y 46)
	  y 92   big banners (area names, announcements)
	  y 186  chase banner (Chase) - toasts slide below it while it's showing (SetToastOffset)
	  y 186+ toasts
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)

local Notifications = {}

local KIND_COLORS = {
	info = Theme.Colors.Blue,
	success = Theme.Colors.Green,
	error = Theme.Colors.Red,
	rare = Theme.Colors.Yellow,
	event = Theme.Colors.Pink,
}

local toastHolder: Frame
local bannerHolder: Frame
local toastCounter = 0
local TOAST_Y = 186

-- Push the toasts down while something else (the chase banner) uses that spot.
function Notifications.SetToastOffset(extra: number)
	TweenService:Create(toastHolder, TweenInfo.new(0.25), { Position = UDim2.new(0.5, 0, 0, TOAST_Y + extra) }):Play()
end

function Notifications.Toast(text: string, kind: string?)
	local color = KIND_COLORS[kind or "info"] or Theme.Colors.Blue
	toastCounter -= 1 -- newest first
	local toast = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = toastCounter,
		Parent = toastHolder,
	}, {
		Theme.Corner(10),
		Theme.Stroke(2.5),
	})
	Theme.new("Frame", { Size = UDim2.new(0, 8, 1, 0), BackgroundColor3 = color, BorderSizePixel = 0, Parent = toast }, { Theme.Corner(10) })
	local label = Theme.Label({ Text = text, Font = Theme.Font, Size = UDim2.new(1, -24, 1, -8), Position = UDim2.fromOffset(16, 4), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 1.5, Parent = toast })
	if kind == "error" then
		Theme.PlaySound("Error")
	elseif kind == "event" then
		Theme.PlaySound("Announce")
	end

	-- Keep at most 3 toasts
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 4, #toasts do
		toasts[i]:Destroy()
	end

	task.delay(3.5, function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			task.wait(0.4)
			toast:Destroy()
		end
	end)
end

-- Big banner across the top (Secret donuts, area names...).
function Notifications.Banner(text: string, color: Color3, duration: number?, subtitle: string?)
	for _, child in bannerHolder:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local banner = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -120),
		Size = UDim2.new(1, 0, 0, if subtitle then 82 else 56),
		BackgroundTransparency = 1,
		Parent = bannerHolder,
	})
	local title = Theme.Label({ Text = text, TextColor3 = color, Size = UDim2.new(1, 0, 0, 52), StrokeThickness = 3.5, Parent = banner })
	local sub
	if subtitle then
		sub = Theme.Label({ Text = subtitle, Font = Theme.Font, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 54), TextColor3 = Theme.Colors.White, StrokeThickness = 2, Parent = banner })
	end
	TweenService:Create(banner, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 0) }):Play()
	task.delay(duration or 3, function()
		if banner.Parent then
			TweenService:Create(title, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
			if sub then
				TweenService:Create(sub, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
			end
			task.wait(0.5)
			banner:Destroy()
		end
	end)
end

function Notifications.Init()
	local gui = Theme.ScreenGui("Notifications", 20)
	toastHolder = Theme.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, TOAST_Y),
		Size = UDim2.fromOffset(460, 120),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Theme.AutoScale(toastHolder)
	bannerHolder = Theme.new("Frame", {
		Name = "Banners",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92),
		Size = UDim2.fromOffset(860, 92),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.AutoScale(bannerHolder)

	Remotes.Event("Notify").OnClientEvent:Connect(function(text: string, kind: string?)
		Notifications.Toast(text, kind)
	end)
	Remotes.Event("AreaAnnouncement").OnClientEvent:Connect(function(text: string, color: Color3)
		Notifications.Banner(text, color, 5)
		Theme.PlaySound("Announce")
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">PassOffer</string>
              <string name="Source"><![CDATA[--[[
	PassOffer: during a player's first hour of play (Config.PassOffer), a popup offers the money
	pass once per session: a few minutes after joining, and only when they're not running with a
	donut or looking at another window.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local PassOffer = {}

local player = Players.LocalPlayer

local function findPass(): Config.GamePass?
	for _, pass in Config.GamePasses do
		if pass.Key == Config.PassOffer.PassKey then
			return pass
		end
	end
	return nil
end

local function playTime(): number
	local value = player:GetAttribute("PlayTime")
	return if type(value) == "number" then value else 0
end

function PassOffer.Init()
	local pass = findPass()
	if not pass then
		return
	end
	local offer = pass
	local modal = Modal.new("🎁 SPECIAL OFFER", Theme.Colors.Green, Vector2.new(460, 340))
	local body = modal.Body
	Theme.Label({ Text = "💵", TextScaled = false, TextSize = 64, Size = UDim2.new(1, 0, 0, 70), Parent = body })
	Theme.Label({ Text = `{string.upper(offer.Name)} FOREVER!`, Font = Theme.Title, TextColor3 = Color3.fromRGB(120, 255, 120), Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 72), StrokeThickness = 3, Parent = body })
	Theme.Label({
		Text = `Every donut on your base earns {offer.Multiplier}x money - for good, even after rebirths!`,
		Font = Theme.Font, TextScaled = false, TextSize = 20, TextWrapped = true,
		Size = UDim2.new(1, -20, 0, 56), Position = UDim2.fromOffset(10, 118), StrokeThickness = 1.5, Parent = body,
	})
	local buy = Theme.Button({ Text = `BUY  R$ {offer.SuggestedPrice}`, Color = Theme.Colors.Green, Size = UDim2.new(0.6, -6, 0, 52), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = body })
	local later = Theme.Button({ Text = "No thanks", Color = Theme.Colors.Gray, Size = UDim2.new(0.4, -6, 0, 52), AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Parent = body })
	buy.Activated:Connect(function()
		State.Action("BuyPass", offer.Key)
		modal:Close()
	end)
	later.Activated:Connect(function()
		modal:Close()
	end)
	-- Show the real price once Roblox tells us
	task.spawn(function()
		if offer.GamePassId > 0 then
			local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, offer.GamePassId, Enum.InfoType.GamePass)
			if ok and info and info.PriceInRobux then
				Theme.SetButtonText(buy, `BUY  R$ {info.PriceInRobux}`)
			end
		end
	end)

	task.spawn(function()
		task.wait(Config.PassOffer.DelaySeconds)
		-- Wait for a calm moment (not mid-chase, no other window open), for up to 10 minutes
		for _ = 1, 600 do
			if State.Data.Passes[offer.Key] or playTime() > Config.PassOffer.FirstMinutes * 60 then
				return
			end
			if player:GetAttribute("CarryingDonut") == nil and not Modal.AnyOpen() then
				modal:Open()
				return
			end
			task.wait(1)
		end
	end)
end

return PassOffer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">PetsWindow</string>
              <string name="Source"><![CDATA[--[[
	Pets window:
	  Eggs - the eggs in your incubator, each with a countdown, and a HATCH button when it's ready
	         (plus what's inside each egg and the chances)
	  Pets - every pet you own: equip up to Config.Pets.MaxEquipped (they follow you and give their
	         money / treadmill bonus), Equip Best, or release pets you don't want.
	Hatching plays a full-screen animation: the egg shakes harder and harder, cracks, flashes, and
	the pet pops out.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Pets)
local PetModel = require(Shared.PetModel)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local PetsWindow = {}

local modal: Modal.Modal
local pages: { [string]: ScrollingFrame } = {}
local header: TextLabel
local eggCards: { [string]: { Frame: Frame, Bar: Frame, Label: TextLabel, Button: TextButton, HatchAt: number } } = {}
local currentTab = "Eggs"
local overlay: Frame
local confirmRelease: string? = nil

-- A 3D preview of a model in a ViewportFrame (the model's Top/Bottom attributes frame the camera).
local function preview(parent: Instance, model: Model, size: UDim2, position: UDim2): ViewportFrame
	local viewport = Theme.new("ViewportFrame", {
		BackgroundColor3 = Color3.fromRGB(25, 25, 40),
		Size = size,
		Position = position,
		Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		Parent = parent,
	}, { Theme.Corner(10) })
	model:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(200), 0))
	model.Parent = viewport
	local top = (model:GetAttribute("Top") :: number?) or 1.5
	local bottom = (model:GetAttribute("Bottom") :: number?) or 1.5
	local centerY = (top - bottom) / 2
	local height = top + bottom
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(Vector3.new(0, centerY + height * 0.25, -(height * 1.6 + 3)), Vector3.new(0, centerY, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

local function clearPage(page: ScrollingFrame)
	for _, child in page:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function card(page: Instance, order: number, color: Color3): Frame
	return Theme.new("Frame", { BackgroundColor3 = Theme.Colors.PanelLight, LayoutOrder = order, Parent = page }, {
		Theme.Corner(12),
		Theme.Stroke(3, color),
	})
end

--------------------------------------------------------------------------------
-- Eggs
--------------------------------------------------------------------------------
local function refreshEggTimers()
	local now = workspace:GetServerTimeNow()
	for _, entry in eggCards do
		local left = entry.HatchAt - now
		if left <= 0 then
			entry.Label.Text = "READY!"
			entry.Label.TextColor3 = Color3.fromRGB(120, 255, 130)
			entry.Bar.Size = UDim2.fromScale(1, 1)
			entry.Button.Visible = true
		else
			entry.Label.Text = "⏳ " .. Format.Duration(left)
			entry.Label.TextColor3 = Color3.fromRGB(255, 255, 255)
			entry.Button.Visible = false
		end
	end
end

type EggData = { Uid: string, Id: string, HatchAt: number }
type PetData = { Uid: string, Id: string }

local function buildEggs()
	local page = pages.Eggs
	clearPage(page)
	table.clear(eggCards)
	local eggs: { EggData } = State.Data.Eggs or {}
	if #eggs == 0 then
		local empty = card(page, 1, Theme.Colors.Gray)
		Theme.Label({
			Text = "No eggs yet! Eggs show up in Area 4 and further. Grab one (your guard wakes up!) and bring it to your base.",
			Font = Theme.Font, Size = UDim2.new(1, -16, 1, -16), Position = UDim2.fromOffset(8, 8), StrokeThickness = 1.5, Parent = empty,
		})
	end
	for order, eggData in eggs do
		local egg = Pets.EggById[eggData.Id]
		if egg then
			local c = card(page, order, egg.Accent)
			preview(c, PetModel.BuildEgg(egg, { NoEffects = true }), UDim2.new(1, -12, 0, 92), UDim2.fromOffset(6, 6))
			Theme.Label({ Text = egg.Name, TextColor3 = egg.Accent:Lerp(Color3.new(1, 1, 1), 0.4), Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 100), StrokeThickness = 2, Parent = c })
			local barBack = Theme.new("Frame", { Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 126), BackgroundColor3 = Theme.Colors.Outline, Parent = c }, { Theme.Corner(6) })
			local total = egg.HatchSeconds
			local done = math.clamp(1 - (eggData.HatchAt - workspace:GetServerTimeNow()) / total, 0, 1)
			local bar = Theme.new("Frame", { Size = UDim2.fromScale(done, 1), BackgroundColor3 = egg.Accent, Parent = barBack }, { Theme.Corner(6) })
			TweenService:Create(bar, TweenInfo.new(math.max(0, eggData.HatchAt - workspace:GetServerTimeNow()), Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) }):Play()
			local label = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -8, 1, -4), Position = UDim2.fromOffset(4, 2), StrokeThickness = 1.5, Parent = barBack })
			-- What's inside
			local odds = {}
			for _, entry in egg.Pool do
				local pet = Pets.ById[entry.Pet]
				table.insert(odds, `{pet.Name} {string.format("%.3g", Pets.Chance(egg, pet.Id) * 100)}%`)
			end
			Theme.Label({ Text = table.concat(odds, " • "), Font = Theme.Font, TextColor3 = Color3.fromRGB(200, 200, 215), Size = UDim2.new(1, -10, 0, 30), Position = UDim2.fromOffset(5, 152), StrokeThickness = 1, Parent = c })
			local hatch = Theme.Button({ Text = "HATCH!", Color = Theme.Colors.Green, Size = UDim2.new(1, -16, 0, 34), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Parent = c })
			hatch.Visible = false
			hatch.Activated:Connect(function()
				State.Action("HatchEgg", eggData.Uid)
			end)
			eggCards[eggData.Uid] = { Frame = c, Bar = bar, Label = label, Button = hatch, HatchAt = eggData.HatchAt }
		end
	end
	refreshEggTimers()
end

--------------------------------------------------------------------------------
-- Pets
--------------------------------------------------------------------------------
local function buildPets()
	local page = pages.Pets
	clearPage(page)
	local owned: { PetData } = State.Data.Pets or {}
	local equipped: { string } = State.Data.EquippedPets or {}
	local list = table.clone(owned)
	table.sort(list, function(a, b)
		local ea, eb = table.find(equipped, a.Uid) ~= nil, table.find(equipped, b.Uid) ~= nil
		if ea ~= eb then
			return ea
		end
		local pa, pb = Pets.ById[a.Id], Pets.ById[b.Id]
		local sa = if pa then pa.Money + pa.Speed else 0
		local sb = if pb then pb.Money + pb.Speed else 0
		return sa > sb
	end)
	if #list == 0 then
		local empty = card(page, 1, Theme.Colors.Gray)
		Theme.Label({ Text = "No pets yet! Hatch an egg to get your first pet.", Font = Theme.Font, Size = UDim2.new(1, -16, 1, -16), Position = UDim2.fromOffset(8, 8), StrokeThickness = 1.5, Parent = empty })
	end
	for order, petData in list do
		local pet = Pets.ById[petData.Id]
		if pet then
			local rarity = Pets.Rarity(pet.Rarity)
			local isEquipped = table.find(equipped, petData.Uid) ~= nil
			local c = card(page, order, if isEquipped then Theme.Colors.Green else rarity.Color)
			preview(c, PetModel.BuildPet(pet, { NoEffects = true }), UDim2.new(1, -12, 0, 92), UDim2.fromOffset(6, 6))
			Theme.Label({ Text = rarity.Id, TextColor3 = rarity.Color, Font = Theme.Font, Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 100), StrokeThickness = 1.2, Parent = c })
			Theme.Label({ Text = pet.Name, Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 116), StrokeThickness = 2, Parent = c })
			Theme.Label({ Text = Pets.BonusText(pet), Font = Theme.Font, TextColor3 = Theme.Colors.Money, Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 140), StrokeThickness = 1.2, Parent = c })
			local equip = Theme.Button({ Text = if isEquipped then "UNEQUIP" else "EQUIP", Color = if isEquipped then Theme.Colors.Orange else Theme.Colors.Green, Size = UDim2.new(0.72, -10, 0, 32), Position = UDim2.new(0, 6, 1, -38), Parent = c })
			equip.Activated:Connect(function()
				State.Action(if isEquipped then "UnequipPet" else "EquipPet", petData.Uid)
			end)
			local release = Theme.Button({ Text = "✖", Color = Theme.Colors.Red, Size = UDim2.new(0.28, -4, 0, 32), Position = UDim2.new(0.72, -2, 1, -38), Parent = c })
			release.Activated:Connect(function()
				if confirmRelease == petData.Uid then
					confirmRelease = nil
					State.Action("ReleasePet", petData.Uid)
				else
					confirmRelease = petData.Uid
					Theme.SetButtonText(release, "SURE?")
					task.delay(3, function()
						if confirmRelease == petData.Uid then
							confirmRelease = nil
						end
						if release.Parent then
							Theme.SetButtonText(release, "✖")
						end
					end)
				end
			end)
		end
	end
end

local function refreshHeader()
	local equippedIds = {}
	local pets: { PetData } = State.Data.Pets or {}
	local equipped: { string } = State.Data.EquippedPets or {}
	for _, uid in equipped do
		for _, pet in pets do
			if pet.Uid == uid then
				table.insert(equippedIds, pet.Id)
			end
		end
	end
	local money, speed = Economy.PetBonuses(equippedIds)
	if currentTab == "Eggs" then
		local capacity = Config.Pets.MaxEggs + Config.Pets.IncubatorSize.PerLevel * State.Number("IncubatorSize")
		local hatchSpeed = 1 + Config.Pets.IncubatorSpeed.PerLevel * State.Number("IncubatorSpeed")
		header.Text = `🥚 Incubator {#(State.Data.Eggs or {})}/{capacity}  •  ⚡ x{Format.Multiplier(hatchSpeed)} speed  •  upgrade it in the Shop`
	else
		header.Text = `🐾 {#pets}/{Config.Pets.MaxPets} pets   •   Equipped {#equippedIds}/{Config.Pets.MaxEquipped}: +{math.floor(money * 100 + 0.5)}% money, +{math.floor(speed * 100 + 0.5)}% speed`
	end
end

local function refresh()
	refreshHeader()
	if currentTab == "Eggs" then
		buildEggs()
	else
		buildPets()
	end
end

-- How many eggs are ready to hatch (HUD badge).
function PetsWindow.ReadyEggs(): number
	local now = workspace:GetServerTimeNow()
	local count = 0
	local eggs: { EggData } = State.Data.Eggs or {}
	for _, egg in eggs do
		if egg.HatchAt <= now then
			count += 1
		end
	end
	return count
end

--------------------------------------------------------------------------------
-- Hatch animation
--------------------------------------------------------------------------------
local function playHatch(info: { EggId: string, PetId: string })
	local egg = Pets.EggById[info.EggId]
	local pet = Pets.ById[info.PetId]
	if not egg or not pet then
		return
	end
	local rarity = Pets.Rarity(pet.Rarity)
	modal:Close()
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	TweenService:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 0.35 }):Play()
	local stage = Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(340, 340), BackgroundTransparency = 1, Parent = overlay })
	Theme.AutoScale(stage)
	local eggView = preview(stage, PetModel.BuildEgg(egg, { NoEffects = true }), UDim2.fromScale(1, 1), UDim2.new())
	eggView.BackgroundTransparency = 1
	-- Shake harder and harder
	local shaking = true
	local startedAt = os.clock()
	local connection = RunService.RenderStepped:Connect(function()
		if not shaking then
			return
		end
		local p = math.clamp((os.clock() - startedAt) / 2.2, 0, 1)
		eggView.Rotation = math.sin(os.clock() * (8 + p * 30)) * (4 + p * 22)
		eggView.Position = UDim2.fromOffset(math.sin(os.clock() * 40) * p * 6, 0)
	end)
	for i = 1, 3 do
		task.delay(0.6 * i, function()
			Theme.PlaySound("Crack")
		end)
	end
	task.wait(2.2)
	shaking = false
	connection:Disconnect()
	-- Flash!
	local flash = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 5, Parent = overlay })
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	task.delay(0.7, function()
		flash:Destroy()
	end)
	Theme.PlaySound("Hatch")
	eggView:Destroy()
	-- Rays behind the pet for the rare ones
	if rarity.Order >= 4 then
		for i = 1, 8 do
			local ray = Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(18, 460), Rotation = i * 22.5, BackgroundColor3 = rarity.Color, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = stage }, {
				Theme.new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) }) }),
			})
			TweenService:Create(ray, TweenInfo.new(6, Enum.EasingStyle.Linear), { Rotation = ray.Rotation + 90 }):Play()
		end
	end
	local petView = preview(stage, PetModel.BuildPet(pet, { NoEffects = true }), UDim2.fromScale(1, 1), UDim2.new())
	petView.BackgroundTransparency = 1
	local popScale = Theme.new("UIScale", { Scale = 0.2, Parent = petView })
	TweenService:Create(popScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local title = Theme.Label({ Text = `{string.upper(rarity.Id)}!`, TextColor3 = rarity.Color, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -70), Size = UDim2.fromOffset(420, 48), StrokeThickness = 4, Parent = stage })
	Theme.Label({ Text = pet.Name, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.fromOffset(420, 44), StrokeThickness = 3.5, Parent = stage })
	Theme.Label({ Text = `{Pets.BonusText(pet)}  ({string.format("%.3g", Pets.Chance(egg, pet.Id) * 100)}% chance)`, Font = Theme.Font, TextColor3 = Theme.Colors.Money, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 46), Size = UDim2.fromOffset(420, 26), StrokeThickness = 2, Parent = stage })
	if rarity.Order >= 6 then
		task.spawn(function()
			while title.Parent do
				title.TextColor3 = Color3.fromHSV((os.clock() * 0.4) % 1, 0.7, 1)
				task.wait()
			end
		end)
	end
	-- Spin the pet slowly until it closes
	local camera = petView:FindFirstChildOfClass("Camera")
	local spin = RunService.RenderStepped:Connect(function(dt: number)
		if camera then
			camera.CFrame = CFrame.Angles(0, dt * 0.8, 0) * camera.CFrame
		end
	end)
	task.wait(3.2)
	spin:Disconnect()
	TweenService:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
	stage:Destroy()
	task.wait(0.3)
	overlay.Visible = false
end

function PetsWindow.Open()
	modal:Open()
end

function PetsWindow.Init()
	modal = Modal.new("🐾 PETS", Theme.Colors.Pink, Vector2.new(760, 520))
	local body = modal.Body
	header = Theme.Label({ Text = "", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -330, 0, 28), Position = UDim2.fromOffset(0, 50), StrokeThickness = 1.5, Parent = body })
	local hatchAll = Theme.Button({ Text = "HATCH ALL READY", Color = Theme.Colors.Green, Size = UDim2.fromOffset(170, 34), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -150, 0, 48), Parent = body })
	hatchAll.Activated:Connect(function()
		State.Action("HatchEgg")
	end)
	local best = Theme.Button({ Text = "EQUIP BEST", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(140, 34), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 48), Parent = body })
	best.Activated:Connect(function()
		State.Action("EquipBestPets")
	end)
	for _, name in { "Eggs", "Pets" } do
		pages[name] = Theme.new("ScrollingFrame", {
			Name = name,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 88),
			Size = UDim2.new(1, 0, 1, -88),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 8,
			Visible = false,
			Parent = body,
		}, {
			Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(168, 228), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
			Theme.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
		})
	end
	local selectTab = Modal.Tabs(body, {
		{ Name = "Eggs", Text = "🥚 Eggs", Color = Theme.Colors.Orange },
		{ Name = "Pets", Text = "🐾 Pets", Color = Theme.Colors.Pink },
	}, function(name)
		currentTab = name
		for pageName, page in pages do
			page.Visible = pageName == name
		end
		hatchAll.Visible = name == "Eggs"
		best.Visible = name == "Pets"
		refresh()
	end)
	modal.OnOpen = function()
		selectTab(currentTab)
	end
	State.Changed:Connect(function()
		if modal:IsOpen() then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if modal:IsOpen() and currentTab == "Eggs" then
				refreshEggTimers()
			end
		end
	end)

	local gui = Theme.ScreenGui("Hatching", 30)
	overlay = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Visible = false, Parent = gui })
	gui.IgnoreGuiInset = true
	local queue: { { EggId: string, PetId: string } } = {}
	local playing = false
	Remotes.Event("EggHatched").OnClientEvent:Connect(function(info)
		table.insert(queue, info)
		if playing then
			return
		end
		playing = true
		while #queue > 0 do
			local next = table.remove(queue, 1)
			if next then
				playHatch(next)
			end
		end
		playing = false
	end)
end

return PetsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Rebirth</string>
              <string name="Source"><![CDATA[--[[
	Rebirth window: requirements for the next rebirth (with progress bars), what you get, what
	resets and what you keep. The button asks for a second click to confirm.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Rebirth = {}

local modal: Modal.Modal
local refresh: () -> () = function() end

function Rebirth.Open()
	modal:Open()
end

-- True when the next rebirth is affordable (the HUD button glows).
function Rebirth.IsReady(): boolean
	local nextRebirth = Economy.NextRebirth(State.Number("Rebirths"))
	return nextRebirth ~= nil and State.Number("Speed") >= nextRebirth.Speed and State.Number("Money") >= nextRebirth.Cost
end

local function progressBar(parent: Instance, y: number, color: Color3): (Frame, TextLabel)
	local bar = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, y), BackgroundColor3 = Theme.Colors.Outline, Parent = parent }, { Theme.Corner(8), Theme.Stroke(2) })
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = color, Parent = bar }, { Theme.Corner(8) })
	local label = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), StrokeThickness = 1.8, Parent = bar })
	return fill, label
end

function Rebirth.Init()
	modal = Modal.new("🔄 REBIRTH", Theme.Colors.Orange, Vector2.new(620, 520))
	local body = modal.Body

	local current = Theme.Label({ Text = "", RichText = true, Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 30), Parent = body })
	local reward = Theme.Label({ Text = "", RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 36), TextColor3 = Theme.Colors.Yellow, Parent = body })
	local unlock = Theme.Label({ Text = "", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 72), TextColor3 = Color3.fromRGB(140, 230, 255), StrokeThickness = 1.8, Parent = body })
	local speedFill, speedLabel = progressBar(body, 108, Theme.Colors.Speed)
	local moneyFill, moneyLabel = progressBar(body, 146, Theme.Colors.Green)
	Theme.Label({
		Text = "❌ Resets: Money, Speed, treadmill, Speed Multiplier and the donuts in your base\n✅ Keeps: game passes, items, skins, base expansions and Index rewards",
		Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 188), StrokeThickness = 1.5, Parent = body,
	})
	local button = Theme.Button({ Text = "REBIRTH", Color = Theme.Colors.Orange, Size = UDim2.new(1, -40, 0, 64), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Parent = body })
	local confirming = false

	refresh = function()
		local rebirths = State.Number("Rebirths")
		local moneyMult = Economy.RebirthMoneyMultiplier(rebirths)
		local speedMult = Economy.RebirthSpeedMultiplier(rebirths)
		current.Text = `Rebirths: <b>{rebirths}</b>   •   💵 Money x{Format.Multiplier(moneyMult)}   •   ⚡ Speed x{Format.Multiplier(speedMult)}`
		local nextRebirth = Economy.NextRebirth(rebirths)
		if not nextRebirth then
			reward.Text = "👑 MAX REBIRTH! You're a donut legend."
			unlock.Text = ""
			speedFill.Size = UDim2.fromScale(1, 1)
			moneyFill.Size = UDim2.fromScale(1, 1)
			speedLabel.Text = "Done"
			moneyLabel.Text = "Done"
			Theme.SetButtonText(button, "MAXED")
			Theme.SetButtonColor(button, Theme.Colors.Gray)
			return
		end
		reward.Text = `REBIRTH {rebirths + 1}: 💵 x{Format.Multiplier(Economy.RebirthMoneyMultiplier(rebirths + 1))} money  ⚡ x{Format.Multiplier(Economy.RebirthSpeedMultiplier(rebirths + 1))} speed`
		local unlockText = ""
		for _, world in Areas.Worlds do
			if world.RequiredRebirths == rebirths + 1 then
				unlockText = `🔓 Unlocks World {world.Id}: {world.Icon} {world.Name} (everyone is x{world.WalkMultiplier} faster there)`
			end
		end
		unlock.Text = unlockText
		local speed, money = State.Number("Speed"), State.Number("Money")
		speedFill.Size = UDim2.fromScale(math.clamp(speed / nextRebirth.Speed, 0, 1), 1)
		moneyFill.Size = UDim2.fromScale(math.clamp(money / nextRebirth.Cost, 0, 1), 1)
		speedLabel.Text = `⚡ Speed {Format.Number(speed)} / {Format.Number(nextRebirth.Speed)}`
		moneyLabel.Text = `💵 Money {Format.Money(money)} / {Format.Money(nextRebirth.Cost)}`
		if Rebirth.IsReady() then
			Theme.SetButtonText(button, if confirming then "ARE YOU SURE? CLICK AGAIN" else "🔄 REBIRTH NOW")
			Theme.SetButtonColor(button, if confirming then Theme.Colors.Red else Theme.Colors.Green)
		else
			Theme.SetButtonText(button, "NOT READY YET")
			Theme.SetButtonColor(button, Theme.Colors.Gray)
		end
	end

	button.Activated:Connect(function()
		if not Rebirth.IsReady() then
			return
		end
		if confirming then
			confirming = false
			State.Action("Rebirth")
			modal:Close()
		else
			confirming = true
			refresh()
			task.delay(4, function()
				confirming = false
				refresh()
			end)
		end
	end)

	for _, name in { "Speed", "Money", "Rebirths" } do
		State.OnAttribute(name, function()
			if modal:IsOpen() then
				refresh()
			end
		end)
	end
	modal.OnOpen = function()
		confirming = false
		refresh()
	end
end

return Rebirth
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[--[[
	Settings window + background music player.
	Music on/off and volume are saved per player. Tracks come from Config.Music.Tracks.

	The music never stops on its own: a single song loops, several songs play one after another
	(and start over), and a watchdog restarts playback if Roblox ever drops it. Songs that fail to
	load (a private asset, a deleted asset, or a typo in the ID) are skipped with a warning in the
	Output window; if none of them load, it keeps retrying (a slow connection while the map loads).
]]

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Signal = require(Shared.Signal)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Settings = {}

-- Fires (on: boolean) whenever music is switched on or off (the HUD's music toggle listens).
Settings.MusicChanged = Signal.new()

local modal: Modal.Modal
local sound: Sound
local trackIndex = 1
local volume = Config.Music.DefaultVolume
local musicOn = true
local loaded = false -- becomes true once the saved settings arrive
local refresh: () -> () = function() end
local status = "" -- shown under "Now playing" when something is wrong
local playToken = 0
local failed: { [number]: boolean } = {}
local LOAD_TIMEOUT = 25 -- seconds a song may take to load before it's skipped
local RETRY_DELAY = 30 -- seconds before trying again when no song could be loaded
local retryPending = false

local tracks = Config.Music.Tracks
local usingFallback = false

local function applyVolume()
	sound.Volume = if musicOn then volume else 0
end

local function workingTracks(): number
	local count = 0
	for i = 1, #tracks do
		if not failed[i] then
			count += 1
		end
	end
	return count
end

local playTrack: (index: number) -> ()

playTrack = function(index: number)
	if #tracks == 0 then
		return
	end
	if workingTracks() == 0 and not usingFallback and #Config.Music.Fallback > 0 then
		-- None of the chosen songs loads: play the backup song(s) instead
		usingFallback = true
		tracks = Config.Music.Fallback
		table.clear(failed)
		playTrack(1)
		return
	end
	if workingTracks() == 0 then
		-- Nothing loaded (yet): try every song again in a while instead of going silent for good.
		sound:Stop()
		status = "Couldn't load the music - trying again soon"
		refresh()
		if not retryPending then
			retryPending = true
			task.delay(RETRY_DELAY, function()
				retryPending = false
				table.clear(failed)
				playTrack(trackIndex)
			end)
		end
		return
	end
	-- Skip songs that already failed
	for _ = 1, #tracks do
		trackIndex = (index - 1) % #tracks + 1
		if not failed[trackIndex] then
			break
		end
		index += 1
	end
	playToken += 1
	local token = playToken
	local track = tracks[trackIndex]
	sound:Stop()
	-- One song: let Roblox loop it seamlessly. Several: play them in turn (Ended / the watchdog).
	sound.Looped = workingTracks() <= 1
	sound.SoundId = "rbxassetid://" .. tostring(track.Id)
	sound.TimePosition = 0
	sound:Play()
	status = ""
	refresh()
	-- A song that never loads (private/deleted asset) never plays: skip it after a while.
	task.delay(LOAD_TIMEOUT, function()
		if token ~= playToken then
			return
		end
		if not sound.IsLoaded or sound.TimeLength <= 0 then
			failed[trackIndex] = true
			warn(`[Music] Couldn't load "{track.Name}" (rbxassetid://{track.Id}). Audio must be public or uploaded by the game's owner. Skipping it.`)
			playTrack(trackIndex + 1)
		end
	end)
end

local function save()
	State.Action("SetMusic", { Volume = volume, On = musicOn })
end

function Settings.Open()
	modal:Open()
end

function Settings.MusicOn(): boolean
	return musicOn
end

function Settings.SetMusicOn(on: boolean)
	if on == musicOn then
		return
	end
	musicOn = on
	applyVolume()
	refresh()
	save()
	Settings.MusicChanged:Fire(musicOn)
end

function Settings.Init()
	sound = Instance.new("Sound")
	sound.Name = "Soundtrack"
	sound.Looped = false
	sound.Parent = SoundService
	applyVolume()
	sound.Ended:Connect(function()
		if not sound.Looped then
			playTrack(trackIndex + 1)
		end
	end)
	-- Watchdog: if the music ever stops by itself (a missed Ended event, the engine dropping the
	-- sound...), start the next song. "Music off" only turns the volume down, so this never fights it.
	task.spawn(function()
		while true do
			task.wait(3)
			if #tracks > 0 and not retryPending and sound.IsLoaded and not sound.IsPlaying then
				playTrack(if sound.Looped then trackIndex else trackIndex + 1)
			end
		end
	end)

	modal = Modal.new("⚙️ SETTINGS", Theme.Colors.Gray, Vector2.new(520, 420))
	local body = modal.Body

	Theme.Label({ Text = "🎵 MUSIC", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 36), Parent = body })
	local nowPlaying = Theme.Label({ Text = "", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 40), StrokeThickness = 1.5, Parent = body })

	local toggle = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.fromOffset(150, 52), Position = UDim2.fromOffset(0, 80), Parent = body })
	local skip = Theme.Button({ Text = "NEXT ⏭", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(150, 52), Position = UDim2.fromOffset(160, 80), Parent = body })

	Theme.Label({ Text = "Volume", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 150), StrokeThickness = 1.5, Parent = body })
	local minus = Theme.Button({ Text = "−", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(0, 182), Parent = body })
	local bar = Theme.new("Frame", { Size = UDim2.fromOffset(300, 26), Position = UDim2.fromOffset(62, 195), BackgroundColor3 = Theme.Colors.Outline, Parent = body }, { Theme.Corner(8), Theme.Stroke(2) })
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(volume, 1), BackgroundColor3 = Theme.Colors.Green, Parent = bar }, { Theme.Corner(8) })
	local plus = Theme.Button({ Text = "+", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(372, 182), Parent = body })
	local help = Theme.Button({ Text = "❓ HOW TO PLAY", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(220, 52), Position = UDim2.fromOffset(0, 256), Parent = body })
	help.Activated:Connect(function()
		modal:Close()
		require(script.Parent.Tutorial).Open()
	end)
	local notes = Theme.Button({ Text = "📰 UPDATE LOG", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(220, 52), Position = UDim2.fromOffset(230, 256), Parent = body })
	notes.Activated:Connect(function()
		require(script.Parent.UpdateNotes).Open()
	end)
	local percent = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.fromOffset(60, 30), Position = UDim2.fromOffset(430, 193), StrokeThickness = 1.5, Parent = body })

	refresh = function()
		Theme.SetButtonText(toggle, if musicOn then "MUSIC: ON" else "MUSIC: OFF")
		Theme.SetButtonColor(toggle, if musicOn then Theme.Colors.Green else Theme.Colors.Gray)
		fill.Size = UDim2.fromScale(volume, 1)
		percent.Text = math.floor(volume * 100 + 0.5) .. "%"
		if #tracks == 0 then
			nowPlaying.Text = "No songs added yet (Config.Music.Tracks)"
		elseif status ~= "" then
			nowPlaying.Text = status
		else
			nowPlaying.Text = "Now playing: " .. tracks[trackIndex].Name
		end
	end

	toggle.Activated:Connect(function()
		Settings.SetMusicOn(not musicOn)
	end)
	skip.Activated:Connect(function()
		playTrack(trackIndex + 1)
	end)
	local function changeVolume(delta: number)
		volume = math.clamp(math.floor((volume + delta) * 10 + 0.5) / 10, 0, 1)
		applyVolume()
		refresh()
		save()
	end
	minus.Activated:Connect(function()
		changeVolume(-0.1)
	end)
	plus.Activated:Connect(function()
		changeVolume(0.1)
	end)

	-- Use the player's saved settings once they arrive
	State.Changed:Connect(function(snapshot)
		if loaded then
			return
		end
		loaded = true
		if type(snapshot.MusicVolume) == "number" then
			volume = snapshot.MusicVolume
		end
		if type(snapshot.MusicOn) == "boolean" then
			musicOn = snapshot.MusicOn
		end
		applyVolume()
		refresh()
		Settings.MusicChanged:Fire(musicOn)
	end)

	refresh()
	playTrack(1)
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--[[
	Shop window with five tabs:
	  Upgrades  - Speed Multiplier, Treadmill tiers, Base Expansions and Incubator upgrades (money)
	  Boosts    - 1.5x / 2x / 3x / 4x / 5x / 10x Money, 2x Speed, Teleporter and the Luck Event (Robux)
	  Crates    - Common / Rare / Epic / Legendary crates (Robux). Every outcome and its exact chance
	              is shown on the card, and "All odds" lists the pets inside every egg too (Roblox's
	              paid random items rules). Hidden purchase for players whose region blocks them.
	  Items     - weapons, traps and the base lock (in-game money), with spinning 3D previews of the
	              real models (shared/ItemModel.luau)
	  Skins     - base skins (paid with your Speed stat), equip the ones you own
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local ItemModel = require(Shared.ItemModel)
local Crates = require(Shared.Crates)
local CrateModel = require(Shared.CrateModel)
local Pets = require(Shared.Pets)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Shop = {}

local modal: Modal.Modal
local pages: { [string]: ScrollingFrame } = {}
local selectTab: (string) -> ()
local refreshers: { () -> () } = {}
local robuxPrices: { [number]: number } = {}
local priceFailed: { [number]: boolean } = {}
local buildItems: (ScrollingFrame) -> ()

local function refreshAll()
	for _, refresh in refreshers do
		refresh()
	end
end

local function newPage(name: string, parent: Instance, columns: number, cardHeight: number): ScrollingFrame
	local page = Theme.new("ScrollingFrame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 1, -54),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = parent,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.new(1 / columns, -10, 0, cardHeight),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
	})
	pages[name] = page
	return page
end

local function card(parent: Instance, order: number, color: Color3): Frame
	return Theme.new("Frame", {
		BackgroundColor3 = Theme.Colors.PanelLight,
		LayoutOrder = order,
		Parent = parent,
	}, {
		Theme.Corner(14),
		Theme.Stroke(3, Theme.Darken(color, 0.3)),
		Theme.Gradient(Theme.Lighten(Theme.Colors.PanelLight, 0.08), Theme.Colors.Panel),
	})
end

--------------------------------------------------------------------------------
-- Upgrades
--------------------------------------------------------------------------------
local function buildUpgrades(page: ScrollingFrame)
	-- Speed multiplier
	local multCard = card(page, 1, Theme.Colors.Purple)
	Theme.Label({ Text = "⚡ SPEED MULTIPLIER", TextColor3 = Color3.fromRGB(200, 160, 255), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = multCard })
	local multInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = multCard })
	local multButton = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = multCard })
	multButton.Activated:Connect(function()
		State.Action("BuySpeedMultiplier")
	end)

	-- Treadmill
	local treadCard = card(page, 2, Theme.Colors.Orange)
	Theme.Label({ Text = "🏃 TREADMILL", TextColor3 = Color3.fromRGB(255, 200, 120), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = treadCard })
	local treadInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = treadCard })
	local treadButton = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = treadCard })
	treadButton.Activated:Connect(function()
		State.Action("BuyTreadmill")
	end)

	-- Base expansion
	local expandCard = card(page, 3, Theme.Colors.Blue)
	local expandTitle = Theme.Label({ Text = "🏗 BASE EXPANSION", TextColor3 = Color3.fromRGB(140, 210, 255), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = expandCard })
	local expandInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = expandCard })
	local expandButton = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = expandCard })
	expandButton.Activated:Connect(function()
		local expansions = State.Number("Expansions")
		if Economy.ExpansionCost(expansions) then
			State.Action("BuyExpansion")
		elseif Economy.NextFloorCost(expansions, math.max(1, State.Number("Floors"))) then
			State.Action("BuyFloor")
		end
	end)

	-- Incubator upgrades
	local function incubatorCard(order: number, kind: string, title: string, color: Color3): (TextLabel, TextButton)
		local c = card(page, order, color)
		Theme.Label({ Text = title, TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.4), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = c })
		local info = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = c })
		local button = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = c })
		button.Activated:Connect(function()
			State.Action("BuyIncubatorUpgrade", kind)
		end)
		return info, button
	end
	local hatchInfo, hatchButton = incubatorCard(4, "Speed", "⚡ INCUBATOR SPEED", Theme.Colors.Pink)
	local sizeInfo, sizeButton = incubatorCard(5, "Size", "🥚 INCUBATOR SIZE", Theme.Colors.Orange)

	-- Summary
	local summary = card(page, 6, Theme.Colors.Blue)
	local summaryText = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -24, 1, -20), Position = UDim2.fromOffset(12, 10), StrokeThickness = 1.5, Parent = summary })
	local tip = card(page, 7, Theme.Colors.Green)
	Theme.Label({
		Text = `💡 Run on your treadmill to gain Speed: every {Config.Speed.SpeedPerWalk} Speed is +1 walk speed. Faster = you can steal from further areas, where donuts are rarer and earn way more! Upgrading your donuts (E on them) is cheap early on.`,
		Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -24, 1, -20), Position = UDim2.fromOffset(12, 10), StrokeThickness = 1.5, Parent = tip,
	})

	table.insert(refreshers, function()
		local money = State.Number("Money")
		local passMult = math.max(1, State.Number("SpeedPassMultiplier"))

		local rebirths = State.Number("Rebirths")
		local multLevel = State.Number("SpeedMultLevel")
		if multLevel >= Config.SpeedMultiplier.MaxLevel then
			multInfo.Text = `x{Format.Multiplier(Economy.SpeedMultiplier(multLevel))} (MAX)`
			Theme.SetButtonText(multButton, "MAXED")
			Theme.SetButtonColor(multButton, Theme.Colors.Gray)
		else
			local cost = Economy.SpeedMultiplierCost(multLevel)
			local percent = math.floor(Config.SpeedMultiplier.PerLevel * 100 + 0.5)
			multInfo.Text = `x{Format.Multiplier(Economy.SpeedMultiplier(multLevel))}  →  x{Format.Multiplier(Economy.SpeedMultiplier(multLevel + 1))}\n+{percent}% treadmill speed per level (Lv {multLevel}/{Config.SpeedMultiplier.MaxLevel})`
			Theme.SetButtonText(multButton, "Buy " .. Format.Money(cost))
			Theme.SetButtonColor(multButton, if money >= cost then Theme.Colors.Green else Theme.Colors.Gray)
		end

		local level = math.max(1, State.Number("TreadmillLevel"))
		local tier = Economy.TreadmillTier(level)
		if level >= Economy.MaxTreadmillLevel() then
			treadInfo.Text = `{tier.Name} (Tier {level}/{Economy.MaxTreadmillLevel()}) - the best!\n+{Format.Rate(tier.Rate)} speed/s base`
			Theme.SetButtonText(treadButton, "MAXED")
			Theme.SetButtonColor(treadButton, Theme.Colors.Gray)
		else
			local nextTier = Economy.TreadmillTier(level + 1)
			treadInfo.Text = `{tier.Name} → {nextTier.Name} (Tier {level + 1})\n+{Format.Rate(tier.Rate)}/s → +{Format.Rate(nextTier.Rate)}/s base`
			if rebirths < nextTier.RequiredRebirths then
				Theme.SetButtonText(treadButton, `🔒 Needs Rebirth {nextTier.RequiredRebirths}`)
				Theme.SetButtonColor(treadButton, Theme.Colors.Gray)
			else
				Theme.SetButtonText(treadButton, "Buy " .. Format.Money(nextTier.Cost))
				Theme.SetButtonColor(treadButton, if money >= nextTier.Cost then Theme.Colors.Green else Theme.Colors.Gray)
			end
		end

		local expansions = State.Number("Expansions")
		local floors = math.max(1, State.Number("Floors"))
		local slots = Economy.SlotCount(expansions, floors)
		local expandCost = Economy.ExpansionCost(expansions)
		local floorCost = Economy.NextFloorCost(expansions, floors)
		if expandCost then
			expandTitle.Text = "🏗 BASE EXPANSION"
			expandInfo.Text = `{slots} → {slots + Config.Plots.ExpansionSlots} donut stands\nKept forever, even when you rebirth`
			Theme.SetButtonText(expandButton, "Buy " .. Format.Money(expandCost))
			Theme.SetButtonColor(expandButton, if money >= expandCost then Theme.Colors.Green else Theme.Colors.Gray)
		elseif floorCost then
			-- Ground floor full: the next step is a whole new floor
			expandTitle.Text = if floors >= 2 then "🏢 THIRD FLOOR" else "🏢 SECOND FLOOR"
			expandInfo.Text = `{slots} → {slots + Config.Plots.UpperFloors.Slots} donut stands on a new floor\nKept forever, even when you rebirth`
			Theme.SetButtonText(expandButton, "Buy " .. Format.Money(floorCost))
			Theme.SetButtonColor(expandButton, if money >= floorCost then Theme.Colors.Green else Theme.Colors.Gray)
		else
			expandTitle.Text = "🏢 BASE"
			expandInfo.Text = `{slots} donut stands on {floors} floors - fully built!`
			Theme.SetButtonText(expandButton, "MAXED")
			Theme.SetButtonColor(expandButton, Theme.Colors.Gray)
		end

		local function incubatorRow(kind: string, info: TextLabel, button: TextButton)
			local level = State.Number(if kind == "Speed" then "IncubatorSpeed" else "IncubatorSize")
			local cost = Economy.IncubatorUpgradeCost(kind, level)
			local now = if kind == "Speed" then `x{Format.Multiplier(Economy.IncubatorSpeed(level))} hatch speed` else `{Economy.IncubatorCapacity(level)} eggs at once`
			if cost then
				local nextText = if kind == "Speed" then `x{Format.Multiplier(Economy.IncubatorSpeed(level + 1))}` else `{Economy.IncubatorCapacity(level + 1)} eggs`
				info.Text = `{now}  →  {nextText}\nKept forever, even when you rebirth`
				Theme.SetButtonText(button, "Buy " .. Format.Money(cost))
				Theme.SetButtonColor(button, if money >= cost then Theme.Colors.Green else Theme.Colors.Gray)
			else
				info.Text = `{now} (MAX)`
				Theme.SetButtonText(button, "MAXED")
				Theme.SetButtonColor(button, Theme.Colors.Gray)
			end
		end
		incubatorRow("Speed", hatchInfo, hatchButton)
		incubatorRow("Size", sizeInfo, sizeButton)

		local indexBonus = State.Number("IndexBonus")
		local petBonus = State.Number("PetSpeedBonus")
		local rate = Economy.TreadmillRate(level, multLevel, passMult, rebirths, indexBonus, petBonus)
		local walk = State.Number("WalkSpeed")
		local extras = {}
		if rebirths > 0 then
			table.insert(extras, `🔄 x{Format.Multiplier(Economy.RebirthSpeedMultiplier(rebirths))}`)
		end
		if indexBonus > 0 then
			table.insert(extras, `📖 +{indexBonus}%`)
		end
		if petBonus > 0 then
			table.insert(extras, `🐾 +{math.floor(petBonus * 100 + 0.5)}%`)
		end
		local extraText = if #extras > 0 then " (" .. table.concat(extras, " ") .. ")" else ""
		summaryText.Text = `<b>YOUR STATS</b>\nTreadmill: <font color="#c9a0ff">+{Format.Rate(rate)} speed/s</font>{extraText}\nSpeed: <font color="#c9a0ff">{Format.Number(State.Number("Speed"))}</font> (walk speed {math.floor(walk)})\nIncome: <font color="#8dff6a">{Format.Money(State.Number("Income"))}/s</font>`
	end)
end

--------------------------------------------------------------------------------
-- Game passes
--------------------------------------------------------------------------------
local function robuxText(passId: number, suggested: number): string
	if passId <= 0 then
		return `R$ {suggested}`
	end
	local price = robuxPrices[passId]
	return if price then `R$ {price}` elseif priceFailed[passId] then "BUY" else "R$ ..."
end

local function fetchPrice(passId: number, infoType: Enum.InfoType?)
	if passId <= 0 or robuxPrices[passId] then
		return
	end
	task.spawn(function()
		for attempt = 1, 3 do
			local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, passId, infoType or Enum.InfoType.GamePass)
			if ok and info and info.PriceInRobux then
				robuxPrices[passId] = info.PriceInRobux
				refreshAll()
				return
			end
			task.wait(attempt * 3)
		end
		priceFailed[passId] = true -- still buyable: the button just says BUY
		refreshAll()
	end)
end

local function buildPasses(page: ScrollingFrame)
	for order, pass in Config.GamePasses do
		fetchPrice(pass.GamePassId)
		local c = card(page, order, pass.Color)
		local icon = if pass.Kind == "Money" then "💵" elseif pass.Kind == "Speed" then "⚡" else "🌀"
		local description = if pass.Kind == "Money"
			then `Earn {pass.Multiplier}x money from every donut, forever`
			elseif pass.Kind == "Speed" then "Double speed from your treadmill, forever"
			else "Teleport to any world or area you've unlocked, any time"
		Theme.Label({ Text = icon, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(10, 10), Parent = c })
		Theme.Label({ Text = string.upper(pass.Name), TextColor3 = pass.Color:Lerp(Color3.new(1, 1, 1), 0.3), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 12), Parent = c })
		Theme.Label({
			Text = description,
			Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 50), StrokeThickness = 1.2, Parent = c,
		})
		local button = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 48), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = c })
		button.Activated:Connect(function()
			if not State.Data.Passes[pass.Key] then
				State.Action("BuyPass", pass.Key)
			end
		end)
		table.insert(refreshers, function()
			if State.Data.Passes[pass.Key] then
				Theme.SetButtonText(button, "OWNED ✓")
				Theme.SetButtonColor(button, Theme.Colors.Gray)
			else
				Theme.SetButtonText(button, robuxText(pass.GamePassId, pass.SuggestedPrice))
				Theme.SetButtonColor(button, Theme.Colors.Green)
			end
		end)
	end
	-- Luck Event (a developer product: can be bought again and again)
	local luck = card(page, 90, Color3.fromRGB(60, 200, 90))
	Theme.Label({ Text = "🍀", Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(10, 10), Parent = luck })
	Theme.Label({ Text = "LUCK EVENT (10 MIN)", TextColor3 = Color3.fromRGB(140, 255, 160), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 12), Parent = luck })
	Theme.Label({ Text = `Rare donuts x{Config.LuckEvent.RarityLuck}, mutations x{Config.LuckEvent.MutationLuck}, big sizes x{Config.LuckEvent.BigSizeLuck} for EVERYONE (boosted odds show in the Index)`, Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 50), StrokeThickness = 1.2, Parent = luck })
	local luckButton = Theme.Button({ Text = `R$ {Config.LuckEvent.SuggestedPrice}`, Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 48), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = luck })
	luckButton.Activated:Connect(function()
		State.Action("BuyLuck")
	end)

	if Config.MoneyPassStacking == "Additive" then
		local note = card(page, 100, Theme.Colors.Blue)
		Theme.Label({ Text = "💡 Money passes stack! Own 2x + 3x = 4x money.", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10), StrokeThickness = 1.5, Parent = note })
	end
end

--------------------------------------------------------------------------------
-- Crates
--------------------------------------------------------------------------------
local KIND_ICON = { Coins = "💰", SpeedBoost = "⚡", Luck = "🍀", Egg = "🥚", Pet = "🐾" }

local function percent(chance: number): string
	local p = chance * 100
	return if p >= 10 then string.format("%.1f%%", p) elseif p >= 1 then string.format("%.2f%%", p) else string.format("%.3f%%", p)
end

-- What an outcome gives, in words (coins are estimated for you right now).
local function outcomeText(outcome: Crates.Outcome): string
	local reward = outcome.Reward
	if reward.Kind == "Coins" then
		local amount = Economy.CrateCoins(reward.Seconds or 60, State.Number("Speed"), State.Number("Rebirths"))
		return `Coins (~{Format.Money(amount)} for you now)`
	elseif reward.Kind == "SpeedBoost" then
		return `Speed Boost: run {math.floor((Config.Crates.SpeedBoostMultiplier - 1) * 100 + 0.5)}% faster for {Format.Duration(reward.Seconds or 600)}`
	elseif reward.Kind == "Luck" then
		return `Luck Event for the whole server ({Format.Duration(reward.Seconds or 600)})`
	elseif outcome.Egg then
		local egg = Pets.EggById[outcome.Egg]
		return if egg then egg.Name .. (if egg.CrateOnly then " (exclusive)" else "") else outcome.Egg
	elseif outcome.Pet then
		local pet = Pets.ById[outcome.Pet]
		return if pet then `{pet.Name} ({pet.Rarity} pet, exclusive)` else outcome.Pet
	end
	return reward.Kind
end

local function buildCrates(page: ScrollingFrame, body: Instance)
	-- "All odds" panel (on top of the shop): every outcome, and the pets inside every egg
	local details = Theme.new("Frame", {
		Name = "CrateOdds",
		BackgroundColor3 = Theme.Colors.Panel,
		Size = UDim2.new(1, 0, 1, -54),
		Position = UDim2.fromOffset(0, 54),
		Visible = false,
		ZIndex = 20,
		Parent = body,
	}, { Theme.Corner(14), Theme.Stroke(3) })
	local detailsTitle = Theme.Label({ Text = "", Size = UDim2.new(1, -130, 0, 36), Position = UDim2.fromOffset(12, 8), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21, Parent = details })
	local close = Theme.Button({ Text = "BACK", Color = Theme.Colors.Red, Size = UDim2.fromOffset(100, 38), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Parent = details })
	close.ZIndex = 21
	close.Activated:Connect(function()
		details.Visible = false
	end)
	local detailsText = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 52),
		Size = UDim2.new(1, -24, 1, -62),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		ZIndex = 21,
		Parent = details,
	})
	local detailsLabel = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextScaled = false, TextSize = 20, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -12, 0, 0), StrokeThickness = 1.2, ZIndex = 21, Parent = detailsText })

	local function showOdds(crate: Crates.Crate)
		detailsTitle.Text = `🎁 {string.upper(crate.Name)} - ALL ODDS`
		local lines = { "You get ONE of these (adds up to 100%). Luck and passes never change these odds.", "" }
		for _, outcome in Crates.Odds(crate) do
			table.insert(lines, `<b>{KIND_ICON[outcome.Reward.Kind] or "🎁"} {outcomeText(outcome)}: {percent(outcome.Chance)}</b>`)
			local egg = if outcome.Egg then Pets.EggById[outcome.Egg] else nil
			if egg then
				table.insert(lines, `      it hatches (after {Format.Duration(egg.HatchSeconds)}) into:`)
				for _, entry in egg.Pool do
					local pet = Pets.ById[entry.Pet]
					local inEgg = Pets.Chance(egg, entry.Pet)
					table.insert(lines, `      • {pet.Name} ({pet.Rarity}, {Pets.BonusText(pet)}): {percent(inEgg)} of the egg = {percent(outcome.Chance * inEgg)} of the crate`)
				end
			end
		end
		detailsLabel.Text = table.concat(lines, "\n")
		details.Visible = true
	end

	local spinning: { Camera } = {}
	for _, crate in Crates.List do
		local product = Config.Crates.Products[crate.Id]
		fetchPrice(product.DeveloperProductId, Enum.InfoType.Product)
		local c = card(page, crate.Order, crate.Color)
		local viewport = Theme.new("ViewportFrame", {
			BackgroundColor3 = Color3.fromRGB(25, 25, 40),
			Size = UDim2.fromOffset(84, 84),
			Position = UDim2.fromOffset(8, 8),
			Ambient = Color3.fromRGB(180, 180, 180),
			LightColor = Color3.fromRGB(255, 255, 255),
			LightDirection = Vector3.new(-0.5, -1, 0.8),
			Parent = c,
		}, { Theme.Corner(10) })
		local model = CrateModel.Build(crate.Id, { NoEffects = true })
		model:PivotTo(CFrame.new(0, -0.3, 0))
		model.Parent = viewport
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		table.insert(spinning, camera)
		Theme.Label({ Text = string.upper(crate.Name), TextColor3 = crate.Color:Lerp(Color3.new(1, 1, 1), 0.35), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -110, 0, 32), Position = UDim2.fromOffset(100, 10), Parent = c })
		Theme.Label({ Text = "Opens right away: ONE of these", Font = Theme.Font, TextColor3 = Color3.fromRGB(200, 200, 210), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -110, 0, 20), Position = UDim2.fromOffset(100, 44), StrokeThickness = 1, Parent = c })
		local odds = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, -20, 0, 118), Position = UDim2.fromOffset(10, 98), StrokeThickness = 1.2, Parent = c })
		local all = Theme.Button({ Text = "📋 All odds", Color = Theme.Colors.Blue, Size = UDim2.new(0.38, -12, 0, 46), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -10), Parent = c })
		all.Activated:Connect(function()
			showOdds(crate)
		end)
		local buy = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(0.62, -12, 0, 46), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -10), Parent = c })
		buy.Activated:Connect(function()
			-- The server double-checks and explains if crates can't be bought here
			State.Action("BuyCrate", crate.Id)
		end)
		table.insert(refreshers, function()
			local lines = {}
			for _, outcome in Crates.Odds(crate) do
				table.insert(lines, `{KIND_ICON[outcome.Reward.Kind] or "🎁"} {outcomeText(outcome)} <b>{percent(outcome.Chance)}</b>`)
			end
			odds.Text = table.concat(lines, "\n")
			if State.Get("CratesBlocked") == true then
				Theme.SetButtonText(buy, "Not available in your region")
				Theme.SetButtonColor(buy, Theme.Colors.Gray)
			else
				Theme.SetButtonText(buy, robuxText(product.DeveloperProductId, product.Price))
				Theme.SetButtonColor(buy, Theme.Colors.Green)
			end
		end)
	end
	local note = card(page, 10, Theme.Colors.Orange)
	Theme.Label({ Text = "🎁 Crates also show up for free in the lane now and then - hold E to open one! Eggs go straight into your incubator.", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10), StrokeThickness = 1.5, Parent = note })
	RunService.RenderStepped:Connect(function()
		if not page.Visible then
			return
		end
		local angle = os.clock() * 0.8
		for _, camera in spinning do
			camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(angle) * 11, 4, -math.cos(angle) * 11), Vector3.new(0, 0.2, 0))
		end
	end)
	State.OnAttribute("CratesBlocked", refreshAll)
end

--------------------------------------------------------------------------------
-- Skins
--------------------------------------------------------------------------------
local function buildSkins(page: ScrollingFrame)
	local note = card(page, 0, Theme.Colors.Purple)
	Theme.Label({ Text = "🎨 Skins are bought with SPEED ⚡ (you'll be slower until you train it back). They're yours forever, even after rebirths!", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10), StrokeThickness = 1.5, Parent = note })
	for order, skin in Config.Skins do
		local c = card(page, order, skin.Trim)
		-- Colour swatch preview of the skin
		local swatch = Theme.new("Frame", { Size = UDim2.new(1, -20, 0, 64), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = skin.Floor, Parent = c }, { Theme.Corner(10), Theme.Stroke(2) })
		for i, color in { skin.FloorAlt, skin.Fence, skin.Trim, skin.Pedestal } do
			Theme.new("Frame", { Size = UDim2.new(0.2, -4, 1, -16), Position = UDim2.new(0.04 + (i - 1) * 0.24, 0, 0, 8), BackgroundColor3 = color, Parent = swatch }, { Theme.Corner(8), Theme.Stroke(1.5) })
		end
		Theme.Label({ Text = string.upper(skin.Name), Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 80), Parent = c })
		local button = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 46), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = c })
		button.Activated:Connect(function()
			if State.Data.OwnedSkins[skin.Id] or skin.SpeedCost <= 0 then
				State.Action("EquipSkin", skin.Id)
			else
				State.Action("BuySkin", skin.Id)
			end
		end)
		table.insert(refreshers, function()
			local owned = skin.SpeedCost <= 0 or State.Data.OwnedSkins[skin.Id]
			if State.Data.EquippedSkin == skin.Id then
				Theme.SetButtonText(button, "EQUIPPED")
				Theme.SetButtonColor(button, Theme.Colors.Gray)
			elseif owned then
				Theme.SetButtonText(button, "EQUIP")
				Theme.SetButtonColor(button, Theme.Colors.Blue)
			else
				Theme.SetButtonText(button, "⚡ " .. Format.Number(skin.SpeedCost))
				Theme.SetButtonColor(button, if State.Number("Speed") >= skin.SpeedCost then Theme.Colors.Purple else Theme.Colors.Gray)
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Items (weapons, traps, base lock)
--------------------------------------------------------------------------------
local KIND_LABEL = { Weapon = "⚔️ WEAPON", Trap = "🪤 TRAP", Lock = "🛡 DEFENSE" }

function buildItems(page: ScrollingFrame)
	local spinning: { { Camera: Camera, Radius: number, Height: number } } = {}
	for order, item in Config.Items do
		local c = card(page, order, item.Color)
		-- A 3D preview of the real model, slowly turning
		local viewport = Theme.new("ViewportFrame", {
			BackgroundColor3 = Color3.fromRGB(25, 25, 40),
			Size = UDim2.fromOffset(60, 60),
			Position = UDim2.fromOffset(8, 6),
			Ambient = Color3.fromRGB(170, 170, 170),
			LightColor = Color3.fromRGB(255, 255, 255),
			LightDirection = Vector3.new(-0.5, -1, 0.8),
			Parent = c,
		}, { Theme.Corner(10) })
		local model = ItemModel.BuildPreview(item)
		-- The item's +Z is "up the item": stand it upright, then centre it on the origin
		local upright = CFrame.Angles(math.rad(-90), 0, 0)
		model:PivotTo(upright)
		local box, size = model:GetBoundingBox()
		model:PivotTo(CFrame.new(-box.Position) * upright)
		model.Parent = viewport
		local radius = math.max(size.X, size.Y, size.Z) * 1.25 + 1
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, -radius), Vector3.zero)
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		table.insert(spinning, { Camera = camera, Radius = radius, Height = 0 })
		Theme.Label({ Text = string.upper(item.Name), TextColor3 = item.Color:Lerp(Color3.new(1, 1, 1), 0.3), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 30), Position = UDim2.fromOffset(74, 8), Parent = c })
		Theme.Label({ Text = KIND_LABEL[item.Kind] or item.Kind, Font = Theme.Font, TextColor3 = Color3.fromRGB(200, 200, 210), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 18), Position = UDim2.fromOffset(74, 38), StrokeThickness = 1, Parent = c })
		Theme.Label({ Text = item.Description, Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 68), StrokeThickness = 1.2, Parent = c })
		local button = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 48), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = c })
		-- Owned items: the button takes the item off your hotbar / puts it back (you keep owning it).
		button.Activated:Connect(function()
			local owned = item.Starter or (State.Data.Items and State.Data.Items[item.Id])
			if owned then
				State.Action("ToggleHotbar", item.Id)
			else
				State.Action("BuyItem", item.Id)
			end
		end)
		table.insert(refreshers, function()
			local owned = item.Starter or (State.Data.Items and State.Data.Items[item.Id])
			local hidden = State.Data.HiddenItems and State.Data.HiddenItems[item.Id]
			if owned and hidden then
				Theme.SetButtonText(button, "➕ Put back on hotbar")
				Theme.SetButtonColor(button, Theme.Colors.Blue)
			elseif owned then
				Theme.SetButtonText(button, "✓ In hotbar  •  tap to remove")
				Theme.SetButtonColor(button, Theme.Colors.Gray)
			else
				Theme.SetButtonText(button, "Buy " .. Format.Money(item.Cost))
				Theme.SetButtonColor(button, if State.Number("Money") >= item.Cost then Theme.Colors.Green else Theme.Colors.Gray)
			end
		end)
	end
	RunService.RenderStepped:Connect(function()
		if not page.Visible then
			return
		end
		local angle = os.clock() * 0.8
		for _, entry in spinning do
			entry.Camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(angle) * entry.Radius, entry.Height, -math.cos(angle) * entry.Radius), Vector3.zero)
		end
	end)
end

function Shop.Open(tab: string?)
	modal:Open()
	selectTab(tab or "Upgrades")
end

function Shop.Init()
	modal = Modal.new("🛒 SHOP", Theme.Colors.Green, Vector2.new(740, 490))
	local body = modal.Body
	selectTab = Modal.Tabs(body, {
		{ Name = "Upgrades", Text = "⚡ Upgrades", Color = Theme.Colors.Purple },
		{ Name = "Passes", Text = "🚀 Boosts", Color = Theme.Colors.Orange },
		{ Name = "Crates", Text = "🎁 Crates", Color = Theme.Colors.Yellow },
		{ Name = "Items", Text = "⚔️ Items", Color = Theme.Colors.Red },
		{ Name = "Skins", Text = "🎨 Skins", Color = Theme.Colors.Pink },
	}, function(name)
		for pageName, page in pages do
			page.Visible = pageName == name
		end
		refreshAll()
	end)
	buildUpgrades(newPage("Upgrades", body, 2, 190))
	buildPasses(newPage("Passes", body, 2, 160))
	buildCrates(newPage("Crates", body, 2, 290), body)
	buildItems(newPage("Items", body, 2, 175))
	buildSkins(newPage("Skins", body, 3, 180))

	for _, name in { "Money", "Speed", "SpeedMultLevel", "TreadmillLevel", "SpeedPassMultiplier", "Income", "Rebirths", "Expansions", "Floors", "IndexBonus", "IncubatorSpeed", "IncubatorSize" } do
		State.OnAttribute(name, function()
			if modal:IsOpen() then
				refreshAll()
			end
		end)
	end
	State.Changed:Connect(refreshAll)

	-- Shop stalls in the hub: walk onto a glowing circle (or press E at the counter) to open that
	-- stall's tab. Walking off closes it again.
	task.spawn(function()
		local hub = workspace:WaitForChild("Map"):WaitForChild("Hub")
		local player = Players.LocalPlayer :: Player
		local stalls: { { Glow: BasePart, Tab: string, Inside: boolean } } = {}
		local autoOpened = false
		local function addStall(stall: Instance)
			local tab = stall:GetAttribute("ShopTab")
			if type(tab) ~= "string" then
				return
			end
			local glow = stall:WaitForChild("Glow") :: BasePart
			local promptPart = stall:WaitForChild("PromptPart")
			table.insert(stalls, { Glow = glow, Tab = tab, Inside = false })
			local proximity = Theme.new("ProximityPrompt", {
				ActionText = "Open",
				ObjectText = stall.Name,
				HoldDuration = 0,
				MaxActivationDistance = 12,
				RequiresLineOfSight = false,
				Parent = promptPart,
			})
			proximity.Triggered:Connect(function()
				Shop.Open(tab)
			end)
		end
		for _, child in hub:GetChildren() do
			task.spawn(addStall, child)
		end
		while true do
			task.wait(0.15)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			for _, stall in stalls do
				local inside = false
				if root then
					local offset = root.Position - stall.Glow.Position
					inside = Vector2.new(offset.X, offset.Z).Magnitude < stall.Glow.Size.Y / 2 and math.abs(offset.Y) < 8
				end
				if inside and not stall.Inside then
					Shop.Open(stall.Tab)
					autoOpened = true
				elseif not inside and stall.Inside and autoOpened then
					modal:Close()
					autoOpened = false
				end
				stall.Inside = inside
			end
		end
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme: colours, fonts and small UI building helpers (chunky outlined "simulator" style).
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")

local Theme = {}

local rgb = Color3.fromRGB

Theme.Font = Enum.Font.FredokaOne
Theme.Title = Enum.Font.LuckiestGuy

Theme.Colors = {
	Green = rgb(80, 215, 50),
	Blue = rgb(30, 160, 255),
	Orange = rgb(255, 140, 30),
	Red = rgb(235, 55, 55),
	Purple = rgb(150, 70, 255),
	Yellow = rgb(255, 210, 40),
	Pink = rgb(255, 110, 190),
	Gray = rgb(120, 120, 130),
	Money = rgb(90, 255, 70),
	Speed = rgb(120, 60, 255),
	Panel = rgb(35, 35, 55),
	PanelLight = rgb(55, 55, 80),
	Outline = rgb(15, 15, 25),
	White = rgb(255, 255, 255),
}

Theme.IsTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Sound effects: quiet and soft by default. Id = any sound (paste "rbxassetid://123" from the
-- Creator Store to use your own), Volume 0-1, Pitch 1 = normal (lower = deeper/softer).
-- Set Id = "" to turn a sound off.
-- Notes = { pitch, ... } plays the sound once per note, one after the other (a little jingle).
local PING = "rbxasset://sounds/electronicpingshort.wav"
local WHOOSH = "rbxasset://sounds/Rocket whoosh 01.wav"
local THUD = "rbxasset://sounds/action_jump_land.mp3"
export type SoundDef = { Id: string, Volume: number, Pitch: number, Notes: { number }?, Gap: number? }
Theme.Sounds = {
	Click = { Id = "rbxasset://sounds/button.wav", Volume = 0.12, Pitch = 1.15 },
	-- Stealing: a quick "swipe", a rising "got it!" jingle, then the chase starts
	Grab = { Id = WHOOSH, Volume = 0.35, Pitch = 1.8 },
	Steal = { Id = PING, Volume = 0.2, Pitch = 1, Notes = { 1, 1.26, 1.5 }, Gap = 0.07 },
	Hatch = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.3, Pitch = 1.6 },
	Crack = { Id = THUD, Volume = 0.4, Pitch = 1.8 },
	-- Home safe: a bright "cha-ching" arpeggio
	Deposit = { Id = PING, Volume = 0.24, Pitch = 1, Notes = { 1, 1.26, 1.5, 2 }, Gap = 0.08 },
	Collect = { Id = PING, Volume = 0.2, Pitch = 1 },
	Announce = { Id = PING, Volume = 0.12, Pitch = 0.7 },
	-- Caught: a big BONK and a whoosh as you go flying
	Caught = { Id = THUD, Volume = 0.8, Pitch = 0.55 },
	Fling = { Id = WHOOSH, Volume = 0.5, Pitch = 0.8 },
	Error = { Id = "", Volume = 0, Pitch = 1 },
} :: { [string]: SoundDef }

local function playOnce(id: string, volume: number, pitch: number)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.PlaybackSpeed = pitch
	SoundService:PlayLocalSound(sound)
	task.delay(3, function()
		sound:Destroy()
	end)
end

function Theme.PlaySound(name: string, _volume: number?)
	local def = Theme.Sounds[name]
	if not def or def.Id == "" then
		return
	end
	local notes = def.Notes
	if notes then
		task.spawn(function()
			for i, note in notes do
				playOnce(def.Id, def.Volume, def.Pitch * note)
				if i < #notes then
					task.wait(def.Gap or 0.08)
				end
			end
		end)
	else
		playOnce(def.Id, def.Volume, def.Pitch)
	end
end

-- Instance.new with a property table and optional children.
function Theme.new(className: string, props: { [string]: any }?, children: { any }?): any
	local instance = Instance.new(className :: any)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.Corner(radius: number?): any
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Theme.Stroke(thickness: number?, color: Color3?, mode: Enum.ApplyStrokeMode?): any
	return Theme.new("UIStroke", {
		Thickness = thickness or 3,
		Color = color or Theme.Colors.Outline,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
	})
end

function Theme.Gradient(top: Color3, bottom: Color3): any
	return Theme.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = 90 })
end

function Theme.Padding(px: number): any
	local u = UDim.new(0, px)
	return Theme.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

-- Outlined text label (thick black stroke like the reference UI).
function Theme.Label(props: { [string]: any }): TextLabel
	local label = Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Title,
		TextColor3 = Theme.Colors.White,
		TextScaled = true,
		Text = "",
	})
	for key, value in props do
		if key ~= "Parent" and key ~= "StrokeThickness" and key ~= "StrokeColor" then
			(label :: any)[key] = value
		end
	end
	Theme.new("UIStroke", {
		Thickness = props.StrokeThickness or 2.5,
		Color = props.StrokeColor or Theme.Colors.Outline,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = label,
	})
	label.Parent = props.Parent
	return label
end

local function lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

local function darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end
Theme.Lighten = lighten
Theme.Darken = darken

-- Pop animation on press.
function Theme.Bounce(button: GuiObject)
	local scale = button:FindFirstChild("BounceScale") :: UIScale?
	if not scale then
		scale = Theme.new("UIScale", { Name = "BounceScale", Parent = button })
	end
	local s = scale :: UIScale
	s.Scale = 0.9
	TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Big chunky button: coloured gradient, dark outline, outlined text, optional emoji icon.
function Theme.Button(props: {
	Text: string,
	Color: Color3,
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Icon: string?,
	Parent: Instance?,
	LayoutOrder: number?,
	Name: string?,
	TextSize: number?,
}): TextButton
	local button = Theme.new("TextButton", {
		Name = props.Name or "Button",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
	}, {
		Theme.Corner(9),
		Theme.Stroke(3.5),
		Theme.Gradient(lighten(props.Color, 0.3), darken(props.Color, 0.12)),
	})
	button:SetAttribute("BaseColor", props.Color)
	local textX = 0
	if props.Icon then
		Theme.Label({
			Name = "Icon",
			Text = props.Icon,
			Font = Enum.Font.GothamBold,
			Size = UDim2.fromScale(0.8, 0.8), -- square: both relative to the button height
			SizeConstraint = Enum.SizeConstraint.RelativeYY,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 6, 0.5, 0),
			Parent = button,
		})
		textX = 0.3
	end
	Theme.Label({
		Name = "Text",
		Text = props.Text,
		Size = UDim2.new(1 - textX, -10, 0.7, 0),
		Position = UDim2.new(textX, if props.Icon then 0 else 5, 0.15, 0),
		Parent = button,
	})
	button.MouseButton1Down:Connect(function()
		Theme.Bounce(button)
		Theme.PlaySound("Click")
	end)
	button.Parent = props.Parent
	return button
end

-- Recolour a Theme.Button (e.g. grey when you can't afford something).
function Theme.SetButtonColor(button: TextButton, color: Color3)
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = ColorSequence.new(lighten(color, 0.25), darken(color, 0.1))
	end
end

function Theme.SetButtonText(button: TextButton, text: string)
	local label = button:FindFirstChild("Text") :: TextLabel?
	if label then
		label.Text = text
	end
end

-- Keeps a UIScale in sync with the screen size (UI is designed for 1280x720, then drawn at
-- Theme.UIScale of that so it stays out of the way of the game).
Theme.UIScale = 0.82
local scales: { UIScale } = {}
local function currentScale(): number
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	return math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1.2) * Theme.UIScale
end

function Theme.CurrentScale(): number
	return currentScale()
end

function Theme.AutoScale(target: GuiObject): UIScale
	local scale = Theme.new("UIScale", { Name = "AutoScale", Scale = currentScale(), Parent = target })
	table.insert(scales, scale)
	return scale
end

local function hookCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			local value = currentScale()
			for _, scale in scales do
				scale.Scale = value
			end
		end)
	end
end
hookCamera()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)

function Theme.PlayerGui(): PlayerGui
	return (Players.LocalPlayer :: Player):WaitForChild("PlayerGui") :: PlayerGui
end

function Theme.ScreenGui(name: string, displayOrder: number?): ScreenGui
	return Theme.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		IgnoreGuiInset = false,
		Parent = Theme.PlayerGui(),
	})
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--[[
	Tutorial: a guided first game. A small line of text at the top of the screen says what to do
	next, with a Skip Tutorial button beside it, and a red arrow floating over your head points the
	way (a second red arrow bobs over the target):
	  1. follow the arrow to the donut lane
	  2. steal a donut (walk up to one and press E)
	  3. run back to your base before the guard catches you (caught? steal another one)
	  4. upgrade the donut on your base (press E on it when you have enough money)
	  5. run on your treadmill to get faster
	Then a Claim button gives you a free egg (once ever; the server checks).
	It starts on your first join and keeps coming back until you finish or skip it; Settings >
	How to play starts it again.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Areas = require(Shared.Areas)
local Layout = require(Shared.Layout)
local Remotes = require(Shared.Remotes)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)
local AreaTracker = require(script.Parent.Parent.AreaTracker)
local Bases = require(script.Parent.Parent.Bases)

local Tutorial = {}

local player = Players.LocalPlayer :: Player
local RED = Color3.fromRGB(235, 40, 40)
local STEPS = { "Lane", "Steal", "RunHome", "Upgrade", "Treadmill" }
local TEXT: { [string]: string } = {
	Lane = "Follow the red arrow to the donut lane",
	Steal = "Walk up to a donut and press E to steal it",
	RunHome = `Run back to your base before {Config.Guard.Name} catches you`,
	Caught = `{Config.Guard.Name} caught you! Steal another donut and try again`,
	Upgrade = "Your donut makes money. When you have enough, press E on it to upgrade it",
	Treadmill = "Run on your treadmill to get faster",
	Done = "Tutorial complete! Claim your free egg",
	Claimed = "Tutorial complete!",
}

local step: string? = nil -- nil while the tutorial isn't running
local caught = false
local upgradesAtStart = 0
local speedAtStart = 0
local refresh: () -> ()

local function number(name: string): number
	local value = player:GetAttribute(name)
	return if type(value) == "number" then value else 0
end

local function go(nextStep: string?)
	step = nextStep
	if nextStep == "Upgrade" then
		upgradesAtStart = number("DonutUpgrades")
	elseif nextStep == "Treadmill" then
		speedAtStart = number("Speed")
	end
	refresh()
end

function Tutorial.Start()
	caught = false
	go("Lane")
end
Tutorial.Open = Tutorial.Start -- Settings > How to play

function Tutorial.IsRunning(): boolean
	return step ~= nil
end

--------------------------------------------------------------------------------
-- The red arrows: one over your head pointing the way, one bobbing over the target
--------------------------------------------------------------------------------
type Arrow = { Parts: { BasePart }, Offsets: { CFrame } }

local function newArrow(parent: Instance, scale: number): Arrow
	local arrow: Arrow = { Parts = {}, Offsets = {} }
	local function piece(size: Vector3, offset: CFrame)
		local part = Instance.new("Part")
		part.Name = "TutorialArrow"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = RED
		part.Size = size * scale
		part.Parent = parent
		table.insert(arrow.Parts, part)
		table.insert(arrow.Offsets, CFrame.new(offset.Position * scale) * offset.Rotation)
	end
	-- points along -Z: a shaft and a chevron at the tip
	piece(Vector3.new(0.7, 0.7, 5), CFrame.new(0, 0, 0.5))
	for _, side in { -1, 1 } do
		piece(Vector3.new(0.7, 0.7, 2.8), CFrame.new(side * 0.9, 0, -2.13) * CFrame.Angles(0, side * math.rad(40), 0))
	end
	return arrow
end

local function place(arrow: Arrow, cf: CFrame?)
	for i, part in arrow.Parts do
		if cf then
			part.CFrame = cf * arrow.Offsets[i]
			part.Transparency = 0
		else
			part.Transparency = 1
		end
	end
end

-- Where the arrows should point for the current step.
local nearestDonut: Vector3? = nil
local lastScan = 0
local function laneStart(): Vector3
	local world = math.max(1, State.Number("World"))
	local first = Areas.ByWorld[world] and Areas.ByWorld[world][1]
	local z = if first then Layout.AreaStart(first.Id) + 15 else 0
	return Vector3.new(Layout.WorldOffset(world), 0, z)
end

local function findDonut(from: Vector3): Vector3?
	local area = AreaTracker.Current
	local map = workspace:FindFirstChild("Map")
	local lane = map and map:FindFirstChild("Lane")
	local folder = lane and lane:FindFirstChild("Area" .. area)
	if area <= 0 or not folder then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for _, prompt in folder:GetDescendants() do
		if prompt:IsA("ProximityPrompt") and prompt.Name == "StealPrompt" and prompt.Enabled then
			local holder = prompt.Parent
			if holder and holder:IsA("BasePart") then
				local distance = (holder.Position - from).Magnitude
				if distance < bestDistance then
					best, bestDistance = holder.Position, distance
				end
			end
		end
	end
	return best
end

local function target(from: Vector3): Vector3?
	local plot = Bases.Mine()
	if step == "Lane" then
		return laneStart()
	elseif step == "Steal" then
		local now = os.clock()
		if now - lastScan > 0.75 then
			lastScan = now
			nearestDonut = findDonut(from)
		end
		return nearestDonut or laneStart()
	elseif step == "RunHome" then
		return if plot then plot:GetPivot().Position else nil
	elseif step == "Upgrade" and plot then
		for _, child in plot:GetChildren() do
			if child:IsA("Model") and string.sub(child.Name, 1, 9) == "SlotDonut" then
				return child:GetPivot().Position
			end
		end
		return plot:GetPivot().Position
	elseif step == "Treadmill" and plot then
		local treadmill = plot:FindFirstChild("Treadmill")
		local belt = treadmill and treadmill:FindFirstChild("Belt")
		return if belt and belt:IsA("BasePart") then belt.Position else plot:GetPivot().Position
	end
	return nil
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------
function Tutorial.Init()
	-- The line of text at the top, with Skip / Claim beside it
	local gui = Theme.ScreenGui("Tutorial", 6)
	local strip = Theme.new("Frame", {
		Name = "Strip",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 48),
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0.45,
		Visible = false,
		Parent = gui,
	}, {
		Theme.Corner(10),
		Theme.Stroke(2),
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 6) }),
	})
	Theme.AutoScale(strip)
	local counter = Theme.Label({ Name = "Counter", Text = "", Font = Theme.Font, TextScaled = false, TextSize = 16, TextColor3 = Color3.fromRGB(255, 120, 120), AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), StrokeThickness = 1.5, LayoutOrder = 1, Parent = strip })
	local label = Theme.Label({ Name = "Text", Text = "", Font = Theme.Font, TextScaled = false, TextSize = 18, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), StrokeThickness = 1.5, LayoutOrder = 2, Parent = strip })
	local skip = Theme.Button({ Text = "Skip Tutorial", Color = Theme.Colors.Gray, Size = UDim2.fromOffset(130, 30), Parent = strip })
	skip.Name = "Skip"
	skip.LayoutOrder = 3
	local claim = Theme.Button({ Text = "Claim", Color = Theme.Colors.Green, Size = UDim2.fromOffset(110, 30), Parent = strip })
	claim.Name = "Claim"
	claim.LayoutOrder = 4
	local close = Theme.Button({ Text = "Close", Color = Theme.Colors.Gray, Size = UDim2.fromOffset(90, 30), Parent = strip })
	close.Name = "Close"
	close.LayoutOrder = 5

	local arrows = Instance.new("Folder")
	arrows.Name = "TutorialArrows"
	arrows.Parent = workspace
	local guide = newArrow(arrows, 1)
	local marker = newArrow(arrows, 1.4)
	place(guide, nil)
	place(marker, nil)

	refresh = function()
		strip.Visible = step ~= nil
		if not step then
			return
		end
		local index = table.find(STEPS, step)
		counter.Text = if index then `{index}/{#STEPS}` else ""
		counter.Visible = index ~= nil
		local claimed = State.Data.TutorialEggClaimed == true
		if step == "Done" then
			label.Text = if claimed then TEXT.Claimed else TEXT.Done
		else
			label.Text = if step == "Steal" and caught then TEXT.Caught else TEXT[step]
		end
		skip.Visible = step ~= "Done"
		claim.Visible = step == "Done" and not claimed
		close.Visible = step == "Done" and claimed
	end

	skip.Activated:Connect(function()
		State.Action("SeenTutorial")
		go(nil)
	end)
	claim.Activated:Connect(function()
		State.Action("ClaimTutorialEgg")
		label.Text = TEXT.Claimed
		claim.Visible = false
		task.delay(2.5, function()
			if step == "Done" then
				go(nil)
			end
		end)
	end)
	close.Activated:Connect(function()
		State.Action("SeenTutorial")
		go(nil)
	end)

	-- Stealing, getting caught and bringing donuts home
	Remotes.Event("ChaseEnded").OnClientEvent:Connect(function(info: any)
		if type(info) ~= "table" or info.Kind == "Egg" then
			return
		end
		if step == "RunHome" or step == "Steal" then
			if info.Result == "Deposited" then
				go("Upgrade")
			elseif info.Result == "Caught" or info.Result == "Lost" then
				caught = true
				go("Steal")
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		if not step then
			place(guide, nil)
			place(marker, nil)
			return
		end
		-- move on when the step is done
		if step == "Lane" and AreaTracker.Current > 0 then
			go("Steal")
		elseif step == "Steal" and player:GetAttribute("CarryingDonut") then
			caught = false
			go("RunHome")
		elseif step == "Upgrade" and number("DonutUpgrades") > upgradesAtStart then
			go("Treadmill")
		elseif step == "Treadmill" and number("Speed") >= speedAtStart + 3 then
			go("Done")
		end
		-- point the way
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local goal = if root and step ~= "Done" then target(root.Position) else nil
		if not root or not goal then
			place(guide, nil)
			place(marker, nil)
			return
		end
		local t = os.clock()
		local bob = math.sin(t * 3) * 0.4
		local here = root.Position + Vector3.new(0, 6.5 + bob, 0)
		local flat = Vector3.new(goal.X - here.X, 0, goal.Z - here.Z)
		if flat.Magnitude > 4 then
			local ahead = flat.Unit
			local right = Vector3.yAxis:Cross(-ahead)
			place(guide, CFrame.fromMatrix(here, right, Vector3.yAxis, -ahead))
		else
			place(guide, nil)
		end
		-- pointing straight down over the target, turning slowly
		local over = goal + Vector3.new(0, 10 + math.sin(t * 2.5) * 1.2, 0)
		place(marker, CFrame.fromMatrix(over, Vector3.xAxis, Vector3.new(0, 0, -1), Vector3.yAxis) * CFrame.Angles(0, 0, t * 1.5))
	end)

	-- First join: start it (it keeps coming back until finished or skipped)
	local checked = false
	State.Changed:Connect(function(snapshot)
		if not checked then
			checked = true
			if snapshot.SeenTutorial == false then
				Tutorial.Start()
			end
		elseif step == "Done" then
			refresh() -- the claim went through
		end
	end)
	refresh()
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">UltimateRebirth</string>
              <string name="Source"><![CDATA[--[[
	UltimateRebirth: the big red button in The Black Hole's secret lab.
	  * UltimateAsk      -> "are you sure?" (what resets, what you keep)
	  * UltimateRebirth  -> the screen flashes white, an explosion goes off and "WORLD 2" appears
	                        while the server moves you there
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local UltimateRebirth = {}

local function explode()
	-- Roblox's own explosion (sound + blast), in front of the camera, harmless (made on this client)
	local camera = workspace.CurrentCamera
	if camera then
		local blast = Instance.new("Explosion")
		blast.Position = camera.CFrame.Position + camera.CFrame.LookVector * 25
		blast.BlastPressure = 0
		blast.BlastRadius = 0
		blast.DestroyJointRadiusPercent = 0
		blast.ExplosionType = Enum.ExplosionType.NoCraters
		blast.Parent = workspace
	end
	local id = Config.UltimateRebirth.ExplosionSoundId
	if id ~= "" then
		local sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Volume = Config.UltimateRebirth.ExplosionVolume
		SoundService:PlayLocalSound(sound)
		task.delay(8, function()
			sound:Destroy()
		end)
	end
end

local function flash(gui: ScreenGui, worldName: string)
	local white = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 50, Parent = gui })
	local title = Theme.Label({
		Text = string.upper(worldName),
		Font = Theme.Title,
		TextColor3 = Color3.fromRGB(70, 90, 255),
		StrokeThickness = 6,
		StrokeColor = Color3.fromRGB(20, 20, 60),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromScale(0.8, 0.22),
		TextTransparency = 1,
		ZIndex = 51,
		Parent = gui,
	})
	local sub = Theme.Label({
		Text = "Rarer donuts. 2x money. A whole new start.",
		Font = Theme.Font,
		TextColor3 = Color3.fromRGB(60, 60, 90),
		StrokeThickness = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.6),
		Size = UDim2.fromScale(0.6, 0.06),
		TextTransparency = 1,
		ZIndex = 51,
		Parent = gui,
	})
	local titleStroke = title:FindFirstChildOfClass("UIStroke")
	if titleStroke then
		titleStroke.Transparency = 1
	end
	explode()
	TweenService:Create(white, TweenInfo.new(0.35), { BackgroundTransparency = 0 }):Play()
	task.wait(0.5)
	local scale = Theme.new("UIScale", { Scale = 0.4, Parent = title })
	TweenService:Create(scale, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(title, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
	TweenService:Create(sub, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
	if titleStroke then
		titleStroke.Transparency = 0
	end
	task.wait(2.4)
	local out = TweenInfo.new(1.1)
	TweenService:Create(white, out, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(title, out, { TextTransparency = 1 }):Play()
	TweenService:Create(sub, out, { TextTransparency = 1 }):Play()
	if titleStroke then
		TweenService:Create(titleStroke, out, { Transparency = 1 }):Play()
	end
	task.wait(1.2)
	white:Destroy()
	title:Destroy()
	sub:Destroy()
end

function UltimateRebirth.Init()
	local gui = Theme.ScreenGui("UltimateRebirth", 100)
	gui.IgnoreGuiInset = true

	local modal = Modal.new("💥 ULTIMATE REBIRTH", Color3.fromRGB(220, 30, 40), Vector2.new(500, 380))
	local body = modal.Body
	Theme.Label({ Text = "Are you SURE?", Font = Theme.Title, TextColor3 = Color3.fromRGB(255, 80, 80), Size = UDim2.new(1, 0, 0, 44), StrokeThickness = 3, Parent = body })
	Theme.Label({
		Text = "Your Money, Speed, Rebirths and the donuts on your base reset.\nYou KEEP your pets, passes, items, base upgrades and Index.\n\nYou'll be sent to WORLD 2: rarer donuts worth 2x money!",
		Font = Theme.Font, TextScaled = false, TextSize = 19, TextWrapped = true,
		Size = UDim2.new(1, -16, 0, 150), Position = UDim2.fromOffset(8, 50), StrokeThickness = 1.5, Parent = body,
	})
	local press = Theme.Button({ Text = "PRESS IT! 💥", Color = Theme.Colors.Red, Size = UDim2.new(0.58, -6, 0, 56), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = body })
	local cancel = Theme.Button({ Text = "Not yet", Color = Theme.Colors.Gray, Size = UDim2.new(0.42, -6, 0, 56), AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Parent = body })
	press.Activated:Connect(function()
		modal:Close()
		State.Action("UltimateRebirth")
	end)
	cancel.Activated:Connect(function()
		modal:Close()
	end)

	Remotes.Event("UltimateAsk").OnClientEvent:Connect(function()
		modal:Open()
	end)
	Remotes.Event("UltimateRebirth").OnClientEvent:Connect(function(worldName: string)
		task.spawn(flash, gui, if type(worldName) == "string" then worldName else "World 2")
	end)
end

return UltimateRebirth
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">UpdateNotes</string>
              <string name="Source"><![CDATA[--[[
	UpdateNotes: the Update Log window (the notes themselves are in Shared/UpdateNotes).

	  * a ribbon tab "Update Log", a "Shown on login / Hidden on login" switch, an "Update N" picker
	    and a round close button along the top
	  * left: the game's logo, the update's name, "Update N Patch Notes", a box listing everything new
	    (✦ between them), then each section: heading, tag and bullet lines
	  * right: groups of new things as cards with spinning 3D models of the real donuts / pets / eggs
	    (built from the game's own models, so there are no images to upload)
	It opens by itself the first time a player joins after a new update (their save remembers the
	last one they saw), unless they set it to "Hidden on login"; Settings > Update Log opens it any
	time. Brand-new players get the tutorial instead.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Notes = require(Shared.UpdateNotes)
local Donuts = require(Shared.Donuts)
local DonutModel = require(Shared.DonutModel)
local Pets = require(Shared.Pets)
local PetModel = require(Shared.PetModel)
local Rarities = require(Shared.Rarities)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local UpdateNotes = {}

local WIDTH, HEIGHT = 900, 540
local SIDEBAR = 256
local rgb = Color3.fromRGB

type Spinner = { Camera: Camera, Distance: number, Height: number, Phase: number }

local modal: Modal.Modal
local show: (version: number) -> ()

function UpdateNotes.Open(version: number?)
	show(version or Notes.Latest)
	modal:Open()
end

local function hex(color: Color3): string
	return string.format("#%02X%02X%02X", math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
end

local function text(props: { [string]: any }): TextLabel
	props.Font = props.Font or Theme.Font
	props.TextScaled = false
	props.TextWrapped = true
	props.AutomaticSize = Enum.AutomaticSize.Y
	return Theme.Label(props)
end

-- What a sidebar card shows: the model, its name and its rarity colour.
local function describe(item: Notes.Item): (Model?, string, string, Color3)
	if item.Kind == "Donut" then
		local donut = Donuts.ById[item.Id]
		if donut then
			local ok, model = pcall(DonutModel.Build, donut, { NoEffects = true })
			return if ok then model else nil, donut.Name, donut.Rarity, Rarities.Get(donut.Rarity).Color
		end
	elseif item.Kind == "Pet" then
		local pet = Pets.ById[item.Id]
		if pet then
			local ok, model = pcall(PetModel.BuildPet, pet, { NoEffects = true })
			return if ok then model else nil, pet.Name, pet.Rarity, Pets.Rarity(pet.Rarity).Color
		end
	elseif item.Kind == "Egg" then
		local egg = Pets.EggById[item.Id]
		if egg then
			local ok, model = pcall(PetModel.BuildEgg, egg, { NoEffects = true })
			return if ok then model else nil, egg.Name, "Egg", egg.Color
		end
	end
	return nil, item.Id, "", Theme.Colors.Gray
end

-- Put a model in a ViewportFrame, centred, and return a spinner for its camera.
local function stage(viewport: ViewportFrame, model: Model, zoom: number): Spinner
	local box, size = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() - box.Position)
	model.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local distance = math.max(size.X, size.Y, size.Z) * zoom
	local spinner = { Camera = camera, Distance = distance, Height = distance * 0.18, Phase = math.random() * 6 }
	camera.CFrame = CFrame.lookAt(Vector3.new(0, spinner.Height, -distance), Vector3.zero)
	return spinner
end

function UpdateNotes.Init()
	modal = Modal.new("UPDATE LOG", Theme.Colors.Orange, Vector2.new(WIDTH, HEIGHT))
	local frame = modal.Frame
	-- Our own top bar instead of the usual window header
	local header = frame:FindFirstChild("Header")
	if header and header:IsA("GuiObject") then
		header.Visible = false
	end
	frame.BackgroundColor3 = rgb(14, 12, 24)
	local panelGradient = frame:FindFirstChildOfClass("UIGradient")
	if panelGradient then
		panelGradient:Destroy()
	end
	modal.Body.Position = UDim2.new()
	modal.Body.Size = UDim2.fromScale(1, 1)
	local body = modal.Body

	-- Left: the patch notes, over a big faded model
	local left = Theme.new("Frame", {
		Name = "Notes",
		Position = UDim2.fromOffset(12, 64),
		Size = UDim2.new(1, -(SIDEBAR + 34), 1, -76),
		ClipsDescendants = true,
		Parent = body,
	}, { Theme.Corner(12), Theme.Stroke(3) })
	local leftGradient = Theme.new("UIGradient", { Rotation = 90, Parent = left })
	local backdrop = Theme.new("ViewportFrame", {
		Name = "Backdrop",
		BackgroundTransparency = 1,
		ImageTransparency = 0.6,
		Ambient = rgb(200, 190, 220),
		LightColor = rgb(255, 255, 255),
		LightDirection = Vector3.new(-0.4, -1, 0.7),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -10),
		Size = UDim2.new(1, 40, 0, 260),
		Parent = left,
	})
	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = left,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 16) }),
	})

	-- Right: the new things, as cards
	local right = Theme.new("Frame", {
		Name = "Sidebar",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 64),
		Size = UDim2.new(0, SIDEBAR, 1, -76),
		BackgroundColor3 = rgb(8, 7, 14),
		Parent = body,
	}, { Theme.Corner(12), Theme.Stroke(3) })
	local cards = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = right,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 12) }),
	})

	-- Top bar: the ribbon tab, the two pickers and the close button
	Theme.new("Frame", { Name = "TopBar", Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = rgb(10, 9, 18), BorderSizePixel = 0, Parent = body }, { Theme.Corner(18) })
	local ribbon = Theme.new("Frame", {
		Name = "Ribbon",
		Position = UDim2.fromOffset(-30, -24),
		Size = UDim2.fromOffset(380, 70),
		ZIndex = 3,
		Parent = body,
	}, { Theme.Corner(12), Theme.Stroke(3.5) })
	local ribbonGradient = Theme.new("UIGradient", { Rotation = 90, Parent = ribbon })
	Theme.Label({ Text = "Update Log", TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(96, 12), Size = UDim2.new(1, -110, 0, 46), StrokeThickness = 3.5, ZIndex = 4, Parent = ribbon })
	local badge = Theme.new("Frame", {
		Name = "Badge",
		Position = UDim2.fromOffset(-44, -34),
		Size = UDim2.fromOffset(96, 96),
		BackgroundColor3 = Theme.Colors.Yellow,
		ZIndex = 5,
		Parent = body,
	}, { Theme.new("UICorner", { CornerRadius = UDim.new(1, 0) }), Theme.Stroke(4), Theme.Gradient(rgb(255, 230, 120), rgb(255, 150, 40)) })
	Theme.Label({ Text = "🍩", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), ZIndex = 6, Parent = badge })

	local close = Theme.Button({ Text = "X", Color = Theme.Colors.Red, Size = UDim2.fromOffset(58, 58), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -8, 0, 8), Parent = body })
	close.ZIndex = 5
	for _, child in close:GetDescendants() do
		if child:IsA("UICorner") then
			child.CornerRadius = UDim.new(1, 0)
		end
	end
	close.Activated:Connect(function()
		modal:Close()
	end)
	local versionButton = Theme.Button({ Text = "", Color = rgb(55, 55, 70), Size = UDim2.fromOffset(170, 42), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -52, 0, 8), Parent = body })
	local loginButton = Theme.Button({ Text = "", Color = rgb(55, 55, 70), Size = UDim2.fromOffset(230, 42), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -232, 0, 8), Parent = body })

	-- "Update N" picker: a little menu of every update
	local menu = Theme.new("Frame", {
		Name = "VersionMenu",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -52, 0, 54),
		Size = UDim2.fromOffset(170, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = rgb(30, 30, 44),
		Visible = false,
		ZIndex = 10,
		Parent = body,
	}, { Theme.Corner(10), Theme.Stroke(2.5), Theme.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }), Theme.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }) })
	for i, update in Notes.List do
		local option = Theme.Button({ Text = `Update {update.Version}`, Color = if i == 1 then Theme.Colors.Orange else rgb(70, 70, 90), Size = UDim2.new(1, 0, 0, 36), Parent = menu })
		option.LayoutOrder = i
		option.ZIndex = 11
		option.Activated:Connect(function()
			menu.Visible = false
			show(update.Version)
		end)
	end
	versionButton.Activated:Connect(function()
		menu.Visible = not menu.Visible
	end)

	-- "Shown on login" switch (saved)
	local function showLogin()
		Theme.SetButtonText(loginButton, if State.Get("NotesOnLogin") == false then "▼ Hidden on login" else "▼ Shown on login")
	end
	loginButton.Activated:Connect(function()
		local on = State.Get("NotesOnLogin") == false
		State.Action("NotesOnLogin", on)
		Theme.SetButtonText(loginButton, if on then "▼ Shown on login" else "▼ Hidden on login")
	end)
	State.Changed:Connect(showLogin)
	showLogin()

	local spinners: { Spinner } = {}
	show = function(version: number)
		local update = Notes.Get(version) or Notes.List[1]
		menu.Visible = false
		table.clear(spinners)
		for _, container in { scroll, cards } do
			for _, child in container:GetChildren() do
				if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
					child:Destroy()
				end
			end
		end
		backdrop:ClearAllChildren()
		Theme.SetButtonText(versionButton, `▼ Update {update.Version}`)
		leftGradient.Color = ColorSequence.new(Theme.Lighten(update.Color, 0.12), Theme.Darken(update.Color, 0.45))
		ribbonGradient.Color = ColorSequence.new(Theme.Lighten(update.Accent, 0.15), Theme.Darken(update.Accent, 0.2))
		local accent = update.Accent

		-- Left column
		local order = 0
		local function add(instance: GuiObject)
			order += 1
			instance.LayoutOrder = order
			instance.Parent = scroll
		end
		local logo = Theme.Label({ Text = "STEAL A DONUT", Size = UDim2.new(1, -30, 0, 70), StrokeThickness = 5 })
		Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(rgb(255, 255, 255), rgb(255, 190, 225)), Parent = logo })
		add(logo)
		add(Theme.Label({ Text = update.Name, TextColor3 = accent, Size = UDim2.new(1, -30, 0, 48), StrokeThickness = 4 }))
		add(Theme.Label({ Text = `Update {update.Version} Patch Notes  •  {update.Date}`, Font = Theme.Font, TextColor3 = rgb(205, 200, 220), Size = UDim2.new(1, -30, 0, 24), StrokeThickness = 2 }))
		-- The box listing everything new
		local titles = {}
		for _, section in update.Sections do
			table.insert(titles, section.Title)
		end
		local box = Theme.new("Frame", {
			Size = UDim2.new(1, -60, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = rgb(0, 0, 0),
			BackgroundTransparency = 0.55,
		}, { Theme.Corner(10), Theme.Stroke(2, Theme.Darken(accent, 0.4)), Theme.Padding(12) })
		text({ Text = table.concat(titles, `  <font color="{hex(accent)}">✦</font>  `), RichText = true, TextSize = 22, LineHeight = 1.1, Size = UDim2.fromScale(1, 0), StrokeThickness = 2, Parent = box })
		add(Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 6) }))
		add(box)
		add(Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 10) }))
		for _, section in update.Sections do
			add(Theme.Label({ Text = section.Title, TextColor3 = accent, Size = UDim2.new(1, -30, 0, 34), StrokeThickness = 3 }))
			add(Theme.Label({ Text = section.Tag, Font = Theme.Font, TextColor3 = rgb(200, 195, 215), Size = UDim2.new(1, -30, 0, 22), StrokeThickness = 2 }))
			for _, line in section.Lines do
				add(text({ Text = "• " .. line, TextSize = 21, Size = UDim2.new(1, -60, 0, 0), StrokeThickness = 2 }))
			end
			add(Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 10) }))
		end

		-- Right column: groups of cards
		local cardOrder = 0
		local firstModel: Model? = nil
		for _, group in update.Sidebar do
			cardOrder += 1
			Theme.Label({ Text = group.Title, TextColor3 = accent, Size = UDim2.new(1, -16, 0, 30), StrokeThickness = 3, LayoutOrder = cardOrder, Parent = cards })
			cardOrder += 1
			local grid = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = cardOrder, Parent = cards }, {
				Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(112, 112), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
			})
			for i, item in group.Items do
				local model, name, rarity, color = describe(item)
				local card = Theme.new("Frame", { LayoutOrder = i, Parent = grid }, {
					Theme.Corner(12),
					Theme.Stroke(3, Theme.Lighten(color, 0.35)),
					Theme.Gradient(Theme.Lighten(color, 0.1), Theme.Darken(color, 0.55)),
				})
				Theme.Label({ Text = string.upper(rarity), TextColor3 = Theme.Lighten(color, 0.5), TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(7, 4), Size = UDim2.new(0.8, 0, 0, 15), StrokeThickness = 1.5, ZIndex = 3, Parent = card })
				Theme.Label({ Text = name, Font = Theme.Font, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, -8, 0, 30), StrokeThickness = 2, ZIndex = 3, Parent = card })
				if model then
					if not firstModel then
						firstModel = model:Clone()
					end
					local viewport = Theme.new("ViewportFrame", {
						BackgroundTransparency = 1,
						Ambient = rgb(190, 185, 205),
						LightColor = rgb(255, 255, 255),
						LightDirection = Vector3.new(-0.5, -1, 0.8),
						Position = UDim2.fromOffset(4, 10),
						Size = UDim2.new(1, -8, 1, -30),
						ZIndex = 2,
						Parent = card,
					})
					table.insert(spinners, stage(viewport, model, 1.6))
				end
			end
		end
		if firstModel then
			table.insert(spinners, stage(backdrop, firstModel, 1.2))
		end
		scroll.CanvasPosition = Vector2.zero
		cards.CanvasPosition = Vector2.zero
	end

	-- The models sway gently while the window is open
	RunService.RenderStepped:Connect(function()
		if not modal:IsOpen() then
			return
		end
		local t = os.clock()
		for _, spinner in spinners do
			local angle = math.sin(t * 0.8 + spinner.Phase) * 0.6
			spinner.Camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(angle) * spinner.Distance, spinner.Height, -math.cos(angle) * spinner.Distance), Vector3.zero)
		end
	end)

	-- Joining after a new update: show it once (brand-new players get the tutorial instead)
	local checked = false
	State.Changed:Connect(function(snapshot)
		if checked then
			return
		end
		checked = true
		if (snapshot.SeenUpdate or 0) >= Notes.Latest then
			return
		end
		State.Action("SeenUpdate", Notes.Latest)
		if snapshot.SeenTutorial ~= false and snapshot.NotesOnLogin ~= false then
			task.delay(1.5, function()
				if not Modal.AnyOpen() then
					UpdateNotes.Open()
				end
			end)
		end
	end)
end

return UpdateNotes
]]></string>
            </Properties>
