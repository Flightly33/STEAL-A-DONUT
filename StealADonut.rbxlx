DonutAuras.ById = {} :: { [string]: Element }
for _, element in DonutAuras.Elements do
	DonutAuras.ById[element.Id] = element
	for _, move in element.Moves do
		assert(Moves[move], "Unknown aura move " .. move .. " in " .. element.Id)
	end
end

-- Per-donut choices: { Primary = element id, Secondary = element id }.
DonutAuras.Overrides = {
	cosmicdonut = { Primary = "Cosmos", Secondary = "Void" }, -- stars and galaxies, with the black hole's pull
} :: { [string]: { Primary: string?, Secondary: string? } }

-- How many effects, and how strong, by rarity order (Common = 1, Epic = 4 ...). Lite: only light
-- effects (LIGHT), kept soft.
local TIERS: { [number]: { Count: number, Intensity: number, Lite: boolean? } } = {
	[1] = { Count = 1, Intensity = 0.35, Lite = true },
	[2] = { Count = 2, Intensity = 0.4, Lite = true },
	[3] = { Count = 2, Intensity = 0.5, Lite = true },
	[4] = { Count = 2, Intensity = 0.6 },
	[5] = { Count = 3, Intensity = 0.85 },
	[6] = { Count = 4, Intensity = 1 },
	[7] = { Count = 5, Intensity = 1.3 },
	[8] = { Count = 5, Intensity = 1.5 },
	[9] = { Count = 6, Intensity = 1.6 },
}

-- Effects any element can borrow when its own are used up (keeps every donut's set different).
local WILD = { "stars", "glitter", "wisps", "mist", "shockwave", "runes", "swirl", "rays", "vortex", "kira", "slashes", "impact" }

-- The light effects a Common, Uncommon or Rare donut can have (just a few particles, nothing the
-- client has to move), and the ones any of them can borrow.
local LIGHT = { kira = true, sakura = true, snow = true, petals = true, feathers = true, bubbles = true, steam = true, confetti = true, embers = true, stars = true, glitter = true, mist = true, streaks = true, slashes = true, zaps = true }
local LIGHT_WILD = { "kira", "stars", "glitter", "sakura", "mist", "snow", "bubbles", "embers", "confetti", "slashes", "zaps" }

local function hashString(text: string): number
	local hash = 23
	for i = 1, #text do
		hash = (hash * 41 + string.byte(text, i)) % 2147483647
	end
	return hash
end

local function wordsOf(donut: Donut): { string }
	local words = {}
	for word in string.gmatch(string.lower(donut.Name .. " " .. donut.Id), "[^%s]+") do
		table.insert(words, word)
	end
	return words
end

local function nameMatches(element: Element, words: { string }): boolean
	for _, key in element.Keys do
		for _, word in words do
			if string.sub(key, -1) == "$" then
				if word == string.sub(key, 1, -2) then
					return true
				end
			elseif string.sub(word, 1, #key) == key then
				return true
			end
		end
	end
	return false
end

local function partMatches(element: Element, parts: { [string]: boolean }): boolean
	for _, name in element.Parts do
		if parts[name] then
			return true
		end
	end
	return false
end

-- The donut's main and second elements.
function DonutAuras.ElementsOf(donut: Donut): (Element, Element?)
	local words = wordsOf(donut)
	local parts = {}
	for _, name in donut.Parts do
		parts[name] = true
	end
	local area = Areas.Get(donut.Area)
	local biome = area and area.Theme or ""
	local found: { Element } = {}
	local function addIf(element: Element)
		if not table.find(found, element) then
			table.insert(found, element)
		end
	end
	for _, element in DonutAuras.Elements do
		if nameMatches(element, words) then
			addIf(element)
		end
	end
	for _, element in DonutAuras.Elements do
		if partMatches(element, parts) then
			addIf(element)
		end
	end
	for _, element in DonutAuras.Elements do
		if table.find(element.Biomes, biome) then
			addIf(element)
		end
	end
	local override = DonutAuras.Overrides[donut.Id]
	if override then
		if override.Secondary then
			table.insert(found, 1, DonutAuras.ById[override.Secondary])
		end
		if override.Primary then
			table.insert(found, 1, DonutAuras.ById[override.Primary])
		end
	end
	local primary = found[1] or DonutAuras.Elements[hashString(donut.Id) % #DonutAuras.Elements + 1]
	local secondary: Element? = nil
	for _, element in found do
		if element ~= primary then
			secondary = element
			break
		end
	end
	return primary, secondary
end

-- Builds a donut's aura. `used` holds the effect sets earlier donuts already have: it keeps
-- trying other picks (its element's second or third best effect first, other effects from its
-- second element, then borrowed ones) until it finds a set no other donut has.
local function build(donut: Donut, used: { [string]: boolean }?): Theme?
	local rarity = Rarities.Get(donut.Rarity)
	local tier = TIERS[math.min(rarity.Order, 9)]
	if not tier then
		return nil
	end
	local look = DonutLooks.For(donut :: any, rarity.Order)
	if not look.Effects then
		return nil
	end
	local primary, secondary = DonutAuras.ElementsOf(donut)
	-- its colours: the element's, the first tinted with the donut's own glaze
	local frosting = donut.Frosting
	local saturated = math.max(frosting.R, frosting.G, frosting.B) - math.min(frosting.R, frosting.G, frosting.B) > 0.25
	local colors = {
		if saturated then primary.Colors[1]:Lerp(frosting, 0.3) else primary.Colors[1],
		primary.Colors[2],
		primary.Colors[3],
	}

	local chosen: { { Move: string, From: Element } } = {}
	local r = Random.new(hashString(donut.Id))
	-- a small donut's light effects: its element's, its second element's, then borrowed ones
	local pool: { { Move: string, From: Element } } = {}
	if tier.Lite then
		local function offer(move: string, from: Element)
			if not LIGHT[move] then
				return
			end
			for _, other in pool do
				if other.Move == move then
					return
				end
			end
			table.insert(pool, { Move = move, From = from })
		end
		for _, move in primary.Moves do
			offer(move, primary)
		end
		if secondary then
			for _, move in secondary.Moves do
				offer(move, secondary)
			end
		end
		for _, move in LIGHT_WILD do
			offer(move, primary)
		end
	end
	for attempt = 0, 60 do
		r = Random.new(hashString(donut.Id) + attempt * 7919)
		chosen = {}
		local function take(move: string, from: Element)
			if #chosen >= tier.Count then
				return
			end
			for _, other in chosen do
				if field(other.Move) == field(move) then
					return
				end
			end
			table.insert(chosen, { Move = move, From = from })
		end
		if tier.Lite then
			-- its first light effect (the next one on each try), then random ones
			local first = pool[1 + attempt % #pool]
			take(first.Move, first.From)
			for _ = 1, 20 do
				if #chosen >= tier.Count then
					break
				end
				local pick = pool[r:NextInteger(1, #pool)]
				take(pick.Move, pick.From)
			end
		else
			-- its main effect: its element's best (then second, third best on later tries)
			take(primary.Moves[1 + (attempt // 4) % math.min(3, #primary.Moves)], primary)
			-- one from its second element
			if secondary then
				take(secondary.Moves[1 + attempt % math.min(3, #secondary.Moves)], secondary)
			end
			-- the rest from its own element, borrowing a few more on later tries
			local rest = table.clone(primary.Moves)
			if attempt >= 8 then
				for _, move in WILD do
					table.insert(rest, move)
				end
			end
			while #chosen < tier.Count and #rest > 0 do
				take(table.remove(rest, r:NextInteger(1, #rest)) :: string, primary)
			end
		end
		if not used then
			break
		end
		local names = {}
		for _, pick in chosen do
			table.insert(names, pick.Move)
		end
		table.sort(names)
		local key = table.concat(names, "+")
		if not used[key] then
			used[key] = true
			break
		end
	end

	local theme: Theme = {
		Id = "Signature",
		Colors = colors,
		Pulse = primary.Pulse,
		Outline = if rarity.Order >= 7 then true else nil,
		Lite = tier.Lite,
	}
	local elements = { primary.Id }
	for _, pick in chosen do
		Moves[pick.Move](theme, tier.Intensity, r, colors)
		if field(pick.Move) == "Drift" then
			-- (drifting particles take the colours of the element that brought them)
			theme.DriftColors = pick.From.Drift or { pick.From.Colors[1], pick.From.Colors[2] }
		end
		if pick.From ~= primary and not table.find(elements, pick.From.Id) then
			table.insert(elements, pick.From.Id)
		end
	end
	theme.Elements = elements
	return theme
end

-- Every donut's aura, worked out once in list order (so each one's set is different from all the
-- donuts before it, the same on the server and every client).
local cache: { [string]: Theme | false }? = nil
local function all(): { [string]: Theme | false }
	local known = cache
	if known then
		return known
	end
	local built: { [string]: Theme | false } = {}
	local used = {}
	for _, donut in Donuts.List do
		built[donut.Id] = build(donut :: any, used) or false
	end
	cache = built
	return built
end

-- The donut's own aura (nil when its look turns effects off).
function DonutAuras.For(donut: Donut): Theme?
	if Donuts.ById[donut.Id] == donut then
		return all()[donut.Id] or nil
	end
	return build(donut, nil) -- (a donut made up on the spot, like the Update Log's emblem)
end

-- Every effect set a donut has: its own aura, then its mutation's.
function DonutAuras.Themes(donut: Donut, mutationId: string?): { Theme }
	local themes = {}
	local own = DonutAuras.For(donut)
	if own then
		table.insert(themes, own)
	end
	local fromMutation = FXThemes.ForMutation(mutationId)
	if fromMutation then
		table.insert(themes, fromMutation)
	end
	return themes
end

return DonutAuras
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DonutExtras</string>
          <string name="Source"><![CDATA[--[[
	DonutExtras
	===========
	The details that make every donut its own character (used by DonutModel):

	  * Theme details: every donut gets a few small touches from the area it lives in. Lava cracks
	    and embers in The Underworld, circuit traces in Cyber City, icicles in Glacier Glaze, star
	    specks in space, slime in the Haunted Donuttery... Cosmic copies (World 2) get star specks
	    on top of their home area's touches.
	  * Signature accessories: the bits that match a donut's NAME, listed in its Parts in
	    Donuts.luau like the classic accessories: "AlarmClock" (Tick Tock Glazock), "Volcano"
	    (Volcanito), "WifiArcs" (Wifinut), "Banhammer", "CrabClaws", "Katanas"...

	Everything is made of plain parts welded to the donut (no meshes or images), using the Kit that
	DonutModel hands over: its builders place parts in the donut's own space (unscaled, -Z = front,
	the ring in the XY plane) and scale them for big donuts.

	Moving bits are marked like DonutModel's: Limb = "Tail" (wags), "Sway" (flags, flames,
	antennae), "Roll" (clock hands, wind-up keys: turns around the front-back axis), "Orbit" (slowly
	circles round the donut's vertical axis), "Wing", "Arm", "Leg", "Tentacle".

	Keep an accessory to about 12 parts: a full base holds 48 donuts.
]]

local DonutExtras = {}

export type Kit = {
	Id: string,
	s: number,
	R: number,
	TOP: number,
	BALL: number,
	FROST_R: number,
	Dough: Color3,
	Frosting: Color3,
	Sprinkles: { Color3 },
	RarityOrder: number,
	Studded: boolean,
	Square: boolean, -- a square brick donut (DonutModel): flat sides, corners cut off
	DoughFront: number, -- where the dough's front is (-Z)
	CornerReach: number, -- square: the cut corners are where |x| + |y| reaches this
	Rng: Random,
	at: (x: number, y: number, z: number) -> CFrame,
	ball: (diameter: number, color: Color3, cf: CFrame, material: Enum.Material?, name: string?) -> BasePart,
	ellipsoid: (size: Vector3, color: Color3, cf: CFrame, material: Enum.Material?, name: string?) -> BasePart,
	block: (size: Vector3, color: Color3, cf: CFrame, material: Enum.Material?, name: string?) -> BasePart,
	cylinder: (height: number, diameter: number, color: Color3, cf: CFrame, material: Enum.Material?, name: string?) -> BasePart,
	wedge: (size: Vector3, color: Color3, cf: CFrame, material: Enum.Material?) -> BasePart,
	limb: (part: BasePart, kind: string, side: number, px: number, py: number, pz: number) -> BasePart,
	onGlaze: (angle: number, tilt: number, lift: number) -> CFrame,
	face: (x: number, y: number, lift: number) -> CFrame,
	has: (name: string) -> boolean,
	find: (name: string) -> { BasePart },
	add: (part: BasePart, cf: CFrame, color: Color3, material: Enum.Material?) -> BasePart,
}

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)
local BLACK = rgb(20, 20, 24)
local GOLD = rgb(255, 200, 60)
local SILVER = rgb(205, 210, 220)
local NEON = Enum.Material.Neon
local GLASS = Enum.Material.Glass
local FOIL = Enum.Material.Foil
local METAL = Enum.Material.Metal
local WOOD = Enum.Material.Wood
local TAU = math.pi * 2

local function brightness(c: Color3): number
	return c.R * 0.299 + c.G * 0.587 + c.B * 0.114
end

---------------------------------------------------------------------------------------------------
-- Shared helpers (all in the donut's unscaled space)
---------------------------------------------------------------------------------------------------

-- A cylinder from `a` to `b` (rods, sticks, tails, strands).
local function segment(k: Kit, a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?, name: string?): BasePart
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	local along = b - a
	p.Size = Vector3.new(along.Magnitude + diameter * 0.4, diameter, diameter) * k.s
	p.Name = name or "Rod"
	local x = along.Unit
	local helper = if math.abs(x.Y) > 0.9 then Vector3.xAxis else Vector3.yAxis
	local z = x:Cross(helper).Unit
	local y = z:Cross(x).Unit
	return k.add(p, CFrame.fromMatrix((a + b) / 2 * k.s, x, y, z), color, material)
end

-- A flat disc facing along `cf`'s look direction (coins, clock faces, wheels, shields).
local function disc(k: Kit, cf: CFrame, thickness: number, diameter: number, color: Color3, material: Enum.Material?, name: string?): BasePart
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(thickness, diameter, diameter) * k.s
	p.Name = name or "Disc"
	-- cylinders run along X: turn X onto the look direction
	return k.add(p, cf * CFrame.Angles(0, math.pi / 2, 0), color, material)
end

-- Where `cf` (built from unscaled numbers) sits once scaled: rotation kept, position scaled.
local function scaled(k: Kit, cf: CFrame): CFrame
	return cf - cf.Position + cf.Position * k.s
end

-- A ring of short rods around `center` (unscaled CFrame; the ring lies in its XY plane), from
-- angle `from` to `to` (radians, 0 = +X). Good for loops, arcs, wheels, portals.
local function torus(k: Kit, center: CFrame, radius: number, thickness: number, count: number, color: Color3, material: Enum.Material?, name: string?, from: number?, to: number?, colors: { Color3 }?): { BasePart }
	local a0, a1 = from or 0, to or TAU
	local step = (a1 - a0) / count
	local pieces = {}
	for i = 0, count - 1 do
		local t0, t1 = a0 + step * i, a0 + step * (i + 1)
		local p0 = center:PointToWorldSpace(Vector3.new(math.cos(t0) * radius, math.sin(t0) * radius, 0))
		local p1 = center:PointToWorldSpace(Vector3.new(math.cos(t1) * radius, math.sin(t1) * radius, 0))
		table.insert(pieces, segment(k, p0, p1, thickness, if colors then colors[(i % #colors) + 1] else color, material, name))
	end
	return pieces
end

-- A point on the dough tube: `angle` round the ring, `around` from the front (0) over the outer
-- edge (pi/2) to the back (pi). The CFrame's up is the surface normal, X runs along the ring,
-- Z runs round the tube.
local function onDough(k: Kit, angle: number, around: number, lift: number): CFrame
	local radial = Vector3.new(math.cos(angle), math.sin(angle), 0)
	local normal = radial * math.sin(around) + Vector3.new(0, 0, -math.cos(around))
	local downTube = radial * math.cos(around) + Vector3.new(0, 0, math.sin(around))
	local tangent = Vector3.new(-radial.Y, radial.X, 0)
	local point = radial * k.R + normal * (k.BALL / 2 + lift)
	if k.Square then
		-- the square ring: its flat outer sides (or the cut corner there), else the dough's front
		local c, sn = math.cos(angle), math.sin(angle)
		local alongSide = k.TOP / math.max(math.abs(c), math.abs(sn))
		local toCorner = k.CornerReach / (math.abs(c) + math.abs(sn))
		local side = if toCorner < alongSide
			then Vector3.new(math.sign(c), math.sign(sn), 0).Unit
			elseif math.abs(c) >= math.abs(sn) then Vector3.new(math.sign(c), 0, 0)
			else Vector3.new(0, math.sign(sn), 0)
		normal = side * math.sin(around) + Vector3.new(0, 0, -math.cos(around))
		downTube = side * math.cos(around) + Vector3.new(0, 0, math.sin(around))
		tangent = Vector3.new(-side.Y, side.X, 0)
		local front, back = k.DoughFront, k.BALL / 2
		if around >= math.pi / 4 then
			local depth = math.clamp(-math.cos(around) / math.sin(around), -1, 1)
			point = Vector3.new(c, sn, 0) * math.min(alongSide, toCorner) + Vector3.new(0, 0, (front + back) / 2 + (back - front) / 2 * depth) + normal * lift
		else
			point = Vector3.new(c, sn, 0) * ((k.R + k.BALL / 2 * math.tan(around)) / math.max(math.abs(c), math.abs(sn))) + Vector3.new(0, 0, front) + normal * lift
		end
	elseif k.Studded then
		-- the square-edged dough ring: its outer side (from 45 degrees round), else its front
		local half = k.BALL / 2
		point = if around >= math.pi / 4
			then radial * (k.R + half) + Vector3.new(0, 0, -half * math.cos(around) / math.sin(around)) + normal * lift
			else radial * (k.R + half * math.tan(around)) + Vector3.new(0, 0, -half) + normal * lift
	end
	return CFrame.fromMatrix(point * k.s, tangent, normal, downTube)
end

-- A random angle on the glaze away from the face (which sits at the top).
local function glazeAngle(k: Kit): number
	local angle
	repeat
		angle = k.Rng:NextNumber(0, TAU)
	until math.abs(angle - math.pi / 2) > 0.8
	return angle
end

-- Where the right (side 1) or left (-1) hand is. Donuts without arms get a floating glove there.
-- (strong donuts flex their arms, so their fists are a little further out and up)
local function hand(k: Kit, side: number): Vector3
	local flexing = #k.find("Bicep") > 0
	local point = if flexing then Vector3.new(side * (k.R + 1.58), 0.84, -0.1) else Vector3.new(side * (k.R + 1.42), 0.72, -0.1)
	if not k.has("Arms") then
		local existing = false
		for _, glove in k.find("FloatingGlove") do
			if (glove.Position.X > 0) == (side > 0) then
				existing = true
			end
		end
		if not existing then
			k.ball(0.52, WHITE, k.at(point.X, point.Y, point.Z), nil, "FloatingGlove")
		end
	end
	return point
end

-- A four-pointed sparkle star.
local function sparkle(k: Kit, cf: CFrame, size: number, color: Color3, name: string?): { BasePart }
	return {
		k.ellipsoid(Vector3.new(size * 0.22, size, size * 0.12), color, cf, NEON, name or "Star"),
		k.ellipsoid(Vector3.new(size, size * 0.22, size * 0.12), color, cf, NEON, name or "Star"),
	}
end

-- A screen with a line of text (signs, error screens, terminals).
local function screen(k: Kit, cf: CFrame, size: Vector2, frame: Color3, back: Color3, text: string, textColor: Color3, font: Enum.Font?)
	k.block(Vector3.new(size.X + 0.16, size.Y + 0.16, 0.14), frame, cf, METAL, "ScreenFrame")
	local panel = k.block(Vector3.new(size.X, size.Y, 0.06), back, cf * CFrame.new(0, 0, -0.06 * k.s), NEON, "Screen")
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(size.X * 60, size.Y * 60)
	gui.LightInfluence = 0
	gui.Parent = panel
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = font or Enum.Font.Arcade
	label.TextColor3 = textColor
	label.Parent = gui
end

-- Wrapped round the tube at a ring angle: ridges, stripes, bands.
local function ridges(k: Kit, count: number, twist: number, color: Color3, width: number, material: Enum.Material?, name: string, skipFace: boolean?)
	for i = 0, count - 1 do
		local angle = (i + 0.5) / count * TAU
		if not skipFace or math.abs(angle - math.pi / 2) > 0.7 then
			local cf = onDough(k, angle, math.rad(95), -0.03) * CFrame.Angles(0, twist, 0)
			k.ellipsoid(Vector3.new(width, 0.1, 1.3), color, cf, material, name)
		end
	end
end

---------------------------------------------------------------------------------------------------
-- Theme details: a few small touches from the donut's home area
---------------------------------------------------------------------------------------------------
local Theme: { [string]: (k: Kit) -> () } = {}

local function lavaCracks(k: Kit, count: number, color: Color3)
	for _ = 1, count do
		local angle = k.Rng:NextNumber(0, TAU)
		local around = math.rad(k.Rng:NextNumber(70, 115))
		local cf = onDough(k, angle, around, -0.01) * CFrame.Angles(0, k.Rng:NextNumber(-0.9, 0.9), 0)
		k.ellipsoid(Vector3.new(0.07, 0.08, k.Rng:NextNumber(0.5, 0.9)), color, cf, NEON, "LavaCrack")
	end
end

local function specks(k: Kit, count: number, colors: { Color3 }, size: number, material: Enum.Material?, name: string)
	for i = 1, count do
		local cf = k.onGlaze(glazeAngle(k), k.Rng:NextNumber(-0.8, 0.9), -0.02) * CFrame.Angles(k.Rng:NextNumber(0, 3), k.Rng:NextNumber(0, 3), 0)
		k.block(Vector3.one * size, colors[(i - 1) % #colors + 1], cf, material, name)
	end
end

local function stars(k: Kit, count: number, color: Color3)
	for _ = 1, count do
		local cf = k.onGlaze(glazeAngle(k), k.Rng:NextNumber(-0.7, 0.8), 0.02)
		k.ball(0.14, color, cf, NEON, "StarSpeck")
	end
end

local function circuit(k: Kit, color: Color3)
	-- two traces running round the lower glaze, each ending in a pad
	for _, side in { -1, 1 } do
		local a0 = -math.pi / 2 + side * 0.25
		local a1 = a0 + side * 0.7
		for i = 0, 1 do
			local angle = a0 + (a1 - a0) * (i + 0.5) / 2
			local tilt = if i == 0 then 0.55 else -0.35
			k.ellipsoid(Vector3.new(0.6, 0.06, 0.05), color, k.onGlaze(angle, tilt, 0.005) * CFrame.Angles(0, 0, angle + math.pi / 2), NEON, "Circuit")
		end
		k.ball(0.17, color, k.onGlaze(a1, -0.35, 0.01), NEON, "CircuitPad")
	end
end

local function puffs(k: Kit, count: number, color: Color3, transparency: number)
	for i = 1, count do
		local angle = math.rad(200 + (i - 1) * 140 / math.max(count - 1, 1))
		local p = Vector3.new(math.cos(angle) * (k.R + 0.55), math.sin(angle) * (k.R + 0.55), 0.35)
		k.ball(k.Rng:NextNumber(0.75, 1.05), color, k.at(p.X, p.Y, p.Z), nil, "Puff").Transparency = transparency
	end
end

function Theme.Meadow(k: Kit)
	-- a daisy on the glaze
	local cf = k.onGlaze(math.rad(-35), 0.35, 0.02)
	k.ball(0.2, rgb(255, 210, 40), cf, nil, "Daisy")
	for i = 0, 4 do
		local a = i / 5 * TAU
		k.ellipsoid(Vector3.new(0.3, 0.13, 0.06), WHITE, cf * CFrame.Angles(0, 0, a) * CFrame.new(0.17 * k.s, 0, 0.01 * k.s), nil, "Petal")
	end
end

function Theme.Park(k: Kit)
	-- a lucky clover
	local cf = k.onGlaze(math.rad(-40), 0.3, 0.02)
	for i = 0, 2 do
		local a = i / 3 * TAU + 0.5
		k.ball(0.22, rgb(70, 190, 70), cf * CFrame.new(math.cos(a) * 0.11 * k.s, math.sin(a) * 0.11 * k.s, 0), nil, "Clover")
	end
	k.ellipsoid(Vector3.new(0.05, 0.3, 0.05), rgb(60, 150, 60), cf * CFrame.new(0.05 * k.s, -0.2 * k.s, 0), nil, "Clover")
end

function Theme.Desert(k: Kit)
	specks(k, 6, { rgb(255, 245, 220), rgb(240, 215, 160) }, 0.13, GLASS, "SugarCrystal")
end

function Theme.Frosting(k: Kit)
	-- a dollop of whipped cream with a cherry
	local cf = k.onGlaze(math.rad(-50), 0.2, 0.05)
	k.ellipsoid(Vector3.new(0.6, 0.6, 0.35), rgb(255, 250, 240), cf, nil, "Cream")
	k.ellipsoid(Vector3.new(0.4, 0.4, 0.3), rgb(255, 250, 240), cf * CFrame.new(0, 0, -0.2 * k.s), nil, "Cream")
	k.ball(0.26, rgb(220, 20, 50), cf * CFrame.new(0, 0, -0.38 * k.s), nil, "Cherry").Reflectance = 0.2
end

function Theme.Chocolate(k: Kit)
	-- chocolate drizzle (white chocolate on dark glaze)
	local color = if brightness(k.Frosting) < 0.35 then rgb(250, 240, 225) else rgb(70, 35, 20)
	for i = 0, 2 do
		local angle = math.rad(-90 + (i - 1) * 38)
		k.ellipsoid(Vector3.new(0.08, 1.3, 0.05), color, k.onGlaze(angle, 0, 0.01) * CFrame.Angles(0, 0, angle + 0.5), nil, "Drizzle")
	end
end

function Theme.Ice(k: Kit)
	-- icicles hanging under the ring
	for i = 0, 2 do
		local angle = math.rad(-125 + i * 35)
		local x, y = math.cos(angle) * (k.R + 0.15), math.sin(angle) * (k.R + 0.15)
		local icicle = k.ellipsoid(Vector3.new(0.2, 0.75, 0.2), rgb(190, 235, 255), k.at(x, y - 0.4, -0.35), GLASS, "Icicle")
		icicle.Transparency = 0.15
	end
end

function Theme.Lava(k: Kit)
	lavaCracks(k, 3, rgb(255, 140, 30))
end

function Theme.Neon(k: Kit)
	circuit(k, k.Sprinkles[1] or rgb(0, 255, 200))
end

function Theme.Crystal(k: Kit)
	for i = 0, 2 do
		local angle = math.rad(-60 - i * 30)
		local cf = onDough(k, angle, math.rad(100), 0.15) * CFrame.Angles(0, math.rad(45), k.Rng:NextNumber(-0.3, 0.3))
		local shard = k.block(Vector3.new(0.28, 0.75 - i * 0.12, 0.28), k.Frosting:Lerp(WHITE, 0.35), cf, GLASS, "Crystal")
		shard.Transparency = 0.2
		shard.Reflectance = 0.3
	end
end

function Theme.Celestial(k: Kit)
	stars(k, 4, rgb(255, 250, 210))
end

function Theme.Candy(k: Kit)
	local colors = { rgb(255, 70, 90), rgb(255, 220, 60), rgb(90, 220, 120) }
	for i = 0, 2 do
		local cf = k.onGlaze(math.rad(-60 - i * 30), k.Rng:NextNumber(-0.3, 0.4), 0.08)
		k.ellipsoid(Vector3.new(0.3, 0.3, 0.26), colors[i + 1], cf, nil, "Gumdrop").Reflectance = 0.1
	end
end

function Theme.Rainbow(k: Kit)
	local colors = { rgb(255, 60, 60), rgb(255, 160, 40), rgb(255, 230, 60), rgb(80, 220, 100), rgb(60, 150, 255), rgb(170, 90, 255) }
	for i, color in colors do
		local angle = math.rad(-160 + (i - 1) * 28)
		k.ball(0.2, color, k.onGlaze(angle, 0.75, 0.02), NEON, "RainbowDot")
	end
end

-- The Underworld
function Theme.EmberGates(k: Kit)
	lavaCracks(k, 3, rgb(255, 120, 20))
	k.ball(0.16, rgb(255, 210, 80), k.onGlaze(glazeAngle(k), 0.2, 0.05), NEON, "Ember")
end
function Theme.BrimstoneBakery(k: Kit)
	lavaCracks(k, 2, rgb(255, 150, 30))
	specks(k, 4, { rgb(255, 230, 80), rgb(230, 200, 60) }, 0.12, nil, "Brimstone")
end
function Theme.MagmaRivers(k: Kit)
	lavaCracks(k, 2, rgb(255, 110, 20))
	local angle = math.rad(-60)
	local radial = Vector3.new(math.cos(angle), math.sin(angle), 0)
	local p = radial * (k.R + 0.55)
	k.ellipsoid(Vector3.new(0.3, 0.95, 0.3), rgb(255, 120, 20), k.at(p.X, p.Y - 0.35, -0.3), NEON, "LavaDrip")
end
function Theme.SoulCaverns(k: Kit)
	for i = 0, 1 do
		local p = Vector3.new(if i == 0 then -2.6 else 2.5, if i == 0 then 1.4 else -0.6, 0.3)
		local wisp = k.ellipsoid(Vector3.new(0.4, 0.55, 0.4), rgb(120, 230, 255), k.at(p.X, p.Y, p.Z), NEON, "Wisp")
		wisp.Transparency = 0.35
		k.limb(wisp, "Orbit", 0, 0, 0, 0)
	end
end
function Theme.ObsidianForge(k: Kit)
	lavaCracks(k, 2, rgb(255, 100, 20))
	local cf = onDough(k, math.rad(-140), math.rad(95), 0.15) * CFrame.Angles(0, math.rad(45), 0.3)
	k.block(Vector3.new(0.3, 0.7, 0.3), rgb(25, 20, 35), cf, GLASS, "Obsidian").Reflectance = 0.4
end
function Theme.InfernoSpires(k: Kit)
	lavaCracks(k, 3, rgb(255, 80, 20))
end
function Theme.MoltenCore(k: Kit)
	lavaCracks(k, 4, rgb(255, 170, 40))
end

-- Dream Dimension
function Theme.Clouds(k: Kit)
	puffs(k, 3, WHITE, 0.05)
end
function Theme.Toys(k: Kit)
	-- stitching round the outer edge
	for i = 0, 4 do
		local angle = math.rad(-150 + i * 30)
		k.block(Vector3.new(0.25, 0.05, 0.06), rgb(255, 255, 255), onDough(k, angle, math.rad(85), 0.005), nil, "Stitch")
	end
end
function Theme.Haunted(k: Kit)
	-- green slime dripping off the bottom
	for i = 0, 1 do
		local angle = math.rad(if i == 0 then -60 else -125)
		local p = Vector3.new(math.cos(angle) * (k.R + 0.45), math.sin(angle) * (k.R + 0.45), -0.35)
		k.ellipsoid(Vector3.new(0.3, 0.8, 0.3), rgb(140, 255, 110), k.at(p.X, p.Y - 0.25, p.Z), NEON, "Slime").Transparency = 0.15
	end
end
function Theme.Clockwork(k: Kit)
	for i = 0, 3 do
		local angle = math.rad(-150 + i * 40)
		k.ball(0.17, rgb(220, 170, 70), onDough(k, angle, math.rad(80), 0), FOIL, "Rivet")
	end
end
function Theme.Heaven(k: Kit)
	stars(k, 3, rgb(255, 225, 120))
end
function Theme.Starfall(k: Kit)
	stars(k, 4, rgb(255, 240, 180))
end
function Theme.Aurora(k: Kit)
	local cf = k.at(0, 0.4, 0.95) * CFrame.Angles(0, 0, 0.35)
	local band = k.ellipsoid(Vector3.new(5.2, 0.5, 0.08), rgb(120, 255, 200), cf, NEON, "Aurora")
	band.Transparency = 0.55
	local band2 = k.ellipsoid(Vector3.new(4.6, 0.4, 0.08), rgb(190, 120, 255), cf * CFrame.new(0, -0.35 * k.s, 0.05 * k.s), NEON, "Aurora")
	band2.Transparency = 0.6
end

-- Cyber City
function Theme.CyberStreets(k: Kit)
	circuit(k, k.Sprinkles[1] or rgb(255, 0, 200))
end
function Theme.Hologram(k: Kit)
	-- hologram scanlines across the front
	for i = 0, 1 do
		local line = k.block(Vector3.new(4.6, 0.07, 0.04), rgb(120, 240, 255), k.at(0, -0.6 + i * 1.3, -1.02), NEON, "Scanline")
		line.Transparency = 0.45
	end
end
function Theme.RobotFactory(k: Kit)
	for i = 0, 3 do
		k.ball(0.17, rgb(170, 175, 185), onDough(k, math.rad(-150 + i * 40), math.rad(80), 0), METAL, "Rivet")
	end
end
function Theme.DataHighway(k: Kit)
	circuit(k, rgb(60, 255, 140))
end
function Theme.Firewall(k: Kit)
	lavaCracks(k, 3, rgb(255, 60, 40))
end
function Theme.Glitch(k: Kit)
	for i = 0, 2 do
		local y = -1.2 + i * 1.1
		local glitch = k.block(Vector3.new(k.Rng:NextNumber(1.2, 2.4), 0.16, 0.06), if i % 2 == 0 then rgb(255, 0, 200) else rgb(0, 255, 230), k.at(k.Rng:NextNumber(-1.2, 1.2), y, -1.0), NEON, "Glitch")
		glitch.Transparency = 0.35
	end
end
function Theme.Mainframe(k: Kit)
	circuit(k, rgb(80, 170, 255))
end
function Theme.BlackHole(k: Kit)
	stars(k, 3, rgb(210, 180, 255))
	local band = k.ellipsoid(Vector3.new(5.4, 0.12, 5.4), rgb(160, 100, 255), k.at(0, -0.3, 0) * CFrame.Angles(math.rad(12), 0, math.rad(-10)), NEON, "Accretion")
	band.Transparency = 0.75
end

function DonutExtras.Theme(k: Kit, theme: string, cosmic: boolean)
	local builder = Theme[theme]
	if builder then
		builder(k)
	end
	if cosmic then
		stars(k, 3, rgb(200, 180, 255))
	end
end

---------------------------------------------------------------------------------------------------
-- Signature accessories (match the donut's name)
---------------------------------------------------------------------------------------------------
local A: { [string]: (k: Kit) -> () } = {}
DonutExtras.Accessories = A

-- Sweets ------------------------------------------------------------------------------------------

function A.SugarCoat(k: Kit)
	specks(k, 10, { WHITE, rgb(240, 240, 255) }, 0.13, GLASS, "Sugar")
end

function A.SprinkleStorm(k: Kit)
	local colors = if #k.Sprinkles > 0 then k.Sprinkles else { WHITE }
	for n = 1, 12 do
		local cf
		if n % 3 == 0 then
			cf = onDough(k, k.Rng:NextNumber(0, TAU), math.rad(k.Rng:NextNumber(60, 120)), 0.03) * CFrame.Angles(0, k.Rng:NextNumber(0, 3), 0)
		else
			cf = k.onGlaze(glazeAngle(k), k.Rng:NextNumber(-1, 1.1), -0.035) * CFrame.Angles(0, 0, k.Rng:NextNumber(0, TAU))
		end
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.4, 0.12, 0.12) * k.s
		p.Name = "Sprinkle"
		k.add(p, cf, colors[(n - 1) % #colors + 1])
	end
end

function A.WoodGrain(k: Kit)
	-- a log of a donut: wooden dough with knots
	for _, piece in k.find("Dough") do
		piece.Material = WOOD
	end
	for i = 0, 1 do
		local cf = onDough(k, math.rad(if i == 0 then -30 else 200), math.rad(90), 0.0)
		k.ellipsoid(Vector3.new(0.45, 0.08, 0.35), k.Dough:Lerp(BLACK, 0.45), cf, WOOD, "Knot")
	end
end

function A.CrullerRidges(k: Kit)
	ridges(k, 10, math.rad(35), k.Dough:Lerp(WHITE, 0.25), 0.2, nil, "Ridge")
end

function A.PumpkinRidges(k: Kit)
	ridges(k, 8, 0, k.Dough:Lerp(BLACK, 0.3), 0.14, nil, "Rib")
end

function A.CreamFilling(k: Kit)
	local cream = rgb(255, 240, 200)
	k.ellipsoid(Vector3.new(1.05, 0.55, 0.9), cream, k.at(0, -0.5, -0.15), nil, "Cream")
	k.ellipsoid(Vector3.new(0.5, 0.35, 0.55), cream, onDough(k, math.rad(-20), math.rad(80), 0.08), nil, "Cream")
	k.ellipsoid(Vector3.new(0.22, 0.5, 0.22), cream, k.at(k.R + 0.62, -0.95, -0.25), nil, "Cream")
end

function A.JellyOoze(k: Kit)
	local jelly = rgb(215, 25, 55)
	local blob = k.ellipsoid(Vector3.new(1.0, 0.6, 0.85), jelly, k.at(0, -0.48, -0.15), GLASS, "Jelly")
	blob.Transparency = 0.1
	blob.Reflectance = 0.25
	k.ellipsoid(Vector3.new(0.5, 0.35, 0.5), jelly, onDough(k, math.rad(-25), math.rad(85), 0.08), GLASS, "Jelly").Reflectance = 0.25
	k.ellipsoid(Vector3.new(0.24, 0.55, 0.24), jelly, k.at(k.R + 0.55, -1.05, -0.3), GLASS, "Jelly").Reflectance = 0.25
	k.ball(0.18, jelly, k.at(k.R + 0.5, -1.5, -0.3), GLASS, "Jelly")
end

function A.FudgeDrips(k: Kit)
	local fudge = k.Frosting:Lerp(BLACK, 0.25)
	for i = 0, 3 do
		local angle = math.rad(-160 + i * 45)
		local radial = Vector3.new(math.cos(angle), math.sin(angle), 0)
		local p = radial * (k.R + 0.6)
		local drip = k.ellipsoid(Vector3.new(0.35, 0.9 + (i % 2) * 0.35, 0.3), fudge, k.at(p.X, p.Y - 0.25, -0.3), nil, "Fudge")
		drip.Reflectance = 0.2
	end
end

function A.CaramelDrips(k: Kit)
	local caramel = rgb(225, 140, 40)
	for i = 0, 3 do
		local angle = math.rad(-150 + i * 40)
		local radial = Vector3.new(math.cos(angle), math.sin(angle), 0)
		local p = radial * (k.R + 0.6)
		k.ellipsoid(Vector3.new(0.3, 0.85 + (i % 2) * 0.3, 0.28), caramel, k.at(p.X, p.Y - 0.25, -0.3), GLASS, "Caramel").Reflectance = 0.3
	end
	k.ellipsoid(Vector3.new(0.07, 2.2, 0.05), caramel, k.onGlaze(math.rad(-90), 0, 0.01) * CFrame.Angles(0, 0, 1.1), GLASS, "Drizzle")
end

function A.CinnamonSwirl(k: Kit)
	local cinnamon = rgb(150, 85, 35)
	for i = 0, 7 do
		local angle = math.rad(-170 + i * 22)
		k.ellipsoid(Vector3.new(0.34, 0.12, 0.05), cinnamon, k.onGlaze(angle, math.sin(i * 1.3) * 0.55, 0.005) * CFrame.Angles(0, 0, angle + math.pi / 2 + math.sin(i) * 0.5), nil, "Cinnamon")
	end
end

function A.StrawberrySlices(k: Kit)
	local red = rgb(235, 40, 70)
	for i = 0, 1 do
		local cf = k.onGlaze(math.rad(-50 - i * 70), 0.15, 0.04) * CFrame.Angles(0, 0, i * 1.2)
		k.ellipsoid(Vector3.new(0.6, 0.5, 0.1), red, cf, nil, "Strawberry")
		k.ellipsoid(Vector3.new(0.32, 0.26, 0.11), rgb(255, 200, 210), cf * CFrame.new(0, -0.03 * k.s, -0.01 * k.s), nil, "Strawberry")
	end
	-- a whole strawberry on top
	k.ellipsoid(Vector3.new(0.55, 0.65, 0.55), red, k.at(0.7, k.TOP + 0.25, 0), nil, "Strawberry").Reflectance = 0.15
	k.ellipsoid(Vector3.new(0.6, 0.12, 0.6), rgb(70, 170, 60), k.at(0.7, k.TOP + 0.55, 0), nil, "Leaves")
end

function A.Gumdrops(k: Kit)
	local colors = { rgb(255, 60, 80), rgb(255, 210, 50), rgb(80, 220, 110), rgb(170, 90, 255) }
	for i, color in colors do
		local angle = math.rad(20 + (i - 1) * 47)
		local x, y = math.cos(angle) * 0.9, k.TOP - 0.05 + math.sin(i) * 0.05
		k.ellipsoid(Vector3.new(0.5, 0.5, 0.5), color, k.at(x - 0.5, y + 0.1, (i - 2.5) * 0.25), nil, "Gumdrop").Reflectance = 0.1
	end
end

function A.CandyCane(k: Kit)
	local h = hand(k, -1)
	local base = h + Vector3.new(0, -1.1, -0.1)
	local top = h + Vector3.new(0, 1.3, -0.1)
	for i = 0, 3 do
		local a = base:Lerp(top, i / 4)
		local b = base:Lerp(top, (i + 1) / 4)
		segment(k, a, b, 0.3, if i % 2 == 0 then rgb(230, 30, 45) else WHITE, nil, "CandyCane")
	end
	torus(k, CFrame.new(top + Vector3.new(0.4, 0, 0)), 0.4, 0.3, 4, WHITE, nil, "CandyCane", 0, math.pi, { rgb(230, 30, 45), WHITE })
end

function A.Lollipop(k: Kit)
	local h = hand(k, 1)
	local top = h + Vector3.new(0, 1.6, -0.1)
	segment(k, h + Vector3.new(0, -0.3, -0.1), top, 0.12, WHITE, nil, "Stick")
	local cf = CFrame.new(top + Vector3.new(0, 0.45, 0)) * CFrame.Angles(0, math.pi, 0)
	disc(k, scaled(k, cf), 0.18, 1.2, k.Frosting, nil, "Lollipop")
	disc(k, scaled(k, cf * CFrame.new(0, 0, -0.03)), 0.18, 0.8, WHITE, nil, "Swirl")
	disc(k, scaled(k, cf * CFrame.new(0, 0, -0.06)), 0.18, 0.42, k.Frosting:Lerp(BLACK, 0.2), nil, "Swirl")
end

function A.PeppermintSwirl(k: Kit)
	-- a big peppermint behind the donut, slowly turning
	local center = Vector3.new(0, 0.2, 0.95)
	local cf = scaled(k, CFrame.new(center))
	disc(k, cf, 0.2, 5.2, WHITE, nil, "Peppermint")
	for i = 0, 3 do
		local stripe = k.ellipsoid(Vector3.new(0.7, 2.5, 0.22), rgb(230, 30, 45), cf * CFrame.Angles(0, 0, i / 4 * math.pi) * CFrame.new(0, 1.2 * k.s, -0.08 * k.s), nil, "Peppermint")
		k.limb(stripe, "Roll", 0, center.X, center.Y, center.Z)
	end
end

-- Animals -----------------------------------------------------------------------------------------

function A.CatEars(k: Kit)
	for _, side in { -1, 1 } do
		local cf = k.at(side * 0.85, k.TOP + 0.25, 0.05) * CFrame.Angles(0, 0, side * math.rad(-15))
		k.wedge(Vector3.new(0.22, 0.75, 0.6), k.Dough:Lerp(BLACK, 0.15), cf * CFrame.Angles(0, math.pi / 2, 0))
		k.wedge(Vector3.new(0.23, 0.45, 0.32), rgb(255, 170, 190), cf * CFrame.new(0, -0.08 * k.s, -0.06 * k.s) * CFrame.Angles(0, math.pi / 2, 0))
	end
end

function A.BigNose(k: Kit)
	k.ellipsoid(Vector3.new(0.45, 0.42, 0.8), rgb(255, 190, 150), k.face(0, k.TOP - 0.98, 0.18), nil, "Nose")
end

function A.Trunk(k: Kit)
	local grey = rgb(150, 170, 140)
	local p0 = Vector3.new(0, k.TOP - 0.95, -1.05)
	local p1 = Vector3.new(0, k.TOP - 1.5, -1.35)
	local p2 = Vector3.new(0, k.TOP - 2.05, -1.25)
	local p3 = Vector3.new(0.2, k.TOP - 2.35, -0.95)
	for _, piece in { { From = p0, To = p1, D = 0.42 }, { From = p1, To = p2, D = 0.34 }, { From = p2, To = p3, D = 0.26 } } do
		local part = segment(k, piece.From, piece.To, piece.D, grey, nil, "Trunk")
		k.limb(part, "Tentacle", 1, p0.X, p0.Y, p0.Z)
	end
end

function A.SharkTail(k: Kit)
	local grey = rgb(120, 140, 170)
	local pivot = Vector3.new(0, -0.8, 0.75)
	local upper = k.wedge(Vector3.new(0.22, 1.0, 0.9), grey, k.at(0, -0.55, 1.45) * CFrame.Angles(math.rad(-35), math.pi, 0))
	local lower = k.wedge(Vector3.new(0.22, 0.8, 0.7), grey, k.at(0, -1.25, 1.35) * CFrame.Angles(math.rad(-150), math.pi, 0))
	for _, part in { upper, lower } do
		part.Name = "SharkTail"
		k.limb(part, "Tail", 0, pivot.X, pivot.Y, pivot.Z)
	end
end

function A.SharkGills(k: Kit)
	for i = 0, 2 do
		k.ellipsoid(Vector3.new(0.06, 0.5, 0.05), BLACK, k.onGlaze(math.rad(-15 - i * 9), 0.6, 0.0) * CFrame.Angles(0, 0, 0.2), nil, "Gill")
	end
end

function A.ShrimpTail(k: Kit)
	local pink = rgb(255, 140, 110)
	local pivot = Vector3.new(0, -0.9, 0.7)
	local points = { Vector3.new(0, -0.9, 0.9), Vector3.new(0, -1.45, 1.3), Vector3.new(0, -1.8, 1.75) }
	for i, p in points do
		local part = k.ellipsoid(Vector3.new(0.75 - i * 0.15, 0.55 - i * 0.1, 0.6), if i % 2 == 0 then pink:Lerp(WHITE, 0.25) else pink, k.at(p.X, p.Y, p.Z) * CFrame.Angles(math.rad(-30 - i * 15), 0, 0), nil, "ShrimpTail")
		k.limb(part, "Tail", 0, pivot.X, pivot.Y, pivot.Z)
	end
	for _, side in { -1, 1 } do
		local fan = k.ellipsoid(Vector3.new(0.45, 0.1, 0.7), pink, k.at(side * 0.22, -2.05, 2.1) * CFrame.Angles(0.4, side * 0.5, 0), nil, "ShrimpTail")
		k.limb(fan, "Tail", 0, pivot.X, pivot.Y, pivot.Z)
	end
end

function A.BeaverTeeth(k: Kit)
	for _, side in { -1, 1 } do
		k.block(Vector3.new(0.18, 0.28, 0.06), WHITE, k.face(side * 0.1, k.TOP - 1.38, 0.03), nil, "Tooth")
	end
	local tail = k.ellipsoid(Vector3.new(1.0, 0.18, 1.6), rgb(110, 75, 50), k.at(0, -1.7, 1.4) * CFrame.Angles(math.rad(-25), 0, 0), nil, "BeaverTail")
	k.limb(tail, "Tail", 0, 0, -1.2, 0.7)
end

function A.CowSpots(k: Kit)
	for _ = 1, 4 do
		local cf = k.onGlaze(glazeAngle(k), k.Rng:NextNumber(-0.6, 0.6), 0.005) * CFrame.Angles(0, 0, k.Rng:NextNumber(0, 3))
		k.ellipsoid(Vector3.new(k.Rng:NextNumber(0.5, 0.8), k.Rng:NextNumber(0.35, 0.55), 0.04), BLACK, cf, nil, "CowSpot")
	end
end

function A.CowBell(k: Kit)
	k.ellipsoid(Vector3.new(2.6, 0.22, 0.25), rgb(150, 60, 40), k.at(0, -k.R + 0.05, -0.85), nil, "Collar")
	k.ellipsoid(Vector3.new(0.5, 0.55, 0.45), GOLD, k.at(0, -k.R - 0.35, -1.0), FOIL, "Bell")
	k.ball(0.15, rgb(120, 90, 30), k.at(0, -k.R - 0.62, -1.0), nil, "Bell")
end

function A.CrocSnout(k: Kit)
	local green = k.Frosting:Lerp(rgb(40, 120, 50), 0.4)
	local cf = k.face(0, k.TOP - 1.3, 0.45)
	k.ellipsoid(Vector3.new(1.0, 0.45, 1.5), green, cf, nil, "Snout")
	for _, side in { -1, 1 } do
		k.ball(0.14, BLACK, cf * CFrame.new(side * 0.15 * k.s, 0.18 * k.s, -0.6 * k.s), nil, "Nostril")
		for t = 0, 1 do
			k.wedge(Vector3.new(0.08, 0.16, 0.12), WHITE, cf * CFrame.new(side * 0.4 * k.s, -0.2 * k.s, (-0.35 + t * 0.35) * k.s) * CFrame.Angles(math.pi, 0, 0))
		end
	end
end

function A.Flippers(k: Kit)
	k.ellipsoid(Vector3.new(1.3, 0.95, 0.1), WHITE, k.onGlaze(-math.pi / 2, 0, 0.02), nil, "Belly")
	for _, side in { -1, 1 } do
		local flipper = k.ellipsoid(Vector3.new(0.4, 1.3, 0.25), k.Frosting, k.at(side * (k.R + 0.95), -0.3, 0) * CFrame.Angles(0, 0, side * math.rad(25)), nil, "Flipper")
		k.limb(flipper, "Wing", side, side * (k.R + 0.7), 0.2, 0)
	end
end

function A.BowTie(k: Kit)
	local red = rgb(220, 30, 50)
	local cf = k.face(0, 0.9, 0.05)
	for _, side in { -1, 1 } do
		k.wedge(Vector3.new(0.12, 0.4, 0.35), red, cf * CFrame.new(side * 0.2 * k.s, 0, 0) * CFrame.Angles(0, side * math.pi / 2, math.pi / 2))
	end
	k.ball(0.18, red:Lerp(BLACK, 0.2), cf, nil, "BowTie")
end

function A.FurTufts(k: Kit)
	local fur = k.Dough:Lerp(WHITE, 0.6)
	for i = 0, 5 do
		local angle = math.rad(-170 + i * 36)
		if math.abs(angle - math.pi / 2) > 0.6 then
			k.ball(k.Rng:NextNumber(0.5, 0.65), fur, onDough(k, angle, math.rad(95), 0.05), nil, "Fur")
		end
	end
end

function A.TigerStripes(k: Kit)
	for i = 0, 5 do
		local angle = math.rad(-160 + i * 28)
		k.ellipsoid(Vector3.new(0.1, 0.75, 0.04), BLACK, k.onGlaze(angle, 0.1, 0.005) * CFrame.Angles(0, 0, angle + 0.3), nil, "Stripe")
	end
end

function A.CrabClaws(k: Kit)
	local red = k.Frosting:Lerp(rgb(200, 40, 30), 0.5)
	for _, glove in k.find("Glove") do
		glove.Color = red
	end
	for _, side in { -1, 1 } do
		local h = hand(k, side)
		local shoulderX, shoulderY = side * (k.R + 0.74), -0.25
		for j, tilt in { 0.35, -0.35 } do
			local claw = k.ellipsoid(Vector3.new(0.35, 0.85, 0.35), red, k.at(h.X + side * 0.15, h.Y + 0.45, h.Z) * CFrame.Angles(0, 0, side * tilt), nil, "Claw")
			if j == 2 then
				claw.Size = claw.Size * 0.8
			end
			k.limb(claw, "Arm", side, shoulderX, shoulderY, -0.1)
		end
	end
end

function A.FlamingoLegs(k: Kit)
	local pink = rgb(255, 120, 165)
	for _, part in k.find("Leg") do
		if part:GetAttribute("Limb") == "Leg" then
			part.Color = pink
			part.Size = Vector3.new(part.Size.X, part.Size.Y * 0.6, part.Size.Z * 0.6)
		end
	end
	for _, name in { "Shoe", "Sole" } do
		for _, part in k.find(name) do
			part.Color = pink:Lerp(BLACK, if name == "Sole" then 0.3 else 0.1)
		end
	end
end

function A.FeatherTuft(k: Kit)
	local pink = k.Frosting:Lerp(rgb(255, 120, 170), 0.5)
	for i = -1, 1 do
		local f = k.ellipsoid(Vector3.new(0.22, 0.95, 0.12), pink, k.at(i * 0.22, k.TOP + 0.45, 0.1) * CFrame.Angles(0, 0, -i * 0.4), nil, "Feather")
		k.limb(f, "Sway", 0, 0, k.TOP, 0)
	end
end

function A.BigBeak(k: Kit)
	local cf = k.face(0, k.TOP - 1.15, 0.6)
	k.ellipsoid(Vector3.new(0.7, 0.55, 1.6), rgb(255, 150, 30), cf, nil, "Beak")
	k.ellipsoid(Vector3.new(0.72, 0.3, 0.6), rgb(255, 220, 60), cf * CFrame.new(0, 0.12 * k.s, 0.2 * k.s), nil, "Beak")
	k.ball(0.3, BLACK, cf * CFrame.new(0, 0, -0.75 * k.s), nil, "BeakTip")
end

function A.DinoSpikes(k: Kit)
	local color = k.Frosting:Lerp(BLACK, 0.25)
	for i = 0, 4 do
		local angle = math.rad(30 + i * 30)
		local cf = onDough(k, angle, math.rad(110), 0.0)
		k.wedge(Vector3.new(0.2, 0.55 - math.abs(i - 2) * 0.08, 0.5), color, cf)
	end
end

function A.DragonTail(k: Kit)
	local color = k.Frosting:Lerp(k.Dough, 0.4)
	local pivot = Vector3.new(0, -1.0, 0.7)
	local points = { Vector3.new(0, -1.0, 0.7), Vector3.new(0.5, -1.7, 1.6), Vector3.new(1.4, -2.0, 2.2), Vector3.new(2.2, -1.7, 2.5) }
	for i = 1, 3 do
		local part = segment(k, points[i], points[i + 1], 0.55 - i * 0.12, color, nil, "Tail")
		k.limb(part, "Tail", 0, pivot.X, pivot.Y, pivot.Z)
		local spike = k.wedge(Vector3.new(0.12, 0.35, 0.3), color:Lerp(BLACK, 0.3), k.at(points[i].X, points[i].Y + 0.3, points[i].Z) * CFrame.Angles(0, -0.6, 0))
		k.limb(spike, "Tail", 0, pivot.X, pivot.Y, pivot.Z)
	end
	local tip = k.wedge(Vector3.new(0.12, 0.6, 0.55), color:Lerp(BLACK, 0.3), k.at(points[4].X + 0.2, points[4].Y, points[4].Z) * CFrame.Angles(0, -1.0, math.pi / 2))
	k.limb(tip, "Tail", 0, pivot.X, pivot.Y, pivot.Z)
end

function A.DevilTail(k: Kit)
	local red = rgb(200, 20, 30)
	local pivot = Vector3.new(0, -1.0, 0.7)
	local points = { Vector3.new(0, -1.0, 0.7), Vector3.new(0.7, -1.9, 1.3), Vector3.new(1.6, -1.6, 1.6), Vector3.new(2.1, -0.9, 1.6) }
	for i = 1, 3 do
		k.limb(segment(k, points[i], points[i + 1], 0.16, red, nil, "Tail"), "Tail", 0, pivot.X, pivot.Y, pivot.Z)
	end
	local spade = k.wedge(Vector3.new(0.1, 0.5, 0.5), red, k.at(2.2, -0.6, 1.6) * CFrame.Angles(0, math.pi / 2, 0))
	k.limb(spade, "Tail", 0, pivot.X, pivot.Y, pivot.Z)
end

function A.PhoenixCrest(k: Kit)
	local colors = { rgb(255, 230, 80), rgb(255, 140, 30), rgb(255, 60, 30) }
	for i, color in colors do
		local f = k.ellipsoid(Vector3.new(0.2, 1.1 - i * 0.12, 0.14), color, k.at((i - 2) * 0.2, k.TOP + 0.5, 0.15 + i * 0.12) * CFrame.Angles(-0.35 - i * 0.1, 0, (2 - i) * 0.3), NEON, "Crest")
		k.limb(f, "Sway", 0, 0, k.TOP, 0)
	end
end

function A.PhoenixTail(k: Kit)
	local colors = { rgb(255, 210, 60), rgb(255, 120, 30), rgb(255, 60, 30) }
	local pivot = Vector3.new(0, -1.0, 0.7)
	for i, color in colors do
		local f = k.ellipsoid(Vector3.new(0.3, 2.2, 0.15), color, k.at((i - 2) * 0.55, -2.0, 1.4) * CFrame.Angles(0.6, 0, (i - 2) * 0.35), NEON, "TailFeather")
		f.Transparency = 0.1
		k.limb(f, "Tail", 0, pivot.X, pivot.Y, pivot.Z)
	end
end

function A.Bats(k: Kit)
	for i = 0, 1 do
		local angle = i * math.pi + 0.6
		local p = Vector3.new(math.cos(angle) * (k.R + 1.9), 1.2 - i * 0.8, math.sin(angle) * (k.R + 1.9))
		local body = k.ball(0.32, BLACK, k.at(p.X, p.Y, p.Z), nil, "Bat")
		k.limb(body, "Orbit", 0, 0, 0, 0)
		for _, side in { -1, 1 } do
			local wing = k.wedge(Vector3.new(0.06, 0.3, 0.55), BLACK, k.at(p.X + side * 0.3, p.Y + 0.05, p.Z) * CFrame.Angles(0, side * math.pi / 2, 0))
			k.limb(wing, "Orbit", 0, 0, 0, 0)
		end
	end
end

-- Hats & heads ------------------------------------------------------------------------------------

function A.Tiara(k: Kit)
	local cf = k.at(0, k.TOP + 0.05, -0.15)
	k.ellipsoid(Vector3.new(1.3, 0.16, 0.6), SILVER, cf, METAL, "Tiara")
	for i = -1, 1 do
		k.wedge(Vector3.new(0.1, 0.4 - math.abs(i) * 0.12, 0.25), SILVER, cf * CFrame.new(i * 0.35 * k.s, 0.2 * k.s, -0.1 * k.s) * CFrame.Angles(0, math.pi / 2, 0))
	end
	k.ball(0.2, rgb(255, 120, 200), cf * CFrame.new(0, 0.12 * k.s, -0.3 * k.s), NEON, "Gem")
end

function A.LeafCrown(k: Kit)
	local green = rgb(80, 180, 70)
	for i = 0, 3 do
		local a = i / 4 * TAU + 0.4
		k.ellipsoid(Vector3.new(0.9, 0.12, 0.38), green, k.at(math.cos(a) * 0.45, k.TOP + 0.3, math.sin(a) * 0.45) * CFrame.Angles(0, -a, math.rad(30)), nil, "Leaf")
	end
	k.block(Vector3.new(0.1, 0.5, 0.1), rgb(110, 75, 40), k.at(0, k.TOP + 0.3, 0), WOOD, "Twig")
end

function A.MinerHelmet(k: Kit)
	k.ellipsoid(Vector3.new(1.8, 1.0, 1.6), rgb(255, 200, 30), k.at(0, k.TOP + 0.2, 0), nil, "Helmet")
	k.cylinder(0.08, 2.1, rgb(240, 180, 20), k.at(0, k.TOP - 0.05, 0), nil, "Brim")
	disc(k, k.at(0, k.TOP + 0.3, -0.78) * CFrame.Angles(0, math.pi, 0), 0.2, 0.5, rgb(60, 60, 60), METAL, "Lamp")
	disc(k, k.at(0, k.TOP + 0.3, -0.85) * CFrame.Angles(0, math.pi, 0), 0.06, 0.36, rgb(255, 250, 200), NEON, "LampLight")
end

function A.Fedora(k: Kit)
	local brown = rgb(70, 50, 40)
	k.ellipsoid(Vector3.new(2.3, 0.12, 1.9), brown, k.at(0, k.TOP, 0) * CFrame.Angles(0, 0, 0.08), nil, "Fedora")
	k.ellipsoid(Vector3.new(1.35, 0.85, 1.15), brown, k.at(0, k.TOP + 0.35, 0), nil, "Fedora")
	k.cylinder(0.18, 1.3, BLACK, k.at(0, k.TOP + 0.15, 0), nil, "Band")
end

function A.Goggles(k: Kit)
	k.ellipsoid(Vector3.new(2.6, 0.18, 1.7), rgb(90, 60, 40), k.at(0, k.TOP - 0.15, 0.05) * CFrame.Angles(0.25, 0, 0), nil, "Strap")
	for _, side in { -1, 1 } do
		local cf = k.at(side * 0.4, k.TOP + 0.05, -0.65) * CFrame.Angles(0.6, math.pi, 0)
		disc(k, cf, 0.22, 0.55, rgb(160, 120, 60), METAL, "GoggleRim")
		disc(k, cf * CFrame.new(0, 0, 0.06 * k.s), 0.1, 0.4, rgb(255, 160, 60), GLASS, "GoggleLens").Transparency = 0.2
	end
end

function A.Busby(k: Kit)
	k.ellipsoid(Vector3.new(1.4, 2.1, 1.3), rgb(25, 22, 22), k.at(0, k.TOP + 0.95, 0), nil, "Busby")
	k.ellipsoid(Vector3.new(0.25, 0.7, 0.25), rgb(230, 30, 40), k.at(0.55, k.TOP + 1.5, -0.2), nil, "Plume")
	k.ellipsoid(Vector3.new(2.4, 0.1, 0.12), GOLD, k.face(0, k.TOP - 0.3, 0.03), FOIL, "ChinStrap")
end

function A.IceCrown(k: Kit)
	local ice = rgb(180, 235, 255)
	k.cylinder(0.25, 1.5, ice, k.at(0, k.TOP + 0.1, 0), GLASS, "IceCrown").Transparency = 0.15
	for i = 0, 4 do
		local a = i / 5 * TAU - math.pi / 2
		local spike = k.block(Vector3.new(0.2, 0.75 + (if i == 0 then 0.35 else 0), 0.2), ice, k.at(math.cos(a) * 0.62, k.TOP + 0.55, math.sin(a) * 0.62) * CFrame.Angles(0, math.rad(45), 0), GLASS, "IceSpike")
		spike.Transparency = 0.1
		spike.Reflectance = 0.3
	end
end

function A.TrojanHelmet(k: Kit)
	local bronze = rgb(205, 145, 70)
	k.ellipsoid(Vector3.new(1.9, 1.0, 1.7), bronze, k.at(0, k.TOP + 0.15, 0), FOIL, "Helmet")
	k.ellipsoid(Vector3.new(0.35, 0.9, 2.2), rgb(210, 30, 40), k.at(0, k.TOP + 0.85, 0.2), nil, "Crest")
	for _, side in { -1, 1 } do
		k.block(Vector3.new(0.12, 0.9, 0.5), bronze, k.at(side * 1.05, k.TOP - 0.35, -0.55), FOIL, "CheekGuard")
	end
end

function A.SpaceHelmet(k: Kit)
	local bubble = k.ball(5.6, rgb(200, 230, 255), k.at(0, 0.1, 0), nil, "Bubble")
	bubble.Transparency = 0.82
	bubble.Reflectance = 0.25
	for _, piece in torus(k, CFrame.new(0, -2.35, 0) * CFrame.Angles(math.pi / 2, 0, 0), 1.6, 0.35, 8, WHITE, nil, "Collar") do
		piece.Material = Enum.Material.SmoothPlastic
	end
	k.block(Vector3.new(1.6, 1.8, 0.7), WHITE, k.at(0, -0.2, 1.3), nil, "Backpack")
end

function A.BrainDome(k: Kit)
	local dome = k.ellipsoid(Vector3.new(1.9, 1.4, 1.7), rgb(200, 240, 255), k.at(0, k.TOP + 0.35, 0), GLASS, "Dome")
	dome.Transparency = 0.6
	k.ellipsoid(Vector3.new(1.3, 0.9, 1.1), rgb(255, 140, 180), k.at(0, k.TOP + 0.3, 0), nil, "Brain")
	k.ellipsoid(Vector3.new(0.06, 0.85, 1.05), rgb(220, 100, 140), k.at(0, k.TOP + 0.33, 0), nil, "Brain")
	k.ball(0.15, rgb(120, 220, 255), k.at(0.35, k.TOP + 0.65, -0.3), NEON, "Synapse")
end

function A.Headphones(k: Kit)
	local dark = rgb(40, 40, 50)
	local glow = k.Sprinkles[1] or rgb(0, 255, 220)
	torus(k, CFrame.new(0, 0.9, -0.05), 2.25, 0.2, 6, dark, nil, "Headband", math.rad(15), math.rad(165))
	for _, side in { -1, 1 } do
		local cf = k.at(side * 2.3, 0.75, -0.05) * CFrame.Angles(0, side * math.pi / 2, 0)
		disc(k, cf, 0.4, 1.0, dark, nil, "EarCup")
		disc(k, cf * CFrame.new(0, 0, -0.21 * k.s), 0.05, 0.7, glow, NEON, "EarGlow")
	end
end

function A.Beard(k: Kit)
	local color = rgb(240, 240, 245)
	for i, spec in { { 0.95, 1.25, 0.65 }, { 0.35, 1.0, 0.75 }, { -0.25, 0.65, 0.7 } } do
		k.ellipsoid(Vector3.new(spec[2], spec[3], 0.4), color, k.at(0, spec[1], -1.05 - i * 0.03), nil, "Beard")
	end
end

function A.FireBeard(k: Kit)
	local colors = { rgb(255, 200, 60), rgb(255, 130, 30), rgb(255, 70, 20) }
	for i, spec in { { 0.95, 1.25, 0.65 }, { 0.35, 1.0, 0.75 }, { -0.25, 0.65, 0.7 } } do
		local part = k.ellipsoid(Vector3.new(spec[2], spec[3], 0.4), colors[i], k.at(0, spec[1], -1.05 - i * 0.03), NEON, "Beard")
		k.limb(part, "Sway", 0, 0, 1.2, -1.0)
	end
end

function A.FlameHair(k: Kit)
	local base = k.Frosting:Lerp(rgb(255, 120, 20), 0.5)
	for i = -2, 2 do
		local f = k.ellipsoid(Vector3.new(0.38, 1.0 - math.abs(i) * 0.15, 0.38), if math.abs(i) == 1 then rgb(255, 220, 80) else base, k.at(i * 0.32, k.TOP + 0.45, 0.05) * CFrame.Angles(0, 0, -i * 0.25), NEON, "FlameHair")
		f.Transparency = 0.1
		k.limb(f, "Sway", 0, 0, k.TOP, 0)
	end
end

function A.SummitFlag(k: Kit)
	k.ellipsoid(Vector3.new(1.6, 0.45, 1.3), WHITE, k.at(0, k.TOP + 0.05, 0), nil, "SnowCap")
	k.cylinder(2.0, 0.1, rgb(150, 150, 160), k.at(0.4, k.TOP + 1.0, 0), METAL, "FlagPole")
	local flag = k.block(Vector3.new(0.95, 0.6, 0.05), rgb(230, 40, 50), k.at(0.9, k.TOP + 1.65, 0), nil, "Flag")
	k.limb(flag, "Sway", 0, 0.4, k.TOP + 1.65, 0)
	k.ball(0.18, GOLD, k.at(0.4, k.TOP + 2.0, 0), FOIL, "PoleTip")
end

function A.Chimney(k: Kit)
	local brick = rgb(160, 70, 50)
	k.cylinder(1.1, 0.65, brick, k.at(0.55, k.TOP + 0.45, 0.2), nil, "Chimney")
	k.cylinder(0.18, 0.8, brick:Lerp(BLACK, 0.3), k.at(0.55, k.TOP + 1.0, 0.2), nil, "ChimneyCap")
	for i = 0, 1 do
		local puff = k.ball(0.6 + i * 0.25, rgb(90, 80, 80), k.at(0.75 + i * 0.35, k.TOP + 1.5 + i * 0.6, 0.2), nil, "Smoke")
		puff.Transparency = 0.35 + i * 0.2
		k.limb(puff, "Sway", 0, 0.55, k.TOP + 1.0, 0.2)
	end
end

function A.SmokeStack(k: Kit)
	local brass = rgb(210, 160, 70)
	k.cylinder(1.3, 0.5, brass, k.at(-0.55, k.TOP + 0.55, 0.2), FOIL, "SmokeStack")
	k.cylinder(0.15, 0.7, brass:Lerp(BLACK, 0.3), k.at(-0.55, k.TOP + 1.2, 0.2), METAL, "StackRim")
	for i = 0, 1 do
		local puff = k.ball(0.55 + i * 0.25, rgb(230, 230, 235), k.at(-0.75 - i * 0.3, k.TOP + 1.65 + i * 0.55, 0.2), nil, "Steam")
		puff.Transparency = 0.3 + i * 0.25
		k.limb(puff, "Sway", 0, -0.55, k.TOP + 1.2, 0.2)
	end
end

function A.Volcano(k: Kit)
	local rock = rgb(80, 55, 45)
	for i = 0, 2 do
		k.cylinder(0.4, 1.9 - i * 0.5, rock:Lerp(BLACK, i * 0.1), k.at(0, k.TOP + 0.15 + i * 0.38, 0.05), nil, "Volcano")
	end
	k.cylinder(0.1, 0.8, rgb(255, 120, 20), k.at(0, k.TOP + 1.05, 0.05), NEON, "Lava")
	for _, side in { -1, 1 } do
		k.ellipsoid(Vector3.new(0.18, 0.75, 0.15), rgb(255, 100, 20), k.at(side * 0.45, k.TOP + 0.6, -0.55) * CFrame.Angles(0, 0, side * 0.45), NEON, "LavaRun")
	end
	local blob = k.ball(0.35, rgb(255, 160, 40), k.at(0, k.TOP + 1.5, 0.05), NEON, "LavaBlob")
	k.limb(blob, "Sway", 0, 0, k.TOP + 1.0, 0.05)
end

function A.BombFuse(k: Kit)
	k.cylinder(0.3, 0.7, rgb(60, 60, 70), k.at(0, k.TOP + 0.1, 0), METAL, "FuseCap")
	segment(k, Vector3.new(0, k.TOP + 0.2, 0), Vector3.new(0.3, k.TOP + 0.9, -0.1), 0.1, rgb(200, 180, 140), nil, "Fuse")
	local spark = k.ball(0.35, rgb(255, 220, 80), k.at(0.32, k.TOP + 1.0, -0.1), NEON, "Spark")
	k.limb(spark, "Sway", 0, 0.15, k.TOP + 0.5, 0)
end

function A.JellyDome(k: Kit)
	local dome = k.ellipsoid(Vector3.new(2.4, 1.3, 2.1), k.Frosting:Lerp(WHITE, 0.2), k.at(0, k.TOP + 0.25, 0), NEON, "JellyBell")
	dome.Transparency = 0.55
	for i = 0, 3 do
		local a = i / 4 * TAU
		k.ball(0.22, k.Frosting:Lerp(WHITE, 0.5), k.at(math.cos(a) * 0.5, k.TOP + 0.45, math.sin(a) * 0.5), NEON, "JellySpot")
	end
end

function A.Laurel(k: Kit)
	for i = 0, 9 do
		local a = i / 10 * TAU
		k.ellipsoid(Vector3.new(0.45, 0.12, 0.22), GOLD, k.at(math.cos(a) * 0.8, k.TOP + 0.12, math.sin(a) * 0.8) * CFrame.Angles(0, -a, 0.6), FOIL, "Laurel")
	end
end

-- Held things -------------------------------------------------------------------------------------

function A.Katanas(k: Kit)
	-- crossed on its back, the hilts sticking up over the shoulders
	for _, side in { -1, 1 } do
		local cf = k.at(side * 0.9, 1.3, 0.95) * CFrame.Angles(0, 0, side * math.rad(-30))
		k.block(Vector3.new(0.1, 2.6, 0.22), SILVER, cf * CFrame.new(0, -0.5 * k.s, 0), METAL, "Blade").Reflectance = 0.3
		k.block(Vector3.new(0.42, 0.08, 0.42), GOLD, cf * CFrame.new(0, 0.85 * k.s, 0), FOIL, "Guard")
		k.block(Vector3.new(0.17, 0.75, 0.17), BLACK, cf * CFrame.new(0, 1.3 * k.s, 0), nil, "Hilt")
	end
end

function A.Trident(k: Kit)
	local h = hand(k, 1)
	local gold = rgb(255, 190, 50)
	segment(k, h + Vector3.new(0, -1.6, -0.1), h + Vector3.new(0, 1.9, -0.1), 0.14, gold, FOIL, "Trident")
	k.block(Vector3.new(0.9, 0.12, 0.12), gold, k.at(h.X, h.Y + 1.9, h.Z - 0.1), FOIL, "Trident")
	for i = -1, 1 do
		k.wedge(Vector3.new(0.12, 0.6, 0.18), gold, k.at(h.X + i * 0.38, h.Y + 2.25, h.Z - 0.1) * CFrame.Angles(0, math.pi / 2, 0))
	end
end

function A.Spear(k: Kit)
	local h = hand(k, 1)
	segment(k, h + Vector3.new(0, -2.0, -0.1), h + Vector3.new(0, 2.2, -0.1), 0.13, rgb(120, 90, 60), WOOD, "Spear")
	for _, flip in { 0, math.pi } do
		k.wedge(Vector3.new(0.12, 0.7, 0.3), SILVER, k.at(h.X, h.Y + 2.55, h.Z - 0.1) * CFrame.Angles(0, math.pi / 2 + flip, 0))
	end
	k.ball(0.2, GOLD, k.at(h.X, h.Y + 2.2, h.Z - 0.1), FOIL, "SpearRing")
end

function A.Scepter(k: Kit)
	local h = hand(k, -1)
	segment(k, h + Vector3.new(0, -1.2, -0.1), h + Vector3.new(0, 1.5, -0.1), 0.16, GOLD, FOIL, "Scepter")
	k.ball(0.6, k.Frosting:Lerp(WHITE, 0.15), k.at(h.X, h.Y + 1.8, h.Z - 0.1), NEON, "ScepterOrb")
	for i = 0, 2 do
		local a = i / 3 * TAU
		k.block(Vector3.new(0.1, 0.35, 0.1), GOLD, k.at(h.X + math.cos(a) * 0.25, h.Y + 1.55, h.Z - 0.1 + math.sin(a) * 0.25), FOIL, "ScepterClaw")
	end
end

function A.Ankh(k: Kit)
	local h = hand(k, -1)
	segment(k, h + Vector3.new(0, -1.0, -0.1), h + Vector3.new(0, 0.9, -0.1), 0.16, GOLD, FOIL, "Ankh")
	segment(k, h + Vector3.new(-0.45, 0.75, -0.1), h + Vector3.new(0.45, 0.75, -0.1), 0.15, GOLD, FOIL, "Ankh")
	torus(k, CFrame.new(h + Vector3.new(0, 1.3, -0.1)), 0.38, 0.14, 6, GOLD, FOIL, "Ankh")
end

function A.ForgeHammer(k: Kit)
	local h = hand(k, 1)
	segment(k, h + Vector3.new(0, -0.8, -0.1), h + Vector3.new(0, 1.3, -0.1), 0.18, rgb(120, 85, 55), WOOD, "Handle")
	k.block(Vector3.new(1.1, 0.5, 0.5), rgb(80, 80, 90), k.at(h.X, h.Y + 1.45, h.Z - 0.1), METAL, "HammerHead")
	k.block(Vector3.new(0.12, 0.42, 0.42), rgb(255, 120, 30), k.at(h.X - 0.58, h.Y + 1.45, h.Z - 0.1), NEON, "HotFace")
end

function A.Banhammer(k: Kit)
	local h = hand(k, 1)
	segment(k, h + Vector3.new(0, -1.0, -0.1), h + Vector3.new(0, 1.8, -0.1), 0.22, BLACK, nil, "Handle")
	local head = k.block(Vector3.new(1.9, 0.95, 0.95), rgb(220, 30, 40), k.at(h.X, h.Y + 2.1, h.Z - 0.1), nil, "HammerHead")
	head.Reflectance = 0.15
	for _, side in { -1, 1 } do
		k.block(Vector3.new(0.12, 1.0, 1.0), BLACK, k.at(h.X + side * 0.98, h.Y + 2.1, h.Z - 0.1), METAL, "HammerCap")
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(190, 95)
	gui.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = "BAN"
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.TextColor3 = WHITE
	label.Parent = gui
end

function A.Sword(k: Kit)
	local h = hand(k, 1)
	k.block(Vector3.new(0.14, 2.6, 0.3), rgb(255, 240, 200), k.at(h.X, h.Y + 1.7, h.Z - 0.1), NEON, "Blade")
	k.block(Vector3.new(0.75, 0.14, 0.28), GOLD, k.at(h.X, h.Y + 0.35, h.Z - 0.1), FOIL, "Guard")
	k.block(Vector3.new(0.17, 0.6, 0.17), rgb(120, 70, 40), k.at(h.X, h.Y, h.Z - 0.1), nil, "Hilt")
	local flame = k.ellipsoid(Vector3.new(0.4, 2.4, 0.4), rgb(255, 170, 40), k.at(h.X, h.Y + 1.8, h.Z - 0.1), NEON, "Flame")
	flame.Transparency = 0.6
end

function A.LaserSword(k: Kit)
	local h = hand(k, 1)
	k.block(Vector3.new(0.18, 0.7, 0.18), rgb(70, 70, 80), k.at(h.X, h.Y, h.Z - 0.1), METAL, "Hilt")
	local blade = k.cylinder(2.8, 0.22, rgb(255, 50, 50), k.at(h.X, h.Y + 1.75, h.Z - 0.1), NEON, "Laser")
	blade.Transparency = 0.05
	k.cylinder(2.9, 0.4, rgb(255, 120, 120), k.at(h.X, h.Y + 1.75, h.Z - 0.1), NEON, "LaserGlow").Transparency = 0.7
end

function A.LightningBolt(k: Kit)
	local h = hand(k, 1)
	local yellow = rgb(255, 235, 70)
	local points = { h + Vector3.new(0, 0, -0.1), h + Vector3.new(-0.35, 0.8, -0.1), h + Vector3.new(0.25, 1.1, -0.1), h + Vector3.new(-0.15, 2.0, -0.1) }
	for i = 1, 3 do
		segment(k, points[i], points[i + 1], 0.24, yellow, NEON, "Lightning")
	end
end

function A.Broom(k: Kit)
	segment(k, Vector3.new(-2.6, -1.6, 0.9), Vector3.new(2.6, 1.6, 0.9), 0.16, rgb(130, 90, 50), WOOD, "Broom")
	k.ellipsoid(Vector3.new(1.2, 0.7, 0.7), rgb(210, 170, 90), k.at(-2.9, -1.85, 0.9) * CFrame.Angles(0, 0, math.atan2(1.6, 2.6)), nil, "Bristles")
	k.cylinder(0.15, 0.4, rgb(120, 60, 160), k.at(-2.35, -1.45, 0.9) * CFrame.Angles(0, 0, -math.atan2(2.6, 1.6)), nil, "BroomBand")
end

function A.YoYo(k: Kit)
	local h = hand(k, 1)
	local bottom = h + Vector3.new(0.1, -2.0, -0.2)
	segment(k, h, bottom, 0.04, WHITE, nil, "String")
	local cf = CFrame.new(bottom) * CFrame.Angles(0, math.pi / 2, 0)
	for _, x in { -0.13, 0.13 } do
		disc(k, scaled(k, cf * CFrame.new(0, 0, x)), 0.2, 0.75, k.Frosting, nil, "YoYo")
	end
	disc(k, scaled(k, cf), 0.08, 0.3, WHITE, nil, "YoYoAxle")
end

function A.StarWand(k: Kit)
	local h = hand(k, 1)
	segment(k, h + Vector3.new(0, -0.3, -0.1), h + Vector3.new(0, 1.4, -0.1), 0.1, rgb(240, 240, 255), nil, "Wand")
	local tip = k.at(h.X, h.Y + 1.7, h.Z - 0.1)
	sparkle(k, tip, 0.9, rgb(255, 235, 120), "WandStar")
	k.ball(0.25, WHITE, tip, NEON, "WandStar")
end

function A.FairyWand(k: Kit)
	local h = hand(k, 1)
	segment(k, h + Vector3.new(0, -0.3, -0.1), h + Vector3.new(0, 1.4, -0.1), 0.1, rgb(255, 210, 240), nil, "Wand")
	local tip = k.at(h.X, h.Y + 1.7, h.Z - 0.1)
	sparkle(k, tip, 0.9, rgb(255, 160, 230), "WandStar")
	k.ball(0.25, WHITE, tip, NEON, "WandStar")
	for i = 1, 2 do
		k.ball(0.12, rgb(255, 230, 250), k.at(h.X + 0.25 * i, h.Y + 1.7 - 0.35 * i, h.Z - 0.1), NEON, "Sparkle")
	end
end

function A.Harp(k: Kit)
	local h = hand(k, -1)
	local base = h + Vector3.new(0, -0.6, -0.2)
	local gold = rgb(255, 205, 80)
	segment(k, base, base + Vector3.new(0, 1.8, 0), 0.16, gold, FOIL, "Harp")
	segment(k, base, base + Vector3.new(-1.0, 0.3, 0), 0.14, gold, FOIL, "Harp")
	segment(k, base + Vector3.new(-1.0, 0.3, 0), base + Vector3.new(0, 1.8, 0), 0.16, gold, FOIL, "Harp")
	for i = 1, 3 do
		local x = -i * 0.24
		segment(k, base + Vector3.new(x, 0.08 + i * 0.07, 0), base + Vector3.new(x, 1.8 + x * 1.5, 0), 0.03, WHITE, NEON, "String")
	end
end

function A.Shield(k: Kit)
	local h = hand(k, -1)
	local cf = k.at(h.X - 0.3, h.Y - 0.2, h.Z - 0.45) * CFrame.Angles(0, 0.35, 0)
	disc(k, cf, 0.18, 2.0, rgb(200, 60, 50), nil, "Shield")
	disc(k, cf * CFrame.new(0, 0, 0.06 * k.s), 0.2, 2.15, GOLD, FOIL, "ShieldRim")
	k.ball(0.5, GOLD, cf * CFrame.new(0, 0, -0.12 * k.s), FOIL, "ShieldBoss")
end

function A.BrickShield(k: Kit)
	local h = hand(k, -1)
	local cf = k.at(h.X - 0.2, h.Y, h.Z - 0.45) * CFrame.Angles(0, 0.35, 0)
	k.block(Vector3.new(1.4, 1.5, 0.25), rgb(170, 70, 50), cf, nil, "Bricks")
	for i = 0, 1 do
		k.block(Vector3.new(1.42, 0.06, 0.27), rgb(220, 200, 180), cf * CFrame.new(0, (-0.25 + i * 0.5) * k.s, 0), nil, "Mortar")
	end
	for i = -1, 1 do
		local flame = k.ellipsoid(Vector3.new(0.35, 0.8, 0.3), if i == 0 then rgb(255, 220, 70) else rgb(255, 110, 30), cf * CFrame.new(i * 0.4 * k.s, 1.0 * k.s, 0), NEON, "Flame")
		k.limb(flame, "Sway", 0, h.X, h.Y + 0.8, h.Z)
	end
end

function A.Envelope(k: Kit)
	local h = hand(k, -1)
	local cf = k.at(h.X, h.Y + 0.6, h.Z - 0.35)
	k.block(Vector3.new(1.2, 0.8, 0.08), WHITE, cf, nil, "Envelope")
	k.wedge(Vector3.new(0.09, 0.4, 1.2), rgb(235, 235, 240), cf * CFrame.new(0, 0.2 * k.s, -0.04 * k.s) * CFrame.Angles(math.pi / 2, math.pi / 2, 0))
	k.ball(0.22, rgb(220, 30, 40), cf * CFrame.new(0, 0, -0.08 * k.s), nil, "Seal")
end

function A.ShoppingBags(k: Kit)
	for i, side in { -1, 1 } do
		local h = hand(k, side)
		local color = if i == 1 then rgb(255, 90, 170) else rgb(80, 200, 255)
		k.block(Vector3.new(0.9, 1.0, 0.45), color, k.at(h.X, h.Y - 0.85, h.Z), nil, "Bag")
		torus(k, CFrame.new(h + Vector3.new(0, -0.3, 0)), 0.25, 0.06, 3, BLACK, nil, "BagHandle", 0, math.pi)
	end
end

function A.Joystick(k: Kit)
	local cf = k.at(0, k.TOP + 0.15, 0)
	k.block(Vector3.new(1.3, 0.35, 0.9), rgb(30, 30, 40), cf, nil, "ArcadeBase")
	k.cylinder(0.75, 0.12, rgb(160, 160, 170), cf * CFrame.new(-0.25 * k.s, 0.5 * k.s, 0), METAL, "Stick")
	k.ball(0.4, rgb(230, 30, 40), cf * CFrame.new(-0.25 * k.s, 0.9 * k.s, 0), nil, "Knob").Reflectance = 0.2
	for i = 0, 1 do
		k.cylinder(0.12, 0.25, if i == 0 then rgb(255, 220, 40) else rgb(40, 160, 255), cf * CFrame.new((0.25 + i * 0.3) * k.s, 0.2 * k.s, -0.1 * k.s), NEON, "Button")
	end
end

-- Tech --------------------------------------------------------------------------------------------

function A.RoboPlates(k: Kit)
	for i = 0, 2 do
		local angle = math.rad(-150 + i * 60)
		local cf = onDough(k, angle, math.rad(85), 0.02)
		k.block(Vector3.new(0.75, 0.1, 0.8), rgb(160, 165, 175), cf, METAL, "Plate")
		k.ball(0.14, rgb(110, 110, 120), cf * CFrame.new(0.28 * k.s, 0.06 * k.s, 0.28 * k.s), METAL, "Bolt")
	end
end

function A.RoboClaw(k: Kit)
	local h = hand(k, 1)
	for _, glove in k.find("Glove") do
		if glove.Position.X > 0 then
			glove.Color = rgb(150, 155, 165)
			glove.Material = METAL
		end
	end
	local shoulderX, shoulderY = k.R + 0.74, -0.25
	for _, tilt in { 0.4, -0.4 } do
		local prong = k.block(Vector3.new(0.14, 0.6, 0.2), rgb(150, 155, 165), k.at(h.X + 0.1, h.Y + 0.4, h.Z) * CFrame.Angles(0, 0, tilt), METAL, "Claw")
		if k.has("Arms") then
			k.limb(prong, "Arm", 1, shoulderX, shoulderY, -0.1)
		end
	end
end

function A.WindUpKey(k: Kit)
	local brass = rgb(220, 170, 70)
	local center = Vector3.new(0, 0.2, 1.0)
	local shaft = segment(k, center, center + Vector3.new(0, 0, 0.6), 0.18, brass, FOIL, "Key")
	k.limb(shaft, "Roll", 0, center.X, center.Y, center.Z)
	for _, side in { -1, 1 } do
		local lobe = k.ellipsoid(Vector3.new(0.65, 0.45, 0.12), brass, k.at(side * 0.38, 0.2, 1.65), FOIL, "Key")
		k.limb(lobe, "Roll", 0, center.X, center.Y, center.Z)
	end
end

function A.Bolts(k: Kit)
	for i = 0, 2 do
		local cf = onDough(k, math.rad(-140 + i * 50), math.rad(80), 0.05)
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.18, 0.4, 0.4) * k.s
		p.Name = "Nut"
		k.add(p, cf * CFrame.Angles(0, 0, math.pi / 2), rgb(170, 175, 185), METAL)
	end
	segment(k, Vector3.new(1.2, k.TOP - 0.2, 0.1), Vector3.new(1.5, k.TOP + 0.6, 0.1), 0.16, rgb(170, 175, 185), METAL, "Bolt")
	k.cylinder(0.15, 0.4, rgb(150, 155, 165), k.at(1.52, k.TOP + 0.65, 0.1), METAL, "BoltHead")
end

function A.ShoulderCannons(k: Kit)
	for _, side in { -1, 1 } do
		k.block(Vector3.new(0.7, 0.4, 0.8), rgb(70, 72, 80), k.at(side * 1.4, k.TOP - 0.25, 0.2), METAL, "CannonMount")
		local cf = k.at(side * 1.4, k.TOP + 0.1, -0.15) * CFrame.Angles(0, math.pi / 2, 0)
		local barrel = Instance.new("Part")
		barrel.Shape = Enum.PartType.Cylinder
		barrel.Size = Vector3.new(1.3, 0.35, 0.35) * k.s
		barrel.Name = "Cannon"
		k.add(barrel, cf, rgb(90, 92, 100), METAL)
		k.ball(0.22, rgb(255, 160, 40), k.at(side * 1.4, k.TOP + 0.1, -0.82), NEON, "Muzzle")
	end
end

function A.WeldMask(k: Kit)
	local dark = rgb(50, 50, 60)
	k.block(Vector3.new(1.6, 0.9, 0.2), dark, k.at(0, k.TOP + 0.35, -0.35) * CFrame.Angles(math.rad(-55), 0, 0), nil, "WeldMask")
	k.block(Vector3.new(0.8, 0.25, 0.22), rgb(60, 255, 120), k.at(0, k.TOP + 0.4, -0.42) * CFrame.Angles(math.rad(-55), 0, 0), GLASS, "WeldWindow")
	local h = hand(k, 1)
	segment(k, h, h + Vector3.new(0.3, 0.9, -0.3), 0.18, rgb(120, 120, 130), METAL, "Torch")
	k.ball(0.28, rgb(120, 200, 255), k.at(h.X + 0.35, h.Y + 1.05, h.Z - 0.35), NEON, "TorchFlame")
end

function A.CPUChip(k: Kit)
	local cf = k.at(0, k.TOP + 0.1, 0)
	k.block(Vector3.new(1.3, 0.18, 1.3), rgb(25, 30, 35), cf, nil, "Chip")
	k.block(Vector3.new(0.6, 0.2, 0.6), rgb(200, 205, 215), cf * CFrame.new(0, 0.03 * k.s, 0), METAL, "ChipLid")
	for i = -1, 1 do
		for _, side in { -1, 1 } do
			k.block(Vector3.new(0.1, 0.06, 0.32), GOLD, cf * CFrame.new(i * 0.38 * k.s, -0.02 * k.s, side * 0.78 * k.s), FOIL, "Pin")
		end
	end
	k.ball(0.15, rgb(80, 200, 255), cf * CFrame.new(0.45 * k.s, 0.12 * k.s, -0.45 * k.s), NEON, "ChipLight")
end

function A.ServerRack(k: Kit)
	local cf = k.at(-(k.R + 1.6), -0.4, 0.4) * CFrame.Angles(0, math.rad(20), 0)
	k.block(Vector3.new(1.5, 3.0, 1.0), rgb(35, 38, 48), cf, METAL, "Server")
	for i = 0, 3 do
		k.block(Vector3.new(1.15, 0.08, 0.05), if i % 2 == 0 then rgb(60, 255, 120) else rgb(80, 170, 255), cf * CFrame.new(0, (-1.0 + i * 0.65) * k.s, -0.52 * k.s), NEON, "ServerLED")
	end
end

function A.VendingMachine(k: Kit)
	local cf = k.at(k.R + 1.75, -0.6, 0.4) * CFrame.Angles(0, math.rad(-20), 0)
	k.block(Vector3.new(2.0, 2.6, 0.9), rgb(220, 40, 60), cf, nil, "Vending")
	local window = k.block(Vector3.new(1.3, 1.6, 0.05), rgb(200, 240, 255), cf * CFrame.new(-0.2 * k.s, 0.3 * k.s, -0.46 * k.s), GLASS, "VendingWindow")
	window.Transparency = 0.4
	for i = 0, 2 do
		k.block(Vector3.new(0.3, 0.4, 0.2), ({ rgb(255, 220, 40), rgb(80, 200, 255), rgb(120, 255, 120) })[i + 1], cf * CFrame.new((-0.6 + i * 0.4) * k.s, 0.55 * k.s, -0.3 * k.s), nil, "Snack")
	end
	k.block(Vector3.new(0.25, 0.5, 0.06), BLACK, cf * CFrame.new(0.72 * k.s, 0.4 * k.s, -0.46 * k.s), nil, "CoinSlot")
end

function A.ConveyorBelt(k: Kit)
	local y = -k.TOP - 1.45
	k.block(Vector3.new(3.2, 0.25, 1.6), rgb(40, 40, 45), k.at(0, y, -0.1), nil, "Belt")
	for i = 0, 3 do
		local roller = Instance.new("Part")
		roller.Shape = Enum.PartType.Cylinder
		roller.Size = Vector3.new(1.7, 0.4, 0.4) * k.s
		roller.Name = "Roller"
		k.add(roller, k.at(-1.2 + i * 0.8, y - 0.25, -0.1) * CFrame.Angles(0, math.pi / 2, 0), rgb(150, 150, 160), METAL)
	end
	for _, side in { -1, 1 } do
		k.block(Vector3.new(3.2, 0.12, 0.08), rgb(255, 210, 0), k.at(0, y + 0.13, -0.1 + side * 0.8), NEON, "Stripe")
	end
end

function A.Skateboard(k: Kit)
	local y = -k.TOP - 1.45
	k.ellipsoid(Vector3.new(1.3, 0.14, 3.4), rgb(170, 90, 255), k.at(0, y, -0.15), nil, "Deck")
	k.block(Vector3.new(0.9, 0.05, 2.6), rgb(0, 255, 230), k.at(0, y - 0.1, -0.15), NEON, "Underglow")
	for _, z in { -1.1, 0.8 } do
		for _, side in { -1, 1 } do
			local wheel = Instance.new("Part")
			wheel.Shape = Enum.PartType.Cylinder
			wheel.Size = Vector3.new(0.18, 0.35, 0.35) * k.s
			wheel.Name = "Wheel"
			k.add(wheel, k.at(side * 0.45, y - 0.25, z - 0.15), rgb(255, 230, 60))
		end
	end
end

function A.Surfboard(k: Kit)
	local board = k.ellipsoid(Vector3.new(1.3, 4.4, 0.2), rgb(255, 230, 120), k.at(0.4, 0.3, 1.15) * CFrame.Angles(0, 0, -0.25), nil, "Surfboard")
	board.Reflectance = 0.1
	k.ellipsoid(Vector3.new(0.35, 4.2, 0.22), rgb(255, 100, 30), k.at(0.4, 0.3, 1.16) * CFrame.Angles(0, 0, -0.25), nil, "Stripe")
end

function A.PixelBlocks(k: Kit)
	local colors = { rgb(255, 40, 200), rgb(0, 255, 220), rgb(255, 230, 0), rgb(120, 255, 80) }
	for i = 0, 5 do
		local angle = math.rad(-170 + i * 30)
		k.block(Vector3.one * 0.32, colors[i % #colors + 1], onDough(k, angle, math.rad(70 + (i % 2) * 40), 0.1), NEON, "Pixel")
	end
end

function A.GlitchSlices(k: Kit)
	for i = 0, 2 do
		local slice = k.block(Vector3.new(4.6, 0.3, 1.8), if i % 2 == 0 then rgb(255, 0, 200) else rgb(0, 255, 230), k.at(if i % 2 == 0 then 0.35 else -0.35, -1.2 + i * 1.2, 0), NEON, "GlitchSlice")
		slice.Transparency = 0.7
	end
end

function A.BinaryRing(k: Kit)
	local green = rgb(60, 255, 120)
	for i = 0, 7 do
		local a = i / 8 * TAU
		local p = Vector3.new(math.cos(a) * (k.R + 1.6), 0.4 + math.sin(a * 2) * 0.3, math.sin(a) * (k.R + 1.6))
		local bit = if i % 3 == 0 then k.ellipsoid(Vector3.new(0.25, 0.42, 0.08), green, k.at(p.X, p.Y, p.Z) * CFrame.Angles(0, -a, 0), NEON, "Bit")
			else k.block(Vector3.new(0.09, 0.42, 0.09), green, k.at(p.X, p.Y, p.Z), NEON, "Bit")
		k.limb(bit, "Orbit", 0, 0, 0, 0)
	end
end

function A.WifiArcs(k: Kit)
	local green = rgb(120, 255, 160)
	local base = CFrame.new(0, k.TOP + 0.3, 0)
	for i = 1, 3 do
		torus(k, base, 0.4 * i, 0.14, 2 + i, green, NEON, "Wifi", math.rad(45), math.rad(135))
	end
	k.ball(0.25, green, k.at(0, k.TOP + 0.35, 0), NEON, "WifiDot")
end

function A.FiberStrands(k: Kit)
	local colors = { rgb(255, 80, 200), rgb(80, 220, 255), rgb(255, 240, 120), rgb(120, 255, 160), rgb(200, 120, 255) }
	for i = -2, 2 do
		local from = Vector3.new(i * 0.3, k.TOP - 0.1, 0.1)
		local to = Vector3.new(i * 0.75, k.TOP + 1.3 - math.abs(i) * 0.2, 0.1 + math.abs(i) * 0.1)
		local strand = segment(k, from, to, 0.06, WHITE, nil, "Fiber")
		strand.Transparency = 0.3
		local tip = k.ball(0.22, colors[i + 3], k.at(to.X, to.Y, to.Z), NEON, "FiberTip")
		k.limb(strand, "Sway", 0, from.X, from.Y, from.Z)
		k.limb(tip, "Sway", 0, from.X, from.Y, from.Z)
	end
end

function A.AtomOrbits(k: Kit)
	local color = rgb(200, 140, 255)
	for _, tilt in { math.rad(60), math.rad(-60) } do
		local center = CFrame.new(0, 0, 0.3) * CFrame.Angles(0, 0, tilt) * CFrame.Angles(math.rad(75), 0, 0)
		for _, piece in torus(k, center, k.R + 1.4, 0.07, 7, color, NEON, "Orbit") do
			piece.Transparency = 0.3
		end
	end
	local electron = k.ball(0.35, rgb(120, 230, 255), k.at(k.R + 1.4, 0, 0.3), NEON, "Electron")
	k.limb(electron, "Orbit", 0, 0, 0, 0)
end

function A.HoloRing(k: Kit)
	local color = rgb(120, 240, 255)
	local center = CFrame.new(0, 0.2, 0) * CFrame.Angles(math.rad(80), 0, math.rad(15))
	for _, piece in torus(k, center, k.R + 1.4, 0.12, 8, color, NEON, "HoloRing") do
		piece.Transparency = 0.35
		k.limb(piece, "Orbit", 0, 0, 0, 0)
	end
end

function A.NeonTube(k: Kit)
	local color = if #k.Sprinkles > 0 then k.Sprinkles[1] else rgb(0, 255, 200)
	torus(k, CFrame.new(0, 0, 0.45), k.R + 1.05, 0.14, 10, color, NEON, "NeonTube")
end

function A.LoadingRing(k: Kit)
	local center = Vector3.new(0, k.TOP + 1.2, 0)
	local pieces = torus(k, CFrame.new(center), 0.55, 0.16, 7, rgb(0, 255, 220), NEON, "Loading", 0, math.rad(300))
	for i, piece in pieces do
		piece.Transparency = (i - 1) / #pieces * 0.8
		k.limb(piece, "Roll", 0, center.X, center.Y, center.Z)
	end
end

function A.ErrorSign(k: Kit)
	screen(k, k.at(0, k.TOP + 1.0, 0.05), Vector2.new(1.8, 0.9), rgb(60, 60, 70), rgb(30, 30, 40), "404", rgb(255, 60, 60))
end

function A.BlueScreen(k: Kit)
	screen(k, k.at(0, k.TOP + 1.0, 0.05), Vector2.new(1.8, 1.1), rgb(60, 60, 70), rgb(20, 70, 210), ":(", WHITE, Enum.Font.GothamBold)
end

function A.Terminal(k: Kit)
	screen(k, k.at(0, k.TOP + 1.0, 0.05), Vector2.new(1.8, 0.9), rgb(40, 40, 45), rgb(5, 15, 5), "> sudo_", rgb(60, 255, 100), Enum.Font.Code)
end

function A.Billboard(k: Kit)
	for _, side in { -1, 1 } do
		k.block(Vector3.new(0.12, 1.0, 0.12), rgb(80, 80, 90), k.at(side * 0.7, k.TOP + 0.4, 0.2), METAL, "Post")
	end
	screen(k, k.at(0, k.TOP + 1.25, 0.2), Vector2.new(2.4, 0.9), rgb(50, 50, 60), k.Frosting:Lerp(BLACK, 0.55), "DONUTS 24/7", k.Frosting:Lerp(WHITE, 0.5), Enum.Font.LuckiestGuy)
end

function A.SentinelEye(k: Kit)
	local center = Vector3.new(0, k.TOP + 1.1, 0)
	k.ball(0.9, rgb(40, 20, 20), k.at(center.X, center.Y, center.Z), METAL, "Sentinel")
	k.ball(0.55, rgb(255, 40, 30), k.at(center.X, center.Y, center.Z - 0.25), NEON, "SentinelEye")
	for _, piece in torus(k, CFrame.new(center) * CFrame.Angles(math.pi / 2, 0, 0), 0.75, 0.08, 6, rgb(255, 80, 60), NEON, "SentinelRing") do
		k.limb(piece, "Orbit", 0, center.X, center.Y, center.Z)
	end
end

function A.Checkerboard(k: Kit)
	-- MissingDonut: the missing-texture checkerboard
	for i, piece in k.find("Frosting") do
		if i % 2 == 0 and piece:IsA("Part") and (piece :: Part).Shape == Enum.PartType.Cylinder then
			piece.Color = BLACK
		end
	end
	for i, piece in k.find("Dough") do
		piece.Color = if i % 2 == 0 then rgb(255, 0, 220) else BLACK
	end
end

-- Space -------------------------------------------------------------------------------------------

function A.GalaxySwirl(k: Kit)
	-- a little spiral galaxy floating above, facing out and slowly turning
	local center = Vector3.new(0, k.TOP + 1.4, 0)
	local disk = disc(k, k.at(center.X, center.Y, center.Z), 0.05, 2.0, rgb(120, 80, 255), NEON, "Galaxy")
	disk.Transparency = 0.7
	k.ball(0.38, rgb(255, 240, 200), k.at(center.X, center.Y, center.Z - 0.05), NEON, "GalaxyCore")
	for arm = 0, 1 do
		for i = 1, 4 do
			local a = arm * math.pi + i * 0.75
			local r = i * 0.22
			local star = k.ball(0.17 - i * 0.015, if i >= 3 then rgb(150, 200, 255) else rgb(255, 200, 255), k.at(center.X + math.cos(a) * r, center.Y + math.sin(a) * r, center.Z - 0.06), NEON, "GalaxyStar")
			k.limb(star, "Roll", 0, center.X, center.Y, center.Z)
		end
	end
	k.limb(disk, "Roll", 0, center.X, center.Y, center.Z)
end

function A.NovaBurst(k: Kit)
	local center = Vector3.new(0, 0, 0.9)
	for i = 0, 7 do
		local a = i / 8 * TAU
		local ray = k.ellipsoid(Vector3.new(0.3, 1.5 - (i % 2) * 0.5, 0.1), if i % 2 == 0 then rgb(255, 230, 120) else rgb(255, 150, 60), k.at(math.cos(a) * 3.0, math.sin(a) * 3.0, 0.9) * CFrame.Angles(0, 0, a - math.pi / 2), NEON, "NovaRay")
		ray.Transparency = 0.15
		k.limb(ray, "Roll", 0, center.X, center.Y, center.Z)
	end
end

function A.InfinityRing(k: Kit)
	local color = rgb(220, 200, 255)
	for _, side in { -1, 1 } do
		for _, piece in torus(k, CFrame.new(side * 0.55, k.TOP + 1.2, 0), 0.5, 0.14, 6, color, NEON, "Infinity") do
			k.limb(piece, "Orbit", 0, 0, k.TOP + 1.2, 0)
		end
	end
end

function A.NebulaCloud(k: Kit)
	local colors = { rgb(255, 120, 220), rgb(150, 110, 255), rgb(100, 200, 255) }
	for i, color in colors do
		local a = i / 3 * TAU
		local puff = k.ball(1.1, color, k.at(math.cos(a) * 2.9, 0.6 + math.sin(a * 2) * 0.6, math.sin(a) * 2.9), NEON, "Nebula")
		puff.Transparency = 0.6
		k.limb(puff, "Orbit", 0, 0, 0, 0)
	end
end

function A.Prism(k: Kit)
	local center = Vector3.new(0, k.TOP + 1.3, 0)
	for _, flip in { 0, math.pi } do
		local piece = k.wedge(Vector3.new(0.7, 0.8, 0.45), rgb(230, 245, 255), k.at(center.X, center.Y, center.Z) * CFrame.Angles(0, flip, 0) * CFrame.new(0, 0, 0.225 * k.s), GLASS)
		piece.Transparency = 0.25
		piece.Reflectance = 0.3
		k.limb(piece, "Orbit", 0, center.X, center.Y, center.Z)
	end
	local colors = { rgb(255, 70, 70), rgb(255, 230, 60), rgb(70, 220, 255) }
	for i, color in colors do
		local ray = k.block(Vector3.new(1.2, 0.08, 0.08), color, k.at(center.X + 0.9, center.Y - 0.1 - i * 0.1, center.Z) * CFrame.Angles(0, 0, -0.15 * i), NEON, "PrismRay")
		k.limb(ray, "Orbit", 0, center.X, center.Y, center.Z)
	end
end

function A.Moon(k: Kit)
	local center = CFrame.new(-2.7, k.TOP + 0.6, 0.2) * CFrame.Angles(0, 0, 0.5)
	for _, piece in torus(k, center, 0.55, 0.32, 5, rgb(255, 240, 170), NEON, "Moon", math.rad(70), math.rad(290)) do
		k.limb(piece, "Orbit", 0, 0, 0, 0)
	end
end

function A.FallingStars(k: Kit)
	for i = 0, 1 do
		local a = i * math.pi + 0.8
		local cf = k.at(math.cos(a) * 3.0, 1.3 - i * 1.4, math.sin(a) * 3.0)
		for _, part in sparkle(k, cf, 0.9, rgb(255, 235, 140)) do
			k.limb(part, "Orbit", 0, 0, 0, 0)
		end
	end
end

-- The Cosmic Donut: a black hole's horizon spinning round it, tipped forward like Saturn's rings -
-- the dark shadow band inside, the thin white photon ring, the accretion disk of glowing gas
-- (white-hot on one side, through gold and pink to violet on the other, so you can see it turn),
-- bright clumps riding in it, and a faint violet haze outside. Every piece is a "Horizon" limb:
-- the client spins it round the ring's own axis (Axis), Spin radians a second.
function A.CosmicHorizon(k: Kit)
	local tilt = CFrame.Angles(math.rad(-28), 0, math.rad(12))
	local axis = tilt.UpVector
	local radius = k.R + 2.0
	local function spin(part: BasePart)
		k.limb(part, "Horizon", 0, 0, 0, 0)
		part:SetAttribute("Axis", axis)
		part:SetAttribute("Spin", 1.3)
	end
	local hot = { rgb(255, 255, 245), rgb(255, 225, 140), rgb(255, 150, 70), rgb(255, 90, 160), rgb(170, 80, 255), rgb(110, 50, 220) }
	local function heat(t: number): Color3
		-- 0 = the hot side, 0.5 = the far side, back to 0
		local x = math.min(t, 1 - t) * 2 * (#hot - 1)
		local i = math.floor(x)
		return hot[i + 1]:Lerp(hot[math.min(i + 2, #hot)], x - i)
	end
	local function ring(name: string, r: number, count: number, width: number, thick: number, color: (number) -> Color3, transparency: number)
		local length = 2 * math.pi * r / count * 1.08
		for i = 0, count - 1 do
			local t = i / count
			local cf = k.at(0, 0, 0) * tilt * CFrame.Angles(0, t * TAU, 0) * CFrame.new(r * k.s, 0, 0)
			local piece = k.block(Vector3.new(width, thick, length), color(t), cf, NEON, name)
			piece.Transparency = transparency
			spin(piece)
		end
	end
	ring("Horizon", radius - 0.5, 18, 0.32, 0.13, function()
		return rgb(6, 0, 14)
	end, 0)
	ring("PhotonRing", radius - 0.28, 18, 0.09, 0.16, function()
		return rgb(255, 250, 235)
	end, 0)
	ring("Accretion", radius + 0.1, 20, 0.62, 0.1, heat, 0)
	ring("HorizonHaze", radius + 0.72, 16, 0.45, 0.06, function(t)
		return rgb(150, 70, 255):Lerp(rgb(80, 210, 255), 0.5 + 0.5 * math.cos(t * TAU * 2))
	end, 0.5)
	for i = 0, 3 do
		local a = i / 4 * TAU + 0.4
		local cf = k.at(0, 0, 0) * tilt * CFrame.Angles(0, a, 0) * CFrame.new((radius + 0.1) * k.s, 0.12 * k.s, 0)
		spin(k.block(Vector3.one * 0.36, rgb(255, 240, 210), cf * CFrame.Angles(0.6, 0.6, 0), NEON, "HotSpot"))
	end
end

function A.Flower(k: Kit)
	local center = k.at(0.5, k.TOP + 0.55, -0.05)
	local petal = k.Frosting:Lerp(WHITE, 0.3)
	k.ball(0.42, rgb(255, 220, 80), center, NEON, "FlowerHeart")
	for i = 0, 4 do
		local a = i / 5 * TAU
		k.ellipsoid(Vector3.new(0.5, 0.3, 0.12), petal, center * CFrame.Angles(0, 0, a) * CFrame.new(0.38 * k.s, 0, 0.03 * k.s), nil, "Petal")
	end
end

function A.AuroraRibbon(k: Kit)
	for i, color in { rgb(120, 255, 200), rgb(190, 120, 255) } do
		local ribbon = k.ellipsoid(Vector3.new(0.7, 4.4, 0.08), color, k.at((i - 1.5) * 1.6, 0.2, 1.1) * CFrame.Angles(0.15, 0, (i - 1.5) * 0.5), NEON, "AuroraRibbon")
		ribbon.Transparency = 0.45
		k.limb(ribbon, "Cape", 0, 0, 1.5, 0.9)
	end
end

function A.SeraphWings(k: Kit)
	for _, side in { -1, 1 } do
		for f = 0, 1 do
			local wing = k.ellipsoid(Vector3.new(1.9 - f * 0.4, 0.6, 0.16), rgb(255, 250, 225), k.at(side * (k.R + 0.7 + f * 0.2), 2.0 + f * 0.4, 0.75) * CFrame.Angles(0, side * math.rad(-15), side * math.rad(55 + f * 15)), NEON, "Wing")
			k.limb(wing, "Wing", side, side * (k.R - 0.2), 1.4, 0.7)
		end
	end
end

function A.CosmicEye(k: Kit)
	local cf = k.at(0, k.TOP + 1.1, -0.1)
	k.ellipsoid(Vector3.new(1.1, 0.6, 0.35), WHITE, cf, nil, "CosmicEye")
	k.ball(0.42, rgb(170, 90, 255), cf * CFrame.new(0, 0, -0.12 * k.s), NEON, "Iris")
	k.ball(0.2, BLACK, cf * CFrame.new(0, 0, -0.27 * k.s), nil, "Pupil")
end

function A.VoidRing(k: Kit)
	torus(k, CFrame.new(0, 0, 0.6), k.R + 1.25, 0.3, 10, rgb(30, 10, 50), nil, "VoidRing")
	for _, piece in torus(k, CFrame.new(0, 0, 0.62), k.R + 1.25, 0.38, 10, rgb(150, 70, 255), NEON, "VoidGlow") do
		piece.Transparency = 0.75
	end
end

function A.AccretionDisk(k: Kit)
	local center = CFrame.new(0, 0, 0) * CFrame.Angles(math.rad(75), 0, math.rad(-12))
	local colors = { rgb(255, 170, 60), rgb(255, 230, 150), rgb(255, 110, 40) }
	for _, piece in torus(k, center, k.R + 1.5, 0.3, 12, WHITE, NEON, "Accretion", nil, nil, colors) do
		piece.Transparency = 0.2
		k.limb(piece, "Orbit", 0, 0, 0, 0)
	end
end

function A.GravityRings(k: Kit)
	for i, tilt in { math.rad(70), math.rad(110) } do
		local center = CFrame.new(0, 0, 0) * CFrame.Angles(tilt, math.rad(i * 30), 0)
		for _, piece in torus(k, center, k.R + 1.2 + i * 0.35, 0.1, 7, rgb(90, 200, 255), NEON, "GravityRing") do
			piece.Transparency = 0.25
			k.limb(piece, "Orbit", 0, 0, 0, 0)
		end
	end
end

function A.QuasarJets(k: Kit)
	for _, dir in { 1, -1 } do
		local core = k.ellipsoid(Vector3.new(0.45, 3.0, 0.45), rgb(220, 240, 255), k.at(0, dir * (k.TOP + 1.4), 0.4), NEON, "Jet")
		core.Transparency = 0.1
		local glow = k.ellipsoid(Vector3.new(1.0, 3.6, 1.0), rgb(110, 170, 255), k.at(0, dir * (k.TOP + 1.5), 0.4), NEON, "JetGlow")
		glow.Transparency = 0.7
	end
end

function A.Wormhole(k: Kit)
	local center = Vector3.new(0, 0.1, 1.0)
	k.cylinder(0.1, 3.4, rgb(5, 0, 15), k.at(center.X, center.Y, center.Z + 0.1) * CFrame.Angles(math.pi / 2, 0, 0), nil, "WormholeCore")
	for i, spec in { { Radius = 2.3, Color = rgb(170, 90, 255) }, { Radius = 1.8, Color = rgb(90, 160, 255) } } do
		for _, piece in torus(k, CFrame.new(center + Vector3.new(0, 0, i * 0.05)), spec.Radius, 0.22, 8, spec.Color, NEON, "Wormhole") do
			piece.Transparency = 0.15 * i
			k.limb(piece, "Roll", 0, center.X, center.Y, center.Z)
		end
	end
end

function A.Spaghetti(k: Kit)
	-- spaghettified: strands of dough and glaze stretched off towards the black hole
	for i = 0, 4 do
		local y = -1.4 + i * 0.7
		local from = Vector3.new(k.R + 0.3, y * 0.8, 0.1)
		local to = Vector3.new(k.R + 2.6 + (i % 2) * 0.6, y * 1.05, 0.3)
		local strand = segment(k, from, to, 0.18 - (i % 2) * 0.05, if i % 2 == 0 then k.Frosting else k.Dough, nil, "Spaghetti")
		strand.Transparency = 0.1 + (i % 3) * 0.15
	end
end

-- Toys, spooky, time ------------------------------------------------------------------------------

function A.AlarmClock(k: Kit)
	-- the hole is a clock face; bells on top
	local center = Vector3.new(0, 0, -0.25)
	disc(k, k.at(center.X, center.Y, center.Z) * CFrame.Angles(0, math.pi, 0), 0.12, 1.45, rgb(255, 250, 235), nil, "ClockFace")
	for i = 0, 3 do
		local a = i / 4 * TAU
		k.block(Vector3.new(0.06, 0.18, 0.04), BLACK, k.at(math.cos(a) * 0.55, math.sin(a) * 0.55, center.Z - 0.07) * CFrame.Angles(0, 0, a + math.pi / 2), nil, "Tick")
	end
	local hour = k.block(Vector3.new(0.08, 0.38, 0.04), BLACK, k.at(0, 0.17, center.Z - 0.09), nil, "Hand")
	local minute = k.block(Vector3.new(0.06, 0.55, 0.04), rgb(200, 30, 40), k.at(0.24, 0.0, center.Z - 0.1) * CFrame.Angles(0, 0, -math.pi / 2), nil, "Hand")
	k.limb(minute, "Roll", 0, center.X, center.Y, center.Z)
	k.limb(hour, "Roll", 0, center.X, center.Y, center.Z)
	for _, side in { -1, 1 } do
		k.ellipsoid(Vector3.new(0.75, 0.55, 0.75), GOLD, k.at(side * 0.75, k.TOP + 0.25, 0) * CFrame.Angles(0, 0, side * -0.4), FOIL, "Bell")
	end
end

function A.Hourglass(k: Kit)
	local center = Vector3.new(-2.8, 1.2, 0.2)
	local cf = k.at(center.X, center.Y, center.Z)
	for _, dir in { 1, -1 } do
		local bulb = k.ellipsoid(Vector3.new(0.6, 0.65, 0.6), rgb(220, 240, 255), cf * CFrame.new(0, dir * 0.33 * k.s, 0), GLASS, "Hourglass")
		bulb.Transparency = 0.5
		k.cylinder(0.1, 0.8, GOLD, cf * CFrame.new(0, dir * 0.7 * k.s, 0), FOIL, "HourglassCap")
	end
	k.ellipsoid(Vector3.new(0.4, 0.3, 0.4), rgb(255, 210, 120), cf * CFrame.new(0, -0.45 * k.s, 0), NEON, "Sand")
	for _, part in k.find("Hourglass") do
		k.limb(part, "Orbit", 0, 0, 0, 0)
	end
	for _, part in k.find("HourglassCap") do
		k.limb(part, "Orbit", 0, 0, 0, 0)
	end
	for _, part in k.find("Sand") do
		k.limb(part, "Orbit", 0, 0, 0, 0)
	end
end

function A.JackCrank(k: Kit)
	local center = Vector3.new(0, 0.1, 0.95)
	local arm = segment(k, center + Vector3.new(0, 0, 0.3), center + Vector3.new(0.6, 0.0, 0.3), 0.14, rgb(200, 30, 40), nil, "Crank")
	local knob = k.ball(0.3, rgb(255, 220, 40), k.at(center.X + 0.65, center.Y, center.Z + 0.45), nil, "CrankKnob")
	local shaft = segment(k, center, center + Vector3.new(0, 0, 0.32), 0.14, rgb(160, 160, 170), METAL, "Crank")
	for _, part in { arm, knob, shaft } do
		k.limb(part, "Roll", 0, center.X, center.Y, center.Z)
	end
	-- a spring popping out of the top with a little hat
	for i = 0, 3 do
		k.cylinder(0.08, 0.6, rgb(190, 190, 200), k.at(0, k.TOP + 0.15 + i * 0.22, 0), METAL, "Spring")
	end
end

function A.ToyDrum(k: Kit)
	local cf = k.at(0, -k.R - 0.15, -1.15)
	k.cylinder(0.75, 1.3, rgb(220, 40, 50), cf, nil, "Drum")
	for _, dy in { -0.38, 0.38 } do
		k.cylinder(0.1, 1.36, GOLD, cf * CFrame.new(0, dy * k.s, 0), FOIL, "DrumRim")
	end
	for _, side in { -1, 1 } do
		segment(k, Vector3.new(side * 0.25, -k.R + 0.3, -1.15), Vector3.new(side * 0.55, -k.R + 0.95, -1.3), 0.08, rgb(240, 220, 190), WOOD, "Drumstick")
	end
end

function A.Stitches(k: Kit)
	local cf = k.onGlaze(math.rad(-55), 0.1, 0.02)
	k.block(Vector3.new(0.75, 0.6, 0.05), k.Frosting:Lerp(rgb(255, 230, 150), 0.6), cf, Enum.Material.Fabric, "Patch")
	for i = 0, 3 do
		local corner = cf * CFrame.new((if i % 2 == 0 then -0.37 else 0.37) * k.s, (if i < 2 then -0.3 else 0.3) * k.s, -0.03 * k.s)
		k.block(Vector3.new(0.18, 0.04, 0.03), BLACK, corner * CFrame.Angles(0, 0, math.rad(45)), nil, "Stitch")
	end
	k.cylinder(0.08, 0.32, rgb(60, 40, 30), k.onGlaze(math.rad(-120), 0.2, 0.02) * CFrame.Angles(math.pi / 2, 0, 0), nil, "Button")
end

function A.GhostTail(k: Kit)
	local white = k.Frosting:Lerp(WHITE, 0.5)
	for i = -1, 1 do
		local wisp = k.ellipsoid(Vector3.new(1.1, 1.8 - math.abs(i) * 0.4, 0.9), white, k.at(i * 0.95, -k.TOP - 0.3 + math.abs(i) * 0.25, 0.1), nil, "GhostTail")
		wisp.Transparency = 0.25
		k.limb(wisp, "Tentacle", if i < 0 then -1 else 1, i * 0.9, -k.R, 0)
	end
end

function A.VampireCollar(k: Kit)
	for _, side in { -1, 1 } do
		k.wedge(Vector3.new(0.12, 1.5, 1.0), rgb(30, 10, 15), k.at(side * 1.15, k.TOP - 0.1, 0.55) * CFrame.Angles(0, side * 0.6, side * 0.35))
		k.wedge(Vector3.new(0.13, 1.3, 0.85), rgb(170, 20, 35), k.at(side * 1.1, k.TOP - 0.15, 0.48) * CFrame.Angles(0, side * 0.6, side * 0.35))
	end
end

function A.Ribcage(k: Kit)
	-- crossed bones on the glaze
	local bone = rgb(245, 240, 225)
	for _, tilt in { 0.6, -0.6 } do
		local cf = k.onGlaze(-math.pi / 2, 0.05, 0.08) * CFrame.Angles(0, 0, tilt)
		k.block(Vector3.new(1.3, 0.16, 0.12), bone, cf, nil, "Bone")
		for _, x in { -0.68, 0.68 } do
			for _, y in { -0.08, 0.08 } do
				k.ball(0.18, bone, cf * CFrame.new(x * k.s, y * k.s, 0), nil, "BoneEnd")
			end
		end
	end
end

function A.RainCloud(k: Kit)
	local center = Vector3.new(0, k.TOP + 1.4, 0)
	for i = -1, 1 do
		k.ball(0.8 - math.abs(i) * 0.15, rgb(235, 240, 255), k.at(center.X + i * 0.5, center.Y + (1 - math.abs(i)) * 0.15, center.Z), nil, "Cloud")
	end
	for i = -1, 1 do
		k.ellipsoid(Vector3.new(0.12, 0.28, 0.12), rgb(90, 170, 255), k.at(center.X + i * 0.45, center.Y - 0.6 - (i % 2) * 0.2, center.Z), GLASS, "Raindrop")
	end
end

function A.CloudPuffs(k: Kit)
	puffs(k, 5, WHITE, 0)
end

function A.RainbowArc(k: Kit)
	local colors = { rgb(255, 60, 60), rgb(255, 150, 40), rgb(255, 230, 60), rgb(80, 220, 100), rgb(60, 150, 255), rgb(130, 80, 255), rgb(200, 90, 255) }
	torus(k, CFrame.new(0, 0.3, 0.75), k.R + 1.3, 0.38, 7, WHITE, NEON, "Rainbow", math.rad(5), math.rad(175), colors)
	for _, side in { -1, 1 } do
		k.ball(0.75, WHITE, k.at(side * (k.R + 1.3), 0.25, 0.75), nil, "Cloud")
	end
end

-- Treasure & fire ---------------------------------------------------------------------------------

function A.TreasureCoins(k: Kit)
	for i = 0, 4 do
		local a = i / 5 * TAU
		local coin = disc(k, k.at(math.cos(a) * 2.9, 0.4 + math.sin(a * 3) * 0.5, math.sin(a) * 2.9) * CFrame.Angles(0, -a, 0), 0.08, 0.55, GOLD, FOIL, "Coin")
		k.limb(coin, "Orbit", 0, 0, 0, 0)
	end
end

function A.Gems(k: Kit)
	local colors = { rgb(255, 40, 80), rgb(60, 220, 120), rgb(70, 140, 255) }
	for i, color in colors do
		local cf = k.onGlaze(math.rad(-150 + i * 40), 0.2, 0.08) * CFrame.Angles(0, 0, math.rad(45))
		k.block(Vector3.new(0.3, 0.3, 0.2), color, cf, GLASS, "Gem").Reflectance = 0.4
	end
end

function A.LavaDrips(k: Kit)
	for i = 0, 2 do
		local angle = math.rad(-150 + i * 55)
		local radial = Vector3.new(math.cos(angle), math.sin(angle), 0)
		local p = radial * (k.R + 0.6)
		k.ellipsoid(Vector3.new(0.3, 0.9 + (i % 2) * 0.4, 0.28), rgb(255, 110, 20), k.at(p.X, p.Y - 0.25, -0.3), NEON, "LavaDrip")
		k.ball(0.18, rgb(255, 180, 60), k.at(p.X, p.Y - 0.85 - (i % 2) * 0.3, -0.3), NEON, "LavaDrop")
	end
end

function A.LavaCracks(k: Kit)
	lavaCracks(k, 5, rgb(255, 150, 30))
end

function A.LavaBubbles(k: Kit)
	for _ = 1, 4 do
		local bubble = k.ball(k.Rng:NextNumber(0.2, 0.38), rgb(255, 170, 60), k.onGlaze(glazeAngle(k), k.Rng:NextNumber(-0.6, 0.7), 0.06), GLASS, "Bubble")
		bubble.Transparency = 0.25
		bubble.Reflectance = 0.3
	end
end

function A.CharcoalChunks(k: Kit)
	for i = 1, 4 do
		local cf = k.onGlaze(glazeAngle(k), k.Rng:NextNumber(-0.6, 0.6), 0.05) * CFrame.Angles(k.Rng:NextNumber(0, 3), k.Rng:NextNumber(0, 3), 0)
		k.block(Vector3.new(0.32, 0.26, 0.3), rgb(40, 36, 36), cf, nil, "Charcoal")
		if i <= 2 then
			k.ball(0.12, rgb(255, 120, 30), cf * CFrame.new(0.12 * k.s, 0.1 * k.s, 0), NEON, "Ember")
		end
	end
end

function A.ObsidianShards(k: Kit)
	for i = 0, 3 do
		local cf = onDough(k, math.rad(-160 + i * 45), math.rad(95), 0.25) * CFrame.Angles(0, math.rad(45), k.Rng:NextNumber(-0.4, 0.4))
		local shard = k.block(Vector3.new(0.3, 0.9 - (i % 2) * 0.3, 0.3), rgb(25, 18, 38), cf, GLASS, "Obsidian")
		shard.Reflectance = 0.45
	end
end

function A.BasaltPlates(k: Kit)
	for i = 0, 2 do
		local cf = onDough(k, math.rad(-140 + i * 50), math.rad(85), 0.03)
		local plate = Instance.new("Part")
		plate.Shape = Enum.PartType.Cylinder
		plate.Size = Vector3.new(0.14, 0.75, 0.75) * k.s
		plate.Name = "Basalt"
		k.add(plate, cf * CFrame.Angles(0, 0, math.pi / 2), rgb(60, 55, 58), Enum.Material.Basalt)
	end
	lavaCracks(k, 2, rgb(255, 110, 20))
end

function A.MagmaCore(k: Kit)
	k.ball(1.0, rgb(255, 150, 40), k.at(0, 0, 0), NEON, "MagmaCore")
	k.ball(1.35, rgb(255, 90, 20), k.at(0, 0, 0), NEON, "MagmaGlow").Transparency = 0.6
end

function A.LavaWave(k: Kit)
	local center = Vector3.new(0, 0.6, 1.2)
	local pieces = torus(k, CFrame.new(center) * CFrame.Angles(0, 0, math.rad(-20)), 2.6, 0.55, 5, rgb(255, 120, 30), NEON, "LavaWave", math.rad(10), math.rad(170), { rgb(255, 90, 20), rgb(255, 150, 40), rgb(255, 210, 80) })
	for _, piece in pieces do
		k.limb(piece, "Cape", 0, 0, 0.6, 1.0)
	end
	k.ball(0.6, rgb(255, 220, 120), k.at(-2.4, 1.6, 1.2), NEON, "Foam")
end

function A.Bombs(k: Kit)
	for _, side in { -1, 1 } do
		k.ellipsoid(Vector3.new(0.45, 0.45, 0.95), rgb(50, 55, 50), k.at(side * 1.4, -0.45, 0.45), METAL, "Bomb")
		k.wedge(Vector3.new(0.08, 0.3, 0.3), rgb(200, 40, 40), k.at(side * 1.4, -0.25, 0.95))
	end
end

function A.Hook(k: Kit)
	local h = hand(k, 1)
	for _, glove in k.find("Glove") do
		if glove.Position.X > 0 then
			glove.Color = rgb(60, 45, 35)
		end
	end
	local base = h + Vector3.new(0, 0.3, 0)
	local pieces = { segment(k, h, base, 0.12, SILVER, METAL, "Hook") }
	for _, piece in torus(k, CFrame.new(base + Vector3.new(0.25, 0.2, 0)), 0.3, 0.1, 4, SILVER, METAL, "Hook", math.rad(180), math.rad(360)) do
		table.insert(pieces, piece)
	end
	if k.has("Arms") then
		for _, piece in pieces do
			k.limb(piece, "Arm", 1, k.R + 0.74, -0.25, -0.1)
		end
	end
end

function A.Snowflakes(k: Kit)
	for i = 0, 1 do
		local a = i * math.pi + 0.3
		local cf = k.at(math.cos(a) * 2.9, 1.0 - i * 1.2, math.sin(a) * 2.9)
		for j = 0, 2 do
			local arm = k.block(Vector3.new(0.06, 0.6, 0.06), WHITE, cf * CFrame.Angles(0, 0, j * math.pi / 3), NEON, "Snowflake")
			k.limb(arm, "Orbit", 0, 0, 0, 0)
		end
	end
end

function A.BananaPeel(k: Kit)
	local yellow = rgb(255, 225, 70)
	-- the donut sits in a half-peeled banana: four peel petals cupping its lower half
	for i = 0, 3 do
		local a = i / 4 * TAU + math.pi / 4
		local peel = k.ellipsoid(Vector3.new(1.3, 2.6, 0.2), yellow, k.at(math.cos(a) * 2.1, -1.1, math.sin(a) * 1.45) * CFrame.Angles(0, -a + math.pi / 2, 0) * CFrame.Angles(math.rad(-18), 0, 0), nil, "Peel")
		peel.Reflectance = 0.05
	end
	k.ellipsoid(Vector3.new(0.4, 0.45, 0.4), rgb(110, 80, 40), k.at(0, -2.35, 0.9), nil, "PeelTip")
end

function A.Cactus(k: Kit)
	local green = rgb(80, 170, 80)
	k.cylinder(1.1, 0.5, green, k.at(-0.6, k.TOP + 0.45, 0.1), nil, "Cactus")
	k.ball(0.5, green, k.at(-0.6, k.TOP + 1.0, 0.1), nil, "Cactus")
	k.cylinder(0.45, 0.28, green, k.at(-1.0, k.TOP + 0.7, 0.1), nil, "Cactus")
	k.block(Vector3.new(0.35, 0.22, 0.22), green, k.at(-0.85, k.TOP + 0.5, 0.1), nil, "Cactus")
	k.ball(0.28, rgb(255, 120, 190), k.at(-0.6, k.TOP + 1.25, 0.1), nil, "CactusFlower")
end

function A.BalletSlippers(k: Kit)
	for _, name in { "Shoe", "Sole" } do
		for _, part in k.find(name) do
			part.Color = if name == "Shoe" then rgb(255, 170, 210) else rgb(255, 210, 230)
		end
	end
	for _, side in { -1, 1 } do
		for _, tilt in { 0.5, -0.5 } do
			local ribbon = k.block(Vector3.new(0.05, 0.45, 0.05), rgb(255, 150, 200), k.at(side * 0.55, -k.TOP - 0.65, -0.19) * CFrame.Angles(0, 0, tilt), nil, "Ribbon")
			k.limb(ribbon, "Leg", side, side * 0.55, -k.TOP + 0.2, 0)
		end
	end
end

function A.Icicles(k: Kit)
	-- a fringe of icicles all along the bottom, with frost on the rim
	for i = 0, 5 do
		local angle = math.rad(-165 + i * 30)
		local radial = Vector3.new(math.cos(angle), math.sin(angle), 0)
		local p = radial * (k.R + 0.45)
		local length = 0.55 + ((i * 7) % 3) * 0.2
		local icicle = k.ellipsoid(Vector3.new(0.2, length, 0.2), rgb(200, 240, 255), k.at(p.X, p.Y - length * 0.45, -0.45), GLASS, "Icicle")
		icicle.Transparency = 0.15
		icicle.Reflectance = 0.25
	end
end

function A.CrystalCluster(k: Kit)
	local color = k.Frosting:Lerp(WHITE, 0.25)
	for i = 0, 3 do
		local angle = math.rad(25 + i * 42)
		local cf = onDough(k, angle, math.rad(100), 0.25) * CFrame.Angles(0, math.rad(45), (i - 1.5) * 0.25)
		local shard = k.block(Vector3.new(0.32, 1.0 - (i % 2) * 0.3, 0.32), color, cf, GLASS, "Crystal")
		shard.Transparency = 0.2
		shard.Reflectance = 0.35
	end
end

function A.PufferSpikes(k: Kit)
	local color = k.Frosting:Lerp(rgb(255, 230, 150), 0.4)
	for i = 0, 7 do
		local angle = (i + 0.5) / 8 * TAU
		if math.abs(angle - math.pi / 2) > 0.5 then
			local cf = onDough(k, angle, math.rad(95), 0.1)
			k.wedge(Vector3.new(0.14, 0.45, 0.35), color, cf)
		end
	end
end

function A.SoulWisps(k: Kit)
	for i = 0, 2 do
		local a = i / 3 * TAU + 0.4
		local wisp = k.ellipsoid(Vector3.new(0.45, 0.7, 0.45), rgb(110, 230, 255), k.at(math.cos(a) * 2.9, 0.8 + math.sin(a * 2) * 0.5, math.sin(a) * 2.9), NEON, "Wisp")
		wisp.Transparency = 0.3
		k.limb(wisp, "Orbit", 0, 0, 0, 0)
		local tail = k.ellipsoid(Vector3.new(0.25, 0.6, 0.25), rgb(180, 245, 255), k.at(math.cos(a) * 2.9, 0.35 + math.sin(a * 2) * 0.5, math.sin(a) * 2.9), NEON, "Wisp")
		tail.Transparency = 0.6
		k.limb(tail, "Orbit", 0, 0, 0, 0)
	end
end

---------------------------------------------------------------------------------------------------

function DonutExtras.Has(name: string): boolean
	return A[name] ~= nil
end

function DonutExtras.Build(k: Kit, name: string): boolean
	local builder = A[name]
	if not builder then
		return false
	end
	builder(k)
	return true
end

return DonutExtras
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">DonutLayers</string>
          <string name="Source"><![CDATA[--[[
	DonutLayers
	===========
	The layers DonutModel puts on top of a donut's glaze, from its look (DonutLooks):

	  * Drips: tongues of glaze with a drop at the end, hanging over the outer edge ("Drippy"), or
	    running down from the edge of a half-dipped donut's glaze ("HalfDip").
	  * Shine: light dashes on the raised glaze, beside the soft gloss.
	  * Markings from the name: drizzle, stripes, spots, lightning bolts, flames, runes, hearts,
	    scales, swirls or stars. On Legendary and up they glow.
	  * Trims on the rarer donuts: a string of beads round the glaze (Epic: pearls, Legendary: gold,
	    Celestial and up: glowing in the rarity's colour) and a gem on the front (Legendary and up).
	  * A champion's belt on the strongest donuts (Maximus, Supremus, Odin, Zeus...).

	Built with DonutModel's Kit (DonutExtras.Kit): unscaled numbers in the donut's own space,
	-Z = front, the ring in the XY plane. Drips are named "Frosting" so the client's colour effects
	(rainbow, galaxy) paint them with the rest of the glaze.
]]

local DonutExtras = require(script.Parent.DonutExtras)
local DonutLooks = require(script.Parent.DonutLooks)

type Kit = DonutExtras.Kit
type Look = DonutLooks.Look

export type Info = {
	Accent: Color3, -- the second colour (drizzle, markings)
	Crown: Color3, -- the raised middle of the glaze
	Material: Enum.Material, -- the glaze's material
	ShoulderFront: number, -- how far in front the glaze's two layers stand (-Z)
	CrownFront: number,
	HalfDip: number, -- sin(angle) where a half-dipped donut's glaze ends
	Square: boolean, -- a square brick donut (DonutModel makes its drips itself, cell by cell)
	Glow: Color3, -- the rarity's (or mutation's) colour
	NoEffects: boolean,
	NoFace: boolean,
}

local DonutLayers = {}

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)
local BLACK = Color3.new(0, 0, 0)
local NEON = Enum.Material.Neon
local TAU = math.pi * 2
local FACE = math.pi / 2 -- the face is at the top of the ring

local function awayFromFace(angle: number, margin: number): boolean
	local d = math.abs(((angle - FACE + math.pi) % TAU) - math.pi)
	return d > margin
end

-- A drip of glaze hanging from (x, yTop): a tongue `length` long and a drop at its end.
local function drip(k: Kit, info: Info, x: number, yTop: number, length: number, width: number, z: number, color: Color3): (BasePart, BasePart)
	local tongue = k.block(Vector3.new(width, length, 0.22), color, k.at(x, yTop - length / 2, z), info.Material, "Frosting")
	local bead = k.ball(width * 1.35, color, k.at(x, yTop - length - width * 0.3, z), info.Material, "Frosting")
	tongue.Reflectance = 0.15
	bead.Reflectance = 0.15
	return tongue, bead
end

local function drips(k: Kit, look: Look, info: Info)
	local color = k.Frosting
	local z = info.ShoulderFront - 0.06
	local outer = k.R + k.FROST_R - 0.06
	if look.Glaze == "HalfDip" then
		-- running down from where the glaze stops, on both sides
		local stop = math.asin(info.HalfDip)
		for _, base in { stop - 0.2, math.pi - stop + 0.2 } do
			for i, r in { 1.15, 1.85 } do
				local length = if i == 1 then k.Rng:NextNumber(0.5, 0.75) else k.Rng:NextNumber(0.25, 0.4)
				drip(k, info, r * math.cos(base), r * math.sin(base) + 0.06, length, 0.24, z, color)
			end
		end
		return
	end
	-- hanging off the bottom edge (shorter beside the legs)
	for _, degrees in { 205, 232, 308, 335 } do
		local angle = math.rad(degrees + k.Rng:NextNumber(-4, 4))
		local x, y = outer * math.cos(angle), outer * math.sin(angle)
		local length = k.Rng:NextNumber(0.45, 0.95)
		if math.abs(x) > 0.25 and math.abs(x) < 0.9 and y < -1.5 then
			length = math.min(length, 0.5) -- (beside a leg)
		end
		drip(k, info, x, y + 0.08, length, 0.24, z, color)
	end
end

-- Light dashes on the raised glaze: the glossy highlight.
local function shine(k: Kit, look: Look, info: Info)
	local light = info.Crown:Lerp(WHITE, 0.6)
	for i, degrees in { 160, 176, 189 } do
		if look.Glaze == "HalfDip" and math.sin(math.rad(degrees)) < info.HalfDip + 0.1 then
			continue
		end
		local angle = math.rad(degrees)
		local cf = k.onGlaze(angle, -0.18, 0.01) * CFrame.Angles(0, 0, if info.Square then math.pi / 2 else angle + math.pi / 2)
		k.block(Vector3.new(if i == 2 then 0.42 else 0.2, 0.1, 0.04), light, cf, nil, "Shine")
	end
end

-- Spots on the glaze for a pattern (away from the face, on the glaze of a half-dipped donut).
local function spots(k: Kit, look: Look, info: Info, count: number, from: number, to: number): { number }
	local list = {}
	for i = 0, count - 1 do
		local angle = math.rad(from + (to - from) * (i + 0.5) / count + k.Rng:NextNumber(-5, 5))
		if awayFromFace(angle, 0.8) and (look.Glaze ~= "HalfDip" or math.sin(angle) > info.HalfDip + 0.15) then
			table.insert(list, angle)
		end
	end
	return list
end

local Markings: { [string]: (k: Kit, look: Look, info: Info, color: Color3, material: Enum.Material?) -> () } = {}

function Markings.Drizzle(k, look, info, color, material)
	for i, angle in spots(k, look, info, 14, -170, 170) do
		local cf = k.onGlaze(angle, 0, 0.012) * CFrame.Angles(0, 0, angle + (if i % 2 == 0 then 0.6 else -0.6))
		k.block(Vector3.new(0.82, 0.07, 0.04), color, cf, material, "Drizzle")
	end
end

function Markings.Stripes(k, look, info, color, material)
	local dark = if material then color else k.Frosting:Lerp(BLACK, 0.6)
	for i, angle in spots(k, look, info, 12, -165, 165) do
		local cf = k.onGlaze(angle, (if i % 2 == 0 then 0.25 else -0.25), 0.012) * CFrame.Angles(0, 0, angle + 0.2)
		k.block(Vector3.new(if i % 2 == 0 then 0.7 else 0.5, 0.12, 0.04), dark, cf, material, "Stripe")
	end
end

function Markings.Spots(k, look, info, color, material)
	local spot = if material then color elseif (k.Frosting.R + k.Frosting.G + k.Frosting.B) > 1.8 then rgb(45, 35, 35) else WHITE
	for i, angle in spots(k, look, info, 8, -165, 165) do
		local cf = k.onGlaze(angle, k.Rng:NextNumber(-0.6, 0.6), 0.012) * CFrame.Angles(0, 0, k.Rng:NextNumber(0, TAU))
		local size = if i % 3 == 0 then 0.42 else 0.3
		k.block(Vector3.new(size, size * 0.8, 0.04), spot, cf, material, "Spot")
	end
end

function Markings.Bolts(k, look, info, _color, material)
	local yellow = rgb(255, 230, 60)
	for _, angle in spots(k, look, info, 4, -160, 160) do
		local base = k.onGlaze(angle, 0, 0.015) * CFrame.Angles(0, 0, angle)
		-- a zigzag: three short strokes across the glaze
		for j, step in { { -0.2, 0.5 }, { 0, -0.5 }, { 0.2, 0.5 } } do
			local cf = base * CFrame.new(step[1] * k.s, (j - 2) * 0.05 * k.s, 0) * CFrame.Angles(0, 0, step[2])
			k.block(Vector3.new(0.26, 0.08, 0.04), yellow, cf, material or NEON, "Bolt")
		end
	end
end

function Markings.Flames(k, look, info, _color, material)
	for _, angle in spots(k, look, info, 5, -150, -30) do
		-- licking up from the bottom edge towards the hole
		local radial = Vector3.new(math.cos(angle), math.sin(angle), 0)
		local function at(r: number): CFrame
			local p = radial * r
			return k.face(p.X, p.Y, 0.012) * CFrame.Angles(0, 0, angle + math.pi / 2)
		end
		k.block(Vector3.new(0.3, 0.38, 0.04), rgb(255, 110, 30), at(k.R + 0.18), material, "Flame")
		k.block(Vector3.new(0.15, 0.34, 0.045), rgb(255, 220, 80), at(k.R - 0.14) * CFrame.Angles(0, 0, k.Rng:NextNumber(-0.3, 0.3)), material, "Flame")
	end
end

function Markings.Runes(k, look, info, color, material)
	local glow = if material then rgb(120, 230, 255) else color
	for _, angle in spots(k, look, info, 4, -160, 160) do
		local base = k.onGlaze(angle, 0, 0.012) * CFrame.Angles(0, 0, angle)
		-- a stem and two strokes off it, like an old rune
		k.block(Vector3.new(0.5, 0.06, 0.04), glow, base, material, "Rune")
		k.block(Vector3.new(0.26, 0.06, 0.04), glow, base * CFrame.new(0.06 * k.s, 0.1 * k.s, 0) * CFrame.Angles(0, 0, 0.7), material, "Rune")
		k.block(Vector3.new(0.26, 0.06, 0.04), glow, base * CFrame.new(-0.1 * k.s, 0.1 * k.s, 0) * CFrame.Angles(0, 0, 0.7), material, "Rune")
	end
end

local function heart(k: Kit, cf: CFrame, size: number, color: Color3, material: Enum.Material?, name: string)
	local lobe = size * 0.42
	for _, side in { -1, 1 } do
		k.block(Vector3.new(lobe, lobe, 0.04), color, cf * CFrame.new(side * size * 0.2 * k.s, size * 0.16 * k.s, 0) * CFrame.Angles(0, 0, math.rad(45)), material, name)
	end
	k.block(Vector3.new(size * 0.52, size * 0.52, 0.04), color, cf * CFrame.new(0, -size * 0.1 * k.s, 0) * CFrame.Angles(0, 0, math.rad(45)), material, name)
end

function Markings.Hearts(k, look, info, _color, material)
	for i, angle in spots(k, look, info, 5, -160, 160) do
		heart(k, k.onGlaze(angle, k.Rng:NextNumber(-0.4, 0.4), 0.012), 0.36, if i % 2 == 0 then rgb(255, 80, 130) else rgb(255, 160, 200), material, "Heart")
	end
end

function Markings.Scales(k, look, _info, _color, material)
	-- overlapping plates down the outer sides of the dough, like a dragon's
	local plate = k.Frosting:Lerp(BLACK, 0.25)
	local half = k.BALL / 2
	for i = 0, 6 do
		local angle = math.rad(200 + i * 23.3)
		local radial = Vector3.new(math.cos(angle), math.sin(angle), 0)
		local tangent = Vector3.new(-radial.Y, radial.X, 0)
		for row, zz in { -0.35, 0.15 } do
			local point = radial * (k.R + half + 0.03) + Vector3.new(0, 0, zz)
			local cf = CFrame.fromMatrix(point * k.s, tangent, radial, -Vector3.zAxis) * CFrame.Angles(math.rad(-18), 0, 0)
			k.block(Vector3.new(0.42, 0.08, 0.44), if (i + row) % 2 == 0 then plate else plate:Lerp(WHITE, 0.15), cf, material, "Scale")
		end
	end
	local _ = look
end

function Markings.Swirls(k, look, info, color, material)
	for _, angle in spots(k, look, info, 3, -150, 150) do
		local center = k.onGlaze(angle, 0, 0.014)
		-- a curl: an arc winding in to a dot
		local points = {}
		for j = 0, 4 do
			local t = j / 4 * math.pi * 1.6
			local r = 0.32 - j * 0.06
			table.insert(points, Vector3.new(math.cos(t + angle) * r, math.sin(t + angle) * r, 0))
		end
		for j = 1, #points - 1 do
			local a, b = points[j], points[j + 1]
			local along = b - a
			local cf = center * CFrame.new((a + b) / 2 * k.s) * CFrame.Angles(0, 0, math.atan2(along.Y, along.X))
			k.block(Vector3.new(along.Magnitude + 0.06, 0.07, 0.04), color, cf, material, "Swirl")
		end
		k.ball(0.12, color, center * CFrame.new(points[#points] * k.s), material, "Swirl")
	end
end

function Markings.Stars(k, look, info, _color, material)
	for i, angle in spots(k, look, info, 5, -160, 160) do
		local cf = k.onGlaze(angle, k.Rng:NextNumber(-0.4, 0.4), 0.012) * CFrame.Angles(0, 0, math.rad(45 * (i % 2)))
		local color = if i % 2 == 0 then rgb(255, 235, 120) else WHITE
		k.block(Vector3.new(0.07, 0.34, 0.04), color, cf, material or NEON, "Star")
		k.block(Vector3.new(0.34, 0.07, 0.04), color, cf, material or NEON, "Star")
	end
end

-- A string of beads round the outside of the glaze (Epic and up).
local function beads(k: Kit, info: Info)
	local order = k.RarityOrder
	local color, material = rgb(245, 240, 235), Enum.Material.SmoothPlastic -- pearls
	if order >= 6 then
		color, material = info.Glow:Lerp(WHITE, 0.35), NEON
	elseif order >= 5 then
		color, material = rgb(255, 200, 60), Enum.Material.Foil
	end
	local radius = k.R + k.FROST_R - 0.04
	for i = 0, 11 do
		local angle = math.rad(15 + i * 30)
		if awayFromFace(angle, math.rad(35)) then
			-- (square: along the glaze's outer cells)
			local cf = if info.Square then k.onGlaze(angle, 1.25, 0.05) else k.at(math.cos(angle) * radius, math.sin(angle) * radius, info.ShoulderFront - 0.05)
			local bead = k.ball(0.18, color, cf, material, "Bead")
			bead.Reflectance = 0.25
		end
	end
end

-- A big gem set in gold on the front (Legendary and up).
local function gem(k: Kit, info: Info)
	local cf = k.onGlaze(-math.pi / 2, 0, 0.03) * CFrame.Angles(0, 0, math.rad(45))
	k.block(Vector3.new(0.44, 0.44, 0.06), rgb(255, 200, 60), cf, Enum.Material.Foil, "GemSetting")
	k.block(Vector3.new(0.3, 0.3, 0.1), info.Glow:Lerp(WHITE, 0.15), cf * CFrame.new(0, 0, -0.03 * k.s), NEON, "Gem")
end

-- A champion's belt across the bottom of the ring: red straps, a gold plate and a gem.
local function belt(k: Kit, info: Info)
	for _, degrees in { 238, 302 } do
		local angle = math.rad(degrees)
		k.block(Vector3.new(0.86, 0.62, 0.05), rgb(200, 30, 40), k.onGlaze(angle, 0, 0.012) * CFrame.Angles(0, 0, angle + math.pi / 2), nil, "Belt")
	end
	local plate = k.onGlaze(-math.pi / 2, 0, 0.03)
	k.block(Vector3.new(0.9, 0.66, 0.08), rgb(255, 200, 60), plate, Enum.Material.Foil, "BeltPlate")
	k.block(Vector3.new(0.7, 0.46, 0.09), rgb(255, 225, 120), plate * CFrame.new(0, 0, -0.02 * k.s), Enum.Material.Foil, "BeltPlate")
	k.block(Vector3.new(0.24, 0.24, 0.1), info.Glow, plate * CFrame.new(0, 0, -0.05 * k.s) * CFrame.Angles(0, 0, math.rad(45)), NEON, "Gem")
	for _, side in { -1, 1 } do
		k.ball(0.12, rgb(255, 230, 140), plate * CFrame.new(side * 0.36 * k.s, 0, -0.04 * k.s), Enum.Material.Foil, "BeltStud")
	end
end

function DonutLayers.Build(k: Kit, look: Look, info: Info)
	if (look.Glaze == "Drippy" or look.Glaze == "HalfDip") and not info.Square then
		drips(k, look, info)
	end
	shine(k, look, info)
	if info.NoFace then
		return
	end
	local marking = look.Marking
	if marking and Markings[marking] then
		local material = if look.MarkGlow then NEON else nil
		local color = if look.MarkGlow then info.Accent:Lerp(WHITE, 0.25) else info.Accent
		Markings[marking](k, look, info, color, material)
	end
	if k.RarityOrder >= 4 then
		beads(k, info)
	end
	if look.Muscles >= 2 then
		belt(k, info)
	elseif k.RarityOrder >= 5 then
		gem(k, info)
	end
end

return DonutLayers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">DonutLooks</string>
          <string name="Source"><![CDATA[--[[
	DonutLooks
	==========
	A donut's personality, read from its NAME (and its accessories, rarity and colours), so no two
	donuts are built the same way (DonutModel builds it, DonutLayers adds the layers):

	  * Mood: the face. "Cute" (big shiny eyes, the default), "Happy" (open smile), "Fierce"
	    (angry brows, fiery eyes, a toothy grin: lava, dragons, sharks...), "Mighty" (strong
	    names: determined brows, see Muscles), "Silly" (one big eye, tongue out: Tung Tung, Brr
	    Brr...), "Cool" (half-closed eyes and a smirk), "Dreamy" (sleepy lids and lashes: clouds,
	    angels, moons), "Royal" (lashes and a calm smile: kings and queens), "Spooky" (dark eyes
	    with glowing pupils: ghosts, vampires) and "Robot" (glowing screen eyes).
	  * Effects: false = no aura or glow of its own (DonutAuras); BiomeDetails: false = none of its
	    biome's little touches (DonutExtras.Theme); Scale: a smaller or bigger donut;
	    Rim: the outer glaze layer (round the rim and the hole) in another colour.
	  * Muscles: 0, 1 (toned arms: fighters and guards) or 2 (huge flexing arms and a champion
	    belt: Maximus, Supremus, Odin, Zeus, -zilla...). A strong donut gets arms if it has none.
	  * Feet: "Sneakers" (in the donut's own colours), "HighTops", "Boots", "Paws" (with toe
	    beans), "Hooves", "Claws", "Webbed", "Robot", "Sandals", or "Plain" (accessories that
	    restyle the shoes themselves: ballet slippers, flamingo legs).
	  * Glaze: "Glossy" (two layers of glaze and a shine), "TwoTone" (the raised middle of the glaze
	    in a second colour), "HalfDip" (only the top dipped, drips at the edge) or "Drippy" (drips
	    over the edges).
	  * Marking: a pattern on the glaze from the name - "Drizzle", "Stripes", "Spots", "Bolts",
	    "Flames", "Runes", "Hearts", "Scales", "Swirls" or "Stars". Legendary and up glow.
	  * Sprinkles: "Jimmies" (rods), "Nonpareils" (tiny beads), "Confetti" (flat squares) or
	    "Chunks" (chocolate-chip chunks).

	Everything here is plain data (DonutLooks.For is pure), so it's cheap and easy to test.
]]

local DonutLooks = {}

export type Look = {
	Mood: string,
	Iris: Color3,
	GlowEyes: boolean,
	Lashes: boolean,
	Muscles: number,
	Feet: string,
	Shoe: Color3,
	ShoeAccent: Color3,
	Sole: Color3,
	Glaze: string,
	Accent: Color3,
	Marking: string?,
	MarkGlow: boolean,
	Sprinkles: string,
	Tilt: number, -- radians the face leans (head tilt)
	Effects: boolean,
	BiomeDetails: boolean,
	Scale: number,
	Rim: Color3?,
}

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)
local BLACK = rgb(30, 30, 36)

-- Per-donut choices that beat whatever the name says.
DonutLooks.Overrides = {
	tradonut = { Shoe = rgb(40, 110, 235), ShoeAccent = WHITE }, -- Tralalero's blue sneakers
	tralalerobeach = { Shoe = rgb(40, 110, 235), ShoeAccent = rgb(255, 140, 40) },
	frigocamel = { Feet = "Boots" }, -- Frigo Camelo wears boots
	lirililarila = { Feet = "Sandals" },
	-- The Cosmic Donut: galaxy glaze (violet with a cyan raised middle), glowing stars on it,
	-- starry eyes, high-tops in deep space blue
	cosmicdonut = {
		Mood = "Cute", Glaze = "TwoTone", Accent = rgb(225, 130, 255), Rim = rgb(70, 25, 150),
		Marking = "Stars", MarkGlow = true, Sprinkles = "Nonpareils",
		Iris = rgb(150, 90, 255), GlowEyes = true, Lashes = true,
		Feet = "HighTops", Shoe = rgb(40, 22, 95), ShoeAccent = rgb(90, 225, 255), Sole = rgb(255, 255, 255),
		Effects = true, BiomeDetails = false, Scale = 1.1,
	},
} :: { [string]: { [string]: any } }

local function hashString(text: string): number
	local hash = 17
	for i = 1, #text do
		hash = (hash * 37 + string.byte(text, i)) % 2147483647
	end
	return hash
end

local function brightness(c: Color3): number
	return c.R * 0.299 + c.G * 0.587 + c.B * 0.114
end

local function saturation(c: Color3): number
	return math.max(c.R, c.G, c.B) - math.min(c.R, c.G, c.B)
end

-- Sneaker colours: { shoe, stripe, sole }
local SNEAKERS = {
	{ rgb(230, 45, 55), WHITE, WHITE },
	{ rgb(40, 110, 235), WHITE, WHITE },
	{ rgb(35, 35, 42), WHITE, WHITE },
	{ rgb(245, 245, 248), rgb(230, 40, 50), rgb(200, 200, 208) },
	{ rgb(60, 190, 80), rgb(255, 220, 60), WHITE },
	{ rgb(140, 70, 220), rgb(255, 140, 210), WHITE },
	{ rgb(255, 130, 30), BLACK, WHITE },
	{ rgb(255, 120, 180), WHITE, WHITE },
	{ rgb(30, 185, 190), WHITE, WHITE },
	{ rgb(255, 205, 40), BLACK, WHITE },
}

local IRISES = {
	rgb(110, 70, 40), -- brown
	rgb(60, 140, 255), -- blue
	rgb(50, 175, 90), -- green
	rgb(150, 90, 230), -- violet
	rgb(30, 175, 185), -- teal
	rgb(175, 120, 40), -- hazel
	rgb(235, 90, 160), -- pink
}

-- Name keywords. A keyword matches the start of any word in the donut's name or its id
-- ("rex" matches "Rexorino" but not "Fluorex"); one ending in "$" has to be the whole word.
local KEYS = {
	Spooky = { "ghost", "boo", "spook", "soul", "vampir", "skeleton", "witch", "wisp", "bone", "phantom", "zombie", "haunt" },
	Robot = { "robo", "mecha", "glazobot", "servero", "donutronic", "processore", "mainframo", "sentinelo", "antivirus", "weldonut", "vendomatico", "conveyoro", "boltino", "a.i." },
	Silly = { "tung", "brr", "trippi", "troppi", "yo-yo", "glazoyo", "lirili", "tralalero", "chimpanz", "bobrito", "sahur", "jack", "gumdroppa", "spaghett", "lag", "missingdonut", "patadonut" },
	Fierce = { "infern", "magma", "lava", "devil", "imp$", "impolo", "dragon", "rex", "shark", "scorch", "croc", "bomb", "blast", "blaze", "ember", "flamb", "volcan", "erupt", "crab", "tigr", "tiger", "pirat", "captain", "basalt", "obsidian", "cinda", "flame", "fire", "molten", "crullfire", "katana" },
	Royal = { "king", "queen", "imperatrix", "pharaoh", "glazamun", "grande", "palazzo", "prince", "final", "omnidonut", "supremo", "supremito", "eternal", "infinit", "goldino", "treasurino", "idolonut" },
	Dreamy = { "cloud", "angel", "heaven", "seraph", "harp", "moon", "dream", "petal", "bloom", "fairy", "nebul", "cumulus", "puffino", "floretta", "aurora", "comet" },
	Cool = { "surf", "skater", "neonetto", "street", "billboard", "cool", "neonino" },
	Happy = { "candy", "lollipop", "sprink", "strawberr", "rainbow", "arcobal", "teddy", "toy", "gum", "sugar", "sweet", "party" },

	Mighty = { "maximus", "maxima", "supremus", "zilla", "glazilla", "crullazilla", "odin", "zeus", "hades", "titan", "prime", "banhammer", "overclockus" },
	Toned = { "forgy", "firewallo", "shieldonut", "sentinelo", "antivirus", "soldier", "archangelo", "crashino", "guardino", "defendo", "blockerino" },

	Webbed = { "pinguino", "duck", "goose" },
	Paws = { "cat", "tigr", "tiger", "chimp", "monkey", "teddy", "yeti", "bear", "wolf", "lion", "dog", "pup", "kitty", "bobrito", "trippi", "patadonut" },
	Hooves = { "vaca", "cow", "camel", "trojan", "horse", "devil", "infernolino", "imp$", "impolo", "goat" },
	Claws = { "dragon", "rex", "zilla", "glazilla", "crullazilla", "croc", "dino", "raptor", "lizard", "phoenix", "parrot", "toucan", "glazarrot", "soulcanino" },
	Boots = { "soldier", "pirat", "captain", "cowboy", "frigo", "odin", "viking", "chocolatto", "summitino", "witch", "knight", "archangelo", "shieldonut", "sentinelo", "firewallo", "hades", "zeusino", "laserino" },
	Sandals = { "lirili", "pharaoh", "glazamun", "surf", "wavino", "beach", "laguna", "idolonut", "templ" },
	HighTops = { "skater", "street", "neonetto", "arcadonut", "pixel", "sahur" },

	Drippy = { "fudge", "caramel", "lava", "magma", "molten", "drip", "jelly", "honey", "syrup", "slime", "ooze", "melt", "eruptus", "volcan", "lavaccino", "lavalino" },
	HalfDip = { "dunk", "dip" },

	Drizzle = { "choco", "cocoa", "fudge", "mocha", "cappucc", "coffee", "caramel", "kreme", "boston", "cavern", "charcoal" },
	Stripes = { "tigr", "tiger", "zebra", "stripol", "bee", "wasp" },
	Spots = { "vaca", "cow", "leopard", "cheetah", "dalmat", "ladybug", "puffer", "jaguar", "spot" },
	Bolts = { "zeus", "bolt", "thunder", "storm", "overclock", "volt", "electr", "spark" },
	Flames = { "flame", "blaze", "infern", "fire", "scorch", "ember", "burn", "flamb", "cinda", "hellfire", "crullfire" },
	Runes = { "odin", "rune", "idol", "pharaoh", "glazamun", "templ", "ancient", "chrono", "eternal", "mystic" },
	Hearts = { "teddy", "love", "amor", "heart", "sweet", "lollipop", "cupid", "strawberr" },
	Scales = { "dragon", "rex", "zilla", "glazilla", "crullazilla", "croc", "dino", "basalt" },
	Swirls = { "soul", "wisp", "spirit", "aurora", "dream", "galax", "nebul", "cosmo", "void", "quantum", "infinit", "wormhol", "singular" },
	Stars = { "star", "comet", "astro", "cosmic", "nova", "supernova" },

	Chunks = { "choco", "cocoa", "fudge", "cookie", "charcoal", "basalt", "obsidian", "rocky", "cavern" },
	Nonpareils = { "pearl", "crystal", "amethyst", "prism", "diamond", "frost", "ice", "glacier", "snow" },
	Confetti = { "party", "confetti", "arcade", "pixel", "glitch", "toy", "jack" },
}

-- Accessories that already paint the same pattern (no double layers).
local SAME_PATTERN = {
	Stripes = { "TigerStripes", "CandyCane", "PeppermintSwirl" },
	Spots = { "CowSpots" },
	Drizzle = { "CaramelDrips" },
	Swirls = { "CinnamonSwirl", "GalaxySwirl" },
}

-- Glowing eyes for these moods once a donut is rare enough.
local IRIS_BY_MOOD: { [string]: Color3 } = {
	Spooky = rgb(120, 255, 150),
	Robot = rgb(60, 230, 255),
	Fierce = rgb(255, 150, 30),
	Mighty = rgb(255, 90, 50),
	Royal = rgb(160, 90, 255),
	Dreamy = rgb(200, 140, 255),
}

function DonutLooks.For(donut: { Id: string, Name: string, Rarity: string, Frosting: Color3, Dough: Color3, Sprinkles: { Color3 }?, Parts: { string } }, rarityOrder: number): Look
	local words = {}
	for word in string.gmatch(string.lower(donut.Name .. " " .. donut.Id), "[^%s]+") do
		table.insert(words, word)
	end
	local function any(list: { string }): boolean
		for _, key in list do
			for _, word in words do
				if string.sub(key, -1) == "$" then
					if word == string.sub(key, 1, -2) then
						return true
					end
				elseif string.sub(word, 1, #key) == key then
					return true
				end
			end
		end
		return false
	end
	local parts = {}
	for _, name in donut.Parts do
		parts[name] = true
	end
	local hash = hashString(donut.Id)
	local function pick<T>(list: { T }, salt: number): T
		return list[(math.floor(hash / salt) % #list) + 1]
	end

	-- Muscles: strong names (and the donuts that carry a big hammer or a shield)
	local muscles = if any(KEYS.Mighty) then 2
		elseif any(KEYS.Toned) or parts.ForgeHammer or parts.Shield or parts.BrickShield or parts.Banhammer or parts.Sword then 1
		else 0

	-- Mood
	local mood = "Cute"
	if any(KEYS.Spooky) or parts.GhostTail then
		mood = "Spooky"
	elseif any(KEYS.Robot) or parts.RoboPlates then
		mood = "Robot"
	elseif muscles > 0 then
		mood = "Mighty"
	elseif any(KEYS.Silly) then
		mood = "Silly"
	elseif any(KEYS.Fierce) or parts.Fangs or parts.DevilTail then
		mood = "Fierce"
	elseif any(KEYS.Royal) or (parts.Crown and rarityOrder >= 6) then
		mood = "Royal"
	elseif any(KEYS.Dreamy) or parts.CloudPuffs then
		mood = "Dreamy"
	elseif any(KEYS.Cool) or parts.Sunglasses or parts.Visor then
		mood = "Cool"
	elseif any(KEYS.Happy) or hash % 3 == 0 then
		mood = "Happy"
	end

	local iris = IRIS_BY_MOOD[mood] or pick(IRISES, 7)
	local glowEyes = mood == "Spooky" or mood == "Robot" or (rarityOrder >= 6 and IRIS_BY_MOOD[mood] and true or false)
	local lashes = mood == "Royal" or mood == "Dreamy" or parts.Tiara == true or parts.Tutu == true or parts.Bow == true

	-- Feet
	local feet = "Sneakers"
	if parts.FlamingoLegs or parts.BalletSlippers or parts.Flippers then
		feet = "Plain"
	elseif any(KEYS.Webbed) then
		feet = "Webbed"
	elseif mood == "Robot" then
		feet = "Robot"
	elseif any(KEYS.Claws) or parts.DragonTail or parts.DinoSpikes or parts.CrocSnout then
		feet = "Claws"
	elseif any(KEYS.Paws) or parts.CatEars or parts.MonkeyEars or parts.FurTufts then
		feet = "Paws"
	elseif any(KEYS.Hooves) or parts.DevilTail or parts.Camel or parts.CowBell then
		feet = "Hooves"
	elseif any(KEYS.Boots) or muscles > 0 or parts.PirateHat or parts.MinerHelmet or parts.Busby or parts.WitchHat then
		feet = "Boots"
	elseif any(KEYS.Sandals) or parts.Pharaoh then
		feet = "Sandals"
	elseif any(KEYS.HighTops) then
		feet = "HighTops"
	end
	local sneaker = pick(SNEAKERS, 11)
	local shoe, shoeAccent, sole = sneaker[1], sneaker[2], sneaker[3]
	if saturation(donut.Frosting) > 0.3 and (hash % 5) < 2 then
		-- shoes to match the glaze
		shoe, shoeAccent, sole = donut.Frosting:Lerp(BLACK, 0.12), WHITE, WHITE
	end
	-- (for the other feet: Shoe = the foot, ShoeAccent = buckle / toe beans / claws..., Sole = the bottom)
	if feet == "Boots" then
		shoe, shoeAccent, sole = pick({ rgb(95, 60, 35), rgb(40, 38, 46), rgb(120, 35, 45), rgb(70, 75, 92) }, 13), rgb(255, 200, 60), rgb(40, 32, 28)
	elseif feet == "Paws" then
		local fur = donut.Dough:Lerp(WHITE, 0.12)
		shoe, shoeAccent, sole = fur, rgb(255, 150, 175), fur:Lerp(BLACK, 0.3)
	elseif feet == "Hooves" then
		shoe, shoeAccent, sole = rgb(70, 55, 50), donut.Dough:Lerp(WHITE, 0.55), rgb(30, 24, 22)
	elseif feet == "Claws" then
		local scales = donut.Frosting:Lerp(BLACK, 0.3)
		shoe, shoeAccent, sole = scales, rgb(245, 238, 220), scales:Lerp(WHITE, 0.2)
	elseif feet == "Robot" then
		shoe, shoeAccent, sole = rgb(150, 155, 168), iris, rgb(50, 52, 60)
	elseif feet == "Webbed" then
		shoe, shoeAccent, sole = rgb(255, 150, 40), rgb(225, 105, 20), rgb(225, 105, 20)
	elseif feet == "Sandals" then
		shoe, shoeAccent, sole = donut.Dough, pick({ rgb(230, 60, 60), rgb(60, 140, 240), rgb(255, 200, 60) }, 13), rgb(150, 95, 50)
	end

	-- Glaze
	local glaze = "Glossy"
	if any(KEYS.Drippy) or parts.LavaDrips or parts.FudgeDrips or parts.JellyOoze then
		glaze = "Drippy"
	elseif any(KEYS.HalfDip) or (rarityOrder <= 3 and hash % 7 == 0) then
		glaze = "HalfDip"
	elseif hash % 4 == 1 then
		glaze = "TwoTone"
	end
	local accent
	local sprinkles = donut.Sprinkles
	if any(KEYS.Drizzle) then
		accent = if brightness(donut.Frosting) < 0.45 then rgb(255, 245, 230) else rgb(105, 60, 35)
	elseif sprinkles and #sprinkles > 0 and math.abs(brightness(sprinkles[1]) - brightness(donut.Frosting)) > 0.18 then
		accent = sprinkles[1]
	elseif brightness(donut.Frosting) < 0.5 then
		accent = donut.Frosting:Lerp(WHITE, 0.6)
	else
		accent = donut.Frosting:Lerp(BLACK, 0.35)
	end

	-- Marking
	local marking: string? = nil
	for _, name in { "Drizzle", "Bolts", "Flames", "Runes", "Stripes", "Spots", "Scales", "Hearts", "Swirls", "Stars" } do
		if any(KEYS[name]) then
			marking = name
			break
		end
	end
	if marking and SAME_PATTERN[marking] then
		for _, accessory in SAME_PATTERN[marking] do
			if parts[accessory] then
				marking = nil
				break
			end
		end
	end
	if not marking and rarityOrder >= 6 then
		marking = "Swirls" -- the rarest donuts all get glowing swirls (like the mythical creatures)
	end
	if not marking and glaze == "Glossy" and rarityOrder >= 3 and hash % 3 == 0 then
		marking = "Drizzle"
	end

	local sprinkleStyle = "Jimmies"
	if any(KEYS.Chunks) then
		sprinkleStyle = "Chunks"
	elseif any(KEYS.Nonpareils) then
		sprinkleStyle = "Nonpareils"
	elseif any(KEYS.Confetti) then
		sprinkleStyle = "Confetti"
	elseif hash % 6 == 2 then
		sprinkleStyle = "Nonpareils"
	elseif hash % 6 == 4 then
		sprinkleStyle = "Confetti"
	end

	local look: Look = {
		Mood = mood,
		Iris = iris,
		GlowEyes = glowEyes,
		Lashes = lashes,
		Muscles = muscles,
		Feet = feet,
		Shoe = shoe,
		ShoeAccent = shoeAccent,
		Sole = sole,
		Glaze = glaze,
		Accent = accent,
		Marking = marking,
		MarkGlow = rarityOrder >= 5,
		Sprinkles = sprinkleStyle,
		Tilt = 0,
		Effects = true,
		BiomeDetails = true,
		Scale = 1,
		Rim = nil,
	}
	local override = DonutLooks.Overrides[donut.Id]
	if override then
		for key, value in override do
			(look :: any)[key] = value
		end
	end
	return look
end

return DonutLooks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">DonutModel</string>
          <string name="Source"><![CDATA[--[[
	DonutModel
	==========
	Builds a donut "character" out of plain parts (no uploaded meshes needed): a smooth dough ring
	(a torus made of short cylinders laid end to end), a glossy glaze ring in front of it with a wavy,
	dripping edge, sprinkles lying on the glaze, a cute face and brainrot accessories (legs,
	sunglasses, shark fin...).

	Rarer donuts get more and more effects (sparkles, lights, floating, light pillars, orbiting orbs,
	halos, rainbow frosting, a shimmering aura for Secrets). Mutations recolour the donut and add
	their own effects (Gold shines, Diamond is glassy, Mythic grows horns, Divine gets wings and a
	halo, Rainbow cycles colours). Sizes scale the whole donut.
	On top of that, every donut has its own aura (DonutAuras.luau: a small one for Common to Rare,
	bigger and bigger after that) built from FXThemes blocks: sun rays, particle vortexes, hellfire,
	god rays, the anime effects (AnimeFX.luau: power-up auras, toon fire, slashes, impact frames)...
	plus lightning, magic circles and comets animated by each client (client/DonutFX.luau).

	The model is a single rigid assembly: the invisible "Root" part is anchored and every other part is
	welded to it, so moving Root moves the whole donut (cheap to animate on the client).
	Moving parts (legs, arms, wings, propellers, orbiting orbs, tentacles, capes) are marked with a
	"Limb" attribute and the point they swing around ("Pivot", in the donut's own space); the eyes
	("EyeWhite"), pupils ("Pupil") and mouth ("Mouth") are marked too, so the client can make the
	donut blink, look around and open its mouth (see client/DonutIdle.luau).

	Used by the server (lane spawns, bases, podiums, carried donuts) and the client (Index previews).
]]

local CollectionService = game:GetService("CollectionService")

local Config = require(script.Parent.Config)

local Rarities = require(script.Parent.Rarities)
local Format = require(script.Parent.Format)
local Donuts = require(script.Parent.Donuts)
local Areas = require(script.Parent.Areas)
local FXThemes = require(script.Parent.FXThemes)
local DonutExtras = require(script.Parent.DonutExtras)
local DonutLooks = require(script.Parent.DonutLooks)
local DonutLayers = require(script.Parent.DonutLayers)
local DonutAuras = require(script.Parent.DonutAuras)
local AnimeFX = require(script.Parent.AnimeFX)

type Donut = Donuts.Donut

local DonutModel = {}

local RING_RADIUS = 1.5
local BALL = 1.55 -- thickness of the dough ring
local SEGMENTS = 16 -- tube pieces in the dough ring
local GLAZE_SEGMENTS = 18 -- the glaze is shinier, so it gets a few more (smoother highlights)
local FROSTING_OFFSET = -0.3 -- the glaze sits on the front face (-Z is the donut's front)
local FROSTING_TUBE = 1.36
-- Studded donuts (Config.DonutModels): the ring is built from square-edged blocks, a few fewer of
-- them (chunkier), and the glaze is two steps: a wide "shoulder" and a narrower raised "crown" in the
-- middle, so its front follows the round glaze closely and everything placed on it still sits on it.
local STUDDED = Config.DonutModels.Studded
local STUDDED_SEGMENTS, STUDDED_GLAZE_SEGMENTS = 16, 18
-- (the shoulder stands a little proud of the dough's front, -BALL / 2, so both layers show)
local CROWN_HALF, CROWN_FRONT, SHOULDER_FRONT = 0.38, -1.0, -0.86
local HALF_DIP = -0.3 -- a half-dipped donut's glaze stops where sin(angle round the ring) drops below this
local STUD_FACES = { "TopSurface", "BottomSurface", "FrontSurface", "BackSurface", "LeftSurface", "RightSurface" }
-- Studs go on the big pieces a donut is built from: its dough ring, legs and arms. On the glaze and
-- the little details (sprinkles, eyes, beads...) they only looked like noise, so those stay smooth.
local STUD_PARTS = { Dough = true, Leg = true, Ankle = true, UpperArm = true, Forearm = true, Shoulder = true, Bicep = true }
-- Square brick donuts (Config.DonutModels.Shape = "Square", studded only), like the Blender model in
-- art/brick_donut: the ring is a square with its corners cut off, laid out on a grid of square cells
-- (13 across) in layers - a darker baked back, the dough, a wide glaze layer standing out in front
-- of it and a raised crown in the middle of the glaze. Neighbouring cells are merged into big
-- blocks, so the whole ring is about 30 parts. The glaze's two fronts stay where the round studded
-- ones are (so the face and everything on it fit both shapes); the dough stands further back, so
-- the glaze steps out from it.
local SQUARE = STUDDED and Config.DonutModels.Shape == "Square"
local CELL = (RING_RADIUS + BALL / 2) / 6.5
local SQUARE_N = 6 -- cells from the middle to the edge
local SQUARE_DOUGH_FRONT = SHOULDER_FRONT + 0.3
local SQUARE_BAKED = 0.18 -- depth of the darker back
local SQUARE_CORNER = 10.5 * CELL -- the dough's cut corners: |x| + |y| up to about this

local function cellKey(x: number, y: number): number
	return (x + 16) * 64 + (y + 16)
end

-- The cells of one square layer: `inner` to `outer` cells out from the middle (either way), with
-- its corners cut off where |x| + |y| > `cut`.
local function squareLayer(inner: number, outer: number, cut: number): { [number]: boolean }
	local cells = {}
	for x = -SQUARE_N, SQUARE_N do
		for y = -SQUARE_N, SQUARE_N do
			local d = math.max(math.abs(x), math.abs(y))
			if d >= inner and d <= outer and math.abs(x) + math.abs(y) <= cut then
				cells[cellKey(x, y)] = true
			end
		end
	end
	return cells
end
local SQUARE_DOUGH = squareLayer(2, 6, 10)
local SQUARE_GLAZE = squareLayer(2, 5, 8)
local SQUARE_CROWN = squareLayer(3, 4, 6)

-- A layer's cells merged into as few rectangles as possible: a run along a row, grown downwards as
-- far as it goes. Each is { x0, y0, x1, y1 } in cells (inclusive).
local function rectangles(cells: { [number]: boolean }): { { number } }
	local used = {}
	local function free(x: number, y: number): boolean
		local key = cellKey(x, y)
		return cells[key] == true and not used[key]
	end
	local rects = {}
	for y = SQUARE_N, -SQUARE_N, -1 do
		for x = -SQUARE_N, SQUARE_N do
			if free(x, y) then
				local x1 = x
				while x1 < SQUARE_N and free(x1 + 1, y) do
					x1 += 1
				end
				local y0 = y
				while y0 > -SQUARE_N do
					local whole = true
					for cx = x, x1 do
						whole = whole and free(cx, y0 - 1)
					end
					if not whole then
						break
					end
					y0 -= 1
				end
				for cx = x, x1 do
					for cy = y0, y do
						used[cellKey(cx, cy)] = true
					end
				end
				table.insert(rects, { x, y0, x1, y })
			end
		end
	end
	return rects
end

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)
local BLACK = rgb(20, 20, 20)

export type BuildOptions = {
	Scale: number?,
	Pillar: boolean?, -- tall light pillar (rare lane donuts, so players can spot them from afar)
	NoEffects: boolean?, -- skip lights/particles (viewport previews)
	Calm: boolean?, -- softer effects (donuts on bases: lots of them side by side would glare)
	Mutation: string?,
	Size: string?,
	NoFace: boolean?, -- just a donut (the Update Log's emblem): no face, sprinkles all the way round
}

local function hashString(text: string): number
	local hash = 7
	for i = 1, #text do
		hash = (hash * 31 + string.byte(text, i)) % 2147483647
	end
	return hash
end

local function emitter(parent: Instance, color: ColorSequence, rate: number, size: number, speed: number, lifetime: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Color = color
	e.LightEmission = 1
	e.Rate = rate
	e.Lifetime = NumberRange.new(lifetime * 0.6, lifetime)
	e.Speed = NumberRange.new(speed * 0.4, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new(0.1, 1)
	e.Parent = parent
	return e
end

-- Particle textures: Roblox's own (always there), unless Config.DonutFX.Textures names others.
local TEXTURES: { [string]: string } = {
	Spark = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Swirl = "rbxasset://textures/particles/forcefield_vortex_main.dds",
}
local function texture(name: string): string
	local custom = Config.DonutFX.Textures[name]
	if type(custom) == "string" and custom ~= "" then
		return custom
	end
	return TEXTURES[name] or AnimeFX.Texture(name) -- (Petal...: the anime textures)
end
DonutModel.Texture = texture

local function keys(colors: { Color3 }): ColorSequence
	if #colors == 1 then
		return ColorSequence.new(colors[1])
	end
	local list = {}
	for i, color in colors do
		table.insert(list, ColorSequenceKeypoint.new((i - 1) / (#colors - 1), color))
	end
	return ColorSequence.new(list)
end

function DonutModel.Build(donut: Donut, options: BuildOptions?): Model
	local opts: BuildOptions = options or {}
	local rarity = Rarities.Get(donut.Rarity)
	local mutation = Rarities.Mutation(opts.Mutation)
	local size = Rarities.Size(opts.Size)
	-- Its personality (face, feet, muscles, glaze style, markings, size) comes from its name
	local look = DonutLooks.For(donut, rarity.Order)
	local s = (opts.Scale or 1) * size.Scale * look.Scale
	local rng = Random.new(hashString(donut.Id))
	local partsSet = {}
	for _, name in donut.Parts do
		partsSet[name] = true
	end
	if mutation.Halo then
		partsSet.Halo = true
	end
	if mutation.Wings then
		partsSet.Wings = true
	end
	if mutation.Horns then
		partsSet.Horns = true
	end
	if look.Muscles > 0 and not partsSet.PlaneWings and not partsSet.Tentacles then
		partsSet.Arms = true -- strong donuts show off their arms
	end

	local doughColor = mutation.Dough or donut.Dough
	local frostingColor = mutation.Frosting or donut.Frosting
	-- the second colour (two-tone glaze, drizzles, markings): a mutation keeps to its own colours
	local accent = if mutation.Frosting then frostingColor:Lerp(if mutation.Id == "Gold" then WHITE else Color3.new(0, 0, 0), 0.35) else look.Accent
	local frostingMaterial = mutation.Material or Enum.Material.SmoothPlastic
	local doughMaterial = if mutation.Material == Enum.Material.Neon then Enum.Material.SmoothPlastic else (mutation.Material or Enum.Material.SmoothPlastic)
	local special = mutation.Order >= 1 -- mutated donuts look shinier

	local model = Instance.new("Model")
	model.Name = donut.Id

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(3, 3, 1.5) * s
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Massless = true
	root.CFrame = CFrame.identity
	root.Parent = model
	model.PrimaryPart = root

	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x * s, y * s, z * s)
	end

	local function add(p: BasePart, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Material = material or Enum.Material.SmoothPlastic
		p.Color = color
		p.CFrame = cf
		local weld = Instance.new("Weld")
		weld.Part0 = root
		weld.Part1 = p
		weld.C0 = cf
		weld.Parent = p
		p.Parent = model
		return p
	end

	local function ball(diameter: number, color: Color3, cf: CFrame, material: Enum.Material?, name: string?): BasePart
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.one * diameter * s
		p.Name = name or "Ball"
		return add(p, cf, color, material)
	end

	-- Stretched ball (a block with a sphere mesh: Ball parts are always perfectly round).
	local function ellipsoid(sizeV: Vector3, color: Color3, cf: CFrame, material: Enum.Material?, name: string?): BasePart
		local p = Instance.new("Part")
		p.Size = sizeV * s
		p.Name = name or "Ellipsoid"
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
		return add(p, cf, color, material)
	end

	local function block(sizeV: Vector3, color: Color3, cf: CFrame, material: Enum.Material?, name: string?): BasePart
		local p = Instance.new("Part")
		p.Size = sizeV * s
		p.Name = name or "Block"
		return add(p, cf, color, material)
	end

	-- Cylinder standing upright (Roblox cylinders point along X by default).
	local function cylinder(height: number, diameter: number, color: Color3, cf: CFrame, material: Enum.Material?, name: string?): BasePart
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(height, diameter, diameter) * s
		p.Name = name or "Cylinder"
		return add(p, cf * CFrame.Angles(0, 0, math.pi / 2), color, material)
	end

	local function wedge(sizeV: Vector3, color: Color3, cf: CFrame, material: Enum.Material?): BasePart
		local p = Instance.new("WedgePart")
		p.Size = sizeV * s
		p.Name = "Wedge"
		return add(p, cf, color, material)
	end

	-- Mark a part as an animatable limb that swings around `pivot` (unscaled donut coordinates).
	local function limb(part: BasePart, kind: string, side: number, px: number, py: number, pz: number): BasePart
		part:SetAttribute("Limb", kind)
		part:SetAttribute("Side", side)
		part:SetAttribute("Pivot", Vector3.new(px, py, pz) * s)
		return part
	end

	local R = RING_RADIUS
	local TOP = R + BALL / 2 -- top of the ring
	local shine = if rarity.Shine or special then 0.15 else 0.06
	local TAU = math.pi * 2
	local FROST_R = FROSTING_TUBE / 2

	-- A smooth ring (a torus) out of straight tube pieces: one cylinder per segment lying along the
	-- ring, each just long enough to meet its neighbours on the outside without a notch.
	-- `shade(angle)` lightens (+) or darkens (-) each piece a little: baked-looking dough, glossy glaze.
	-- (studded: square blocks, `depth` deep front to back)
	-- `keep(angle)` leaves pieces out (half-dipped glaze).
	local function ring(count: number, diameter: number, z: number, color: Color3, material: Enum.Material, name: string, shade: ((number) -> number)?, depth: number?, keep: ((number) -> boolean)?): { BasePart }
		local step = TAU / count
		local length = 2 * R * math.sin(step / 2) + diameter * math.tan(step / 2)
		local pieces = {}
		for i = 0, count - 1 do
			local angle = i * step
			if keep and not keep(angle) then
				continue
			end
			local p = Instance.new("Part")
			p.Shape = if STUDDED then Enum.PartType.Block else Enum.PartType.Cylinder
			p.Size = Vector3.new(length, diameter, depth or diameter) * s
			p.Name = name
			local cf = at(R * math.cos(angle), R * math.sin(angle), z) * CFrame.Angles(0, 0, angle + math.pi / 2)
			local tint = color
			-- (studded blocks are all one colour: neighbours overlap at their corners, flat and at the
			-- same depth, so any difference between them shows as thin seams across the glaze)
			if shade and not STUDDED then
				local amount = shade(angle)
				tint = if amount > 0 then color:Lerp(WHITE, amount) else color:Lerp(Color3.new(0, 0, 0), -amount)
			end
			table.insert(pieces, add(p, cf, tint, material))
		end
		return pieces
	end

	-- Glaze styles (DonutLooks): a half-dipped donut only has glaze on its top part
	local function glazed(angle: number): boolean
		return look.Glaze ~= "HalfDip" or math.sin(angle) > HALF_DIP
	end

	-- Square: the cells the glaze and its raised crown cover (just the top part on a half-dipped
	-- donut), and how far in front the surface is at (x, y): the crown, the glaze, else the dough.
	-- (Over the hole it's the glaze's front, so a mouth on the hole's edge still sits right.)
	local glazeCells: { [number]: boolean }, crownCells: { [number]: boolean } = {}, {}
	if SQUARE then
		for x = -SQUARE_N, SQUARE_N do
			for y = -SQUARE_N, SQUARE_N do
				local key = cellKey(x, y)
				if glazed(math.atan2(y, x)) then
					glazeCells[key] = SQUARE_GLAZE[key]
					crownCells[key] = SQUARE_CROWN[key]
				end
			end
		end
	end
	local function squareFront(x: number, y: number): number
		local key = cellKey(math.round(x / CELL), math.round(y / CELL))
		if crownCells[key] then
			return CROWN_FRONT
		elseif glazeCells[key] then
			return SHOULDER_FRONT
		elseif SQUARE_DOUGH[key] then
			return SQUARE_DOUGH_FRONT
		end
		return SHOULDER_FRONT
	end

	-- A spot on the glaze, facing out of it: `angle` around the ring, `tilt` from the front of the
	-- tube towards its outer edge (negative = towards the hole), `lift` above the surface.
	local function onGlaze(angle: number, tilt: number, lift: number): CFrame
		if SQUARE then
			-- the same spread across the square glaze (pulled in at its cut corners), on whichever
			-- layer is there, facing straight out of the front
			local c, sn = math.cos(angle), math.sin(angle)
			local reach = (3.5 + math.sin(tilt) * 1.9) * CELL / math.max(math.abs(c), math.abs(sn))
			local p = Vector3.new(c, sn, 0) * math.min(reach, 8.4 * CELL / (math.abs(c) + math.abs(sn)))
			local point = p + Vector3.new(0, 0, squareFront(p.X, p.Y) - lift)
			return CFrame.lookAt(point * s, (point - Vector3.zAxis) * s)
		end
		local radial = Vector3.new(math.cos(angle), math.sin(angle), 0)
		local normal = radial * math.sin(tilt) + Vector3.new(0, 0, -math.cos(tilt))
		local point = radial * R + Vector3.new(0, 0, FROSTING_OFFSET) + normal * (FROST_R + lift)
		if STUDDED then
			-- on the flat front of the stepped glaze (the crown in the middle, the shoulder outside it)
			local offset = math.sin(tilt) * FROST_R
			local front = if math.abs(offset) <= CROWN_HALF then CROWN_FRONT else SHOULDER_FRONT
			point = radial * (R + offset) + Vector3.new(0, 0, front) + normal * lift
		end
		return CFrame.lookAt(point * s, (point + normal) * s)
	end

	-- The glaze surface in front of the point (x, y) on the donut's face.
	local function face(x: number, y: number, lift: number): CFrame
		if SQUARE then
			local point = Vector3.new(x, y, squareFront(x, y) - lift)
			return CFrame.lookAt(point * s, (point - Vector3.zAxis) * s)
		end
		local offset = math.clamp(math.sqrt(x * x + y * y) - R, -FROST_R * 0.95, FROST_R * 0.95)
		return onGlaze(math.atan2(y, x), math.asin(offset / FROST_R), lift)
	end

	-- Square: the layers as blocks, each covering a rectangle of cells from z0 to z1 (front to back)
	local function slab(cells: { [number]: boolean }, z0: number, z1: number, color: Color3, material: Enum.Material, name: string): { BasePart }
		local pieces = {}
		for _, r in rectangles(cells) do
			local sizeV = Vector3.new((r[3] - r[1] + 1) * CELL, (r[4] - r[2] + 1) * CELL, z1 - z0)
			table.insert(pieces, block(sizeV, color, at((r[1] + r[3]) / 2 * CELL, (r[2] + r[4]) / 2 * CELL, (z0 + z1) / 2), material, name))
		end
		return pieces
	end

	-- Dough ring, with the glaze in front of it (the dough shows around its edges)
	-- (the dough is golden on top and more baked underneath; the glaze catches light from the top left)
	local doughPieces
	if SQUARE then
		-- the dough, and a darker baked back behind it
		doughPieces = slab(SQUARE_DOUGH, SQUARE_DOUGH_FRONT, BALL / 2 - SQUARE_BAKED, doughColor, doughMaterial, "Dough")
		for _, piece in slab(SQUARE_DOUGH, BALL / 2 - SQUARE_BAKED, BALL / 2, doughColor:Lerp(Color3.new(0, 0, 0), 0.22), doughMaterial, "Dough") do
			table.insert(doughPieces, piece)
		end
	else
		doughPieces = ring(if STUDDED then STUDDED_SEGMENTS else SEGMENTS, BALL, 0, doughColor, doughMaterial, "Dough", function(angle: number): number
			local up = math.sin(angle)
			return if up > 0 then up * 0.1 else up * 0.2
		end)
	end
	for _, piece in doughPieces do
		piece.Reflectance = shine * 0.3
	end
	local function glazeShade(angle: number): number
		local light = math.cos(angle - math.rad(135))
		return if light > 0 then light * 0.1 else light * 0.07
	end
	-- Two layers of glaze: a wide one a shade darker, and a raised middle on top of it that catches
	-- the light (a second colour on "TwoTone" donuts)
	local underColor = if look.Rim and not mutation.Frosting then look.Rim else frostingColor:Lerp(Color3.new(0, 0, 0), 0.14)
	local crownColor = if look.Glaze == "TwoTone" then accent else frostingColor
	local glaze
	if SQUARE then
		-- the wide glaze layer standing out from the dough, the crown standing out from that
		glaze = slab(glazeCells, SHOULDER_FRONT, SQUARE_DOUGH_FRONT + 0.02, underColor, frostingMaterial, "Frosting")
		for _, piece in slab(crownCells, CROWN_FRONT, SHOULDER_FRONT + 0.02, crownColor, frostingMaterial, "Frosting") do
			table.insert(glaze, piece)
		end
	elseif STUDDED then
		-- shoulder: as wide as the round glaze, standing a little proud of the dough; crown on top
		glaze = ring(STUDDED_GLAZE_SEGMENTS, FROSTING_TUBE, SHOULDER_FRONT / 2, underColor, frostingMaterial, "Frosting", glazeShade, -SHOULDER_FRONT, glazed)
		local crownDepth = SHOULDER_FRONT - CROWN_FRONT + 0.1
		for _, piece in ring(STUDDED_GLAZE_SEGMENTS, CROWN_HALF * 2, CROWN_FRONT + crownDepth / 2, crownColor, frostingMaterial, "Frosting", function(angle: number): number
			return glazeShade(angle) + 0.05 -- the raised middle catches a bit more light
		end, crownDepth, glazed) do
			table.insert(glaze, piece)
		end
	else
		glaze = ring(GLAZE_SEGMENTS, FROSTING_TUBE, FROSTING_OFFSET, frostingColor, frostingMaterial, "Frosting", glazeShade, nil, glazed)
	end

	-- Studded: glaze running over the dough rim on the lower half, from the middle of every other
	-- glaze block (all of them on a drippy donut), each with a drop at its end.
	-- Round donuts: tongues of glaze lying over the dough rim all the way round; on the lower sides
	-- some run right over the edge like drips.
	if SQUARE then
		-- Square: glaze running down a column of cells from the glaze's lowest cell there, over the
		-- dough (thinner than the glaze), with a drop hanging off the rim if it gets that far.
		-- Half-dipped donuts drip down their sides from where the glaze stops.
		local dripColor = if look.Rim and not mutation.Frosting then underColor else frostingColor
		local columns: { number } = if look.Glaze == "HalfDip" then { -5, -3, 3, 5 } elseif look.Glaze == "Drippy" then { -5, -3, 0, 3, 5 } else { -4, 0, 4 }
		local z0, z1 = SQUARE_DOUGH_FRONT - 0.17, SQUARE_DOUGH_FRONT + 0.03
		for _, x in columns do
			local lowest
			for y = 1, -SQUARE_N, -1 do
				if glazeCells[cellKey(x, y)] then
					lowest = y
				end
			end
			if not lowest then
				continue
			end
			local length = rng:NextInteger(1, if look.Glaze == "Drippy" then 3 else 2)
			local run, hang = 0, false
			for k = 1, length do
				local y = lowest - k
				if SQUARE_DOUGH[cellKey(x, y)] then
					run = k
				else
					hang = not (math.abs(x) <= 1 and math.abs(y) <= 1) -- (never into the hole)
					break
				end
			end
			local top = (lowest - 0.5) * CELL
			if run > 0 then
				table.insert(glaze, block(Vector3.new(CELL - 0.03, run * CELL + 0.04, z1 - z0), dripColor, at(x * CELL, top - run * CELL / 2 + 0.02, (z0 + z1) / 2), frostingMaterial, "Frosting"))
			end
			if hang then
				local y = (lowest - run - 1) * CELL
				table.insert(glaze, block(Vector3.new(CELL + 0.02, CELL, z1 - z0 + 0.04), dripColor, at(x * CELL, y, (z0 + z1) / 2), frostingMaterial, "Frosting"))
			end
		end
	elseif STUDDED then
		local step = TAU / STUDDED_GLAZE_SEGMENTS
		local dripColor = if look.Rim and not mutation.Frosting then underColor else frostingColor
		for i = 0, STUDDED_GLAZE_SEGMENTS - 1 do
			local angle = i * step
			local drippy = look.Glaze == "Drippy"
			if math.sin(angle) < -0.4 and (drippy or i % 2 == 0) and glazed(angle) then
				-- from under the glaze's lower edge, straight down over the dough and off its rim
				local edge = Vector3.new(math.cos(angle), math.sin(angle), 0) * (R + FROST_R - 0.1)
				local length = rng:NextNumber(0.42, if drippy then 0.72 else 0.56)
				local z = -BALL / 2 + 0.03 -- (on the dough's front, just behind the glaze)
				table.insert(glaze, block(Vector3.new(0.26, length, 0.2), dripColor, at(edge.X, edge.Y - length / 2, z), frostingMaterial, "Frosting"))
				table.insert(glaze, block(Vector3.new(0.34, 0.24, 0.24), dripColor, at(edge.X, edge.Y - length, z - 0.02), frostingMaterial, "Frosting"))
			end
		end
	end
	local edgeCount = if STUDDED then 0 else 8
	for n = 0, edgeCount - 1 do
		local angle = (n + rng:NextNumber(-0.25, 0.25)) / edgeCount * TAU + 0.2
		local radial = Vector3.new(math.cos(angle), math.sin(angle), 0)
		local dripChance = if look.Glaze == "Drippy" then 1 else 0.75
		local drip = radial.Y < -0.2 and math.abs(radial.X) > 0.4 and rng:NextNumber() < dripChance
		if not glazed(angle) then
			continue
		end
		-- how far round the dough tube (from its front towards the outside) the tongue sits
		local around = math.rad(if drip then 74 else 60)
		local normal = radial * math.sin(around) + Vector3.new(0, 0, -math.cos(around))
		local downTube = radial * math.cos(around) + Vector3.new(0, 0, math.sin(around))
		local tangent = Vector3.new(-radial.Y, radial.X, 0)
		local center = (radial * R + normal * (BALL / 2)) * s
		local length = if drip then rng:NextNumber(0.85, 1.1) else rng:NextNumber(0.45, 0.6)
		local cf = CFrame.fromMatrix(center, tangent, normal, downTube)
		if STUDDED then
			-- a flat tab of glaze on the square ring's outer side, running back from its front edge
			local depth = math.min(length, BALL) * 0.8
			center = (radial * (R + BALL / 2 + 0.06) + Vector3.new(0, 0, -BALL / 2 + depth / 2)) * s
			cf = CFrame.fromMatrix(center, tangent, radial, Vector3.new(0, 0, 1))
			length = depth
		end
		table.insert(glaze, ellipsoid(Vector3.new(if drip then 0.4 else 0.55, 0.2, length), if look.Rim and not mutation.Frosting then underColor else frostingColor, cf, frostingMaterial, "Frosting"))
	end
	for _, piece in glaze do
		piece.Reflectance = shine
		if mutation.Id == "Diamond" then
			piece.Transparency = 0.15
		end
	end

	-- Sprinkles lying on the glaze (none on the face): rods, tiny beads, flat confetti or chunks
	local sprinkleColors = donut.Sprinkles
	if mutation.Id == "Gold" then
		sprinkleColors = { rgb(255, 250, 200), rgb(255, 180, 40) }
	elseif mutation.Id == "Diamond" then
		sprinkleColors = { WHITE, rgb(150, 230, 255) }
	end
	if sprinkleColors then
		local colors = sprinkleColors
		local style = if opts.NoFace then "Jimmies" else look.Sprinkles
		local count = if opts.NoFace then 26 elseif style == "Nonpareils" then 20 elseif style == "Chunks" then 12 else 16
		-- Square: one each on a few glaze cells (none round the face), lined up with the grid
		local spots = {}
		if SQUARE then
			for x = -SQUARE_N, SQUARE_N do
				for y = -SQUARE_N, SQUARE_N do
					if glazeCells[cellKey(x, y)] and (opts.NoFace or math.abs(x) > 4 or y < 2) then
						table.insert(spots, Vector2.new(x, y))
					end
				end
			end
			for n = 1, math.min(count, #spots) do
				local spot = table.remove(spots, rng:NextInteger(1, #spots)) :: Vector2
				local color = colors[(n - 1) % #colors + 1]
				local sizeV = Vector3.new(0.26, 0.09, 0.07)
				if style == "Nonpareils" then
					sizeV = Vector3.new(0.14, 0.14, 0.08)
				elseif style == "Confetti" then
					sizeV = Vector3.new(0.22, 0.22, 0.05)
				elseif style == "Chunks" then
					sizeV = Vector3.new(0.22, 0.2, 0.14)
					color = if n % 3 == 0 then color else look.Accent:Lerp(Color3.new(0, 0, 0), 0.25)
				end
				local x, y = spot.X * CELL, spot.Y * CELL
				local turn = if rng:NextNumber() < 0.5 then 0 else math.pi / 2
				block(sizeV, color, at(x, y, squareFront(x, y) - sizeV.Z / 2 + 0.02) * CFrame.Angles(0, 0, turn), if special then Enum.Material.Neon else Enum.Material.SmoothPlastic, "Sprinkle")
			end
			count = 0
		end
		for n = 1, count do
			local angle
			repeat
				angle = rng:NextNumber(0, TAU)
			until (opts.NoFace or math.abs(angle - math.pi / 2) > 0.62) and (glazed(angle) and math.sin(angle) > HALF_DIP + 0.12 or look.Glaze ~= "HalfDip")
			local sprinkle = Instance.new("Part")
			sprinkle.Name = "Sprinkle"
			local color = colors[(n - 1) % #colors + 1]
			local cf = onGlaze(angle, rng:NextNumber(-1.0, 1.1), 0.0) * CFrame.Angles(0, 0, rng:NextNumber(0, TAU))
			if style == "Nonpareils" then
				sprinkle.Shape = Enum.PartType.Ball
				sprinkle.Size = Vector3.one * 0.16 * s
			elseif style == "Confetti" then
				sprinkle.Size = Vector3.new(0.24, 0.24, 0.05) * s
			elseif style == "Chunks" then
				sprinkle.Size = Vector3.new(0.24, 0.2, 0.16) * s
				cf *= CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(-0.4, 0.4), 0)
				color = if n % 3 == 0 then color else look.Accent:Lerp(Color3.new(0, 0, 0), 0.25)
			elseif STUDDED then
				sprinkle.Size = Vector3.new(0.34, 0.1, 0.07) * s -- (a neat little rod lying flat)
			else
				sprinkle.Shape = Enum.PartType.Cylinder
				sprinkle.Size = Vector3.new(0.4, 0.12, 0.12) * s
			end
			add(sprinkle, cf, color, if special then Enum.Material.Neon else Enum.Material.SmoothPlastic)
		end
	end

	-- A soft shine on the glaze (top left, beside the face)
	if mutation.Id ~= "Diamond" then
		-- (square: straight up the side, in line with the blocks)
		local gloss = ellipsoid(Vector3.new(0.85, 0.2, 0.05), WHITE, onGlaze(math.rad(150), -0.25, 0.012) * CFrame.Angles(0, 0, if SQUARE then math.pi / 2 else math.rad(150) + math.pi / 2), nil, "Gloss")
		gloss.Transparency = 0.55
	end

	-- Face: layered eyes (a dark rim, the white, a coloured iris, the pupil and two shines), cheeks
	-- and a mouth, all shaped by the donut's mood (DonutLooks): angry brows, sleepy lids, a toothy
	-- grin, a tongue sticking out, glowing ghost eyes, robot screen eyes...
	-- The client squashes the eye whites and rims ("EyeWhite") to blink, shifts the irises, pupils
	-- and shines ("Pupil") to look around, and opens the mouth (widens the middle, "Mouth" =
	-- "Middle", and hides the rest, "Mouth" = "Corner") when the donut jumps or dances.
	if not opts.NoFace then
		local eyesCovered = partsSet.Sunglasses or partsSet.Visor
		local EYE_Y = TOP - 0.66
		local mood = look.Mood
		local tiltCf = CFrame.Angles(0, 0, -look.Tilt)
		local DARK = rgb(45, 28, 32)
		local NEON = Enum.Material.Neon
		-- (x, y) on the face, turned with the head tilt about the middle of the face
		local function lean(x: number, y: number): (number, number)
			if look.Tilt == 0 then
				return x, y
			end
			local c, sn = math.cos(-look.Tilt), math.sin(-look.Tilt)
			local dy = y - (EYE_Y - 0.3)
			return x * c - dy * sn, EYE_Y - 0.3 + x * sn + dy * c
		end
		-- a point (u, v) in an eye centred on (ex, ey), `z` deep
		local function eyePoint(ex: number, ey: number, u: number, v: number, z: number): CFrame
			return at(ex, ey, z) * tiltCf * CFrame.new(u * s, v * s, 0)
		end
		local function onFace(x: number, y: number, lift: number): CFrame
			local lx, ly = lean(x, y)
			return face(lx, ly, lift) * tiltCf
		end
		local function tag(part: BasePart, key: string, value: any): BasePart
			part:SetAttribute(key, value)
			return part
		end
		local skin = crownColor:Lerp(Color3.new(0, 0, 0), 0.08) -- eyelids are glaze-coloured

		local function roundEye(side: number)
			local W, H = 0.62, 0.8
			if mood == "Fierce" or mood == "Mighty" then
				W, H = 0.66, 0.6
			elseif mood == "Spooky" then
				W, H = 0.66, 0.74
			elseif mood == "Robot" then
				W, H = 0.72, 0.46
			elseif mood == "Silly" then
				local k = if side < 0 then 1.15 else 0.86
				W, H = 0.62 * k, 0.8 * k
			end
			local ex, ey = lean(side * 0.5, EYE_Y + (if mood == "Fierce" or mood == "Mighty" then -0.05 else 0))
			local white = if mood == "Spooky" then rgb(25, 14, 36) elseif mood == "Robot" then rgb(14, 22, 34) else WHITE
			local rimColor = if mood == "Robot" then rgb(95, 100, 115) elseif mood == "Spooky" then rgb(8, 4, 12) else DARK
			if mood == "Robot" or mood == "Spooky" then
				-- a screen's metal bezel / a dark socket
				tag(ellipsoid(Vector3.new(W + 0.12, H + 0.12, 0.36), rimColor, eyePoint(ex, ey, 0, 0, CROWN_FRONT + 0.04), if mood == "Robot" then Enum.Material.Metal else nil, "EyeRim"), "EyeWhite", true)
			end
			tag(ellipsoid(Vector3.new(W, H, 0.36), white, eyePoint(ex, ey, 0, 0, CROWN_FRONT + 0.01), nil, "Eye"), "EyeWhite", true)
			local px = if mood == "Silly" then -side * 0.1 else -side * 0.04 -- looking a little inwards
			local k = W / 0.62
			if mood == "Robot" then
				tag(block(Vector3.new(W * 0.78, H * 0.36, 0.06), look.Iris, eyePoint(ex, ey, 0, 0, CROWN_FRONT - 0.19), NEON, "Pupil"), "Pupil", true)
				tag(block(Vector3.new(W * 0.26, H * 0.1, 0.05), WHITE, eyePoint(ex, ey, -W * 0.2, H * 0.06, CROWN_FRONT - 0.23), NEON, "Glint"), "Pupil", true)
			elseif mood == "Spooky" then
				tag(ellipsoid(Vector3.new(W * 0.5, H * 0.54, 0.06), look.Iris, eyePoint(ex, ey, px, -0.04, CROWN_FRONT - 0.19), NEON, "Pupil"), "Pupil", true)
				tag(ball(0.08, WHITE, eyePoint(ex, ey, px - 0.05, 0.05, CROWN_FRONT - 0.24), NEON, "Glint"), "Pupil", true)
			else
				tag(ellipsoid(Vector3.new(W * 0.7, H * 0.7, 0.06), look.Iris, eyePoint(ex, ey, px, -0.04, CROWN_FRONT - 0.19), if look.GlowEyes then NEON else nil, "Iris"), "Pupil", true)
				tag(ellipsoid(Vector3.new(W * 0.38, H * 0.42, 0.06), BLACK, eyePoint(ex, ey, px, -0.05, CROWN_FRONT - 0.22), nil, "Pupil"), "Pupil", true)
				if STUDDED then
					-- one square shine tucked into the pupil's top corner (the pixel-art eye)
					local gw = W * 0.15
					tag(block(Vector3.new(gw, gw, 0.05), WHITE, eyePoint(ex, ey, px - W * 0.19 + gw / 2 + 0.02, -0.05 + H * 0.21 - gw / 2 - 0.02, CROWN_FRONT - 0.26), NEON, "Glint"), "Pupil", true)
				else
					tag(ball(0.17 * k, WHITE, eyePoint(ex, ey, px - 0.08 * k, 0.09 * k, CROWN_FRONT - 0.26), NEON, "Glint"), "Pupil", true)
					tag(ball(0.08 * k, WHITE, eyePoint(ex, ey, px + 0.08 * k, -0.14 * k, CROWN_FRONT - 0.26), NEON, "Glint"), "Pupil", true)
				end
			end
			-- sleepy / cool / regal eyelids, lashes and brows
			local top = (H + 0.12) / 2
			local lid = if mood == "Dreamy" then 0.46 elseif mood == "Cool" then 0.38 elseif mood == "Royal" then 0.3 else 0
			if lid > 0 then
				local lh = (H + 0.12) * lid
				block(Vector3.new(W + 0.16, lh, 0.1), skin, eyePoint(ex, ey, 0, top - lh / 2 + 0.02, CROWN_FRONT - 0.31), nil, "EyeLid")
				block(Vector3.new(W + 0.18, 0.07, 0.11), DARK, eyePoint(ex, ey, 0, top - lh + 0.02, CROWN_FRONT - 0.315), nil, "LashLine")
				top -= lh
			end
			if look.Lashes then
				for i = 0, 1 do
					block(Vector3.new(0.22, 0.06, 0.08), DARK, eyePoint(ex, ey, side * (W / 2 + 0.04), top - i * 0.12, CROWN_FRONT - 0.3) * CFrame.Angles(0, 0, side * (0.6 - i * 0.45)), nil, "Lash")
				end
			end
			if mood == "Fierce" or mood == "Mighty" or mood == "Royal" or mood == "Silly" then
				local bw, bh, angle, rise = 0.66, 0.17, side * 0.38, 0.14
				if mood == "Mighty" then
					bw, bh, angle = 0.72, 0.2, side * 0.22
				elseif mood == "Royal" then
					bw, bh, angle = 0.5, 0.08, -side * 0.18
				elseif mood == "Silly" then
					bw, bh = 0.5, 0.1
					angle, rise = if side < 0 then side * 0.25 else 0, if side < 0 then 0.3 else 0.12
				end
				block(Vector3.new(bw, bh, 0.3), rgb(55, 32, 28), eyePoint(ex, ey, -side * 0.02, (H + 0.12) / 2 + rise, CROWN_FRONT - 0.03) * CFrame.Angles(0, 0, angle), nil, "Brow")
			end
		end

		for _, side in { -1, 1 } do
			if not eyesCovered and not (partsSet.EyePatch and side == 1) then
				roundEye(side)
			end
			if mood ~= "Fierce" and mood ~= "Mighty" and mood ~= "Spooky" and mood ~= "Robot" and mood ~= "Cool" then
				ellipsoid(Vector3.new(0.4, 0.22, 0.1), rgb(255, 120, 150), onFace(side * 0.9, TOP - 1.1, 0), nil, "Cheek").Transparency = 0.3
			end
		end

		if not partsSet.Mustache and not partsSet.Beak and not partsSet.Fangs then
			local mouthY = TOP - 1.2
			local dark = rgb(90, 30, 35)
			local pink = rgb(255, 120, 140)
			local function middle(part: BasePart)
				part:SetAttribute("Mouth", "Middle")
			end
			local function corner(part: BasePart)
				part:SetAttribute("Mouth", "Corner")
			end
			if mood == "Happy" then
				middle(ellipsoid(Vector3.new(0.44, 0.24, 0.1), dark, onFace(0, mouthY - 0.06, 0.02), nil, "Mouth"))
				corner(ellipsoid(Vector3.new(0.24, 0.1, 0.1), pink, onFace(0, mouthY - 0.12, 0.05), nil, "Tongue"))
				for _, side in { -1, 1 } do
					corner(ellipsoid(Vector3.new(0.14, 0.09, 0.1), dark, onFace(side * 0.25, mouthY + 0.03, 0.02) * CFrame.Angles(0, 0, side * math.rad(40)), nil, "Mouth"))
				end
			elseif mood == "Fierce" or mood == "Mighty" then
				local wide = if mood == "Fierce" then 0.62 else 0.5
				middle(block(Vector3.new(wide, if mood == "Fierce" then 0.22 else 0.17, 0.1), dark, onFace(0, mouthY - 0.04, 0.02), nil, "Mouth"))
				corner(block(Vector3.new(wide - 0.08, 0.07, 0.1), WHITE, onFace(0, mouthY + 0.02, 0.04), nil, "Teeth"))
				if mood == "Fierce" then
					for _, side in { -1, 1 } do
						corner(block(Vector3.new(0.08, 0.13, 0.1), WHITE, onFace(side * 0.17, mouthY - 0.04, 0.05), nil, "Teeth"))
					end
				end
			elseif mood == "Silly" then
				middle(ellipsoid(Vector3.new(0.4, 0.2, 0.1), dark, onFace(0.04, mouthY - 0.05, 0.02), nil, "Mouth"))
				corner(block(Vector3.new(0.22, 0.3, 0.1), pink, onFace(0.1, mouthY - 0.2, 0.05) * CFrame.Angles(0, 0, -0.25), nil, "Tongue"))
			elseif mood == "Cool" then
				middle(ellipsoid(Vector3.new(0.3, 0.09, 0.1), dark, onFace(0.06, mouthY - 0.02, 0.02) * CFrame.Angles(0, 0, 0.12), nil, "Mouth"))
				corner(ellipsoid(Vector3.new(0.16, 0.08, 0.1), dark, onFace(0.24, mouthY + 0.03, 0.02) * CFrame.Angles(0, 0, 0.6), nil, "Mouth"))
			elseif mood == "Spooky" then
				middle(ellipsoid(Vector3.new(0.26, 0.32, 0.1), rgb(20, 10, 25), onFace(0, mouthY - 0.08, 0.02), nil, "Mouth"))
			elseif mood == "Robot" then
				middle(block(Vector3.new(0.46, 0.08, 0.06), look.Iris, onFace(0, mouthY - 0.03, 0.03), NEON, "Mouth"))
				for _, side in { -1, 1 } do
					corner(block(Vector3.new(0.08, 0.08, 0.06), look.Iris, onFace(side * 0.27, mouthY + 0.03, 0.03), NEON, "Mouth"))
				end
			else
				-- a smile (smaller and calmer on dreamy and royal donuts)
				local small = mood == "Dreamy" or mood == "Royal"
				middle(ellipsoid(Vector3.new(if small then 0.2 else 0.28, if small then 0.09 else 0.11, 0.1), dark, onFace(0, mouthY - 0.035, 0.02), nil, "Mouth"))
				for _, side in { -1, 1 } do
					corner(ellipsoid(Vector3.new(if small then 0.16 else 0.22, if small then 0.08 else 0.1, 0.1), dark, onFace(side * (if small then 0.13 else 0.18), mouthY, 0.02) * CFrame.Angles(0, 0, side * math.rad(if small then 35 else 30)), nil, "Mouth"))
				end
			end
		end
	end

	-- Brainrot accessories
	local accessories = {}

	-- Legs, and feet that match the donut (DonutLooks): layered sneakers (sole, toe cap, stripe,
	-- laces), high-tops, boots with a buckle, paws with toe beans, hooves, claws, webbed feet, robot
	-- feet or sandals. Strong donuts have thicker legs.
	function accessories.Legs()
		local thick = if look.Muscles >= 2 then 0.5 elseif look.Muscles == 1 then 0.44 else 0.36
		local shoe, stripe, sole = look.Shoe, look.ShoeAccent, look.Sole
		for _, side in { -1, 1 } do
			local hipX, hipY = side * 0.55, -TOP + 0.2
			local x = side * 0.55
			local function leg(part: BasePart): BasePart
				return limb(part, "Leg", side, hipX, hipY, 0)
			end
			leg(block(Vector3.new(thick, 1.25, thick), doughColor, at(x, -TOP - 0.42, 0), nil, "Leg"))
			local feet = look.Feet
			if feet == "Plain" then
				-- (restyled by ballet slippers, flamingo legs...)
				leg(ellipsoid(Vector3.new(0.62, 0.46, 0.92), rgb(235, 50, 60), at(x, -TOP - 1.08, -0.16), nil, "Shoe"))
				leg(ellipsoid(Vector3.new(0.7, 0.2, 1.0), WHITE, at(x, -TOP - 1.24, -0.17), nil, "Sole"))
			elseif feet == "Sneakers" or feet == "HighTops" then
				local high = feet == "HighTops"
				leg(block(Vector3.new(0.72, 0.2, 1.04), sole, at(x, -TOP - 1.24, -0.17), nil, "Sole"))
				leg(block(Vector3.new(0.64, if high then 0.62 else 0.4, 0.92), shoe, at(x, -TOP - (if high then 0.95 else 1.04), -0.14), nil, "Shoe"))
				leg(block(Vector3.new(0.62, 0.24, 0.3), sole:Lerp(shoe, 0.12), at(x, -TOP - 1.1, -0.53), nil, "ToeCap"))
				leg(block(Vector3.new(0.68, 0.1, 0.5), stripe, at(x, -TOP - 1.02, -0.02), nil, "ShoeStripe"))
				if high then
					leg(block(Vector3.new(0.68, 0.14, 0.62), stripe, at(x, -TOP - 0.66, 0), nil, "Collar"))
				else
					leg(block(Vector3.new(0.34, 0.07, 0.3), WHITE, at(x, -TOP - 0.83, -0.36), nil, "Laces"))
				end
			elseif feet == "Boots" then
				leg(block(Vector3.new(0.72, 0.18, 1.0), sole, at(x, -TOP - 1.25, -0.16), nil, "Sole"))
				leg(block(Vector3.new(0.66, 0.44, 0.94), shoe, at(x, -TOP - 1.06, -0.15), nil, "Shoe"))
				leg(block(Vector3.new(0.6, 0.62, 0.62), shoe, at(x, -TOP - 0.62, 0.02), nil, "BootShaft"))
				leg(block(Vector3.new(0.68, 0.14, 0.68), shoe:Lerp(WHITE, 0.3), at(x, -TOP - 0.32, 0.02), nil, "BootCuff"))
				leg(block(Vector3.new(0.22, 0.16, 0.06), stripe, at(x, -TOP - 0.86, -0.31), Enum.Material.Foil, "Buckle"))
			elseif feet == "Paws" then
				leg(block(Vector3.new(0.66, 0.1, 0.78), sole, at(x, -TOP - 1.3, -0.16), nil, "Sole"))
				leg(block(Vector3.new(0.72, 0.46, 0.86), shoe, at(x, -TOP - 1.08, -0.16), nil, "Shoe"))
				for i = -1, 1 do
					leg(block(Vector3.new(0.16, 0.13, 0.06), stripe, at(x + i * 0.21, -TOP - 1.02, -0.61), nil, "ToeBean"))
				end
			elseif feet == "Hooves" then
				leg(block(Vector3.new(0.6, 0.46, 0.7), shoe, at(x, -TOP - 1.12, -0.08), nil, "Shoe"))
				leg(block(Vector3.new(0.7, 0.2, 0.78), stripe, at(x, -TOP - 0.86, -0.08), nil, "FurCuff"))
				leg(block(Vector3.new(0.06, 0.42, 0.06), sole, at(x, -TOP - 1.13, -0.44), nil, "HoofSplit"))
			elseif feet == "Claws" then
				leg(block(Vector3.new(0.68, 0.4, 0.84), shoe, at(x, -TOP - 1.14, -0.12), nil, "Shoe"))
				leg(block(Vector3.new(0.7, 0.12, 0.88), sole, at(x, -TOP - 0.95, -0.1), nil, "Scale"))
				for i = -1, 1 do
					leg(wedge(Vector3.new(0.14, 0.2, 0.3), stripe, at(x + i * 0.22, -TOP - 1.24, -0.68)))
				end
			elseif feet == "Webbed" then
				leg(block(Vector3.new(0.84, 0.16, 0.95), shoe, at(x, -TOP - 1.28, -0.2), nil, "Shoe"))
				for i = -1, 1, 2 do
					leg(block(Vector3.new(0.05, 0.18, 0.6), stripe, at(x + i * 0.2, -TOP - 1.27, -0.32), nil, "Webbing"))
				end
			elseif feet == "Robot" then
				leg(block(Vector3.new(0.74, 0.16, 1.02), sole, at(x, -TOP - 1.27, -0.16), nil, "Sole"))
				leg(block(Vector3.new(0.68, 0.4, 0.94), shoe, at(x, -TOP - 1.06, -0.15), Enum.Material.Metal, "Shoe"))
				leg(block(Vector3.new(0.7, 0.08, 0.5), stripe, at(x, -TOP - 1.0, -0.3), Enum.Material.Neon, "ShoeLight"))
				leg(ball(0.42, shoe:Lerp(WHITE, 0.2), at(x, -TOP - 0.8, 0), Enum.Material.Metal, "Ankle"))
			else -- Sandals
				leg(block(Vector3.new(0.7, 0.14, 1.0), sole, at(x, -TOP - 1.27, -0.16), nil, "Sole"))
				leg(block(Vector3.new(0.56, 0.26, 0.86), shoe, at(x, -TOP - 1.08, -0.15), nil, "Shoe"))
				for _, z in { -0.36, 0.04 } do
					leg(block(Vector3.new(0.62, 0.08, 0.14), stripe, at(x, -TOP - 0.98, z), nil, "Strap"))
				end
			end
		end
	end

	function accessories.Arms()
		local shoulderY = -0.25
		if look.Muscles > 0 then
			-- Flexing: a round shoulder, a big bicep, the forearm up, a sweatband and a fist
			local k = if look.Muscles >= 2 then 1.15 else 1
			local arm = doughColor
			local band = if look.Feet == "Boots" then rgb(225, 40, 50) else look.Shoe
			for _, side in { -1, 1 } do
				local shoulderX = side * (R + 0.74)
				local function piece(part: BasePart)
					limb(part, "Arm", side, shoulderX, shoulderY, -0.1)
				end
				piece(ball(0.6 * k, arm:Lerp(WHITE, 0.05), at(side * (R + 0.8), 0.02, -0.1), nil, "Shoulder"))
				piece(block(Vector3.new(1.0, 0.46 * k, 0.46 * k), arm, at(side * (R + 1.28), -0.12, -0.1) * CFrame.Angles(0, 0, side * -0.06), nil, "UpperArm"))
				piece(block(Vector3.new(0.62 * k, 0.5 * k, 0.52 * k), arm:Lerp(WHITE, 0.14), at(side * (R + 1.05), 0.2 + 0.08 * k, -0.12), nil, "Bicep"))
				piece(block(Vector3.new(0.42 * k, 0.7, 0.42 * k), arm:Lerp(Color3.new(0, 0, 0), 0.08), at(side * (R + 1.66), 0.2, -0.1) * CFrame.Angles(0, 0, side * -0.12), nil, "Forearm"))
				piece(block(Vector3.new(0.5 * k, 0.16, 0.5 * k), band, at(side * (R + 1.62), 0.56, -0.1), nil, "Wristband"))
				piece(ball(0.56 * k, WHITE, at(side * (R + 1.58), 0.84, -0.1), nil, "Glove"))
			end
			return
		end
		for _, side in { -1, 1 } do
			local cf = at(side * (R + 1.05), 0.2, -0.1) * CFrame.Angles(0, 0, side * math.rad(-35))
			-- The shoulder is the arm's inner end, where it meets the ring
			local shoulderX = side * (R + 0.74)
			limb(cylinder(1.1, 0.3, doughColor, cf), "Arm", side, shoulderX, shoulderY, -0.1)
			-- a cuff in the colour of its shoes, then the glove
			limb(block(Vector3.new(0.4, 0.16, 0.4), look.Shoe, at(side * (R + 1.29), 0.5, -0.1) * CFrame.Angles(0, 0, side * math.rad(-35)), nil, "Cuff"), "Arm", side, shoulderX, shoulderY, -0.1)
			limb(ball(0.52, WHITE, at(side * (R + 1.42), 0.72, -0.1), nil, "Glove"), "Arm", side, shoulderX, shoulderY, -0.1)
		end
	end

