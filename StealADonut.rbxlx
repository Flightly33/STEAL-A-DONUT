-- A gold coin
SHAPES.coin = {
	circle(0.5, 0.5, 0.78, { color = Color3.fromRGB(255, 200, 50) }),
	circle(0.5, 0.5, 0.46, { fill = Color3.fromRGB(240, 165, 30) }),
