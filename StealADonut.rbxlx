	{ Id = "CoralCrab", Name = "Coral Crab", Rarity = "Epic", Money = 0.1, Speed = 0.3, Shape = "Crab", Body = rgb(255, 110, 90), Accent = rgb(255, 220, 200), Features = { "Claws", "Antenna" } },
	{ Id = "TikiTurtle", Name = "Tiki Turtle", Rarity = "Legendary", Money = 0.5, Speed = 0.3, Shape = "Quad", Body = rgb(110, 190, 90), Accent = rgb(170, 110, 60), Features = { "Shell", "Leaf", "Glow", "TikiMask" } },
	{ Id = "KrakenJr", Name = "Kraken Jr.", Rarity = "Mythic", Money = 0.9, Speed = 0.5, Shape = "Blob", Body = rgb(170, 50, 120), Accent = rgb(80, 220, 255), Features = { "Tentacles", "Crown", "Glow" } },
	-- Dream Egg
	{ Id = "CloudSheep", Name = "Cloud Sheep", Rarity = "Epic", Money = 0.4, Speed = 0.3, Shape = "Quad", Body = rgb(250, 250, 255), Accent = rgb(255, 190, 225), Features = { "Fluff", "RoundEars" } },
	{ Id = "TeddyGhost", Name = "Teddy Ghost", Rarity = "Legendary", Money = 0.7, Speed = 0.4, Shape = "Blob", Body = rgb(235, 240, 255), Accent = rgb(170, 130, 255), Features = { "RoundEars", "Bow", "Ghost", "Glow" } },
	{ Id = "AngelBear", Name = "Angel Bear", Rarity = "Mythic", Money = 1.2, Speed = 0.6, Shape = "Quad", Body = rgb(255, 235, 200), Accent = rgb(255, 230, 120), Features = { "RoundEars", "Wings", "Halo", "Glow" } },
	{ Id = "DreamDragon", Name = "Dream Dragon", Rarity = "Secret", Money = 2, Speed = 1, Shape = "Dragon", Body = rgb(255, 200, 240), Accent = rgb(150, 220, 255), Features = { "Wings", "Horns", "Tail", "Halo", "Stars", "Rainbow", "Glow" } },
	-- Void Egg (ultra rare, anywhere from area 8)
	{ Id = "VoidImp", Name = "Void Imp", Rarity = "Legendary", Money = 0.8, Speed = 0.5, Shape = "Blob", Body = rgb(20, 10, 30), Accent = rgb(200, 60, 255), Features = { "Horns", "Wings", "Tail", "Glow" } },
	{ Id = "VoidSerpent", Name = "Void Serpent", Rarity = "Mythic", Money = 1.5, Speed = 0.8, Shape = "Dragon", Body = rgb(15, 5, 25), Accent = rgb(120, 255, 220), Features = { "Horns", "Tail", "Stars", "Glow" } },
	{ Id = "GlitchGod", Name = "Glitch God", Rarity = "Secret", Money = 3, Speed = 1.5, Shape = "Blob", Body = rgb(0, 0, 0), Accent = rgb(0, 255, 180), Features = { "Crown", "Halo", "Stars", "Rainbow", "Glitch", "Glow" }, Scale = 1.2 },
	-- Crate exclusives: the Royal Egg (Epic / Legendary crates) ...
	{ Id = "RoyalCorgi", Name = "Royal Corgi", Rarity = "Legendary", Money = 0.8, Speed = 0.4, Shape = "Quad", Body = rgb(240, 170, 90), Accent = rgb(255, 215, 60), Features = { "PointyEars", "PuffTail", "Crown", "Glow" }, Exclusive = "Royal Egg" },
	{ Id = "JesterMonkey", Name = "Jester Monkey", Rarity = "Legendary", Money = 0.5, Speed = 0.8, Shape = "Quad", Body = rgb(150, 95, 60), Accent = rgb(170, 60, 255), Features = { "RoundEars", "Tail", "Bow", "Glow", "JesterHat" }, Exclusive = "Royal Egg" },
	{ Id = "RoyalGriffin", Name = "Royal Griffin", Rarity = "Mythic", Money = 1.4, Speed = 0.9, Shape = "Bird", Body = rgb(245, 220, 150), Accent = rgb(255, 200, 40), Features = { "Beak", "Wings", "Crest", "Crown", "Glow" }, Exclusive = "Royal Egg" },
	{ Id = "CrownWhale", Name = "Crown Whale", Rarity = "Mythic", Money = 1.8, Speed = 0.6, Shape = "Whale", Body = rgb(60, 40, 140), Accent = rgb(255, 215, 60), Features = { "Crown", "Spout", "Stars", "Glow" }, Exclusive = "Royal Egg" },
	-- Cyber Egg (World 4: Cyber City)
	{ Id = "PixelPup", Name = "Pixel Pup", Rarity = "Epic", Money = 0.5, Speed = 0.3, Shape = "Quad", Body = rgb(40, 40, 60), Accent = rgb(255, 40, 200), Features = { "PointyEars", "Tail", "Glow", "Pixels" } },
	{ Id = "DroneBird", Name = "Drone Bird", Rarity = "Legendary", Money = 0.8, Speed = 0.6, Shape = "Bird", Body = rgb(150, 155, 165), Accent = rgb(0, 230, 255), Features = { "Beak", "Wings", "Antenna", "Glow", "Rotors" } },
	{ Id = "MechaCat", Name = "Mecha Cat", Rarity = "Mythic", Money = 1.6, Speed = 0.9, Shape = "Quad", Body = rgb(60, 62, 70), Accent = rgb(255, 190, 0), Features = { "PointyEars", "Tail", "Antenna", "Glow", "MetalPlates" } },
	{ Id = "NeonOverlord", Name = "Neon Overlord", Rarity = "Secret", Money = 3, Speed = 1.5, Shape = "Dragon", Body = rgb(20, 20, 35), Accent = rgb(255, 40, 200), Features = { "Wings", "Horns", "Tail", "Crown", "Glitch", "Glow", "NeonStripes" }, Scale = 1.15 },
	-- ... and one pet that only comes straight out of a Legendary Crate.
	{ Id = "CrateKing", Name = "Crate King", Rarity = "Secret", Money = 3, Speed = 1.5, Shape = "Dragon", Body = rgb(255, 200, 40), Accent = rgb(255, 60, 60), Features = { "Wings", "Horns", "Tail", "Crown", "Halo", "Rainbow", "Glow", "CrateBox" }, Scale = 1.15, Exclusive = "Legendary Crate" },
} :: { Pet }

Pets.Eggs = {
	{
		Id = "Sprinkle", Name = "Sprinkle Egg", MinArea = 3, MaxArea = 8, Weight = 100, HatchSeconds = 180, Tier = 1,
		Color = rgb(255, 170, 215), Accent = rgb(255, 255, 255),
		Pool = { { Pet = "GlazePup", Weight = 45 }, { Pet = "SprinkleKitty", Weight = 30 }, { Pet = "ChocoBunny", Weight = 18 }, { Pet = "DonutDuck", Weight = 7 } },
	},
	{
		Id = "Frosted", Name = "Frosted Egg", MinArea = 5, MaxArea = 10, Weight = 60, HatchSeconds = 480, Tier = 2,
		Color = rgb(170, 225, 255), Accent = rgb(255, 255, 255),
		Pool = { { Pet = "FrostPenguin", Weight = 45 }, { Pet = "SnowFox", Weight = 30 }, { Pet = "IceOwl", Weight = 18 }, { Pet = "YetiCub", Weight = 7 } },
	},
	{
		Id = "Molten", Name = "Molten Egg", MinArea = 6, MaxArea = 12, Weight = 40, HatchSeconds = 900, Tier = 3,
		Color = rgb(70, 40, 35), Accent = rgb(255, 120, 0),
		Pool = { { Pet = "EmberLizard", Weight = 45 }, { Pet = "MagmaHound", Weight = 32 }, { Pet = "FirePhoenix", Weight = 17 }, { Pet = "LavaDragon", Weight = 6 } },
	},
	{
		Id = "Cosmic", Name = "Cosmic Egg", MinArea = 8, MaxArea = 14, Weight = 25, HatchSeconds = 1800, Tier = 4,
		Color = rgb(40, 20, 90), Accent = rgb(150, 220, 255),
		Pool = { { Pet = "StarJelly", Weight = 48 }, { Pet = "NebulaCat", Weight = 33 }, { Pet = "GalaxyWhale", Weight = 16 }, { Pet = "CosmicUnicorn", Weight = 3 } },
	},
	{
		Id = "Tropical", Name = "Tropical Egg", MinArea = 4, MaxArea = 12, Weight = 35, HatchSeconds = 2700, Tier = 4,
		Color = rgb(255, 220, 120), Accent = rgb(0, 200, 190),
		Pool = { { Pet = "ParrotPal", Weight = 48 }, { Pet = "CoralCrab", Weight = 33 }, { Pet = "TikiTurtle", Weight = 16 }, { Pet = "KrakenJr", Weight = 3 } },
	},
	{
		Id = "Dream", Name = "Dream Egg", MinArea = 11, MaxArea = 15, Weight = 35, HatchSeconds = 3600, Tier = 5,
		Color = rgb(255, 235, 250), Accent = rgb(190, 150, 255),
		Pool = { { Pet = "CloudSheep", Weight = 55 }, { Pet = "TeddyGhost", Weight = 32 }, { Pet = "AngelBear", Weight = 12 }, { Pet = "DreamDragon", Weight = 1 } },
	},
	{
		Id = "Void", Name = "Void Egg", MinArea = 7, MaxArea = 17, Weight = 3, HatchSeconds = 5400, Tier = 6, Rainbow = true,
		Color = rgb(10, 5, 20), Accent = rgb(200, 80, 255),
		Pool = { { Pet = "VoidImp", Weight = 70 }, { Pet = "VoidSerpent", Weight = 28 }, { Pet = "GlitchGod", Weight = 2 } },
	},
	{
		Id = "Cyber", Name = "Cyber Egg", MinArea = 12, MaxArea = 17, Weight = 35, HatchSeconds = 4500, Tier = 5,
		Color = rgb(30, 30, 45), Accent = rgb(255, 40, 200),
		Pool = { { Pet = "PixelPup", Weight = 55 }, { Pet = "DroneBird", Weight = 32 }, { Pet = "MechaCat", Weight = 12 }, { Pet = "NeonOverlord", Weight = 1 } },
	},
	{
		Id = "Royal", Name = "Royal Egg", MinArea = 0, MaxArea = 0, Weight = 0, HatchSeconds = 1200, Tier = 6, CrateOnly = true,
		Color = rgb(255, 205, 50), Accent = rgb(170, 60, 255),
		Pool = { { Pet = "RoyalCorgi", Weight = 40 }, { Pet = "JesterMonkey", Weight = 35 }, { Pet = "RoyalGriffin", Weight = 17 }, { Pet = "CrownWhale", Weight = 8 } },
	},
} :: { Egg }

Pets.ById = {} :: { [string]: Pet }
for _, pet in Pets.List do
	assert(Pets.ById[pet.Id] == nil, "Duplicate pet id: " .. pet.Id)
	Pets.ById[pet.Id] = pet
end
Pets.EggById = {} :: { [string]: Egg }
for _, egg in Pets.Eggs do
	Pets.EggById[egg.Id] = egg
	for _, entry in egg.Pool do
		assert(Pets.ById[entry.Pet], `Egg {egg.Id} has unknown pet {entry.Pet}`)
	end
end
Pets.RarityById = {} :: { [string]: PetRarity }
for _, rarity in Pets.Rarities do
	Pets.RarityById[rarity.Id] = rarity
end

function Pets.Rarity(id: string): PetRarity
	return Pets.RarityById[id] or Pets.Rarities[1]
end

function Pets.HasFeature(pet: Pet, feature: string): boolean
	return table.find(pet.Features, feature) ~= nil
end

-- Eggs that can show up in an area.
function Pets.EggsForArea(areaId: number): { Egg }
	local result = {}
	for _, egg in Pets.Eggs do
		if not egg.CrateOnly and areaId >= egg.MinArea and areaId <= egg.MaxArea then
			table.insert(result, egg)
		end
	end
	return result
end

function Pets.RollEgg(areaId: number, rng: Random): Egg?
	local pool = Pets.EggsForArea(areaId)
	local total = 0
	for _, egg in pool do
		total += egg.Weight
	end
	if total <= 0 then
		return nil
	end
	local pick = rng:NextNumber() * total
	for _, egg in pool do
		pick -= egg.Weight
		if pick <= 0 then
			return egg
		end
	end
	return pool[#pool]
end

function Pets.RollPet(egg: Egg, rng: Random): Pet
	local total = 0
	for _, entry in egg.Pool do
		total += entry.Weight
	end
	local pick = rng:NextNumber() * total
	for _, entry in egg.Pool do
		pick -= entry.Weight
		if pick <= 0 then
			return Pets.ById[entry.Pet]
		end
	end
	return Pets.ById[egg.Pool[#egg.Pool].Pet]
end

-- Chance (0-1) of an egg hatching into a pet.
function Pets.Chance(egg: Egg, petId: string): number
	local total, weight = 0, 0
	for _, entry in egg.Pool do
		total += entry.Weight
		if entry.Pet == petId then
			weight = entry.Weight
		end
	end
	return if total > 0 then weight / total else 0
end

-- The egg a pet comes from.
function Pets.EggOf(petId: string): Egg?
	for _, egg in Pets.Eggs do
		for _, entry in egg.Pool do
			if entry.Pet == petId then
				return egg
			end
		end
	end
	return nil
end

-- "+25% money • +10% speed"
function Pets.BonusText(pet: Pet): string
	local parts = {}
	if pet.Money > 0 then
		table.insert(parts, `+{math.floor(pet.Money * 100 + 0.5)}% money`)
	end
	if pet.Speed > 0 then
		table.insert(parts, `+{math.floor(pet.Speed * 100 + 0.5)}% speed`)
	end
	return table.concat(parts, " • ")
end

return Pets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Rarities</string>
          <string name="Source"><![CDATA[--[[
	Rarities, Mutations and Sizes.

	Every donut that spawns has:
	  * a base RARITY (from Donuts.luau)       Common ... Secret, Admin, Icon
	  * a MUTATION (rolled on spawn, rare)     None / Gold / Diamond / Mythic / Divine / Rainbow
	                                           (+ Eternal, only from the Eternal Storm event)
	  * a SIZE (rolled on spawn)               Small / Normal / Big / Huge / Giant

	Income = base income x mutation multiplier x size multiplier x upgrade level.
	Bigger donuts slow you down while you carry them (CarrySpeed).

	Rarity effects (they stack up the rarer a donut is; Legendary+ also sparkle and get a glowing ring
	on the ground in the lane):
		Shine      -> glossy frosting
		Light      -> PointLight in the rarity colour
		Particles  -> particle aura (rate)
		Rainbow    -> frosting cycles through colours (client side)
		Float      -> donut bobs and spins (client side)
		Halo       -> glowing ring above the donut
		Beam       -> light pillar under the donut (lane only, so you can spot it from afar)
		Orbit      -> little glowing orbs circling it
]]

export type Rarity = {
	Id: string,
	Order: number,
	Color: Color3,
	Shine: boolean?,
	Light: number?,
	Particles: number?,
	Rainbow: boolean?,
	Float: boolean?,
	Halo: boolean?,
	Beam: boolean?,
	Orbit: boolean?,
	AdminOnly: boolean?, -- never spawns by itself: only the admin panel can make one
	IndexReward: { Cash: number, Speed: number? },
}

export type Mutation = {
	Id: string,
	Order: number,
	Multiplier: number,
	Chance: number, -- per spawn (before event luck)
	Color: Color3,
	Dough: Color3?,
	Frosting: Color3?,
	Material: Enum.Material?,
	Particles: number?,
	Rainbow: boolean?,
	Halo: boolean?,
	Wings: boolean?,
	Horns: boolean?,
	Light: number?,
	EventOnly: boolean?, -- never rolled on a spawn (Eternal: only the Eternal Storm gives it)
}

export type Size = {
	Id: string,
	Order: number,
	Scale: number,
	Multiplier: number,
	Weight: number,
	CarrySpeed: number, -- WalkSpeed multiplier while you carry it
}

local Rarities = {}

--------------------------------------------------------------------------------
-- Base rarities. IndexReward: what you can claim in the Index once you've found the donut.
--   Cash  -> this many seconds of the donut's base income
--   Speed -> (Epic and up) you can pick this permanent % bonus to treadmill gains INSTEAD of the cash
--------------------------------------------------------------------------------
Rarities.List = {
	{ Id = "Common", Order = 1, Color = Color3.fromRGB(215, 215, 215), IndexReward = { Cash = 300 } },
	{ Id = "Uncommon", Order = 2, Color = Color3.fromRGB(85, 225, 90), IndexReward = { Cash = 450 } },
	-- (early game: Common - Rare are plain donuts, Epic only glows a little; the big effects start at
	-- Legendary and get wilder from there - see FXThemes)
	{ Id = "Rare", Order = 3, Color = Color3.fromRGB(55, 150, 255), Shine = true, IndexReward = { Cash = 600 } },
	{ Id = "Epic", Order = 4, Color = Color3.fromRGB(190, 70, 255), Shine = true, Light = 6, Particles = 3, IndexReward = { Cash = 900, Speed = 1 } },
	{ Id = "Legendary", Order = 5, Color = Color3.fromRGB(255, 190, 25), Shine = true, Light = 10, Particles = 14, Float = true, Beam = true, IndexReward = { Cash = 1200, Speed = 2 } },
	{ Id = "Celestial", Order = 6, Color = Color3.fromRGB(255, 110, 255), Shine = true, Light = 13, Particles = 24, Rainbow = true, Float = true, Halo = true, Beam = true, Orbit = true, IndexReward = { Cash = 1800, Speed = 4 } },
	{ Id = "Secret", Order = 7, Color = Color3.fromRGB(255, 255, 255), Shine = true, Light = 16, Particles = 40, Rainbow = true, Float = true, Halo = true, Beam = true, Orbit = true, IndexReward = { Cash = 3600, Speed = 8 } },
	-- Rarer than Secret: one per world, a fraction of a percent of a percent per spawn.
	{ Id = "Admin", Order = 8, Color = Color3.fromRGB(255, 40, 40), Shine = true, Light = 22, Particles = 60, Float = true, Halo = true, Beam = true, Orbit = true, AdminOnly = true, IndexReward = { Cash = 7200, Speed = 15 } },
	-- The rarest of all: a handful of legendary one-offs (the first is Fake Kar, in The Black Hole).
	{ Id = "Icon", Order = 9, Color = Color3.fromRGB(40, 140, 255), Shine = true, Light = 26, Particles = 80, Float = true, Halo = true, Beam = true, Orbit = true, IndexReward = { Cash = 14400, Speed = 25 } },
} :: { Rarity }

--------------------------------------------------------------------------------
-- Mutations: rolled on every spawn. Chances are per spawn; area events and the Luck Event multiply
-- them. Gold 0.6%, Diamond 0.25%, Mythic 0.08%, Divine 0.02%, Rainbow 0.006% (1 in ~17,000).
-- Eternal never rolls: only the Eternal Storm's purple lightning gives it (EventService).
--------------------------------------------------------------------------------
Rarities.Mutations = {
	{ Id = "None", Order = 0, Multiplier = 1, Chance = 0, Color = Color3.fromRGB(255, 255, 255) },
	{ Id = "Gold", Order = 1, Multiplier = 2, Chance = 0.006, Color = Color3.fromRGB(255, 205, 40), Dough = Color3.fromRGB(230, 170, 40), Frosting = Color3.fromRGB(255, 215, 60), Material = Enum.Material.Foil, Light = 5 },
	{ Id = "Diamond", Order = 2, Multiplier = 3, Chance = 0.0025, Color = Color3.fromRGB(120, 230, 255), Dough = Color3.fromRGB(170, 230, 255), Frosting = Color3.fromRGB(200, 250, 255), Material = Enum.Material.Glass, Particles = 4, Light = 7 },
	{ Id = "Mythic", Order = 3, Multiplier = 5, Chance = 0.0008, Color = Color3.fromRGB(255, 45, 85), Dough = Color3.fromRGB(60, 20, 30), Frosting = Color3.fromRGB(255, 40, 70), Material = Enum.Material.Neon, Particles = 18, Horns = true, Light = 10 },
	{ Id = "Divine", Order = 4, Multiplier = 10, Chance = 0.0002, Color = Color3.fromRGB(255, 250, 200), Dough = Color3.fromRGB(255, 240, 200), Frosting = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Neon, Particles = 25, Halo = true, Wings = true, Light = 14 },
	{ Id = "Rainbow", Order = 5, Multiplier = 25, Chance = 0.00006, Color = Color3.fromRGB(255, 120, 255), Particles = 35, Rainbow = true, Halo = true, Light = 16 },
	{ Id = "Eternal", Order = 6, Multiplier = 50, Chance = 0, Color = Color3.fromRGB(175, 70, 255), Dough = Color3.fromRGB(45, 15, 70), Frosting = Color3.fromRGB(200, 110, 255), Material = Enum.Material.Neon, Particles = 30, Halo = true, Light = 20, EventOnly = true },
} :: { Mutation }

--------------------------------------------------------------------------------
-- Sizes: bigger = more money but slower to carry home.
--------------------------------------------------------------------------------
Rarities.Sizes = {
	{ Id = "Small", Order = 1, Scale = 0.75, Multiplier = 0.6, Weight = 22, CarrySpeed = 1 },
	{ Id = "Normal", Order = 2, Scale = 1, Multiplier = 1, Weight = 55, CarrySpeed = 1 },
	{ Id = "Big", Order = 3, Scale = 1.3, Multiplier = 1.8, Weight = 16, CarrySpeed = 0.95 },
	{ Id = "Huge", Order = 4, Scale = 1.65, Multiplier = 3.5, Weight = 6, CarrySpeed = 0.9 },
	{ Id = "Giant", Order = 5, Scale = 2.1, Multiplier = 7, Weight = 1, CarrySpeed = 0.84 },
} :: { Size }

Rarities.ById = {} :: { [string]: Rarity }
for _, rarity in Rarities.List do
	Rarities.ById[rarity.Id] = rarity
end
Rarities.MutationById = {} :: { [string]: Mutation }
for _, mutation in Rarities.Mutations do
	Rarities.MutationById[mutation.Id] = mutation
end
Rarities.SizeById = {} :: { [string]: Size }
for _, size in Rarities.Sizes do
	Rarities.SizeById[size.Id] = size
end

function Rarities.Get(id: string): Rarity
	return Rarities.ById[id] or Rarities.List[1]
end

function Rarities.Mutation(id: string?): Mutation
	return Rarities.MutationById[id or "None"] or Rarities.Mutations[1]
end

function Rarities.Size(id: string?): Size
	return Rarities.SizeById[id or "Normal"] or Rarities.Sizes[2]
end

-- Roll a mutation. `luck` multiplies every chance and `boost` names one mutation that gets an extra
-- x5 (area events use both).
function Rarities.RollMutation(rng: Random, luck: number?, boost: string?): Mutation
	local roll = rng:NextNumber()
	local l = luck or 1
	-- Rarest first so a lucky roll lands on the best mutation.
	for i = #Rarities.Mutations, 2, -1 do
		local mutation = Rarities.Mutations[i]
		local chance = mutation.Chance * l * (if mutation.Id == boost then 5 else 1)
		if roll < chance then
			return mutation
		end
		roll -= chance
	end
	return Rarities.Mutations[1]
end

-- Roll a size. `bigLuck` multiplies the chance of every size bigger than Normal (Luck Event).
function Rarities.RollSize(rng: Random, bigLuck: number?): Size
	local luck = bigLuck or 1
	local function weight(size: Size): number
		return if size.Order > 2 then size.Weight * luck else size.Weight
	end
	local total = 0
	for _, size in Rarities.Sizes do
		total += weight(size)
	end
	local pick = rng:NextNumber() * total
	for _, size in Rarities.Sizes do
		pick -= weight(size)
		if pick <= 0 then
			return size
		end
	end
	return Rarities.Sizes[2]
end

-- "Giant Gold Glazino", "Glazino", "Huge Rainbow ..."
function Rarities.DisplayName(baseName: string, mutationId: string?, sizeId: string?): string
	local parts = {}
	if sizeId and sizeId ~= "Normal" then
		table.insert(parts, sizeId)
	end
	if mutationId and mutationId ~= "None" then
		table.insert(parts, mutationId)
	end
	table.insert(parts, baseName)
	return table.concat(parts, " ")
end

return Rarities
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	All RemoteEvents / RemoteFunctions in one place. The server creates them, the client waits for them.

	Server -> Client
		Notify(text, kind)                 toast message ("info" | "success" | "error" | "rare")
		State(snapshot)                    tables that don't fit in attributes (passes, skins, index...)
		ChaseStarted(info)                 you grabbed a box (or an egg) and a guard is after you
		ChaseEnded(result)                 "Safe" | "Caught" | "Deposited" | "Lost"
		OfflineEarnings(amount, seconds)
		LeaderboardUpdated(boardId)
		AreaAnnouncement(text, color)      big server-wide banner (rare spawns / rare steals)
		Flung(velocity)                    you got hit by a weapon/trap: client launches itself
		EggHatched(info)                   { EggId, PetId, Uid } - play the hatch animation
		AdminPanel()                       open the admin panel (you typed the code)
		CrateOpened(info)                  { Crate, Kind, Amount?, Seconds?, Egg?, Pet? } - play the opening
		BoxesReset()                       every biome's boxes were just replaced ("ALL BOXES RESET!")
		BoxOpened(info)                    a box in a pen opened: { Owner, Slot, DonutId, Mutation, Size }
		SkipOdds(info)                     "Open now" on your box: { Slot, Area, Tier, Size, Mutation } - show its odds first
		Meteor(info)                       the Cosmic Meteor: { Position, StartAt (server time), Seed, Area } - play the show
		CosmicCrafted(info)                you crafted The Cosmic Donut: { Shards } - celebrate

	Client -> Server
		Action(name, arg)                  shop purchases, equip skin, run speed, teleport home...
		ClientReady()                      UI is built; server then sends welcome-back popup etc.
		GetLeaderboard(boardId) -> data    (RemoteFunction)
		GetGlobalStats() -> stats          (RemoteFunction) spawn / found counts of every donut
		GetSellList() -> { SellItem }      (RemoteFunction) your inventory + pen donuts and their prices (UI/Sell)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- NOTE: the folder must NOT sit next to this ModuleScript under the same name ("Remotes"),
-- otherwise the client's WaitForChild finds this script instead of the folder and hangs forever.
local FOLDER_NAME = "GameRemotes"

local EVENTS = { "Notify", "State", "ChaseStarted", "ChaseEnded", "OfflineEarnings", "LeaderboardUpdated", "AreaAnnouncement", "Action", "ClientReady", "Flung", "EggHatched", "AdminPanel", "CrateOpened", "StormBlock", "StormStrike", "BoxesReset", "BoxOpened", "SkipOdds", "Meteor", "CosmicCrafted" }
local FUNCTIONS = { "GetLeaderboard", "GetGlobalStats", "GetSellList" }

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	for _, name in EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	for _, name in FUNCTIONS do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

function Remotes.Event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Roam</string>
          <string name="Source"><![CDATA[--[[
	Roam: where a donut in a base pen is at any moment (bases are open pens where donuts wander
	around, like Steal an Egg).

	The server (to check that a thief is really next to a donut) and every client (which moves the
	donuts: client/DonutIdle.luau) work it out from the same numbers and the shared server clock
	(workspace:GetServerTimeNow()), so everyone sees every donut in the same place and nothing is
	sent over the network.

	Each donut wanders around the middle of its own patch of the pen (Home, within Radius, never
	past the pen's fence). Its time is cut into legs of a few seconds: it stands still for a while
	(doing its idle animations), turns, and walks to the next spot just in time for the next leg.
	The spots come from an integer hash of its seed and the leg number, so every device gets exactly
	the same ones.
]]

local Roam = {}

export type Params = {
	Seed: number,
	Home: Vector3, -- plot space, on the ground
	Radius: number,
	Speed: number, -- studs per second
	Min: Vector2, -- the pen (plot space X, Z) minus a margin: donuts never walk past it
	Max: Vector2,
}

export type State = {
	Position: Vector3, -- plot space, on the ground
	Yaw: number, -- facing (plot space; 0 = towards the front of the base)
	Walk: number, -- studs walked so far in this stride (0 while standing)
	Moving: boolean,
}

local TWO32 = 4294967296
local TURN = 0.7 -- seconds spent turning before setting off
local TAU = math.pi * 2

-- 32-bit multiply without losing precision in a double.
local function mul32(a: number, b: number): number
	local low, high = a % 65536, a // 65536
	return (low * b + ((high * b) % 65536) * 65536) % TWO32
end

-- A number in [0, 1) from three integers (the murmur3 finaliser): the same on every device.
local function hash(seed: number, leg: number, k: number): number
	local h = (seed % 1000003) * 2654 + (leg % 65536) * 7919 + k * 104729
	h = h % TWO32
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = mul32(h, 0x85ebca6b)
	h = bit32.bxor(h, bit32.rshift(h, 13))
	h = mul32(h, 0xc2b2ae35)
	h = bit32.bxor(h, bit32.rshift(h, 16))
	return h / TWO32
end

local function legLength(p: Params): number
	return 4 + 3 * hash(p.Seed, 0, 91)
end

-- Where the donut is headed at the end of leg `leg`.
local function waypoint(p: Params, leg: number): Vector3
	local r = p.Radius * math.sqrt(hash(p.Seed, leg, 1))
	local angle = TAU * hash(p.Seed, leg, 2)
	local x = math.clamp(p.Home.X + math.cos(angle) * r, p.Min.X, p.Max.X)
	local z = math.clamp(p.Home.Z + math.sin(angle) * r, p.Min.Y, p.Max.Y)
	return Vector3.new(x, 0, z)
end

local function yawOf(direction: Vector3, fallback: number): number
	if direction.Magnitude < 0.05 then
		return fallback
	end
	return math.atan2(-direction.X, -direction.Z)
end

-- Turn from angle a to angle b the short way round, `alpha` of the way.
local function turnBetween(a: number, b: number, alpha: number): number
	local delta = (b - a + math.pi) % TAU - math.pi
	return a + delta * alpha
end

function Roam.At(p: Params, now: number): State
	local length = legLength(p)
	local shifted = now + hash(p.Seed, 1, 92) * length
	local leg = math.floor(shifted / length)
	local into = shifted - leg * length

	local from = waypoint(p, leg - 1)
	local to = waypoint(p, leg)
	local before = waypoint(p, leg - 2)
	local offset = to - from
	local distance = offset.Magnitude
	local previousYaw = yawOf(from - before, 0)
	local yaw = yawOf(offset, previousYaw)

	-- Walk at Speed, but always arrive before the leg ends
	local walkTime = math.min(distance / math.max(p.Speed, 0.1), length - TURN - 0.5)
	local setOff = length - walkTime
	if into < setOff - TURN or distance < 0.05 then
		return { Position = from, Yaw = previousYaw, Walk = 0, Moving = false }
	elseif into < setOff then
		local alpha = (into - (setOff - TURN)) / TURN
		alpha = alpha * alpha * (3 - 2 * alpha)
		return { Position = from, Yaw = turnBetween(previousYaw, yaw, alpha), Walk = 0, Moving = false }
	end
	local alpha = math.clamp((into - setOff) / walkTime, 0, 1)
	-- ease in and out so it doesn't start or stop dead
	local eased = alpha * alpha * (3 - 2 * alpha)
	return { Position = from + offset * eased, Yaw = yaw, Walk = distance * eased, Moving = alpha < 1 }
end

return Roam
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--[[
	Minimal signal (event) implementation for module-to-module communication.
]]

export type Connection = { Disconnect: (self: Connection) -> () }

local Signal = {}
Signal.__index = Signal

export type Signal = typeof(setmetatable({} :: { _handlers: { { fn: (...any) -> (), connected: boolean } } }, Signal))

function Signal.new(): Signal
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal.Connect(self: Signal, fn: (...any) -> ()): Connection
	local entry = { fn = fn, connected = true }
	table.insert(self._handlers, entry)
	local handlers = self._handlers
	return {
		Disconnect = function()
			entry.connected = false
			local index = table.find(handlers, entry)
			if index then
				table.remove(handlers, index)
			end
		end,
	}
end

function Signal.Fire(self: Signal, ...: any)
	for _, entry in table.clone(self._handlers) do
		if entry.connected then
			task.spawn(entry.fn, ...)
		end
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Trails</string>
          <string name="Source"><![CDATA[--[[
	Trails: an effect behind you while you run, drawn by every client (client/TrailFX). Pick one in
	the Trails window (HUD). The server keeps what you own (Data.OwnedTrails) and what you wear
	(Data.EquippedTrail, shown to everyone as the player's "Trail" attribute).

	UnlockBiome: the trail unlocks for good the first time your Speed is enough to get into that
	biome (the HUD shows a "!" on the Trails button, and it's put on for you if you wear none).

	Cost: a trail with a Cost is bought with in-game money (Trails window -> BUY, ShopService BuyTrail)
	and is yours for good. Fast Guy costs $100M.

	Fast Guy: you run so fast you leave frozen frames of yourself behind - 24 a second, glowing
	blue-white afterimages - a streak of light, and now and then a pane of glass that cracks and
	shatters behind you.
]]

local Areas = require(script.Parent.Areas)

export type Trail = {
	Id: string,
	Name: string,
	Icon: string,
	Description: string,
	Color: Color3, -- the afterimages / streak
	Accent: Color3, -- outlines and glass edges
	UnlockBiome: number?, -- unlocks for good when your Speed gets you into this biome
	Cost: number?, -- in-game money to buy it in the Trails window (nil = not for sale)
	Order: number,
}

local Trails = {}

Trails.List = {
	{
		Id = "FastGuy",
		Name = "Fast Guy",
		Icon = "💨",
		Description = "Run so fast you leave frozen frames of yourself behind, and the air cracks like glass.",
		Color = Color3.fromRGB(165, 215, 255),
		Accent = Color3.fromRGB(255, 255, 255),
		Cost = 100_000_000,
		Order = 1,
	},
} :: { Trail }

Trails.ById = {} :: { [string]: Trail }
for _, trail in Trails.List do
	Trails.ById[trail.Id] = trail
end

-- You have to be running at least this fast (studs a second) for a trail to show.
Trails.MinSpeed = 30

-- The Speed stat that unlocks a trail (nil = it isn't unlocked by Speed).
function Trails.RequiredSpeed(trail: Trail): number?
	local area = trail.UnlockBiome and Areas.List[trail.UnlockBiome]
	return if area then area.RecommendedSpeed else nil
end

function Trails.IsUnlocked(trail: Trail, owned: { [string]: boolean }?, bestSpeed: number): boolean
	if owned and owned[trail.Id] then
		return true
	end
	local need = Trails.RequiredSpeed(trail)
	return need ~= nil and bestSpeed >= need
end

return Trails
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">UpdateNotes</string>
          <string name="Source"><![CDATA[--[[
	UpdateNotes: the Update Log that pops up every time a player joins (UI/UpdateNotes).

	PUBLISHING AN UPDATE? Add a new entry at the TOP of UpdateNotes.List with the next Version number.
	It shows on every join (a brand-new player's tutorial starts once they close it). The 📰 UPDATES
	button on the side shows every update any time.

	  Version  - goes up by one every update (1, 2, 3...)
	  Name     - the update's name, big under the game's logo
	  Date     - shown after "Update N Patch Notes"
	  Color    - the window's background colour; Accent - the headings' colour
	  Decor    - what floats around the notes: "Rise" (golden diamonds and sparkles drifting up),
	             "Embers" (sparks rising from a lava glow), "Stars" (twinkling stars, shooting stars
	             and a slowly turning swirl) or "Sparkles" (soft glowing bubbles)
	  Emblem   - the 3D donut in the top-left corner: { Frosting = colour, Sprinkles = { colours },
	             Dough = colour (optional) }. Its ring and the window's border use Color and Accent.
	  Sections - the patch notes: a heading, a small tag under it and bullet lines
	             { Title = "The Black Hole", Tag = "NEW Area", Lines = { "...", "..." } }
	             (the box at the top lists every section's Title)
	  Sidebar  - groups of new things shown as spinning 3D cards, built from the game's own models (no
	             images to upload, so nothing for Roblox to moderate). Kind is "Donut", "Pet" or "Egg";
	             Id is the id in Donuts.luau / Pets.luau.
	             { Title = "7 New Donuts", Items = { { Kind = "Donut", Id = "fakekar" }, ... } }
	             Hovering a card (tapping it on a phone) shows its details: rarity, stats, odds and
	             where to get it. Add Note = "..." to an item to put an extra line on that card.
]]

export type Item = { Kind: string, Id: string, Note: string? }
export type Emblem = { Frosting: Color3, Sprinkles: { Color3 }, Dough: Color3? }
export type Section = { Title: string, Tag: string, Lines: { string } }
export type Group = { Title: string, Items: { Item } }
export type Update = {
	Version: number,
	Name: string,
	Date: string,
	Color: Color3,
	Accent: Color3,
	Decor: string?,
	Emblem: Emblem?,
	Sections: { Section },
	Sidebar: { Group },
}

local UpdateNotes = {}

local function donuts(ids: { string }): { Item }
	local items = {}
	for _, id in ids do
		table.insert(items, { Kind = "Donut", Id = id })
	end
	return items
end

UpdateNotes.List = {
	{
		Version = 7,
		Name = "The Cosmic Meteor",
		Date = "Oct 7, 2026",
