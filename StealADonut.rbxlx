	},
	{
		Id = 14, Name = "Clockwork Void", Theme = "Clockwork",
		RecommendedSpeed = 85_000_000, WakeDelay = 0.88, World = 1, Index = 14,
		Floor = { Color3.fromRGB(72, 62, 92), Color3.fromRGB(86, 74, 108) }, FloorMaterial = Enum.Material.DiamondPlate,
		Wall = { Color3.fromRGB(42, 36, 62), Color3.fromRGB(34, 30, 52) }, WallMaterial = Enum.Material.Metal,
		Trim = Color3.fromRGB(255, 190, 60), TrimMaterial = Enum.Material.Neon,
		Guard = { Skin = Color3.fromRGB(200, 200, 215), Shirt = Color3.fromRGB(120, 90, 50), Pants = Color3.fromRGB(60, 50, 80), Aura = "Neon", Title = "Robo", Hat = "Gears" },
		Ambience = ambience({ ClockTime = 19.4, Tint = Color3.fromRGB(235, 220, 255), Saturation = 0.1, Contrast = 0.2, Ambient = Color3.fromRGB(90, 70, 130), AtmosphereColor = Color3.fromRGB(140, 100, 200), AtmosphereDensity = 0.35, Haze = 1.5, Bloom = 0.5 }),
	},
	{
		Id = 15, Name = "Donut Heaven", Theme = "Heaven",
		RecommendedSpeed = 140_000_000, WakeDelay = 0.82, World = 1, Index = 15, DomerBoost = 1.3,
		Floor = { Color3.fromRGB(255, 242, 205), Color3.fromRGB(255, 230, 175) }, FloorMaterial = Enum.Material.Marble,
		Wall = { Color3.fromRGB(255, 250, 238), Color3.fromRGB(245, 238, 220) }, WallMaterial = Enum.Material.Marble,
		Trim = Color3.fromRGB(255, 215, 90), TrimMaterial = Enum.Material.Neon,
		Guard = { Skin = Color3.fromRGB(255, 230, 140), Shirt = Color3.fromRGB(255, 255, 255), Pants = Color3.fromRGB(255, 215, 90), Aura = "Cosmic", Title = "Golden", Hat = "Halo" },
		Ambience = ambience({ ClockTime = 12, Tint = Color3.fromRGB(255, 245, 220), Saturation = 0.1, AtmosphereColor = Color3.fromRGB(255, 235, 190), AtmosphereDensity = 0.25, Haze = 1.5, Bloom = 0.6 }),
	},
	{
		Id = 16, Name = "Glitch Zone", Theme = "Glitch",
		RecommendedSpeed = 240_000_000, WakeDelay = 0.8, World = 1, Index = 16,
		Floor = { Color3.fromRGB(20, 20, 20), Color3.fromRGB(245, 245, 245) }, FloorMaterial = Enum.Material.SmoothPlastic,
		Wall = { Color3.fromRGB(255, 0, 200), Color3.fromRGB(0, 255, 220) }, WallMaterial = Enum.Material.Neon,
		Trim = Color3.fromRGB(255, 255, 0), TrimMaterial = Enum.Material.Neon,
		Guard = { Skin = Color3.fromRGB(0, 255, 220), Shirt = Color3.fromRGB(0, 0, 0), Pants = Color3.fromRGB(255, 0, 200), Aura = "Cosmic", Title = "Glitched", Hat = "Gears" },
		Ambience = ambience({ ClockTime = 0, Tint = Color3.fromRGB(240, 220, 255), Saturation = 0.25, Contrast = 0.25, Ambient = Color3.fromRGB(80, 60, 140), AtmosphereColor = Color3.fromRGB(255, 0, 200), AtmosphereDensity = 0.46, Haze = 2, Bloom = 0.7 }),
	},
	{
		Id = 17, Name = "The Black Hole", Theme = "BlackHole",
		RecommendedSpeed = 400_000_000, WakeDelay = 0.78, World = 1, Index = 17, HalfWidth = 175, DomerBoost = 1.5,
		Floor = { Color3.fromRGB(14, 10, 26), Color3.fromRGB(22, 16, 40) }, FloorMaterial = Enum.Material.Glass,
		Wall = { Color3.fromRGB(10, 8, 20), Color3.fromRGB(18, 12, 34) }, WallMaterial = Enum.Material.Glass,
		Trim = Color3.fromRGB(170, 90, 255), TrimMaterial = Enum.Material.Neon,
		Guard = { Skin = Color3.fromRGB(0, 255, 220), Shirt = Color3.fromRGB(20, 20, 30), Pants = Color3.fromRGB(120, 60, 255), Aura = "Cosmic", Title = "Event Horizon", Hat = "Halo" },
		Ambience = ambience({ ClockTime = 0, Tint = Color3.fromRGB(230, 215, 255), Saturation = 0.35, Contrast = 0.32, Ambient = Color3.fromRGB(70, 50, 130), AtmosphereColor = Color3.fromRGB(90, 50, 200), AtmosphereDensity = 0.36, Haze = 1.2, Bloom = 0.7 }),
	},
} :: { Area }

-- Lengths: the first biomes have their own (FIRST_LENGTHS: a short first one), the next two are
-- SecondLength; after that a biome is as long as RunSeconds of running at its own Speed (and
-- always longer than the last).
local FIRST_LENGTHS = { 160, 420, 600, 500 }
local SECOND_LENGTH, RUN_SECONDS, TILE = 600, 6, Config.Map.TileSize
local function walkSpeed(speed: number): number
	local s = Config.Speed
	return s.BaseWalkSpeed + s.CurveScale * math.max(speed, 0) ^ s.CurvePower
end
local previous = 0
for index, area in Areas.List do
	local length = if index <= #FIRST_LENGTHS then FIRST_LENGTHS[index] elseif index <= 6 then SECOND_LENGTH else walkSpeed(area.RecommendedSpeed) * RUN_SECONDS
	length = math.max(math.floor(length / TILE + 0.5) * TILE, previous + (if index > 6 then 2 * TILE else 0))
	area.Length = length
	previous = length
end

-- (One lane now: the old worlds and their portals are gone. Kept as a single world so code that
-- asks "which world" still has an answer.)
Areas.Worlds = {
	{ Id = 1, Name = "Donut Land", OffsetX = 0, BridgeLength = 0, WalkMultiplier = 1, Color = Color3.fromRGB(120, 210, 56) },
} :: { World }

Areas.ByWorld = {} :: { [number]: { Area } }
for _, area in Areas.List do
	Areas.ByWorld[area.World] = Areas.ByWorld[area.World] or {}
	table.insert(Areas.ByWorld[area.World], area)
end

function Areas.Get(id: number): Area?
	return Areas.List[id]
end

function Areas.World(id: number?): World
	return Areas.Worlds[id or 1] or Areas.Worlds[1]
end

return Areas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">BakerModel</string>
          <string name="Source"><![CDATA[--[[
	BakerModel: the baker who works in every base's donut shop window (client/Bakers) and hands you
	your first donut box in the opening cinematic (client/Intro).

	A friendly, round baker made of studded blocks like Domer: a tall chef's hat, a big curly
	mustache, rosy cheeks, a white jacket with a pink apron (a donut on its pocket) and grey checked
	trousers. A standard R6 layout (HumanoidRootPart, Torso, Head, arms, legs; every other piece
	welded to one of them), so Puppet can pose him.

	Faces he can pull (show/hide the named pieces): "Smile" (normally), "MouthOpen" (shouting,
	surprised).
]]

local BakerModel = {}

local rgb = Color3.fromRGB
local WHITE = rgb(250, 250, 250)
local SKIN = rgb(240, 196, 150)
local HAIR = rgb(120, 72, 38)
local APRON = rgb(255, 150, 200)
local PANTS = rgb(95, 95, 110)
local DARK = rgb(40, 28, 30)

local STUD_FACES = { "TopSurface", "BottomSurface", "FrontSurface", "BackSurface", "LeftSurface", "RightSurface" }

function BakerModel.Build(scale: number?): Model
	local model = Instance.new("Model")
	model.Name = "Baker"
	local function part(name: string, size: Vector3, color: Color3, cf: CFrame, studs: boolean?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.CFrame = cf
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if studs then
			for _, face in STUD_FACES do
				(p :: any)[face] = Enum.SurfaceType.Studs
			end
			p.Material = Enum.Material.Plastic
		end
		p.Parent = model
		return p
	end
	-- (pieces welded to a limb, `offset` from its middle)
	local function on(base: BasePart, name: string, size: Vector3, color: Color3, offset: CFrame, studs: boolean?): Part
		local p = part(name, size, color, base.CFrame * offset, studs)
		local weld = Instance.new("Weld")
		weld.Part0 = base
		weld.Part1 = p
		weld.C0 = offset
		weld.Parent = p
		return p
	end

	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), WHITE, CFrame.new(0, 3, 0))
	root.Transparency = 1
	local torso = part("Torso", Vector3.new(2, 2, 1), WHITE, CFrame.new(0, 3, 0), true)
	local head = part("Head", Vector3.new(1.3, 1.3, 1.3), SKIN, CFrame.new(0, 4.65, 0), true)
	local limbs: { [string]: Part } = {
		["Left Arm"] = part("Left Arm", Vector3.new(1, 2, 1), WHITE, CFrame.new(-1.5, 3, 0)),
		["Right Arm"] = part("Right Arm", Vector3.new(1, 2, 1), WHITE, CFrame.new(1.5, 3, 0)),
		["Left Leg"] = part("Left Leg", Vector3.new(1, 2, 1), PANTS, CFrame.new(-0.5, 1, 0), true),
		["Right Leg"] = part("Right Leg", Vector3.new(1, 2, 1), PANTS, CFrame.new(0.5, 1, 0), true),
	}
	for name, limb in limbs do
		local weld = Instance.new("Weld") -- (Puppet removes joints; this just keeps them together until then)
		weld.Part0 = torso
		weld.Part1 = limb
		weld.C0 = torso.CFrame:ToObjectSpace(limb.CFrame)
		weld.Name = name .. "Joint"
		weld.Parent = torso
	end
	local neck = Instance.new("Weld")
	neck.Part0 = torso
	neck.Part1 = head
	neck.C0 = torso.CFrame:ToObjectSpace(head.CFrame)
	neck.Parent = torso
	local rootJoint = Instance.new("Weld")
	rootJoint.Part0 = root
	rootJoint.Part1 = torso
	rootJoint.Parent = root

	-- a round belly, the apron and its pocket (with a little donut on it)
	on(torso, "Belly", Vector3.new(2.15, 1.1, 1.35), WHITE, CFrame.new(0, -0.45, -0.12), true)
	on(torso, "Apron", Vector3.new(1.7, 1.9, 0.12), APRON, CFrame.new(0, -0.3, -0.84))
	on(torso, "ApronBib", Vector3.new(1.0, 0.7, 0.1), APRON, CFrame.new(0, 0.62, -0.57))
	on(torso, "Pocket", Vector3.new(0.9, 0.55, 0.05), APRON:Lerp(WHITE, 0.35), CFrame.new(0, -0.55, -0.92))
	on(torso, "PocketDonut", Vector3.new(0.34, 0.34, 0.04), rgb(225, 165, 95), CFrame.new(0, -0.5, -0.95) * CFrame.Angles(0, 0, math.rad(45)))
	on(torso, "PocketIcing", Vector3.new(0.24, 0.24, 0.04), rgb(255, 90, 160), CFrame.new(0, -0.47, -0.96) * CFrame.Angles(0, 0, math.rad(45)))
	for _, y in { 0.35, -0.05 } do
		on(torso, "Button", Vector3.new(0.14, 0.14, 0.06), rgb(200, 200, 210), CFrame.new(0.72, y, -0.53))
	end
	on(torso, "Collar", Vector3.new(1.4, 0.25, 1.05), WHITE, CFrame.new(0, 1.0, 0))

	-- face
	for _, side in { -1, 1 } do
		on(head, "Eye", Vector3.new(0.14, 0.24, 0.05), DARK, CFrame.new(side * 0.25, 0.14, -0.66))
		on(head, "Brow", Vector3.new(0.3, 0.08, 0.05), HAIR, CFrame.new(side * 0.25, 0.36, -0.66) * CFrame.Angles(0, 0, math.rad(side * -8)))
		on(head, "Cheek", Vector3.new(0.2, 0.12, 0.04), rgb(255, 150, 160), CFrame.new(side * 0.43, -0.1, -0.66))
		on(head, "MustacheCurl", Vector3.new(0.22, 0.22, 0.1), HAIR, CFrame.new(side * 0.5, -0.12, -0.7) * CFrame.Angles(0, 0, math.rad(side * 30)))
		on(head, "Ear", Vector3.new(0.14, 0.34, 0.26), SKIN, CFrame.new(side * 0.69, 0, 0))
	end
	on(head, "Nose", Vector3.new(0.26, 0.24, 0.18), SKIN:Lerp(rgb(220, 120, 110), 0.25), CFrame.new(0, 0.0, -0.72))
	on(head, "Mustache", Vector3.new(0.8, 0.2, 0.1), HAIR, CFrame.new(0, -0.2, -0.7))
	on(head, "Smile", Vector3.new(0.34, 0.06, 0.05), rgb(150, 40, 50), CFrame.new(0, -0.4, -0.66))
	local open = on(head, "MouthOpen", Vector3.new(0.28, 0.24, 0.05), rgb(120, 30, 40), CFrame.new(0, -0.42, -0.66))
	open.Transparency = 1
	-- the chef's hat
	on(head, "HatBand", Vector3.new(1.42, 0.45, 1.42), WHITE, CFrame.new(0, 0.85, 0), true)
	on(head, "HatPuff", Vector3.new(1.75, 1.0, 1.75), WHITE, CFrame.new(0, 1.55, 0), true)
	on(head, "HatTop", Vector3.new(1.35, 0.35, 1.35), WHITE, CFrame.new(0, 2.15, 0), true)

	-- arms: white sleeves, then hands
	for _, name in { "Left Arm", "Right Arm" } do
		local arm = limbs[name]
		arm.Transparency = 1
		on(arm, "Sleeve", Vector3.new(1.08, 1.25, 1.08), WHITE, CFrame.new(0, 0.38, 0), true)
		on(arm, "Cuff", Vector3.new(1.0, 0.22, 1.0), APRON, CFrame.new(0, -0.32, 0))
		on(arm, "Forearm", Vector3.new(0.86, 0.6, 0.86), SKIN, CFrame.new(0, -0.65, 0), true)
		on(arm, "Hand", Vector3.new(0.8, 0.5, 0.8), SKIN, CFrame.new(0, -1.15, 0), true)
	end
	-- legs: shoes
	for _, name in { "Left Leg", "Right Leg" } do
		on(limbs[name], "Shoe", Vector3.new(1.05, 0.4, 1.35), DARK, CFrame.new(0, -0.82, -0.15), true)
	end

	model.PrimaryPart = root
	if scale and scale ~= 1 then
		model:ScaleTo(scale)
	end
	return model
end

return BakerModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">BoxModel</string>
          <string name="Source"><![CDATA[--[[
	BoxModel: builds a donut box (Boxes.luau) - in a biome, lying on the ground, carried over a
	thief's head, waiting to open in a pen, or popping open (client/BoxFX).

	A bakery donut box made of studded bricks: the box itself with a trim band round its foot and the
	rarity's name on its front and back, and a lid that clearly sits on top - it overhangs the box,
	has a contrasting trim round its edge, a closing tab at the front and a raised panel with
	"DONUTS" on it. Every part of the lid is named "Lid..." or "Bow..." so it can flip open in one
	piece (client/BoxFX).
	  * Basic: pink cardboard, a white lid.
	  * Rare: sky blue, a white lid with blue trim, a silver ribbon and a little bow.
	  * Epic: purple, a deep purple lid with gold trim, gold corners, a gold ribbon and a big bow.
	  * Legendary: shiny gold, a cream lid with gold corners and a big bow; the lid sits ajar and
	    golden light spills out of the gap.
	  * Mythic: dark crimson with a black lid, gold corners, glowing gold edges and glowing cracks; the
	    lid sits ajar with red light pouring out, and embers drift up.
	A box with a mutation (Rarities.Mutations) is made of that mutation's material (gold foil,
	diamond glass, glowing neon...). Bigger boxes are just bigger (Boxes.Sizes Scale).

	The model's pivot (and PrimaryPart "Root") is the middle of its bottom face, so PivotTo on a
	spot on the ground puts it standing on it. Attributes: Tier, BoxSize, Mutation, Area, Top (height).
]]

local Boxes = require(script.Parent.Boxes)
local Rarities = require(script.Parent.Rarities)

local BoxModel = {}

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)
local GOLD = rgb(255, 200, 60)
local WIDTH, HEIGHT, DEPTH = 5.2, 2.6, 3.6 -- a Small box, in studs
local AJAR = math.rad(13) -- how far the Legendary and Mythic lids are lifted at the front

export type Options = {
	Mutation: string?,
	Area: number?,
	NoEffects: boolean?, -- no lights or particles (inventory previews, lots of boxes on screen)
	Scale: number?, -- on top of the box's size
}

-- Each tier's look: Body / Lid / Trim colours, the panel and its text, the ribbon (nil = none)
type Look = { Body: Color3, Lid: Color3, Trim: Color3, Panel: Color3, Text: Color3, Ribbon: Color3?, Material: Enum.Material, Label: string }
local LOOKS: { [string]: Look } = {
	Basic = { Body = rgb(255, 170, 205), Lid = rgb(255, 240, 246), Trim = rgb(240, 110, 160), Panel = WHITE, Text = rgb(240, 100, 155), Ribbon = nil, Material = Enum.Material.Plastic, Label = "FRESH" },
	Rare = { Body = rgb(80, 160, 255), Lid = rgb(240, 248, 255), Trim = rgb(40, 110, 230), Panel = rgb(215, 235, 255), Text = rgb(40, 110, 230), Ribbon = rgb(215, 222, 235), Material = Enum.Material.Plastic, Label = "RARE" },
	Epic = { Body = rgb(170, 80, 255), Lid = rgb(105, 35, 185), Trim = GOLD, Panel = rgb(200, 140, 255), Text = WHITE, Ribbon = GOLD, Material = Enum.Material.Plastic, Label = "EPIC" },
	Legendary = { Body = rgb(255, 195, 40), Lid = rgb(255, 242, 205), Trim = rgb(255, 160, 20), Panel = WHITE, Text = rgb(235, 150, 10), Ribbon = rgb(255, 120, 40), Material = Enum.Material.Foil, Label = "LEGENDARY" },
	Mythic = { Body = rgb(150, 15, 40), Lid = rgb(28, 12, 18), Trim = GOLD, Panel = rgb(60, 20, 30), Text = GOLD, Ribbon = GOLD, Material = Enum.Material.Plastic, Label = "MYTHIC" },
}
-- (each tier's colours, for things that show a box without building one: the shop's shelves)
BoxModel.Looks = LOOKS

local function studs(part: BasePart)
	part.TopSurface = Enum.SurfaceType.Studs
	part.BottomSurface = Enum.SurfaceType.Inlet
	part.FrontSurface = Enum.SurfaceType.Studs
	part.BackSurface = Enum.SurfaceType.Studs
	part.LeftSurface = Enum.SurfaceType.Studs
	part.RightSurface = Enum.SurfaceType.Studs
end

local function part(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.Plastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function label(parent: BasePart, face: Enum.NormalId, text: string, color: Color3, stroke: Color3, pixels: number, name: string)
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixels
	gui.LightInfluence = 0.4
	gui.Parent = parent
	local textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 1
	textLabel.Size = UDim2.fromScale(0.86, 0.7)
	textLabel.Position = UDim2.fromScale(0.07, 0.15)
	textLabel.Font = Enum.Font.LuckiestGuy
	textLabel.TextScaled = true
	textLabel.Text = text
	textLabel.TextColor3 = color
	textLabel.TextStrokeColor3 = stroke
	textLabel.TextStrokeTransparency = 0
	textLabel.Parent = gui
end

function BoxModel.Build(tierId: string, sizeId: string?, options: Options?): Model
	local opts: Options = options or {}
	local tier = Boxes.Tier(tierId)
	local size = Boxes.Size(sizeId)
	local mutation = Rarities.Mutation(opts.Mutation)
	local s = size.Scale * (opts.Scale or 1)
	local w, h, d = WIDTH * s, HEIGHT * s, DEPTH * s
	local base = h * 0.7 -- the box's height (the lid is the rest)
	local lidHeight = h - base
	local order = tier.Order

	local model = Instance.new("Model")
	model.Name = "DonutBox"
	local root = part(model, "Root", Vector3.new(1, 0.2, 1), CFrame.new(0, 0, 0), WHITE)
	root.Transparency = 1
	model.PrimaryPart = root

	local look = LOOKS[tier.Id] or LOOKS.Basic
	local body, lidColor, trim, material = look.Body, look.Lid, look.Trim, look.Material
	local panel, text, ribbon = look.Panel, look.Text, look.Ribbon
	if mutation.Id ~= "None" then
		body = mutation.Frosting or mutation.Color
		lidColor = body:Lerp(WHITE, 0.25)
		trim = mutation.Dough or mutation.Color:Lerp(WHITE, 0.5)
		material = mutation.Material or Enum.Material.Plastic
		panel, text = body:Lerp(WHITE, 0.5), trim
	end

	-- The box: its body, a trim band round its foot, and a dark line under the lid
	local bottom = part(model, "Bottom", Vector3.new(w, base, d), CFrame.new(0, base / 2, 0), body, material)
	part(model, "Band", Vector3.new(w * 1.02, 0.22 * s, d * 1.02), CFrame.new(0, 0.13 * s, 0), trim, Enum.Material.SmoothPlastic)
	part(model, "Gap", Vector3.new(w * 0.99, 0.07 * s, d * 0.99), CFrame.new(0, base - 0.03 * s, 0), body:Lerp(Color3.new(0, 0, 0), 0.6), Enum.Material.SmoothPlastic)
	if material == Enum.Material.Plastic then
		studs(bottom)
	end
	local labelColor = if order >= 4 then GOLD else WHITE
	label(bottom, Enum.NormalId.Front, look.Label, labelColor, body:Lerp(Color3.new(0, 0, 0), 0.55), 26, "TierText")
	label(bottom, Enum.NormalId.Back, look.Label, labelColor, body:Lerp(Color3.new(0, 0, 0), 0.55), 26, "TierTextBack")

	-- Corners (Epic and up): gold caps down the box's four edges
	if order >= 2 then
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				part(model, "Corner", Vector3.new(0.32 * s, base * 0.96, 0.32 * s), CFrame.new(sx * (w / 2 - 0.1 * s), base / 2, sz * (d / 2 - 0.1 * s)), trim, Enum.Material.Foil)
			end
		end
	end

	-- Mythic: glowing cracks down its sides
	if order >= 4 then
		for i, spot in { { -0.28, 0.4 }, { 0.12, -0.5 }, { 0.36, 0.3 } } do
			for _, sz in { -1, 1 } do
				local crack = part(model, "Crack", Vector3.new(0.09 * s, base * 0.5, 0.06 * s), CFrame.new(spot[1] * w, base * 0.48, sz * (d / 2 + 0.01 * s)) * CFrame.Angles(0, 0, spot[2] + i * 0.1), rgb(255, 120, 40), Enum.Material.Neon)
				crack.Transparency = 0.1
			end
		end
	end

	-- The lid (every part of it is named Lid... / Bow... so BoxFX can lift it off in one piece)
	local lidParts: { BasePart } = {}
	local function lidPart(name: string, sizeV: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, shape: Enum.PartType?): BasePart
		local p = part(model, name, sizeV, cf, color, mat, shape)
		table.insert(lidParts, p)
		return p
	end
	local lidY = base + lidHeight / 2
	local lid = lidPart("Lid", Vector3.new(w * 1.07, lidHeight, d * 1.07), CFrame.new(0, lidY, 0), lidColor, material)
	if material == Enum.Material.Plastic then
		studs(lid)
	end
	lidPart("LidTrim", Vector3.new(w * 1.09, 0.16 * s, d * 1.09), CFrame.new(0, base + 0.08 * s, 0), trim, Enum.Material.SmoothPlastic)
	-- the closing tab at the front, hanging over the box
	lidPart("LidTab", Vector3.new(w * 0.2, lidHeight * 0.9, 0.12 * s), CFrame.new(-w * 0.14, base + lidHeight * 0.3, -d * 0.535 - 0.06 * s), trim, Enum.Material.SmoothPlastic)
	-- a raised panel with the name on it (beside the ribbon)
	local panelPart = lidPart("LidPanel", Vector3.new(w * 0.56, 0.1 * s, d * 0.66), CFrame.new(-w * 0.14, base + lidHeight + 0.05 * s, 0), panel, Enum.Material.SmoothPlastic)
	label(panelPart, Enum.NormalId.Top, "DONUTS", text, panel:Lerp(Color3.new(0, 0, 0), 0.5), 30, "LidText")

	-- Ribbons (Rare and up): round the box and over the lid, a bow on top
	if ribbon then
		local rw = 0.5 * s
		local rx = w * 0.3
		part(model, "Ribbon", Vector3.new(rw, base * 0.98, d * 1.025), CFrame.new(rx, base / 2, 0), ribbon, Enum.Material.SmoothPlastic)
		part(model, "Ribbon", Vector3.new(w * 1.025, base * 0.98, rw), CFrame.new(0, base / 2, 0), ribbon, Enum.Material.SmoothPlastic)
		lidPart("LidRibbon", Vector3.new(rw, lidHeight + 0.04 * s, d * 1.09), CFrame.new(rx, lidY + 0.02 * s, 0), ribbon, Enum.Material.SmoothPlastic)
		lidPart("LidRibbon", Vector3.new(w * 0.29, lidHeight + 0.04 * s, rw), CFrame.new(w * 0.4, lidY + 0.02 * s, 0), ribbon, Enum.Material.SmoothPlastic)
		lidPart("LidRibbon", Vector3.new(w * 0.04, lidHeight + 0.04 * s, rw), CFrame.new(-w * 0.515, lidY + 0.02 * s, 0), ribbon, Enum.Material.SmoothPlastic)
		local bow = (if order >= 3 then 1.9 elseif order >= 2 then 1.55 else 1.0) * s
		local top = base + lidHeight
		for _, side in { -1, 1 } do
			lidPart("Bow", Vector3.new(bow, bow * 0.62, bow * 0.48), CFrame.new(rx + side * bow * 0.45, top + bow * 0.3, 0) * CFrame.Angles(0, 0, side * 0.5), ribbon, Enum.Material.SmoothPlastic)
			lidPart("Bow", Vector3.new(bow * 0.5, bow * 0.34, bow * 0.5), CFrame.new(rx + side * bow * 0.62, top + bow * 0.36, 0) * CFrame.Angles(0, 0, side * 0.5), ribbon:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.SmoothPlastic)
			if order >= 2 then
				-- tails trailing down the lid
				lidPart("BowTail", Vector3.new(bow * 0.24, 0.08 * s, bow * 0.8), CFrame.new(rx + side * bow * 0.2, top + 0.06 * s, side * bow * 0.42) * CFrame.Angles(0, side * 0.35, 0), ribbon, Enum.Material.SmoothPlastic)
			end
		end
		lidPart("BowKnot", Vector3.one * bow * 0.45, CFrame.new(rx, top + bow * 0.25, 0), ribbon:Lerp(WHITE, 0.15), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	end

	-- Corners on the lid too (Epic and up), and the Mythic box's glowing gold edges
	if order >= 2 then
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				lidPart("LidCorner", Vector3.new(0.4 * s, lidHeight + 0.06 * s, 0.4 * s), CFrame.new(sx * (w * 0.535 - 0.14 * s), lidY + 0.03 * s, sz * (d * 0.535 - 0.14 * s)), trim, Enum.Material.Foil)
			end
		end
	end
	if order >= 4 then
		for _, side in { -1, 1 } do
			lidPart("LidEdge", Vector3.new(w * 1.08, 0.2 * s, 0.2 * s), CFrame.new(0, base + lidHeight, side * d * 0.54), trim, Enum.Material.Neon)
			lidPart("LidEdge", Vector3.new(0.2 * s, 0.2 * s, d * 1.08), CFrame.new(side * w * 0.54, base + lidHeight, 0), trim, Enum.Material.Neon)
			part(model, "Edge", Vector3.new(w * 1.04, 0.2 * s, 0.2 * s), CFrame.new(0, 0.3 * s, side * d * 0.52), trim, Enum.Material.Neon)
			part(model, "Edge", Vector3.new(0.2 * s, 0.2 * s, d * 1.04), CFrame.new(side * w * 0.52, 0.3 * s, 0), trim, Enum.Material.Neon)
		end
	end

	-- Legendary and Mythic: the lid sits ajar (hinged at the back) and light pours out of the gap
	local glowColor = if mutation.Light then mutation.Color elseif order >= 4 then rgb(255, 70, 50) else rgb(255, 225, 120)
	if order >= 3 then
		local hinge = CFrame.new(0, base, d / 2)
		local tilt = hinge * CFrame.Angles(AJAR, 0, 0) * hinge:Inverse()
		for _, p in lidParts do
			p.CFrame = tilt * p.CFrame
		end
		part(model, "InnerGlow", Vector3.new(w * 0.94, 0.12 * s, d * 0.94), CFrame.new(0, base - 0.02 * s, 0), glowColor, Enum.Material.Neon)
		if not opts.NoEffects then
			-- rays of light shining out of the front of the gap
			local from = Instance.new("Attachment")
			from.Position = bottom.CFrame:PointToObjectSpace(Vector3.new(0, base + 0.1 * s, -d * 0.2))
			from.Parent = bottom
			for i = -2, 2 do
				local to = Instance.new("Attachment")
				to.Position = bottom.CFrame:PointToObjectSpace(Vector3.new(i * w * 0.24, base + (1.6 + math.abs(i) * 0.2) * s, -d * 0.5 - 2.4 * s))
				to.Parent = bottom
				local ray = Instance.new("Beam")
				ray.Name = "LightRay"
				ray.Attachment0 = from
				ray.Attachment1 = to
				ray.FaceCamera = true
				ray.Segments = 1
				ray.Width0 = 0.5 * s
				ray.Width1 = 1.6 * s
				ray.LightEmission = 1
				ray.Brightness = 1.4
				ray.Color = ColorSequence.new(glowColor:Lerp(WHITE, 0.4), glowColor)
				ray.Transparency = NumberSequence.new(0.45, 1)
				ray.Parent = bottom
			end
		end
	end

	if not opts.NoEffects then
		local glow = if mutation.Light then mutation.Color elseif order >= 2 then tier.Color else nil
		if glow then
			local light = Instance.new("PointLight")
			light.Color = if order >= 3 then glowColor else glow
			light.Range = (if order >= 4 then 18 elseif order >= 3 or mutation.Light then 14 else 9) * math.sqrt(s)
			light.Brightness = if order >= 4 then 2.6 elseif order >= 3 then 2 else 1.3
			light.Parent = bottom
		end
		local rate = (if order >= 4 then 16 elseif order >= 3 then 10 elseif order >= 2 then 4 elseif order >= 1 then 1.5 else 0) + (mutation.Particles or 0) * 0.5
		if rate > 0 then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name = "Sparkles"
			emitter.Color = ColorSequence.new(if mutation.Id ~= "None" then mutation.Color else tier.Color, WHITE)
			emitter.LightEmission = 0.8
			emitter.Rate = rate
			emitter.Lifetime = NumberRange.new(0.8, 1.6)
			emitter.Speed = NumberRange.new(0.5, 2)
			emitter.SpreadAngle = Vector2.new(180, 180)
			emitter.Size = NumberSequence.new(0.35 * math.sqrt(s), 0)
			emitter.Parent = lid
		end
		if order >= 4 then
			-- embers drifting up off a Mythic box
			local embers = Instance.new("ParticleEmitter")
			embers.Name = "Embers"
			embers.Color = ColorSequence.new(rgb(255, 210, 80), rgb(255, 60, 40))
			embers.LightEmission = 1
			embers.Rate = 8
			embers.Lifetime = NumberRange.new(1, 2)
			embers.Speed = NumberRange.new(2, 4)
			embers.SpreadAngle = Vector2.new(25, 25)
			embers.Acceleration = Vector3.new(0, 2, 0)
			embers.Size = NumberSequence.new(0.25 * math.sqrt(s), 0)
			embers.Parent = lid
		end
	end

	model:SetAttribute("Tier", tier.Id)
	model:SetAttribute("BoxSize", size.Id)
	model:SetAttribute("Mutation", mutation.Id)
	if opts.Area then
		model:SetAttribute("Area", opts.Area)
	end
	-- its height (for labels and timers above it): the highest point of any visible part
	local top = h
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") and p ~= root then
			local cf, sizeV = p.CFrame, p.Size
			local half = math.abs(cf.RightVector.Y) * sizeV.X / 2 + math.abs(cf.UpVector.Y) * sizeV.Y / 2 + math.abs(cf.LookVector.Y) * sizeV.Z / 2
			top = math.max(top, cf.Position.Y + half)
		end
	end
	model:SetAttribute("Top", top)
	if mutation.Rainbow then
		model:SetAttribute("Rainbow", true)
	end
	return model
end

-- Stand a box (its bottom middle) on `cf`.
function BoxModel.PlaceOn(model: Model, cf: CFrame)
	model:PivotTo(cf)
end

return BoxModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Boxes</string>
          <string name="Source"><![CDATA[--[[
	Boxes: donut boxes - what you steal from each biome's Domer (Config.Boxes has the numbers).

	A box is a rarity TIER and a SIZE:
	  * Tier: Basic (the plain pink box, first biome only), Rare, Epic, Legendary or Mythic. Which
	    ones a biome has (and how often) is its lineup (Config.Boxes.Lineups): Rare / Epic /
	    Legendary, then Epic / Legendary / Mythic in the later biomes. The tier picks which of the
	    biome's donuts can come out (Donuts.ByBox) and how long it takes to open.
	  * Size: Small, Big, Huge or GIANT. Bigger boxes are rarer, take longer to open, slow you down
	    while you carry them and hold a bigger donut (Rarities.Sizes) that earns more.

	A box in your pen opens after HatchSeconds (its tier) x HatchMultiplier (its size) - the same
	in every biome: a Small Rare box takes 1 minute whether it's from biome 2 or biome 19.
]]

local Config = require(script.Parent.Config)

export type Tier = {
	Id: string,
	Name: string,
	Order: number,
	HatchSeconds: number,
	Color: Color3,
	Trim: Color3,
}

export type LineupEntry = { Tier: Tier, Weight: number }

export type Size = {
	Id: string,
	Name: string,
	HatchMultiplier: number,
	Weight: number,
	Scale: number,
	DonutSize: string,
	CarrySpeed: number,
}

local Boxes = {}

Boxes.Tiers = Config.Boxes.Tiers :: { Tier }
Boxes.Sizes = Config.Boxes.Sizes :: { Size }

Boxes.TierById = {} :: { [string]: Tier }
for _, tier in Boxes.Tiers do
	Boxes.TierById[tier.Id] = tier
end
Boxes.SizeById = {} :: { [string]: Size }
for _, size in Boxes.Sizes do
	Boxes.SizeById[size.Id] = size
end

function Boxes.Tier(id: string?): Tier
	return Boxes.TierById[id or "Basic"] or Boxes.Tiers[1]
end

function Boxes.Size(id: string?): Size
	return Boxes.SizeById[id or "Small"] or Boxes.Sizes[1]
end

-- Seconds a box takes to open in your pen (before Box Rushes and skips).
function Boxes.HatchSeconds(tierId: string, sizeId: string?): number
	return Boxes.Tier(tierId).HatchSeconds * Boxes.Size(sizeId).HatchMultiplier
end

local lineups: { { From: number, Entries: { LineupEntry } } } = {}
for _, lineup in Config.Boxes.Lineups do
	local entries = {}
	for _, entry in lineup.Tiers do
		local tier = Boxes.TierById[entry.Id]
		assert(tier, "Unknown box tier in Config.Boxes.Lineups: " .. entry.Id)
		table.insert(entries, { Tier = tier, Weight = entry.Weight })
	end
	table.insert(lineups, { From = lineup.From, Entries = entries })
end
table.sort(lineups, function(a, b)
	return a.From < b.From
end)

-- The boxes a biome's Domer guards, most common first, with how often each turns up.
function Boxes.Lineup(biome: number): { LineupEntry }
	local found = lineups[1].Entries
	for _, lineup in lineups do
		if biome >= lineup.From then
			found = lineup.Entries
		end
	end
	return found
end

-- The tiers a biome's Domer guards, most common first.
function Boxes.TiersFor(biome: number): { Tier }
	local list = {}
	for _, entry in Boxes.Lineup(biome) do
		table.insert(list, entry.Tier)
	end
	return list
end

-- Where a tier is in its biome's lineup: 1 = the common box, 3 = the rarest (0 = not there).
function Boxes.Rank(biome: number, tierId: string): number
	for i, entry in Boxes.Lineup(biome) do
		if entry.Tier.Id == tierId then
			return i
		end
	end
	return 0
end

-- A random tier for a fresh box in `biome`. `luck` multiplies the weights of every box but the
-- common one.
function Boxes.RollTier(biome: number, rng: Random, luck: number?): Tier
	local lineup = Boxes.Lineup(biome)
	local boost = luck or 1
	local total = 0
	for i, entry in lineup do
		total += entry.Weight * (if i > 1 then boost else 1)
	end
	local left = rng:NextNumber() * total
	for i, entry in lineup do
		left -= entry.Weight * (if i > 1 then boost else 1)
		if left <= 0 then
			return entry.Tier
		end
	end
	return lineup[#lineup].Tier
end

-- Chance (0-1) that a fresh box in `biome` is this tier. `luck`: the Luck Event's boost, the same
-- way RollTier uses it (so the Index can show the boosted odds while one runs).
function Boxes.TierChance(biome: number, tierId: string, luck: number?): number
	local lineup = Boxes.Lineup(biome)
	local boost = luck or 1
	local total, mine = 0, 0
	for i, entry in lineup do
		local weight = entry.Weight * (if i > 1 then boost else 1)
		total += weight
		if entry.Tier.Id == tierId then
			mine = weight
		end
	end
	return if total > 0 then mine / total else 0
end

-- A random size. `bigLuck` multiplies every size bigger than Small (Luck Event).
function Boxes.RollSize(rng: Random, bigLuck: number?): Size
	local luck = bigLuck or 1
	local total = 0
	for i, size in Boxes.Sizes do
		total += size.Weight * (if i > 1 then luck else 1)
	end
	local left = rng:NextNumber() * total
	for i, size in Boxes.Sizes do
		left -= size.Weight * (if i > 1 then luck else 1)
		if left <= 0 then
			return size
		end
	end
	return Boxes.Sizes[1]
end

-- "GIANT Legendary Donut Box", "Donut Box", "Big Epic Donut Box"
function Boxes.DisplayName(tierId: string, sizeId: string?): string
	local size = Boxes.Size(sizeId)
	local name = Boxes.Tier(tierId).Name
	return if size.Id == "Small" then name else `{size.Name} {name}`
end

return Boxes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	======
	Every tunable number in the game lives here (plus Areas.luau / Donuts.luau / Rarities.luau).
	You should be able to rebalance the whole game without touching any other script.

	>>> BEFORE PUBLISHING <<<
	1. Game Passes: their IDs are in Config.GamePasses[...].GamePassId (from the Creator Dashboard).
	   A GamePassId of 0 means "not set up yet" and the item shows as "Coming Soon" in live servers.
	2. Developer Products: Luck Event, one per crate, one per tip. IDs are in
	   Config.LuckEvent.DeveloperProductId, Config.Crates.Products[...] and
	   Config.Donations.Products[...].DeveloperProductId. Crates are "paid random items": say so in
	   the Maturity & Compliance Questionnaire on the Creator Dashboard.
	3. The admin code works for EVERYONE who types it (Config.Admin.AllowAnyone). Luck Events and
	   crates from the panel only work for the owner / Config.Admin.AllowedUserIds.
	4. In Studio: Game Settings > Security > "Enable Studio Access to API Services" so DataStores work
	   while testing.
]]

export type TreadmillTier = {
	Name: string,
	PerStep: number, -- Speed gained per step (Config.Treadmill.StepsPerSecond steps a second)
	Cost: number,
	Base: Color3,
	Accent: Color3,
	Material: Enum.Material,
	Neon: boolean?,
	Fire: boolean?,
	Light: boolean?,
	Sparkles: boolean?,
	Rainbow: boolean?,
	Halo: boolean?,
	Heavenly: boolean?, -- the last treadmill: white marble and gold, wings and a halo of light
}

export type GamePass = {
	Key: string,
	Name: string,
	Kind: string,
	Multiplier: number,
	GamePassId: number,
	SuggestedPrice: number,
	Color: Color3,
	-- Does exactly what that pass (its Key) does: not sold in the game, but owning it still counts.
	SameAs: string?,
}

export type Skin = {
	Id: string,
	Name: string,
	SpeedCost: number, -- paid with your Speed stat (0 = free)
	Floor: Color3,
	FloorAlt: Color3,
	FloorMaterial: Enum.Material,
	Fence: Color3,
	FenceMaterial: Enum.Material,
	Trim: Color3,
	TrimMaterial: Enum.Material,
	Pedestal: Color3,
	PedestalMaterial: Enum.Material,
	Effect: string?,
	OwnerOnly: boolean?, -- only the game's owner can use it (it's hidden from everyone else's Shop)
}

local Config = {}

Config.GameName = "Steal a Donut"

--------------------------------------------------------------------------------
-- Guard (the sleeping donut-lover who guards each area)
--------------------------------------------------------------------------------
Config.Guard = {
	-- Shown above every guard and in all UI text ("Domer is chasing you!"). Changing this one string
	-- renames the guard everywhere.
	Name = "Domer",

	-- Every player has their OWN guards: you only ever see (and get chased by) yours, so other
	-- players can't wake him up for you. When a chase ends he walks back to his corner.
	Scale = 4, -- model scale (1 = normal player size). He's HUGE: about 20 studs tall.
	-- His walk and idle animations (Roblox's R6 ones). Clients preload them when the game starts, so
	-- he doesn't stand frozen for a moment the first time he wakes up.
	WalkAnimation = "rbxassetid://180426354",
	IdleAnimation = "rbxassetid://180435571",
	-- His snore. "" = made from Roblox's own sounds; paste
	-- "rbxassetid://..." from the Creator Store to use a real recording. A pasted snore plays only
	-- while you're close enough to grab one of his boxes, louder the closer you are to him:
	-- SnoreVolume right next to him, a third of it at the far side of his boxes.
	SnoreSoundId = "rbxassetid://9115480677",
	SnoreVolume = 0.45,
	-- Grabbing one of his boxes: these all play at once (Volume: 0 to 10, 1 = as uploaded). An empty
	-- list plays the built-in swipe and "got it!" jingle instead (eggs and meteor shards always do).
	-- These two are the chase sounds (he wakes up without a sound of his own): keep them loud.
	GrabSounds = {
		{ Id = "rbxassetid://6506461886", Volume = 2.5 },
		{ Id = "rbxassetid://135439749484858", Volume = 2.5 },
	} :: { { Id: string, Volume: number } },
	-- The "!?" over his head while he's waking up and chasing you (client/Guards): rainbow letters
	-- with a soft glow, turning round Spin times a second. Size in studs; Glow: how bright (1 = flat).
	Alert = { Text = "!?", Spin = 0.5, Size = 14, Glow = 1.6 },
	CatchRadius = 10, -- studs (horizontal) between his centre and yours that counts as "caught"
	-- A biome's Speed is the Speed you need to get away from its Domer: each Domer is just fast
	-- enough that a player with exactly that Speed, running a small box straight back, gets out of
	-- his biome and is caught EscapeMargin studs past its entrance (outside his biome, so the box
	-- stays on the ground there). Any slower and he catches you inside (he takes the box back); a
	-- big or GIANT box slows you down, so you need more. He's about 1.2-1.3x as fast as a player
	-- with exactly the biome's Speed (Economy.GuardWalkSpeed).
	EscapeMargin = 60,
	-- After a catch (or once you reach the lobby) he walks back to his corner at this share of
	-- his chase speed. Pick the box up again and he turns around and runs at you from wherever
	-- he is.
	ReturnSpeedFactor = 0.45,
	TurnDelay = 0.4, -- seconds he takes to turn around when you grab his box again on his way home
	MaxReturnSeconds = 240, -- a walk home that takes longer than this ends with him back asleep
	-- The first biome's Domer is slower than anyone (beginners always get away).
	BeginnerSpeed = 18,
	-- Every Domer runs this much faster than the escape rule above says (a biome can add its own
	-- DomerBoost in Areas.luau); the Speed shown on the signs is worked out from his real speed
	-- (Economy.EscapeSpeed).
	SpeedBoost = 1.25,
	-- Shown in the RUN! warning while he chases you.
	RunText = "RUN!",
	-- Lag compensation: the catch is judged against where the guard was on YOUR screen (the server
	-- rewinds him by your ping plus Roblox's interpolation delay), so a fast chase over a laggy
	-- connection can't catch you while he still looks 40 studs away. Capped so lag can't be abused.
	InterpolationDelay = 0.1,
	MaxRewind = 0.35,
	GiveUpDelay = 1.2, -- seconds he stands there fuming after you reach safety, before walking home
	StunTime = 2.3, -- seconds after being caught (and flung) before you can grab anything again

	-- Footsteps + screen shake while he's close (client side, only for your own guard).
	FootstepRange = 110, -- studs: you start hearing him
	ShakeRange = 45, -- studs: the camera starts shaking
	MaxShake = 0.9, -- strongest shake (studs of camera offset) when he's right behind you

	-- Random line he yells when he wakes up.
	WakeShouts = { "D'OH!", "HEY! MY DONUT!", "WHY YOU LITTLE...!", "MMM... DONUT THIEF!", "COME BACK HERE!" },
	CatchShouts = { "WOO-HOO!", "GOTCHA!", "MINE! ALL MINE!", "MMM... DONUT..." },
}

--------------------------------------------------------------------------------
-- Map layout (studs). Floor top is at Y = 0.
-- One lobby (bases, treadmills, the sell stall, leaderboards) and one long lane of biomes (Areas.luau)
-- running from it along +Z. Every biome is LaneHalfWidth * 2 studs wide with thick grassy walls.
-- (Changing the width or the wall squares rebuilds the map: bump MapBuilder's MAP_VERSION.)
--------------------------------------------------------------------------------
Config.Map = {
	LaneHalfWidth = 130, -- the lane runs along +Z, from X = -130 to X = 130
	LaneWallSquare = 12, -- the lane walls' checker squares (studs)
	AreaLength = 500, -- a biome's length when Areas.luau doesn't give one (multiple of TileSize)
	TileSize = 20,
	LaneWallHeight = 60,
	WallThickness = 40, -- the lane's walls are this thick (grass on top), so there's no void beside it

	SafeZoneZ = 0, -- everything with Z < SafeZoneZ is the safe lobby (bases, treadmills, leaderboards)
	HubHalfWidth = 322, -- a row of 5 bases across the lobby, one more in each front corner
	HubDepth = 376, -- (the corner bases by the lane, the row of 5 behind, the leaderboards high on the back wall)
	HubWallHeight = 40,
}

--------------------------------------------------------------------------------
-- Player bases (plots)
--------------------------------------------------------------------------------
Config.Plots = {
	Count = 7, -- bases per server: set the game's Max Players to this too (Game Settings > Places > Server Size)
	-- Your base is a donut shop with an open pen in front (like Steal an Egg) where your donuts roam.
	-- Upgrade it at the sign by its gate: every size holds Slots donuts (and boxes waiting to open)
	-- and the pen grows a little each time.
	Sizes = {
		{ Slots = 7, Cost = 0 },
		{ Slots = 9, Cost = 100_000 },
		{ Slots = 11, Cost = 1_500_000 },
		{ Slots = 13, Cost = 22_000_000 },
		{ Slots = 15, Cost = 320_000_000 },
		{ Slots = 17, Cost = 4_600_000_000 },
		{ Slots = 19, Cost = 68_000_000_000 },
		{ Slots = 20, Cost = 1_000_000_000_000 },
	},
	-- Past the last size (the owner, and the "ender=rich" code): ExtraSlots more per size, up to
	-- Config.Admin.MaxSlots.
	ExtraSlots = 5,
	-- The pen holds a CellSize x CellSize patch of ground per donut (a little wider than deep).
	-- Every donut roams around its own patch, up to RoamRadius x CellSize from its middle.
	CellSize = 18,
	RoamRadius = 0.85,
	RoamSpeed = 3.5, -- studs per second while walking (bigger donuts take bigger strides)
	FenceHeight = 3.5, -- a low fence anyone can hop over (like Steal an Egg)
	DonutScale = 1.5,
	PodiumDonutScale = 1.7,
}

--------------------------------------------------------------------------------
-- Speed
-- The "Speed" stat is the big number in the HUD (it climbs into the hundreds of millions). How fast
-- you actually run grows more gently with it, or late-game players would break Roblox's physics.
-- Your Speed counts StatMultiplier times when you run (100 Speed runs like 200):
--   WalkSpeed = BaseWalkSpeed + CurveScale * (StatMultiplier * Speed) ^ CurvePower
--   (Speed 0 = 24, 900 = 45, 10K = 57, 700K = 102, 30M = 189, 400M = 302)
-- Each biome shows the Speed you need to get away from its Domer (Areas.luau; anyone can walk in).
--------------------------------------------------------------------------------
Config.Speed = {
	StartSpeed = 30, -- the Speed stat a brand new player starts with (it runs like 34: see the formula above)
	BaseWalkSpeed = 24,
	StatMultiplier = 2, -- your Speed counts double when you run
	MinRunSpeed = 16, -- the slowest run speed you can type in Settings
	SlowModeSpeed = 30, -- the HUD's Slow Mode switch: walk at this speed (handy round your base)
	CurveScale = 4.6,
	CurvePower = 0.2,
}

-- Treadmills: the one by your base gives Speed every step while you run on it (StepsPerSecond steps
-- a second). Buy the next one in the Shop. PerStep is before your Speed Multiplier, Index, pets
-- and 2x Speed pass. Every treadmill is its own model (shared/TreadmillModels, designed in Blender:
-- art/treadmills), looked up by Name.
-- Balance (economy sim, a good player with no passes or pets, sharing boxes with other players):
-- biome 6 at ~1.3 h, biome 12 at ~6.5 h, the last biome and the last treadmill (Heavenly) at
-- ~13.4 h; never more than ~1.6 h between two treadmills (Thunder, Magma, Dragon and Supernova
-- fill what were the longest waits). Real players take longer (breaks, getting caught, boxes lost
-- to bats).
local rgb = Color3.fromRGB
Config.Treadmill = {
	BeltSpeed = 13, -- how fast the belt stripes scroll (visual only)
	StepsPerSecond = 12,
	Tiers = {
		{ Name = "Rusty", PerStep = 3, Cost = 0, Base = rgb(120, 110, 100), Accent = rgb(150, 80, 50), Material = Enum.Material.CorrodedMetal },
		{ Name = "Basic", PerStep = 5, Cost = 15_000, Base = rgb(230, 230, 230), Accent = rgb(40, 40, 40), Material = Enum.Material.SmoothPlastic },
		{ Name = "Sporty", PerStep = 12, Cost = 250_000, Base = rgb(220, 40, 40), Accent = rgb(255, 255, 255), Material = Enum.Material.SmoothPlastic },
		{ Name = "Pro", PerStep = 30, Cost = 3_000_000, Base = rgb(40, 90, 200), Accent = rgb(0, 220, 255), Material = Enum.Material.Metal, Neon = true },
		{ Name = "Turbo", PerStep = 80, Cost = 75_000_000, Base = rgb(255, 140, 0), Accent = rgb(255, 240, 0), Material = Enum.Material.Metal, Neon = true, Fire = true },
		{ Name = "Neon", PerStep = 100, Cost = 1_500_000_000, Base = rgb(20, 20, 30), Accent = rgb(0, 255, 120), Material = Enum.Material.SmoothPlastic, Neon = true, Light = true },
		{ Name = "Thunder", PerStep = 120, Cost = 10_000_000_000, Base = rgb(30, 40, 80), Accent = rgb(255, 225, 40), Material = Enum.Material.Metal, Neon = true, Light = true },
		{ Name = "Diamond", PerStep = 250, Cost = 50_000_000_000, Base = rgb(150, 230, 255), Accent = rgb(255, 255, 255), Material = Enum.Material.Glass, Neon = true, Light = true, Sparkles = true },
		{ Name = "Magma", PerStep = 300, Cost = 250_000_000_000, Base = rgb(45, 35, 35), Accent = rgb(255, 110, 20), Material = Enum.Material.Basalt, Neon = true, Light = true, Fire = true },
		{ Name = "Plasma", PerStep = 500, Cost = 1_000_000_000_000, Base = rgb(60, 10, 90), Accent = rgb(200, 60, 255), Material = Enum.Material.SmoothPlastic, Neon = true, Light = true, Sparkles = true },
		{ Name = "Quantum", PerStep = 1_000, Cost = 15_000_000_000_000, Base = rgb(10, 10, 10), Accent = rgb(255, 0, 170), Material = Enum.Material.Glass, Neon = true, Light = true, Sparkles = true, Rainbow = true },
		{ Name = "Cosmic", PerStep = 1_500, Cost = 45_000_000_000_000, Base = rgb(40, 20, 90), Accent = rgb(120, 200, 255), Material = Enum.Material.Glass, Neon = true, Light = true, Sparkles = true, Rainbow = true, Halo = true },
		{ Name = "Void", PerStep = 2_000, Cost = 100_000_000_000_000, Base = rgb(5, 5, 10), Accent = rgb(150, 90, 255), Material = Enum.Material.Glass, Neon = true, Light = true, Sparkles = true, Halo = true },
		{ Name = "Dragon", PerStep = 2_400, Cost = 300_000_000_000_000, Base = rgb(20, 120, 70), Accent = rgb(255, 200, 50), Material = Enum.Material.SmoothPlastic, Neon = true, Light = true, Fire = true },
		{ Name = "Supernova", PerStep = 3_000, Cost = 800_000_000_000_000, Base = rgb(255, 150, 40), Accent = rgb(255, 250, 210), Material = Enum.Material.SmoothPlastic, Neon = true, Light = true, Sparkles = true, Halo = true },
		{ Name = "Heavenly", PerStep = 4_000, Cost = 3_000_000_000_000_000, Base = rgb(255, 250, 235), Accent = rgb(255, 215, 90), Material = Enum.Material.Marble, Neon = true, Light = true, Sparkles = true, Rainbow = true, Halo = true, Heavenly = true },
	} :: { TreadmillTier },
	-- Version 8 of the save data added Thunder, Magma, Dragon and Supernova: an old treadmill level
	-- -> the same treadmill's level now (DataService migrates it)
