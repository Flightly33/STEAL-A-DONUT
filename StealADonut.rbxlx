	},
	{
		Id = "Frozen", Name = "Frozen Fortress", SpeedCost = 100_000,
		Floor = Color3.fromRGB(200, 235, 255), FloorAlt = Color3.fromRGB(180, 220, 250), FloorMaterial = Enum.Material.Ice,
