	D("rootaccess", "Root Access Admino", "Admin", 33, 1.19e28, 0.004, rgb(15, 15, 20), rgb(255, 30, 40), ADMIN, { "Crown", "Sunglasses", "Cape", "Wings", "Halo", "Orbit", "Antenna" }),

