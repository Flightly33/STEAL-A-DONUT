        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="67">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Steal a Donut - client entry point.
]]

local UI = script:WaitForChild("UI")

local Theme = require(UI.Theme)
Theme.WireClickSounds(Theme.PlayerGui()) -- every button clicks like a soft keyboard key

local Notifications = require(UI.Notifications)
local HUD = require(UI.HUD)
local Shop = require(UI.Shop)
local Index = require(UI.Index)
local Leaderboards = require(UI.Leaderboards)
local Chase = require(UI.Chase)
local Settings = require(UI.Settings)
local Trails = require(UI.Trails)
local Teleport = require(UI.Teleport)
local Sell = require(UI.Sell)
local BaseSize = require(UI.BaseSize)
local PetsWindow = require(UI.PetsWindow)
local Donate = require(UI.Donate)
local SkipOdds = require(UI.SkipOdds)
local Admin = require(UI.Admin)
local CrateOpen = require(UI.CrateOpen)
local Tutorial = require(UI.Tutorial)
local UpdateNotes = require(UI.UpdateNotes)
local PassOffer = require(UI.PassOffer)
local EventBanner = require(UI.EventBanner)
local HideUI = require(UI.HideUI)
local CosmicForge = require(UI.CosmicForge)
local Effects = require(script.Effects)
local BlackHoleFX = require(script.BlackHoleFX)
local Treadmill = require(script.Treadmill)
local Guards = require(script.Guards)
local Weather = require(script.Weather)
local StormFX = require(script.StormFX)
local MeteorFX = require(script.MeteorFX)
local DonutIdle = require(script.DonutIdle)
local DonutFX = require(script.DonutFX)
local DonutGlow = require(script.DonutGlow)
local Conveyors = require(script.Conveyors)
local Followers = require(script.Followers)
local Carried = require(script.Carried)
local TrailFX = require(script.TrailFX)
local BoxFX = require(script.BoxFX)
local PetFX = require(script.PetFX)
local Flight = require(script.Flight)
local ChatTags = require(script.ChatTags)
local Culling = require(script.Culling)
local ParticleBudget = require(script.ParticleBudget)

Notifications.Init()
Shop.Init()
Index.Init()
Leaderboards.Init()
Chase.Init()
Settings.Init()
Trails.Init()
Teleport.Init()
Sell.Init()
BaseSize.Init()
PetsWindow.Init()
Donate.Init()
SkipOdds.Init()
Admin.Init()
CrateOpen.Init()
Tutorial.Init()
UpdateNotes.Init()
PassOffer.Init()
EventBanner.Init()
ChatTags.Init()
HideUI.Init()
CosmicForge.Init()
HUD.Init({
	OpenShop = Shop.Open,
	OpenIndex = Index.Open,
	OpenSettings = Settings.Open,
	OpenTrails = Trails.Open,
	OpenTeleport = Teleport.Open,
	OpenBaseSize = BaseSize.Open,
	OpenPets = PetsWindow.Open,
	OpenDonate = Donate.Open,
	OpenUpdates = function()
		UpdateNotes.Open()
	end,
	OpenAdmin = Admin.Open,
	HideUI = HideUI.Toggle,
	UnclaimedIndex = Index.UnclaimedCount,
	TrailReady = Trails.IsReady,
	ReadyEggs = PetsWindow.ReadyEggs,
})
Effects.Init()
DonutFX.Init() -- right after Effects, so it sees every donut in its resting spot
DonutGlow.Init()
Conveyors.Init()
BlackHoleFX.Init()
Treadmill.Init()
Guards.Init()
Weather.Init()
StormFX.Init(Settings.SetStorm)
MeteorFX.Init()
DonutIdle.Init()
Followers.Init()
Carried.Init()
TrailFX.Init()
BoxFX.Init()
PetFX.Init()
Flight.Init()
ParticleBudget.Init()
Culling.Init() -- last: everything else has seen the whole map first

-- Tell the server the UI is listening (it then sends the welcome-back popup, etc.)
require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Remotes")).Event("ClientReady"):FireServer()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">AreaTracker</string>
            <string name="Source"><![CDATA[--[[
	Tracks which biome the local player is standing in (0 = the lobby). Anyone can walk into any
	biome: a biome's Speed is what you need to get away from its Domer, not to get in.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Layout)
local Signal = require(Shared.Signal)

local player = Players.LocalPlayer :: Player

local AreaTracker = {}
AreaTracker.Current = -1
AreaTracker.Changed = Signal.new() -- (newArea, oldArea)

function AreaTracker.Position(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

task.spawn(function()
	while true do
		local position = AreaTracker.Position()
		if position then
			local area = Layout.AreaAt(position)
			if area ~= AreaTracker.Current then
				local old = AreaTracker.Current
				AreaTracker.Current = area
				AreaTracker.Changed:Fire(area, old)
			end
		end
		task.wait(0.2)
	end
end)

return AreaTracker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">Bases</string>
            <string name="Source"><![CDATA[--[[
	Bases: find base plots in the map from the client. The 8 bases sit in the lobby
	(workspace.Map.Plots.PlotN); the local player's is player attribute PlotIndex.
]]

local Players = game:GetService("Players")

local player = Players.LocalPlayer :: Player

local Bases = {}

function Bases.GetPlot(plotIndex: any): Model?
	local map = workspace:FindFirstChild("Map")
	if not map or type(plotIndex) ~= "number" then
		return nil
	end
	local plots = map:FindFirstChild("Plots")
	local plot = plots and plots:FindFirstChild("Plot" .. plotIndex)
	return if plot and plot:IsA("Model") then plot else nil
end

-- The local player's base plot.
function Bases.Mine(): Model?
	return Bases.GetPlot(player:GetAttribute("PlotIndex"))
end

return Bases
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">BlackHoleFX</string>
            <string name="Source"><![CDATA[--[[
	BlackHoleFX: brings the black holes (server/BlackHoleModel) to life on the client.
	  * the lens rings (the photon ring and the light bent round the shadow) turn to face your camera
	  * hot spots orbit in the disk, the inner ones faster
	  * the swirl of infalling sparks and dust turns (the sparks are locked to it, so they spiral in)
	  * the disk's spiral arms spin round, so you see the whole disk turning
	  * the glow breathes
	  * the lab's containment rings spin and wobble, and its containment reading flickers
	  * in The Black Hole the colour grading throbs slowly, as if space itself were pulsing
	Only black holes the camera is near enough to see are animated.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Areas = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Areas"))

local AreaTracker = require(script.Parent.AreaTracker)

local BlackHoleFX = {}

local AREA = #Areas.List -- The Black Hole (the last biome)
local VIEW_DISTANCE = 6000 -- (the Eternal Storm's hangs high over the middle of a long lane)
local LAB_DISTANCE = 300

type Spot = { Part: BasePart, Radius: number, Angle: number, Speed: number }
type Hole = {
	Center: Vector3,
	Disk: CFrame,
	Lens: BasePart?,
	Inflow: BasePart?,
	Spin: number,
	Swirl: BasePart?,
	SwirlSpin: number,
	Spots: { Spot },
	Glow: PointLight?,
	GlowBase: number,
}
type Gyro = { Model: Model, Center: Vector3, Tilt: CFrame, Spin: number, Precess: number }

local function track<T>(tag: string, onAdd: (Instance) -> T?): { [Instance]: T }
	local set: { [Instance]: T } = {}
	local function add(instance: Instance)
		local value = onAdd(instance)
		if value ~= nil and instance.Parent then
			set[instance] = value
		end
	end
	for _, instance in CollectionService:GetTagged(tag) do
		task.spawn(add, instance)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance)
		set[instance] = nil
	end)
	return set
end

local function number(instance: Instance, name: string): number
	local value = instance:GetAttribute(name)
	return if type(value) == "number" then value else 0
end

-- A frame at `center` whose -Z looks at `target`, with Y as close to `up` as it can be.
local function facing(center: Vector3, target: Vector3, up: Vector3): CFrame
	local look = target - center
	if look.Magnitude < 0.01 then
		return CFrame.new(center)
	end
	local back = -look.Unit
	local right = up:Cross(back)
	if right.Magnitude < 0.01 then
		right = Vector3.zAxis:Cross(back)
	end
	right = right.Unit
	return CFrame.fromMatrix(center, right, back:Cross(right), back)
end

local function addHole(instance: Instance): Hole?
	if not instance:IsA("Model") then
		return nil
	end
	local core = instance:WaitForChild("Core", 10)
	local frame = instance:WaitForChild("DiskFrame", 10)
	if not (core and core:IsA("BasePart") and frame and frame:IsA("BasePart")) then
		return nil
	end
	local lens = instance:FindFirstChild("Lens")
	local inflow = instance:FindFirstChild("Inflow")
	local swirl = instance:FindFirstChild("Swirl")
	local glow = core:FindFirstChild("Glow")
	local spots: { Spot } = {}
	for _, child in instance:GetChildren() do
		if child:IsA("BasePart") and child.Name == "HotSpot" then
			table.insert(spots, { Part = child, Radius = number(child, "Radius"), Angle = number(child, "Angle"), Speed = number(child, "Speed") })
		end
	end
	return {
		Center = core.Position,
		Disk = frame.CFrame,
		Lens = if lens and lens:IsA("BasePart") then lens else nil,
		Inflow = if inflow and inflow:IsA("BasePart") then inflow else nil,
		Spin = if inflow then number(inflow, "Spin") else 0,
		Swirl = if swirl and swirl:IsA("BasePart") then swirl else nil,
		SwirlSpin = if swirl then number(swirl, "Spin") else 0,
		Spots = spots,
		Glow = if glow and glow:IsA("PointLight") then glow else nil,
		GlowBase = if glow and glow:IsA("PointLight") then glow.Brightness else 0,
	}
end

local function addGyro(instance: Instance): Gyro?
	if not instance:IsA("Model") then
		return nil
	end
	local hub = instance.PrimaryPart or instance:WaitForChild("Hub", 10)
	if not hub or not hub:IsA("BasePart") then
		return nil
	end
	instance.PrimaryPart = hub
	local pivot = hub.CFrame
	return { Model = instance, Center = pivot.Position, Tilt = pivot - pivot.Position, Spin = number(instance, "Spin"), Precess = number(instance, "Precess") }
end

function BlackHoleFX.Init()
	local holes: { [Instance]: Hole } = track("BlackHole", addHole)
	local gyros: { [Instance]: Gyro } = track("GyroRing", addGyro)
	local readouts: { [Instance]: TextLabel } = track("LabReadout", function(instance): TextLabel?
		return if instance:IsA("TextLabel") then instance else nil
	end)

	-- Space throbbing in The Black Hole (fades in and out as you arrive and leave)
	local pulse = Instance.new("ColorCorrectionEffect")
	pulse.Name = "GravityPulse"
	pulse.Enabled = false
	pulse.Parent = Lighting
	local strength = 0

	local nextReading = 0
	RunService.RenderStepped:Connect(function(dt: number)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local cam = camera.CFrame.Position
		local t = os.clock()

		for model, hole in holes do
			if not model.Parent then
				holes[model] = nil
				continue
			end
			if (hole.Center - cam).Magnitude > VIEW_DISTANCE then
				continue
			end
			if hole.Lens then
				hole.Lens.CFrame = facing(hole.Center, cam, hole.Disk.UpVector)
			end
			for _, spot in hole.Spots do
				spot.Part.CFrame = hole.Disk * CFrame.Angles(0, spot.Angle + t * spot.Speed, 0) * CFrame.new(spot.Radius, 0, 0)
			end
			if hole.Inflow then
				hole.Inflow.CFrame = hole.Disk * CFrame.Angles(0, t * hole.Spin, 0)
			end
			if hole.Swirl then
				hole.Swirl.CFrame = hole.Disk * CFrame.Angles(0, t * hole.SwirlSpin, 0)
			end
			if hole.Glow then
				hole.Glow.Brightness = hole.GlowBase * (1 + 0.18 * math.sin(t * 1.7))
			end
		end

		-- The lab (under the floor): containment rings and the flickering reading
		for model, gyro in gyros do
			if not model.Parent then
				gyros[model] = nil
			elseif cam.Y < gyro.Center.Y + 40 and (gyro.Center - cam).Magnitude < LAB_DISTANCE then
				gyro.Model:PivotTo(CFrame.new(gyro.Center) * CFrame.Angles(0, t * gyro.Precess, 0) * gyro.Tilt * CFrame.Angles(0, t * gyro.Spin, 0))
			end
		end
		if t >= nextReading then
			nextReading = t + 0.4
			for label in readouts do
				local text = label :: TextLabel
				local reading = 96 + math.random() * 3.9
				text.Text = string.format("CONTAINMENT FIELD: %.1f%%", reading)
				text.TextColor3 = if reading < 97 then Color3.fromRGB(255, 210, 0) else Color3.fromRGB(80, 255, 170)
			end
		end

		local target = if AreaTracker.Current == AREA then 1 else 0
		strength += (target - strength) * math.min(1, dt * 1.5)
		pulse.Enabled = strength > 0.01
		if pulse.Enabled then
			local wave = math.sin(t * 1.1)
			pulse.Contrast = strength * (0.05 + 0.05 * wave)
			pulse.Saturation = strength * 0.06 * math.sin(t * 1.1 + 1)
			pulse.TintColor = Color3.new(1, 1 - strength * 0.03 * (1 + wave), 1)
		end
	end)
end

return BlackHoleFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">BoxFX</string>
            <string name="Source"><![CDATA[--[[
	BoxFX: donut boxes on the client.
	  * Boxes in the biomes ("LaneBox"): a gentle bob and turn so they catch the eye (only the ones
	    near you move).
	  * Boxes in pens ("PenBox"): the time left counts down on the label over each one, worked out
	    here from its HatchAt attribute so the server doesn't send anything every second. Once it's
	    ready the box hops and wiggles, the label flashes CLICK TO OPEN!, and its owner clicks (or
	    taps) it, or presses E, to open it. Only the owner sees the prompts ("Open now" for Robux
	    while it waits, "Open!" once it's ready) and can click it.
	  * Opening (remote "BoxOpened"): the lid flips off, the box spins faster and faster, a white
	    flash - and the donut pops out, then drops into its owner's inventory (flies to them).
	  * The pill at the top: the Box Rush (every Config.Boxes.Rush.Interval seconds every box in
	    every pen opens Rush.Speed times faster for Rush.Duration seconds), and in a biome the time
	    until every box is replaced with a fresh one. "ALL BOXES RESET!" when that happens.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Boxes = require(Shared.Boxes)
local Donuts = require(Shared.Donuts)
local DonutModel = require(Shared.DonutModel)
local Rarities = require(Shared.Rarities)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.UI.Theme)
local Notifications = require(script.Parent.UI.Notifications)
local AreaTracker = require(script.Parent.AreaTracker)

local BoxFX = {}

local player = Players.LocalPlayer :: Player

local BOB_RANGE = 180 -- biome boxes further away than this don't bob
-- the lid's parts fly off together: BoxModel names them all "Lid..." or "Bow..."
local function isLidPart(name: string): boolean
	local start = string.sub(name, 1, 3)
	return start == "Lid" or start == "Bow"
end

type Bobbing = { Model: Model, Parts: { BasePart }, Offsets: { CFrame }, Pivot: CFrame, Phase: number }

type PenBox = {
	Model: Model,
	Timer: TextLabel,
	Mine: boolean,
	Skip: ProximityPrompt?,
	Open: ProximityPrompt?,
	Parts: { BasePart },
	Offsets: { CFrame },
	Pivot: CFrame,
	Phase: number,
}

local bobbing: { [Model]: Bobbing } = {}
local bulkMove = true -- (workspace:BulkMoveTo, if this client has it)
local penBoxes: { [Model]: PenBox } = {}
local READY_GOLD = Color3.fromRGB(255, 215, 70)
local WIGGLE_RANGE = 120 -- ready boxes further away than this don't wiggle

local function rushing(): boolean
	local endsAt = workspace:GetAttribute("BoxRushEndsAt")
	return type(endsAt) == "number" and endsAt > workspace:GetServerTimeNow()
end

--------------------------------------------------------------------------------
-- Biome boxes: bob and turn
--------------------------------------------------------------------------------
local function addLaneBox(model: Instance)
	if not model:IsA("Model") or bobbing[model] then
		return
	end
	local pivot = model:GetPivot()
	local parts, offsets = {}, {}
	for _, part in model:GetDescendants() do
		-- (the glowing ring stays on the ground)
		if part:IsA("BasePart") and part.Name ~= "GroundRing" then
			table.insert(parts, part)
			table.insert(offsets, pivot:ToObjectSpace(part.CFrame))
		end
	end
	bobbing[model] = { Model = model, Parts = parts, Offsets = offsets, Pivot = pivot, Phase = math.random() * math.pi * 2 }
end

local function moveParts(parts: { BasePart }, frames: { CFrame })
	if #parts == 0 then
		return
	end
	if bulkMove then
		local ok = pcall(function()
			workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
		end)
		bulkMove = ok
	end
	if not bulkMove then
		for i, part in parts do
			part.CFrame = frames[i]
		end
	end
end

local function updateBobbing(now: number, position: Vector3?, parts: { BasePart }, frames: { CFrame })
	for model, info in bobbing do
		if not model.Parent then
			bobbing[model] = nil
			continue
		end
		if not position or (info.Pivot.Position - position).Magnitude > BOB_RANGE then
			continue
		end
		local t = now + info.Phase
		local bob = info.Pivot * CFrame.new(0, 0.35 + math.sin(t * 2.2) * 0.3, 0) * CFrame.Angles(0, math.sin(t * 0.9) * 0.18, math.sin(t * 1.7) * 0.03)
		for i, part in info.Parts do
			table.insert(parts, part)
			table.insert(frames, bob * info.Offsets[i])
		end
	end
end

--------------------------------------------------------------------------------
-- Pen boxes: countdowns, then "CLICK TO OPEN!"
--------------------------------------------------------------------------------
local function setEnabled(prompt: ProximityPrompt?, on: boolean)
	if prompt and prompt.Enabled ~= on then
		prompt.Enabled = on
	end
end

local function addPenBox(model: Instance)
	if not model:IsA("Model") or penBoxes[model] then
		return
	end
	task.defer(function()
		-- (a box's parts and labels can arrive a moment after the box itself)
		local root = model:WaitForChild("Root", 10)
		local info = root and root:WaitForChild("BoxInfo", 10)
		local pill = info and info:WaitForChild("TimerPill", 10)
		local timer = pill and pill:WaitForChild("Timer", 10)
		if not root or not timer or not timer:IsA("TextLabel") or not model.Parent or penBoxes[model] then
			return
		end
		local skip = root:WaitForChild("SkipPrompt", 5)
		local open = root:WaitForChild("OpenPrompt", 5)
		local mine = model:GetAttribute("OwnerUserId") == player.UserId
		-- other players' boxes: no prompts and no clicking (the server checks too)
		local click = model:FindFirstChild("OpenClick")
		if click and click:IsA("ClickDetector") and not mine then
			click.MaxActivationDistance = 0
		end
		local pivot = model:GetPivot()
		local parts, offsets = {}, {}
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				table.insert(parts, part)
				table.insert(offsets, pivot:ToObjectSpace(part.CFrame))
			end
		end
		penBoxes[model] = {
			Model = model,
			Timer = timer,
			Mine = mine,
			Skip = if skip and skip:IsA("ProximityPrompt") then skip else nil,
			Open = if open and open:IsA("ProximityPrompt") then open else nil,
			Parts = parts,
			Offsets = offsets,
			Pivot = pivot,
			Phase = math.random() * 1.6,
		}
	end)
end

local function isReady(entry: PenBox, now: number): boolean
	local hatchAt = entry.Model:GetAttribute("HatchAt")
	return entry.Model:GetAttribute("Ready") == true or (type(hatchAt) == "number" and hatchAt - now <= 0.5)
end

local function updateTimers()
	local now = workspace:GetServerTimeNow()
	local rush = rushing()
	for model, entry in penBoxes do
		if not model.Parent then
			penBoxes[model] = nil
			continue
		end
		local ready = isReady(entry, now)
		setEnabled(entry.Skip, entry.Mine and not ready)
		setEnabled(entry.Open, entry.Mine and ready)
		local text, color
		if ready then
			text = if entry.Mine then "CLICK TO OPEN!" else "READY"
			-- (flashes between gold and white)
			color = if math.floor(os.clock() * 2.5) % 2 == 0 then READY_GOLD else Color3.new(1, 1, 1)
		else
			local hatchAt = model:GetAttribute("HatchAt") :: number
			text = `{Format.Duration(math.ceil(hatchAt - now))}{if rush then ` x{Config.Boxes.Rush.Speed}` else ""}`
			color = if rush then Color3.fromRGB(120, 230, 255) else Color3.new(1, 1, 1)
		end
		if entry.Timer.Text ~= text then
			entry.Timer.Text = text
		end
		if entry.Timer.TextColor3 ~= color then
			entry.Timer.TextColor3 = color
		end
	end
end

-- Your ready boxes hop and wiggle now and then, so you notice them.
local function updateWiggle(now: number, position: Vector3?, parts: { BasePart }, frames: { CFrame })
	if not position then
		return
	end
	local serverNow = workspace:GetServerTimeNow()
	for model, entry in penBoxes do
		if not entry.Mine or not model.Parent or not isReady(entry, serverNow) or (entry.Pivot.Position - position).Magnitude > WIGGLE_RANGE then
			continue
		end
		local t = (now + entry.Phase) % 1.6
		local cf = entry.Pivot
		if t < 0.5 then
			local k = t / 0.5
			cf = entry.Pivot * CFrame.new(0, math.sin(k * math.pi) * 0.8, 0) * CFrame.Angles(0, 0, math.sin(k * math.pi * 4) * 0.12 * (1 - k))
		end
		for i, part in entry.Parts do
			table.insert(parts, part)
			table.insert(frames, cf * entry.Offsets[i])
		end
	end
end

--------------------------------------------------------------------------------
-- Opening
--------------------------------------------------------------------------------
type Opened = { Owner: Player?, Slot: number, Box: Model?, DonutId: string, Mutation: string?, Size: string? }

local function hide(model: Model)
	for _, child in model:GetDescendants() do
		if child:IsA("BasePart") then
			child.Transparency = 1
		elseif child:IsA("LayerCollector") then
			child.Enabled = false
		elseif child:IsA("ParticleEmitter") then
			child.Enabled = false
		elseif child:IsA("Light") then
			child.Enabled = false
		elseif child:IsA("ProximityPrompt") then
			child.Enabled = false
		end
	end
end

local function screenFlash()
	local gui = Theme.ScreenGui("BoxFlash", 30)
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.None
	local frame = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.35, BorderSizePixel = 0, Parent = gui })
	TweenService:Create(frame, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	task.delay(0.6, function()
		gui:Destroy()
	end)
end

-- The donut that came out: pops up over the box, then flies to its owner and is gone (it's in
-- their inventory now).
local function popDonut(info: Opened, at: CFrame, boxScale: number)
	local donut = Donuts.ById[info.DonutId]
	if not donut then
		return
	end
	local model = DonutModel.Build(donut, { Scale = 0.75 * math.sqrt(boxScale), Mutation = info.Mutation, Size = info.Size, Calm = true })
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	local rarity = Rarities.Get(donut.Rarity)
	local mutation = Rarities.Mutation(info.Mutation)
	local label = Theme.new("BillboardGui", { Size = UDim2.fromOffset(260, 56), StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0), AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 120 })
	Theme.Label({ Text = Rarities.DisplayName(donut.Name, info.Mutation, info.Size), TextColor3 = if mutation.Order > 0 then mutation.Color else rarity.Color, Size = UDim2.new(1, 0, 0.6, 0), StrokeThickness = 2.5, Parent = label })
	Theme.Label({ Text = string.upper(rarity.Id), Font = Theme.Font, TextColor3 = rarity.Color, Size = UDim2.new(1, 0, 0.4, 0), Position = UDim2.fromScale(0, 0.6), StrokeThickness = 2, Parent = label })
	label.Adornee = model.PrimaryPart
	label.Parent = model
	model.Parent = workspace

	local start = os.clock()
	local rise, hold, fly = 0.35, 0.75, 0.45
	local from = at.Position
	local connection: RBXScriptConnection? = nil
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		local spin = CFrame.Angles(0, t * 4, 0)
		if t < rise + hold then
			local k = math.min(t / rise, 1)
			local up = 4 * boxScale * (1 - (1 - k) ^ 3) + math.sin(t * 5) * 0.15
			model:PivotTo(CFrame.new(from + Vector3.new(0, up, 0)) * spin)
		elseif t < rise + hold + fly then
			local k = (t - rise - hold) / fly
			local owner = info.Owner
			local root = owner and owner.Character and owner.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local top = from + Vector3.new(0, 4 * boxScale, 0)
			local target = if root then root.Position else top
			-- an arc from over the box down into its owner
			local p = top:Lerp(target, k * k) + Vector3.new(0, math.sin(k * math.pi) * 3, 0)
			model:PivotTo(CFrame.new(p) * spin)
		else
			if connection then
				connection:Disconnect()
			end
			model:Destroy()
			if info.Owner == player then
				Theme.PlaySound("Collect")
			end
		end
	end)
end

local function onBoxOpened(info: Opened)
	local box = info.Box
	local root = box and box.Parent and box.PrimaryPart
	if not box or not root then
		return
	end
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local near = myRoot ~= nil and (myRoot.Position - root.Position).Magnitude < 160
	if not near and info.Owner ~= player then
		return -- (nobody to see it: skip the effect)
	end
	local tier = Boxes.Tier(box:GetAttribute("Tier") :: string?)
	local size = Boxes.Size(box:GetAttribute("BoxSize") :: string?)
	local mutation = Rarities.Mutation(box:GetAttribute("Mutation") :: string?)
	local glow = if mutation.Order > 0 then mutation.Color else tier.Color

	-- Play it on a copy (the server removes the real box in a moment)
	local copy = box:Clone()
	for _, child in copy:GetDescendants() do
		if child:IsA("BillboardGui") or child:IsA("ProximityPrompt") then
			child:Destroy()
		end
	end
	CollectionService:RemoveTag(copy, "PenBox")
	hide(box)
	copy.Parent = workspace
	local pivot = copy:GetPivot()
	local lidParts, bodyParts, lidOffsets, bodyOffsets = {}, {}, {}, {}
	for _, part in copy:GetDescendants() do
		if part:IsA("BasePart") then
			if isLidPart(part.Name) then
				table.insert(lidParts, part)
				table.insert(lidOffsets, pivot:ToObjectSpace(part.CFrame))
			else
				table.insert(bodyParts, part)
				table.insert(bodyOffsets, pivot:ToObjectSpace(part.CFrame))
			end
		end
	end
	local scale = size.Scale
	local top = (copy:GetAttribute("Top") :: number?) or 3
	Theme.PlaySound("Crack")

	local start = os.clock()
	local LID, SPIN = 0.4, 1.25
	local angle = 0
	local flashed = false
	local connection: RBXScriptConnection? = nil
	connection = RunService.RenderStepped:Connect(function(dt: number)
		local t = os.clock() - start
		-- the lid flips up and off backwards, fading
		local lk = math.min(t / LID, 1)
		local lidFrame = pivot * CFrame.new(0, top * 0.8 * lk + 2 * scale * lk, 1.6 * scale * lk) * CFrame.Angles(-lk * math.rad(110), 0, 0)
		for i, part in lidParts do
			part.CFrame = lidFrame * lidOffsets[i]
			part.Transparency = math.max(part.Transparency, lk ^ 2)
		end
		-- the box spins faster and faster, lifting a little
		if t > LID * 0.5 then
			local sk = math.clamp((t - LID * 0.5) / SPIN, 0, 1)
			angle += dt * (3 + sk * sk * 30)
			local spin = pivot * CFrame.new(0, sk * 1.2 * scale, 0) * CFrame.Angles(0, angle, 0)
			for i, part in bodyParts do
				part.CFrame = spin * bodyOffsets[i]
			end
		end
		if not flashed and t >= LID * 0.5 + SPIN then
			flashed = true
			if connection then
				connection:Disconnect()
			end
			-- white flash
			local center = (pivot * CFrame.new(0, top * 0.5 + 1.2 * scale, 0)).Position
			copy:Destroy()
			local ball = Instance.new("Part")
			ball.Shape = Enum.PartType.Ball
			ball.Anchored = true
			ball.CanCollide = false
			ball.CanQuery = false
			ball.CanTouch = false
			ball.CastShadow = false
			ball.Material = Enum.Material.Neon
			ball.Color = Color3.new(1, 1, 1)
			ball.Size = Vector3.one * 2 * scale
			ball.CFrame = CFrame.new(center)
			local light = Instance.new("PointLight")
			light.Color = glow:Lerp(Color3.new(1, 1, 1), 0.5)
			light.Brightness = 6
			light.Range = 24 * math.sqrt(scale)
			light.Parent = ball
			ball.Parent = workspace
			TweenService:Create(ball, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * 12 * scale, Transparency = 1 }):Play()
			TweenService:Create(light, TweenInfo.new(0.45), { Brightness = 0 }):Play()
			task.delay(0.5, function()
				ball:Destroy()
			end)
			if info.Owner == player then
				screenFlash()
			end
			Theme.PlaySound(if tier.Order >= 3 or mutation.Order >= 3 then "Rare" else "Hatch")
			popDonut(info, CFrame.new(center), scale)
		end
	end)
end

--------------------------------------------------------------------------------
-- The pill at the top: Box Rush and the next reset
--------------------------------------------------------------------------------
local function buildPill(): (Frame, TextLabel)
	local gui = Theme.ScreenGui("BoxTimers", 2)
	local pill = Theme.new("Frame", {
		Name = "BoxPill",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 46),
		Size = UDim2.fromOffset(400, 34),
		BackgroundColor3 = Color3.fromRGB(40, 30, 60),
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = gui,
	}, {
		Theme.Corner(17),
		Theme.Stroke(2.5),
	})
	Theme.AutoScale(pill)
	local label = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -16, 1, -6), Position = UDim2.fromOffset(8, 3), StrokeThickness = 2, Parent = pill })
	return pill, label
end

local function updatePill(pill: Frame, label: TextLabel)
	local now = workspace:GetServerTimeNow()
	local rushEnds = workspace:GetAttribute("BoxRushEndsAt")
	local rushAt = workspace:GetAttribute("BoxRushAt")
	local reset = workspace:GetAttribute("BoxReset")
	local text, color = nil, Color3.new(1, 1, 1)
	if type(rushEnds) == "number" and rushEnds > now then
		text = `⏩ BOX RUSH! Pen boxes open {Config.Boxes.Rush.Speed}x faster • {math.ceil(rushEnds - now)}s`
		color = Color3.fromRGB(120, 230, 255)
	elseif type(rushAt) == "number" and rushAt - now <= 10 and rushAt > now then
		text = `⏩ Box Rush in {math.ceil(rushAt - now)}s!`
		color = Color3.fromRGB(120, 230, 255)
	elseif AreaTracker.Current > 0 and type(reset) == "number" and reset > now then
		text = `📦 New boxes in {Format.Duration(math.ceil(reset - now))}`
		color = Color3.fromRGB(255, 220, 120)
	end
	pill.Visible = text ~= nil
	if text and label.Text ~= text then
		label.Text = text
		label.TextColor3 = color
	end
end

function BoxFX.Init()
	for _, model in CollectionService:GetTagged("LaneBox") do
		addLaneBox(model)
	end
	CollectionService:GetInstanceAddedSignal("LaneBox"):Connect(addLaneBox)
	CollectionService:GetInstanceRemovedSignal("LaneBox"):Connect(function(model)
		bobbing[model :: Model] = nil
	end)
	for _, model in CollectionService:GetTagged("PenBox") do
		addPenBox(model)
	end
	CollectionService:GetInstanceAddedSignal("PenBox"):Connect(addPenBox)

	Remotes.Event("BoxOpened").OnClientEvent:Connect(onBoxOpened)
	Remotes.Event("BoxesReset").OnClientEvent:Connect(function()
		if AreaTracker.Current > 0 then
			Notifications.Banner("📦 ALL BOXES RESET!", Color3.fromRGB(255, 200, 90), 2, "Fresh boxes next to every Domer")
		end
	end)

	local pill, label = buildPill()
	local nextBob = 0
	local nextTick = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now >= nextBob then
			nextBob = now + 1 / 30
			local position = AreaTracker.Position()
			local parts, frames = {}, {}
			updateBobbing(now, position, parts, frames)
			updateWiggle(now, position, parts, frames)
			moveParts(parts, frames)
		end
		if now >= nextTick then
			nextTick = now + 0.25
			updateTimers()
			updatePill(pill, label)
		end
	end)
end

return BoxFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Carried</string>
            <string name="Source"><![CDATA[--[[
	Carried: the box (or donut, or egg, or meteor shard) each player is carrying, drawn by every client.

	The server only sets attributes on the carrier - CarryingDonut (the box's tier, the donut's or
	the egg's id), CarryKind ("Box" / "Egg" / "Shard"), CarryMutation and CarrySize - and every client
	builds the model itself: boxes, shards and donuts held in both arms in front of you (arms raised),
	eggs above the head. Nothing is sent over
	the network and nothing is welded into a character on the server, which is what used to make the
	first second of a steal stutter on phones (a donut is ~110 parts).

	To make the grab itself instant, the donut is already built while you hold the Steal button, so
	it's ready the moment the server says you got it. Other players' donuts are only built while
	they're near you.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Donuts = require(Shared.Donuts)
local Pets = require(Shared.Pets)
local DonutModel = require(Shared.DonutModel)
local PetModel = require(Shared.PetModel)
local BoxModel = require(Shared.BoxModel)
local Meteor = require(Shared.Meteor)

local Carried = {}

local player = Players.LocalPlayer :: Player

local DONUT_SCALE = 0.45
local EGG_SCALE = 0.6
local BOX_SCALE = 0.7
local SHARD_SCALE = 0.75
local BUILD_RANGE = 250 -- other players' carried donuts are drawn within this many studs of you...
local DROP_RANGE = 320 -- ...and removed again past this
local SPARE_LIFETIME = 6 -- seconds a donut built in advance (while holding Steal) is kept
local ARM_JOINTS = { "RightShoulder", "LeftShoulder", "Right Shoulder", "Left Shoulder" }

type Held = { Key: string, Model: Model, Character: Model, Arms: { [Motor6D]: CFrame } }

local held: { [Player]: Held } = {}
local pending: { [Player]: boolean } = {}
local spare: { Key: string, Model: Model, At: number }? = nil

-- What `target` is carrying, as a key ("Lane|glazey|Gold|Big"), or nil.
local function keyFor(target: Player): string?
	local id = target:GetAttribute("CarryingDonut")
	if type(id) ~= "string" then
		return nil
	end
	local kind = target:GetAttribute("CarryKind")
	local mutation = target:GetAttribute("CarryMutation")
	local size = target:GetAttribute("CarrySize")
	local tag = if kind == "Egg" then "Egg" elseif kind == "Box" then "Box" elseif kind == "Shard" then "Shard" else "Donut"
	return `{tag}|{id}|{mutation or "None"}|{size or "Normal"}`
end

local function build(key: string): Model?
	local fields = string.split(key, "|")
	local model: Model? = nil
	if fields[1] == "Egg" then
		local egg = Pets.EggById[fields[2]]
		model = if egg then PetModel.BuildEgg(egg, { Scale = EGG_SCALE }) else nil
	elseif fields[1] == "Box" or fields[1] == "Shard" then
		local box = if fields[1] == "Box"
			then BoxModel.Build(fields[2], fields[4], { Mutation = fields[3], Scale = BOX_SCALE })
			else Meteor.BuildShard(SHARD_SCALE, 7)
		-- A box (or a shard) is built to stand still: every part anchored, none joined. Weld them all
		-- to its root so the whole box moves with you (otherwise only the invisible root came along
		-- and the box stayed hanging in the air where you grabbed it).
		local root = box.PrimaryPart
		if root then
			for _, part in box:GetDescendants() do
				if part:IsA("BasePart") and part ~= root then
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = root
					weld.Part1 = part
					weld.Parent = part
					part.Anchored = false
				end
			end
		end
		-- (its pivot is its bottom: rest it on your forearms, a little below the chest)
		box:SetAttribute("HoldY", -0.9)
		model = box
	else
		local donut = Donuts.ById[fields[2]]
		model = if donut then DonutModel.Build(donut, { Scale = DONUT_SCALE, Mutation = fields[3], Size = fields[4] }) else nil
	end
	if not model or not model.PrimaryPart then
		return nil
	end
	model.Name = "CarriedDonut"
	model:SetAttribute("Carried", true)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Massless = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
		end
	end
	return model
end

-- Arms reach forward while holding a donut (R15 and R6 shoulder joints); undone when it's gone.
local function raiseArms(character: Model): { [Motor6D]: CFrame }
	local saved: { [Motor6D]: CFrame } = {}
	for _, joint in character:GetDescendants() do
		if joint:IsA("Motor6D") and table.find(ARM_JOINTS, joint.Name) then
			saved[joint] = joint.C0
			-- R6 shoulders point sideways (rotate about their own Z), R15 about X
			joint.C0 = joint.C0
				* (if string.find(joint.Name, " ")
					then CFrame.Angles(0, 0, if joint.Name == "Right Shoulder" then math.rad(80) else math.rad(-80))
					else CFrame.Angles(math.rad(80), 0, 0))
		end
	end
	return saved
end

-- Weld the model to the character: in front of the chest (boxes, donuts) or above the head (eggs, or a
-- character without a torso). The model is parented last, so it joins the character in one go.
local function attach(character: Model, model: Model, inArms: boolean): boolean
	local root = model.PrimaryPart :: BasePart
	local torso = (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")) :: BasePart?
	local head = character:FindFirstChild("Head") :: BasePart?
	local anchor: BasePart?, offset: CFrame
	if inArms and torso then
		local _, size = model:GetBoundingBox()
		anchor, offset = torso, CFrame.new(0, (model:GetAttribute("HoldY") :: number?) or 0.2, -(torso.Size.Z / 2 + size.Z / 2 + 0.3))
	elseif head then
		anchor, offset = head, CFrame.new(0, 1.2 + ((model:GetAttribute("Bottom") :: number?) or 1.4), 0)
	else
		return false
	end
	local part = anchor :: BasePart
	model:PivotTo(part.CFrame * offset)
	root.Anchored = false
	local weld = Instance.new("Weld")
	weld.Part0 = part
	weld.Part1 = root
	weld.C0 = offset
	weld.Parent = root
	model.Parent = character
	return true
end

local function drop(target: Player)
	local current = held[target]
	if not current then
		return
	end
	held[target] = nil
	current.Model:Destroy()
	for joint, c0 in current.Arms do
		if joint.Parent then
			joint.C0 = c0
		end
	end
end

local function inRange(target: Player, range: number): boolean
	if target == player then
		return true
	end
	local camera = workspace.CurrentCamera
	local character = target.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return camera ~= nil and root ~= nil and (root.Position - camera.CFrame.Position).Magnitude < range
end

local function refresh(target: Player)
	pending[target] = nil
	local key = keyFor(target)
	local character = target.Character
	local current = held[target]
	if current and key == current.Key and character == current.Character and current.Model.Parent then
		if not inRange(target, DROP_RANGE) then
			drop(target)
		end
		return
	end
	drop(target)
	if not key or not character or not inRange(target, BUILD_RANGE) then
		return
	end
	local model: Model?
	local ready = spare
	if target == player and ready and ready.Key == key then
		model = ready.Model -- built while you held the Steal button
		spare = nil
	else
		model = build(key)
	end
	if not model then
		return
	end
	-- (eggs ride on your head; boxes and donuts are held in both arms)
	local inArms = string.sub(key, 1, 4) ~= "Egg|"
	if not attach(character, model, inArms) then
		model:Destroy()
		return
	end
	held[target] = { Key = key, Model = model, Character = character, Arms = if inArms then raiseArms(character) else {} }
end

-- Several attributes change together: refresh once, after they've all arrived.
local function schedule(target: Player)
	if not pending[target] then
		pending[target] = true
		task.defer(refresh, target)
	end
end

local function watch(target: Player)
	for _, name in { "CarryingDonut", "CarryKind", "CarryMutation", "CarrySize" } do
		target:GetAttributeChangedSignal(name):Connect(function()
			schedule(target)
		end)
	end
	target.CharacterAdded:Connect(function()
		schedule(target)
	end)
	schedule(target)
end

-- Holding Steal on a donut: build the one you'll carry now, so the grab itself costs nothing.
local function prebuild(prompt: ProximityPrompt, who: Player)
	if who ~= player or prompt.Name ~= "StealPrompt" then
		return
	end
	local source: Instance? = prompt.Parent
	while source and source:GetAttribute("DonutId") == nil and source:GetAttribute("BoxId") == nil do
		source = source.Parent
	end
	if not source then
		return
	end
	local key = if source:GetAttribute("BoxId") ~= nil
		then `Box|{source:GetAttribute("Tier")}|{source:GetAttribute("Mutation") or "None"}|{source:GetAttribute("BoxSize") or "Small"}`
		else `Donut|{source:GetAttribute("DonutId")}|{source:GetAttribute("Mutation") or "None"}|{source:GetAttribute("Size") or "Normal"}`
	if spare and spare.Key == key then
		spare.At = os.clock()
		return
	end
	task.defer(function()
		local model = build(key)
		if not model then
			return
		end
		if spare then
			spare.Model:Destroy()
		end
		spare = { Key = key, Model = model, At = os.clock() }
	end)
end

function Carried.Init()
	for _, target in Players:GetPlayers() do
		watch(target)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(target)
		drop(target)
		pending[target] = nil
	end)
	ProximityPromptService.PromptButtonHoldBegan:Connect(prebuild)

	-- Other players' donuts come and go with distance; an unused spare is thrown away.
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, target in Players:GetPlayers() do
				if target ~= player and keyFor(target) ~= nil then
					local near = held[target] ~= nil
					if near ~= inRange(target, if near then DROP_RANGE else BUILD_RANGE) then
						schedule(target)
					end
				end
			end
			local old = spare
			if old and os.clock() - old.At > SPARE_LIFETIME then
				old.Model:Destroy()
				spare = nil
			end
		end
	end)
end

return Carried
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">ChatTags</string>
            <string name="Source"><![CDATA[--[[
	Chat tags: players with a donor title (from tipping, see ProductService) get it in front of
	their name in chat, in the title's colour, e.g. "[Ultimate Donor] Flightly33: hi".
	The server sets the "DonorTitle" / "DonorTitleColor" attributes on each player.
]]

local Players = game:GetService("Players")

local ChatTags = {}

function ChatTags.Init()
	local ok, TextChatService = pcall(game.GetService, game, "TextChatService")
	if not ok or not TextChatService then
		return
	end
	(TextChatService :: TextChatService).OnIncomingMessage = function(message: TextChatMessage): TextChatMessageProperties?
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		local sender = if source then Players:GetPlayerByUserId(source.UserId) else nil
		local title = if sender then sender:GetAttribute("DonorTitle") else nil
		if sender and type(title) == "string" then
			local color = sender:GetAttribute("DonorTitleColor")
			local hex = if typeof(color) == "Color3" then color:ToHex() else "ff8ad0"
			properties.PrefixText = `<font color="#{hex}">[{title}]</font> {message.PrefixText}`
		end
		return properties
	end
end

return ChatTags
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Conveyors</string>
            <string name="Source"><![CDATA[--[[
	Conveyors: slides the glowing arrows along the lobby's two conveyor belts (MapBuilder), at the
	belts' own speed, so you can see which way each one goes. The belts themselves carry you (the
	server gives them their velocity); this is only the look, on this player's screen.

	Every arrow moves forward by the same amount and jumps back one gap when it has gone a whole
	gap, so the row of arrows looks like one endless moving belt.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Conveyors = {}

local RANGE = 900 -- studs from the camera to a belt's middle: further away its arrows stand still

type Belt = { Parts: { BasePart }, Bases: { CFrame }, Direction: Vector3, Center: Vector3 }

local belts: { Belt } = {}

local function collect(folder: Instance)
	for _, model in folder:GetChildren() do
		local belt = model:FindFirstChild("Belt")
		local direction = belt and belt:GetAttribute("Direction")
		if belt and belt:IsA("BasePart") and typeof(direction) == "Vector3" then
			local parts, bases = {}, {}
			for _, part in model:GetChildren() do
				if part:IsA("BasePart") and part:GetAttribute("ConveyorArrow") then
					table.insert(parts, part)
					table.insert(bases, part.CFrame)
				end
			end
			table.insert(belts, { Parts = parts, Bases = bases, Direction = direction, Center = belt.Position })
		end
	end
end

function Conveyors.Init()
	task.spawn(function()
		local map = workspace:WaitForChild("Map", 60)
		local hub = map and map:WaitForChild("Hub", 30)
		local folder = hub and hub:WaitForChild("Conveyors", 30)
		if not folder then
			return
		end
		task.wait(1) -- (let every arrow arrive)
		collect(folder)
		local spacing = Config.Conveyors.ArrowSpacing
		local speed = Config.Conveyors.Speed
		local clock = 0
		local bulkMove = true
		RunService.RenderStepped:Connect(function(dt: number)
			clock += dt
			local camera = workspace.CurrentCamera
			if not camera then
				return
			end
			local offset = (clock * speed) % spacing
			for _, belt in belts do
				if (camera.CFrame.Position - belt.Center).Magnitude > RANGE then
					continue
				end
				local shift = belt.Direction * offset
				local frames = table.create(#belt.Parts)
				for i, base in belt.Bases do
					frames[i] = base + shift
				end
				if bulkMove then
					bulkMove = pcall(function()
						workspace:BulkMoveTo(belt.Parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
					end)
				end
				if not bulkMove then
					for i, part in belt.Parts do
						part.CFrame = frames[i]
					end
				end
			end
		end)
	end)
end

return Conveyors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Culling</string>
            <string name="Source"><![CDATA[--[[
	Culling: hides what's far away, on this player's screen only. Nothing moves out of its folder
	and nothing changes for anyone else; it's just not drawn.

	  * biomes far ahead or behind: their decorations, boxes, crates, Domer's corner, arch and signs
	    (floors and walls always stay, so you can still see where the lane goes)
	  * bases further than a few plots away
	  * the lobby's sell stall, leaderboards and decorations while you're far down the lane

	Hidden parts get LocalTransparencyModifier = 1 (not drawn) and their lights, particles, beams,
	fire, smoke and signs are switched off; everything comes back as you get close (checked a few
	times a second). Anything that leaves a hidden folder (a donut someone carries off) is shown
	again straight away.
]]

local RunService = game:GetService("RunService")

local Culling = {}

-- Studs from the camera to the nearest edge of the area / base / world
local LANE_DISTANCE = 600
local PLOT_DISTANCE = 520
local WORLD_DISTANCE = 800
local MARGIN = 60 -- hide only this much further out than we show (no flicker at the edge)
local CHECK_EVERY = 0.35
-- Hiding or showing an area touches thousands of parts (every lane donut is ~100), so the work is
-- spread over a few frames instead of one big stutter while you run down the lane.
local BATCH = 1500 -- parts (and lights, emitters...) handled per frame

-- Parts of a lane area / world that always stay
local KEEP = {
	Floor = true,
	Wall = true,
	Walls = true,
	WallTop = true,
	AreaLine = true,
	SafeZoneLine = true,
	SafeZoneLabel = true,
	Bridge = true,
	Arrival = true,
	GatePillar = true,
	HubSpawn = true,
}

type Chunk = {
	Name: string,
	Containers: { Instance },
	Min: Vector3,
	Max: Vector3,
	Distance: number,
	Hidden: boolean,
	Saved: { [Instance]: number | boolean },
	Connections: { RBXScriptConnection },
}

local chunks: { Chunk } = {}

local function bounds(roots: { Instance }): (Vector3?, Vector3?)
	local min, max = nil, nil
	for _, root in roots do
		local list = root:GetDescendants()
		if root:IsA("BasePart") then
			table.insert(list, root)
		end
		for _, part in list do
			if part:IsA("BasePart") then
				local p = part.CFrame.Position
				local half = part.Size / 2
				local lo, hi = p - half, p + half
				min = if min then min:Min(lo) else lo
				max = if max then max:Max(hi) else hi
			end
		end
	end
	return min, max
end

local function addChunk(name: string, containers: { Instance }, boundsFrom: { Instance }, distance: number)
	if #containers == 0 then
		return
	end
	local min, max = bounds(boundsFrom)
	if not min or not max then
		return
	end
	table.insert(chunks, {
		Name = name,
		Containers = containers,
		Min = min,
		Max = max,
		Distance = distance,
		Hidden = false,
		Saved = {},
		Connections = {},
	})
end

-- LocalTransparencyModifier is set directly on parts and decals; only if this engine can't (the
-- offline test runner) does every access go through pcall.
local direct = pcall(function()
	local probe = Instance.new("Part")
	probe.LocalTransparencyModifier = probe.LocalTransparencyModifier
	probe:Destroy()
end)
local function getLocalTransparency(item: Instance): number
	if direct then
		return (item :: any).LocalTransparencyModifier
	end
	local ok, value = pcall(function()
		return (item :: any).LocalTransparencyModifier
	end)
	return if ok and type(value) == "number" then value else 0
end
local function setLocalTransparency(item: Instance, value: number)
	if direct then
		(item :: any).LocalTransparencyModifier = value
		return
	end
	pcall(function()
		(item :: any).LocalTransparencyModifier = value
	end)
end

local function hideOne(chunk: Chunk, item: Instance)
	if chunk.Saved[item] ~= nil then
		return
	end
	if item:IsA("BasePart") or item:IsA("Decal") then
		local current = getLocalTransparency(item)
		if current < 1 then
			chunk.Saved[item] = current
			setLocalTransparency(item, 1)
		end
	elseif item:IsA("Light") or item:IsA("ParticleEmitter") or item:IsA("Beam") or item:IsA("Trail") or item:IsA("Fire") or item:IsA("Smoke") or item:IsA("Sparkles") or item:IsA("LayerCollector") then
		if (item :: any).Enabled then
			chunk.Saved[item] = true;
			(item :: any).Enabled = false
		end
	end
end

local function restoreOne(chunk: Chunk, item: Instance)
	local saved = chunk.Saved[item]
	if saved == nil then
		return
	end
	chunk.Saved[item] = nil
	if type(saved) == "number" then
		setLocalTransparency(item, saved)
	else
		(item :: any).Enabled = true
	end
end

-- Unfinished hide / show work, a batch of items per frame (showing comes first)
type Job = { Chunk: Chunk, Hide: boolean, Items: { Instance }, Next: number }
local jobs: { Job } = {}

local function setHidden(chunk: Chunk, hidden: boolean)
	if chunk.Hidden == hidden then
		return
	end
	chunk.Hidden = hidden
	-- an unfinished job for this chunk was going the other way: drop it
	for i = #jobs, 1, -1 do
		if jobs[i].Chunk == chunk then
			table.remove(jobs, i)
		end
	end
	local items: { Instance } = {}
	if hidden then
		for _, container in chunk.Containers do
			table.insert(items, container)
			local descendants = container:GetDescendants()
			table.move(descendants, 1, #descendants, #items + 1, items)
			table.insert(chunk.Connections, container.DescendantAdded:Connect(function(item: Instance)
				hideOne(chunk, item)
			end))
			-- a donut carried out of a hidden area must show again wherever it goes
			table.insert(chunk.Connections, container.DescendantRemoving:Connect(function(item: Instance)
				restoreOne(chunk, item)
			end))
		end
		table.insert(jobs, { Chunk = chunk, Hide = true, Items = items, Next = 1 })
	else
		for _, connection in chunk.Connections do
			connection:Disconnect()
		end
		table.clear(chunk.Connections)
		for item in chunk.Saved do
			table.insert(items, item)
		end
		table.insert(jobs, 1, { Chunk = chunk, Hide = false, Items = items, Next = 1 })
	end
end

-- Do up to `budget` items of the queued hide / show work.
local function work(budget: number)
	while budget > 0 and #jobs > 0 do
		local job = jobs[1]
		local items, chunk = job.Items, job.Chunk
		local last = math.min(#items, job.Next + budget - 1)
		for i = job.Next, last do
			local item = items[i]
			if job.Hide then
				if item.Parent then
					hideOne(chunk, item)
				end
			else
				restoreOne(chunk, item)
			end
		end
		budget -= last - job.Next + 1
		job.Next = last + 1
		if job.Next > #items then
			table.remove(jobs, 1)
		end
	end
end

-- Distance from a point to the nearest point of a box.
local function distanceToBox(point: Vector3, min: Vector3, max: Vector3): number
	local nearest = point:Max(min):Min(max)
	return (point - nearest).Magnitude
end

local function collect(map: Instance)
	local lane = map:WaitForChild("Lane", 30)
	if lane then
		for _, area in lane:GetChildren() do
			local containers = {}
			for _, child in area:GetChildren() do
				if not KEEP[child.Name] then
					table.insert(containers, child)
				end
			end
			addChunk(area.Name, containers, { area }, LANE_DISTANCE)
		end
	end
	local function plotChunks(folder: Instance?)
		if folder then
			for _, plot in folder:GetChildren() do
				addChunk(plot.Name, { plot }, { plot }, PLOT_DISTANCE)
			end
		end
	end
	plotChunks(map:FindFirstChild("Plots"))
	local hub = map:FindFirstChild("Hub")
	if hub then
		local containers = {}
		for _, child in hub:GetChildren() do
			if not KEEP[child.Name] and child.Name ~= "Plots" then
				table.insert(containers, child)
			end
		end
		local floor = hub:FindFirstChild("Floor")
		addChunk("Hub", containers, { floor or hub }, WORLD_DISTANCE)
		plotChunks(hub:FindFirstChild("Plots"))
	end
	local worlds = map:FindFirstChild("Worlds")
	if worlds then
		for _, world in worlds:GetChildren() do
			local containers = {}
			for _, child in world:GetChildren() do
				if not KEEP[child.Name] and child.Name ~= "Plots" then
					table.insert(containers, child)
				end
			end
			local floor = world:FindFirstChild("Floor")
			addChunk(world.Name, containers, { floor or world }, WORLD_DISTANCE)
			plotChunks(world:FindFirstChild("Plots"))
		end
	end
end

local function update()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local point = camera.CFrame.Position
	for _, chunk in chunks do
		local distance = distanceToBox(point, chunk.Min, chunk.Max)
		if chunk.Hidden then
			if distance < chunk.Distance then
				setHidden(chunk, false)
			end
		elseif distance > chunk.Distance + MARGIN then
			setHidden(chunk, true)
		end
	end
end

-- Is this part / light / emitter hidden by culling right now?
function Culling.IsHidden(item: Instance): boolean
	for _, chunk in chunks do
		if chunk.Saved[item] ~= nil then
			return true
		end
	end
	return false
end

-- (for tests) how many chunks are hidden right now
function Culling.HiddenCount(): number
	local count = 0
	for _, chunk in chunks do
		if chunk.Hidden then
			count += 1
		end
	end
	return count
end

function Culling.Update()
	update()
	work(math.huge)
end

function Culling.Init()
	task.spawn(function()
		local map = workspace:WaitForChild("Map", 60)
		if not map then
			return
		end
		collect(map)
		update()
		local elapsed = 0
		RunService.Heartbeat:Connect(function(dt: number)
			elapsed += dt
			if elapsed >= CHECK_EVERY then
				elapsed = 0
				update()
			end
			if #jobs > 0 then
				work(BATCH)
			end
		end)
	end)
end

return Culling
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">DonutFX</string>
            <string name="Source"><![CDATA[--[[
	DonutFX: the moving parts of the mystical donut themes (see FXThemes.luau), animated by every client
	for the rare donuts near its camera - in the lane, on bases, on podiums and on players' heads:
	  * lightning: crackling arcs (Secret / Rainbow), bolts rising from the ground (Mythic),
	    strikes from the sky with a shockwave (Divine)
	  * magic circles on the ground: rings, dashed arcs and glyphs turning in opposite directions
	  * comets with glowing trails orbiting the donut
	  * shockwaves bursting along the ground
	  * pulsing lights (a heartbeat for Mythic, rainbow for Secret / Rainbow, a purple throb for
	    Eternal), glowing outlines, spinning light rays, and the donut itself changing colour
	    (galaxy, rainbow, throbbing red)
	  * crystal shards tumbling round the donut, flying out and back (Celestial and up)
	  * electric bursts: stars of sparks crackling off it (the server made the emitters; this sets
	    them off)
	Everything here exists only on this client (nothing is replicated) and is removed again when you
	walk away. Only the closest donuts get the full show.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local FXThemes = require(Shared.FXThemes)
local Donuts = require(Shared.Donuts)
local DonutAuras = require(Shared.DonutAuras)

local DonutFX = {}

local player = Players.LocalPlayer :: Player
local RANGE = 170 -- studs from the camera
local MAX_ACTIVE = 14 -- closest donuts that get lightning, circles and comets
local MAX_OUTLINES = 6 -- Roblox can only draw a limited number of outlines at once
local MAX_BOLTS = 40
local MAX_SHARDS = 110 -- crystal shards on screen at once (the closest donuts get them first)
local TAU = math.pi * 2
local FLAT = CFrame.Angles(math.rad(90), 0, 0) -- lays a cylinder adornment flat on the ground

type Theme = FXThemes.Theme

type ThemeState = { Theme: Theme, Index: number, NextBolt: number, NextWave: number }

type Spinner = { Adornment: GuiBase3d, Base: CFrame, Speed: number, Theme: Theme, Hue: number, Pulse: boolean? }

type Wisp = { Part: BasePart, Trail: Trail, Axis: CFrame, Radius: number, Speed: number, Offset: number, Theme: Theme, Hue: number }

type Wave = { Adornment: CylinderHandleAdornment, Start: number, Theme: Theme, Scale: number }

type Shard = { Part: BasePart, Axis: CFrame, Radius: number, Speed: number, Offset: number, Spin: Vector3, SpinSpeed: number, Out: number }

-- a little shape circling the donut (FXThemes Orbiters): a few parts moving as one
type Orbiter = { Parts: { BasePart }, Offsets: { CFrame }, Axis: CFrame, Radius: number, Speed: number, Offset: number, Turn: number }

type Visuals = {
	Folder: Folder,
	Anchor: BasePart?,
	Spinners: { Spinner },
	Wisps: { Wisp },
	Waves: { Wave },
	Shards: { Shard },
	Orbiters: { Orbiter },
	Outline: Highlight?,
}

type FX = {
	Model: Model,
	Root: BasePart,
	Scale: number,
	Ground: CFrame?, -- where the magic circle goes (nil while a donut is being carried)
	GroundY: number?, -- donuts roaming a base pen: the circle follows them along the floor
	Themes: { ThemeState },
	Light: PointLight?,
	LightBrightness: number,
	LightColor: Color3,
	Bursts: { { Weld: Weld, Base: CFrame, Spin: number } },
	Frosting: { BasePart },
	FrostingColors: { Color3 },
	Dough: { BasePart },
	DoughColors: { Color3 },
	Tint: string?,
	Pulse: string?,
	OutlineTheme: Theme?,
	Visuals: Visuals?,
	Distance: number,
	Boosted: { ParticleEmitter }, -- flames, spirals, smoke (FXBoost): only on for the closest donuts
	BoostOn: boolean?,
	Crackles: { ParticleEmitter }, -- electric burst points (FXThemes Electric)
	CrackleRate: number,
	NextCrackle: number,
}

type Bolt = { Parts: { BasePart }, Light: PointLight, Born: number }

local fxs: { [Model]: FX } = {}
local shardCount = 0
local bulkMove = true -- (workspace:BulkMoveTo, if this client has it)
local bolts: { Bolt } = {}
local boltPool: { BasePart } = {}
local folder: Folder
local rng = Random.new()
local clock = 0

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------
local function heartbeat(t: number): number
	local u = t % 1.15
	return math.exp(-(u / 0.07) ^ 2) + 0.75 * math.exp(-((u - 0.25) / 0.07) ^ 2)
end

local function themeColor(theme: Theme, index: number, hue: number): Color3
	if theme.Rainbow then
		return Color3.fromHSV((clock * 0.18 + hue) % 1, 0.7, 1)
	end
	return theme.Colors[(index - 1) % #theme.Colors + 1]
end

local function randomColor(theme: Theme): Color3
	if theme.Rainbow then
		return Color3.fromHSV(rng:NextNumber(), 0.75, 1)
	end
	return theme.Colors[rng:NextInteger(1, #theme.Colors)]
end

local function localPart(name: string, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

--------------------------------------------------------------------------------
-- Lightning
--------------------------------------------------------------------------------
local function takeBoltPart(): BasePart
	local p = table.remove(boltPool)
	if p then
		return p
	end
	local part = localPart("Bolt", folder)
	part.Transparency = 1
	return part
end

local function spawnBolt(from: Vector3, to: Vector3, color: Color3, width: number, branch: boolean, flash: number)
	local direction = to - from
	local distance = direction.Magnitude
	if distance < 0.2 or #bolts >= MAX_BOLTS then
		return
	end
	local right = direction:Cross(Vector3.yAxis)
	if right.Magnitude < 0.01 then
		right = direction:Cross(Vector3.xAxis)
	end
	right = right.Unit
	local up = right:Cross(direction).Unit
	local segments = math.clamp(math.floor(distance / 0.9), 4, 12)
	local parts = {}
	local previous = from
	for i = 1, segments do
		local point = if i == segments
			then to
			else from + direction * (i / segments) + (right * rng:NextNumber(-1, 1) + up * rng:NextNumber(-1, 1)) * distance * 0.08
		local step = point - previous
		local part = takeBoltPart()
		part.Size = Vector3.new(width, width, step.Magnitude + width * 0.5)
		part.CFrame = CFrame.lookAt(previous + step / 2, point)
		part.Color = color
		part.Transparency = 0
		table.insert(parts, part)
		if branch and i == segments // 2 and rng:NextNumber() < 0.7 then
			spawnBolt(point, point + rng:NextUnitVector() * distance * 0.35, color, width * 0.6, false, 0)
		end
		previous = point
	end
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10 + flash * 12
	light.Brightness = 3 + flash * 3
	light.Shadows = false
	light.Parent = parts[#parts]
	table.insert(bolts, { Parts = parts, Light = light, Born = clock })
end

local function updateBolts()
	for i = #bolts, 1, -1 do
		local bolt = bolts[i]
		local age = clock - bolt.Born
		if age > 0.17 then
			for _, part in bolt.Parts do
				part.Transparency = 1
				table.insert(boltPool, part)
			end
			bolt.Light:Destroy()
			table.remove(bolts, i)
		else
			-- flicker: on, dim, on, fade
			local transparency = if age < 0.05 then 0 elseif age < 0.08 then 0.7 elseif age < 0.13 then 0 else 0.5
			for _, part in bolt.Parts do
				part.Transparency = transparency
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Magic circles, comets, shockwaves
--------------------------------------------------------------------------------
local function ring(anchor: BasePart, radius: number, width: number, angle: number, color: Color3, transparency: number): CylinderHandleAdornment
	local a = Instance.new("CylinderHandleAdornment")
	a.Adornee = anchor
	a.Radius = radius
	a.InnerRadius = math.max(0, radius - width)
	a.Height = 0.05
	a.Angle = angle
	a.Color3 = color
	a.Transparency = transparency
	a.CFrame = FLAT
	a.Parent = anchor
	return a
end

local function buildCircle(fx: FX, visuals: Visuals, anchor: BasePart, state: ThemeState)
	local theme = state.Theme
	local sc = fx.Scale
	local radius = (3.2 + (state.Index - 1) * 1.15) * sc
	local direction = if state.Index % 2 == 0 then -1 else 1
	local function add(adornment: GuiBase3d, base: CFrame, speed: number, hue: number, pulse: boolean?)
		table.insert(visuals.Spinners, { Adornment = adornment, Base = base, Speed = speed * direction, Theme = theme, Hue = hue, Pulse = pulse })
	end
	-- Outer ring + a thin ring around it
	add(ring(anchor, radius, 0.16 * sc, 360, theme.Colors[1], 0.15), CFrame.identity, 0.4, 0)
	add(ring(anchor, radius + 0.3 * sc, 0.06 * sc, 360, themeColor(theme, 2, 0.3), 0.35), CFrame.identity, 0, 0.3)
	-- Dashed ring
	for i = 0, 5 do
		add(ring(anchor, radius - 0.45 * sc, 0.12 * sc, 30, themeColor(theme, 2, i / 6), 0.2), CFrame.Angles(0, 0, i * TAU / 6), -0.7, i / 6)
	end
	-- Inner arcs
	for i = 0, 2 do
		add(ring(anchor, radius - 1.05 * sc, 0.1 * sc, 80, themeColor(theme, 3, i / 3), 0.25), CFrame.Angles(0, 0, i * TAU / 3), 1.1, i / 3)
	end
	-- Glyph marks around the outer ring
	for i = 0, 7 do
		local glyph = Instance.new("BoxHandleAdornment")
		glyph.Adornee = anchor
		glyph.Size = Vector3.new(0.12 * sc, 0.04, 0.5 * sc)
		glyph.Color3 = theme.Colors[1]
		glyph.Transparency = 0.1
		glyph.Parent = anchor
		-- (spinners rotate their Base about the vertical; glyphs sit out on the ring)
		table.insert(visuals.Spinners, {
			Adornment = glyph,
			Base = CFrame.Angles(0, i * TAU / 8, 0) * CFrame.new(0, 0, -(radius - 0.25 * sc)),
			Speed = 0.4 * direction,
			Theme = theme,
			Hue = i / 8,
		})
	end
	-- Soft glow in the middle
	add(ring(anchor, 1.3 * sc, 1.3 * sc, 360, theme.Colors[1], 0.8), CFrame.identity, 0, 0, true)
end

local function buildWisps(fx: FX, visuals: Visuals, state: ThemeState)
	local theme = state.Theme
	local count = theme.Wisps or 0
	local sc = fx.Scale
	for i = 1, count do
		local color = themeColor(theme, i, i / count)
		local part = localPart("Comet", visuals.Folder)
		part.Shape = Enum.PartType.Ball
		part.Size = Vector3.one * 0.32 * sc
		part.Color = color
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.14 * sc, 0)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.14 * sc, 0)
		a1.Parent = part
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.45
		trail.LightEmission = 1
		trail.Brightness = 3
		trail.FaceCamera = true
		trail.Color = ColorSequence.new(color)
		trail.Transparency = NumberSequence.new(0, 1)
		trail.WidthScale = NumberSequence.new(1, 0)
		trail.Parent = part
		table.insert(visuals.Wisps, {
			Part = part,
			Trail = trail,
			Axis = CFrame.Angles(rng:NextNumber(-1, 1), rng:NextNumber(0, TAU), rng:NextNumber(-1, 1)),
			Radius = (2.4 + rng:NextNumber() * 1.1) * sc,
			Speed = (1.6 + rng:NextNumber()) * (if rng:NextNumber() < 0.5 then -1 else 1),
			Offset = i / count * TAU,
			Theme = theme,
			Hue = i / count,
		})
	end
end

-- Jagged crystal shards (thin wedges) tumbling round the donut on tilted orbits, flying out and
-- back in. Bright ones glow (neon), dark ones are solid, like the corrupted look of the rarest pets.
local function buildShards(fx: FX, visuals: Visuals, state: ThemeState)
	local shards = state.Theme.Shards
	if not shards then
		return
	end
	local sc = fx.Scale
	for i = 1, shards.Count do
		if shardCount >= MAX_SHARDS then
			return
		end
		local color = shards.Colors[(i - 1) % #shards.Colors + 1]
		local _, _, v = color:ToHSV()
		local part = Instance.new("WedgePart")
		part.Name = "Shard"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Size = Vector3.new(0.12, rng:NextNumber(0.7, 1.7), rng:NextNumber(0.45, 1)) * sc
		part.Color = color
		part.Material = if v > 0.45 then Enum.Material.Neon else Enum.Material.SmoothPlastic
		part.Parent = visuals.Folder
		shardCount += 1
		table.insert(visuals.Shards, {
			Part = part,
			Axis = CFrame.Angles(rng:NextNumber(-0.7, 0.7), rng:NextNumber(0, TAU), rng:NextNumber(-0.7, 0.7)),
			Radius = rng:NextNumber(2, 3.2) * sc,
			Speed = rng:NextNumber(0.7, 1.6) * (if rng:NextNumber() < 0.5 then -1 else 1),
			Offset = rng:NextNumber(0, TAU),
			Spin = rng:NextUnitVector(),
			SpinSpeed = rng:NextNumber(1.5, 4),
			Out = rng:NextNumber(0.6, 1.6) * sc,
		})
	end
end

-- The pieces of each Orbiters shape (in its own space, 1 = a normal donut): size, offset, colour
-- index (0 = white), material, part shape.
type Piece = { Size: Vector3, At: CFrame, Color: number, Material: Enum.Material?, Shape: Enum.PartType? }
local DIAMOND = CFrame.Angles(0, 0, math.rad(45))
local SHAPES: { [string]: { Piece } } = {
	Heart = {
		{ Size = Vector3.new(0.26, 0.26, 0.12), At = CFrame.new(-0.12, 0.08, 0) * DIAMOND, Color = 1 },
		{ Size = Vector3.new(0.26, 0.26, 0.12), At = CFrame.new(0.12, 0.08, 0) * DIAMOND, Color = 1 },
		{ Size = Vector3.new(0.34, 0.34, 0.12), At = CFrame.new(0, -0.08, 0) * DIAMOND, Color = 1 },
	},
	Star = {
		{ Size = Vector3.new(0.1, 0.62, 0.08), At = CFrame.new(), Color = 1 },
		{ Size = Vector3.new(0.62, 0.1, 0.08), At = CFrame.new(), Color = 1 },
		{ Size = Vector3.new(0.2, 0.2, 0.1), At = DIAMOND, Color = 0 },
	},
	Coin = {
		{ Size = Vector3.new(0.08, 0.5, 0.5), At = CFrame.new(), Color = 1, Material = Enum.Material.Foil, Shape = Enum.PartType.Cylinder },
		{ Size = Vector3.new(0.1, 0.32, 0.32), At = CFrame.new(), Color = 2, Material = Enum.Material.Foil, Shape = Enum.PartType.Cylinder },
	},
	Bubble = {
		{ Size = Vector3.one * 0.5, At = CFrame.new(), Color = 1, Material = Enum.Material.Glass, Shape = Enum.PartType.Ball },
		{ Size = Vector3.one * 0.12, At = CFrame.new(-0.1, 0.12, -0.18), Color = 0, Shape = Enum.PartType.Ball },
	},
	Cube = {
		{ Size = Vector3.one * 0.34, At = CFrame.new(), Color = 1 },
	},
	Note = {
		{ Size = Vector3.new(0.26, 0.2, 0.12), At = CFrame.new(-0.06, -0.22, 0) * CFrame.Angles(0, 0, 0.35), Color = 1 },
		{ Size = Vector3.new(0.06, 0.5, 0.06), At = CFrame.new(0.06, 0.02, 0), Color = 1 },
		{ Size = Vector3.new(0.2, 0.07, 0.06), At = CFrame.new(0.14, 0.24, 0) * CFrame.Angles(0, 0, -0.5), Color = 1 },
	},
	Leaf = {
		{ Size = Vector3.new(0.42, 0.06, 0.22), At = CFrame.new(), Color = 1, Material = Enum.Material.SmoothPlastic },
		{ Size = Vector3.new(0.3, 0.07, 0.03), At = CFrame.new(), Color = 2, Material = Enum.Material.SmoothPlastic },
	},
	Snowflake = {
		{ Size = Vector3.new(0.07, 0.56, 0.05), At = CFrame.new(), Color = 0 },
		{ Size = Vector3.new(0.07, 0.56, 0.05), At = CFrame.Angles(0, 0, math.rad(60)), Color = 0 },
		{ Size = Vector3.new(0.07, 0.56, 0.05), At = CFrame.Angles(0, 0, math.rad(-60)), Color = 1 },
	},
	Gear = {
		{ Size = Vector3.new(0.1, 0.4, 0.4), At = CFrame.new(), Color = 1, Material = Enum.Material.Foil, Shape = Enum.PartType.Cylinder },
		{ Size = Vector3.new(0.08, 0.56, 0.1), At = CFrame.new(), Color = 1, Material = Enum.Material.Foil },
		{ Size = Vector3.new(0.08, 0.1, 0.56), At = CFrame.new(), Color = 1, Material = Enum.Material.Foil },
	},
	Bolt = {
		{ Size = Vector3.new(0.1, 0.28, 0.06), At = CFrame.new(0.05, 0.18, 0) * CFrame.Angles(0, 0, -0.5), Color = 1 },
		{ Size = Vector3.new(0.24, 0.08, 0.06), At = CFrame.new(0, 0.04, 0), Color = 1 },
		{ Size = Vector3.new(0.1, 0.28, 0.06), At = CFrame.new(-0.05, -0.12, 0) * CFrame.Angles(0, 0, -0.5), Color = 1 },
	},
	Feather = {
		{ Size = Vector3.new(0.18, 0.6, 0.04), At = CFrame.new(), Color = 0, Material = Enum.Material.SmoothPlastic },
		{ Size = Vector3.new(0.03, 0.66, 0.05), At = CFrame.new(), Color = 1, Material = Enum.Material.SmoothPlastic },
	},
}

-- Little shapes circling the donut on tilted orbits, bobbing and turning (FXThemes Orbiters).
local function buildOrbiters(fx: FX, visuals: Visuals, state: ThemeState)
	local orbiters = state.Theme.Orbiters
	local pieces = orbiters and SHAPES[orbiters.Shape]
	if not orbiters or not pieces then
		return
	end
	local sc = fx.Scale
	local theme = state.Theme
	for i = 1, orbiters.Count do
		if shardCount + #pieces > MAX_SHARDS then
			return
		end
		local parts, offsets = {}, {}
		for _, piece in pieces do
			local part = localPart(orbiters.Shape, visuals.Folder)
			if piece.Shape then
				part.Shape = piece.Shape
			end
			part.Size = piece.Size * sc * 1.25
			part.Material = piece.Material or Enum.Material.Neon
			part.Color = if piece.Color == 0 then Color3.new(1, 1, 1) else themeColor(theme, piece.Color + i - 1, i / orbiters.Count)
			if part.Material == Enum.Material.Glass then
				part.Transparency = 0.45
			end
			table.insert(parts, part)
			table.insert(offsets, piece.At.Rotation + piece.At.Position * sc * 1.25)
		end
		shardCount += #parts
		table.insert(visuals.Orbiters, {
			Parts = parts,
			Offsets = offsets,
			Axis = CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, TAU), rng:NextNumber(-0.5, 0.5)),
			Radius = rng:NextNumber(2.3, 3.1) * sc,
			Speed = rng:NextNumber(0.6, 1.1) * (if i % 2 == 0 then -1 else 1),
			Offset = i / orbiters.Count * TAU,
			Turn = rng:NextNumber(1.2, 2.4),
		})
	end
end

local function spawnWave(fx: FX, state: ThemeState)
	local visuals = fx.Visuals
	local anchor = visuals and visuals.Anchor
	if not visuals or not anchor then
		return
	end
	local a = ring(anchor, fx.Scale, 0.3 * fx.Scale, 360, randomColor(state.Theme), 0.15)
	table.insert(visuals.Waves, { Adornment = a, Start = clock, Theme = state.Theme, Scale = fx.Scale })
end

--------------------------------------------------------------------------------
-- Build / drop the per-donut visuals
--------------------------------------------------------------------------------
local function restoreColors(fx: FX)
	if fx.Tint == "Heartbeat" then
		for i, part in fx.Frosting do
			part.Color = fx.FrostingColors[i]
		end
	elseif fx.Tint then
		for i, part in fx.Dough do
			part.Color = fx.DoughColors[i]
		end
	end
end

local function setBoost(fx: FX, on: boolean)
	if fx.BoostOn == on then
		return
	end
	fx.BoostOn = on
	for _, emitter in fx.Boosted do
		emitter.Enabled = on
	end
end

local function dropVisuals(fx: FX)
	setBoost(fx, false)
	local visuals = fx.Visuals
	if visuals then
		shardCount -= #visuals.Shards
		for _, orbiter in visuals.Orbiters do
			shardCount -= #orbiter.Parts
		end
		visuals.Folder:Destroy()
		if visuals.Outline then
			visuals.Outline:Destroy()
		end
		fx.Visuals = nil
		restoreColors(fx)
	end
end

local function ensureVisuals(fx: FX)
	if fx.Visuals then
		return
	end
	local visualsFolder = Instance.new("Folder")
	visualsFolder.Name = fx.Model.Name
	visualsFolder.Parent = folder
	local visuals: Visuals = { Folder = visualsFolder, Anchor = nil, Spinners = {}, Wisps = {}, Waves = {}, Shards = {}, Orbiters = {}, Outline = nil }
	if fx.Ground then
		local anchor = localPart("CircleAnchor", visualsFolder)
		anchor.Transparency = 1
		anchor.Size = Vector3.one * 0.2
		anchor.CFrame = (fx.Ground :: CFrame) + Vector3.new(0, 0.07, 0)
		visuals.Anchor = anchor
	end
	for _, state in fx.Themes do
		if state.Theme.Runes and visuals.Anchor then
			buildCircle(fx, visuals, visuals.Anchor :: BasePart, state)
		end
		buildWisps(fx, visuals, state)
		buildShards(fx, visuals, state)
		buildOrbiters(fx, visuals, state)
	end
	fx.Visuals = visuals
end

local function setOutline(fx: FX, wanted: boolean)
	local visuals = fx.Visuals
	if not visuals then
		return
	end
	if wanted and not visuals.Outline and fx.OutlineTheme then
		local highlight = Instance.new("Highlight")
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.FillTransparency = 0.82
		highlight.OutlineTransparency = 0
		highlight.Parent = fx.Model
		visuals.Outline = highlight
	elseif not wanted and visuals.Outline then
		visuals.Outline:Destroy()
		visuals.Outline = nil
	end
end

--------------------------------------------------------------------------------
-- Per-frame updates
--------------------------------------------------------------------------------
-- Cheap things for every rare donut in range: spinning rays and the pulsing light.
local function updateCheap(fx: FX)
	for _, burst in fx.Bursts do
		burst.Weld.C0 = burst.Base * CFrame.Angles(0, 0, (clock * burst.Spin) % TAU)
	end
	local light = fx.Light
	if light then
		local base = fx.LightBrightness
		local pulse = fx.Pulse
		if pulse == "Heartbeat" then
			light.Brightness = base * (0.7 + 2.6 * heartbeat(clock))
		elseif pulse == "Shimmer" then
			light.Brightness = base * (1.1 + 0.45 * math.sin(clock * 3.3) + 0.2 * math.sin(clock * 7.1))
		elseif pulse == "Hue" then
			light.Color = Color3.fromHSV((clock * 0.25) % 1, 0.8, 1)
			light.Brightness = base * 1.4
		elseif pulse == "Glow" then
			light.Brightness = base * (1 + 0.35 * math.sin(clock * 2))
		elseif pulse == "Throb" then
			-- a deep purple throb, flaring up now and then like the storm's lightning
			light.Brightness = base * (1.5 + 0.9 * math.sin(clock * 4.5) + (if math.sin(clock * 13.7) > 0.93 then 2 else 0))
		end
	end
end

local function lightningPoints(fx: FX, mode: string): (Vector3, Vector3, number, boolean, number)
	local sc = fx.Scale
	local center = fx.Root.Position + Vector3.new(0, 0.3 * sc, 0)
	local ground = fx.Ground
	local function groundPoint(radius: number): Vector3
		local angle = rng:NextNumber(0, TAU)
		if ground then
			return ground.Position + Vector3.new(math.cos(angle) * radius, 0.1, math.sin(angle) * radius)
		end
		return center + rng:NextUnitVector() * radius
	end
	if mode == "Rise" then
		return groundPoint(3 * sc), center + rng:NextUnitVector() * 1.1 * sc, 0.14 * sc, true, 0.5
	elseif mode == "Strike" then
		local from = center + Vector3.new(rng:NextNumber(-4, 4) * sc, 16 * sc, rng:NextNumber(-4, 4) * sc)
		return from, center + rng:NextUnitVector() * 0.5 * sc, 0.22 * sc, true, 1
	end
	-- Arc: crackles around the donut, sometimes grounding into the magic circle
	local from = center + rng:NextUnitVector() * 1.8 * sc
	local to = if ground and rng:NextNumber() < 0.3 then groundPoint(rng:NextNumber(2.5, 3.5) * sc) else center + rng:NextUnitVector() * 3.9 * sc
	return from, to, 0.1 * sc, rng:NextNumber() < 0.4, 0.3
end

-- The full show (only for the closest donuts).
local function updateFull(fx: FX)
	local visuals = fx.Visuals
	if not visuals then
		return
	end
	local groundY = fx.GroundY
	if groundY then
		local position = fx.Root.Position
		fx.Ground = CFrame.new(position.X, groundY, position.Z)
		local anchor = visuals.Anchor
		if anchor then
			anchor.CFrame = CFrame.new(position.X, groundY + 0.07, position.Z)
		end
	end
	-- Magic circles
	for _, spinner in visuals.Spinners do
		local adornment = spinner.Adornment :: any
		local turn = CFrame.Angles(0, 0, (clock * spinner.Speed) % TAU)
		if adornment:IsA("BoxHandleAdornment") then
			adornment.CFrame = CFrame.Angles(0, (clock * spinner.Speed) % TAU, 0) * spinner.Base
		else
			adornment.CFrame = FLAT * turn * spinner.Base
		end
		if spinner.Theme.Rainbow then
			adornment.Color3 = Color3.fromHSV((clock * 0.18 + spinner.Hue) % 1, 0.7, 1)
		end
		if spinner.Pulse then
			adornment.Transparency = 0.8 + 0.1 * math.sin(clock * 3)
		end
	end
	-- Comets
	local center = fx.Root.Position + Vector3.new(0, 0.3 * fx.Scale, 0)
	for _, wisp in visuals.Wisps do
		local angle = clock * wisp.Speed + wisp.Offset
		local offset = wisp.Axis:VectorToWorldSpace(Vector3.new(math.cos(angle), 0, math.sin(angle))) * wisp.Radius
		wisp.Part.CFrame = CFrame.new(center + offset)
		if wisp.Theme.Rainbow then
			local color = Color3.fromHSV((clock * 0.3 + wisp.Hue) % 1, 0.7, 1)
			wisp.Part.Color = color
			wisp.Trail.Color = ColorSequence.new(color)
		end
	end
	-- Crystal shards and circling shapes
	local shards = visuals.Shards
	if #shards > 0 or #visuals.Orbiters > 0 then
		local parts: { BasePart } = table.create(#shards)
		local cframes: { CFrame } = table.create(#shards)
		for _, shard in shards do
			local angle = clock * shard.Speed + shard.Offset
			local radius = shard.Radius + shard.Out * (0.5 + 0.5 * math.sin(clock * 1.6 + shard.Offset * 2))
			local offset = shard.Axis:VectorToWorldSpace(Vector3.new(math.cos(angle), 0, math.sin(angle))) * radius
			table.insert(parts, shard.Part)
			table.insert(cframes, CFrame.new(center + offset) * CFrame.fromAxisAngle(shard.Spin, (clock * shard.SpinSpeed + shard.Offset) % TAU))
		end
		for _, orbiter in visuals.Orbiters do
			local angle = clock * orbiter.Speed + orbiter.Offset
			local offset = orbiter.Axis:VectorToWorldSpace(Vector3.new(math.cos(angle), 0, math.sin(angle))) * orbiter.Radius
			local frame = CFrame.new(center + offset + Vector3.new(0, 0.25 * fx.Scale * math.sin(clock * 2 + orbiter.Offset * 3), 0))
				* CFrame.Angles(0, (clock * orbiter.Turn + orbiter.Offset) % TAU, 0)
			for i, part in orbiter.Parts do
				table.insert(parts, part)
				table.insert(cframes, frame * orbiter.Offsets[i])
			end
		end
		if bulkMove then
			local ok = pcall(function()
				workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
			end)
			bulkMove = ok
		end
		if not bulkMove then
			for i, part in parts do
				part.CFrame = cframes[i]
			end
		end
	end
	-- Electric bursts: a star of sparks from a random point on the donut, several times a second
	if #fx.Crackles > 0 and clock >= fx.NextCrackle then
		fx.NextCrackle = clock + rng:NextNumber(0.4, 1.6) / math.max(fx.CrackleRate, 0.1)
		local emitter = fx.Crackles[rng:NextInteger(1, #fx.Crackles)]
		if emitter.Parent then
			emitter:Emit(rng:NextInteger(7, 13))
		end
	end
	-- Shockwaves
	for i = #visuals.Waves, 1, -1 do
		local wave = visuals.Waves[i]
		local a = (clock - wave.Start) / 0.8
		if a >= 1 then
			wave.Adornment:Destroy()
			table.remove(visuals.Waves, i)
		else
			local eased = 1 - (1 - a) ^ 3
			local radius = (0.8 + eased * 8.5) * wave.Scale
			wave.Adornment.Radius = radius
			wave.Adornment.InnerRadius = math.max(0, radius - 0.35 * wave.Scale)
			wave.Adornment.Transparency = 0.15 + 0.85 * a
		end
	end
	-- Lightning + shockwave timers
	for _, state in fx.Themes do
		local theme = state.Theme
		local lightning = theme.Lightning
		if lightning and clock >= state.NextBolt then
			state.NextBolt = clock + rng:NextNumber(lightning.Min, lightning.Max)
			local from, to, width, branch, flash = lightningPoints(fx, lightning.Mode)
			spawnBolt(from, to, randomColor(theme), width, branch, flash)
			if lightning.Mode == "Strike" then
				spawnWave(fx, state)
			end
		end
		local shock = theme.Shockwave
		if shock and clock >= state.NextWave then
			state.NextWave = clock + rng:NextNumber(shock.Min, shock.Max)
			spawnWave(fx, state)
		end
	end
	-- The donut's own colours
	local tint = fx.Tint
	if tint == "Heartbeat" and not CollectionService:HasTag(fx.Model, "DonutRainbow") then
		local beat = heartbeat(clock)
		for i, part in fx.Frosting do
			part.Color = fx.FrostingColors[i]:Lerp(Color3.fromRGB(255, 190, 190), beat * 0.7)
		end
	elseif tint == "Galaxy" then
		for i, part in fx.Dough do
			local wave = math.sin(clock * 0.9 + i * 0.55)
			part.Color = Color3.fromHSV((0.72 + 0.1 * math.sin(clock * 0.5 + i * 0.4)) % 1, 0.8, 0.32 + 0.14 * wave)
		end
	elseif tint == "Rainbow" then
		local count = #fx.Dough
		for i, part in fx.Dough do
			part.Color = Color3.fromHSV((clock * 0.2 + i / count) % 1, 0.55, 1)
		end
	end
	-- Outline colour
	local outline = visuals.Outline
	local outlineTheme = fx.OutlineTheme
	if outline and outlineTheme then
		local color = themeColor(outlineTheme, 1, 0)
		outline.OutlineColor = color
		outline.FillColor = color
		outline.OutlineTransparency = 0.15 + 0.15 * math.sin(clock * 4)
	end
end

--------------------------------------------------------------------------------
-- Registration
--------------------------------------------------------------------------------
local function register(instance: Instance)
	if not instance:IsA("Model") or fxs[instance] then
		return
	end
	local model = instance
	local root = model.PrimaryPart or model:WaitForChild("Root", 5)
	if not root or not root:IsA("BasePart") or not model.Parent then
		return
	end
	-- the same effects the server built: the donut's own aura and its mutation's (DonutAuras)
	local donutId = model:GetAttribute("DonutId")
	local mutationAttr = model:GetAttribute("Mutation")
	local mutation = if type(mutationAttr) == "string" then mutationAttr else nil
	local donut = if type(donutId) == "string" then Donuts.Get(donutId) else nil
	local themes: { Theme } = {}
	if donut then
		themes = DonutAuras.Themes(donut, mutation)
	else
		local fromMutation = FXThemes.ForMutation(mutation)
		if fromMutation then
			table.insert(themes, fromMutation)
		end
	end
	if #themes == 0 then
		return
	end
	local scale = model:GetAttribute("FXScale")
	local bottom = model:GetAttribute("Bottom")
	local sc = if type(scale) == "number" then scale else 1
	-- Read the resting position straight away (other effects start moving the donut right after).
	local ground: CFrame? = nil
	if root.Anchored and not model:GetAttribute("Follower") then
		ground = CFrame.new(root.Position - Vector3.new(0, if type(bottom) == "number" then bottom else 1.5, 0))
	end
	local groundY = if ground and model:GetAttribute("RoamOrigin") ~= nil then ground.Position.Y else nil

	local states: { ThemeState } = {}
	local tint, pulse, outlineTheme = nil, nil, nil
	for i, theme in themes do
		table.insert(states, { Theme = theme, Index = i, NextBolt = clock + rng:NextNumber(0.2, 1.5), NextWave = clock + rng:NextNumber(0.5, 3) })
		tint = theme.Tint or tint
		pulse = theme.Pulse or pulse
		if theme.Outline then
			outlineTheme = theme
		end
	end

	local bursts = {}
	local frosting, frostingColors, dough, doughColors = {}, {}, {}, {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local spin = part:GetAttribute("FXSpin")
			local weld = part:FindFirstChildOfClass("Weld")
			if type(spin) == "number" and weld then
				table.insert(bursts, { Weld = weld, Base = weld.C0, Spin = spin })
			end
			if part.Name == "Frosting" then
				table.insert(frosting, part)
				table.insert(frostingColors, part.Color)
			elseif part.Name == "Dough" then
				table.insert(dough, part)
				table.insert(doughColors, part.Color)
			end
		end
	end
	local boosted: { ParticleEmitter } = {}
	for _, emitter in model:GetDescendants() do
		if emitter:IsA("ParticleEmitter") and emitter:GetAttribute("FXBoost") then
			emitter.Enabled = false -- (on once it's one of the closest donuts)
			table.insert(boosted, emitter)
		end
	end
	local crackles: { ParticleEmitter } = {}
	local crackleRate = 0
	for _, holder in model:GetChildren() do
		if holder.Name == "ElectricFX" then
			crackleRate += (holder:GetAttribute("ElectricRate") :: number?) or 0
			for _, emitter in holder:GetDescendants() do
				if emitter:IsA("ParticleEmitter") then
					table.insert(crackles, emitter)
				end
			end
		end
	end
	local light = root:FindFirstChildOfClass("PointLight")
	fxs[model] = {
		Model = model,
		Root = root,
		Scale = sc,
		Ground = ground,
		GroundY = groundY,
		Themes = states,
		Light = light,
		LightBrightness = if light then light.Brightness else 1,
		LightColor = if light then light.Color else Color3.new(1, 1, 1),
		Bursts = bursts,
		Frosting = frosting,
		FrostingColors = frostingColors,
		Dough = dough,
		DoughColors = doughColors,
		Tint = tint,
		Pulse = pulse,
		OutlineTheme = outlineTheme,
		Visuals = nil,
		Distance = math.huge,
		Boosted = boosted,
		BoostOn = false,
		Crackles = crackles,
		CrackleRate = crackleRate,
		NextCrackle = clock + rng:NextNumber(0, 1),
	}
end

local function unregister(instance: Instance)
	local fx = if instance:IsA("Model") then fxs[instance] else nil
	if fx then
		dropVisuals(fx)
		fxs[instance :: Model] = nil
	end
end

local function focusPosition(): Vector3?
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

function DonutFX.Init()
	folder = Instance.new("Folder")
	folder.Name = "DonutFXLocal"
	folder.Parent = workspace

	for _, instance in CollectionService:GetTagged("DonutFX") do
		task.spawn(register, instance)
	end
	CollectionService:GetInstanceAddedSignal("DonutFX"):Connect(register)
	CollectionService:GetInstanceRemovedSignal("DonutFX"):Connect(unregister)

	RunService.RenderStepped:Connect(function(dt: number)
		clock += dt
		updateBolts()
		local focus = focusPosition()
		if not focus then
			return
		end
		local near: { FX } = {}
		for model, fx in fxs do
			if not model.Parent then
				unregister(model)
				continue
			end
			fx.Distance = (fx.Root.Position - focus).Magnitude
			if fx.Distance < RANGE then
				table.insert(near, fx)
			elseif fx.Visuals then
				dropVisuals(fx)
			end
		end
		table.sort(near, function(a, b)
			return a.Distance < b.Distance
		end)
		local outlines = 0
		for rank, fx in near do
			updateCheap(fx)
			if rank <= MAX_ACTIVE then
				ensureVisuals(fx)
				setBoost(fx, true)
				local wantsOutline = fx.OutlineTheme ~= nil and outlines < MAX_OUTLINES
				if wantsOutline then
					outlines += 1
				end
				setOutline(fx, wantsOutline)
				updateFull(fx)
			elseif fx.Visuals then
				dropVisuals(fx)
			end
		end
	end)
end

return DonutFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">DonutGlow</string>
            <string name="Source"><![CDATA[--[[
	DonutGlow: a glowing outline round the rare donuts closest to the camera (Epic and up, and every
	mutated donut: the server tags them "DonutOutline" and stores the colour in "OutlineColor"),
	like the glowing creatures in the egg games.

	Roblox only draws a limited number of outlines (Highlights) at once, so only the closest few
	get one. Donuts whose mystical theme already pulses an outline (DonutFX, "FXOutline") are left
	to DonutFX. Everything here is local to this client.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local DonutGlow = {}

local MAX_OUTLINES = 8
local RANGE = 70 -- studs from the camera
local INTERVAL = 0.25 -- seconds between picking the closest donuts

local folder: Folder? = nil
local outlines: { [Model]: Highlight } = {}

local function makeOutline(model: Model): Highlight
	local color = model:GetAttribute("OutlineColor")
	local glow = if typeof(color) == "Color3" then color else Color3.new(1, 1, 1)
	local highlight = Instance.new("Highlight")
	highlight.Name = "DonutGlow"
	highlight.Adornee = model
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.FillTransparency = 1
	highlight.OutlineColor = glow:Lerp(Color3.new(1, 1, 1), 0.45)
	highlight.OutlineTransparency = 0.15
	highlight.Parent = folder
	return highlight
end

local function update()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local eye = camera.CFrame.Position
	local near: { { Model: Model, Distance: number } } = {}
	for _, instance in CollectionService:GetTagged("DonutOutline") do
		if instance:IsA("Model") and instance:IsDescendantOf(workspace) and not instance:GetAttribute("FXOutline") then
			local root = instance.PrimaryPart
			if root then
				local distance = (root.Position - eye).Magnitude
				if distance < RANGE then
					table.insert(near, { Model = instance, Distance = distance })
				end
			end
		end
	end
	table.sort(near, function(a, b)
		return a.Distance < b.Distance
	end)
	local wanted: { [Model]: boolean } = {}
	for i = 1, math.min(MAX_OUTLINES, #near) do
		wanted[near[i].Model] = true
	end
	for model, highlight in outlines do
		if not wanted[model] or not model.Parent then
			highlight:Destroy()
			outlines[model] = nil
		end
	end
	for model in wanted do
		if not outlines[model] then
			outlines[model] = makeOutline(model)
		end
	end
end

function DonutGlow.Init()
	local holder = Instance.new("Folder")
	holder.Name = "DonutGlowLocal"
	holder.Parent = workspace
	folder = holder
	local cooldown = 0
	RunService.RenderStepped:Connect(function(dt: number)
		cooldown -= dt
		if cooldown > 0 then
			return
		end
		cooldown = INTERVAL
		update()
	end)
end

return DonutGlow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">DonutIdle</string>
            <string name="Source"><![CDATA[--[[
	DonutIdle: idle animations for the donuts in the bases (all client-side, so the server never
	has to replicate any of it).

	Base donuts roam their pen: they stand around for a few seconds, turn, and walk somewhere else
	(a hop on every step, feet and arms swinging). Where each one is comes from Roam.luau and the
	shared server clock, so every player sees it in the same spot and the server knows where it is
	too (to check thieves are really next to it).

	Every donut gets its own personality, picked from its id and its spot in the base:
	  Bounce - happy little hops (feet kick, arms flop)
	  Sway   - rocks side to side, arms swinging
	  Dance  - bops to a beat, arms up in turn, feet stepping
	  Look   - stands still, breathing, looking around
	  Float  - rare / mutated donuts that float: hover, spin and flap their wings
	Every few seconds a donut does something special: a twirl, a big jump (crouch, leap, land), a
	backflip, a wave, a cheer, a wiggle, a look around, or a little doze. They blink, their eyes wander,
	and when you walk past they watch you (eyes first, then they turn a little) - and when you come
	close they wave or jump to say hi. Their mouths open while they jump, twirl and cheer.
	The few donuts closest to you breathe: a slow squash and stretch from their feet.
	Propellers spin, orbiting orbs orbit, tentacles wiggle and capes flutter.

	How it works: a donut is one anchored Root with every other part welded to it (DonutModel), so
	moving Root moves the whole donut, and changing a limb's weld (C0) bends that limb around the
	"Pivot" the server stored on it. Eyes ("EyeWhite") are squashed to blink, pupils ("Pupil") slide
	inside the eyes, and the middle of the smile ("Mouth" = "Middle") stretches into an open mouth.
	Only donuts near the camera are animated.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Roam = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Roam"))

local DonutIdle = {}

local player = Players.LocalPlayer :: Player
local RANGE = 110 -- studs from the camera; further donuts stand still
local NEAR = 45 -- closer than this: every frame, otherwise 30 times a second
local WATCH_RANGE = 30 -- donuts this close to you watch you
local GREET_RANGE = 13 -- ...and say hi when you come this close
local GREET_COOLDOWN = 25
local TAU = math.pi * 2
local STYLES = { "Bounce", "Sway", "Dance", "Look" }
local ACTION_LENGTH: { [string]: number } = {
	Twirl = 0.9,
	Jump = 0.95,
	Flip = 1.15,
	Wiggle = 0.8,
	Wave = 1.6,
	Cheer = 1.3,
	LookAround = 2.2,
	Doze = 2.8,
}
local OPEN_MOUTH: { [string]: boolean } = { Twirl = true, Jump = true, Flip = true, Cheer = true, Wave = true }
local LOOK_TARGETS = { -0.55, 0, 0.55, 0, -0.3, 0.3 }
local CLOSED_EYE = Color3.fromRGB(70, 35, 40)
local GAZE = 0.075 -- how far pupils slide (studs, before the donut's scale)
local EYE_HEIGHT = 1.6 -- eyes above the middle of the donut (before its scale)
-- Breathing moves (and stretches) every part of a donut, so only the BREATHERS closest donuts
-- within BREATHE_RANGE studs do it, and only BREATHE_RATE times a second (it's slow, so that's smooth)
local BREATHE_RANGE = 35
local BREATHERS = 4
local BREATHE_RATE = 15
local BREATHE_PERIOD = 2.6 -- seconds per breath
local STRETCH, SQUASH = 0.04, 0.025 -- taller by 4% breathing in, 2.5% thinner

type Limb = { Weld: Weld, Base: CFrame, Pivot: CFrame, Kind: string, Side: number, Phase: number, Axis: Vector3?, Spin: number }
type Eye = { Part: BasePart, Size: Vector3, Color: Color3 }
type Pupil = { Part: BasePart, Weld: Weld, Base: CFrame }
type Mouth = { Part: BasePart, Weld: Weld, Base: CFrame, Size: Vector3, Corners: { BasePart } }
-- A part that breathes with the body: moved from Base, and the big blocks (dough, glaze) stretched
type BodyPart = { Part: BasePart, Weld: Weld, Base: CFrame, Size: Vector3, Grow: boolean }

-- Base donuts roam their pen (Roam.luau): where they are comes from the shared server clock.
type RoamInfo = { Params: Roam.Params, Origin: CFrame, Height: number }

type Idle = {
	Model: Model,
	Roam: RoamInfo?,
	Root: BasePart,
	Details: { BasePart }, -- tiny bits (sprinkles, glints, specks) not drawn from far away
	Lod: boolean,
	Base: CFrame,
	Bottom: number,
	Scale: number,
	Style: string,
	Rng: Random,
	Phase: number,
	Limbs: { Limb },
	Eyes: { Eye },
	Pupils: { Pupil },
	Mouth: Mouth?,
	Body: { BodyPart },
	Breath: number, -- -1 (out) .. 1 (in), times how much it's breathing
	BreathWeight: number, -- eases in and out as it becomes one of the closest donuts
	BreathAccum: number,
	HasArms: boolean,
	Blinking: boolean,
	NextBlink: number,
	BlinkUntil: number,
	MouthOpen: boolean,
	Gaze: Vector2,
	GazeTarget: Vector2,
	NextGaze: number,
	Action: string?,
	ActionStart: number,
	NextAction: number,
	Yaw: number,
	Turn: number,
	LookTarget: number,
	NextLook: number,
	Near: boolean,
	GreetAt: number?,
	NextGreet: number,
	LastY: number,
	Flop: number,
	Active: boolean,
	Accum: number,
}

local idles: { [Model]: Idle } = {}
local clock = 0 -- animation time: rendered seconds (pauses when the game does)

local function hashString(text: string): number
	local hash = 7
	for i = 1, #text do
		hash = (hash * 31 + string.byte(text, i)) % 2147483647
	end
	return hash
end

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

local function approach(current: number, target: number, rate: number, dt: number): number
	return current + (target - current) * (1 - math.exp(-rate * dt))
end

local function setBlink(idle: Idle, closed: boolean)
	if idle.Blinking == closed then
		return
	end
	idle.Blinking = closed
	for _, eye in idle.Eyes do
		eye.Part.Size = if closed then Vector3.new(eye.Size.X * 1.05, eye.Size.Y * 0.14, eye.Size.Z * 0.8) else eye.Size
		eye.Part.Color = if closed then CLOSED_EYE else eye.Color
	end
	for _, pupil in idle.Pupils do
		pupil.Part.Transparency = if closed then 1 else 0
	end
end

-- How far breathing moves the point `p` (in the donut's own space): up and away from its feet,
-- a little in towards its middle.
local function breathOffset(idle: Idle, p: Vector3): Vector3
	local b = idle.Breath
	if b == 0 then
		return Vector3.zero
	end
	return Vector3.new(-p.X * SQUASH * b, (p.Y + idle.Bottom) * STRETCH * b, -p.Z * SQUASH * b)
end

local function placeMouth(idle: Idle)
	local mouth = idle.Mouth
	if mouth then
		local cf = if idle.MouthOpen then mouth.Base * CFrame.new(0, -mouth.Size.Y * 0.6, 0) else mouth.Base
		mouth.Weld.C0 = cf + breathOffset(idle, mouth.Base.Position)
	end
end

local function setMouth(idle: Idle, open: boolean)
	local mouth = idle.Mouth
	if not mouth or idle.MouthOpen == open then
		return
	end
	idle.MouthOpen = open
	-- The middle of the smile grows into a round "wheee!" mouth, the corners hide
	mouth.Part.Size = if open then Vector3.new(mouth.Size.X * 1.25, mouth.Size.Y * 2.6, mouth.Size.Z) else mouth.Size
	placeMouth(idle)
	for _, corner in mouth.Corners do
		corner.Transparency = if open then 1 else 0
	end
end

local function setGaze(idle: Idle, gaze: Vector2, force: boolean?)
	if not force and (gaze - idle.Gaze).Magnitude < 0.004 then
		return
	end
	idle.Gaze = gaze
	local offset = CFrame.new(gaze.X * GAZE * idle.Scale, gaze.Y * GAZE * idle.Scale, 0)
	for _, pupil in idle.Pupils do
		pupil.Weld.C0 = pupil.Base * offset + breathOffset(idle, pupil.Base.Position)
	end
end

-- Breathe: move every part of the body for the current breath, and stretch the big blocks along
-- the sides of them that run up and down (so neighbouring blocks still meet).
local function breathe(idle: Idle)
	local b = idle.Breath
	local up, across = 1 + STRETCH * b, 1 - SQUASH * b
	local function along(v: Vector3): number
		return Vector3.new(v.X * across, v.Y * up, v.Z * across).Magnitude
	end
	for _, piece in idle.Body do
		local base = piece.Base
		piece.Weld.C0 = base + breathOffset(idle, base.Position)
		if piece.Grow then
			piece.Part.Size = Vector3.new(piece.Size.X * along(base.RightVector), piece.Size.Y * along(base.UpVector), piece.Size.Z * along(base.LookVector))
		end
	end
	setGaze(idle, idle.Gaze, true)
	placeMouth(idle)
end

-- Back to the pose the server built (when the donut goes out of range).
local function reset(idle: Idle)
	idle.Root.CFrame = idle.Base
	if idle.Breath ~= 0 or idle.BreathWeight > 0 then
		idle.Breath, idle.BreathWeight = 0, 0
		breathe(idle)
	end
	for _, limb in idle.Limbs do
		limb.Weld.C0 = limb.Base
	end
	setBlink(idle, false)
	setMouth(idle, false)
	setGaze(idle, Vector2.zero)
end

local function register(instance: Instance)
	if not instance:IsA("Model") or idles[instance] then
		return
	end
	local model = instance
	task.wait(0.3) -- let every part of the donut arrive
	if not model.Parent then
		return
	end
	local root = model.PrimaryPart or model:FindFirstChild("Root")
	if not root or not root:IsA("BasePart") then
		return
	end
	local donutId = model:GetAttribute("DonutId")
	local stand = model:GetAttribute("IdleSeed")
	local seed = hashString(if type(donutId) == "string" then donutId else model.Name) + (if type(stand) == "number" then stand * 7919 else 0)
	local rng = Random.new(seed)

	local limbs: { Limb } = {}
	local eyes: { Eye } = {}
	local pupils: { Pupil } = {}
	local mouth: Mouth? = nil
	local corners: { BasePart } = {}
	local phases: { [string]: number } = {} -- parts swinging around the same pivot move together
	local hasArms = false
	local details: { BasePart } = {}
	local body: { BodyPart } = {}
	local tiny = 0.45 * root.Size.Y / 3
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local size = part.Size
			if part ~= root and part.Transparency < 1 and math.max(size.X, size.Y, size.Z) <= tiny then
				table.insert(details, part)
			end
			local kind = part:GetAttribute("Limb")
			local weld = part:FindFirstChildOfClass("Weld")
			if type(kind) == "string" and weld then
				local pivot = part:GetAttribute("Pivot")
				local pivotPosition = if typeof(pivot) == "Vector3" then pivot else Vector3.zero
				local side = part:GetAttribute("Side")
				local key = string.format("%.2f,%.2f,%.2f", pivotPosition.X, pivotPosition.Y, pivotPosition.Z)
				local phase = phases[key] or rng:NextNumber(0, TAU)
				phases[key] = phase
				local axis = part:GetAttribute("Axis")
				local spinRate = part:GetAttribute("Spin")
				table.insert(limbs, {
					Weld = weld,
					Base = weld.C0,
					Pivot = CFrame.new(pivotPosition),
					Kind = kind,
					Side = if type(side) == "number" then side else 0,
					Phase = phase,
					Axis = if typeof(axis) == "Vector3" then axis else nil,
					Spin = if type(spinRate) == "number" then spinRate else 1,
				})
				hasArms = hasArms or kind == "Arm"
			end
			if part:GetAttribute("EyeWhite") then
				table.insert(eyes, { Part = part, Size = part.Size, Color = part.Color })
			elseif part:GetAttribute("Pupil") and weld then
				table.insert(pupils, { Part = part, Weld = weld, Base = weld.C0 })
			end
			local mouthPart = part:GetAttribute("Mouth")
			-- everything else welded to the donut breathes with it (not the invisible effect
			-- holders, or the light rays DonutFX spins)
			if weld and weld.Part0 == root and type(kind) ~= "string" and not part:GetAttribute("Pupil") and mouthPart ~= "Middle" and part.Transparency < 1 and part:GetAttribute("FXSpin") == nil then
				table.insert(body, { Part = part, Weld = weld, Base = weld.C0, Size = part.Size, Grow = part.Name == "Dough" or part.Name == "Frosting" })
			end
			if mouthPart == "Middle" and weld then
				mouth = { Part = part, Weld = weld, Base = weld.C0, Size = part.Size, Corners = corners }
			elseif mouthPart == "Corner" then
				table.insert(corners, part)
			end
		end
	end

	local now = clock
	local bottom = model:GetAttribute("Bottom")
	local roam: RoamInfo? = nil
	local origin = model:GetAttribute("RoamOrigin")
	local home = model:GetAttribute("RoamHome")
	local roamMin, roamMax = model:GetAttribute("RoamMin"), model:GetAttribute("RoamMax")
	if typeof(origin) == "CFrame" and typeof(home) == "Vector3" and typeof(roamMin) == "Vector2" and typeof(roamMax) == "Vector2" then
		roam = {
			Params = {
				Seed = (model:GetAttribute("RoamSeed") :: number?) or 1,
				Home = home,
				Radius = (model:GetAttribute("RoamRadius") :: number?) or 8,
				Speed = (model:GetAttribute("RoamSpeed") :: number?) or 4,
				Min = roamMin,
				Max = roamMax,
			},
			Origin = origin,
			Height = origin:PointToObjectSpace(root.Position).Y,
		}
	end
	idles[model] = {
		Model = model,
		Roam = roam,
		Root = root,
		Details = details,
		Lod = false,
		Base = root.CFrame,
		Bottom = if type(bottom) == "number" then bottom else 1.5,
		Scale = root.Size.Y / 3,
		Style = if CollectionService:HasTag(model, "DonutFloat") then "Float" else STYLES[rng:NextInteger(1, #STYLES)],
		Rng = rng,
		Phase = rng:NextNumber(0, 10),
		Limbs = limbs,
		Eyes = eyes,
		Pupils = pupils,
		Mouth = mouth,
		Body = body,
		Breath = 0,
		BreathWeight = 0,
		BreathAccum = 0,
		HasArms = hasArms,
		Blinking = false,
		NextBlink = now + rng:NextNumber(0.5, 4),
		BlinkUntil = 0,
		MouthOpen = false,
		Gaze = Vector2.zero,
		GazeTarget = Vector2.zero,
		NextGaze = now + rng:NextNumber(0.5, 2),
		Action = nil,
		ActionStart = 0,
		NextAction = now + rng:NextNumber(2, 10),
		Yaw = 0,
		Turn = 0,
		LookTarget = 0,
		NextLook = now + rng:NextNumber(0.5, 2),
		Near = false,
		GreetAt = nil,
		NextGreet = 0,
		LastY = 0,
		Flop = 0,
		Active = false,
		Accum = 0,
	}
end

-- Far away: the tiny bits aren't drawn (a whole base of donuts is thousands of parts).
-- (LocalTransparencyModifier only changes this player's screen.)
local LOD_DISTANCE = 125
local function setLod(idle: Idle, far: boolean)
	idle.Lod = far
	local value = if far then 1 else 0
	for _, part in idle.Details do
		pcall(function()
			part.LocalTransparencyModifier = value
		end)
	end
end

local function startAction(idle: Idle, action: string, now: number)
	idle.Action = action
	idle.ActionStart = now
end

local function animate(idle: Idle, now: number, dt: number, target: Vector3?)
	local t = now + idle.Phase
	local k = idle.Scale
	-- Roaming: walk to where it is in its pen right now (the same spot on every screen)
	local moving, stride = false, 0
	local roam = idle.Roam
	if roam then
		local state = Roam.At(roam.Params, workspace:GetServerTimeNow())
		idle.Base = roam.Origin * CFrame.new(state.Position.X, roam.Height, state.Position.Z) * CFrame.Angles(0, state.Yaw, 0)
		moving, stride = state.Moving, state.Walk
	end
	local y, yaw, pitch, roll, flip = 0, 0, 0, 0, 0
	-- Limb amounts. Arms: 0 = relaxed, 0.5 = the built "hands up" pose, 1 = straight up.
	-- Legs: positive kicks the feet forward. Wings: positive = tips up.
	local legL, legR, armL, armR, wing = 0, 0, 0.2, 0.2, 0
	local eyesClosed = false
	local floppy = true -- arms flop with the bounce (off while waving)

	-- Where you are, seen from the donut's stand: angle to turn to face you, and how close you are
	local watching = false
	local faceYaw = 0
	if target then
		local fromStand = idle.Base:PointToObjectSpace(target)
		local distance = Vector3.new(fromStand.X, 0, fromStand.Z).Magnitude
		watching = distance < WATCH_RANGE * math.max(1, k)
		faceYaw = math.atan2(-fromStand.X, -fromStand.Z)
		-- Say hi when you walk up (once in a while, not every donut at once)
		local near = distance < GREET_RANGE * math.max(1, k)
		if near and not idle.Near and now >= idle.NextGreet and idle.Rng:NextNumber() < 0.7 then
			idle.GreetAt = now + idle.Rng:NextNumber(0, 0.6)
			idle.NextGreet = now + GREET_COOLDOWN
		end
		idle.Near = distance < (GREET_RANGE + 6) * math.max(1, k)
	end
	if idle.GreetAt and now >= idle.GreetAt and not idle.Action then
		idle.GreetAt = nil
		startAction(idle, if idle.HasArms then "Wave" else "Jump", now)
	end

	-- Turn a little towards you while you're around (not all the way round if you're behind it)
	local turnTarget = if watching and not moving and math.abs(faceYaw) < 2 then math.clamp(faceYaw, -0.7, 0.7) * 0.6 else 0
	idle.Turn = approach(idle.Turn, turnTarget, 2.5, dt)

	local style = idle.Style
	if style == "Float" then
		y = 0.35 * k * math.sin(t * 2)
		yaw = (t * 0.9) % TAU
		wing = 0.35 * math.sin(t * 7)
		legL = 0.25 * math.sin(t * 3)
		legR = -legL
		armL = 0.45 + 0.15 * math.sin(t * 2.5)
		armR = 0.45 + 0.15 * math.sin(t * 2.5 + 1)
		floppy = false
	elseif style == "Bounce" then
		local u = (t * 0.75) % 1 -- one hop every 1.33 s
		local hop = if u < 0.45 then math.sin(u / 0.45 * math.pi) else 0
		y = 0.45 * k * hop
		if u > 0.8 then
			y -= 0.07 * k * math.sin((u - 0.8) / 0.2 * math.pi) -- little squat before the next hop
		elseif u > 0.45 and u < 0.58 then
			y -= 0.05 * k * math.sin((u - 0.45) / 0.13 * math.pi) -- and a soft landing
		end
		pitch = -0.08 * hop
		legL = 0.5 * hop
		legR = legL
		armL = 0.2 + 0.4 * hop
		armR = armL
		wing = 0.3 * hop
	elseif style == "Sway" then
		local w = 1.7
		roll = 0.13 * math.sin(t * w)
		yaw = 0.1 * math.sin(t * w * 0.5)
		y = 0.05 * k * math.abs(math.sin(t * w))
		legL = 0.15 * math.sin(t * w)
		legR = -legL
		armL = 0.3 + 0.25 * math.sin(t * w)
		armR = 0.3 - 0.25 * math.sin(t * w)
		wing = 0.15 * math.sin(t * w * 2)
	elseif style == "Dance" then
		local w = TAU * 1.1 -- beats per second
		local beat = math.abs(math.sin(t * w / 2))
		y = 0.14 * k * beat
		roll = 0.14 * math.sin(t * w / 2)
		yaw = 0.3 * math.sin(t * w / 4)
		legL = 0.35 * math.sin(t * w / 2)
		legR = -legL
		armL = 0.2 + 0.7 * math.max(0, math.sin(t * w / 2))
		armR = 0.2 + 0.7 * math.max(0, -math.sin(t * w / 2))
		wing = 0.25 * beat
		floppy = false
	else -- Look: breathe, and turn to look at things now and then (at you, if you're close)
		y = 0.04 * k * math.sin(t * 1.8)
		if now >= idle.NextLook then
			idle.LookTarget = LOOK_TARGETS[idle.Rng:NextInteger(1, #LOOK_TARGETS)]
			idle.NextLook = now + idle.Rng:NextNumber(1.2, 3.5)
		end
		local lookAt = if watching and math.abs(faceYaw) < 2 then math.clamp(faceYaw, -0.8, 0.8) else idle.LookTarget
		idle.Yaw = approach(idle.Yaw, lookAt, 5, dt)
		yaw = idle.Yaw
		pitch = 0.03 * math.sin(t * 1.8)
		legL = 0.06 * math.sin(t * 0.9) -- shifting its weight from foot to foot
		legR = -legL
		armL = 0.15 + 0.06 * math.sin(t * 1.8)
		armR = armL
		wing = 0.08 * math.sin(t * 1.8)
	end
	if style ~= "Float" and style ~= "Look" then
		yaw += idle.Turn
	end
	if moving and style ~= "Float" then
		-- Walking: a little hop on every step, feet and arms swinging, leaning into it
		local phase = stride / (1.5 * math.max(k, 0.3)) * math.pi
		local step = math.abs(math.sin(phase))
		y = 0.16 * k * step
		yaw, roll = 0, 0.06 * math.sin(phase)
		pitch = -0.07
		legL = 0.65 * math.sin(phase)
		legR = -legL
		armL = 0.3 - 0.3 * math.sin(phase)
		armR = 0.3 + 0.3 * math.sin(phase)
		wing = 0.2 * step
		floppy = false
	end

	-- A special move every few seconds (standing still)
	if moving and idle.Action then
		idle.Action = nil
		idle.NextAction = now + idle.Rng:NextNumber(3, 8)
	end
	if not idle.Action and not moving and now >= idle.NextAction then
		local options = { "Twirl", "Jump", "Jump", "Wiggle", "LookAround", "Flip", "Doze" }
		if idle.HasArms then
			table.insert(options, "Wave")
			table.insert(options, "Cheer")
			table.insert(options, "Cheer")
		end
		startAction(idle, options[idle.Rng:NextInteger(1, #options)], now)
	end
	local action = idle.Action
	if action then
		local a = (now - idle.ActionStart) / ACTION_LENGTH[action]
		if a >= 1 then
			idle.Action = nil
			idle.NextAction = now + idle.Rng:NextNumber(6, 14)
			action = nil
		elseif action == "Twirl" then
			yaw += TAU * smooth(a)
			y += 0.35 * k * math.sin(a * math.pi)
			armL, armR = 0.7, 0.7
		elseif action == "Jump" or action == "Flip" then
			-- crouch... leap... land
			local high = if action == "Flip" then 1.45 else 0.95
			if a < 0.22 then
				local c = math.sin(a / 0.22 * math.pi * 0.5)
				y -= 0.14 * k * c
				legL, legR = 0.3 * c, 0.3 * c
				armL, armR = 0, 0
				pitch += 0.1 * c
			elseif a < 0.82 then
				local air = (a - 0.22) / 0.6
				local h = math.sin(air * math.pi)
				y += high * k * h
				legL = 0.7 * h
				legR = legL
				armL = 0.2 + 0.8 * h
				armR = armL
				wing = 0.6 * h * math.sin(air * TAU * 3)
				if action == "Flip" then
					flip = -TAU * smooth(air)
				end
			else
				local land = (a - 0.82) / 0.18
				y -= 0.1 * k * math.sin(land * math.pi)
				armL, armR = 0.5 * (1 - land), 0.5 * (1 - land)
			end
		elseif action == "Wiggle" then
			roll += 0.25 * math.sin(a * TAU * 3) * (1 - a)
		elseif action == "Wave" then
			local up = math.min(1, a * 4, (1 - a) * 4)
			armR = armR + (0.85 - armR) * up + 0.3 * up * math.sin(a * TAU * 3)
			roll += 0.05 * up
			floppy = false
		elseif action == "Cheer" then
			local pump = math.abs(math.sin(a * TAU * 1.5))
			y += 0.28 * k * pump
			armL = 0.55 + 0.45 * pump
			armR = armL
			legL, legR = 0.3 * pump, 0.3 * pump
			floppy = false
		elseif action == "LookAround" then
			yaw += 0.75 * math.sin(a * TAU) * math.sin(a * math.pi)
		elseif action == "Doze" then
			-- a stretch and a yawn, then a quick nap
			if a < 0.25 then
				local stretch = math.sin(a / 0.25 * math.pi)
				armL, armR = 0.2 + 0.8 * stretch, 0.2 + 0.8 * stretch
				y += 0.12 * k * stretch
				setMouth(idle, stretch > 0.3)
			else
				eyesClosed = true
				roll += 0.07 * math.sin((a - 0.25) * TAU * 0.8)
				y -= 0.05 * k * (0.5 + 0.5 * math.sin((a - 0.25) * TAU * 1.2))
				armL, armR = 0.05, 0.05
			end
			floppy = false
		end
	end

	-- Arms flop with the bounce: they lag behind, flying up as the donut drops
	local velocity = (y - idle.LastY) / math.max(dt, 1 / 120) / math.max(k, 0.1)
	idle.LastY = y
	idle.Flop = approach(idle.Flop, if floppy then math.clamp(-velocity * 0.12, -0.25, 0.3) else 0, 12, dt)
	armL += idle.Flop
	armR += idle.Flop

	-- Mouth: open for the big moves (the Doze yawn sets it above)
	if action ~= "Doze" then
		setMouth(idle, action ~= nil and OPEN_MOUTH[action] == true)
	end

	-- Blink (and keep them shut while dozing)
	if #idle.Eyes > 0 then
		if eyesClosed then
			setBlink(idle, true)
			idle.BlinkUntil = now + 0.1
		elseif idle.Blinking then
			if now >= idle.BlinkUntil then
				setBlink(idle, false)
			end
		elseif now >= idle.NextBlink then
			setBlink(idle, true)
			idle.BlinkUntil = now + 0.13
			-- sometimes a quick double blink
			idle.NextBlink = now + (if idle.Rng:NextNumber() < 0.2 then 0.3 else idle.Rng:NextNumber(2, 5))
		end
	end

	-- Body: rock around the feet, turn and flip around the middle
	local b = idle.Bottom
	local body = idle.Base
		* CFrame.new(0, y, 0)
		* CFrame.Angles(0, yaw, 0)
		* CFrame.Angles(flip, 0, 0)
		* CFrame.new(0, -b, 0)
		* CFrame.Angles(pitch, 0, roll)
		* CFrame.new(0, b, 0)
	idle.Root.CFrame = body

	-- Eyes: follow you while you're close, otherwise wander now and then
	if #idle.Pupils > 0 and not idle.Blinking then
		if watching and target then
			local seen = body:PointToObjectSpace(target)
			if seen.Z < 0 then
				idle.GazeTarget = Vector2.new(math.clamp(seen.X / -seen.Z * 1.6, -1, 1), math.clamp((seen.Y - EYE_HEIGHT * k) / -seen.Z * 1.6, -1, 1))
			else
				idle.GazeTarget = Vector2.new(if seen.X > 0 then 1 else -1, 0)
			end
		elseif action == "LookAround" then
			idle.GazeTarget = Vector2.new(math.clamp(math.sin((now - idle.ActionStart) / ACTION_LENGTH.LookAround * TAU) * 2, -1, 1), 0.2)
		elseif now >= idle.NextGaze then
			idle.GazeTarget = if idle.Rng:NextNumber() < 0.4 then Vector2.zero else Vector2.new(idle.Rng:NextNumber(-1, 1), idle.Rng:NextNumber(-0.6, 0.8))
			idle.NextGaze = now + idle.Rng:NextNumber(0.8, 3)
		end
		-- eyes dart quickly towards what they look at
		local gaze = idle.Gaze:Lerp(idle.GazeTarget, 1 - math.exp(-18 * dt))
		setGaze(idle, gaze)
	end

	-- Limbs: swing each one around its pivot
	for _, limb in idle.Limbs do
		local kind = limb.Kind
		local rotation: CFrame
		if kind == "Leg" then
			rotation = CFrame.Angles(if limb.Side < 0 then legL else legR, 0, 0)
		elseif kind == "Arm" then
			rotation = CFrame.Angles(0, 0, limb.Side * ((if limb.Side < 0 then armL else armR) - 0.5))
		elseif kind == "Wing" then
			rotation = CFrame.Angles(0, 0, limb.Side * wing)
		elseif kind == "Spin" then
			rotation = CFrame.Angles(0, (t * 14) % TAU, 0)
		elseif kind == "Orbit" then
			rotation = CFrame.Angles(0, (t * 1.3) % TAU, 0)
		elseif kind == "Tentacle" then
			rotation = CFrame.Angles(0, 0, 0.18 * math.sin(t * 3 + limb.Phase) - limb.Side * 0.12 * math.max(0, y / math.max(k, 0.1)))
		elseif kind == "Cape" then
			rotation = CFrame.Angles(0.12 + 0.08 * math.sin(t * 2.2) + math.clamp(velocity * 0.05, -0.2, 0.2), 0, 0.03 * math.sin(t * 1.3))
		elseif kind == "Tail" then -- wags side to side
			rotation = CFrame.Angles(0, 0.35 * math.sin(t * 4 + limb.Phase), 0)
		elseif kind == "Sway" then -- flags, flames, antennae
			rotation = CFrame.Angles(0.06 * math.sin(t * 2.1 + limb.Phase), 0, 0.12 * math.sin(t * 2.6 + limb.Phase))
		elseif kind == "Roll" then -- clock hands, wind-up keys: turns round the front-back axis
			rotation = CFrame.Angles(0, 0, (t * 1.6) % TAU)
		elseif kind == "Horizon" and limb.Axis then -- a ring spinning round its own (tipped) axis
			rotation = CFrame.fromAxisAngle(limb.Axis, (t * limb.Spin) % TAU)
		else
			rotation = CFrame.identity
		end
		-- (legs stay planted on the ground while the body breathes above them)
		local breath = if kind == "Leg" then Vector3.zero else breathOffset(idle, limb.Pivot.Position)
		limb.Weld.C0 = limb.Pivot * rotation * limb.Pivot:Inverse() * limb.Base + breath
	end
end

local function focusPosition(): Vector3?
	local camera = workspace.CurrentCamera
	if camera then
		return camera.CFrame.Position
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

-- What donuts look at: your head (or where it would be).
local function watchedPosition(): Vector3?
	local character = player.Character
	if not character then
		return nil
	end
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head.Position
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position + Vector3.new(0, 1.5, 0)
	end
	return nil
end

function DonutIdle.Init()
	for _, tag in { "BaseDonut" } do
		for _, instance in CollectionService:GetTagged(tag) do
			task.spawn(register, instance)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(register)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance)
			if instance:IsA("Model") then
				idles[instance] = nil
			end
		end)
	end

	RunService.RenderStepped:Connect(function(dt: number)
		local focus = focusPosition()
		if not focus then
			return
		end
		clock += dt
		local now = clock
		local target = watchedPosition()
		local camera = workspace.CurrentCamera
		local eye = if camera then camera.CFrame.Position else focus
		local look = if camera then camera.CFrame.LookVector else Vector3.zero
		local close: { { Idle: Idle, Distance: number } } = {}
		for model, idle in idles do
			if not model.Parent then
				idles[model] = nil
				continue
			end
			local distance = (idle.Base.Position - focus).Magnitude
			if idle.Lod then
				if distance < LOD_DISTANCE then
					setLod(idle, false)
				end
			elseif distance > LOD_DISTANCE + 10 then
				setLod(idle, true)
			end
			if distance < BREATHE_RANGE then
				table.insert(close, { Idle = idle, Distance = distance })
			end
			if distance < RANGE then
				idle.Active = true
				idle.Accum += dt
				-- Off to the side or behind the camera: nobody sees it move, skip it (close ones
				-- always move, they can swing into view any moment). Far ones move at 15 fps.
				local toward = idle.Base.Position - eye
				local inView = distance < NEAR or look == Vector3.zero or toward:Dot(look) > toward.Magnitude * 0.35
				local interval = if distance < NEAR then 0 elseif distance < RANGE * 0.6 then 1 / 30 else 1 / 15
				if inView and idle.Accum >= interval then
					animate(idle, now, idle.Accum, target)
					idle.Accum = 0
				elseif idle.Accum > 1 then
					idle.Accum = 1 -- (don't save up a huge jump while it's out of view)
				end
			elseif idle.Active then
				idle.Active = false
				reset(idle)
			end
		end

		-- Breathing: the closest few breathe in and out; the others ease back to standing still
		table.sort(close, function(a, b)
			return a.Distance < b.Distance
		end)
		local chosen: { [Idle]: boolean } = {}
		for i = 1, math.min(BREATHERS, #close) do
			chosen[close[i].Idle] = true
		end
		for _, idle in idles do
			local wanted = if chosen[idle] and idle.Active then 1 else 0
			if wanted == 0 and idle.BreathWeight == 0 then
				continue
			end
			idle.BreathWeight = approach(idle.BreathWeight, wanted, 2.5, dt)
			idle.BreathAccum += dt
			if wanted == 0 and idle.BreathWeight < 0.02 then
				idle.Breath, idle.BreathWeight = 0, 0
				breathe(idle) -- (back to exactly how it was built)
			elseif idle.BreathAccum >= 1 / BREATHE_RATE then
				idle.BreathAccum = 0
				idle.Breath = idle.BreathWeight * math.sin((now + idle.Phase) / BREATHE_PERIOD * TAU)
				breathe(idle)
			end
		end
	end)
end

return DonutIdle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	Effects: purely cosmetic, client-side animation so the server never has to replicate it.
	  DonutFloat / PodiumSpin  - rare donuts bob and spin (base donuts are animated by DonutIdle)
	  DonutRainbow             - frosting cycles through the rainbow (Celestial, Secret)
	  RainbowPart / RainbowText- rainbow parts and labels
	  SpinSlow                 - floating crystals and halo rings
	  TreadmillBelt            - belt slats scroll backwards
	  Area ambience            - lighting, fog and colour grading change per area
	  Owner-only prompts       - hide Upgrade/Sell prompts on other people's donuts
	  Popups                   - "+$" above your donuts
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Areas = require(Shared.Areas)
local Format = require(Shared.Format)

local Theme = require(script.Parent.UI.Theme)
local State = require(script.Parent.State)
local AreaTracker = require(script.Parent.AreaTracker)
local Bases = require(script.Parent.Bases)

local Effects = {}

local player = Players.LocalPlayer :: Player
local ANIMATE_DISTANCE = 180

--------------------------------------------------------------------------------
-- Tag tracking helper
--------------------------------------------------------------------------------
local function track<T>(tag: string, onAdd: (Instance) -> T?): { [Instance]: T }
	local set: { [Instance]: T } = {}
	local function add(instance: Instance)
		local value = onAdd(instance)
		if value ~= nil then
			set[instance] = value
		end
	end
	for _, instance in CollectionService:GetTagged(tag) do
		task.spawn(add, instance)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance)
		set[instance] = nil
	end)
	return set
end

local function cameraPosition(): Vector3
	local camera = workspace.CurrentCamera
	return if camera then camera.CFrame.Position else Vector3.zero
end

--------------------------------------------------------------------------------
-- Donut motion + rainbow
--------------------------------------------------------------------------------
type Floater = { Root: BasePart, Base: CFrame, Phase: number, Spin: number, Bob: number, Accum: number }

local function makeFloater(spin: number, bob: number): (Instance) -> Floater?
	return function(instance: Instance): Floater?
		if not instance:IsA("Model") or CollectionService:HasTag(instance, "BaseDonut") or instance:GetAttribute("Follower") then
			return nil
		end
		local root = instance.PrimaryPart or instance:WaitForChild("Root", 5)
		if not root or not root:IsA("BasePart") then
			return nil
		end
		return { Root = root, Base = root.CFrame, Phase = math.random() * 6, Spin = spin, Bob = bob, Accum = 0 }
	end
end

type Rainbow = { Parts: { BasePart }, Center: BasePart? }

local function makeRainbowModel(instance: Instance): Rainbow?
	local parts = {}
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") and (descendant.Name == "Frosting" or descendant.Name == "Aura" or descendant.Name == "Pillar") then
			table.insert(parts, descendant)
		end
	end
	local center = if instance:IsA("Model") then instance.PrimaryPart else nil
	return { Parts = parts, Center = center or parts[1] }
end

local function startDonutEffects()
	local floaters = track("DonutFloat", makeFloater(0.9, 0.35))
	local podiums = track("PodiumSpin", makeFloater(0.6, 0.25))
	local rainbows: { [Instance]: Rainbow } = track("DonutRainbow", makeRainbowModel)
	local rainbowParts = track("RainbowPart", function(instance)
		return if instance:IsA("BasePart") then instance else nil
	end)
	local rainbowTexts = track("RainbowText", function(instance)
		return if instance:IsA("TextLabel") then instance else nil
	end)
	type Spinner = { Model: Model, Base: CFrame }
	local spinners: { [Instance]: Spinner } = track("SpinSlow", function(instance): Spinner?
		if instance:IsA("Model") and instance.PrimaryPart then
			return { Model = instance, Base = instance:GetPivot() }
		end
		return nil
	end)

	local colourClock = 0
	local spinClock = 0
	RunService.RenderStepped:Connect(function(dt: number)
		local t = os.clock()
		local camera = workspace.CurrentCamera
		local cam = if camera then camera.CFrame.Position else Vector3.zero
		local look = if camera then camera.CFrame.LookVector else Vector3.zero

		-- Every donut is ~100 parts, so moving one isn't free: the ones behind the camera wait, and
		-- the further away they are the less often they move (60 / 30 / 15 times a second).
		local function animate(set: { [Instance]: Floater })
			for model, f in set do
				local root = f.Root
				if not model.Parent then
					set[model] = nil
					continue
				end
				-- Only animate anchored donuts (not one that's being carried).
				if not root.Anchored then
					continue
				end
				f.Accum += dt
				local toward = f.Base.Position - cam
				local distance = toward.Magnitude
				if distance > ANIMATE_DISTANCE then
					continue
				end
				local interval = if distance < 45 then 0 elseif distance < 100 then 1 / 30 else 1 / 15
				local inView = distance < 25 or toward:Dot(look) > distance * 0.3
				if inView and f.Accum >= interval then
					f.Accum = 0
					root.CFrame = f.Base * CFrame.new(0, math.sin(t * 2 + f.Phase) * f.Bob, 0) * CFrame.Angles(0, t * f.Spin + f.Phase, 0)
				end
			end
		end
		animate(floaters)
		animate(podiums)

		-- Slow spinners (30 times a second) and colour cycling (15) don't need every frame either
		spinClock += dt
		if spinClock >= 1 / 30 then
			spinClock = 0
			for model, s in spinners do
				if not model.Parent then
					spinners[model] = nil
				elseif (s.Base.Position - cam).Magnitude < 350 then
					s.Model:PivotTo(s.Base * CFrame.Angles(0, t * 0.5, math.sin(t) * 0.2))
				end
			end
		end
		colourClock += dt
		if colourClock < 1 / 15 then
			return
		end
		colourClock = 0
		local hue = (t * 0.2) % 1
		for model, r in rainbows do
			if not model.Parent then
				rainbows[model] = nil
			elseif r.Center and (r.Center.Position - cam).Magnitude < ANIMATE_DISTANCE * 1.5 then
				for i, part in r.Parts do
					part.Color = Color3.fromHSV((hue + i * 0.07) % 1, 0.7, 1)
				end
			end
		end
		for part in rainbowParts do
			local p = part :: BasePart
			if (p.Position - cam).Magnitude < 400 then
				p.Color = Color3.fromHSV((hue + p.Position.Z * 0.002) % 1, 0.8, 1)
			end
		end
		for label in rainbowTexts do
			if label.Parent then
				(label :: TextLabel).TextColor3 = Color3.fromHSV(hue, 0.6, 1)
			else
				rainbowTexts[label] = nil
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Treadmill belts
--------------------------------------------------------------------------------
local function startTreadmills()
	type Belt = { Belt: BasePart, Slats: { BasePart } }
	local belts: { [Instance]: Belt } = track("TreadmillBelt", function(instance): Belt?
		if not instance:IsA("BasePart") then
			return nil
		end
		task.wait(0.5) -- let the slats replicate
		local treadmill = instance.Parent
		if not treadmill then
			return nil -- rebuilt already (the base moved worlds)
		end
		local slats: { BasePart } = {}
		for _, child in treadmill:GetChildren() do
			if child:IsA("BasePart") and child.Name == "Slat" then
				table.insert(slats, child)
			end
		end
		table.sort(slats, function(a, b)
			return ((a:GetAttribute("SlatIndex") :: number?) or 0) < ((b:GetAttribute("SlatIndex") :: number?) or 0)
		end)
		return { Belt = instance, Slats = slats }
	end)
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local cam = cameraPosition()
		for belt, info in belts do
			local part = info.Belt
			if not belt.Parent then
				belts[belt] = nil
			elseif (part.Position - cam).Magnitude < 150 and #info.Slats > 0 then
				local length = part.Size.Z
				local spacing = length / #info.Slats
				local offset = (t * Config.Treadmill.BeltSpeed) % spacing
				for i, slat in info.Slats do
					local z = ((i - 1) * spacing + offset) % length - length / 2
					slat.CFrame = part.CFrame * CFrame.new(0, part.Size.Y / 2 + 0.03, z)
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Owner-only prompts (Upgrade / Sell / Podium on other players' bases are hidden).
--------------------------------------------------------------------------------
local function startPromptFilter()
	local function filter(prompt: Instance)
		if not prompt:IsA("ProximityPrompt") then
			return
		end
		local function apply()
			local owner = prompt:GetAttribute("OwnerUserId")
			if prompt.Enabled and owner ~= nil and owner ~= player.UserId then
				prompt.Enabled = false
			end
		end
		apply()
		prompt:GetAttributeChangedSignal("OwnerUserId"):Connect(apply)
		prompt:GetPropertyChangedSignal("Enabled"):Connect(apply)
	end
	for _, descendant in workspace:GetDescendants() do
		filter(descendant)
	end
	workspace.DescendantAdded:Connect(filter)
end

--------------------------------------------------------------------------------
-- Area ambience: brighter/basic near the hub, darker and more magical further out
--------------------------------------------------------------------------------
local function startAmbience()
	local tint = Lighting:WaitForChild("AreaTint", 10) :: ColorCorrectionEffect?
	local atmosphere = Lighting:WaitForChild("Atmosphere", 10) :: Atmosphere?
	local bloom = Lighting:WaitForChild("Bloom", 10) :: BloomEffect?
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	local function apply(areaId: number)
		local storming = workspace:GetAttribute("EventId") == "EternalStorm"
		local amb = if storming then Areas.Storm elseif areaId > 0 then Areas.List[areaId].Ambience else Areas.Hub
		-- Day -> night goes forwards through sunset (ClockTime wraps at 24) instead of rewinding the sun.
		local clock = amb.ClockTime
		if clock < 6 and Lighting.ClockTime > 6 then
			clock += 24
		end
		TweenService:Create(Lighting, info, { ClockTime = clock, Ambient = amb.Ambient, OutdoorAmbient = amb.Ambient:Lerp(Color3.new(1, 1, 1), 0.2) }):Play()
		local look = Config.Graphics
		if tint then
			TweenService:Create(tint, info, { TintColor = amb.Tint, Saturation = amb.Saturation + look.SaturationBoost, Contrast = amb.Contrast + look.ContrastBoost }):Play()
		end
		if atmosphere then
			-- Decay is the colour far-away things fade to: match it to the area's air, so distant
			-- scenery melts into a coloured fog instead of ending against grey
			TweenService:Create(atmosphere, info, { Color = amb.AtmosphereColor, Decay = amb.AtmosphereColor:Lerp(Color3.new(0, 0, 0), 0.45), Density = amb.AtmosphereDensity, Haze = amb.Haze }):Play()
		end
		if bloom then
			TweenService:Create(bloom, info, { Intensity = amb.Bloom + look.BloomBoost }):Play()
		end
		-- clouds only in daylight with clear air (not at night, in caves or in thick fog)
		local terrain = workspace:FindFirstChildOfClass("Terrain")
		local clouds = terrain and terrain:FindFirstChildOfClass("Clouds")
		if clouds then
			clouds.Enabled = amb.ClockTime >= 7 and amb.ClockTime <= 17.5 and amb.AtmosphereDensity < 0.35
		end
	end
	AreaTracker.Changed:Connect(apply)
	if AreaTracker.Current >= 0 then
		apply(AreaTracker.Current)
	end
	-- the Eternal Storm turns every area to its night sky, and back when it's over
	workspace:GetAttributeChangedSignal("EventId"):Connect(function()
		apply(math.max(AreaTracker.Current, 0))
	end)
end

--------------------------------------------------------------------------------
-- Floating number popups
--------------------------------------------------------------------------------
local function popup(adornee: BasePart, text: string, color: Color3, offset: Vector3)
	local gui = Theme.new("BillboardGui", {
		Adornee = adornee,
		Size = UDim2.fromOffset(160, 40),
		StudsOffsetWorldSpace = offset,
		AlwaysOnTop = false,
		LightInfluence = 0,
		MaxDistance = 90,
		Parent = Theme.PlayerGui(),
	})
	local label = Theme.Label({ Text = text, TextColor3 = color, Size = UDim2.fromScale(1, 1), StrokeThickness = 2.5, Parent = gui })
	TweenService:Create(gui, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = offset + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
	task.delay(1.25, function()
		gui:Destroy()
	end)
end

local function startPopups()
	-- (Treadmill "+speed" popups live in client/Treadmill.luau.)
	-- "+$X" above your own donuts every few seconds
	task.spawn(function()
		local interval = 3
		while true do
			task.wait(interval)
			local plot = Bases.Mine()
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if plot and root and (root.Position - plot:GetPivot().Position).Magnitude < 180 then
				local mult = math.max(1, State.Number("MoneyMultiplier"))
				for _, child in plot:GetChildren() do
					local income = child:GetAttribute("Income")
					if child:IsA("Model") and child.PrimaryPart and type(income) == "number" then
						local top = (child:GetAttribute("Top") :: number?) or 3
						popup(child.PrimaryPart, "+" .. Format.Money(income * interval * mult), Theme.Colors.Money, Vector3.new(0, top + 3, 0))
					end
				end
			end
		end
	end)
end

function Effects.Init()
	startDonutEffects()
	startTreadmills()
	startPromptFilter()
	startAmbience()
	startPopups()
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">Flight</string>
            <string name="Source"><![CDATA[--[[
	Flight and noclip (admin panel): the server sets your "FlyMode" attribute to "Fly" or "Carpet"; this flies.

	  Move with the normal controls (WASD / thumbstick); the way you face follows the camera.
	  Space / the ⬆ button = up, Shift or Ctrl / the ⬇ button = down. Looking up or down while moving
	  forward also climbs or dives.
	  "Carpet" puts a magic carpet (with tassels and sparkles) under your feet.
	Speed: your walk speed x Config.Admin.FlySpeed (at least 60).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Theme = require(script.Parent.UI.Theme)

local Flight = {}

local player = Players.LocalPlayer :: Player
local rgb = Color3.fromRGB

type Rig = { Velocity: LinearVelocity, Align: AlignOrientation, Attachment: Attachment, Carpet: Model?, Humanoid: Humanoid }
local rig: Rig? = nil
local vertical = 0 -- -1 down, 0, 1 up (keys / buttons)
local buttons: Frame? = nil

local function buildCarpet(root: BasePart): Model
	local model = Instance.new("Model")
	model.Name = "MagicCarpet"
	local function piece(size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?): Part
		local p = Instance.new("Part")
		p.Size = size
		p.CFrame = root.CFrame * offset
		p.Color = color
		p.Material = material or Enum.Material.Fabric
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
		p.Parent = model
		return p
	end
	local base = CFrame.new(0, -3.1, 0)
	local rug = piece(Vector3.new(6, 0.25, 8), base, rgb(170, 30, 60))
	piece(Vector3.new(5, 0.27, 7), base, rgb(230, 170, 40))
	piece(Vector3.new(4, 0.29, 6), base, rgb(120, 20, 90))
	for _, z in { -4.2, 4.2 } do
		for x = -2.5, 2.5, 1 do
			piece(Vector3.new(0.25, 0.25, 0.6), base * CFrame.new(x, 0, z), rgb(255, 215, 80))
		end
	end
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = rgb(255, 220, 120)
	sparkles.Parent = rug
	model.Parent = root.Parent
	return model
end

local function stop()
	if rig then
		rig.Velocity:Destroy()
		rig.Align:Destroy()
		rig.Attachment:Destroy()
		if rig.Carpet then
			rig.Carpet:Destroy()
		end
		rig.Humanoid.PlatformStand = false
		rig = nil
	end
	if buttons then
		buttons.Visible = false
	end
end

local function start(mode: string)
	stop()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "FlightAttachment"
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = root
	local align = Instance.new("AlignOrientation")
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.MaxTorque = math.huge
	align.Responsiveness = 30
	align.CFrame = root.CFrame.Rotation
	align.Parent = root
	humanoid.PlatformStand = true
	rig = {
		Velocity = velocity,
		Align = align,
		Attachment = attachment,
		Carpet = if mode == "Carpet" then buildCarpet(root) else nil,
		Humanoid = humanoid,
	}
	if buttons then
		buttons.Visible = UserInputService.TouchEnabled
	end
end

local function apply()
	local mode = player:GetAttribute("FlyMode")
	if mode == "Fly" or mode == "Carpet" then
		start(mode)
	else
		stop()
	end
end

-- ⬆ / ⬇ buttons for phones and tablets
local function buildButtons()
	local gui = Theme.ScreenGui("FlightButtons", 5)
	local frame = Theme.new("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -170, 1, -150), Size = UDim2.fromOffset(70, 150), BackgroundTransparency = 1, Visible = false, Parent = gui })
	Theme.AutoScale(frame)
	type Info = { Text: string, Direction: number }
	local infos: { Info } = { { Text = "⬆", Direction = 1 }, { Text = "⬇", Direction = -1 } }
	for i, info in infos do
		local button = Theme.Button({ Text = info.Text, Color = Theme.Colors.Blue, Size = UDim2.fromOffset(66, 66), Position = UDim2.fromOffset(0, (i - 1) * 76), Parent = frame })
		button.MouseButton1Down:Connect(function()
			vertical = info.Direction
		end)
		button.MouseButton1Up:Connect(function()
			vertical = 0
		end)
		button.MouseLeave:Connect(function()
			vertical = 0
		end)
	end
	buttons = frame
end

function Flight.Init()
	-- Noclip (admin panel): walk through walls while the "Noclip" attribute is on.
	local noclipParts: { [BasePart]: boolean } = {}
	RunService.Stepped:Connect(function()
		local character = player.Character
		if player:GetAttribute("Noclip") and character then
			for _, part in character:GetDescendants() do
				if part:IsA("BasePart") and part.CanCollide then
					noclipParts[part] = true
					part.CanCollide = false
				end
			end
		elseif next(noclipParts) then
			for part in noclipParts do
				if part.Parent then
					part.CanCollide = true
				end
			end
			table.clear(noclipParts)
		end
	end)
	buildButtons()
	player:GetAttributeChangedSignal("FlyMode"):Connect(apply)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		apply()
	end)
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Space then
			vertical = 1
		elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.LeftControl then
			vertical = -1
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.LeftControl then
			vertical = 0
		end
	end)
	RunService.RenderStepped:Connect(function()
		local current = rig
		if not current then
			return
		end
		if not current.Humanoid.Parent or current.Humanoid.Health <= 0 then
			stop()
			return
		end
		local camera = workspace.CurrentCamera
		local look = if camera then camera.CFrame.LookVector else Vector3.new(0, 0, -1)
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 then
			current.Align.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit)
		end
		local walk = player:GetAttribute("WalkSpeed")
		local speed = math.max(60, (if type(walk) == "number" then walk else 16) * Config.Admin.FlySpeed)
		local move = current.Humanoid.MoveDirection
		-- Moving towards where the camera looks also climbs / dives with it
		local forward = if flat.Magnitude > 0.01 then flat.Unit else Vector3.zero
		local climb = if move.Magnitude > 0.1 then move:Dot(forward) * look.Y else 0
		current.Velocity.VectorVelocity = (move + Vector3.new(0, vertical + climb, 0)) * speed
		current.Humanoid.PlatformStand = true
	end)
	task.defer(apply)
end

return Flight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">Followers</string>
            <string name="Source"><![CDATA[--[[
	Followers: every player's favourite donut and equipped pets, following them around.

	Drawn by each client from the player's attributes (nothing is simulated or replicated):
	  "Favorite" -> "donutId|mutation|size" of their favourite base donut: a copy at
	                Config.Favorite.Scale (1/3) of its size on the stand, mutation look included
	  "Pets"     -> comma-separated ids of their equipped pets
	Walkers hop along behind you, flyers and blobs float. Wings flap, tails wag (faster while you're
	on the move), whale flukes paddle, tentacles wiggle and everyone blinks - all by swinging the
	parts PetModel marked ("Limb") around their joints ("Pivot"). Only followers near the camera are
	animated.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Donuts = require(Shared.Donuts)
local Pets = require(Shared.Pets)
local DonutModel = require(Shared.DonutModel)
local PetModel = require(Shared.PetModel)

local Followers = {}

local RANGE = 220
-- Where followers walk, relative to their owner (behind them, spread out)
local SLOTS = {
	Vector3.new(4, 0, 3.5), -- favourite donut (pushed further out when it's a big one)
	Vector3.new(-4, 0, 3.5),
	Vector3.new(0, 0, 6),
	Vector3.new(-4.5, 0, 8),
	Vector3.new(4.5, 0, 8),
}

-- Limbs that move while following (a favourite donut's arms and legs stay put)
local ANIMATED = { Wing = true, Tail = true, Fluke = true, Fin = true, Tentacle = true, Spin = true, Orbit = true }

type Limb = { Weld: Weld, Base: CFrame, Pivot: CFrame, Kind: string, Side: number }
type Eye = { Part: BasePart, Size: Vector3, Color: Color3 }
type Follower = {
	Model: Model,
	Root: BasePart,
	Slot: number,
	Offset: Vector3, -- where it walks, relative to its owner
	Floats: boolean,
	Height: number, -- root height above the ground
	Phase: number,
	CFrame: CFrame,
	Limbs: { Limb },
	Eyes: { Eye },
	Pupils: { BasePart },
	Blinking: boolean,
	NextBlink: number,
	Rainbow: { BasePart },
	Glitch: boolean,
}

local folder: Folder
local byPlayer: { [Player]: { Follower } } = {}

local function prepare(model: Model, slot: number, floats: boolean, spread: number?): Follower
	local root = model.PrimaryPart :: BasePart
	model:SetAttribute("Follower", true)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	local limbs: { Limb } = {}
	local eyes: { Eye } = {}
	local pupils: { BasePart } = {}
	local rainbow: { BasePart } = {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local weld = part:FindFirstChildOfClass("Weld")
			local kind = part:GetAttribute("Limb")
			if weld and type(kind) == "string" and ANIMATED[kind] then
				local pivot = part:GetAttribute("Pivot")
				local side = part:GetAttribute("Side")
				table.insert(limbs, {
					Weld = weld,
					Base = weld.C0,
					Pivot = CFrame.new(if typeof(pivot) == "Vector3" then pivot else Vector3.zero),
					Kind = kind,
					Side = if type(side) == "number" then side else 0,
				})
			end
			if part:GetAttribute("EyeWhite") then
				table.insert(eyes, { Part = part, Size = part.Size, Color = part.Color })
			elseif part:GetAttribute("Pupil") then
				table.insert(pupils, part)
			end
			if model:GetAttribute("Rainbow") and (part.Name == "Body" or part.Name == "Wing") then
				table.insert(rainbow, part)
			end
		end
	end
	local bottom = (model:GetAttribute("Bottom") :: number?) or 1
	return {
		Model = model,
		Root = root,
		Slot = slot,
		Offset = SLOTS[slot] * (spread or 1),
		Floats = floats,
		Height = bottom + (if floats then 2.2 else 0.05),
		Phase = math.random() * 6,
		CFrame = CFrame.new(),
		Limbs = limbs,
		Eyes = eyes,
		Pupils = pupils,
		Blinking = false,
		NextBlink = os.clock() + math.random() * 4,
		Rainbow = rainbow,
		Glitch = model:GetAttribute("Glitch") == true,
	}
end

local function clear(player: Player)
	local list = byPlayer[player]
	if list then
		for _, follower in list do
			follower.Model:Destroy()
		end
	end
	byPlayer[player] = nil
end

local function rebuild(player: Player)
	clear(player)
	local list: { Follower } = {}
	local favorite = player:GetAttribute("Favorite")
	local parts = if type(favorite) == "string" then string.split(favorite, "|") else {}
	local donut = Donuts.ById[parts[1] or ""]
	if donut then
		-- Same build as the donut on the stand, just smaller
		local model = DonutModel.Build(donut, { Scale = Config.Plots.DonutScale * Config.Favorite.Scale, Mutation = parts[2], Size = parts[3] })
		local _, size = model:GetBoundingBox()
		table.insert(list, prepare(model, 1, true, math.max(1, math.max(size.X, size.Z) / 3)))
	end
	local pets = player:GetAttribute("Pets")
	if type(pets) == "string" and pets ~= "" then
		local slot = 2
		for _, id in string.split(pets, ",") do
			local pet = Pets.ById[id]
			if pet and slot <= #SLOTS then
				local model = PetModel.BuildPet(pet, { Scale = 0.7 })
				local floats = pet.Shape == "Blob" or pet.Shape == "Whale" or Pets.HasFeature(pet, "Wings")
				table.insert(list, prepare(model, slot, floats))
				slot += 1
			end
		end
	end
	for _, follower in list do
		follower.Model.Parent = folder
	end
	byPlayer[player] = list
end

local function watch(player: Player)
	player:GetAttributeChangedSignal("Favorite"):Connect(function()
		rebuild(player)
	end)
	player:GetAttributeChangedSignal("Pets"):Connect(function()
		rebuild(player)
	end)
	rebuild(player)
end

local function update(dt: number)
	local camera = workspace.CurrentCamera
	local cam = if camera then camera.CFrame.Position else Vector3.zero
	local t = os.clock()
	local alpha = 1 - math.exp(-dt * 9)
	for player, list in byPlayer do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local visible = root ~= nil and (root.Position - cam).Magnitude < RANGE
		for _, follower in list do
			local model = follower.Model
			if not visible or not root then
				if model.Parent then
					model.Parent = nil
				end
				continue
			end
			if not model.Parent then
				model.Parent = folder
				follower.CFrame = CFrame.new(root.Position)
			end
			-- Stand behind the owner, on the ground (feet ~3 studs below the root part)
			local hip = if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then humanoid.HipHeight + root.Size.Y / 2 else 3
			local ground = root.Position.Y - hip
			local flat = CFrame.new(root.Position) * CFrame.Angles(0, select(2, root.CFrame:ToEulerAnglesYXZ()), 0)
			local target = (flat * CFrame.new(follower.Offset)).Position
			local moving = root.AssemblyLinearVelocity.Magnitude > 2
			local bob = if follower.Floats then math.sin(t * 2.5 + follower.Phase) * 0.35 elseif moving then math.abs(math.sin(t * 9 + follower.Phase)) * 0.6 else 0
			target = Vector3.new(target.X, ground + follower.Height + bob, target.Z)
			local position = follower.CFrame.Position:Lerp(target, alpha)
			-- Face where the owner is going (or the owner, when standing still)
			local look = if moving then root.CFrame.LookVector else (root.Position - position)
			look = Vector3.new(look.X, 0, look.Z)
			local facing = if look.Magnitude > 0.01 then CFrame.lookAt(position, position + look) else CFrame.new(position)
			if (target - position).Magnitude > 80 then
				facing = CFrame.new(target) -- teleported: snap
			end
			follower.CFrame = facing
			local finalCf = facing
			if follower.Glitch and math.random() < 0.03 then
				finalCf = facing * CFrame.new(math.random() - 0.5, 0, math.random() - 0.5)
			end
			follower.Root.CFrame = finalCf
			local phase = t + follower.Phase
			for _, limb in follower.Limbs do
				local kind = limb.Kind
				local rotation
				if kind == "Wing" then
					rotation = CFrame.Angles(0, 0, math.sin(phase * 12) * 0.45 * limb.Side)
				elseif kind == "Tail" then
					rotation = CFrame.Angles(0, math.sin(phase * (if moving then 16 else 8)) * 0.4, 0)
				elseif kind == "Fluke" then
					rotation = CFrame.Angles(math.sin(phase * 3) * 0.22, 0, 0)
				elseif kind == "Fin" then
					rotation = CFrame.Angles(0, 0, math.sin(phase * 4) * 0.25 * limb.Side)
				elseif kind == "Tentacle" then
					rotation = CFrame.Angles(0, 0, math.sin(phase * 3 + limb.Side) * 0.2)
				elseif kind == "Spin" then
					rotation = CFrame.Angles(0, (t * 14) % (math.pi * 2), 0)
				elseif kind == "Orbit" then
					rotation = CFrame.Angles(0, (t * 1.3) % (math.pi * 2), 0)
				else
					rotation = CFrame.identity
				end
				limb.Weld.C0 = limb.Pivot * rotation * limb.Pivot:Inverse() * limb.Base
			end
			-- Blink: squash the eyes shut for a moment every few seconds
			local shut = t < follower.NextBlink + 0.12 and t >= follower.NextBlink
			if shut ~= follower.Blinking then
				follower.Blinking = shut
				for _, eye in follower.Eyes do
					eye.Part.Size = if shut then Vector3.new(eye.Size.X * 1.05, eye.Size.Y * 0.14, eye.Size.Z * 0.8) else eye.Size
					eye.Part.Color = if shut then Color3.fromRGB(40, 25, 30) else eye.Color
				end
				for _, pupil in follower.Pupils do
					pupil.Transparency = if shut then 1 else 0
				end
			end
			if t >= follower.NextBlink + 0.12 then
				follower.NextBlink = t + 2 + math.random() * 3.5
			end
			if #follower.Rainbow > 0 then
				local color = Color3.fromHSV((t * 0.25) % 1, 0.55, 1)
				for _, part in follower.Rainbow do
					part.Color = color
				end
			end
		end
	end
end

function Followers.Init()
	folder = Instance.new("Folder")
	folder.Name = "Followers"
	folder.Parent = workspace
	for _, player in Players:GetPlayers() do
		task.spawn(watch, player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(clear)
	RunService.RenderStepped:Connect(update)
end

return Followers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">Guards</string>
            <string name="Source"><![CDATA[--[[
	Guards (client side)
	====================
	* Builds YOUR sleeping Domer in every biome's back corner (only you can see him; everyone has
	  their own): in the first biomes he's asleep on his back on his couch (GuardModel.Sleep), later
	  on he sleeps standing up with his head down (GuardModel.Doze). Eyes shut; every breath out puffs
	  a few Z's out of his open mouth, and up close you hear him snore (a deep rattling breath in, a
	  soft breath out: made from Roblox's own sounds, or Config.Guard.SnoreSoundId).
	* The moment he wakes up to chase you, he lets out an angry grunt (Config.Guard.GruntSoundId).
	* When you steal a box the server spawns your chasing guard: your sleeping one disappears in a
	  puff of smoke, and lies back down once the chasing one has walked back to his corner. His
	  animations are preloaded at the start, so he never freezes the first time he wakes up.
	* Other players' chasing guards are hidden, so you never see anyone else's Domers.
]]

local CollectionService = game:GetService("CollectionService")
local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Config = require(Shared.Config)
local GuardModel = require(Shared.GuardModel)

local player = Players.LocalPlayer :: Player

local Guards = {}

type Sleeper = {
	Model: Model,
	Status: TextLabel,
	Home: CFrame,
	Hidden: boolean,
	Mouth: BasePart?,
	Snore: Sound?,
	Phase: number,
	BreathingOut: boolean,
	Snoring: boolean,
}

local SNORE_RANGE = 85 -- studs: how far away you can hear him
local Z_RANGE = 240 -- ...and see his Z's
local BREATH = 3.8 -- seconds per breath (in 1.7 s, out 1.3 s, then a pause)
local BREATH_IN = 1.7
local BREATH_OUT = 1.3

local sleepers: { [number]: Sleeper } = {}
local folder: Folder

--------------------------------------------------------------------------------
-- Poof
--------------------------------------------------------------------------------
function Guards.Poof(position: Vector3, color: Color3?)
	local part = Instance.new("Part")
	part.Name = "Poof"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(4, 6, 4)
	part.CFrame = CFrame.new(position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color or Color3.fromRGB(255, 255, 255))
	emitter.LightEmission = 0.3
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Speed = NumberRange.new(6, 12)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 5
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 3.5) })
	emitter.Transparency = NumberSequence.new(0.2, 1)
	emitter.Rate = 0
	emitter.Parent = part
	part.Parent = folder
	emitter:Emit(28)
	task.delay(1.5, function()
		part:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- Sleeping guards (local only)
--------------------------------------------------------------------------------
local function setHidden(sleeper: Sleeper, hidden: boolean)
	if sleeper.Hidden == hidden then
		return
	end
	sleeper.Hidden = hidden
	sleeper.Model.Parent = if hidden then nil else folder
	Guards.Poof(sleeper.Home.Position + Vector3.new(0, 2, 0))
end

-- His snore: a slowed-down rumble with a fast flutter on it (the rattle), fading in and out with
-- every breath (see breathe). A pasted Creator Store snore plays as it is instead.
local function makeSnore(mouth: BasePart?): Sound?
	if not mouth then
		return nil
	end
	local custom = Config.Guard.SnoreSoundId
	local sound = Instance.new("Sound")
	sound.Name = "Snore"
	sound.SoundId = if custom ~= "" then custom else "rbxasset://sounds/action_falling.mp3"
	sound.Looped = true
	sound.Volume = 0
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 15
	sound.RollOffMaxDistance = SNORE_RANGE
	if custom == "" then
		local rattle = Instance.new("TremoloSoundEffect")
		rattle.Frequency = 22
		rattle.Depth = 0.85
		rattle.Duty = 0.5
		rattle.Parent = sound
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = 5
		eq.MidGain = -3
		eq.HighGain = -16
		eq.Parent = sound
	end
	sound.Parent = mouth
	return sound
end

-- A few Z's puff out of his mouth and float up, growing and fading.
local function puffZs(sleeper: Sleeper)
	local mouth = sleeper.Mouth
	if not mouth then
		return
	end
	local scale = Config.Guard.Scale
	local drift = (if math.random() < 0.5 then -1 else 1) * scale * 0.5
	for i = 1, 3 do
		task.delay((i - 1) * 0.45, function()
			if sleeper.Hidden or not mouth.Parent then
				return
			end
			local gui = Instance.new("BillboardGui")
			gui.Name = "Z"
			gui.Adornee = mouth
			gui.LightInfluence = 0
			gui.MaxDistance = Z_RANGE
			local start = (1 + i * 0.3) * scale -- (big enough to read from across the area)
			gui.Size = UDim2.fromScale(start, start)
			gui.StudsOffsetWorldSpace = Vector3.new(0, 0.35 * scale, 0)
			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Size = UDim2.fromScale(1, 1)
			label.Font = Enum.Font.LuckiestGuy
			label.Text = if i == 1 then "z" else "Z"
			label.TextScaled = true
			label.TextColor3 = Color3.fromRGB(235, 245, 255)
			label.TextStrokeTransparency = 1
			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.fromRGB(50, 70, 140)
			stroke.Thickness = 3
			stroke.Parent = label
			label.Rotation = math.random(-18, 18)
			label.Parent = gui
			gui.Parent = sleeper.Model
			local size = start * 1.9
			TweenService:Create(gui, TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				StudsOffsetWorldSpace = Vector3.new(drift * (1.5 + i * 0.6), (3.2 + i * 0.9) * scale, 0),
				Size = UDim2.fromScale(size, size),
			}):Play()
			TweenService:Create(label, TweenInfo.new(1.1, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 1.5), {
				TextTransparency = 1,
				TextStrokeTransparency = 1,
				Rotation = label.Rotation + math.random(-25, 25),
			}):Play()
			TweenService:Create(stroke, TweenInfo.new(1.1, Enum.EasingStyle.Linear, Enum.EasingDirection.In, 0, false, 1.5), { Transparency = 1 }):Play()
			task.delay(2.7, function()
				gui:Destroy()
			end)
		end)
	end
end

-- One step of his breathing (every few frames): the snore swells while he breathes in, a soft
-- whoosh and the Z's come out while he breathes out.
local function breathe(sleeper: Sleeper, now: number, seen: boolean, heard: boolean)
	local cycle = (now + sleeper.Phase) % BREATH
	local out = cycle >= BREATH_IN and cycle < BREATH_IN + BREATH_OUT
	if out and not sleeper.BreathingOut and seen then
		puffZs(sleeper)
	end
	sleeper.BreathingOut = out
	local sound = sleeper.Snore
	if not sound then
		return
	end
	if heard ~= sleeper.Snoring then
		sleeper.Snoring = heard
		if heard then
			sound:Play()
		else
			sound:Stop()
		end
	end
	if not heard then
		return
	end
	if Config.Guard.SnoreSoundId ~= "" then
		sound.Volume = 0.6
		return
	end
	local rattle = sound:FindFirstChildOfClass("TremoloSoundEffect")
	if cycle < BREATH_IN then
		-- in: a deep rattling rumble that builds up, then stops short
		local a = cycle / BREATH_IN
		local fade = if a > 0.9 then (1 - a) / 0.1 else 1
		sound.Volume = 0.55 * math.sin(math.min(a * 1.2, 1) * math.pi * 0.5) * fade
		sound.PlaybackSpeed = 0.2 + 0.05 * a
		if rattle then
			rattle.Enabled = true
		end
	elseif out then
		-- out: a soft "pfff"
		local a = (cycle - BREATH_IN) / BREATH_OUT
		sound.Volume = 0.2 * math.sin(a * math.pi)
		sound.PlaybackSpeed = 0.45
		if rattle then
			rattle.Enabled = false
		end
	else
		sound.Volume = 0
	end
end

-- The angry grunt when he wakes up: a deep, growly "HUUGH!" with a heavy thump.
local function grunt(part: BasePart)
	local custom = Config.Guard.GruntSoundId
	type Layer = { Id: string, Speed: number, Volume: number, Growl: boolean }
	local layers: { Layer } = if custom ~= ""
		then { { Id = custom, Speed = 1, Volume = 1, Growl = false } }
		else {
			{ Id = "rbxasset://sounds/uuhhh.mp3", Speed = 0.5, Volume = 1.3, Growl = true },
			{ Id = "rbxasset://sounds/action_jump_land.mp3", Speed = 0.4, Volume = 0.8, Growl = false },
		}
	for _, layer in layers do
		local sound = Instance.new("Sound")
		sound.Name = "Grunt"
		sound.SoundId = layer.Id
		sound.PlaybackSpeed = layer.Speed
		sound.Volume = layer.Volume
		sound.RollOffMinDistance = 30
		sound.RollOffMaxDistance = 300
		if layer.Growl then
			local growl = Instance.new("DistortionSoundEffect")
			growl.Level = 0.35
			growl.Parent = sound
			local eq = Instance.new("EqualizerSoundEffect")
			eq.LowGain = 4
			eq.HighGain = -8
			eq.Parent = sound
		end
		sound.Parent = part
		sound:Play()
		task.delay(4, function()
			sound:Destroy()
		end)
	end
end

local function buildSleeper(areaId: number)
	local map = workspace:WaitForChild("Map")
	local lane = map:WaitForChild("Lane")
	local area = lane:WaitForChild("Area" .. areaId, 30)
	local marker = area and area:FindFirstChild("GuardHome", true)
	if not marker or not marker:IsA("BasePart") then
		return
	end
	local model, status = GuardModel.Build(areaId)
	-- On his couch: asleep on his back, eyes shut, mouth open. Later biomes: asleep on his feet,
	-- head down. (Both anchor every part.)
	local onCouch = marker:GetAttribute("Couch") == true
	local mouth = if onCouch then GuardModel.Sleep(model) else GuardModel.Doze(model)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	status.Text = "" -- (the Z's come out of his mouth)
	local facing = marker.CFrame.LookVector * Vector3.new(1, 0, 1)
	local floor = Vector3.new(marker.Position.X, 0, marker.Position.Z)
	local home = CFrame.lookAt(floor, floor + (if facing.Magnitude > 0.01 then facing.Unit else Vector3.new(0, 0, -1)))
	model:PivotTo(if onCouch then GuardModel.CouchCFrame(home) else GuardModel.StandCFrame(home))
	model.Parent = folder
	sleepers[areaId] = {
		Model = model,
		Status = status,
		Home = home,
		Hidden = false,
		Mouth = mouth,
		Snore = makeSnore(mouth),
		Phase = math.random() * BREATH,
		BreathingOut = false,
		Snoring = false,
	}
end

--------------------------------------------------------------------------------
-- Chasing guards (server side): hide other players', swap ours with the sleeper
--------------------------------------------------------------------------------
local function hideForMe(model: Instance)
	local function hide(d: Instance)
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = 1
		elseif d:IsA("Decal") then
			d.LocalTransparencyModifier = 1
		elseif d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Highlight") or d:IsA("Fire") or d:IsA("Sparkles") or d:IsA("Smoke") then
			(d :: any).Enabled = false
		elseif d:IsA("Sound") then
			d.Volume = 0
		end
	end
	for _, d in model:GetDescendants() do
		hide(d)
	end
	model.DescendantAdded:Connect(hide)
end

local function onGuardAdded(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	local owner = instance:GetAttribute("OwnerUserId")
	if owner ~= player.UserId then
		hideForMe(instance)
		return
	end
	local areaId = instance:GetAttribute("Area")
	local sleeper = if type(areaId) == "number" then sleepers[areaId] else nil
	if sleeper then
		setHidden(sleeper, true)
		if sleeper.Snore then
			sleeper.Snore:Stop()
			sleeper.Snoring = false
		end
	end
	-- Woken up: an angry grunt
	task.spawn(function()
		local head = instance:WaitForChild("Head", 3)
		if head and head:IsA("BasePart") then
			grunt(head)
		end
	end)
	local lastPosition = instance:GetPivot().Position
	local connection: RBXScriptConnection
	connection = RunService.Heartbeat:Connect(function()
		if instance.Parent then
			lastPosition = instance:GetPivot().Position
		else
			connection:Disconnect()
			-- The chase is over and he walked back to his corner: he lies back down there. (A puff
			-- where he was too, if he didn't make it all the way.)
			if not sleeper or (lastPosition - sleeper.Home.Position).Magnitude > 20 then
				Guards.Poof(lastPosition + Vector3.new(0, 2, 0))
			end
			if sleeper then
				setHidden(sleeper, false)
			end
		end
	end)
end

function Guards.Init()
	-- Load his animations now, not the moment he first wakes up
	task.spawn(function()
		local list = {}
		for _, id in { Config.Guard.WalkAnimation, Config.Guard.IdleAnimation } do
			local animation = Instance.new("Animation")
			animation.AnimationId = id
			table.insert(list, animation)
		end
		pcall(function()
			ContentProvider:PreloadAsync(list)
		end)
	end)

	folder = Instance.new("Folder")
	folder.Name = "MyGuards"
	folder.Parent = workspace

	task.spawn(function()
		for areaId = 1, #Areas.List do
			buildSleeper(areaId)
		end
	end)

	for _, instance in CollectionService:GetTagged("Guard") do
		task.spawn(onGuardAdded, instance)
	end
	CollectionService:GetInstanceAddedSignal("Guard"):Connect(onGuardAdded)

	-- Breathing: snoring and Z's for the sleepers near you
	task.spawn(function()
		local started = os.clock()
		while true do
			task.wait(0.05)
			local camera = workspace.CurrentCamera
			local eye = if camera then camera.CFrame.Position else Vector3.zero
			local now = os.clock() - started
			for _, sleeper in sleepers do
				local distance = if sleeper.Hidden then math.huge else (sleeper.Home.Position - eye).Magnitude
				breathe(sleeper, now, distance < Z_RANGE, distance < SNORE_RANGE + 10)
			end
		end
	end)
end

return Guards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">MeteorFX</string>
            <string name="Source"><![CDATA[--[[
	MeteorFX: the Cosmic Meteor (shared/Meteor, server/MeteorService), played on every client on
	the server's clock, so everyone sees the same thing at the same moment:

	  0s     the whole screen turns white for 2 seconds (with its sound)
	  2s     everything shakes like crazy
	  2.6s   the sky cracks open like glass where the meteor is coming through, and pieces of sky
	         fall out of it (the sky shatter sound)
	  3.4s   the meteor breaks through: a huge burning space rock falls out of the hole, spinning,
	         with a trail of fire behind it, and a glowing circle on the lane shows where it'll hit
	         (the falling sound)
	  7.4s   it smashes into the lane: a fireball, shock waves, flying rock, a beam of light, and a
	         huge shake (bigger the closer you are; the two impact sounds). The server builds the
	         cracked-open meteor and its shards right then (they're the real thing you can grab).

	Also spins the black hole horizon round The Cosmic Donut floating over the Cosmic Forge
	(tagged "HorizonSpin"; donuts in pens are spun by DonutIdle).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Meteor = require(Shared.Meteor)
local Remotes = require(Shared.Remotes)

local MeteorFX = {}

local rgb = Color3.fromRGB
local TAU = math.pi * 2
local WHITE, VIOLET, PINK, CYAN = rgb(255, 255, 255), rgb(175, 95, 255), rgb(255, 120, 220), rgb(110, 230, 255)
local FIRE, HOT = rgb(255, 150, 60), rgb(255, 230, 170)
local SKY_GLASS = { rgb(150, 190, 255), rgb(190, 165, 255), rgb(120, 160, 235) }
local GRAVITY = Vector3.new(0, -196, 0)
local CRACK_RADIUS = 260 -- studs, the crack in the sky
local HOLE_RADIUS = 80 -- ...and the hole the meteor bursts out of
local SHAKE_HARD = 4 -- the big shake after the white screen
local IMPACT_RANGE = 1600 -- the impact shakes everyone this close (more the closer)

type Piece = { Part: BasePart, Velocity: Vector3, Spin: Vector3, Born: number, Life: number }
type CrackLine = { Part: BasePart, Reveal: number }
type Show = {
	Start: number, -- os.clock() when the white screen comes on
	Landing: Vector3,
	Entry: Vector3,
	Seed: number,
	Done: { [string]: boolean },
	Gui: ScreenGui?,
	White: Frame?,
	Crack: Model?,
	Lines: { CrackLine },
	Hole: BasePart?,
	Rim: BasePart?,
	Rock: Model?,
	Plasma: { BasePart },
	Tail: { BasePart },
	Circle: BasePart?,
	Spin: Vector3,
	Kick: number, -- the impact shake (fades)
	KickAt: number,
}

local folder: Folder
local soundFolder: Folder
local sounds: { [string]: { Sound } } = {}
local current: Show? = nil
local pieces: { Piece } = {}
local rng = Random.new()

local function part(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, parent: Instance?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Parent = parent or folder
	return p
end

local function play(name: string, volume: number)
	local list = sounds[name]
	if list then
		for _, s in list do
			s.Volume = volume
			s.TimePosition = 0
			s:Play()
		end
	end
end

local function stop(name: string)
	local list = sounds[name]
	if list then
		for _, s in list do
			s:Stop()
		end
	end
end

-- A ring bursting out along the ground.
local function ring(at: Vector3, radius: number, color: Color3, duration: number, height: number?)
	local disc = part("Shockwave", Vector3.new(0.4, radius * 0.25, radius * 0.25), CFrame.new(at + Vector3.new(0, height or 0.4, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon)
	disc.Shape = Enum.PartType.Cylinder
	disc.Transparency = 0.15
	TweenService:Create(disc, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.4, radius * 2, radius * 2), Transparency = 1 }):Play()
	task.delay(duration + 0.1, function()
		disc:Destroy()
	end)
end

-- Something flying off on its own (pieces of sky, broken rock): falls, spins and fades.
local function fling(p: BasePart, velocity: Vector3, life: number)
	table.insert(pieces, { Part = p, Velocity = velocity, Spin = rng:NextUnitVector() * rng:NextNumber(1, 4), Born = os.clock(), Life = life })
end

local function closeness(at: Vector3, range: number): number
	local camera = workspace.CurrentCamera
	if not camera then
		return 0
	end
	return math.clamp(1 - (camera.CFrame.Position - at).Magnitude / range, 0, 1)
end

--------------------------------------------------------------------------------
-- The white screen
--------------------------------------------------------------------------------
local function whiteScreen(show: Show)
	local player = Players.LocalPlayer
	local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "MeteorFlash"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.DisplayOrder = 95 -- over everything
	local white = Instance.new("Frame")
	white.Name = "White"
	white.Size = UDim2.fromScale(1, 1)
	white.BackgroundColor3 = WHITE
	white.BackgroundTransparency = 1
	white.BorderSizePixel = 0
	white.Parent = gui
	gui.Parent = playerGui
	show.Gui, show.White = gui, white
end

-- How see-through the white screen is, `t` seconds into the show (it snaps on, stays 2 seconds, and
-- fades away while the shaking starts). Later it flashes again, softer, when the meteor hits.
local function whiteness(show: Show, t: number): number
	local amount = 0
	if t >= 0 and t < Meteor.FLASH then
		amount = math.min(1, t / 0.12)
	elseif t >= Meteor.FLASH and t < Meteor.FLASH + 0.6 then
		amount = 1 - (t - Meteor.FLASH) / 0.6
	end
	-- the meteor bursting through the sky, and hitting the ground
	if t >= Meteor.FALL_AT and t < Meteor.FALL_AT + 0.35 then
		amount = math.max(amount, 0.35 * (1 - (t - Meteor.FALL_AT) / 0.35))
	end
	if t >= Meteor.IMPACT_AT and t < Meteor.IMPACT_AT + 0.6 then
		amount = math.max(amount, (0.25 + 0.55 * closeness(show.Landing, 700)) * (1 - (t - Meteor.IMPACT_AT) / 0.6))
	end
	return 1 - amount
end

--------------------------------------------------------------------------------
-- The sky cracking open
--------------------------------------------------------------------------------
-- A jagged crack line from `a` to `b` (in the crack's own flat plane), with a soft glow round it.
local function crackLine(show: Show, model: Model, frame: CFrame, a: Vector2, b: Vector2, width: number, reveal: number)
	local from = frame:PointToWorldSpace(Vector3.new(a.X, a.Y, 0))
	local to = frame:PointToWorldSpace(Vector3.new(b.X, b.Y, 0))
	local length = (to - from).Magnitude
	if length < 1 then
		return
	end
	local cf = CFrame.lookAt((from + to) / 2, to, frame.LookVector)
	local core = part("Crack", Vector3.new(width, width, length + width), cf, if width > 4 then WHITE else rgb(235, 215, 255), Enum.Material.Neon, model)
	core.Transparency = 1
	table.insert(show.Lines, { Part = core, Reveal = reveal })
	local glow = part("CrackGlow", Vector3.new(width * 3.2, width * 3.2, length + width * 2), cf, if #show.Lines % 4 == 1 then PINK else VIOLET, Enum.Material.Neon, model)
	glow.Transparency = 1
	table.insert(show.Lines, { Part = glow, Reveal = reveal + 0.05 })
end

local function skyShards(show: Show, count: number, from: Vector3, spread: number, frame: CFrame)
	for _ = 1, count do
		local angle = rng:NextNumber(0, TAU)
		local offset = frame:VectorToWorldSpace(Vector3.new(math.cos(angle), math.sin(angle), 0)) * rng:NextNumber(0.2, 1) * spread
		local size = rng:NextNumber(18, 48)
		local wedge = Instance.new("WedgePart")
		wedge.Name = "SkyShard"
		wedge.Anchored = true
		wedge.CanCollide = false
		wedge.CanQuery = false
		wedge.CanTouch = false
		wedge.CastShadow = false
		wedge.Size = Vector3.new(2, size, size * rng:NextNumber(0.5, 1.1))
		wedge.CFrame = CFrame.new(from + offset) * CFrame.Angles(rng:NextNumber(0, TAU), rng:NextNumber(0, TAU), rng:NextNumber(0, TAU))
		-- (glowing pieces of sky, so they show against the dark storm sky)
		wedge.Color = SKY_GLASS[rng:NextInteger(1, #SKY_GLASS)]
		wedge.Material = Enum.Material.Neon
		wedge.Transparency = 0.2
		wedge.Parent = folder
		local velocity = offset.Unit * rng:NextNumber(40, 110) + frame.LookVector * rng:NextNumber(20, 80) + Vector3.new(0, rng:NextNumber(-40, 20), 0)
		fling(wedge, velocity, rng:NextNumber(3.5, 5))
	end
end

local function shatter(show: Show)
	local camera = workspace.CurrentCamera
	local eye = if camera then camera.CFrame.Position else show.Landing + Vector3.new(0, 20, -400)
	-- the crack is a flat star of broken glass, turned to face you
	local frame = CFrame.lookAt(show.Entry, eye)
	local model = Instance.new("Model")
	model.Name = "SkyCrack"
	local r = Random.new(show.Seed)
	local rays = 10
	local rings: { { Vector2 } } = { {}, {} }
	for i = 1, rays do
		local angle = i / rays * TAU + r:NextNumber(-0.18, 0.18)
		local reach = CRACK_RADIUS * r:NextNumber(0.7, 1.15)
		local point = Vector2.zero
		local steps = 4
		for step = 1, steps do
			local bend = angle + r:NextNumber(-0.35, 0.35)
			local nextPoint = Vector2.new(math.cos(bend), math.sin(bend)) * reach * step / steps
			crackLine(show, model, frame, point, nextPoint, if step <= 2 then 6 else 4, step * 0.06)
			-- little branches off the main crack
			if step >= 2 and r:NextNumber() < 0.7 then
				local side = if r:NextNumber() < 0.5 then 1 else -1
				local branch = bend + side * r:NextNumber(0.5, 0.9)
				crackLine(show, model, frame, nextPoint, nextPoint + Vector2.new(math.cos(branch), math.sin(branch)) * reach * r:NextNumber(0.15, 0.3), 2.5, step * 0.06 + 0.1)
			end
			if step == 1 or step == 3 then
				table.insert(rings[if step == 1 then 1 else 2], nextPoint)
			end
			point = nextPoint
		end
	end
	-- rings of cracks joining the rays up, like a smashed window
	for ringIndex, points in rings do
		for i, a in points do
			local b = points[i % #points + 1]
			local middle = (a + b) / 2 * r:NextNumber(0.85, 1.1)
			crackLine(show, model, frame, a, middle, 3, 0.2 + ringIndex * 0.08)
			crackLine(show, model, frame, middle, b, 3, 0.24 + ringIndex * 0.08)
		end
	end
	-- the hole it bursts out of (opens when it comes through), with a burning edge
	local face = frame * CFrame.Angles(0, math.pi / 2, 0) -- (a cylinder's round faces point along its X)
	local rim = part("HoleRim", Vector3.new(1.5, 1, 1), face * CFrame.new(-1, 0, 0), PINK, Enum.Material.Neon, model)
	rim.Shape = Enum.PartType.Cylinder
	rim.Transparency = 1
	local hole = part("Hole", Vector3.new(2, 1, 1), face, rgb(6, 0, 16), Enum.Material.SmoothPlastic, model)
	hole.Shape = Enum.PartType.Cylinder
	hole.Transparency = 1
	local light = Instance.new("PointLight")
	light.Color = VIOLET
	light.Range = 60
	light.Brightness = 10
	light.Parent = rim
	model.Parent = folder
	show.Crack, show.Hole, show.Rim = model, hole, rim
	skyShards(show, 10, show.Entry, CRACK_RADIUS * 0.7, frame)
	play("Shatter", 1.4)
end

--------------------------------------------------------------------------------
-- The fall
--------------------------------------------------------------------------------
local function emitter(parent: BasePart, texture: string, colors: ColorSequence, size: number, rate: number, life: number, emission: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = colors
	e.LightEmission = emission
	e.Rate = rate
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.Speed = NumberRange.new(4, 14)
	e.SpreadAngle = Vector2.new(30, 30)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 2.2) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.RotSpeed = NumberRange.new(-90, 90)
	e.Parent = parent
	return e
end

local function startFall(show: Show)
	local rock = Meteor.BuildRock(Meteor.SIZE, show.Seed)
	local core = rock.PrimaryPart :: BasePart
	-- burning: two glowing shells of plasma round it, fire and smoke pouring off it, and a light
	type Shell = { Name: string, Scale: number, Color: Color3, Transparency: number }
	local shells: { Shell } = {
		{ Name = "Plasma", Scale = 1.3, Color = FIRE, Transparency = 0.55 },
		{ Name = "PlasmaOuter", Scale = 1.6, Color = PINK, Transparency = 0.78 },
	}
	for _, info in shells do
		local shell = part(info.Name, Vector3.one * Meteor.SIZE * info.Scale, CFrame.identity, info.Color, Enum.Material.Neon)
		shell.Shape = Enum.PartType.Ball
		shell.Transparency = info.Transparency
		table.insert(show.Plasma, shell)
	end
	emitter(core, "rbxasset://textures/particles/fire_main.dds", ColorSequence.new(HOT, FIRE), Meteor.SIZE * 0.55, 70, 1.1, 1)
	emitter(core, "rbxasset://textures/particles/fire_main.dds", ColorSequence.new(PINK, VIOLET), Meteor.SIZE * 0.45, 40, 1.4, 1)
	emitter(core, "rbxasset://textures/particles/smoke_main.dds", ColorSequence.new(rgb(90, 70, 110), rgb(40, 30, 60)), Meteor.SIZE * 0.6, 30, 2.4, 0)
	emitter(core, "rbxasset://textures/particles/sparkles_main.dds", ColorSequence.new(WHITE, CYAN), 3, 60, 1.2, 1)
	local light = Instance.new("PointLight")
	light.Color = FIRE
	light.Range = 60
	light.Brightness = 8
	light.Parent = core
	rock:PivotTo(CFrame.new(show.Entry))
	rock.Parent = folder
	show.Rock = rock
	-- its trail of fire, back up the sky the way it came
	show.Tail = {
		part("Tail", Vector3.new(Meteor.SIZE * 0.75, Meteor.SIZE * 0.75, 1), CFrame.new(show.Entry), FIRE, Enum.Material.Neon),
		part("TailGlow", Vector3.new(Meteor.SIZE * 1.3, Meteor.SIZE * 1.3, 1), CFrame.new(show.Entry), VIOLET, Enum.Material.Neon),
	}
	show.Tail[1].Transparency = 0.35
	show.Tail[2].Transparency = 0.7
	-- where it's going to hit
	local circle = part("Warning", Vector3.new(0.3, Meteor.CRATER * 0.4, Meteor.CRATER * 0.4), CFrame.new(show.Landing + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), rgb(255, 70, 160), Enum.Material.Neon)
	circle.Shape = Enum.PartType.Cylinder
	circle.Transparency = 0.4
	show.Circle = circle
	-- the sky bursts open round it
	if show.Crack then
		skyShards(show, 8, show.Entry, HOLE_RADIUS, CFrame.lookAt(show.Entry, show.Landing))
	end
	play("Fall", 1.3)
end

-- Where the meteor is `a` of the way down (0..1): it speeds up all the way.
local function fallPosition(show: Show, a: number): Vector3
	local eased = a * 0.3 + a * a * 0.7
	return show.Entry:Lerp(show.Landing + Vector3.new(0, Meteor.SIZE * 0.35, 0), eased)
end

--------------------------------------------------------------------------------
-- The impact
--------------------------------------------------------------------------------
local function impact(show: Show)
	local at = show.Landing
	if show.Rock then
		show.Rock:Destroy()
	end
	if show.Circle then
		show.Circle:Destroy()
	end
	for _, list in { show.Plasma, show.Tail } do
		for _, p in list do
			p:Destroy()
		end
		table.clear(list)
	end
	show.Rock, show.Circle = nil, nil
	stop("Fall")
	play("Impact", 1.6)
	-- an explosion (just the look: it can't hurt anyone) and a fireball swelling up
	for i = 0, 2 do
		local boom = Instance.new("Explosion")
		boom.BlastPressure = 0
		boom.BlastRadius = 24
		boom.DestroyJointRadiusPercent = 0
		boom.ExplosionType = Enum.ExplosionType.NoCraters
		boom.Position = at + Vector3.new(math.cos(i * 2.1) * 10, 4 + i * 6, math.sin(i * 2.1) * 10)
		boom.Parent = folder
	end
	local fireball = part("Fireball", Vector3.one * Meteor.SIZE, CFrame.new(at + Vector3.new(0, 6, 0)), HOT, Enum.Material.Neon)
	fireball.Shape = Enum.PartType.Ball
	fireball.Transparency = 0.1
	TweenService:Create(fireball, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.one * Meteor.CRATER * 2.4, Transparency = 1, Color = PINK }):Play()
	-- a beam of cosmic light shooting up out of it
	local beam = part("Beam", Vector3.new(500, 22, 22), CFrame.new(at + Vector3.new(0, 250, 0)) * CFrame.Angles(0, 0, math.pi / 2), rgb(220, 190, 255), Enum.Material.Neon)
	beam.Shape = Enum.PartType.Cylinder
	beam.Transparency = 0.1
	TweenService:Create(beam, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = Vector3.new(500, 2, 2), Transparency = 1 }):Play()
	-- shock waves racing out along the ground
	ring(at, Meteor.CRATER * 4.5, WHITE, 1.1)
	ring(at, Meteor.CRATER * 3, VIOLET, 0.9, 0.6)
	ring(at, Meteor.CRATER * 1.8, FIRE, 0.6, 0.8)
	ring(at, Meteor.CRATER * 6, rgb(200, 175, 150), 1.6, 0.3) -- (dust)
	-- broken rock flying everywhere
	local r = Random.new(show.Seed + 99)
	for i = 1, 16 do
		local angle = i / 16 * TAU + r:NextNumber(-0.2, 0.2)
		local chunk = r:NextNumber(3, 7)
		local glow = i % 4 == 0
		local p = part("Debris", Vector3.new(chunk, chunk * 0.8, chunk), CFrame.new(at + Vector3.new(0, 6, 0)), if glow then VIOLET else rgb(60, 46, 74), if glow then Enum.Material.Neon else Enum.Material.Slate)
		fling(p, Vector3.new(math.cos(angle), 0, math.sin(angle)) * r:NextNumber(50, 130) + Vector3.new(0, r:NextNumber(70, 150), 0), r:NextNumber(1.8, 2.6))
	end
	-- the ground shakes: hard right there, still a good jolt from the other end of the map
	show.Kick = 1.2 + 4.5 * closeness(at, IMPACT_RANGE)
	show.KickAt = os.clock()
	task.delay(1.5, function()
		fireball:Destroy()
		beam:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- Every frame
--------------------------------------------------------------------------------
local function clearShow(show: Show)
	local items: { Instance? } = { show.Gui, show.Crack, show.Rock, show.Circle }
	for _, item in items do
		if item then
			item:Destroy()
		end
	end
	for _, list in { show.Plasma, show.Tail } do
		for _, p in list do
			p:Destroy()
		end
	end
	stop("Fall")
	if current == show then
		current = nil
	end
end

local function shakeAmount(show: Show, t: number): number
	local amount = 0
	if t >= Meteor.SHAKE_AT and t < Meteor.SHAKE_AT + Meteor.SHAKE then
		-- slams in, then slowly settles to half
		local a = (t - Meteor.SHAKE_AT) / Meteor.SHAKE
		amount = SHAKE_HARD * (if a < 0.08 then a / 0.08 else 1 - (a - 0.08) * 0.55)
	end
	if t >= Meteor.FALL_AT and t < Meteor.IMPACT_AT then
		-- a rumble growing as it comes down
		local a = (t - Meteor.FALL_AT) / Meteor.FALL
		amount = math.max(amount, 0.5 + 1.6 * a * a)
	end
	if show.Kick > 0 then
		local since = os.clock() - show.KickAt
		amount = math.max(amount, show.Kick * math.max(0, 1 - since / 1.8))
	end
	return amount
end

local function update(dt: number)
	local now = os.clock()
	-- flying pieces (sky glass, rock): fall, spin and fade
	for i = #pieces, 1, -1 do
		local piece = pieces[i]
		local age = now - piece.Born
		if age > piece.Life or not piece.Part.Parent then
			piece.Part:Destroy()
			table.remove(pieces, i)
		else
			piece.Velocity += GRAVITY * 0.35 * dt
			local cf = piece.Part.CFrame
			piece.Part.CFrame = (cf + piece.Velocity * dt) * CFrame.fromAxisAngle(piece.Spin.Unit, piece.Spin.Magnitude * dt)
			local fade = math.clamp((age - piece.Life * 0.6) / (piece.Life * 0.4), 0, 1)
			if fade > 0 then
				piece.Part.Transparency = math.max(piece.Part.Transparency, fade)
			end
		end
	end
	local show = current
	if not show then
		return
	end
	local t = now - show.Start
	local done = show.Done
	-- what happens when (in order, so a late start still catches up)
	if not done.Flash and t >= 0 then
		done.Flash = true
		if t < Meteor.FLASH then
			play("Flash", 1.5)
		end
	end
	if not done.Shatter and t >= Meteor.SHATTER_AT then
		done.Shatter = true
		shatter(show)
	end
	if not done.Fall and t >= Meteor.FALL_AT then
		done.Fall = true
		startFall(show)
	end
	if not done.Impact and t >= Meteor.IMPACT_AT then
		done.Impact = true
		impact(show)
	end
	-- the white screen
	local white = show.White
	if white and white.Parent then
		white.BackgroundTransparency = whiteness(show, t)
	end
	-- the crack spreading across the sky, then glowing, then closing up again (its lines are
	-- only touched while it spreads and while it fades: there are a lot of them)
	local crackAge = t - Meteor.SHATTER_AT
	if show.Crack and crackAge >= 0 then
		local gone = math.clamp((t - Meteor.IMPACT_AT - 3) / 2.5, 0, 1)
		local flicker = 0.08 * math.sin(now * 23)
		if crackAge < 0.8 or gone > 0 then
			for _, line in show.Lines do
				local shown = math.clamp((crackAge - line.Reveal) / 0.12, 0, 1)
				local base = if line.Part.Name == "CrackGlow" then 0.55 else 0
				line.Part.Transparency = 1 - shown + shown * math.clamp(base + gone, 0, 1)
			end
		end
		-- the hole tears open as the meteor comes through
		local open = math.clamp((t - Meteor.FALL_AT + 0.25) / 0.5, 0, 1) * (1 - gone)
		local hole, rim = show.Hole, show.Rim
		if hole and rim then
			local radius = math.max(1, HOLE_RADIUS * open)
			hole.Size = Vector3.new(2, radius * 2, radius * 2)
			rim.Size = Vector3.new(1.5, radius * 2.35, radius * 2.35)
			hole.Transparency = if open > 0 then 0 else 1
			rim.Transparency = if open > 0 then 0.05 + flicker else 1
		end
		if gone >= 1 then
			show.Crack:Destroy()
			show.Crack, show.Hole, show.Rim = nil, nil, nil
			table.clear(show.Lines)
		end
	end
	-- the meteor coming down, and its tail
	local rock = show.Rock
	if rock then
		local a = math.clamp((t - Meteor.FALL_AT) / Meteor.FALL, 0, 1)
		local position = fallPosition(show, a)
		rock:PivotTo(CFrame.new(position) * CFrame.fromAxisAngle(show.Spin, (t - Meteor.FALL_AT) * 2.2))
		for i, shell in show.Plasma do
			shell.CFrame = CFrame.new(position)
			shell.Transparency = (if i == 1 then 0.55 else 0.78) + 0.08 * math.sin(now * 30 + i)
		end
		local back = (show.Entry - position)
		local length = math.min(back.Magnitude, 420)
		if length > 1 then
			local tailEnd = position + back.Unit * length
			for i, tail in show.Tail do
				local width = Meteor.SIZE * (if i == 1 then 0.75 else 1.3)
				tail.Size = Vector3.new(width, width, length)
				tail.CFrame = CFrame.lookAt((position + tailEnd) / 2, position)
			end
		end
		local circle = show.Circle
		if circle then
			local grow = (0.4 + 0.9 * a) * Meteor.CRATER
			circle.Size = Vector3.new(0.3, grow, grow)
			circle.Transparency = 0.3 + 0.35 * math.abs(math.sin(now * (5 + a * 16)))
		end
	end
	if show.Gui and t > Meteor.IMPACT_AT + 1 then
		show.Gui:Destroy()
		show.Gui, show.White = nil, nil
	end
	if t > Meteor.IMPACT_AT + 8 then
		clearShow(show)
	end
end

local function onMeteor(info: any)
	if type(info) ~= "table" or typeof(info.Position) ~= "Vector3" or type(info.StartAt) ~= "number" then
		return
	end
	local start = os.clock() + (info.StartAt - workspace:GetServerTimeNow())
	if os.clock() - start > Meteor.IMPACT_AT + 1 then
		return -- (you joined after it already hit: the crater's there)
	end
	if current then
		clearShow(current)
	end
	local landing = info.Position :: Vector3
	local seed = if type(info.Seed) == "number" then info.Seed else 1
	local show: Show = {
		Start = start,
		Landing = landing,
		Entry = landing + Meteor.ENTRY,
		Seed = seed,
		Done = {},
		Lines = {},
		Plasma = {},
		Tail = {},
		Spin = Random.new(seed):NextUnitVector(),
		Kick = 0,
		KickAt = 0,
	}
	whiteScreen(show)
	current = show
end

--------------------------------------------------------------------------------
-- The Cosmic Donut's horizon (the one floating over the forge)
--------------------------------------------------------------------------------
type Ring = { Weld: Weld, Base: CFrame, Pivot: CFrame, Axis: Vector3, Spin: number }
local horizons: { [Model]: { Ring } } = {}

local function addHorizon(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	local rings: { Ring } = {}
	for _, p in instance:GetDescendants() do
		if p:IsA("BasePart") and p:GetAttribute("Limb") == "Horizon" then
			local weld = p:FindFirstChildOfClass("Weld")
			local axis = p:GetAttribute("Axis")
			local pivot = p:GetAttribute("Pivot")
			local spin = p:GetAttribute("Spin")
			if weld and typeof(axis) == "Vector3" then
				table.insert(rings, {
					Weld = weld,
					Base = weld.C0,
					Pivot = CFrame.new(if typeof(pivot) == "Vector3" then pivot else Vector3.zero),
					Axis = axis,
					Spin = if type(spin) == "number" then spin else 1,
				})
			end
		end
	end
	if #rings > 0 then
		horizons[instance] = rings
	end
end

local function spinHorizons()
	local now = os.clock()
	for model, rings in horizons do
		if not model.Parent then
			horizons[model] = nil
			continue
		end
		for _, ringInfo in rings do
			local rotation = CFrame.fromAxisAngle(ringInfo.Axis, (now * ringInfo.Spin) % TAU)
			ringInfo.Weld.C0 = ringInfo.Pivot * rotation * ringInfo.Pivot:Inverse() * ringInfo.Base
		end
	end
end

function MeteorFX.Init()
	folder = Instance.new("Folder")
	folder.Name = "MeteorFXLocal"
	folder.Parent = workspace
	-- the sounds are made now, so they've loaded by the time a meteor comes
	soundFolder = Instance.new("Folder")
	soundFolder.Name = "MeteorSounds"
	soundFolder.Parent = SoundService
	local ids = Config.CosmicDonut.Sounds
	local lists: { [string]: { string } } = { Flash = { ids.Flash }, Shatter = { ids.Shatter }, Fall = { ids.Fall }, Impact = ids.Impact }
	for name, list in lists do
		sounds[name] = {}
		for i, id in list do
			local s = Instance.new("Sound")
			s.Name = name .. i
			s.SoundId = id
			s.Parent = soundFolder
			table.insert(sounds[name], s)
		end
	end
	Remotes.Event("Meteor").OnClientEvent:Connect(onMeteor)
	for _, instance in CollectionService:GetTagged("HorizonSpin") do
		task.spawn(addHorizon, instance)
	end
	CollectionService:GetInstanceAddedSignal("HorizonSpin"):Connect(addHorizon)
	RunService.RenderStepped:Connect(update)
	RunService.RenderStepped:Connect(spinHorizons)
	-- the shaking (after the camera has moved, so it never builds up)
	RunService:BindToRenderStep("MeteorShake", Enum.RenderPriority.Camera.Value + 2, function()
		local show = current
		local camera = workspace.CurrentCamera
		if not show or not camera then
			return
		end
		local now = os.clock()
		local strength = shakeAmount(show, now - show.Start)
		if strength <= 0 then
			return
		end
		camera.CFrame *= CFrame.Angles(math.noise(now * 22, 1.3) * 0.022 * strength, math.noise(now * 22, 4.7) * 0.022 * strength, math.noise(now * 18, 8.2) * 0.012 * strength)
			+ Vector3.new(math.noise(now * 28, 9.1), math.noise(now * 28, 2.2), 0) * 0.55 * strength
	end)
end

return MeteorFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">ParticleBudget</string>
            <string name="Source"><![CDATA[--[[
	ParticleBudget: fewer particles everywhere, on this player's screen only (less lag).

	Every ParticleEmitter in the game (donut auras, decorations, effects, pets...) emits
	Config.Particles.ParticleScale of its normal rate, and never more than MaxParticleRate per second.
	(The flames, spirals and smoke of the rarest donuts - FXBoost - get more: see below.)
	If a script changes an emitter's Rate later, the new rate is scaled the same way.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local ParticleBudget = {}

local scaling: { [ParticleEmitter]: boolean } = setmetatable({}, { __mode = "k" }) :: any

-- The big mid-to-late game donut effects (emitters with the FXBoost attribute) are allowed more:
-- DonutFX only keeps them switched on for the few donuts closest to you.
local BOOST_SCALE, BOOST_MAX = 0.85, 40

local function scaled(rate: number, boost: boolean): number
	local g = Config.Particles
	if boost then
		return math.min(rate * BOOST_SCALE, BOOST_MAX)
	end
	return math.min(rate * g.ParticleScale, g.MaxParticleRate)
end

local function apply(item: Instance)
	if not item:IsA("ParticleEmitter") then
		return
	end
	local emitter = item
	local function rescale()
		if scaling[emitter] then
			return
		end
		scaling[emitter] = true
		emitter.Rate = scaled(emitter.Rate, emitter:GetAttribute("FXBoost") == true)
		scaling[emitter] = nil
	end
	rescale()
	emitter:GetPropertyChangedSignal("Rate"):Connect(rescale)
end

function ParticleBudget.Init()
	for _, root in { workspace, game:GetService("Players").LocalPlayer } do
		for _, item in root:GetDescendants() do
			apply(item)
		end
		root.DescendantAdded:Connect(apply)
	end
end

return ParticleBudget
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">PetFX</string>
            <string name="Source"><![CDATA[--[[
	PetFX: animates pet eggs on this client (see PetModel.BuildEgg):
	  * eggs wobble (more and more as they get close to hatching), ready ones bounce
	  * rune rings orbit, light rays turn
	  * rainbow eggs cycle colours
	  * incubator eggs show a live countdown ("4m 12s" -> "READY! Open Pets 🐾")
	Only eggs near the camera are animated.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Format = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Format"))

local PetFX = {}

local RANGE = 160

type Spinner = { Weld: Weld, Base: CFrame, Speed: number, AxisZ: boolean }
type Egg = {
	Model: Model,
	Root: BasePart,
	Base: CFrame,
	Phase: number,
	Spinners: { Spinner },
	Rainbow: { BasePart },
	Countdown: TextLabel?,
}

local eggs: { [Instance]: Egg } = {}

local function register(instance: Instance)
	if not instance:IsA("Model") or eggs[instance] then
		return
	end
	local root = instance.PrimaryPart or instance:WaitForChild("Root", 5)
	if not root or not root:IsA("BasePart") then
		return
	end
	local spinners: { Spinner } = {}
	local rainbow: { BasePart } = {}
	for _, part in instance:GetDescendants() do
		if part:IsA("BasePart") then
			local speed = part:GetAttribute("Spin")
			local weld = part:FindFirstChildOfClass("Weld")
			if type(speed) == "number" and weld then
				table.insert(spinners, { Weld = weld, Base = weld.C0, Speed = speed, AxisZ = part.Name == "Rays" })
			end
			if instance:GetAttribute("Rainbow") and (part.Name == "Crack" or part.Name == "Spot" or part.Name == "Rune") then
				table.insert(rainbow, part)
			end
		end
	end
	local timer = root:FindFirstChild("EggTimer")
	local countdown = timer and timer:FindFirstChild("Countdown")
	eggs[instance] = {
		Model = instance,
		Root = root,
		Base = root.CFrame,
		Phase = math.random() * 6,
		Spinners = spinners,
		Rainbow = rainbow,
		Countdown = if countdown and countdown:IsA("TextLabel") then countdown else nil,
	}
end

function PetFX.Init()
	for _, instance in CollectionService:GetTagged("PetEgg") do
		task.spawn(register, instance)
	end
	CollectionService:GetInstanceAddedSignal("PetEgg"):Connect(function(instance)
		task.wait() -- let its children (the countdown label) arrive
		register(instance)
	end)
	CollectionService:GetInstanceRemovedSignal("PetEgg"):Connect(function(instance)
		eggs[instance] = nil
	end)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local now = workspace:GetServerTimeNow()
		local camera = workspace.CurrentCamera
		local cam = if camera then camera.CFrame.Position else Vector3.zero
		for instance, egg in eggs do
			if not instance.Parent then
				eggs[instance] = nil
				continue
			end
			if (egg.Root.Position - cam).Magnitude > RANGE then
				continue
			end
			local hatchAt = instance:GetAttribute("HatchAt")
			local left = if type(hatchAt) == "number" then hatchAt - now else nil
			if egg.Root.Anchored then
				-- Wobble: gentle normally, frantic in the last minute, bouncing when ready
				local strength = 0.08
				local speed = 2.2
				local lift = math.sin(t * 1.6 + egg.Phase) * 0.15
				if left and left <= 0 then
					strength, speed = 0.18, 9
					lift = math.abs(math.sin(t * 5 + egg.Phase)) * 0.6
				elseif left and left < 60 then
					strength, speed = 0.14, 7
				end
				egg.Root.CFrame = egg.Base * CFrame.new(0, lift, 0) * CFrame.Angles(math.sin(t * speed + egg.Phase) * strength, t * 0.3, math.cos(t * speed * 0.8 + egg.Phase) * strength)
			end
			for _, spinner in egg.Spinners do
				local angle = t * spinner.Speed
				spinner.Weld.C0 = spinner.Base * (if spinner.AxisZ then CFrame.Angles(0, 0, angle) else CFrame.Angles(0, angle, 0))
			end
			if #egg.Rainbow > 0 then
				for i, part in egg.Rainbow do
					part.Color = Color3.fromHSV((t * 0.3 + i * 0.08) % 1, 0.8, 1)
				end
			end
			if egg.Countdown and left then
				if left <= 0 then
					egg.Countdown.Text = "READY! Open Pets 🐾"
					egg.Countdown.TextColor3 = Color3.fromRGB(120, 255, 130)
				else
					egg.Countdown.Text = "⏳ " .. Format.Duration(left)
					egg.Countdown.TextColor3 = Color3.fromRGB(255, 255, 255)
				end
			end
		end
	end)
end

return PetFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--[[
	Client-side view of the local player's state.
	Numbers come from Player attributes (Money, Speed, Income...); tables come from the State remote.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local player = Players.LocalPlayer :: Player

export type Snapshot = {
	Passes: { [string]: boolean },
	OwnedSkins: { [string]: boolean },
	EquippedSkin: string,
	Discovered: { [string]: boolean },
	DiscoveredMutations: { [string]: { [string]: boolean } }?,
	IndexClaims: { [string]: string }?,
	OwnedTrails: { [string]: boolean }?,
	EquippedTrail: string?,
	PodiumMode: string,
	MusicVolume: number?,
	MusicOn: boolean?,
	Items: { [string]: boolean }?,
	PlotIndex: number?,
	Eggs: { { Uid: string, Id: string, HatchAt: number } }?,
	Pets: { { Uid: string, Id: string } }?,
	EquippedPets: { string }?,
	Favorite: string?, -- slot key of your favourite donut
	Donated: number?,
	HiddenItems: { [string]: boolean }?, -- items taken off the hotbar
	SeenTutorial: boolean?,
	SeenUpdate: number?,
	NotesOnLogin: boolean?,
	TutorialEggClaimed: boolean?,
	Admin: boolean?,
	GodMode: boolean?,
	MeteorShards: number?, -- for The Cosmic Donut (UI/CosmicForge)
}

local State = {}

State.Data = {
	Passes = {},
	OwnedSkins = { Classic = true },
	EquippedSkin = "Classic",
	Discovered = {},
	PodiumMode = "Rarest",
	PlotIndex = nil,
	Eggs = {},
	Pets = {},
	EquippedPets = {},
} :: Snapshot

State.Changed = Signal.new()

function State.Get(name: string): any
	return player:GetAttribute(name)
end

function State.Number(name: string): number
	local value = player:GetAttribute(name)
	return if type(value) == "number" then value else 0
end

function State.OnAttribute(name: string, callback: (any) -> ())
	player:GetAttributeChangedSignal(name):Connect(function()
		callback(player:GetAttribute(name))
	end)
	callback(player:GetAttribute(name))
end

function State.Action(name: string, arg: any?)
	Remotes.Event("Action"):FireServer(name, arg)
end

Remotes.Event("State").OnClientEvent:Connect(function(snapshot: Snapshot)
	State.Data = snapshot
	State.Changed:Fire(snapshot)
end)

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">StormFX</string>
            <string name="Source"><![CDATA[--[[
	StormFX: what everyone sees and hears during the Eternal Storm (EventService / Config.EternalStorm).

	  * the sky: the server hangs a giant black hole over every world (BlackHoleFX animates it); here
	    the whole picture turns a dark, stormy purple and the Radetzky March plays (Settings)
	  * falling rocks (StormBlock): a huge grassy chunk of rock appears high in the sky and plunges
	    down, with a glowing purple circle on the ground showing where it'll land - get out of it!
	    It smashes into the ground with an explosion, a ring of dust, broken rock and a crater, and
	    shakes the screen of everyone close by (the server flings anyone it lands on)
	  * purple lightning (StormStrike): a giant bolt from the sky onto a donut, which turns ETERNAL
	  * and smaller purple bolts flickering down all around you while it lasts
	  * shooting stars streaking across the sky
	  * the cosmic sky (Config.EternalStorm.Sky, made in Blender - art/eternal_sky), once its images
	    are uploaded: the whole sky turns into space with a galaxy band, slowly turning, and a giant
	    black hole hangs high in front of you wherever you go (its disk spinning, the light bent
	    round it always facing you), with a spinning galaxy behind you
	The server decides where rocks land and which donuts are struck; everything here is just the
	look, made on this client only.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local StormFX = {}

local rgb = Color3.fromRGB
local TAU = math.pi * 2
local SKY_HEIGHT = 340 -- rocks start this high above the ground
local PURPLE, LIGHT_PURPLE, WHITE = rgb(170, 60, 255), rgb(225, 180, 255), rgb(255, 255, 255)

type Rock = { Model: Model, Circle: BasePart, Target: Vector3, Size: number, Start: number, Fall: number, Spin: Vector3, Drift: Vector3 }
type Fading = { Parts: { BasePart }, Until: number }
type Bolt = { Parts: { BasePart }, Light: PointLight?, Born: number, Life: number }

local folder: Folder
local grade: ColorCorrectionEffect
local active = false
local rng = Random.new()
local rocks: { Rock } = {}
local fading: { Fading } = {}
local bolts: { Bolt } = {}
local flash = 0
local dim = 0 -- how dark the storm makes everything (eases in and out)
local shakeUntil, shakeStrength = 0, 0
local nextAmbient = 0
local nextComet = 0
local setMusic: ((boolean) -> ())? = nil
type Comet = { Part: BasePart, Velocity: Vector3, Born: number }
local comets: { Comet } = {}

-- The cosmic sky. Distances in studs from your camera, angles in degrees: the black hole hangs
-- down the lane (+Z, the way you run out of the lobby) and up in the sky, the galaxy behind you.
local STORM = Config.EternalStorm
local FACES = { "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }
local HOLE_DISTANCE, HOLE_ELEVATION = 1250, 28
local CORE_RADIUS = 190 -- the shadow
local DISK_SIZE = 2048 -- (as big as a part can be)
local DISK_VIEW = 12 -- how far above its edge you see the disk from
local HALO_RING = 0.3 -- where the photon ring is in the halo image (radius / half its size)
local GALAXY_DISTANCE, GALAXY_ELEVATION, GALAXY_SIZE = 1700, 35, 1600
type Placed = { Part: BasePart, Offset: CFrame }
type Spinner = { Image: ImageLabel, Speed: number }
local cosmos: Folder? = nil
local placed: { Placed } = {}
local spinners: { Spinner } = {}
type SavedSky = { Storm: Sky, Original: Sky? }
local savedSky: SavedSky? = nil
local skyTurn = 0

local function part(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, parent: Instance?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Parent = parent or folder
	return p
end

local function sound(at: Vector3, id: string, speed: number, volume: number, range: number)
	local holder = part("Sound", Vector3.one, CFrame.new(at), WHITE, Enum.Material.SmoothPlastic)
	holder.Transparency = 1
	local s = Instance.new("Sound")
	s.SoundId = id
	s.PlaybackSpeed = speed
	s.Volume = volume
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 30
	s.RollOffMaxDistance = range
	s.Parent = holder
	s:Play()
	task.delay(4, function()
		holder:Destroy()
	end)
end

local function thunder(at: Vector3, big: boolean)
	sound(at, "rbxasset://sounds/action_falling.mp3", if big then 0.35 else 0.5, if big then 1 else 0.5, if big then 900 else 400)
	sound(at, "rbxasset://sounds/action_jump_land.mp3", 0.3, if big then 1.2 else 0.5, if big then 900 else 400)
end

local function shake(at: Vector3, strength: number, range: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local closeness = 1 - (camera.CFrame.Position - at).Magnitude / range
	if closeness > 0 then
		shakeStrength = math.max(if os.clock() < shakeUntil then shakeStrength else 0, strength * closeness)
		shakeUntil = os.clock() + 0.55
	end
end

-- A jagged bolt of neon from `from` to `to` (with a white-hot core and a couple of branches).
local function bolt(from: Vector3, to: Vector3, width: number, life: number, light: boolean)
	local parts: { BasePart } = {}
	local function line(a: Vector3, b: Vector3, w: number, depth: number)
		local direction = b - a
		local length = direction.Magnitude
		if length < 0.5 then
			return
		end
		local right = direction:Cross(Vector3.yAxis)
		right = if right.Magnitude < 0.01 then Vector3.xAxis else right.Unit
		local up = right:Cross(direction).Unit
		local segments = math.clamp(math.floor(length / 14), 5, 18)
		local previous = a
		for i = 1, segments do
			local point = if i == segments then b else a + direction * (i / segments) + (right * rng:NextNumber(-1, 1) + up * rng:NextNumber(-1, 1)) * length * 0.045
			local step = point - previous
			local cf = CFrame.lookAt(previous + step / 2, point)
			local glow = part("Bolt", Vector3.new(w, w, step.Magnitude + w * 0.4), cf, PURPLE, Enum.Material.Neon)
			table.insert(parts, glow)
			local core = part("BoltCore", Vector3.new(w * 0.4, w * 0.4, step.Magnitude + w * 0.2), cf, WHITE, Enum.Material.Neon)
			table.insert(parts, core)
			if depth < 1 and i > 1 and i < segments and rng:NextNumber() < 0.22 then
				line(point, point + (rng:NextUnitVector() * Vector3.new(1, 0.3, 1)).Unit * length * rng:NextNumber(0.12, 0.25) + Vector3.new(0, -length * 0.08, 0), w * 0.55, depth + 1)
			end
			previous = point
		end
	end
	line(from, to, width, 0)
	local pointLight: PointLight? = nil
	if light and #parts > 0 then
		local glow = Instance.new("PointLight")
		glow.Color = LIGHT_PURPLE
		glow.Range = 60
		glow.Brightness = 6
		glow.Shadows = false
		glow.Parent = parts[#parts]
		pointLight = glow
	end
	table.insert(bolts, { Parts = parts, Light = pointLight, Born = os.clock(), Life = life })
end

-- A ring bursting out along the ground.
local function ring(at: Vector3, radius: number, color: Color3, duration: number)
	local disc = part("Ring", Vector3.new(0.3, radius * 0.3, radius * 0.3), CFrame.new(at + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon)
	disc.Shape = Enum.PartType.Cylinder
	disc.Transparency = 0.2
	TweenService:Create(disc, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.3, radius * 2, radius * 2), Transparency = 1 }):Play()
	task.delay(duration + 0.1, function()
		disc:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- Falling rocks
--------------------------------------------------------------------------------
local ROCK_COLORS = { rgb(150, 115, 90), rgb(128, 100, 82), rgb(170, 132, 100) }
local GRASS = { rgb(120, 210, 56), rgb(106, 196, 48) }

local function buildRock(size: number, seed: number): Model
	local r = Random.new(seed)
	local model = Instance.new("Model")
	model.Name = "StormRock"
	local main = part("Rock", Vector3.new(size, size * 0.65, size * 0.85), CFrame.identity, ROCK_COLORS[r:NextInteger(1, #ROCK_COLORS)], Enum.Material.Slate, model)
	part("Grass", Vector3.new(size * 0.96, 1.6, size * 0.8), CFrame.new(0, size * 0.325 + 0.6, 0), GRASS[r:NextInteger(1, 2)], Enum.Material.Plastic, model)
	-- lumps of rock stuck on all round, and glowing purple cracks (it came out of the black hole)
	for i = 1, 6 do
		local angle = i / 6 * TAU + r:NextNumber(-0.3, 0.3)
		local lump = size * r:NextNumber(0.3, 0.5)
		part("Lump", Vector3.new(lump, lump * 0.8, lump), CFrame.new(math.cos(angle) * size * 0.42, r:NextNumber(-0.3, 0.1) * size, math.sin(angle) * size * 0.36) * CFrame.Angles(r:NextNumber(0, 3), r:NextNumber(0, 3), r:NextNumber(0, 3)), ROCK_COLORS[r:NextInteger(1, #ROCK_COLORS)], Enum.Material.Slate, model)
	end
	for _ = 1, 4 do
		local crack = part("Crack", Vector3.new(0.5, size * r:NextNumber(0.25, 0.5), 0.5), CFrame.new(r:NextNumber(-0.4, 0.4) * size, r:NextNumber(-0.2, 0.15) * size, -size * 0.43) * CFrame.Angles(0, 0, r:NextNumber(-0.8, 0.8)), PURPLE, Enum.Material.Neon, model)
		crack.Transparency = 0.1
	end
	-- a fiery purple trail behind it
	local trail = Instance.new("ParticleEmitter")
	trail.Texture = "rbxasset://textures/particles/fire_main.dds"
	trail.Color = ColorSequence.new(LIGHT_PURPLE, PURPLE)
	trail.LightEmission = 1
	trail.Rate = 40
	trail.Lifetime = NumberRange.new(0.4, 0.8)
	trail.Speed = NumberRange.new(2, 6)
	trail.EmissionDirection = Enum.NormalId.Top
	trail.Size = NumberSequence.new(size * 0.35, size * 0.1)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Parent = main
	model.PrimaryPart = main
	model.Parent = folder
	return model
end

local function onBlock(info: any)
	if type(info) ~= "table" or typeof(info.Position) ~= "Vector3" or type(info.Size) ~= "number" then
		return
	end
	local size, fall = info.Size, (if type(info.Fall) == "number" then info.Fall else 2.6)
	local target = info.Position :: Vector3
	local model = buildRock(size, if type(info.Seed) == "number" then info.Seed else 1)
	local reach = size * 0.6 + 4
	local circle = part("Warning", Vector3.new(0.25, reach * 0.4, reach * 0.4), CFrame.new(target + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.pi / 2), PURPLE, Enum.Material.Neon)
	circle.Shape = Enum.PartType.Cylinder
	circle.Transparency = 0.45
	local drift = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)) * 60
	table.insert(rocks, { Model = model, Circle = circle, Target = target, Size = size, Start = os.clock(), Fall = fall, Spin = rng:NextUnitVector(), Drift = drift })
	model:PivotTo(CFrame.new(target + drift + Vector3.new(0, SKY_HEIGHT, 0)))
end

local function impact(rock: Rock)
	local at, size = rock.Target, rock.Size
	rock.Model:Destroy()
	rock.Circle:Destroy()
	-- the crash: an explosion (just the look: the server does the flinging), a ring of dust,
	-- a dark crater with broken rock round it, and the screen shakes
	local boom = Instance.new("Explosion")
	boom.BlastPressure = 0
	boom.BlastRadius = 0
	boom.DestroyJointRadiusPercent = 0
	boom.ExplosionType = Enum.ExplosionType.NoCraters
	boom.Position = at + Vector3.new(0, 2, 0)
	boom.Parent = folder
	ring(at, size * 1.6, rgb(200, 170, 140), 0.7)
	ring(at, size * 1.1, PURPLE, 0.5)
	thunder(at, false)
	shake(at, 1.4, 220)
	local pieces: { BasePart } = {}
	local crater = part("Crater", Vector3.new(0.3, size * 1.3, size * 1.3), CFrame.new(at + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.pi / 2), rgb(70, 52, 44), Enum.Material.Slate)
	crater.Shape = Enum.PartType.Cylinder
	table.insert(pieces, crater)
	for i = 1, 7 do
		local angle = i / 7 * TAU + rng:NextNumber(-0.3, 0.3)
		local chunk = size * rng:NextNumber(0.18, 0.32)
		local spot = at + Vector3.new(math.cos(angle), 0, math.sin(angle)) * size * rng:NextNumber(0.45, 0.8)
		table.insert(pieces, part("Rubble", Vector3.new(chunk, chunk * 0.7, chunk), CFrame.new(spot + Vector3.new(0, chunk * 0.2, 0)) * CFrame.Angles(rng:NextNumber(-0.6, 0.6), rng:NextNumber(0, 3), rng:NextNumber(-0.6, 0.6)), ROCK_COLORS[rng:NextInteger(1, #ROCK_COLORS)], Enum.Material.Slate))
	end
	local glow = part("CraterGlow", Vector3.new(0.35, size * 0.6, size * 0.6), CFrame.new(at + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.pi / 2), PURPLE, Enum.Material.Neon)
	glow.Shape = Enum.PartType.Cylinder
	glow.Transparency = 0.3
	table.insert(pieces, glow)
	table.insert(fading, { Parts = pieces, Until = os.clock() + 12 })
end

--------------------------------------------------------------------------------
-- Lightning
--------------------------------------------------------------------------------
local function onStrike(info: any)
	if type(info) ~= "table" or typeof(info.Position) ~= "Vector3" then
		return
	end
	local at = info.Position :: Vector3
	local from = at + Vector3.new(rng:NextNumber(-40, 40), 420, rng:NextNumber(-40, 40))
	bolt(from, at + Vector3.new(0, 2, 0), 2.6, 0.45, true)
	bolt(from + Vector3.new(rng:NextNumber(-20, 20), 0, rng:NextNumber(-20, 20)), at + Vector3.new(0, 2, 0), 1.2, 0.3, false)
	ring(at, 30, PURPLE, 0.6)
	ring(at, 16, WHITE, 0.35)
	flash = 1
	thunder(at, true)
	shake(at, 0.9, 260)
end

-- Little bolts all round you while the storm lasts (just for the look).
local function ambient(now: number)
	if now < nextAmbient then
		return
	end
	nextAmbient = now + rng:NextNumber(1, 2.8)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local angle = rng:NextNumber(0, TAU)
	local ground = camera.CFrame.Position * Vector3.new(1, 0, 1) + Vector3.new(math.cos(angle), 0, math.sin(angle)) * rng:NextNumber(90, 280)
	bolt(ground + Vector3.new(rng:NextNumber(-30, 30), 380, rng:NextNumber(-30, 30)), ground, 1.4, 0.25, false)
	flash = math.max(flash, 0.45)
	if rng:NextNumber() < 0.5 then
		thunder(ground, false)
	end
end

--------------------------------------------------------------------------------
-- Shooting stars
--------------------------------------------------------------------------------
local function comet(now: number)
	if now < nextComet then
		return
	end
	nextComet = now + rng:NextNumber(0.6, 1.8)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	-- somewhere high round you, streaking across and a little down
	local angle = rng:NextNumber(0, TAU)
	local from = camera.CFrame.Position + Vector3.new(math.cos(angle) * 700, rng:NextNumber(380, 700), math.sin(angle) * 700)
	local across = Vector3.new(-math.sin(angle), 0, math.cos(angle)) * (if rng:NextNumber() < 0.5 then 1 else -1)
	local velocity = (across + Vector3.new(0, -0.35, 0)).Unit * rng:NextNumber(900, 1400)
	local streak = part("Comet", Vector3.new(2.2, 2.2, 140), CFrame.lookAt(from, from + velocity), if rng:NextNumber() < 0.5 then LIGHT_PURPLE else WHITE, Enum.Material.Neon)
	streak.Transparency = 0.1
	table.insert(comets, { Part = streak, Velocity = velocity, Born = now })
end

--------------------------------------------------------------------------------
-- The cosmic sky (Config.EternalStorm.Sky)
--------------------------------------------------------------------------------
local function skyId(name: string): string?
	local id = (STORM.Sky :: any)[name]
	return if type(id) == "string" and id ~= "" then id else nil
end

local function setOrientation(sky: Sky, value: Vector3)
	pcall(function()
		(sky :: any).SkyboxOrientation = value
	end)
end

-- The skybox: a space skybox of our own takes the normal one's place in Lighting (on this screen
-- only) while the storm lasts - no sun or moon, no extra stars on top of the painted ones
local function swapSky(on: boolean)
	if on then
		for _, face in FACES do
			if not skyId(face) then
				return -- (all six, or the sky stays as it is)
			end
		end
		local storm = Instance.new("Sky")
		storm.Name = "StormSkybox"
		for _, face in FACES do
			(storm :: any)[face] = skyId(face)
		end
		storm.CelestialBodiesShown = false
		storm.StarCount = 0
		local original = Lighting:FindFirstChildOfClass("Sky")
		if original then
			original.Parent = nil
		end
		storm.Parent = Lighting
		savedSky = { Storm = storm, Original = original }
		skyTurn = 0
	elseif savedSky then
		local saved = savedSky
		savedSky = nil
		saved.Storm:Destroy()
		if saved.Original then
			saved.Original.Parent = Lighting
		end
	end
end

local function image(parent: Instance, id: string, speed: number): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = "Image"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Image = id
	label.Parent = parent
	table.insert(spinners, { Image = label, Speed = speed })
	return label
end

-- A flat, glowing picture on both faces of an invisible part (the disk, the galaxy), turning
local function picture(name: string, size: number, id: string, glow: number, speed: number): BasePart
	local holder = part(name, Vector3.new(size, 0.2, size), CFrame.identity, WHITE, Enum.Material.SmoothPlastic, cosmos)
	holder.Transparency = 1
	for _, face in { Enum.NormalId.Top, Enum.NormalId.Bottom } do
		local gui = Instance.new("SurfaceGui")
		gui.Name = face.Name
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = Vector2.new(1024, 1024)
		gui.LightInfluence = 0
		gui.Brightness = glow
		gui.MaxDistance = 100000
		gui.Parent = holder
		image(gui, id, if face == Enum.NormalId.Top then speed else -speed)
	end
	return holder
end

-- A frame at `center` whose top faces `normal`, its sides level
local function flat(center: Vector3, normal: Vector3): CFrame
	local right = Vector3.yAxis:Cross(normal)
	right = if right.Magnitude < 0.01 then Vector3.xAxis else right.Unit
	return CFrame.fromMatrix(center, right, normal)
end

-- The black hole and the galaxy: built once the storm starts, and kept where they are in the sky
-- as you move (update moves them with your camera, so they look as far away as the stars)
local function buildCosmos()
	local disk, halo = skyId("Disk"), skyId("Halo")
	if not (disk and halo) then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "StormCosmos"
	folder.Parent = workspace
	cosmos = folder
	local elevation = math.rad(HOLE_ELEVATION)
	local ahead = Vector3.new(0, math.sin(elevation), math.cos(elevation))
	local center = ahead * HOLE_DISTANCE
	-- the shadow: Neon ignores light, so black Neon stays pitch black
	local core = part("Core", Vector3.one * CORE_RADIUS * 2, CFrame.identity, rgb(0, 0, 0), Enum.Material.Neon, folder)
	core.Shape = Enum.PartType.Ball
	table.insert(placed, { Part = core, Offset = CFrame.new(center) })
	-- the disk, almost edge-on: tipped so you see a little of its top over the near edge
	local tip = math.rad(HOLE_ELEVATION + DISK_VIEW)
	local diskPart = picture("Disk", DISK_SIZE, disk, 1.6, STORM.DiskSpin)
	table.insert(placed, { Part = diskPart, Offset = flat(center, Vector3.new(0, math.cos(tip), -math.sin(tip))) })
	-- the halo: the light from behind the hole bent round it, always turned towards you
	local anchor = part("HaloAnchor", Vector3.one, CFrame.identity, WHITE, Enum.Material.SmoothPlastic, folder)
	anchor.Transparency = 1
	local board = Instance.new("BillboardGui")
	board.Name = "Halo"
	local span = 2 * CORE_RADIUS * 1.04 / HALO_RING
	board.Size = UDim2.new(span, 0, span, 0)
	board.LightInfluence = 0
	board.Brightness = 1.8
	board.MaxDistance = 100000
	board.Adornee = anchor
	board.Parent = anchor
	image(board, halo, 5)
	table.insert(placed, { Part = anchor, Offset = CFrame.new(center) })
	-- the galaxy, behind you, seen at a slant
	local galaxy = skyId("Galaxy")
	if galaxy then
		local up = math.rad(GALAXY_ELEVATION)
		local spot = Vector3.new(0, math.sin(up), -math.cos(up)) * GALAXY_DISTANCE
		local lean = math.rad(GALAXY_ELEVATION + 50)
		local galaxyPart = picture("Galaxy", GALAXY_SIZE, galaxy, 1.4, 3)
		table.insert(placed, { Part = galaxyPart, Offset = flat(spot, Vector3.new(0, math.cos(lean), math.sin(lean))) })
	end
end

local function clearCosmos()
	if cosmos then
		cosmos:Destroy()
		cosmos = nil
	end
	table.clear(placed)
	table.clear(spinners)
end

--------------------------------------------------------------------------------
-- Start / stop
--------------------------------------------------------------------------------
local function setActive(on: boolean)
	if on == active then
		return
	end
	active = on
	grade.Enabled = true
	TweenService:Create(grade, TweenInfo.new(2.5), {
		TintColor = if on then rgb(210, 182, 255) else WHITE,
		Contrast = if on then 0.16 else 0,
		Saturation = if on then 0.08 else 0,
	}):Play()
	if not on then
		task.delay(2.6, function()
			if not active then
				grade.Enabled = false
			end
		end)
	end
	if setMusic then
		setMusic(on)
	end
	swapSky(on)
	if on then
		buildCosmos()
	else
		clearCosmos()
	end
end

local function update(dt: number)
	local now = os.clock()
	-- falling rocks: they speed up all the way down
	for i = #rocks, 1, -1 do
		local rock = rocks[i]
		local a = (now - rock.Start) / rock.Fall
		if a >= 1 then
			table.remove(rocks, i)
			impact(rock)
		else
			local height = SKY_HEIGHT * (1 - a * a)
			local position = rock.Target + rock.Drift * (1 - a * a) + Vector3.new(0, height + rock.Size * 0.3, 0)
			rock.Model:PivotTo(CFrame.new(position) * CFrame.fromAxisAngle(rock.Spin, a * 3))
			local reach = rock.Size * 0.6 + 4
			local grow = 0.4 + 0.6 * a
			rock.Circle.Size = Vector3.new(0.25, reach * 2 * grow, reach * 2 * grow)
			rock.Circle.Transparency = 0.35 + 0.3 * math.abs(math.sin(now * (6 + a * 14)))
		end
	end
	-- broken rock and craters fade away
	for i = #fading, 1, -1 do
		local item = fading[i]
		local left = item.Until - now
		if left <= 0 then
			for _, p in item.Parts do
				p:Destroy()
			end
			table.remove(fading, i)
		elseif left < 2 then
			for _, p in item.Parts do
				p.Transparency = math.max(p.Transparency, 1 - left / 2)
			end
		end
	end
	-- bolts flicker and go
	for i = #bolts, 1, -1 do
		local b = bolts[i]
		local age = now - b.Born
		if age > b.Life then
			for _, p in b.Parts do
				p:Destroy()
			end
			table.remove(bolts, i)
		else
			local t = if age < b.Life * 0.3 then 0 elseif age < b.Life * 0.45 then 0.75 elseif age < b.Life * 0.7 then 0 else 0.6
			for _, p in b.Parts do
				p.Transparency = t
			end
			if b.Light then
				b.Light.Brightness = if t > 0.5 then 1 else 6
			end
		end
	end
	if active then
		ambient(now)
		comet(now)
	end
	-- shooting stars fly and fade
	for i = #comets, 1, -1 do
		local c = comets[i]
		local age = now - c.Born
		if age > 0.9 or not active then
			c.Part:Destroy()
			table.remove(comets, i)
		else
			c.Part.CFrame += c.Velocity * dt
			c.Part.Transparency = 0.1 + 0.9 * (age / 0.9) ^ 2
		end
	end
	-- the cosmic sky: the black hole and galaxy stay put in the sky as you move, their pictures
	-- spin, and the whole skybox slowly turns (tipped, so the galaxy band rolls across the sky)
	local camera = workspace.CurrentCamera
	if cosmos and camera then
		local origin = CFrame.new(camera.CFrame.Position)
		for _, item in placed do
			item.Part.CFrame = origin * item.Offset
		end
		for _, spinner in spinners do
			spinner.Image.Rotation = (spinner.Image.Rotation + spinner.Speed * dt) % 360
		end
	end
	if savedSky then
		skyTurn = (skyTurn + STORM.SkySpin * dt) % 360
		setOrientation(savedSky.Storm, Vector3.new(18, skyTurn, 0))
	end
	-- lightning flashes the whole sky
	if flash > 0 then
		flash = math.max(0, flash - 0.08)
	end
	dim += ((if active then -0.08 else 0) - dim) * math.min(1, dt * 1.2)
	if grade.Enabled then
		grade.Brightness = dim + flash * 0.25
	end
end

function StormFX.Init(onMusic: ((boolean) -> ())?)
	setMusic = onMusic
	folder = Instance.new("Folder")
	folder.Name = "StormFXLocal"
	folder.Parent = workspace
	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "StormGrade"
	grade.Enabled = false
	grade.Parent = Lighting
	Remotes.Event("StormBlock").OnClientEvent:Connect(onBlock)
	Remotes.Event("StormStrike").OnClientEvent:Connect(onStrike)
	local function refresh()
		setActive(workspace:GetAttribute("EventId") == "EternalStorm")
	end
	workspace:GetAttributeChangedSignal("EventId"):Connect(refresh)
	refresh()
	RunService.RenderStepped:Connect(update)
	-- Screen shake (after the camera has moved, so it never builds up)
	RunService:BindToRenderStep("StormShake", Enum.RenderPriority.Camera.Value + 1, function()
		local now = os.clock()
		if now >= shakeUntil then
			return
		end
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local strength = shakeStrength * (shakeUntil - now) / 0.55
		camera.CFrame *= CFrame.Angles(math.noise(now * 25, 1.3) * 0.02 * strength, math.noise(now * 25, 4.7) * 0.02 * strength, 0)
			+ Vector3.new(math.noise(now * 30, 9.1), math.noise(now * 30, 2.2), 0) * 0.6 * strength
	end)
end

return StormFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">TrailFX</string>
            <string name="Source"><![CDATA[--[[
	TrailFX: draws every player's trail (their "Trail" attribute, see shared/Trails) on this screen.

	Fast Guy, while its wearer runs faster than Trails.MinSpeed:
	  * afterimages: FRAME_RATE times a second a glowing blue-white copy of their body is left where
	    they are (Neon, so it shows up even in the brightest biomes), and every copy fades a little
	    every other frame after that, so the run looks like it's made of frozen frames
	  * a streak of light behind the torso
	  * every PANE_EVERY seconds a pane of glass with white edges is left behind them; a moment
	    later it shatters into shards that fly back and fall
	Only players near the camera get the effect. The copies are cloned once per character (one
	afterimage per frame until there are GHOSTS of them) and then reused: nothing is created while
	running. Everything here is client-side.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Trails = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Trails"))

local TrailFX = {}

local VIEW_DISTANCE = 220
local FRAME_RATE = 24 -- afterimages a second (24 frames a second, like Naoya's technique)
local GHOSTS = 8 -- afterimages alive at once (a third of a second of them)
-- Transparency of an afterimage 1, 2, 3 ... frames old. It changes every other frame, so only
-- half the afterimages need their parts updated each frame.
local GHOST_FADE = { 0.15, 0.15, 0.32, 0.32, 0.5, 0.5, 0.7, 0.7 }
local MAX_GHOST_PARTS = 20 -- body parts + accessories copied per afterimage
local PANE_EVERY = 0.85
local PANE_HOLD = 0.12 -- seconds the pane stays whole before it shatters
local PANE_SIZE = Vector2.new(5, 7)
local SHARDS_PER_PANE = 10
local SHARD_LIFE = 0.8
local MAX_SHARDS = 60
local GRAVITY = 55
local GLASS_SOUND = "rbxasset://sounds/electronicpingshort.wav"
local IDLE_CLEANUP = 20

type Ghost = { Parts: { BasePart }, Age: number }
type Pane = { Model: Model, Glass: BasePart, Edges: { BasePart }, ShatterAt: number? }
type Runner = {
	Player: Player,
	Character: Model?,
	TrailId: string?,
	Sources: { BasePart },
	Ghosts: { Ghost },
	Next: number,
	Clock: number,
	PaneClock: number,
	Pane: Pane?,
	Streak: Trail?,
	Dirty: boolean,
	IdleFor: number, -- seconds without the effect (the copies are thrown away after IDLE_CLEANUP)
	Connections: { RBXScriptConnection },
}
type Shard = { Part: BasePart, Velocity: Vector3, Spin: Vector3, Born: number, Active: boolean }

local localPlayer = Players.LocalPlayer
local runners: { [Player]: Runner } = {}
local shards: { Shard } = {}
local folder: Folder
local clock = 0
local bulkMove = true -- (workspace:BulkMoveTo, if this client has it)
local rng = Random.new()
local glassSound: Sound? = nil

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------
local function moveParts(parts: { BasePart }, cframes: { CFrame })
	if bulkMove then
		local ok = pcall(function()
			workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end)
		bulkMove = ok
	end
	if not bulkMove then
		for i, part in parts do
			part.CFrame = cframes[i]
		end
	end
end

local function effectPart(part: BasePart)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
end

local function newPart(className: string, name: string, size: Vector3, color: Color3, material: Enum.Material): BasePart
	local part = Instance.new(className) :: BasePart
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.Transparency = 1
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	effectPart(part)
	return part
end

-- The body parts and accessories an afterimage copies (no tools, no root, nothing invisible).
local function sourcesOf(character: Model): { BasePart }
	local list = {}
	for _, item in character:GetDescendants() do
		if item:IsA("BasePart") and item.Name ~= "HumanoidRootPart" and item.Transparency < 0.95 and not item:FindFirstAncestorOfClass("Tool") then
			table.insert(list, item)
			if #list >= MAX_GHOST_PARTS then
				break
			end
		end
	end
	return list
end

-- A see-through copy of one body part: same shape (its mesh), no face, no textures.
local function ghostPart(source: BasePart, color: Color3): BasePart?
	local archivable = source.Archivable
	source.Archivable = true
	local copy = source:Clone()
	source.Archivable = archivable
	if not copy then
		return nil
	end
	for _, child in copy:GetChildren() do
		if not child:IsA("DataModelMesh") then
			child:Destroy()
		end
	end
	if copy:IsA("MeshPart") then
		pcall(function()
			copy.TextureID = ""
		end)
	end
	effectPart(copy)
	copy.Material = Enum.Material.Neon
	copy.Color = color
	copy.Reflectance = 0
	copy.Transparency = 1
	copy.Name = "Afterimage"
	copy.Parent = folder
	return copy
end

local function clearGhosts(runner: Runner)
	for _, ghost in runner.Ghosts do
		for _, part in ghost.Parts do
			part:Destroy()
		end
	end
	runner.Ghosts = {}
	runner.Next = 1
end

local function setGhostTransparency(ghost: Ghost, transparency: number)
	for _, part in ghost.Parts do
		part.Transparency = transparency
	end
end

--------------------------------------------------------------------------------
-- Glass panes and shards
--------------------------------------------------------------------------------
local function buildPane(trail: Trails.Trail): Pane
	local model = Instance.new("Model")
	model.Name = "GlassPane"
	local glass = newPart("Part", "Glass", Vector3.new(PANE_SIZE.X, PANE_SIZE.Y, 0.15), trail.Color, Enum.Material.Glass)
	glass.Reflectance = 0.25
	glass.Parent = model
	local edges = {}
	local edge = 0.18
	for i, def in {
		{ Vector3.new(PANE_SIZE.X + edge, edge, 0.2), Vector3.new(0, PANE_SIZE.Y / 2, 0) },
		{ Vector3.new(PANE_SIZE.X + edge, edge, 0.2), Vector3.new(0, -PANE_SIZE.Y / 2, 0) },
		{ Vector3.new(edge, PANE_SIZE.Y + edge, 0.2), Vector3.new(PANE_SIZE.X / 2, 0, 0) },
		{ Vector3.new(edge, PANE_SIZE.Y + edge, 0.2), Vector3.new(-PANE_SIZE.X / 2, 0, 0) },
	} do
		local part = newPart("Part", "Edge" .. i, def[1], trail.Accent, Enum.Material.Neon)
		part:SetAttribute("Offset", def[2])
		part.Parent = model
		table.insert(edges, part)
	end
	model.Parent = folder
	return { Model = model, Glass = glass, Edges = edges, ShatterAt = nil }
end

local function showPane(pane: Pane, cf: CFrame)
	local parts, cframes = { pane.Glass }, { cf }
	for _, edge in pane.Edges do
		table.insert(parts, edge)
		table.insert(cframes, cf * CFrame.new(edge:GetAttribute("Offset") :: Vector3))
	end
	moveParts(parts, cframes)
	pane.Glass.Transparency = 0.55
	for _, edge in pane.Edges do
		edge.Transparency = 0.05
	end
	pane.ShatterAt = clock + PANE_HOLD
end

local function freeShard(color: Color3): Shard?
	for _, shard in shards do
		if not shard.Active then
			shard.Part.Color = color
			return shard
		end
	end
	if #shards >= MAX_SHARDS then
		return nil
	end
	local part = newPart("WedgePart", "Shard", Vector3.new(0.08, 1, 1), color, Enum.Material.Glass)
	part.Reflectance = 0.3
	part.Parent = folder
	local shard = { Part = part, Velocity = Vector3.zero, Spin = Vector3.zero, Born = 0, Active = false }
	table.insert(shards, shard)
	return shard
end

local function playGlass(runner: Runner)
	if runner.Player ~= localPlayer then
		return -- only your own trail makes a sound
	end
	if not glassSound then
		local sound = Instance.new("Sound")
		sound.Name = "TrailGlass"
		sound.SoundId = GLASS_SOUND
		sound.Volume = 0.08
		sound.Parent = SoundService
		glassSound = sound
	end
	local sound = glassSound :: Sound
	sound.PlaybackSpeed = 2.4 + rng:NextNumber() * 0.5
	SoundService:PlayLocalSound(sound)
end

local function shatter(runner: Runner, pane: Pane, trail: Trails.Trail)
	pane.ShatterAt = nil
	local cf = pane.Glass.CFrame
	pane.Glass.Transparency = 1
	for _, edge in pane.Edges do
		edge.Transparency = 1
	end
	local parts, cframes = {}, {}
	for _ = 1, SHARDS_PER_PANE do
		local shard = freeShard(trail.Color:Lerp(trail.Accent, rng:NextNumber() * 0.5))
		if not shard then
			break
		end
		local x = rng:NextNumber(-0.5, 0.5) * PANE_SIZE.X
		local y = rng:NextNumber(-0.5, 0.5) * PANE_SIZE.Y
		local size = Vector3.new(0.08, rng:NextNumber(0.6, 1.8), rng:NextNumber(0.5, 1.5))
		shard.Part.Size = size
		shard.Part.Transparency = 0.2
		-- away from the runner (backwards), outwards from the middle of the pane, and a little up
		shard.Velocity = -cf.LookVector * rng:NextNumber(6, 16) + cf.RightVector * x * rng:NextNumber(1.5, 4) + cf.UpVector * (y * 1.2 + rng:NextNumber(2, 7))
		shard.Spin = Vector3.new(rng:NextNumber(-9, 9), rng:NextNumber(-9, 9), rng:NextNumber(-9, 9))
		shard.Born = clock
		shard.Active = true
		table.insert(parts, shard.Part)
		table.insert(cframes, cf * CFrame.new(x, y, 0) * CFrame.Angles(0, math.pi / 2, rng:NextNumber(0, math.pi * 2)))
	end
	moveParts(parts, cframes)
	playGlass(runner)
end

local function updateShards(dt: number)
	local parts, cframes = {}, {}
	for _, shard in shards do
		if shard.Active then
			local age = clock - shard.Born
			if age >= SHARD_LIFE then
				shard.Active = false
				shard.Part.Transparency = 1
			else
				shard.Velocity -= Vector3.new(0, GRAVITY * dt, 0)
				local spin = shard.Spin * dt
				table.insert(parts, shard.Part)
				table.insert(cframes, (shard.Part.CFrame + shard.Velocity * dt) * CFrame.Angles(spin.X, spin.Y, spin.Z))
				shard.Part.Transparency = 0.2 + 0.8 * (age / SHARD_LIFE) ^ 2
			end
		end
	end
	if #parts > 0 then
		moveParts(parts, cframes)
	end
end

--------------------------------------------------------------------------------
-- Runners
--------------------------------------------------------------------------------
local function streakFor(runner: Runner, character: Model, trail: Trails.Trail): Trail?
	local existing = runner.Streak
	if existing and existing.Parent then
		return existing
	end
	local torso = (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")) :: BasePart?
	if not torso then
		return nil
	end
	local top = Instance.new("Attachment")
	top.Name = "TrailTop"
	top.Position = Vector3.new(0, torso.Size.Y * 0.45, 0)
	top.Parent = torso
	local bottom = Instance.new("Attachment")
	bottom.Name = "TrailBottom"
	bottom.Position = Vector3.new(0, -torso.Size.Y * 0.9, 0)
	bottom.Parent = torso
	local streak = Instance.new("Trail")
	streak.Name = "FastTrail"
	streak.Attachment0 = top
	streak.Attachment1 = bottom
	streak.Color = ColorSequence.new(trail.Accent, trail.Color)
	streak.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	streak.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.3) })
	streak.Lifetime = 0.32
	streak.LightEmission = 1
	streak.FaceCamera = true
	streak.Enabled = false
	streak.Parent = torso
	runner.Streak = streak
	return streak
end

local function reset(runner: Runner)
	clearGhosts(runner)
	if runner.Pane then
		runner.Pane.Model:Destroy()
		runner.Pane = nil
	end
	if runner.Streak then
		runner.Streak:Destroy()
		runner.Streak = nil
	end
	for _, connection in runner.Connections do
		connection:Disconnect()
	end
	runner.Connections = {}
	runner.Sources = {}
	runner.Character = nil
	runner.TrailId = nil
end

local function adopt(runner: Runner, character: Model, trail: Trails.Trail)
	reset(runner)
	runner.Character = character
	runner.TrailId = trail.Id
	runner.Sources = sourcesOf(character)
	-- an accessory that loads late (or is taken off) means new copies are needed
	local function dirty(item: Instance)
		if item:IsA("Accessory") or item:IsA("BasePart") then
			runner.Dirty = true
		end
	end
	table.insert(runner.Connections, character.ChildAdded:Connect(dirty))
	table.insert(runner.Connections, character.ChildRemoved:Connect(dirty))
end

-- Leave an afterimage where the runner is now (building it the first time it's needed).
local function snapshot(runner: Runner, trail: Trails.Trail)
	if runner.Dirty then
		runner.Dirty = false
		clearGhosts(runner)
		if runner.Character then
			runner.Sources = sourcesOf(runner.Character)
		end
	end
	local index = runner.Next
	runner.Next = index % GHOSTS + 1
	local ghost = runner.Ghosts[index]
	if not ghost then
		local parts = {}
		for _, source in runner.Sources do
			local copy = ghostPart(source, trail.Color)
			if copy then
				table.insert(parts, copy)
			end
		end
		ghost = { Parts = parts, Age = 0 }
		runner.Ghosts[index] = ghost
	end
	local cframes = {}
	for i, part in ghost.Parts do
		local source = runner.Sources[i]
		cframes[i] = if source and source.Parent then source.CFrame else part.CFrame
	end
	moveParts(ghost.Parts, cframes)
	ghost.Age = 1
	setGhostTransparency(ghost, GHOST_FADE[1])
end

-- One frame later: every afterimage fades a step; the oldest disappear.
local function ageGhosts(runner: Runner)
	for _, ghost in runner.Ghosts do
		if ghost.Age <= GHOSTS then
			ghost.Age += 1
			local fade = GHOST_FADE[ghost.Age] or 1
			if fade ~= GHOST_FADE[ghost.Age - 1] then
				setGhostTransparency(ghost, fade)
			end
		end
	end
end

local function update(dt: number)
	clock += dt
	local camera = workspace.CurrentCamera
	local eye = if camera then camera.CFrame.Position else Vector3.zero
	local step = 1 / FRAME_RATE
	for player, runner in runners do
		local character = player.Character
		local trail = Trails.ById[player:GetAttribute("Trail") :: any]
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local active = false
		if trail and character and root then
			if runner.Character ~= character or runner.TrailId ~= trail.Id then
				adopt(runner, character, trail)
			end
			local velocity = root.AssemblyLinearVelocity
			local speed = Vector2.new(velocity.X, velocity.Z).Magnitude
			active = speed >= Trails.MinSpeed and (root.Position - eye).Magnitude <= VIEW_DISTANCE
		elseif runner.Character then
			-- no trail (taken off) or no character: let the afterimages fade, then tidy up
			local fading = false
			for _, ghost in runner.Ghosts do
				fading = fading or ghost.Age <= GHOSTS
			end
			if not fading and not (runner.Pane and runner.Pane.ShatterAt) then
				reset(runner)
			end
		end

		runner.Clock += dt
		if runner.Clock >= step then
			runner.Clock = math.min(runner.Clock - step, step)
			ageGhosts(runner)
			if active and trail then
				snapshot(runner, trail)
			end
		end

		if character and trail then
			local streak = streakFor(runner, character, trail)
			if streak then
				streak.Enabled = active
			end
		end

		local pane = runner.Pane
		if pane and pane.ShatterAt and clock >= pane.ShatterAt and trail then
			shatter(runner, pane, trail)
		end
		if active then
			runner.IdleFor = 0
		else
			runner.IdleFor += dt
			if runner.IdleFor >= IDLE_CLEANUP and #runner.Ghosts > 0 then
				clearGhosts(runner) -- (built again the next time they run)
			end
		end
		if active and trail and root then
			runner.PaneClock += dt
			if runner.PaneClock >= PANE_EVERY and not (pane and pane.ShatterAt) then
				runner.PaneClock = 0
				local newPane = pane or buildPane(trail)
				runner.Pane = newPane
				local flat = root.CFrame.LookVector * Vector3.new(1, 0, 1)
				local forward = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
				local at = root.Position - forward * 3 + Vector3.new(0, 0.6, 0)
				showPane(newPane, CFrame.lookAt(at, at + forward) * CFrame.Angles(0, 0, rng:NextNumber(-0.12, 0.12)))
			end
		else
			runner.PaneClock = math.min(runner.PaneClock, PANE_EVERY * 0.6)
		end
	end
	updateShards(dt)
end

local function track(player: Player)
	if runners[player] then
		return
	end
	runners[player] = {
		Player = player,
		Character = nil,
		TrailId = nil,
		Sources = {},
		Ghosts = {},
		Next = 1,
		Clock = 0,
		PaneClock = PANE_EVERY * 0.5,
		Pane = nil,
		Streak = nil,
		Dirty = false,
		IdleFor = 0,
		Connections = {},
	}
end

function TrailFX.Init()
	folder = Instance.new("Folder")
	folder.Name = "TrailFX"
	folder.Parent = workspace
	for _, player in Players:GetPlayers() do
		track(player)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(function(player)
		local runner = runners[player]
		if runner then
			reset(runner)
			runners[player] = nil
		end
	end)
	RunService.Heartbeat:Connect(update)
end

return TrailFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">Treadmill</string>
            <string name="Source"><![CDATA[--[[
	Treadmill (client): step onto your own treadmill and you're locked onto the belt, running in
	place automatically. Press Space / Jump (or the "Get off" button) to step off.
	While running: a "+speed" popup every second, the camera zooms out a little (FOV kick), speed
	lines streak across the screen, a trail in your treadmill's colour follows you, and every time
	you gain a whole point of WalkSpeed (every Config.Speed.SpeedPerWalk Speed) a "+1 WALK SPEED!"
	burst pops up.
	Every treadmill's LED strips and fan are animated here too (faster while someone runs on it).

	The server decides how much speed you actually get (TreadmillService); this only handles the
	feel.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Theme = require(script.Parent.UI.Theme)
local State = require(script.Parent.State)
local Bases = require(script.Parent.Bases)

local Treadmill = {}

local player = Players.LocalPlayer :: Player

local BELT_HALF_WIDTH = 3.3
local BELT_HALF_LENGTH = 6.8
local R6_RUN = "rbxassetid://180426354"
local R15_RUN = "rbxassetid://913376220"

local running = false
local pinned: CFrame? = nil
local track: AnimationTrack? = nil
local cooldownUntil = 0
local hint: Frame
local popupLayer: Frame
local rateLabel: TextLabel
local speedLines: Frame
local trail: Trail? = nil
local trailAttachments: { Attachment } = {}
local baseFov = 70
local lastWalkPoint = 0

local function getCharacter(): (Model?, BasePart?, Humanoid?)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return character, root, humanoid
end

local function getBelt(): BasePart?
	local plot = Bases.Mine()
	local treadmill = plot and plot:FindFirstChild("Treadmill")
	local belt = treadmill and treadmill:FindFirstChild("Belt")
	return if belt and belt:IsA("BasePart") then belt else nil
end

local function currentRate(): number
	local level = math.max(1, State.Number("TreadmillLevel"))
	return Economy.TreadmillRate(level, State.Number("SpeedMultLevel"), math.max(1, State.Number("SpeedPassMultiplier")), State.Number("IndexBonus"), State.Number("PetSpeedBonus"))
end

local function tierColor(): Color3
	return Economy.TreadmillTier(math.max(1, State.Number("TreadmillLevel"))).Accent
end

-- Trail + FOV kick + speed lines while running
local function setRunFX(on: boolean, root: BasePart?)
	local camera = workspace.CurrentCamera
	if camera then
		if on then
			baseFov = camera.FieldOfView
		end
		TweenService:Create(camera, TweenInfo.new(0.5, Enum.EasingStyle.Sine), { FieldOfView = if on then baseFov + 10 else baseFov }):Play()
	end
	speedLines.Visible = on
	if trail then
		trail:Destroy()
		trail = nil
	end
	for _, attachment in trailAttachments do
		attachment:Destroy()
	end
	trailAttachments = {}
	if on and root then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 1, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -1.5, 0)
		a1.Parent = root
		local t = Instance.new("Trail")
		t.Attachment0 = a0
		t.Attachment1 = a1
		t.Color = ColorSequence.new(tierColor(), Color3.new(1, 1, 1))
		t.LightEmission = 0.8
		t.Lifetime = 0.35
		t.Transparency = NumberSequence.new(0.3, 1)
		t.FaceCamera = true
		t.Parent = root
		trail = t
		trailAttachments = { a0, a1 }
	end
end

-- Streaks flying across the screen while you run
local function buildSpeedLines(parent: Instance)
	speedLines = Theme.new("Frame", { Name = "SpeedLines", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = parent })
	local lines = {}
	for i = 1, 14 do
		local line = Theme.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.75,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(math.random(80, 220), 3),
			Position = UDim2.fromScale(math.random(), (i - 0.5) / 14),
			Parent = speedLines,
		})
		table.insert(lines, { Frame = line, Speed = math.random(9, 16) / 10, Y = (i - 0.5) / 14 })
	end
	RunService.RenderStepped:Connect(function(dt: number)
		if not speedLines.Visible then
			return
		end
		for _, line in lines do
			local x = line.Frame.Position.X.Scale - dt * line.Speed
			if x < -0.15 then
				x = 1.15
				line.Frame.BackgroundColor3 = tierColor():Lerp(Color3.new(1, 1, 1), 0.5)
			end
			-- keep the middle of the screen clear
			local edge = math.abs(line.Y - 0.5) > 0.22
			line.Frame.BackgroundTransparency = if edge then 0.7 else 1
			line.Frame.Position = UDim2.fromScale(x, line.Y)
		end
	end)
end

-- "+1 WALK SPEED!" every time the Speed stat crosses a whole WalkSpeed point
local function walkSpeedBurst(points: number)
	local label = Theme.Label({
		Text = `+{points} WALK SPEED! 🏃`,
		TextColor3 = Color3.fromRGB(120, 255, 140),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(360, 56),
		StrokeThickness = 3.5,
		Parent = popupLayer,
	})
	local scale = Theme.new("UIScale", { Scale = 0.2, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = Theme.CurrentScale() * 1.1 }):Play()
	TweenService:Create(label, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.22) }):Play()
	task.delay(0.9, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.45)
		label:Destroy()
	end)
end

-- LED strips chase along every treadmill, the fans spin (both faster while someone runs on it)
local function startTreadmillAnimations()
	type LED = { Part: BasePart, Index: number, Model: Instance }
	local leds: { [Instance]: LED } = {}
	local fans: { [Instance]: { Model: Model, Base: CFrame } } = {}
	local function addLED(instance: Instance)
		if instance:IsA("BasePart") then
			leds[instance] = { Part = instance, Index = (instance:GetAttribute("LEDIndex") :: number?) or 0, Model = instance.Parent :: Instance }
		end
	end
	local function addFan(instance: Instance)
		if instance:IsA("Model") and instance.PrimaryPart then
			fans[instance] = { Model = instance, Base = instance:GetPivot() }
		end
	end
	for _, led in CollectionService:GetTagged("TreadmillLED") do
		addLED(led)
	end
	for _, fan in CollectionService:GetTagged("TreadmillFan") do
		addFan(fan)
	end
	CollectionService:GetInstanceAddedSignal("TreadmillLED"):Connect(addLED)
	CollectionService:GetInstanceAddedSignal("TreadmillFan"):Connect(function(instance)
		task.wait(0.2)
		addFan(instance)
	end)
	CollectionService:GetInstanceRemovedSignal("TreadmillLED"):Connect(function(instance)
		leds[instance] = nil
	end)
	CollectionService:GetInstanceRemovedSignal("TreadmillFan"):Connect(function(instance)
		fans[instance] = nil
	end)
	local fanAngle: { [Instance]: number } = {}
	RunService.RenderStepped:Connect(function(dt: number)
		local t = os.clock()
		local camera = workspace.CurrentCamera
		local cam = if camera then camera.CFrame.Position else Vector3.zero
		for instance, led in leds do
			if not instance.Parent then
				leds[instance] = nil
				continue
			end
			if (led.Part.Position - cam).Magnitude < 120 then
				local running = led.Model:GetAttribute("Running") == true
				local speed = if running then 14 else 3
				local wave = math.sin(t * speed - led.Index * 0.8)
				led.Part.Transparency = if running then 0.5 - wave * 0.5 else 0.35 - wave * 0.3
			end
		end
		for instance, fan in fans do
			if not instance.Parent then
				fans[instance] = nil
				continue
			end
			if (fan.Base.Position - cam).Magnitude < 120 then
				local running = (fan.Model.Parent :: Instance):GetAttribute("Running") == true
				fanAngle[instance] = (fanAngle[instance] or 0) + dt * (if running then 22 else 3)
				fan.Model:PivotTo(fan.Base * CFrame.Angles(fanAngle[instance], 0, 0))
			end
		end
	end)
end

-- Disable / enable walking input (so holding W doesn't fight the treadmill).
-- The controls object is looked up once in the background so this never yields.
local controls: any = nil
local function setControls(enabled: boolean)
	if not controls then
		return
	end
	pcall(function()
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end)
end

local function runAnimationId(character: Model, humanoid: Humanoid): string
	local animate = character:FindFirstChild("Animate")
	local runFolder = animate and animate:FindFirstChild("run")
	local anim = runFolder and runFolder:FindFirstChildOfClass("Animation")
	if anim and anim.AnimationId ~= "" then
		return anim.AnimationId
	end
	return if humanoid.RigType == Enum.HumanoidRigType.R15 then R15_RUN else R6_RUN
end

local function start(belt: BasePart, character: Model, root: BasePart, humanoid: Humanoid)
	running = true
	-- Stand in the middle of the belt, facing the console.
	local hip = if humanoid.RigType == Enum.HumanoidRigType.R15 then humanoid.HipHeight + root.Size.Y / 2 else 3
	local top = belt.Position.Y + belt.Size.Y / 2 + hip
	local center = Vector3.new(belt.Position.X, top, belt.Position.Z)
	pinned = CFrame.lookAt(center, center + belt.CFrame.LookVector * Vector3.new(1, 0, 1))
	humanoid.AutoRotate = false
	setControls(false)

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animator then
		local animation = Instance.new("Animation")
		animation.AnimationId = runAnimationId(character, humanoid)
		local ok, loaded = pcall(animator.LoadAnimation, animator, animation)
		if ok and loaded then
			loaded.Priority = Enum.AnimationPriority.Action
			loaded.Looped = true
			loaded:Play(0.2)
			loaded:AdjustSpeed(1.4)
			track = loaded
		end
	end
	rateLabel.Text = `🏃 RUNNING!  +{Format.Rate(currentRate())} ⚡/s`
	hint.Visible = true
	lastWalkPoint = math.floor(Economy.WalkSpeedFromStat(State.Number("Speed")))
	setRunFX(true, root)
end

local function stop(stepOff: boolean)
	if not running then
		return
	end
	-- Everything here is instant (no yields) so the belt can't re-grab you mid-step.
	running = false
	cooldownUntil = os.clock() + 1
	local _, root, humanoid = getCharacter()
	if stepOff and root and pinned then
		-- Hop off the back so you don't instantly step back on.
		root.CFrame = pinned * CFrame.new(0, 0, BELT_HALF_LENGTH + 3)
	end
	pinned = nil
	hint.Visible = false
	if humanoid then
		humanoid.AutoRotate = true
	end
	if track then
		track:Stop(0.2)
		track = nil
	end
	setControls(true)
	setRunFX(false, nil)
end

local function isOnBelt(belt: BasePart, position: Vector3): boolean
	local localPos = belt.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) < BELT_HALF_WIDTH and math.abs(localPos.Z) < BELT_HALF_LENGTH and localPos.Y > 0 and localPos.Y < 8
end

local function popup()
	local amount = currentRate()
	local label = Theme.Label({
		Text = "+" .. Format.Rate(amount) .. " ⚡",
		TextColor3 = Color3.fromRGB(200, 150, 255),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(math.random(10, 90) / 100, math.random(18, 78) / 100),
		Size = UDim2.fromOffset(190, 54),
		Rotation = math.random(-12, 12),
		StrokeThickness = 3,
		Parent = popupLayer,
	})
	local scale = Theme.new("UIScale", { Scale = 0.2, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = Theme.CurrentScale() }):Play()
	TweenService:Create(label, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = label.Position - UDim2.fromOffset(0, 60) }):Play()
	task.delay(0.6, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.4), { Transparency = 1 }):Play()
		end
		task.wait(0.45)
		label:Destroy()
	end)
end

function Treadmill.IsRunning(): boolean
	return running
end

function Treadmill.Init()
	task.spawn(function()
		pcall(function()
			local playerModule = require((player :: any).PlayerScripts:WaitForChild("PlayerModule", 10)) :: any
			controls = playerModule:GetControls()
		end)
	end)
	local gui = Theme.ScreenGui("Treadmill", 4)
	buildSpeedLines(gui)
	popupLayer = Theme.new("Frame", { Name = "Popups", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
	startTreadmillAnimations()
	State.OnAttribute("Speed", function(value)
		if running and type(value) == "number" then
			local point = math.floor(Economy.WalkSpeedFromStat(value))
			if point > lastWalkPoint then
				walkSpeedBurst(point - lastWalkPoint)
			end
			lastWalkPoint = point
		end
	end)

	hint = Theme.new("Frame", {
		Name = "RunningHint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, if Theme.IsTouch then -150 else -24),
		Size = UDim2.fromOffset(420, 110),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	Theme.AutoScale(hint)
	rateLabel = Theme.Label({ Text = "", TextColor3 = Color3.fromRGB(210, 170, 255), Size = UDim2.new(1, 0, 0, 44), StrokeThickness = 3, Parent = hint })
	local getOff = Theme.Button({
		Text = if Theme.IsTouch then "GET OFF" else "GET OFF (Space)",
		Color = Theme.Colors.Red,
		Size = UDim2.fromOffset(260, 56),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 50),
		Parent = hint,
	})
	getOff.Activated:Connect(function()
		stop(true)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if running and not processed and (input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA) then
			stop(true)
		end
	end)
	UserInputService.JumpRequest:Connect(function()
		if running then
			stop(true)
		end
	end)

	-- Keep the character pinned to the belt (before physics and before rendering).
	local function pin()
		if not running or not pinned then
			return
		end
		local _, root = getCharacter()
		if root then
			root.CFrame = pinned
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end
	RunService.Stepped:Connect(pin)
	RunService.RenderStepped:Connect(pin)

	-- Detect stepping on / leaving the treadmill
	task.spawn(function()
		while true do
			task.wait(0.1)
			local character, root, humanoid = getCharacter()
			local belt = getBelt()
			if running then
				if not character or not root or not humanoid or humanoid.Health <= 0 or not belt or player:GetAttribute("CarryingDonut") then
					stop(false)
				end
			elseif character and root and humanoid and belt and os.clock() > cooldownUntil and humanoid.Health > 0 then
				if isOnBelt(belt, root.Position) and not player:GetAttribute("CarryingDonut") then
					start(belt, character, root, humanoid)
				end
			end
		end
	end)

	-- One popup per second while running
	task.spawn(function()
		while true do
			task.wait(1)
			if running then
				popup()
				rateLabel.Text = `🏃 RUNNING!  +{Format.Rate(currentRate())} ⚡/s`
			end
		end
	end)

	player.CharacterAdded:Connect(function()
		running = false
		pinned = nil
		track = nil
		hint.Visible = false
		setControls(true)
		setRunFX(false, nil)
	end)
end

return Treadmill
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="90">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">Admin</string>
              <string name="Source"><![CDATA[--[[
	Admin panel: opens when you type the admin code in chat (the server spots it, hides it from
	everyone else and replies with AdminPanel). Every button just asks the server
	(Action "Admin" { Cmd, Arg }); the server decides (AdminService).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Areas = require(Shared.Areas)
local Boxes = require(Shared.Boxes)
local Donuts = require(Shared.Donuts)
local Rarities = require(Shared.Rarities)
local Pets = require(Shared.Pets)
local Crates = require(Shared.Crates)
local Events = require(Shared.Events)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Admin = {}

local modal: Modal.Modal
local scroll: ScrollingFrame
local order = 0

local function command(cmd: string, arg: any?)
	State.Action("Admin", { Cmd = cmd, Arg = arg })
end

local function section(title: string, cellWidth: number?): (Frame, TextLabel)
	order += 1
	local label = Theme.Label({ Text = title, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = order, Parent = scroll })
	order += 1
	return Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = scroll }, {
		Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(cellWidth or 128, 40), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	}), label
end

local function button(parent: Instance, text: string, color: Color3, onClick: () -> ()): TextButton
	local b = Theme.Button({ Text = text, Color = color, Size = UDim2.new(), Parent = parent })
	b.Activated:Connect(onClick)
	return b
end

-- HD Admin-style commands: pick who (me / everyone / others / a player), type a value if the
-- command needs one, press the command. Only the owner can pick other players or use the
-- moderation and whole-server commands (the server checks too: HDAdmin.Run).
local function buildHD()
	order += 1
	Theme.Label({ Text = "👥 PLAYER COMMANDS (HD Admin)", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = order, Parent = scroll })
	order += 1
	local row = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = order, Parent = scroll })
	local choices: { { Label: string, Target: any } } = {}
	local choice = 1
	local targetButton = Theme.Button({ Text = "", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(250, 40), Parent = row })
	local function refreshChoices()
		local current = choices[choice]
		local owner = Players.LocalPlayer:GetAttribute("AdminOwner") == true
		choices = if owner then { { Label = "🙋 Me", Target = "me" }, { Label = "🌍 Everyone", Target = "all" }, { Label = "👥 Everyone else", Target = "others" } } else { { Label = "🙋 Me", Target = "me" } }
		for _, other in Players:GetPlayers() do
			if owner and other ~= Players.LocalPlayer then
				table.insert(choices, { Label = "👤 " .. other.DisplayName, Target = other.UserId })
			end
		end
		choice = 1
		for i, entry in choices do
			if current and entry.Target == current.Target then
				choice = i
			end
		end
		Theme.SetButtonText(targetButton, "Target: " .. choices[choice].Label .. "  ▸")
	end
	targetButton.Activated:Connect(function()
		refreshChoices()
		choice = choice % #choices + 1
		Theme.SetButtonText(targetButton, "Target: " .. choices[choice].Label .. "  ▸")
	end)
	Players.PlayerAdded:Connect(refreshChoices)
	Players.PlayerRemoving:Connect(function()
		task.defer(refreshChoices)
	end)
	refreshChoices()
	local valueBox = Theme.new("TextBox", {
		Size = UDim2.new(1, -262, 0, 40), Position = UDim2.fromOffset(262, 0),
		BackgroundColor3 = Theme.Colors.PanelLight, TextColor3 = Color3.new(1, 1, 1), PlaceholderText = "value: number or message",
		PlaceholderColor3 = Color3.fromRGB(170, 170, 190), Text = "", Font = Theme.Font, TextScaled = true, ClearTextOnFocus = false, Parent = row,
	}, { Theme.Corner(10), Theme.Stroke(2) })
	local function run(action: string)
		command("HD", { Action = action, Target = choices[choice].Target, Value = if valueBox.Text ~= "" then (tonumber(valueBox.Text) or valueBox.Text) else nil })
	end
	type Entry = { Text: string, Action: string, Color: Color3, Cmd: string? }
	local groups: { { Title: string, Entries: { Entry }, OwnerOnly: boolean? } } = {
		{ Title = "Health", Entries = {
			{ Text = "💀 Kill", Action = "kill", Color = Theme.Colors.Red }, { Text = "🔄 Respawn", Action = "respawn", Color = Theme.Colors.Gray },
			{ Text = "❤️ Heal", Action = "heal", Color = Theme.Colors.Green }, { Text = "😇 God", Action = "god", Color = Theme.Colors.Yellow },
			{ Text = "🙂 Ungod", Action = "ungod", Color = Theme.Colors.Gray }, { Text = "🛡 Forcefield", Action = "ff", Color = Theme.Colors.Blue },
			{ Text = "❌ Unforcefield", Action = "unff", Color = Theme.Colors.Gray }, { Text = "💥 Explode", Action = "explode", Color = Theme.Colors.Orange },
		} },
		{ Title = "Control", Entries = {
			{ Text = "🧊 Freeze", Action = "freeze", Color = Theme.Colors.Blue }, { Text = "🔥 Thaw", Action = "thaw", Color = Theme.Colors.Orange },
			{ Text = "🔒 Jail", Action = "jail", Color = Theme.Colors.Gray }, { Text = "🔓 Unjail", Action = "unjail", Color = Theme.Colors.Green },
			{ Text = "🧲 Bring", Action = "bring", Color = Theme.Colors.Purple }, { Text = "🚀 Go to", Action = "goto", Color = Theme.Colors.Purple },
			{ Text = "🌪 Fling", Action = "fling", Color = Theme.Colors.Red }, { Text = "🪑 Sit", Action = "sit", Color = Theme.Colors.Gray },
		} },
		{ Title = "Body (value = number)", Entries = {
			{ Text = "🏃 Speed", Action = "speed", Color = Theme.Colors.Green }, { Text = "🚶 Normal speed", Action = "unspeed", Color = Theme.Colors.Gray },
			{ Text = "🦘 Jump power", Action = "jump", Color = Theme.Colors.Green }, { Text = "📏 Size", Action = "size", Color = Theme.Colors.Purple },
			{ Text = "👻 Invisible", Action = "invisible", Color = Theme.Colors.Gray }, { Text = "👀 Visible", Action = "visible", Color = Theme.Colors.Blue },
			{ Text = "🧱 Noclip", Action = "noclip", Color = Theme.Colors.Purple }, { Text = "🧍 Clip", Action = "clip", Color = Theme.Colors.Gray },
		} },
		{ Title = "Effects", Entries = {
			{ Text = "✨ Sparkles", Action = "sparkles", Color = Theme.Colors.Yellow }, { Text = "🔥 Fire", Action = "fire", Color = Theme.Colors.Orange },
			{ Text = "💨 Smoke", Action = "smoke", Color = Theme.Colors.Gray }, { Text = "🧹 Remove effects", Action = "unfx", Color = Theme.Colors.Gray },
		} },
		{ Title = "🛡 Admin access (owner only; saved, the code stops working for them)", OwnerOnly = true, Entries = {
			{ Text = "🚫 Remove admin", Action = "", Cmd = "RevokeAdmin", Color = Theme.Colors.Red },
			{ Text = "✅ Give admin back", Action = "", Cmd = "RestoreAdmin", Color = Theme.Colors.Green },
		} },
		{ Title = "Moderation (owner only)", OwnerOnly = true, Entries = {
			{ Text = "👢 Kick", Action = "kick", Color = Theme.Colors.Red }, { Text = "⛔ Ban (this server)", Action = "ban", Color = Theme.Colors.Red },
			{ Text = "✅ Unban all", Action = "unbanall", Color = Theme.Colors.Green },
		} },
		{ Title = "Server (owner only; value = message / hour / gravity)", OwnerOnly = true, Entries = {
			{ Text = "📢 Announce", Action = "announce", Color = Theme.Colors.Yellow }, { Text = "🕒 Time of day", Action = "time", Color = Theme.Colors.Blue },
			{ Text = "🌙 Gravity", Action = "gravity", Color = Theme.Colors.Purple }, { Text = "🛑 Shut down", Action = "shutdown", Color = Theme.Colors.Red },
		} },
	}
	local ownerOnly: { GuiObject } = {}
	for _, group in groups do
		local grid, label = section(group.Title, 150)
		if group.OwnerOnly then
			table.insert(ownerOnly, grid)
			table.insert(ownerOnly, label)
		end
		for _, entry in group.Entries do
			button(grid, entry.Text, entry.Color, function()
				if entry.Cmd then
					command(entry.Cmd, choices[choice].Target)
				else
					run(entry.Action)
				end
			end)
		end
	end
	State.OnAttribute("AdminOwner", function(value)
		for _, item in ownerOnly do
			item.Visible = value == true
		end
		refreshChoices()
	end)
end

local function build()
	buildHD()
	-- Money
	local money = section("💵 Money")
	for _, entry in { { Text = "+1K", Amount = 1e3 }, { Text = "+1M", Amount = 1e6 }, { Text = "+1B", Amount = 1e9 }, { Text = "+1T", Amount = 1e12 }, { Text = "+1Qa", Amount = 1e15 }, { Text = "+1Qi", Amount = 1e18 } } do
		button(money, entry.Text, Theme.Colors.Green, function()
			command("Money", entry.Amount)
		end)
	end
	button(money, "x10 money", Theme.Colors.Green, function()
		command("Money", "x10")
	end)

	-- Speed + upgrades
	local speed = section("⚡ Speed & upgrades")
	for _, amount in { 1e3, 1e5, 1e7, 1e9 } do
		button(speed, `+{Format.Number(amount)} speed`, Theme.Colors.Purple, function()
			command("Speed", amount)
		end)
	end
	button(speed, "Reset speed", Theme.Colors.Gray, function()
		command("ResetSpeed")
	end)
	button(speed, "Max treadmill", Theme.Colors.Orange, function()
		command("MaxTreadmill")
	end)
	button(speed, "+Bigger base", Theme.Colors.Blue, function()
		command("Expand")
	end)

	-- Your base
	local base = section("🏠 Your base", 170)
	button(base, "💸 Reset money", Theme.Colors.Gray, function()
		command("ResetMoney")
	end)
	button(base, "🍩 Clear all donuts", Theme.Colors.Gray, function()
		command("ClearDonuts")
	end)
	-- Only the game's owner sees these: bases past the biggest you can buy, and the owner's own skin
	local ownerButtons = {
		button(base, "👑 Bigger base", Theme.Colors.Yellow, function()
			command("GrowBase", 1)
		end),
		button(base, "👑 Max base", Theme.Colors.Yellow, function()
			command("GrowBase", 99)
		end),
		button(base, "👑 Smaller base", Theme.Colors.Orange, function()
			command("GrowBase", -1)
		end),
		button(base, "👑 Owner skin", Theme.Colors.Purple, function()
			command("OwnerSkin")
		end),
		button(base, "👑 🌌 ETERNAL STORM", Color3.fromRGB(150, 60, 230), function()
			command("EternalStorm")
		end),
	}
	State.OnAttribute("AdminOwner", function(value)
		for _, b in ownerButtons do
			b.Visible = value == true
		end
	end)

	-- Donuts: pick one, a mutation and a size
	local donutSection = section("🍩 Donuts (pick one, then give or spawn it)", 150)
	local mutations = { "None" }
	for _, mutation in Rarities.Mutations do
		if mutation.Order > 0 then
			table.insert(mutations, mutation.Id)
		end
	end
	local sizes = {}
	for _, size in Rarities.Sizes do
		table.insert(sizes, size.Id)
	end
	local selected = Donuts.List[1].Id
	local mutationIndex, sizeIndex = 1, 2
	local selectedLabel: TextButton
	local mutationButton: TextButton
	local sizeButton: TextButton
	local function refreshSelection()
		local donut = Donuts.ById[selected]
		Theme.SetButtonText(selectedLabel, donut.Name)
		Theme.SetButtonColor(selectedLabel, Rarities.Get(donut.Rarity).Color)
		Theme.SetButtonText(mutationButton, "Mutation: " .. mutations[mutationIndex])
		Theme.SetButtonText(sizeButton, "Size: " .. sizes[sizeIndex])
	end
	selectedLabel = button(donutSection, "", Theme.Colors.Gray, function() end)
	mutationButton = button(donutSection, "", Theme.Colors.Pink, function()
		mutationIndex = mutationIndex % #mutations + 1
		refreshSelection()
	end)
	sizeButton = button(donutSection, "", Theme.Colors.Blue, function()
		sizeIndex = sizeIndex % #sizes + 1
		refreshSelection()
	end)
	button(donutSection, "➕ Give to base", Theme.Colors.Green, function()
		command("Donut", { DonutId = selected, Mutation = mutations[mutationIndex], Size = sizes[sizeIndex] })
	end)
	local list = section("", 150)
	local sorted = table.clone(Donuts.List)
	table.sort(sorted, function(a, b)
		local ra, rb = Rarities.Get(a.Rarity).Order, Rarities.Get(b.Rarity).Order
		if ra ~= rb then
			return ra > rb
		end
		return a.Income > b.Income
	end)
	for _, donut in sorted do
		local b = button(list, donut.Name, Rarities.Get(donut.Rarity).Color, function()
			selected = donut.Id
			refreshSelection()
		end)
		b.LayoutOrder = Rarities.Get(donut.Rarity).Order * -1000 + donut.Index
	end
	refreshSelection()

	-- Boxes: pick a box (tier, size, mutation, biome), then give it or drop it
	local boxSection = section("📦 Boxes (pick one, then give or drop it)", 150)
	local tiers, boxSizes = {}, {}
	for _, tier in Boxes.Tiers do
		table.insert(tiers, tier.Id)
	end
	for _, size in Boxes.Sizes do
		table.insert(boxSizes, size.Id)
	end
	local tierIndex, boxSizeIndex, boxMutationIndex, biome = 2, 1, 1, 2
	local tierButton: TextButton
	local boxSizeButton: TextButton
	local boxMutationButton: TextButton
	local biomeButton: TextButton
	local function refreshBox()
		local tier = Boxes.Tier(tiers[tierIndex])
		Theme.SetButtonText(tierButton, tier.Name)
		Theme.SetButtonColor(tierButton, tier.Color)
		Theme.SetButtonText(boxSizeButton, "Size: " .. Boxes.Size(boxSizes[boxSizeIndex]).Name)
		Theme.SetButtonText(boxMutationButton, "Mutation: " .. mutations[boxMutationIndex])
		Theme.SetButtonText(biomeButton, `Biome {biome}: {Areas.List[biome].Name}`)
		Theme.SetButtonColor(biomeButton, Areas.List[biome].Trim)
	end
	tierButton = button(boxSection, "", Theme.Colors.Gray, function()
		tierIndex = tierIndex % #tiers + 1
		refreshBox()
	end)
	boxSizeButton = button(boxSection, "", Theme.Colors.Blue, function()
		boxSizeIndex = boxSizeIndex % #boxSizes + 1
		refreshBox()
	end)
	boxMutationButton = button(boxSection, "", Theme.Colors.Pink, function()
		boxMutationIndex = boxMutationIndex % #mutations + 1
		refreshBox()
	end)
	biomeButton = button(boxSection, "", Theme.Colors.Gray, function()
		biome = biome % #Areas.List + 1
		refreshBox()
	end)
	button(boxSection, "➕ To inventory", Theme.Colors.Green, function()
		command("Box", { Tier = tiers[tierIndex], Size = boxSizes[boxSizeIndex], Mutation = mutations[boxMutationIndex], Area = biome })
	end)
	button(boxSection, "📍 Drop here", Theme.Colors.Orange, function()
		command("SpawnBox", { Tier = tiers[tierIndex], Size = boxSizes[boxSizeIndex], Mutation = mutations[boxMutationIndex] })
	end)
	button(boxSection, "⏩ Open my boxes", Theme.Colors.Purple, function()
		command("OpenBoxes")
	end)
	button(boxSection, "🔄 New boxes everywhere", Theme.Colors.Yellow, function()
		command("ResetBoxes")
	end)
	refreshBox()

	-- Eggs & pets
	local eggs = section("🥚 Eggs & pets", 150)
	for _, egg in Pets.Eggs do
		button(eggs, "+ " .. egg.Name, egg.Accent, function()
			command("Egg", egg.Id)
		end)
	end
	button(eggs, "Hatch all NOW", Theme.Colors.Green, function()
		command("HatchAll")
	end)
	button(eggs, "Clear incubator", Theme.Colors.Gray, function()
		command("ClearEggs")
	end)
	local pets = section("", 150)
	for _, pet in Pets.List do
		button(pets, "+ " .. pet.Name, Pets.Rarity(pet.Rarity).Color, function()
			command("Pet", pet.Id)
		end)
	end

	-- Crates
	local crates = section("🎁 Crates (open = free, spawn = in the area you're in)", 150)
	for _, crate in Crates.List do
		button(crates, "Open " .. crate.Name, crate.Color, function()
			command("OpenCrate", crate.Id)
		end)
	end
	for _, crate in Crates.List do
		button(crates, "Spawn " .. crate.Id, crate.Color:Lerp(Color3.new(0, 0, 0), 0.3), function()
			command("SpawnCrate", crate.Id)
		end)
	end

	-- Fun
	local fun = section("✨ Fun", 150)
	button(fun, "🍀 Luck Event", Theme.Colors.Green, function()
		command("Luck")
	end)
	button(fun, "🎲 Random event", Theme.Colors.Orange, function()
		command("Event")
	end)
	button(fun, "🕊 Fly", Theme.Colors.Blue, function()
		command("Fly", "Fly")
	end)
	button(fun, "🧞 Magic carpet", Theme.Colors.Pink, function()
		command("Fly", "Carpet")
	end)
	button(fun, "🚶 Stop flying", Theme.Colors.Gray, function()
		command("Fly", "Off")
	end)
	local god = button(fun, `🛡 {Config.Guard.Name} can't catch me`, Theme.Colors.Purple, function()
		command("GodMode")
	end)
	State.Changed:Connect(function()
		Theme.SetButtonColor(god, if State.Data.GodMode then Theme.Colors.Green else Theme.Colors.Purple)
	end)

	-- Server events (whole server, one at a time)
	local events = section("🌍 Start a server event (for the whole server)", 150)
	for _, event in Events.List do
		if not event.OwnerOnly then
			button(events, event.Name, event.Color, function()
				command("Event", event.Id)
			end)
		end
	end

	-- Teleport
	local teleport = section("🌀 Teleport to biome", 60)
	for _, area in Areas.List do
		button(teleport, tostring(area.Id), area.Trim, function()
			command("Teleport", area.Id)
		end)
	end
end

function Admin.Open()
	if State.Get("Admin") == true then
		modal:Open()
	end
end

function Admin.Init()
	modal = Modal.new("🛠 ADMIN PANEL", Theme.Colors.Red, Vector2.new(720, 520))
	scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		Parent = modal.Body,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
	})
	local built = false
	modal.OnOpen = function()
		if not built then
			built = true
			build()
		end
	end
	Remotes.Event("AdminPanel").OnClientEvent:Connect(function()
		modal:Open()
	end)
	-- Admin taken away: close the panel
	State.OnAttribute("Admin", function(value)
		if value ~= true and modal:IsOpen() then
			modal:Close()
		end
	end)
end

return Admin
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">BaseSize</string>
              <string name="Source"><![CDATA[--[[
	Base size window: what the base code ("ender=rich" in chat) unlocks - just the BIGGER / SMALLER
	base buttons, nothing else from the admin panel. (Donuts that don't fit a smaller base are kept
	safe and come back when it's bigger again.) It opens by itself the moment the code is typed, and
	again from the 🏢 BASE button on the HUD. Bases grow up to Config.Admin.MaxSlots donuts (as big
	as a pen can get on its plot: see Config). The server checks every press.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Economy)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local BaseSize = {}

local modal: Modal.Modal

function BaseSize.Open()
	modal:Open()
end

function BaseSize.Init()
	modal = Modal.new("🏢 BIGGER BASE", Theme.Colors.Blue, Vector2.new(480, 300))
	local body = modal.Body
	local info = Theme.Label({
		Text = "",
		Font = Theme.Font,
		RichText = true,
		Size = UDim2.new(1, 0, 0, 96),
		StrokeThickness = 1.5,
		Parent = body,
	})
	local one = Theme.Button({ Text = "BIGGER", Icon = "🏢", Color = Theme.Colors.Green, Size = UDim2.fromOffset(140, 66), Position = UDim2.new(0.5, -216, 0, 112), Parent = body })
	local smaller = Theme.Button({ Text = "SMALLER", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(140, 66), Position = UDim2.new(0.5, -70, 0, 112), Parent = body })
	local max = Theme.Button({ Text = "MAX SIZE", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(140, 66), Position = UDim2.new(0.5, 76, 0, 112), Parent = body })
	local top = Economy.AdminMaxBaseLevel()
	one.Activated:Connect(function()
		State.Action("GrowBase", 1)
	end)
	smaller.Activated:Connect(function()
		State.Action("GrowBase", -1)
	end)
	max.Activated:Connect(function()
		State.Action("GrowBase", top)
	end)

	State.OnAttribute("BaseLevel", function()
		local level = math.max(State.Number("BaseLevel"), 1)
		local full = level >= top
		info.Text = `Your base holds <font color="#8dff6a"><b>{Economy.SlotCount(level)}</b></font> donuts\n`
			.. (if full then "That's as big as a base gets!" else `<font size="20">Grow it to hold up to {Economy.SlotCount(top)}</font>`)
		Theme.SetButtonColor(one, if full then Theme.Colors.Gray else Theme.Colors.Green)
		Theme.SetButtonColor(max, if full then Theme.Colors.Gray else Theme.Colors.Blue)
		Theme.SetButtonColor(smaller, if level <= 1 then Theme.Colors.Gray else Theme.Colors.Orange)
	end)
	-- Open it the moment the code is typed
	local opened = false
	State.OnAttribute("SizeAccess", function(value)
		if value == true and not opened then
			opened = true
			modal:Open()
		end
	end)
end

return BaseSize
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">Chase</string>
              <string name="Source"><![CDATA[--[[
	Chase UI: everything that happens during a steal.
	  - "RUN!" banner with live distance to Domer and to the lobby, red screen edges
	  - Domer's footsteps: heavy thuds that get louder as he closes in, and the camera shakes when
	    he's right behind you (Config.Guard FootstepRange / ShakeRange / MaxShake)
	  - "📦 BOX SECURED!" when you get a box back to the lobby (it goes into your inventory)
	  - "CAUGHT!" screen (with a comedic fling): the box went back to Domer, or fell on the ground
	  - A small "Drop" button while you carry a box
	  - "Welcome back" popup for offline earnings
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Boxes = require(Shared.Boxes)
local Donuts = require(Shared.Donuts)
local Rarities = require(Shared.Rarities)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Pets = require(Shared.Pets)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local Bases = require(script.Parent.Parent.Bases)

local Settings = require(script.Parent.Settings)

local Chase = {}

local player = Players.LocalPlayer :: Player

local STEP_SOUND = "rbxasset://sounds/action_jump_land.mp3"

local gui: ScreenGui
local banner: Frame
local bannerTitle: TextLabel
local bannerInfo: TextLabel
local edges: { Frame } = {}
local chaseConnection: RBXScriptConnection? = nil
local beam: Beam? = nil
local beamAttachments: { Attachment } = {}

local function rootPart(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function humanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function setEdges(visible: boolean, color: Color3?)
	for _, edge in edges do
		edge.Visible = visible
		if color then
			edge.BackgroundColor3 = color
		end
	end
end

local function setEdgeStrength(alpha: number)
	for _, edge in edges do
		local gradient = edge:FindFirstChildOfClass("UIGradient")
		if gradient then
			gradient.Transparency = NumberSequence.new(alpha, 1)
		end
	end
end

local function showBanner(visible: boolean)
	banner.Visible = visible
	Notifications.SetToastOffset(if visible then 84 else 0)
end

local function clearBeam()
	if beam then
		beam:Destroy()
		beam = nil
	end
	for _, attachment in beamAttachments do
		attachment:Destroy()
	end
	beamAttachments = {}
end

-- Glowing guide line from you to your base (it's in the world you're in).
local function showPathHome()
	clearBeam()
	local root = rootPart()
	local plot = Bases.Mine()
	local target = plot and plot:FindFirstChild("Spawn")
	if not root or not target or not target:IsA("BasePart") then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 1, 0)
	a1.Parent = target
	local b = Instance.new("Beam")
	b.Attachment0 = a0
	b.Attachment1 = a1
	b.Color = ColorSequence.new(Theme.Colors.Yellow)
	b.Width0 = 1.2
	b.Width1 = 1.2
	b.FaceCamera = true
	b.LightEmission = 1
	b.Transparency = NumberSequence.new(0.3)
	b.Parent = root
	beam = b
	beamAttachments = { a0, a1 }
end

local function resetShake()
	local h = humanoid()
	if h then
		h.CameraOffset = Vector3.zero
	end
end

local function stopChaseLoop()
	if chaseConnection then
		chaseConnection:Disconnect()
		chaseConnection = nil
	end
	resetShake()
end

local function hideBanner()
	stopChaseLoop()
	showBanner(false)
	setEdges(false)
end

-- One heavy footstep from the guard (a 3D sound on him, so you hear where he is). A few sounds
-- are made once per chase and reused, instead of a new one every step.
local steps: { Sound } = {}
local stepIndex = 0
local function footstep(guardRoot: BasePart, volume: number)
	if not steps[1] or steps[1].Parent ~= guardRoot then
		for _, old in steps do
			old:Destroy()
		end
		steps = {}
		for i = 1, 3 do
			local sound = Instance.new("Sound")
			sound.Name = "Footstep" .. i
			sound.SoundId = STEP_SOUND
			sound.RollOffMinDistance = 20
			sound.RollOffMaxDistance = Config.Guard.FootstepRange * 2
			sound.Parent = guardRoot
			steps[i] = sound
		end
	end
	stepIndex = stepIndex % #steps + 1
	local sound = steps[stepIndex]
	sound.Volume = volume
	sound.PlaybackSpeed = 0.42 + math.random() * 0.08
	sound.TimePosition = 0
	sound:Play()
end

type ChaseInfo = { DonutId: string, AreaId: number, Kind: string?, Guard: Model?, GuardSpeed: number?, Mutation: string?, Size: string? }

local function onChaseStarted(info: ChaseInfo)
	Settings.SetChasing(true)
	local kind = info.Kind or "Box"
	local donut = Donuts.ById[info.DonutId]
	local rarity = donut and Rarities.Get(donut.Rarity)
	local size = Rarities.Size(info.Size)
	showBanner(true)
	bannerTitle.Text = `🏃 RUN! {string.upper(Config.Guard.Name)} IS AFTER YOU!`
	bannerTitle.TextColor3 = Color3.fromRGB(255, 80, 80)
	setEdges(true, Color3.fromRGB(255, 0, 0))
	Theme.PlaySound("Grab")
	if kind == "Shard" then
		-- (nobody chases you for a meteor shard: just get it back over the lobby line)
		bannerTitle.Text = "☄️ Bring the meteor shard back to the lobby!"
		bannerTitle.TextColor3 = Color3.fromRGB(215, 160, 255)
		setEdges(true, Color3.fromRGB(160, 80, 255))
		Notifications.Toast("You grabbed a METEOR SHARD! Don't get hit - you'll drop it!", "rare")
	else
		Theme.PlaySound("Steal")
	end
	if kind == "Shard" then
		-- (the toast above)
	elseif kind == "Box" then
		-- (for a box, DonutId is the box tier)
		local tier = Boxes.Tier(info.DonutId)
		local boxSize = Boxes.Size(info.Size)
		Notifications.Toast(`You grabbed a {Rarities.DisplayName(Boxes.DisplayName(tier.Id, boxSize.Id), info.Mutation, nil)}! Get it to the lobby!`, "rare")
		if boxSize.CarrySpeed < 1 then
			Notifications.Toast(`🐌 It's a {boxSize.Name} box! You're {math.floor((1 - boxSize.CarrySpeed) * 100 + 0.5)}% slower while carrying it.`, "error")
		end
	elseif kind == "Egg" then
		local egg = Pets.EggById[info.DonutId]
		if egg then
			Notifications.Toast(`You grabbed a {egg.Name}! Bring it to your incubator!`, "rare")
		end
	elseif donut and rarity then
		Notifications.Toast(`You grabbed {Rarities.DisplayName(donut.Name, info.Mutation, info.Size)} ({rarity.Id})!`, "rare")
		if size.CarrySpeed < 1 then
			Notifications.Toast(`🐌 It's {string.lower(size.Id)}! You're {math.floor((1 - size.CarrySpeed) * 100 + 0.5)}% slower while carrying it.`, "error")
		end
	end

	stopChaseLoop()
	local pulse = 0
	local nextStep = 0
	local lastText = ""
	local nextText = 0
	local nextGlow = 0
	chaseConnection = RunService.RenderStepped:Connect(function(dt)
		pulse += dt
		local root = rootPart()
		if not root then
			return
		end
		local toSafe = math.max(0, root.Position.Z - Config.Map.SafeZoneZ)
		local text = `🛡 Lobby: {math.floor(toSafe)} studs`
		local closeness = 0
		local guard = info.Guard
		local guardRoot = guard and guard.Parent and guard.PrimaryPart
		if guardRoot then
			local offset = guardRoot.Position - root.Position
			local gap = Vector2.new(offset.X, offset.Z).Magnitude
			text ..= `   •   😡 {Config.Guard.Name}: {math.floor(gap)} studs behind`
			-- Footsteps (faster the faster he runs) and screen shake when he's close
			local speed = Vector2.new(guardRoot.AssemblyLinearVelocity.X, guardRoot.AssemblyLinearVelocity.Z).Magnitude
			if gap < Config.Guard.FootstepRange and speed > 2 and pulse >= nextStep then
				local stride = 2.2 * Config.Guard.Scale
				nextStep = pulse + math.clamp(stride / speed, 0.17, 0.6)
				footstep(guardRoot, math.clamp(0.9 * (1 - gap / Config.Guard.FootstepRange), 0.1, 0.9))
			end
			closeness = math.clamp(1 - gap / Config.Guard.ShakeRange, 0, 1)
		end
		local h = humanoid()
		if h then
			if closeness > 0 then
				local strength = Config.Guard.MaxShake * closeness ^ 1.4
				h.CameraOffset = Vector3.new(math.noise(pulse * 18, 0.3) * strength, math.noise(pulse * 18, 7.1) * strength, 0)
			elseif h.CameraOffset ~= Vector3.zero then
				h.CameraOffset = Vector3.zero
			end
		end
		-- (only touch the label when the numbers change, at most 10 times a second: re-fitting
		-- scaled text every frame is slow on phones)
		if text ~= lastText and pulse >= nextText then
			lastText = text
			nextText = pulse + 0.1
			bannerInfo.Text = text
		end
		-- The red glow pulses faster and stronger the closer he gets (30 updates a second is plenty)
		if pulse >= nextGlow then
			nextGlow = pulse + 1 / 30
			local rate = 5 + closeness * 10
			setEdgeStrength(0.6 - closeness * 0.35 + math.sin(pulse * rate) * 0.1)
		end
	end)
end

local function flingSelf(velocity: Vector3?)
	local character = player.Character
	local root = rootPart()
	local h = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not h then
		return
	end
	h:ChangeState(Enum.HumanoidStateType.FallingDown)
	-- Caught: launched high and far back towards the hub, spinning (like getting bonked in Steal an Egg)
	root.AssemblyLinearVelocity = velocity or Vector3.new(math.random(-25, 25), 95, -130)
	root.AssemblyAngularVelocity = Vector3.new(math.random(-12, 12), math.random(-12, 12), math.random(-12, 12))
	Theme.PlaySound("Fling")
	task.delay(if velocity then 1.2 else 1.9, function()
		if h.Parent then
			h:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

local function bigText(text: string, color: Color3, duration: number)
	local label = Theme.Label({
		Text = text,
		TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.fromScale(0.7, 0.12),
		StrokeThickness = 5,
		Parent = gui,
	})
	local scale = Theme.new("UIScale", { Scale = 0.3, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(duration, function()
		TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.4)
		label:Destroy()
	end)
end

type ChaseResult = { Result: string, DonutId: string?, IsNew: boolean?, Reason: string?, Mutation: string?, Size: string?, Kind: string?, EggId: string?, Tier: string?, BoxBack: boolean?, Count: number?, Cost: number? }

local function onChaseEnded(result: ChaseResult)
	Settings.SetChasing(false)
	if result.Result == "Safe" then
		stopChaseLoop()
		setEdges(true, Color3.fromRGB(0, 170, 255))
		bannerTitle.Text = if result.Kind == "Egg" then "🛡 SAFE! Bring the egg to your base!" else "🛡 SAFE! Bring the donut to your base!"
		bannerTitle.TextColor3 = Color3.fromRGB(110, 210, 255)
		bannerInfo.Text = "Follow the yellow line ⬇"
		task.delay(1.2, function()
			if bannerTitle.Text:find("SAFE") then
				setEdges(false)
			end
		end)
		showPathHome()
	elseif result.Result == "Deposited" then
		hideBanner()
		clearBeam()
		if result.Kind == "Egg" then
			local egg = result.EggId and Pets.EggById[result.EggId]
			bigText("🥚 EGG SECURED!", if egg then egg.Accent else Theme.Colors.Pink, 2)
			Theme.PlaySound("Deposit")
			return
		elseif result.Kind == "Shard" then
			local count, cost = result.Count or 0, result.Cost or Config.CosmicDonut.ShardCost
			bigText(`☄️ METEOR SHARD! {count}/{cost}`, Color3.fromRGB(205, 140, 255), 2.2)
			if count >= cost then
				Notifications.Banner("THE COSMIC DONUT", Color3.fromRGB(170, 90, 255), 3, "You have enough shards! Craft it at the Cosmic Forge by the spawn")
			end
			Theme.PlaySound("Deposit")
			return
		elseif result.Kind == "Box" then
			local tier = Boxes.Tier(result.Tier)
			local mutation = Rarities.Mutation(result.Mutation)
			local color = if mutation.Order > 0 then mutation.Color else tier.Color
			bigText("📦 BOX SECURED!", color, 2)
			Notifications.Banner(Rarities.DisplayName(Boxes.DisplayName(tier.Id, result.Size), result.Mutation, nil), color, 2.5, "In your inventory • hold it and click in your pen")
			Theme.PlaySound("Deposit")
			return
		end
		local donut = result.DonutId and Donuts.ById[result.DonutId]
		if donut then
			local rarity = Rarities.Get(donut.Rarity)
			local mutation = Rarities.Mutation(result.Mutation)
			local color = if mutation.Order > 0 then mutation.Color else rarity.Color
			bigText(if result.IsNew then "✨ NEW DONUT! ✨" else "🍩 DONUT SECURED!", color, 2)
			local income = Economy.DonutIncome(donut.Id, 1, result.Mutation, result.Size)
			Notifications.Banner(Rarities.DisplayName(donut.Name, result.Mutation, result.Size), color, 2.5, `{rarity.Id} • {Format.Money(income)}/s`)
		end
		Theme.PlaySound("Deposit")
	elseif result.Result == "Caught" then
		hideBanner()
		clearBeam()
		setEdges(true, Color3.fromRGB(255, 0, 0))
		bigText(`CAUGHT BY {string.upper(Config.Guard.Name)}!`, Color3.fromRGB(255, 70, 70), 1.8)
		if result.Kind == "Box" then
			Notifications.Toast(if result.BoxBack
				then `{Config.Guard.Name} took the box back. Try again!`
				else "You dropped the box! Grab it before someone else does!", "error")
		else
			Notifications.Toast("It went back where you found it. Try again!", "error")
		end
		Theme.PlaySound("Caught")
		flingSelf()
		task.delay(1.5, function()
			setEdges(false)
		end)
	else -- Lost
		hideBanner()
		clearBeam()
		if result.Reason then
			Notifications.Toast(result.Reason, "error")
		end
	end
end

local function buildOfflinePopup()
	local modal = Modal.new("🌙 WELCOME BACK!", Theme.Colors.Purple, Vector2.new(500, 290))
	local text = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, Size = UDim2.new(1, 0, 0, 120), StrokeThickness = 1.5, Parent = modal.Body })
	local collect = Theme.Button({ Text = "COLLECT!", Icon = "💰", Color = Theme.Colors.Green, Size = UDim2.fromOffset(230, 58), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Parent = modal.Body })
	collect.Activated:Connect(function()
		modal:Close()
		Theme.PlaySound("Collect")
	end)
	Remotes.Event("OfflineEarnings").OnClientEvent:Connect(function(amount: number, seconds: number, capped: boolean?)
		local capText = if capped then `\n<font size="18">(offline earnings are capped at {Config.Offline.MaxHours}h)</font>` else ""
		text.Text = `Your donuts kept working while you were away for <b>{Format.Duration(seconds)}</b>!\n\n<font color="#8dff6a" size="40"><b>+{Format.Money(amount)}</b></font>{capText}`
		modal:Open()
	end)
end

function Chase.Init()
	gui = Theme.ScreenGui("Chase", 5)

	-- Small "Drop" button, only while you carry a box. Kept small and away from the other buttons (right side, under the middle) so it isn't hit by accident.
	local dropHolder = Theme.new("Frame", {
		Name = "DropCarried", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.64, 0),
		Size = UDim2.fromOffset(112, 32), BackgroundTransparency = 1, Visible = false, Parent = gui,
	})
	Theme.AutoScale(dropHolder)
	local drop = Theme.Button({ Text = "✋ Drop box", Color = Theme.Colors.Gray, Size = UDim2.fromScale(1, 1), Parent = dropHolder })
	drop.Activated:Connect(function()
		Remotes.Event("Action"):FireServer("DropCarried")
	end)
	local function updateDrop()
		dropHolder.Visible = player:GetAttribute("CarryKind") == "Box"
	end
	player:GetAttributeChangedSignal("CarryKind"):Connect(updateDrop)
	updateDrop()

	-- Red/blue glow around the screen edges. Its own ScreenGui that ignores the top bar and the
	-- phone notch/safe area, so the glow reaches every edge of the screen.
	local edgeGui = Theme.ScreenGui("ChaseGlow", 3)
	edgeGui.IgnoreGuiInset = true
	edgeGui.ScreenInsets = Enum.ScreenInsets.None
	local edgeDefs = {
		{ Size = UDim2.new(1, 0, 0.18, 0), Position = UDim2.fromScale(0, 0), Rotation = 90 },
		{ Size = UDim2.new(1, 0, 0.18, 0), Position = UDim2.fromScale(0, 0.82), Rotation = -90 },
		{ Size = UDim2.new(0.12, 0, 1, 0), Position = UDim2.fromScale(0, 0), Rotation = 0 },
		{ Size = UDim2.new(0.12, 0, 1, 0), Position = UDim2.fromScale(0.88, 0), Rotation = 180 },
	}
	for _, def in edgeDefs do
		local edge = Theme.new("Frame", {
			Size = def.Size,
			Position = def.Position,
			BackgroundColor3 = Color3.fromRGB(255, 0, 0),
			BorderSizePixel = 0,
			Visible = false,
			Parent = edgeGui,
		}, {
			Theme.new("UIGradient", { Rotation = def.Rotation, Transparency = NumberSequence.new(0.5, 1) }),
		})
		table.insert(edges, edge)
	end

	banner = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 186),
		Size = UDim2.fromOffset(780, 78),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	Theme.AutoScale(banner)
	bannerTitle = Theme.Label({ Text = "", Size = UDim2.new(1, 0, 0, 46), StrokeThickness = 4, Parent = banner })
	bannerInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 49), StrokeThickness = 2, Parent = banner })

	Remotes.Event("ChaseStarted").OnClientEvent:Connect(onChaseStarted)
	Remotes.Event("Flung").OnClientEvent:Connect(function(velocity: Vector3)
		flingSelf(velocity)
		Theme.PlaySound("Caught")
	end)
	Remotes.Event("ChaseEnded").OnClientEvent:Connect(onChaseEnded)
	player.CharacterAdded:Connect(function()
		hideBanner()
		clearBeam()
	end)
	buildOfflinePopup()
end

return Chase
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">ChaseMusic</string>
              <string name="Source"><![CDATA[--[[
	ChaseMusic: the scary loop that plays while Domer chases you (Settings starts and stops it).

	Built from sounds every Roblox client already has, so it can never fail to load:
	  * a low rumbling drone (two slowed-down wind loops slightly out of tune with each other)
	  * a heartbeat ("lub-dub") that speeds up the longer the chase goes on
	  * a soft, low boom every two bars and a faint creepy note every other bar
	  * a gentle whoosh when the chase starts
	All of it runs through a soft reverb, an EQ that takes the edge off the highs and a compressor
	that evens out the peaks, so it's tense but never harsh, and no louder than the normal music.
	The sounds are made (and preloaded) when the game starts, so the first chase doesn't stutter.
	A real track in Config.Music.Chase replaces it.
]]

local ContentProvider = game:GetService("ContentProvider")

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local ChaseMusic = {}

local START_BPM, TOP_BPM, RAMP_SECONDS = 96, 138, 30
local LOUDNESS = 0.9 -- relative to the music volume setting

local group: SoundGroup? = nil
local sounds: { [string]: Sound } = {}
local playing = false
local token = 0

local function make(name: string, id: string, speed: number, volume: number, looped: boolean?): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.PlaybackSpeed = speed
	sound.Volume = volume
	sound.Looped = looped == true
	sound.SoundGroup = group
	sound.Parent = group
	sounds[name] = sound
	return sound
end

local function setup()
	if group then
		return
	end
	local g = Instance.new("SoundGroup")
	g.Name = "ChaseMusic"
	g.Volume = 0
	g.Parent = SoundService
	group = g
	local eq = Instance.new("EqualizerSoundEffect")
	eq.LowGain = 2 -- (a big bass boost distorts on phone speakers)
	eq.MidGain = -1
	eq.HighGain = -12 -- takes the sharp edge off everything
	eq.Priority = 3
	eq.Parent = g
	local compressor = Instance.new("CompressorSoundEffect")
	compressor.Threshold = -20
	compressor.Ratio = 4
	compressor.Attack = 0.01
	compressor.Release = 0.2
	compressor.Priority = 2
	compressor.Parent = g
	local reverb = Instance.new("ReverbSoundEffect")
	reverb.DecayTime = 1.6
	reverb.Density = 1
	reverb.WetLevel = -12
	reverb.Priority = 1
	reverb.Parent = g
	make("Drone", "rbxasset://sounds/action_falling.mp3", 0.32, 0.5, true)
	make("Drone2", "rbxasset://sounds/action_falling.mp3", 0.45, 0.18, true)
	make("Lub", "rbxasset://sounds/action_jump_land.mp3", 0.55, 0.75)
	make("Dub", "rbxasset://sounds/action_jump_land.mp3", 0.63, 0.45)
	make("Boom", "rbxasset://sounds/action_jump_land.mp3", 0.34, 0.6)
	make("Ping", "rbxasset://sounds/electronicpingshort.wav", 0.42, 0.12)
	make("Ping2", "rbxasset://sounds/electronicpingshort.wav", 0.445, 0.1)
	make("Whoosh", "rbxasset://sounds/Rocket whoosh 01.wav", 0.45, 0.5)
end

-- Make the sounds now (and load them) so starting the first chase costs nothing.
function ChaseMusic.Preload()
	setup()
	task.spawn(function()
		local list = {}
		for _, sound in sounds do
			table.insert(list, sound)
		end
		pcall(function()
			ContentProvider:PreloadAsync(list)
		end)
	end)
end

local function hit(name: string)
	local sound = sounds[name]
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

function ChaseMusic.IsPlaying(): boolean
	return playing
end

-- `volume`: the player's music volume (0-1).
function ChaseMusic.SetVolume(volume: number)
	if group and playing then
		TweenService:Create(group, TweenInfo.new(0.4), { Volume = volume * LOUDNESS }):Play()
	end
end

function ChaseMusic.Start(volume: number)
	setup()
	if playing then
		ChaseMusic.SetVolume(volume)
		return
	end
	playing = true
	token += 1
	local myToken = token
	local g = group :: SoundGroup
	TweenService:Create(g, TweenInfo.new(0.5), { Volume = volume * LOUDNESS }):Play()
	sounds.Drone:Play()
	sounds.Drone2:Play()
	hit("Whoosh")
	task.spawn(function()
		local started = os.clock()
		local beat = 0
		while playing and token == myToken do
			local t = os.clock() - started
			local bpm = START_BPM + (TOP_BPM - START_BPM) * math.min(1, t / RAMP_SECONDS)
			local interval = 60 / bpm
			hit("Lub")
			if beat % 8 == 0 then
				hit("Boom")
			end
			if beat % 8 == 4 then
				hit(if (beat // 8) % 2 == 0 then "Ping" else "Ping2")
			end
			task.wait(math.min(0.17, interval * 0.3))
			if not playing or token ~= myToken then
				break
			end
			hit("Dub")
			task.wait(math.max(0.05, interval - math.min(0.17, interval * 0.3)))
			beat += 1
		end
	end)
end

function ChaseMusic.Stop()
	if not playing then
		return
	end
	playing = false
	token += 1
	local myToken = token
	local g = group :: SoundGroup
	TweenService:Create(g, TweenInfo.new(0.8), { Volume = 0 }):Play()
	task.delay(0.9, function()
		if token == myToken and not playing then
			for _, sound in sounds do
				sound:Stop()
			end
		end
	end)
end

return ChaseMusic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">CosmicForge</string>
              <string name="Source"><![CDATA[--[[
	CosmicForge: the Cosmic Forge's window (server/CraftService), opened by the prompt on the
	forge's altar by the spawn. Shows The Cosmic Donut turning (its black hole horizon spinning
	round it), how much it earns, your meteor shards (Data.MeteorShards) out of the
	Config.CosmicDonut.ShardCost it costs, and how to get more. CRAFT asks the server for
	"CraftCosmic"; when it's made, the window closes and you get a big celebration.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Donuts = require(Shared.Donuts)
local DonutModel = require(Shared.DonutModel)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Notifications = require(script.Parent.Notifications)
local State = require(script.Parent.Parent.State)

local CosmicForge = {}

local rgb = Color3.fromRGB
local COSMIC = Config.CosmicDonut
local DONUT_ID = "cosmicdonut"
local VIOLET, CYAN, PINK = rgb(170, 90, 255), rgb(110, 230, 255), rgb(255, 130, 225)

type Spin = { Part: BasePart, Offset: CFrame, Axis: Vector3, Rate: number }

local modal: Modal.Modal
local shardsLabel: TextLabel
local fill: Frame
local craftButton: TextButton
local spinConnection: RBXScriptConnection? = nil
local previewModel: Model? = nil
local rings: { Spin } = {}
local others: { { Part: BasePart, Offset: CFrame } } = {}

local function shards(): number
	return State.Data.MeteorShards or 0
end

local function refresh()
	if not shardsLabel then
		return
	end
	local have, cost = shards(), COSMIC.ShardCost
	shardsLabel.Text = `☄️ Meteor Shards: <b>{have}/{cost}</b>`
	fill.Size = UDim2.fromScale(math.clamp(have / cost, 0, 1), 1)
	local text = craftButton:FindFirstChild("Text") :: TextLabel?
	if text then
		text.Text = if not COSMIC.Enabled then "FORGE CLOSED" elseif have >= cost then "CRAFT IT!" else `NEED {cost - have} MORE`
	end
end

-- The donut in the window: the whole thing turns slowly, its horizon spins round it fast.
local function buildPreview(viewport: ViewportFrame)
	local donut = Donuts.ById[DONUT_ID]
	if not donut then
		return
	end
	local model = DonutModel.Build(donut, { NoEffects = true })
	local root = model.PrimaryPart :: BasePart
	local origin = root.CFrame
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= root then
			local offset = origin:ToObjectSpace(part.CFrame)
			local axis = part:GetAttribute("Axis")
			if part:GetAttribute("Limb") == "Horizon" and typeof(axis) == "Vector3" then
				local rate = part:GetAttribute("Spin")
				table.insert(rings, { Part = part, Offset = offset, Axis = axis, Rate = if type(rate) == "number" then rate else 1 })
			else
				table.insert(others, { Part = part, Offset = offset })
			end
		end
	end
	model.Parent = viewport
	previewModel = model
	local top = (model:GetAttribute("Top") :: number?) or 2.5
	local bottom = (model:GetAttribute("Bottom") :: number?) or 2.5
	local centerY = origin.Position.Y + (top - bottom) / 2
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(origin.Position + Vector3.new(2.5, centerY - origin.Position.Y + 2, -((top + bottom) * 1.6 + 7)), Vector3.new(origin.Position.X, centerY, origin.Position.Z))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
end

local function turnPreview()
	local model = previewModel
	local root = model and model.PrimaryPart
	if not root then
		return
	end
	local now = os.clock()
	local turned = CFrame.new(root.Position) * CFrame.Angles(0, now * 0.5, 0)
	root.CFrame = turned
	for _, item in others do
		item.Part.CFrame = turned * item.Offset
	end
	for _, ring in rings do
		ring.Part.CFrame = turned * CFrame.fromAxisAngle(ring.Axis, (now * ring.Rate) % (math.pi * 2)) * ring.Offset
	end
end

function CosmicForge.Open()
	refresh()
	modal:Open()
	if not spinConnection then
		spinConnection = RunService.RenderStepped:Connect(function()
			if not modal:IsOpen() then
				local connection = spinConnection
				spinConnection = nil
				if connection then
					connection:Disconnect()
				end
				return
			end
			turnPreview()
		end)
	end
end

function CosmicForge.Close()
	modal:Close()
end

function CosmicForge.IsOpen(): boolean
	return modal ~= nil and modal:IsOpen()
end

local function hookPrompt()
	local forge = workspace:WaitForChild("CosmicForge", 120)
	local altar = forge and forge:WaitForChild("Altar", 30)
	local prompt = altar and altar:WaitForChild("CosmicForgePrompt", 30)
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Triggered:Connect(function(who: Player)
			if who == Players.LocalPlayer then
				CosmicForge.Open()
			end
		end)
	end
end

function CosmicForge.Init()
	modal = Modal.new("☄️ COSMIC FORGE", rgb(110, 50, 200), Vector2.new(640, 430))
	local body = modal.Body
	-- the donut, in a little window into space
	local viewport = Theme.new("ViewportFrame", {
		Name = "Preview",
		BackgroundColor3 = rgb(14, 8, 32),
		Size = UDim2.new(0.42, 0, 1, 0),
		Ambient = rgb(190, 170, 230),
		LightColor = rgb(255, 245, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		Parent = body,
	}, { Theme.Corner(14), Theme.Stroke(3, VIOLET), Theme.Gradient(rgb(40, 20, 80), rgb(8, 4, 20)) })
	buildPreview(viewport)
	Theme.Label({ Text = "✦ LIMITED TIME ✦", TextColor3 = PINK, Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0, 8, 1, -34), StrokeThickness = 2, Parent = viewport })

	local right = Theme.new("Frame", { Name = "Info", BackgroundTransparency = 1, Position = UDim2.new(0.42, 14, 0, 0), Size = UDim2.new(0.58, -14, 1, 0), Parent = body })
	Theme.Label({ Text = "THE COSMIC DONUT", TextColor3 = rgb(225, 195, 255), Size = UDim2.new(1, 0, 0, 40), StrokeThickness = 3, Parent = right })
	local donut = Donuts.ById[DONUT_ID]
	local income = if donut then Economy.DonutIncome(donut.Id, 1, "None", "Normal") else 0
	Theme.Label({
		Text = `<font color="#{CYAN:ToHex()}">ICON • CRAFTED</font>  💰 <b>{Format.Money(income)}/s</b>`,
		Font = Theme.Font,
		RichText = true,
		TextColor3 = rgb(140, 255, 120),
		Size = UDim2.new(1, 0, 0, 26),
		Position = UDim2.fromOffset(0, 42),
		StrokeThickness = 1.5,
		Parent = right,
	})
	Theme.Label({
		Text = "The best donut in the game! A black hole spins round it and space swirls inside it.",
		Font = Theme.Font,
		TextScaled = false,
		TextSize = 17,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 0, 46),
		Position = UDim2.fromOffset(0, 74),
		StrokeThickness = 1.2,
		Parent = right,
	})
	shardsLabel = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextColor3 = rgb(225, 195, 255), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 128), StrokeThickness = 2, Parent = right })
	local bar = Theme.new("Frame", { Name = "Progress", BackgroundColor3 = rgb(30, 18, 55), Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 162), Parent = right }, { Theme.Corner(11), Theme.Stroke(2.5) })
	fill = Theme.new("Frame", { Name = "Fill", BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(0, 1), Parent = bar }, { Theme.Corner(11), Theme.Gradient(PINK, VIOLET) })
	Theme.Label({
		Text = "How to get shards: when the <b>Eternal Storm</b> comes, a meteor smashes into the lane halfway through. Grab a shard from round its crater and run it back to the lobby. Get hit and you drop it!",
		Font = Theme.Font,
		RichText = true,
		TextScaled = false,
		TextSize = 16,
		TextWrapped = true,
		TextColor3 = rgb(200, 200, 225),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 0, 88),
		Position = UDim2.fromOffset(0, 194),
		StrokeThickness = 1,
		Parent = right,
	})
	craftButton = Theme.Button({ Name = "Craft", Text = "CRAFT IT!", Icon = "☄️", Color = VIOLET, Size = UDim2.new(1, 0, 0, 58), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = right })
	craftButton.Activated:Connect(function()
		if shards() < COSMIC.ShardCost then
			Notifications.Toast(`You need {COSMIC.ShardCost - shards()} more meteor shards!`, "error")
			return
		end
		State.Action("CraftCosmic")
	end)

	State.Changed:Connect(refresh)
	refresh()
	Remotes.Event("CosmicCrafted").OnClientEvent:Connect(function()
		modal:Close()
		Notifications.Banner("🌌 THE COSMIC DONUT 🌌", VIOLET, 4, "You crafted it! It's in your base")
		Theme.PlaySound("Event")
	end)
	task.spawn(hookPrompt)
end

return CosmicForge
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">CrateOpen</string>
              <string name="Source"><![CDATA[--[[
	Crate opening animation (Remotes "CrateOpened", sent by the server's CrateService after it has
	already given the reward): the crate shakes harder and harder, flashes open, and what you got
	pops out - an egg or pet in 3D, or a big icon for coins / Speed Boost / Luck Event.
	Several crates in a row are queued and played one after another.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Crates = require(Shared.Crates)
local CrateModel = require(Shared.CrateModel)
local PetModel = require(Shared.PetModel)
local Pets = require(Shared.Pets)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)

local CrateOpen = {}

type Info = { Crate: string, Kind: string, Amount: number?, Seconds: number?, Egg: string?, Pet: string? }

local overlay: Frame

-- A 3D model in a ViewportFrame, framed by its Top / Bottom attributes.
local function preview(parent: Instance, model: Model): ViewportFrame
	local viewport = Theme.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(180, 180, 180),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		Parent = parent,
	})
	model:PivotTo(CFrame.Angles(0, math.rad(200), 0))
	model.Parent = viewport
	local top = (model:GetAttribute("Top") :: number?) or 1.5
	local bottom = (model:GetAttribute("Bottom") :: number?) or 1.5
	local centerY = (top - bottom) / 2
	local height = top + bottom
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(Vector3.new(0, centerY + height * 0.3, -(height * 1.7 + 3)), Vector3.new(0, centerY, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

-- Big text for what you got: (icon, title, detail)
local function describe(info: Info): (string, string, string)
	if info.Kind == "Coins" then
		return "💰", Format.Money(info.Amount or 0), "Coins!"
	elseif info.Kind == "SpeedBoost" then
		return "⚡", "SPEED BOOST", `Run {math.floor((Config.Crates.SpeedBoostMultiplier - 1) * 100 + 0.5)}% faster for {Format.Duration(info.Seconds or 600)}`
	elseif info.Kind == "Luck" then
		return "🍀", "LUCK EVENT", `Better donuts for the whole server for {Format.Duration(info.Seconds or 600)}`
	elseif info.Kind == "Egg" and info.Egg and Pets.EggById[info.Egg] then
		local egg = Pets.EggById[info.Egg]
		return "🥚", string.upper(egg.Name), `In your incubator - hatches in {Format.Duration(egg.HatchSeconds)}`
	elseif info.Kind == "Pet" and info.Pet and Pets.ById[info.Pet] then
		local pet = Pets.ById[info.Pet]
		return "🐾", string.upper(pet.Name), `{pet.Rarity} pet! {Pets.BonusText(pet)}`
	end
	return "🎁", "SURPRISE", ""
end

local function play(info: Info)
	local crate = Crates.ById[info.Crate] or Crates.List[1]
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	TweenService:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 0.35 }):Play()
	local stage = Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(320, 320), BackgroundTransparency = 1, Parent = overlay })
	Theme.AutoScale(stage)
	Theme.Label({ Text = string.upper(crate.Name), TextColor3 = crate.Color:Lerp(Color3.new(1, 1, 1), 0.3), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -64), Size = UDim2.fromOffset(420, 44), StrokeThickness = 4, Parent = stage })

	-- Shake harder and harder
	local crateView = preview(stage, CrateModel.Build(crate.Id, { NoEffects = true }))
	local startedAt = os.clock()
	local shake = RunService.RenderStepped:Connect(function()
		local p = math.clamp((os.clock() - startedAt) / 1.8, 0, 1)
		crateView.Rotation = math.sin(os.clock() * (10 + p * 30)) * (3 + p * 18)
		crateView.Position = UDim2.fromOffset(math.sin(os.clock() * 45) * p * 7, 0)
	end)
	for i = 1, 3 do
		task.delay(0.5 * i, function()
			Theme.PlaySound("Crack")
		end)
	end
	task.wait(1.8)
	shake:Disconnect()

	-- Flash open
	local flash = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 5, Parent = overlay })
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	task.delay(0.7, function()
		flash:Destroy()
	end)
	Theme.PlaySound("Hatch")
	crateView:Destroy()
	if crate.Order >= 2 then
		for i = 1, 8 do
			local ray = Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(18, 440), Rotation = i * 22.5, BackgroundColor3 = crate.Color, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = stage }, {
				Theme.new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) }) }),
			})
			TweenService:Create(ray, TweenInfo.new(6, Enum.EasingStyle.Linear), { Rotation = ray.Rotation + 90 }):Play()
		end
	end

	-- What you got
	local icon, title, detail = describe(info)
	local reveal: GuiObject
	if info.Kind == "Egg" and info.Egg and Pets.EggById[info.Egg] then
		reveal = preview(stage, PetModel.BuildEgg(Pets.EggById[info.Egg], { NoEffects = true }))
	elseif info.Kind == "Pet" and info.Pet and Pets.ById[info.Pet] then
		reveal = preview(stage, PetModel.BuildPet(Pets.ById[info.Pet], { NoEffects = true }))
	else
		reveal = Theme.Label({ Text = icon, Font = Enum.Font.GothamBold, Size = UDim2.fromScale(0.6, 0.6), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Parent = stage })
	end
	local pop = Theme.new("UIScale", { Scale = 0.2, Parent = reveal })
	TweenService:Create(pop, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local titleLabel = Theme.Label({ Text = title, TextColor3 = if info.Kind == "Coins" then Theme.Colors.Money else Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.fromOffset(460, 46), StrokeThickness = 3.5, Parent = stage })
	Theme.Label({ Text = detail, Font = Theme.Font, TextColor3 = Color3.fromRGB(255, 240, 180), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 48), Size = UDim2.fromOffset(460, 26), StrokeThickness = 2, Parent = stage })
	if info.Kind == "Pet" then
		task.spawn(function()
			while titleLabel.Parent do
				titleLabel.TextColor3 = Color3.fromHSV((os.clock() * 0.4) % 1, 0.7, 1)
				task.wait()
			end
		end)
	end
	-- Spin 3D rewards slowly
	local camera = reveal:FindFirstChildOfClass("Camera")
	local spin = RunService.RenderStepped:Connect(function(dt: number)
		if camera then
			camera.CFrame = CFrame.Angles(0, dt * 0.8, 0) * camera.CFrame
		end
	end)
	task.wait(3)
	spin:Disconnect()
	TweenService:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
	stage:Destroy()
	task.wait(0.3)
	overlay.Visible = false
end

function CrateOpen.Init()
	local gui = Theme.ScreenGui("CrateOpening", 31)
	gui.IgnoreGuiInset = true
	overlay = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Visible = false, Parent = gui })
	local queue: { Info } = {}
	local playing = false
	Remotes.Event("CrateOpened").OnClientEvent:Connect(function(info: Info)
		table.insert(queue, info)
		if playing then
			return
		end
		playing = true
		while #queue > 0 do
			local nextInfo = table.remove(queue, 1)
			if nextInfo then
				play(nextInfo)
			end
		end
		playing = false
	end)
end

return CrateOpen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">Donate</string>
              <string name="Source"><![CDATA[--[[
	Donate window: tip buttons (Robux developer products, Config.Donations) and the Luck Event.
	Tips go on the TOP DONATORS leaderboard (the board in the hub) and each one gives a title shown
	above your head and in chat (your biggest tip's title is the one you keep).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Donate = {}

local modal: Modal.Modal

function Donate.Open()
	modal:Open()
end

function Donate.Init()
	modal = Modal.new("💖 SUPPORT THE GAME", Theme.Colors.Pink, Vector2.new(560, 430))
	local body = modal.Body
	local total = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 44), StrokeThickness = 1.5, Parent = body })

	local grid = Theme.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 140), Parent = body }, {
		Theme.new("UIGridLayout", { CellSize = UDim2.new(1 / 3, -8, 0, 66), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for order, product in Config.Donations.Products do
		local button = Theme.Button({ Text = `R$ {Format.Commas(product.Amount)}`, Icon = "💖", Color = Theme.Colors.Pink, Size = UDim2.new(), LayoutOrder = order, Parent = grid })
		-- the title this tip gives, under the price
		Theme.Label({
			Text = product.Title, Font = Theme.Font, TextColor3 = product.Color, StrokeThickness = 1.5,
			AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -2), Size = UDim2.new(1, -8, 0, 16), ZIndex = 5, Parent = button,
		})
		button.Activated:Connect(function()
			State.Action("Donate", product.Amount)
		end)
	end

	-- Luck Event
	local luck = Theme.new("Frame", { BackgroundColor3 = Theme.Colors.PanelLight, Position = UDim2.fromOffset(0, 196), Size = UDim2.new(1, 0, 0, 150), Parent = body }, {
		Theme.Corner(14),
		Theme.Stroke(3, Color3.fromRGB(60, 200, 90)),
	})
	Theme.Label({ Text = "🍀 LUCK EVENT", TextColor3 = Color3.fromRGB(130, 255, 150), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 8), Parent = luck })
	Theme.Label({
		Text = `For {Format.Duration(Config.LuckEvent.Duration)}, for everyone in this server: every box but each biome's most common one x{Config.LuckEvent.RarityLuck} as likely, mutations x{Config.LuckEvent.MutationLuck}, bigger boxes x{Config.LuckEvent.BigSizeLuck}, eggs x2. The Index shows the boosted odds.`,
		Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 42), StrokeThickness = 1.2, Parent = luck,
	})
	local buy = Theme.Button({ Text = `START IT! R$ {Config.LuckEvent.SuggestedPrice}`, Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 44), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Parent = luck })
	buy.Activated:Connect(function()
		State.Action("BuyLuck")
	end)

	local function refresh()
		local donated = State.Number("Donated")
		local title = game:GetService("Players").LocalPlayer:GetAttribute("DonorTitle")
		local titleText = if type(title) == "string" then `  •  Your title: <b>{title}</b>` else "  •  Every tip gives a title!"
		total.Text = `Tips are a thank-you to the developer: you get the title and a spot on the <b>TOP DONATORS</b> board, nothing else.\nYou've tipped <font color="#ff8ad0"><b>R$ {Format.Commas(donated)}</b></font>{titleText}`
		local endsAt = workspace:GetAttribute("LuckEndsAt")
		local left = if type(endsAt) == "number" then endsAt - workspace:GetServerTimeNow() else 0
		Theme.SetButtonText(buy, if left > 0 then `ADD 10 MIN! R$ {Config.LuckEvent.SuggestedPrice} ({Format.Duration(left)} left)` else `START IT! R$ {Config.LuckEvent.SuggestedPrice}`)
	end
	modal.OnOpen = refresh
	State.OnAttribute("Donated", function()
		if modal:IsOpen() then
			refresh()
		end
	end)
	workspace:GetAttributeChangedSignal("LuckEndsAt"):Connect(function()
		if modal:IsOpen() then
			refresh()
		end
	end)
end

return Donate
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">EventBanner</string>
              <string name="Source"><![CDATA[--[[
	Server event announcement (EventService / Events.luau).

	When an event starts, a BIG card drops in near the top of the screen (the event's colour, a huge
	icon, its name and what it does) with a little fanfare, and pulses so nobody misses it. After a
	few seconds it shrinks into a pill at the top of the screen with a countdown, which stays until
	the event ends. Players who join mid-event just get the pill.
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Events = require(Shared.Events)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)

local EventBanner = {}

local gui: ScreenGui
local holder: Frame -- screen-size scaling for the big card (the card has its own pop-in scale)
local pill: Frame
local pillLabel: TextLabel
local card: Frame? = nil

local function endsIn(): number
	local endsAt = workspace:GetAttribute("EventEndsAt")
	return if type(endsAt) == "number" then math.max(0, endsAt - workspace:GetServerTimeNow()) else 0
end

local function fanfare()
	Theme.PlaySound("Event")
end

local function showCard(event: Events.Event)
	if card then
		card:Destroy()
	end
	local frame = Theme.new("Frame", {
		Name = "EventCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = event.Color,
		Parent = holder,
	}, {
		Theme.Corner(22),
		Theme.Stroke(5),
		Theme.Gradient(event.Color:Lerp(Color3.new(1, 1, 1), 0.25), event.Color:Lerp(Color3.new(0, 0, 0), 0.45)),
	})
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	Theme.Label({ Text = event.Icon, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(130, 130), Position = UDim2.fromOffset(16, 20), Parent = frame })
	Theme.Label({ Text = "⚡ SERVER EVENT ⚡", Font = Theme.Font, TextColor3 = Color3.fromRGB(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 28), Position = UDim2.fromOffset(156, 14), StrokeThickness = 2.5, Parent = frame })
	Theme.Label({ Text = string.upper(event.Name), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 60), Position = UDim2.fromOffset(156, 42), StrokeThickness = 4.5, Parent = frame })
	Theme.Label({ Text = event.Description, Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 30), Position = UDim2.fromOffset(156, 104), StrokeThickness = 2.5, Parent = frame })
	local timer = Theme.Label({ Text = "", Font = Theme.Font, TextColor3 = Color3.fromRGB(255, 255, 200), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 24), Position = UDim2.fromOffset(156, 136), StrokeThickness = 2, Parent = frame })
	card = frame

	-- Pop in, then pulse
	local scale = Theme.new("UIScale", { Scale = 0.2, Parent = frame })
	TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	fanfare()
	local startedAt = os.clock()
	task.spawn(function()
		while frame.Parent and os.clock() - startedAt < 7 do
			local t = os.clock() - startedAt
			if t > 0.5 then
				scale.Scale = 1 + math.sin(t * 6) * 0.03
			end
			if stroke then
				stroke.Color = Color3.fromHSV((t * 0.5) % 1, 0.6, 1)
			end
			timer.Text = `⏱ {Format.Duration(endsIn())} left`
			task.wait()
		end
		if frame.Parent then
			-- Shrink into the pill at the top
			TweenService:Create(scale, TweenInfo.new(0.35), { Scale = 0.1 }):Play()
			TweenService:Create(frame, TweenInfo.new(0.35), { Position = UDim2.new(0.5, 0, 0, -60), BackgroundTransparency = 1 }):Play()
			task.wait(0.35)
			frame:Destroy()
			if card == frame then
				card = nil
			end
		end
	end)
end

function EventBanner.Init()
	gui = Theme.ScreenGui("EventBanner", 25)
	holder = Theme.new("Frame", {
		Name = "CardHolder",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 60),
		Size = UDim2.fromOffset(680, 170),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.AutoScale(holder)
	pill = Theme.new("Frame", {
		Name = "EventPill",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(470, 38),
		BackgroundColor3 = Color3.fromRGB(60, 60, 90),
		Visible = false,
		Parent = gui,
	}, {
		Theme.Corner(19),
		Theme.Stroke(3),
	})
	Theme.AutoScale(pill)
	pillLabel = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -8), Position = UDim2.fromOffset(10, 4), StrokeThickness = 2, Parent = pill })

	local shownId: string? = workspace:GetAttribute("EventId") :: string? -- (joined mid-event: pill only)
	workspace:GetAttributeChangedSignal("EventId"):Connect(function()
		local id = workspace:GetAttribute("EventId")
		local event = if type(id) == "string" then Events.ById[id] else nil
		if event and id ~= shownId then
			showCard(event)
		end
		shownId = if type(id) == "string" then id else nil
	end)

	task.spawn(function()
		while true do
			local id = workspace:GetAttribute("EventId")
			local event = if type(id) == "string" then Events.ById[id] else nil
			local left = endsIn()
			pill.Visible = event ~= nil and left > 0 and card == nil
			if event and pill.Visible then
				pill.BackgroundColor3 = event.Color:Lerp(Color3.new(0, 0, 0), 0.35)
				pillLabel.Text = `{string.upper(event.Name)}  •  {Format.Duration(left)}`
				-- Sit under the Luck Event pill when both are running
				local luckEndsAt = workspace:GetAttribute("LuckEndsAt")
				local luck = type(luckEndsAt) == "number" and luckEndsAt > workspace:GetServerTimeNow()
				pill.Position = UDim2.new(0.5, 0, 0, if luck then 46 else 4)
			end
			task.wait(0.5)
		end
	end)
end

return EventBanner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	HUD: always-on screen UI in the chunky "Steal an Egg" style, kept away from Roblox's own UI
	(chat top-left, player list top-right, hotbar bottom-centre):
	  left   - big Shop / Index / Pets / Trails buttons (middle of the screen; run speed is in Settings)
	  right  - a grid of square buttons: Home / Boosts / Skins / Donate / Updates / Settings (music
	           is in there) / Hide UI (+ Admin, + Base after the base code, + Teleport for
	           Teleporter pass owners), centred on the right edge
	  stats  - Speed, Money, income per second (bottom-left)
	  area   - which biome you're in, the Speed it needs and how fast its Domer runs, and any event
	           (bottom-right); a banner at the top whenever you walk into a biome

	  luck   - a pill at the top while a Luck Event runs (anyone can add 10 more minutes)
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Areas = require(Shared.Areas)
local Economy = require(Shared.Economy)
local Events = require(Shared.Events)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local Notifications = require(script.Parent.Notifications)
local State = require(script.Parent.Parent.State)
local AreaTracker = require(script.Parent.Parent.AreaTracker)
local Bases = require(script.Parent.Parent.Bases)

local HUD = {}

export type Callbacks = {
	OpenShop: (tab: string?) -> (),
	OpenIndex: () -> (),
	OpenSettings: () -> (),
	OpenTrails: () -> (),
	OpenTeleport: () -> (),
	OpenBaseSize: () -> (),
	OpenPets: () -> (),
	OpenDonate: () -> (),
	OpenUpdates: () -> (),
	OpenAdmin: () -> (),
	HideUI: () -> (),
	UnclaimedIndex: () -> number,
	TrailReady: () -> boolean,
	ReadyEggs: () -> number,
}

-- Little red number bubble in a button's corner.
local function badge(button: GuiObject): TextLabel
	local bubble = Theme.Label({
		Name = "Badge",
		Text = "",
		Font = Theme.Font,
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Red,
		Size = UDim2.fromOffset(26, 26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		ZIndex = 5,
		StrokeThickness = 1.5,
		Visible = false,
		Parent = button,
	})
	Theme.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bubble })
	return bubble
end

local function buildLeft(gui: ScreenGui, callbacks: Callbacks)
	local left = Theme.new("Frame", {
		Name = "LeftButtons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(196, 262),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Theme.AutoScale(left)

	-- Shop and Index are the big ones; Pets and Trails a bit smaller underneath
	local big, small = UDim2.fromOffset(190, 64), UDim2.fromOffset(190, 50)
	local shop = Theme.Button({ Text = "Shop", Icon = "🛒", Color = Theme.Colors.Green, Size = big, LayoutOrder = 1, Parent = left })
	local index = Theme.Button({ Text = "Index", Icon = "📖", Color = Theme.Colors.Blue, Size = big, LayoutOrder = 2, Parent = left })
	local pets = Theme.Button({ Text = "Pets", Icon = "🐾", Color = Theme.Colors.Pink, Size = small, LayoutOrder = 3, Parent = left })
	local trails = Theme.Button({ Text = "Trails", Icon = "💨", Color = Theme.Colors.Blue, Size = small, LayoutOrder = 5, Parent = left })
	shop.Activated:Connect(function()
		callbacks.OpenShop("Upgrades")
	end)
	pets.Activated:Connect(callbacks.OpenPets)
	index.Activated:Connect(callbacks.OpenIndex)
	trails.Activated:Connect(callbacks.OpenTrails)

	-- Badges: unclaimed Index rewards, eggs ready to hatch, a trail unlocked but none worn
	local indexBadge = badge(index)
	local petsBadge = badge(pets)
	local trailsBadge = badge(trails)
	local function updateBadges()
		local unclaimed = callbacks.UnclaimedIndex()
		indexBadge.Visible = unclaimed > 0
		indexBadge.Text = if unclaimed > 99 then "99+" else tostring(unclaimed)
		local ready = callbacks.ReadyEggs()
		petsBadge.Visible = ready > 0
		petsBadge.Text = tostring(ready)
		trailsBadge.Visible = callbacks.TrailReady()
		trailsBadge.Text = "!"
	end
	State.Changed:Connect(updateBadges)
	for _, name in { "Money", "Speed", "BestSpeed", "Trail" } do
		State.OnAttribute(name, updateBadges)
	end
	task.spawn(function()
		while true do
			task.wait(2) -- eggs finish hatching on their own
			updateBadges()
		end
	end)
end

local function buildRight(gui: ScreenGui, callbacks: Callbacks)
	local right = Theme.new("Frame", {
		Name = "RightButtons",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(160, 410),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(74, 74),
			CellPadding = UDim2.fromOffset(9, 9),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
	Theme.AutoScale(right)

	local function square(icon: string, caption: string, color: Color3, order: number, onClick: () -> ()): TextButton
		local button = Theme.Button({ Text = "", Color = color, Size = UDim2.fromOffset(74, 74), LayoutOrder = order, Parent = right })
		local drawn = Icons.For(icon)
		if drawn then
			Icons.Draw(drawn, button, color, {
				Size = UDim2.fromScale(0.56, 0.56),
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.fromScale(0.5, 0.08),
			})
		else
			Theme.Label({ Text = icon, Font = Enum.Font.GothamBold, Size = UDim2.new(1, 0, 0.62, 0), Position = UDim2.fromScale(0, 0.06), Parent = button })
		end
		Theme.Label({ Name = "Caption", Text = caption, Font = Theme.Title, Size = UDim2.new(1, -6, 0.26, 0), Position = UDim2.new(0, 3, 0.7, 0), StrokeThickness = 2, Parent = button })
		button.Activated:Connect(onClick)
		return button
	end
	local admin = square("🛠", "ADMIN", Theme.Colors.Red, 0, callbacks.OpenAdmin)
	admin.Visible = false
	-- The base code ("ender=rich"): just the bigger-base buttons
	local baseSize = square("🏢", "BASE", Theme.Colors.Blue, 0, callbacks.OpenBaseSize)
	State.OnAttribute("SizeAccess", function(value)
		baseSize.Visible = value == true
	end)
	square("🏠", "HOME", Theme.Colors.Red, 1, function()
		State.Action("TeleportHome")
	end)
	-- Teleporter pass owners: jump to any biome. Everyone else walks.
	local teleport = square("🌀", "TELEPORT", Theme.Colors.Blue, 2, callbacks.OpenTeleport)
	local function showTeleport()
		teleport.Visible = State.Data.Passes ~= nil and State.Data.Passes.Teleporter == true
	end
	State.Changed:Connect(showTeleport)
	showTeleport()
	square("🚀", "BOOSTS", Theme.Colors.Orange, 3, function()
		callbacks.OpenShop("Passes")
	end)
	square("🎨", "SKINS", Theme.Colors.Purple, 4, function()
		callbacks.OpenShop("Skins")
	end)
	square("💖", "DONATE", Theme.Colors.Pink, 5, callbacks.OpenDonate)
	square("📰", "UPDATES", Theme.Colors.Yellow, 6, function()
		callbacks.OpenUpdates()
	end)
	-- Settings: music on/off, next song and volume live in its window
	square("⚙️", "SETTINGS", Theme.Colors.Gray, 7, callbacks.OpenSettings)
	-- Clear the screen for screenshots (X on a keyboard does the same; see HideUI)
	local hide = square("👁", "HIDE UI", Theme.Colors.Gray, 8, callbacks.HideUI)
	if UserInputService.KeyboardEnabled then
		-- a little dark key cap on the top-right corner: "X" (it fits in the gaps beside the square)
		local key = Theme.new("Frame", {
			Name = "Key",
			BackgroundColor3 = Theme.Colors.Panel,
			Size = UDim2.fromOffset(24, 24),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -4, 0, 4),
			ZIndex = 5,
			Parent = hide,
		}, {
			Theme.Corner(6),
			Theme.Stroke(2),
		})
		Theme.Label({ Text = "X", Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3), ZIndex = 6, StrokeThickness = 1.5, Parent = key })
	end
	State.OnAttribute("Admin", function(value)
		admin.Visible = value == true
	end)
end

local function buildStats(gui: ScreenGui)
	local stats = Theme.new("Frame", {
		Name = "Stats",
		AnchorPoint = if Theme.IsTouch then Vector2.new(1, 0) else Vector2.new(0, 1),
		Position = if Theme.IsTouch then UDim2.new(1, -10, 0, 4) else UDim2.new(0, 10, 1, -10),
		Size = UDim2.fromOffset(380, 136),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.AutoScale(stats)
	local align = if Theme.IsTouch then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left

	-- Big outlined numbers with an icon, like the reference game
	local function row(icon: string, color: Color3, y: number): TextLabel
		local holder = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, y), Parent = stats })
		Theme.Label({ Text = icon, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(50, 50), Position = if Theme.IsTouch then UDim2.new(1, -50, 0, 0) else UDim2.new(), Parent = holder })
		-- (a little shorter than the row, so tall glyphs like "$" don't touch the row above)
		return Theme.Label({
			Text = "0",
			TextColor3 = color,
			Size = UDim2.new(1, -58, 0.86, 0),
			Position = if Theme.IsTouch then UDim2.fromScale(0, 0.07) else UDim2.new(0, 56, 0.07, 0),
			TextXAlignment = align,
			StrokeThickness = 4,
			Parent = holder,
		})
	end
	local speedLabel = row("👟", Theme.Colors.Speed, 0)
	local moneyLabel = row("💵", Theme.Colors.Money, 52)
	local incomeLabel = Theme.Label({ Text = "", TextColor3 = Color3.fromRGB(255, 255, 255), Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 109), TextXAlignment = align, StrokeThickness = 3, Parent = stats })

	local function updateSpeed()
		-- A crate Speed Boost shows its countdown next to your speed
		local endsAt = State.Get("SpeedBoostEndsAt")
		local left = if type(endsAt) == "number" then endsAt - workspace:GetServerTimeNow() else 0
		local boost = if left > 0
			then `  <font size="20" color="#ffe14a">⚡+{math.floor((Config.Crates.SpeedBoostMultiplier - 1) * 100 + 0.5)}% {Format.Duration(left)}</font>`
			else ""
		speedLabel.Text = `{Format.Number(State.Number("Speed"))}{boost}`
	end
	speedLabel.RichText = true
	State.OnAttribute("Speed", updateSpeed)
	State.OnAttribute("SpeedBoostEndsAt", updateSpeed)
	task.spawn(function()
		while true do
			task.wait(1)
			if State.Get("SpeedBoostEndsAt") ~= nil then
				updateSpeed()
			end
		end
	end)
	State.OnAttribute("Money", function(value)
		moneyLabel.Text = Format.Money(value or 0)
	end)
	local function updateIncome()
		local mult = State.Number("MoneyMultiplier")
		local multText = if mult > 1 then `  (x{Format.Multiplier(mult)} money)` else ""
		incomeLabel.Text = `+{Format.Money(State.Number("Income"))}/s{multText}`
	end
	State.OnAttribute("Income", updateIncome)
	State.OnAttribute("MoneyMultiplier", updateIncome)
end

local function buildAreaInfo(gui: ScreenGui)
	local panel = Theme.new("Frame", {
		Name = "AreaInfo",
		AnchorPoint = if Theme.IsTouch then Vector2.new(0, 0) else Vector2.new(1, 1),
		Position = if Theme.IsTouch then UDim2.new(0, 10, 0, 4) else UDim2.new(1, -10, 1, -10),
		Size = UDim2.fromOffset(290, 88),
		BackgroundColor3 = Theme.Colors.Outline,
		BackgroundTransparency = 0.45,
		Parent = gui,
	}, {
		Theme.Corner(12),
	})
	Theme.AutoScale(panel)
	local nameLabel = Theme.Label({ Text = "", Size = UDim2.new(1, -18, 0, 30), Position = UDim2.fromOffset(9, 4), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 2.5, Parent = panel })
	local detail = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, Size = UDim2.new(1, -18, 0, 24), Position = UDim2.fromOffset(9, 36), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 1.5, Parent = panel })
	local eventLabel = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -18, 0, 22), Position = UDim2.fromOffset(9, 62), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 1.5, Parent = panel })

	local function refresh()
		local areaId = AreaTracker.Current
		if areaId <= 0 then
			nameLabel.Text = "🛡 LOBBY"
			nameLabel.TextColor3 = Color3.fromRGB(110, 200, 255)
			detail.Text = `{Config.Guard.Name} can't get you here`
			return
		end
		-- (no walk speed here: the Speed stat on the left is the number that counts)
		local area = Areas.List[areaId]
		local guard = math.floor(Economy.GuardWalkSpeed(areaId))
		local recommended = Economy.RecommendedSpeed(areaId)
		nameLabel.Text = `📍 {areaId}. {area.Name}`
		nameLabel.TextColor3 = area.Trim:Lerp(Color3.new(1, 1, 1), 0.3)
		detail.Text = if recommended > 0
			then `😴 {Config.Guard.Name}: <b>{guard}</b>   •   Escape: <font color="#ffd54a"><b>⚡{Format.Number(recommended)}</b></font>`
			else `😴 {Config.Guard.Name}: <b>{guard}</b>   •   <font color="#7dff6a">Any speed!</font>`
	end

	-- The server event that's running (with a countdown)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local eventId = workspace:GetAttribute("EventId")
			local endsAt = workspace:GetAttribute("EventEndsAt")
			local event = if type(eventId) == "string" then Events.ById[eventId] else nil
			if event and type(endsAt) == "number" then
				eventLabel.Text = `{event.Name}: {Format.Duration(endsAt - workspace:GetServerTimeNow())} left`
				eventLabel.TextColor3 = event.Color
			else
				eventLabel.Text = ""
			end
		end
	end)
	AreaTracker.Changed:Connect(function(areaId: number, old: number)
		refresh()
		if old == -1 then
			return
		end
		if areaId == 0 then
			Notifications.Banner("🛡 LOBBY", Color3.fromRGB(110, 200, 255), 1.5)
		else
			-- Walked into a biome: its name and the Speed you need to get away from its Domer
			local area = Areas.List[areaId]
			local recommended = Economy.RecommendedSpeed(areaId)
			local need = if recommended > 0 then `⚡ {Format.Number(recommended)} Speed to escape` else "⚡ Any speed escapes!"
			Notifications.Banner(`BIOME {areaId}: {string.upper(area.Name)}`, area.Trim:Lerp(Color3.new(1, 1, 1), 0.25), 2.5, `{need} • {Config.Guard.Name} runs {math.floor(Economy.GuardWalkSpeed(areaId))}`)
		end
	end)
end

-- Luck Event pill at the top of the screen (only while one is running).
local function buildLuck(gui: ScreenGui)
	local pill = Theme.new("Frame", {
		Name = "LuckEvent",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(430, 38),
		BackgroundColor3 = Color3.fromRGB(30, 120, 50),
		Visible = false,
		Parent = gui,
	}, {
		Theme.Corner(19),
		Theme.Stroke(3),
		Theme.Gradient(Color3.fromRGB(80, 220, 110), Color3.fromRGB(20, 110, 50)),
	})
	Theme.AutoScale(pill)
	local label = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -140, 1, -8), Position = UDim2.fromOffset(12, 4), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 2, Parent = pill })
	local extend = Theme.Button({ Text = `+10 MIN R$ {Config.LuckEvent.SuggestedPrice}`, Color = Theme.Colors.Yellow, Size = UDim2.fromOffset(124, 30), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), Parent = pill })
	extend.Activated:Connect(function()
		State.Action("BuyLuck")
	end)
	task.spawn(function()
		while true do
			local endsAt = workspace:GetAttribute("LuckEndsAt")
			local left = if type(endsAt) == "number" then endsAt - workspace:GetServerTimeNow() else 0
			pill.Visible = left > 0
			if left > 0 then
				local by = workspace:GetAttribute("LuckBy")
				label.Text = `🍀 LUCK EVENT {Format.Duration(left)}{if type(by) == "string" then " • by " .. by else ""}`
			end
			task.wait(0.5)
		end
	end)
end

-- "YOUR BASE" marker visible through walls, so you always know where to run.
local function buildBaseMarker()
	local marker: BillboardGui? = nil
	local function place()
		local plot: Model? = nil
		for _ = 1, 60 do
			plot = Bases.Mine()
			if plot then
				break
			end
			task.wait(0.5)
		end
		local anchor = plot and plot:FindFirstChild("SignAnchor")
		if not anchor or not anchor:IsA("BasePart") then
			return
		end
		if marker then
			marker:Destroy()
		end
		local gui = Theme.new("BillboardGui", {
			Name = "YourBaseMarker",
			Adornee = anchor,
			AlwaysOnTop = true,
			Size = UDim2.fromOffset(150, 38),
			StudsOffsetWorldSpace = Vector3.new(0, 7, 0),
			LightInfluence = 0,
			Parent = Theme.PlayerGui(),
		})
		Theme.Label({ Text = "⬇ YOUR BASE ⬇", TextColor3 = Theme.Colors.Yellow, Size = UDim2.fromScale(1, 1), StrokeThickness = 3, Parent = gui })
		marker = gui
	end
	State.OnAttribute("PlotIndex", function()
		task.spawn(place)
	end)
end

function HUD.Init(callbacks: Callbacks)
	local gui = Theme.ScreenGui("HUD", 1)
	buildLeft(gui, callbacks)
	buildRight(gui, callbacks)
	buildStats(gui)
	buildAreaInfo(gui)
	buildLuck(gui)
	buildBaseMarker()
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">HideUI</string>
              <string name="Source"><![CDATA[--[[
	HideUI: the 👁 HIDE UI button (or X on a keyboard) clears the screen for screenshots and videos.

	Hides every screen GUI of ours (HUD, windows, notifications, the base marker...) and Roblox's own
	(chat, player list, hotbar), on this player's screen only. Steal prompts stay so you can still
	play. Press X again, or tap the small 👁 SHOW UI pill, to bring everything back exactly as it was.
	Anything that opens while the UI is hidden stays hidden until you show it again.
]]

local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local Theme = require(script.Parent.Theme)

local HideUI = {}

local KEY = Enum.KeyCode.X
-- Roblox's own GUI that goes away too (the emote wheel and health bar aren't used by the game)
local CORE_GUI = { Enum.CoreGuiType.Chat, Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Backpack }
-- Never hidden: our own pill, the steal prompts (you still need to see "Steal") and the loading screen
local KEEP = { ShowUI = true, ProximityPrompts = true, LoadingScreen = true }
local FADE_AFTER = 3 -- seconds before the pill fades out on a keyboard

local hidden = false
local hiddenGuis: { [LayerCollector]: boolean } = {}
local coreSaved: { [Enum.CoreGuiType]: boolean } = {}
local connections: { RBXScriptConnection } = {}
local pill: TextButton? = nil
local pillGui: ScreenGui? = nil
local fadeToken = 0

local function hideOne(gui: Instance)
	if not gui:IsA("LayerCollector") or KEEP[gui.Name] then
		return
	end
	if gui.Enabled then
		hiddenGuis[gui] = true
		gui.Enabled = false
	end
	-- something tried to show itself while the UI is hidden: remember it and keep it hidden
	table.insert(connections, gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if hidden and gui.Enabled then
			hiddenGuis[gui] = true
			gui.Enabled = false
		end
	end))
end

local function setCore(on: boolean)
	for _, kind in CORE_GUI do
		pcall(function()
			if on then
				if coreSaved[kind] ~= nil then
					StarterGui:SetCoreGuiEnabled(kind, coreSaved[kind])
				end
			else
				coreSaved[kind] = StarterGui:GetCoreGuiEnabled(kind)
				StarterGui:SetCoreGuiEnabled(kind, false)
			end
		end)
	end
	if on then
		table.clear(coreSaved)
	end
end

-- The pill shows clearly for a moment, then (with a keyboard, where X brings the UI back) fades
-- away so screenshots are clean. Hovering it brings it back. On phones it stays, a little faded.
local function showPill(visible: boolean)
	local button = pill
	if not button then
		return
	end
	fadeToken += 1
	button.Visible = visible
	if not visible then
		return
	end
	local function setFade(alpha: number)
		button.BackgroundTransparency = alpha
		for _, d in button:GetDescendants() do
			if d:IsA("TextLabel") then
				d.TextTransparency = alpha
			elseif d:IsA("UIStroke") then
				d.Transparency = alpha
			end
		end
	end
	setFade(0)
	local token = fadeToken
	task.delay(FADE_AFTER, function()
		if token == fadeToken and hidden then
			setFade(if UserInputService.KeyboardEnabled then 1 else 0.55)
		end
	end)
end

function HideUI.IsHidden(): boolean
	return hidden
end

function HideUI.Set(hide: boolean)
	if hide == hidden then
		return
	end
	hidden = hide
	local playerGui = Theme.PlayerGui()
	if hide then
		for _, gui in playerGui:GetChildren() do
			hideOne(gui)
		end
		table.insert(connections, playerGui.ChildAdded:Connect(hideOne))
		setCore(false)
	else
		for _, connection in connections do
			connection:Disconnect()
		end
		table.clear(connections)
		for gui in hiddenGuis do
			if gui.Parent then
				gui.Enabled = true
			end
		end
		table.clear(hiddenGuis)
		setCore(true)
	end
	if pillGui then
		pillGui.Enabled = hide
	end
	showPill(hide)
end

function HideUI.Toggle()
	HideUI.Set(not hidden)
end

function HideUI.Init()
	local gui = Theme.ScreenGui("ShowUI", 100)
	gui.Enabled = false
	pillGui = gui
	local button = Theme.Button({
		Name = "Show",
		Text = if UserInputService.KeyboardEnabled then "👁 SHOW UI (X)" else "👁 SHOW UI",
		Color = Theme.Colors.Gray,
		Size = UDim2.fromOffset(170, 40),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		TextSize = 20,
		Parent = gui,
	})
	button.Activated:Connect(function()
		HideUI.Set(false)
	end)
	button.MouseEnter:Connect(function()
		if hidden then
			showPill(true)
		end
	end)
	pill = button
	button.Visible = false

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		-- (processed: typing in chat or a text box, so an X in a message doesn't hide anything)
		if not processed and input.KeyCode == KEY then
			HideUI.Toggle()
		end
	end)
end

return HideUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">Icons</string>
              <string name="Source"><![CDATA[--[[
	Icons: chunky cartoon icons for the HUD and windows (like the big simulator games): a soft white
	body with a thick black outline, a drop shadow, a bit of shading and a shiny highlight, drawn
	from plain Frames so there's nothing to upload. They replace these emojis wherever a
	Theme.Button or a HUD square uses one: 🛒 📖 🐾 🔄 🛠 🏠 🏢 🌀 🚀 🎨 💖 📰 🎵 ⚙️ 👁

	Each icon is a list of shapes in a 1 x 1 box (x, y = centre; w, h = size; rot = degrees;
	r = corner rounding, 0.5 = round):
	  fill "white" (default): the body. Overlapping body shapes merge into one silhouette: every
	                          shadow is drawn first, then every outline, then every fill on top.
	                          Outlines always have rounded corners, like a marker pen.
	                          `color = Color3` paints a body shape (the heart is pink)
	  back = 1 or 2:          a body shape behind the rest, with its own outline where the front
	                          pieces overlap it (the wrench under the hammer, the rocket's fins)
	  fill "ink":             black detail drawn on the body (lines, doors, pupils)
	  fill "hole":            a see-through hole, outlined (the gear's middle): it's painted with the
	                          button's own gradient, so it looks like the button shows through
	                          (`plain`: no outline; `outlineOnly`: just the outline)
	  fill <Color3>:          a coloured spot with its own outline (paint on the palette)
	  fill "shine":           a soft white highlight on top of everything
	  plain = true:           no outline or shadow (a detail laid flat on the body)
	  z = name:               an exact layer from Z (for details that stack: the rocket's window)
	  clip = {x0, y0, x1, y1}: only the part inside that box is drawn (the cycle icon's ring)
	  tri = heading:          see roundedTriangle(); keepTop = share: only the front of the shape
	Everything scales with the icon, so it looks the same on a small HUD square and a big window.
]]

local Icons = {}

export type Layout = { Size: UDim2, Position: UDim2, AnchorPoint: Vector2? }

local OUTLINE = 0.055 -- outline thickness, as a share of the icon's size
local SHADOW = Vector2.new(0.025, 0.05) -- drop shadow offset (down and a little right)
local SHADOW_DARKNESS = 0.55 -- the shadow is the button's own colour, this much darker
local BLACK = Color3.fromRGB(18, 18, 26)
local TOP = Color3.fromRGB(255, 255, 255) -- body shading: white at the top...
local BOTTOM = Color3.fromRGB(214, 222, 240) -- ...to a cool grey at the bottom
local RED = Color3.fromRGB(240, 64, 64)
local PINK = Color3.fromRGB(255, 92, 150)
local NO_BACKGROUND = Color3.fromRGB(120, 120, 130)

-- Layers, back to front. Each depth of body (0 = front, 1 and 2 = behind it) has an outline, a
-- fill and its own ink, so a piece in front gets a black edge where it overlaps one behind.
local Z = {
	Shadow = 1,
	SpotOutline = 11,
	Detail = 12, -- front ink, spots, holes
	Over = 13, -- details on details (window glass, pupils)
	Over2 = 14,
	Shine = 15,
}
local function depthLayers(depth: number): (number, number, number)
	local base = 2 + (2 - depth) * 3
	return base, base + 1, base + 2 -- outline, fill, ink
end

type Shape = { [string]: any }

local function box(x: number, y: number, w: number, h: number, extra: Shape?): Shape
	local shape: Shape = { x = x, y = y, w = w, h = h }
	if extra then
		for key, value in extra do
			shape[key] = value
		end
	end
	return shape
end

local function circle(x: number, y: number, d: number, extra: Shape?): Shape
	local shape = box(x, y, d, d, extra)
	shape.r = 0.5
	return shape
end

local function ellipse(x: number, y: number, w: number, h: number, extra: Shape?): Shape
	local shape = box(x, y, w, h, extra)
	shape.r = 0.5
	return shape
end

local function shine(x: number, y: number, w: number, h: number, rot: number?): Shape
	return ellipse(x, y, w, h, { fill = "shine", rot = rot or -25 })
end

-- A pill from (ax, ay) to (bx, by), `width` thick, with round ends centred on the two points.
local function capsule(ax: number, ay: number, bx: number, by: number, width: number, extra: Shape?): Shape
	local dx, dy = bx - ax, by - ay
	local shape = box((ax + bx) / 2, (ay + by) / 2, width, math.sqrt(dx * dx + dy * dy) + width, extra)
	shape.rot = math.deg(math.atan2(dy, dx)) - 90
	shape.r = 0.5
	return shape
end

-- A right-angled arrowhead with rounded corners. Its back edge runs from (ax, ay) to (bx, by) and it
-- points out at right angles (to the right when that edge goes straight up). The edges are pills,
-- so the outline is round at every corner; the middle is the front half of a square on its corner.
local function roundedTriangle(ax: number, ay: number, bx: number, by: number, round: number): { Shape }
	local mx, my = (ax + bx) / 2, (ay + by) / 2
	local half = math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2) / 2
	-- the tip: half the back edge's length out from its middle, at right angles
	local nx, ny = (ay - by) / (2 * half), (bx - ax) / (2 * half)
	local tx, ty = mx + nx * half, my + ny * half
	local heading = math.deg(math.atan2(ny, nx))
	return {
		capsule(ax, ay, bx, by, round * 2),
		capsule(bx, by, tx, ty, round * 2),
		capsule(tx, ty, ax, ay, round * 2),
		box(mx, my, half * math.sqrt(2), half * math.sqrt(2), { rot = heading - 45, tri = heading, plain = true }),
	}
end

local SHAPES: { [string]: { Shape } } = {}

-- A shopping cart: a grip, a handle running down into the base bar, a basket whose left side
-- follows the handle (a slanted piece clipped to the basket's height), slots and two wheels
SHAPES.cart = {
	box(0.155, 0.19, 0.25, 0.085, { r = 0.5 }),
	box(0.28, 0.424, 0.075, 0.491, { rot = -16, r = 0.5 }),
	box(0.336, 0.4035, 0.12, 0.5, { rot = -16, clip = { -1, 0.265, 2, 0.575 } }),
	box(0.605, 0.42, 0.55, 0.31, { r = 0.12 }),
	box(0.57, 0.665, 0.54, 0.085, { r = 0.5 }),
	circle(0.36, 0.83, 0.19),
	circle(0.74, 0.83, 0.19),
	box(0.45, 0.43, 0.06, 0.16, { fill = "ink", r = 0.5 }),
	box(0.58, 0.43, 0.06, 0.16, { fill = "ink", r = 0.5 }),
	box(0.71, 0.43, 0.06, 0.16, { fill = "ink", r = 0.5 }),
	circle(0.36, 0.83, 0.065, { fill = "ink" }),
	circle(0.74, 0.83, 0.065, { fill = "ink" }),
	shine(0.42, 0.32, 0.12, 0.04, 0),
}

-- A closed book: the cover in front of the pages, a spine, a title and a red bookmark
SHAPES.book = {
	box(0.56, 0.55, 0.58, 0.72, { rot = -14, r = 0.1, back = 1 }),
	box(0.617, 0.859, 0.48, 0.03, { rot = -14, fill = "ink", back = 1 }),
	box(0.5, 0.47, 0.58, 0.72, { rot = -14, r = 0.12 }),
	box(0.325, 0.514, 0.05, 0.72, { rot = -14, fill = "ink" }),
	box(0.53, 0.37, 0.28, 0.09, { rot = -14, fill = "ink", r = 0.3 }),
	box(0.694, 0.834, 0.085, 0.17, { rot = -14, r = 0.15, fill = RED }),
	shine(0.42, 0.21, 0.13, 0.04, -14),
}

SHAPES.paw = {
	ellipse(0.5, 0.67, 0.46, 0.36),
	ellipse(0.19, 0.42, 0.18, 0.23, { rot = -20 }),
	ellipse(0.38, 0.23, 0.18, 0.23, { rot = -8 }),
	ellipse(0.62, 0.23, 0.18, 0.23, { rot = 8 }),
	ellipse(0.81, 0.42, 0.18, 0.23, { rot = 20 }),
	shine(0.41, 0.6, 0.13, 0.06),
}

-- A circular arrow (↻): one smooth white ring with the top-right quarter missing (the ring is drawn
-- twice, clipped to its left half and its bottom half), a round end at 3 o'clock and an arrowhead
-- at 12 o'clock pointing into the gap. The button shows through the middle.
SHAPES.cycle = (function(): { Shape }
	local cx, cy = 0.5, 0.54
	local outer, hole = 0.33, 0.11
	local inner = hole + OUTLINE -- where the white starts (the hole's outline is inside it)
	local keepLeft = { -1, -1, cx, 2 }
	local keepBottom = { -1, cy, 2, 2 }
	local list = {}
	for _, clip in { keepLeft, keepBottom } do
		table.insert(list, circle(cx, cy, outer * 2, { clip = clip }))
	end
	table.insert(list, circle(cx + (outer + inner) / 2, cy, outer - inner))
	-- The arrowhead's inner corner dips just into the hole's outline, so it covers the ring's end
	-- completely (and the outline there tucks it in)
	local round = 0.035
	for _, shape in roundedTriangle(cx, cy - inner + 0.006, cx, cy - outer - 0.14 + round, round) do
		table.insert(list, shape)
	end
	table.insert(list, circle(cx, cy, hole * 2, { fill = "hole", plain = true }))
	for _, clip in { keepLeft, keepBottom } do
		-- the hole's outline only goes round where the ring is (plus the ends' outline)
		table.insert(list, circle(cx, cy, hole * 2, { fill = "hole", clip = clip, clipPad = OUTLINE, outlineOnly = true }))
	end
	table.insert(list, shine(cx - 0.25, cy - 0.02, 0.055, 0.13, 15))
	return list
end)()

-- A wrench under a hammer
SHAPES.tools = {
	box(0.45, 0.55, 0.13, 0.62, { rot = 45, r = 0.45, back = 1 }),
	circle(0.69, 0.31, 0.34, { back = 1 }),
	box(0.75, 0.25, 0.1, 0.2, { rot = 45, fill = "ink", r = 0.3, back = 1 }),
	box(0.56, 0.56, 0.11, 0.62, { rot = -45, r = 0.45 }),
	box(0.34, 0.34, 0.44, 0.18, { rot = -45, r = 0.15 }),
	box(0.39, 0.39, 0.06, 0.18, { rot = -45, fill = "ink" }),
	box(0.66, 0.66, 0.035, 0.12, { rot = 45, fill = "ink" }),
	box(0.71, 0.71, 0.035, 0.12, { rot = 45, fill = "ink" }),
	shine(0.27, 0.32, 0.1, 0.035, -45),
}

-- A house with a chimney, a door with a knob and a window
SHAPES.house = {
	box(0.72, 0.27, 0.1, 0.2, { r = 0.1, back = 1 }),
	box(0.5, 0.42, 0.5, 0.5, { rot = 45, r = 0.06 }),
	box(0.5, 0.65, 0.56, 0.42, { r = 0.05 }),
	-- (the roof line ends inside the eaves' outline)
	box(0.5, 0.45, 0.66, 0.035, { fill = "ink" }),
	box(0.61, 0.765, 0.15, 0.23, { fill = "ink", r = 0.2 }),
	circle(0.65, 0.77, 0.04, { fill = "shine" }),
	box(0.36, 0.63, 0.15, 0.15, { fill = "ink", r = 0.15 }),
	box(0.36, 0.63, 0.025, 0.15, { fill = "white", plain = true, z = "Over" }),
	box(0.36, 0.63, 0.15, 0.025, { fill = "white", plain = true, z = "Over" }),
	shine(0.39, 0.3, 0.12, 0.04, -45),
}

-- A tall building with an antenna, rows of windows (two of them lit) and a door
SHAPES.building = {
	box(0.5, 0.07, 0.035, 0.09, { fill = "ink" }),
	circle(0.5, 0.035, 0.06, { fill = Color3.fromRGB(255, 80, 80) }),
	box(0.5, 0.15, 0.3, 0.08, { r = 0.25 }),
	box(0.5, 0.55, 0.52, 0.74, { r = 0.06 }),
	box(0.39, 0.3, 0.12, 0.08, { fill = "ink", r = 0.2 }),
	box(0.61, 0.3, 0.12, 0.08, { fill = Color3.fromRGB(255, 215, 70), r = 0.2, plain = true }),
	box(0.39, 0.43, 0.12, 0.08, { fill = "ink", r = 0.2 }),
	box(0.61, 0.43, 0.12, 0.08, { fill = "ink", r = 0.2 }),
	box(0.39, 0.56, 0.12, 0.08, { fill = Color3.fromRGB(255, 215, 70), r = 0.2, plain = true }),
	box(0.61, 0.56, 0.12, 0.08, { fill = "ink", r = 0.2 }),
	box(0.39, 0.69, 0.12, 0.08, { fill = "ink", r = 0.2 }),
	box(0.61, 0.69, 0.12, 0.08, { fill = "ink", r = 0.2 }),
	box(0.5, 0.85, 0.14, 0.14, { fill = "ink", r = 0.2 }),
	shine(0.31, 0.24, 0.035, 0.1, 0),
}

-- A globe with a meridian and lines of latitude (every line reaches the outline)
SHAPES.globe = {
	circle(0.5, 0.5, 0.8),
	ellipse(0.5, 0.5, 0.4, 0.8, { fill = "ink" }),
	ellipse(0.5, 0.5, 0.3, 0.72, { fill = "white", plain = true, z = "Over" }),
	box(0.5, 0.5, 0.82, 0.04, { fill = "ink", z = "Over2" }),
	box(0.5, 0.3, 0.72, 0.035, { fill = "ink", z = "Over2" }),
	box(0.5, 0.7, 0.72, 0.035, { fill = "ink", z = "Over2" }),
	shine(0.21, 0.4, 0.045, 0.1, 20),
}

-- A rocket flying up and to the right: a red nose cone and fins, a porthole and a flame
SHAPES.rocket = (function(): { Shape }
	local cx, cy = 0.55, 0.45
	-- a point `along` the rocket (towards the nose) and `side`ways from its middle
	local function at(along: number, side: number): (number, number)
		return cx + along * 0.7071 + side * 0.7071, cy - along * 0.7071 + side * 0.7071
	end
	local list = {}
	local function add(along: number, side: number, make: (number, number) -> Shape)
		local x, y = at(along, side)
		table.insert(list, make(x, y))
	end
	add(-0.42, 0, function(x, y)
		return ellipse(x, y, 0.2, 0.34, { rot = 45, color = Color3.fromRGB(255, 140, 30), back = 2 })
	end)
	add(-0.44, 0, function(x, y)
		return ellipse(x, y, 0.09, 0.18, { rot = 45, color = Color3.fromRGB(255, 230, 90), plain = true, back = 2 })
	end)
	for _, side in { -0.14, 0.14 } do
		add(-0.2, side, function(x, y)
			return box(x, y, 0.2, 0.2, { rot = 45, r = 0.18, color = RED, back = 1 })
		end)
	end
	local length, nose = 0.68, 0.3 -- the nose is the front 30% of the body
	add(0, 0, function(x, y)
		return box(x, y, 0.3, length, { rot = 45, r = 0.5 })
	end)
	add(0, 0, function(x, y)
		return box(x, y, 0.3, length, { rot = 45, r = 0.5, fill = RED, plain = true, keepTop = nose, z = 10 })
	end)
	add(length / 2 - length * nose, 0, function(x, y)
		return box(x, y, 0.3, 0.035, { rot = 45, fill = "ink" })
	end)
	add(-0.05, 0, function(x, y)
		return circle(x, y, 0.19, { fill = "ink" })
	end)
	add(-0.05, 0, function(x, y)
		return circle(x, y, 0.12, { fill = Color3.fromRGB(110, 200, 255), plain = true, z = "Over" })
	end)
	add(-0.02, -0.03, function(x, y)
		return circle(x, y, 0.04, { fill = "shine" })
	end)
	add(-0.17, -0.09, function(x, y)
		return shine(x, y, 0.035, 0.1, 45)
	end)
	return list
end)()

-- A painter's palette with a thumb hole and four blobs of paint
SHAPES.palette = {
	ellipse(0.5, 0.52, 0.88, 0.7, { rot = -10 }),
	circle(0.68, 0.68, 0.15, { fill = "hole" }),
	circle(0.28, 0.48, 0.15, { fill = RED }),
	circle(0.44, 0.3, 0.15, { fill = Color3.fromRGB(255, 215, 50) }),
	circle(0.66, 0.32, 0.15, { fill = Color3.fromRGB(70, 160, 255) }),
	circle(0.37, 0.69, 0.15, { fill = Color3.fromRGB(80, 210, 90) }),
	shine(0.25, 0.43, 0.05, 0.03, -30),
	shine(0.41, 0.25, 0.05, 0.03, -30),
	shine(0.63, 0.27, 0.05, 0.03, -30),
	shine(0.34, 0.64, 0.05, 0.03, -30),
}

-- A heart: a square on its corner with a circle on each of its top edges, so the sides join
-- smoothly with no dents
SHAPES.heart = (function(): { Shape }
	local side, cy = 0.46, 0.535
	local lobe = side / (2 * math.sqrt(2)) -- from the square's middle to the middle of a top edge
	return {
		-- (the circles are a hair bigger, so the square's side corners always sit just inside them)
		circle(0.5 - lobe, cy - lobe, side + 0.012, { color = PINK }),
		circle(0.5 + lobe, cy - lobe, side + 0.012, { color = PINK }),
		-- (only a little rounding: more would dent the sides where they meet the circles)
		box(0.5, cy, side, side, { rot = 45, r = 0.03, color = PINK }),
		shine(0.28, 0.33, 0.14, 0.08, -40),
		circle(0.4, 0.26, 0.045, { fill = "shine" }),
	}
end)()

-- A newspaper: a headline, a picture and lines of text
SHAPES.news = {
	box(0.5, 0.5, 0.7, 0.8, { r = 0.08 }),
	box(0.5, 0.23, 0.52, 0.09, { fill = "ink", r = 0.2 }),
	box(0.34, 0.47, 0.2, 0.2, { fill = "ink", r = 0.1 }),
	box(0.6, 0.4, 0.24, 0.035, { fill = "ink", r = 0.5 }),
	box(0.6, 0.48, 0.24, 0.035, { fill = "ink", r = 0.5 }),
	box(0.6, 0.56, 0.24, 0.035, { fill = "ink", r = 0.5 }),
	box(0.5, 0.67, 0.52, 0.035, { fill = "ink", r = 0.5 }),
	box(0.45, 0.76, 0.42, 0.035, { fill = "ink", r = 0.5 }),
}

-- Two quavers joined by a beam (♫). The beam's corners land exactly on the stems' outer edges, so
-- the outline runs straight from one to the other.
SHAPES.note = {
	ellipse(0.3, 0.75, 0.28, 0.21, { rot = -20 }),
	ellipse(0.72, 0.67, 0.28, 0.21, { rot = -20 }),
	box(0.42, 0.45, 0.075, 0.6),
	box(0.84, 0.425, 0.075, 0.49),
	box(0.63, 0.17, 0.47, 0.13, { rot = -11 }),
	shine(0.27, 0.72, 0.08, 0.035, -20),
}

-- A cog with eight teeth
SHAPES.gear = (function(): { Shape }
	local list = {}
	for i = 0, 3 do
		table.insert(list, box(0.5, 0.5, 0.18, 0.9, { rot = i * 45, r = 0.18 }))
	end
	table.insert(list, circle(0.5, 0.5, 0.66))
	table.insert(list, circle(0.5, 0.5, 0.22, { fill = "hole" }))
	table.insert(list, shine(0.32, 0.33, 0.1, 0.04, -40))
	return list
end)()

-- An open eye with a blue iris
SHAPES.eye = {
	ellipse(0.5, 0.5, 0.9, 0.56),
	circle(0.5, 0.5, 0.36, { fill = Color3.fromRGB(90, 170, 255) }),
	circle(0.5, 0.5, 0.18, { fill = "ink", z = "Over" }),
	circle(0.44, 0.44, 0.07, { fill = "shine" }),
}

local BY_EMOJI: { [string]: string } = {
	["🛒"] = "cart",
	["📖"] = "book",
	["🐾"] = "paw",
	["🔄"] = "cycle",
	["🛠"] = "tools",
	["🛠️"] = "tools",
	["🏠"] = "house",
	["🏢"] = "building",
	["🌀"] = "globe",
	["🌍"] = "globe",
	["🚀"] = "rocket",
	["🎨"] = "palette",
	["💖"] = "heart",
	["📰"] = "news",
	["🎵"] = "note",
	["⚙️"] = "gear",
	["⚙"] = "gear",
	["👁"] = "eye",
}

-- The icon's name for an emoji (or a name), if there's a drawn icon for it.
function Icons.For(emojiOrName: string): string?
	if SHAPES[emojiOrName] then
		return emojiOrName
	end
	return BY_EMOJI[emojiOrName]
end

-- A see-through step: opaque before `at` (0-1 along the gradient), invisible after it.
local function cut(f: Frame, rotation: number, at: number)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = rotation
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(at, 0),
		NumberSequenceKeypoint.new(math.min(1, at + 0.005), 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = f
end

-- One shape as a Frame, `grow` (a share of the icon) bigger on every side, moved by `offset`.
local function frame(parent: Instance, shape: Shape, color: Color3, grow: number, z: number, offset: Vector2?): Frame
	local f = Instance.new("Frame")
	f.Name = "Shape"
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	local move = offset or Vector2.zero
	local x, y = shape.x + move.X, shape.y + move.Y
	local w, h = shape.w + grow * 2, shape.h + grow * 2
	f.Rotation = shape.rot or 0
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = z
	local r = shape.r or 0
	if r > 0 or grow > 0 then
		-- A corner's scale is a share of the shorter side. Grown copies (outlines, shadows) keep
		-- the same curve, and get one even on square corners, so outlines never have sharp corners.
		local short = math.min(shape.w, shape.h)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(if r >= 0.5 then 0.5 else (r * short + grow) / math.min(w, h), 0)
		corner.Parent = f
	end
	if shape.tri then
		-- only the front half of the square: a triangle
		cut(f, 225, 0.5)
	elseif shape.keepTop then
		cut(f, 90, shape.keepTop)
	end
	local clip = shape.clip
	if clip then
		-- drawn inside a box that cuts off the rest (grown copies get a grown box)
		local pad = if offset then shape.clipPad or 0 else math.max(grow, shape.clipPad or 0)
		local x0, y0 = clip[1] - pad + move.X, clip[2] - pad + move.Y
		local x1, y1 = clip[3] + pad + move.X, clip[4] + pad + move.Y
		local holder = Instance.new("Frame")
		holder.Name = "Clip"
		holder.BackgroundTransparency = 1
		holder.ClipsDescendants = true
		holder.Position = UDim2.fromScale(x0, y0)
		holder.Size = UDim2.fromScale(x1 - x0, y1 - y0)
		holder.ZIndex = z
		holder.Parent = parent
		f.Position = UDim2.fromScale((x - x0) / (x1 - x0), (y - y0) / (y1 - y0))
		f.Size = UDim2.fromScale(w / (x1 - x0), h / (y1 - y0))
		f.Parent = holder
	else
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromScale(w, h)
		f.Parent = parent
	end
	return f
end

-- How far a shape (grown by `grow`) reaches above and below its centre.
local function halfHeight(shape: Shape, grow: number): number
	local rot = math.rad(shape.rot or 0)
	return (math.abs((shape.w + grow * 2) * math.sin(rot)) + math.abs((shape.h + grow * 2) * math.cos(rot))) / 2
end

-- Paint a frame top-to-bottom with colours picked by `at(y)` (y from the top of the icon), so the
-- shading runs across every shape as one.
local function verticalGradient(f: Frame, shape: Shape, top: number, bottom: number, at: (number) -> Color3)
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	local gradient = f:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Rotation = 90 - (shape.rot or 0)
	gradient.Color = ColorSequence.new(at(top), at(bottom))
	gradient.Parent = f
end

-- White to grey from the top of the icon to the bottom (`base` tints it for coloured body shapes).
local function shade(f: Frame, shape: Shape, base: Color3?)
	local function at(y: number): Color3
		local c = TOP:Lerp(BOTTOM, math.clamp(y, 0, 1))
		return if base then Color3.new(c.R * base.R, c.G * base.G, c.B * base.B) else c
	end
	if shape.tri or shape.keepTop then
		-- (these already use their gradient for the cut: one flat colour from their middle)
		f.BackgroundColor3 = at(shape.y)
		return
	end
	local half = halfHeight(shape, 0)
	verticalGradient(f, shape, shape.y - half, shape.y + half, at)
end

local function sample(sequence: ColorSequence, t: number): Color3
	local points = sequence.Keypoints
	t = math.clamp(t, 0, 1)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		if t <= b.Time then
			local span = b.Time - a.Time
			return a.Value:Lerp(b.Value, if span > 0 then (t - a.Time) / span else 0)
		end
	end
	return points[#points].Value
end

-- Draw an icon into a new square Frame (named "Icon") inside `parent`, placed by `layout` (or
-- position and size the returned frame yourself, like an image). `background` is the button's
-- colour. When the parent is a Theme.Button and `layout` is given, holes and shadows follow the
-- button's own top-to-bottom gradient, so holes really look see-through.
function Icons.Draw(name: string, parent: Instance, background: Color3?, layout: Layout?): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Icon"
	holder.BackgroundTransparency = 1
	holder.SizeConstraint = Enum.SizeConstraint.RelativeYY
	holder.ZIndex = 2
	-- where the icon sits on the button, in shares of the button's height (for see-through colours)
	local placeTop: number?, placeHeight: number? = nil, nil
	if layout then
		holder.Size = layout.Size
		holder.Position = layout.Position
		holder.AnchorPoint = layout.AnchorPoint or Vector2.zero
		if layout.Size.Y.Offset == 0 and layout.Position.Y.Offset == 0 then
			placeHeight = layout.Size.Y.Scale
			placeTop = layout.Position.Y.Scale - holder.AnchorPoint.Y * layout.Size.Y.Scale
		end
	end
	local back = background or NO_BACKGROUND
	local buttonGradient = parent:FindFirstChildOfClass("UIGradient")

	-- Frames painted with what's behind the icon (holes) or a darker copy of it (shadows)
	local painted: { { frame: Frame, shape: Shape, top: number, bottom: number, dark: number } } = {}
	local function seeThrough(f: Frame, shape: Shape, grow: number, move: Vector2?, dark: number)
		local half = halfHeight(shape, grow)
		local y = shape.y + (if move then move.Y else 0)
		table.insert(painted, { frame = f, shape = shape, top = y - half, bottom = y + half, dark = dark })
	end
	local function repaint()
		for _, entry in painted do
			if buttonGradient and placeTop and placeHeight and parent:IsA("GuiObject") then
				local tint = (parent :: GuiObject).BackgroundColor3
				local sequence = buttonGradient.Color
				local top, height = placeTop, placeHeight
				verticalGradient(entry.frame, entry.shape, entry.top, entry.bottom, function(y: number): Color3
					local c = sample(sequence, top + y * height)
					return Color3.new(c.R * tint.R, c.G * tint.G, c.B * tint.B):Lerp(BLACK, entry.dark)
				end)
			else
				entry.frame.BackgroundColor3 = back:Lerp(BLACK, entry.dark)
			end
		end
	end

	local shapes: { Shape } = SHAPES[name] or {}
	-- shadows and outlines first...
	for _, shape in shapes do
		local fill = shape.fill or "white"
		if shape.plain or fill == "ink" or fill == "shine" then
			continue
		end
		if fill == "white" then
			local outlineZ = depthLayers(shape.back or 0)
			seeThrough(frame(holder, shape, back, OUTLINE, Z.Shadow, SHADOW), shape, OUTLINE, SHADOW, SHADOW_DARKNESS)
			frame(holder, shape, BLACK, OUTLINE, outlineZ)
		elseif fill == "hole" then
			frame(holder, shape, BLACK, OUTLINE, Z.SpotOutline)
		else
			-- a coloured spot: its own (slightly thinner) outline
			local spot = OUTLINE * 0.75
			seeThrough(frame(holder, shape, back, spot, Z.Shadow, SHADOW), shape, spot, SHADOW, SHADOW_DARKNESS)
			frame(holder, shape, BLACK, spot, Z.SpotOutline)
		end
	end
	-- ...then every fill on top
	for _, shape in shapes do
		local fill = shape.fill or "white"
		local _, fillZ, inkZ = depthLayers(shape.back or 0)
		local z = if typeof(shape.z) == "string" then Z[shape.z] else shape.z
		if fill == "white" then
			shade(frame(holder, shape, TOP, 0, z or fillZ), shape, shape.color)
		elseif fill == "ink" then
			frame(holder, shape, BLACK, 0, z or (if shape.back then inkZ else Z.Detail))
		elseif fill == "shine" then
			local f = frame(holder, shape, TOP, 0, Z.Shine)
			f.BackgroundTransparency = 0.2
		elseif fill == "hole" then
			if not shape.outlineOnly then
				seeThrough(frame(holder, shape, back, 0, z or Z.Detail), shape, 0, nil, 0)
			end
		elseif typeof(fill) == "Color3" then
			frame(holder, shape, fill, 0, z or Z.Detail)
		end
	end
	repaint()
	if buttonGradient then
		-- the button changed colour (Theme.SetButtonColor): repaint the holes and shadows
		buttonGradient:GetPropertyChangedSignal("Color"):Connect(repaint)
	end
	holder.Parent = parent
	return holder
end

return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">Index</string>
              <string name="Source"><![CDATA[--[[
	Donut Index: every donut in the game, grouped by biome and by the box it comes out of (with the
	chance of each box, and of each donut inside its box), with 3D previews. Donuts you haven't
	found yet show as black silhouettes named "???".

	Rewards: every donut you've found can be claimed once for cash. Epic and rarer donuts let you
	pick a permanent treadmill speed bonus instead. "Claim All" (top right) claims every reward at
	once: the speed bonus where a donut offers one (until the bonus is capped), cash for the rest. The dots under a donut show which mutations
	of it you've found.

	Global rarity scale: Legendary and rarer donuts show how many times they've spawned and been
	found in the WHOLE game (every server), and what share of all spawns that is. The line at the
	top does the same for every mutation. (StatsService on the server keeps the counts.)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Boxes = require(Shared.Boxes)
local Donuts = require(Shared.Donuts)
local Rarities = require(Shared.Rarities)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local DonutModel = require(Shared.DonutModel)
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Index = {}

type Card = {
	Viewport: ViewportFrame,
	Name: TextLabel,
	Info: TextLabel,
	Rarity: TextLabel,
	Global: TextLabel,
	Dots: { [string]: Frame },
	Cash: TextButton,
	Speed: TextButton?,
	Status: TextLabel,
}

local modal: Modal.Modal
local pages: { [number]: ScrollingFrame } = {}
local cards: { [string]: Card } = {}
local counter: TextLabel
local claimAll: TextButton
local legend: TextLabel
local selectPage: (string) -> ()
local currentPage = 1

-- The tabs: five biomes each
local PAGES = { { 1, 6 }, { 7, 12 }, { 13, 17 } }

type Counts = { [string]: { number } }
local globalStats: { D: Counts, M: Counts }? = nil

-- Share of all spawns, as a readable percentage ("0.0031%")
local function percent(part: number, total: number): string
	if total <= 0 or part <= 0 then
		return "0%"
	end
	local p = part / total * 100
	return if p >= 1 then string.format("%.1f%%", p) elseif p >= 0.01 then string.format("%.2f%%", p) else string.format("%.2g%%", p)
end

-- Donuts found but not claimed yet (the HUD shows this as a badge on the Index button).
function Index.UnclaimedCount(): number
	local discovered: { [string]: boolean } = State.Data.Discovered or {}
	local claims: { [string]: string } = State.Data.IndexClaims or {}
	local count = 0
	for id in discovered do
		if Donuts.ById[id] and not claims[id] then
			count += 1
		end
	end
	return count
end

local function preview(parent: Instance, donut: Donuts.Donut): ViewportFrame
	local viewport = Theme.new("ViewportFrame", {
		BackgroundColor3 = Color3.fromRGB(25, 25, 40),
		Size = UDim2.new(1, -12, 0, 96),
		Position = UDim2.fromOffset(6, 6),
		Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		Parent = parent,
	}, { Theme.Corner(10) })
	local model = DonutModel.Build(donut, { NoEffects = true })
	model.Parent = viewport
	local top = (model:GetAttribute("Top") :: number?) or 2.5
	local bottom = (model:GetAttribute("Bottom") :: number?) or 2.5
	local centerY = (top - bottom) / 2
	local height = top + bottom
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(Vector3.new(2.2, centerY + 1, -(height * 1.35 + 4)), Vector3.new(0, centerY, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

-- How a box is described over its donuts: "📦 EPIC DONUT BOX • 25% of boxes • opens in 10m", with
-- the boosted chance too while a Luck Event runs.
local function boxTitle(biome: number, tier: Boxes.Tier, lucky: boolean): string
	local chance = Boxes.TierChance(biome, tier.Id)
	local share = if chance >= 1 then "every box" else `{math.floor(chance * 1000 + 0.5) / 10}% of boxes`
	if lucky and chance < 1 then
		local boosted = Boxes.TierChance(biome, tier.Id, Config.LuckEvent.RarityLuck)
		share ..= ` → 🍀 {math.floor(boosted * 1000 + 0.5) / 10}%`
	end
	return `📦 {string.upper(tier.Name)} • {share} • opens in {Format.Duration(Boxes.HatchSeconds(tier.Id, "Small"))}`
end

-- The box titles on the pages built so far (refresh() updates them when a Luck Event starts or ends).
local boxTitles: { { Label: TextLabel, Biome: number, Tier: Boxes.Tier } } = {}

local function refresh()
	local discovered: { [string]: boolean } = State.Data.Discovered or {}
	local claims: { [string]: string } = State.Data.IndexClaims or {}
	local mutations: { [string]: { [string]: boolean } } = State.Data.DiscoveredMutations or {}
	local found = 0
	for _ in discovered do
		found += 1
	end
	local stats = globalStats
	local totalSpawns = 0
	if stats then
		for _, counts in stats.D do
			totalSpawns += counts[1] or 0
		end
	end
	-- While a Luck Event runs, show the boosted odds too (Roblox wants boosted odds shown when the
	-- boost was paid for).
	local luckEndsAt = workspace:GetAttribute("LuckEndsAt")
	local lucky = type(luckEndsAt) == "number" and luckEndsAt > workspace:GetServerTimeNow()
	for id, card in cards do
		local donut = Donuts.ById[id]
		local rarity = Rarities.Get(donut.Rarity)
		local cash = Economy.IndexCashReward(id)
		local speed = Economy.IndexSpeedReward(id)
		local chance = if donut.Crafted then "Crafted at the Cosmic Forge • LIMITED"
			elseif not Donuts.Spawnable(donut) then "Admin panel only"
			else `{string.format("%.2g", Donuts.Chance(donut) * 100)}% of box`
		card.Rarity.Text = `{rarity.Id} • {chance}`
		local counts = stats and stats.D[id]
		if rarity.Order >= Config.GlobalStats.ShowFromRarity and Donuts.Spawnable(donut) then
			local spawned = if counts then counts[1] or 0 else 0
			local gotHome = if counts then counts[2] or 0 else 0
			card.Global.Text = if stats then `🌍 {Format.Number(spawned)} spawned ({percent(spawned, totalSpawns)}) • {Format.Number(gotHome)} found` else "🌍 loading..."
		else
			card.Global.Text = ""
		end
		for mutationId, dot in card.Dots do
			local has = mutations[id] and mutations[id][mutationId]
			dot.BackgroundTransparency = if has then 0 else 0.75
		end
		if discovered[id] then
			card.Viewport.ImageColor3 = Color3.new(1, 1, 1)
			card.Name.Text = donut.Name
			card.Info.Text = `{Format.Money(donut.Income)}/s`
		else
			card.Viewport.ImageColor3 = Color3.new(0, 0, 0)
			card.Name.Text = "???"
			card.Info.Text = "Not found yet"
		end
		local claimed = claims[id]
		local canClaim = discovered[id] and not claimed
		card.Cash.Visible = canClaim == true
		if card.Speed then
			card.Speed.Visible = canClaim == true
		end
		card.Status.Visible = not canClaim
		if claimed == "Speed" then
			card.Status.Text = `✓ +{speed or 0}% speed`
			card.Status.TextColor3 = Color3.fromRGB(200, 160, 255)
		elseif claimed then
			card.Status.Text = `✓ Claimed {Format.Money(cash)}`
			card.Status.TextColor3 = Theme.Colors.Money
		else
			card.Status.Text = if speed then `🎁 {Format.Money(cash)} or +{speed}% speed` else `🎁 {Format.Money(cash)}`
			card.Status.TextColor3 = Color3.fromRGB(200, 200, 210)
		end
	end
	local bonus = State.Number("IndexBonus")
	local unclaimed = Index.UnclaimedCount()
	counter.Text = `Discovered {found}/{#Donuts.List}   •   📖 Speed bonus: +{bonus}%   •   🎁 {unclaimed} to claim`
	Theme.SetButtonText(claimAll, if unclaimed > 0 then `🎁 Claim All ({unclaimed})` else "🎁 Claim All")
	Theme.SetButtonColor(claimAll, if unclaimed > 0 then Theme.Colors.Green else Theme.Colors.Gray)
	-- Mutations: chance per spawn + how many were found in the whole game
	local parts = {}
	for _, mutation in Rarities.Mutations do
		if mutation.Order > 0 then
			local counts = stats and stats.M[mutation.Id]
			local foundCount = if counts then counts[2] or 0 else 0
			local boosted = if lucky and not mutation.EventOnly then ` → 🍀 {percent(mutation.Chance * Config.LuckEvent.MutationLuck, 1)}` else ""
			local chance = if mutation.EventOnly then "⚡ Eternal Storm only" else percent(mutation.Chance, 1)
			table.insert(parts, `<font color="#{mutation.Color:ToHex()}">{mutation.Id}</font> {chance}{boosted} ({if stats then Format.Number(foundCount) else "?"} found)`)
		end
	end
	legend.Text = (if lucky then `🍀 Luck Event: rarer boxes x{Config.LuckEvent.RarityLuck}, bigger boxes x{Config.LuckEvent.BigSizeLuck}!  ` else "") .. "🌍 " .. table.concat(parts, "  ")
	for _, entry in boxTitles do
		entry.Label.Text = boxTitle(entry.Biome, entry.Tier, lucky)
	end
end

local function fetchStats()
	local ok, result = pcall(function()
		return Remotes.Function("GetGlobalStats"):InvokeServer()
	end)
	if ok and type(result) == "table" and type(result.D) == "table" and type(result.M) == "table" then
		globalStats = result
		refresh()
	end
end

local function buildCard(grid: Instance, donut: Donuts.Donut, order: number)
	local rarity = Rarities.Get(donut.Rarity)
	local cardFrame = Theme.new("Frame", { BackgroundColor3 = Theme.Colors.PanelLight, LayoutOrder = order, Parent = grid }, {
		Theme.Corner(12),
		Theme.Stroke(3, rarity.Color),
	})
	local viewport = preview(cardFrame, donut)
	local rarityLabel = Theme.Label({ Text = rarity.Id, TextColor3 = rarity.Color, Font = Theme.Font, Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 104), StrokeThickness = 1.5, Parent = cardFrame })
	local nameLabel = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 122), StrokeThickness = 1.5, Parent = cardFrame })
	local info = Theme.Label({ Text = "", Font = Theme.Font, TextColor3 = Theme.Colors.Money, Size = UDim2.new(1, -8, 0, 17), Position = UDim2.fromOffset(4, 148), StrokeThickness = 1.2, Parent = cardFrame })
	local global = Theme.Label({ Text = "", Font = Theme.Font, TextColor3 = Color3.fromRGB(170, 220, 255), Size = UDim2.new(1, -8, 0, 15), Position = UDim2.fromOffset(4, 166), StrokeThickness = 1, Parent = cardFrame })
	-- Mutation dots
	local dotRow = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 14), Position = UDim2.fromOffset(4, 185), Parent = cardFrame }, {
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local dots: { [string]: Frame } = {}
	for _, mutation in Rarities.Mutations do
		if mutation.Order > 0 then
			dots[mutation.Id] = Theme.new("Frame", { Size = UDim2.fromOffset(14, 14), BackgroundColor3 = mutation.Color, BackgroundTransparency = 0.75, LayoutOrder = mutation.Order, Parent = dotRow }, {
				Theme.Corner(7),
				Theme.Stroke(1.5),
			})
		end
	end
	-- Reward buttons
	local speed = Economy.IndexSpeedReward(donut.Id)
	local cash = Theme.Button({ Text = "💵 " .. Format.Money(Economy.IndexCashReward(donut.Id)), Color = Theme.Colors.Green, Size = UDim2.new(if speed then 0.5 else 1, -8, 0, 32), Position = UDim2.new(0, 5, 1, -38), Parent = cardFrame })
	cash.Activated:Connect(function()
		State.Action("ClaimIndex", { DonutId = donut.Id, Kind = "Cash" })
	end)
	local speedButton: TextButton? = nil
	if speed then
		local button = Theme.Button({ Text = `⚡ +{speed}%`, Color = Theme.Colors.Purple, Size = UDim2.new(0.5, -8, 0, 32), Position = UDim2.new(0.5, 3, 1, -38), Parent = cardFrame })
		button.Activated:Connect(function()
			State.Action("ClaimIndex", { DonutId = donut.Id, Kind = "Speed" })
		end)
		speedButton = button
	end
	local status = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -8, 0, 26), Position = UDim2.new(0, 4, 1, -34), StrokeThickness = 1.2, Parent = cardFrame })
	cards[donut.Id] = { Viewport = viewport, Name = nameLabel, Info = info, Rarity = rarityLabel, Global = global, Dots = dots, Cash = cash, Speed = speedButton, Status = status }
end

-- Build one tab's page (previews are only built the first time you look at it).
local function buildPage(pageId: number)
	if pages[pageId] then
		return
	end
	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 104),
		Size = UDim2.new(1, 0, 1, -104),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Visible = false,
		Parent = modal.Body,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingLeft = UDim.new(0, 2), PaddingBottom = UDim.new(0, 10) }),
	})
	pages[pageId] = scroll
	local range = PAGES[pageId]
	local order = 0
	local function section(title: string, color: Color3, size: number): (Frame, TextLabel)
		order += 1
		local frame = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = scroll })
		local label = Theme.Label({ Text = title, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, size), Parent = frame })
		return frame, label
	end
	local function grid(parent: Instance, y: number): Frame
		return Theme.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = parent }, {
			Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(170, 242), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
	end
	for biome = range[1], range[2] do
		local area = Areas.List[biome]
		if not area then
			continue
		end
		local escape = Economy.EscapeSpeed(area.Id)
		local need = if escape > 0 then `⚡{Format.Number(escape)} to escape` else "any speed escapes"
		section(`BIOME {area.Id} • {string.upper(area.Name)} • {need}`, area.Trim:Lerp(Color3.new(1, 1, 1), 0.3), 32)
		for _, tier in Boxes.TiersFor(biome) do
			local list = Donuts.ByBox[biome] and Donuts.ByBox[biome][tier.Id]
			if list and #list > 0 then
				local frame, label = section(boxTitle(biome, tier, false), tier.Color:Lerp(Color3.new(1, 1, 1), 0.25), 24)
				table.insert(boxTitles, { Label = label, Biome = biome, Tier = tier })
				local cells = grid(frame, 28)
				for index, donut in list do
					buildCard(cells, donut, index)
				end
			end
		end
		-- donuts crafted at the Cosmic Forge (limited time)
		local crafted = {}
		local inBiome: { Donuts.Donut } = Donuts.ByArea[biome] or {}
		for _, donut in inBiome do
			if donut.Crafted then
				table.insert(crafted, donut)
			end
		end
		if #crafted > 0 then
			local frame = section("☄️ CRAFTED AT THE COSMIC FORGE • LIMITED TIME", Color3.fromRGB(190, 120, 255), 24)
			local cells = grid(frame, 28)
			for index, donut in crafted do
				buildCard(cells, donut, index)
			end
		end
		-- donuts only the admin panel makes
		local extra = {}
		for _, donut in inBiome do
			if not donut.Box and not donut.Crafted then
				table.insert(extra, donut)
			end
		end
		if #extra > 0 then
			local frame = section("🛠 ADMIN PANEL ONLY", Rarities.Get("Admin").Color, 24)
			local cells = grid(frame, 28)
			for index, donut in extra do
				buildCard(cells, donut, index)
			end
		end
	end
end

function Index.Open()
	modal:Open()
end

function Index.Init()
	modal = Modal.new("📖 DONUT INDEX", Theme.Colors.Blue, Vector2.new(780, 540))
	counter = Theme.Label({ Text = "", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -196, 0, 24), Position = UDim2.fromOffset(0, 50), Parent = modal.Body })
	claimAll = Theme.Button({ Name = "ClaimAll", Text = "🎁 Claim All", Color = Theme.Colors.Gray, Size = UDim2.fromOffset(186, 28), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -2, 0, 47), Parent = modal.Body })
	claimAll.Activated:Connect(function()
		if Index.UnclaimedCount() > 0 then
			State.Action("ClaimIndexAll")
		end
	end)
	legend = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 76), StrokeThickness = 1.2, Parent = modal.Body })
	local tabs = {}
	for pageId, range in PAGES do
		table.insert(tabs, { Name = tostring(pageId), Text = `Biomes {range[1]}-{range[2]}`, Color = Areas.List[range[1]].Trim })
	end
	selectPage = Modal.Tabs(modal.Body, tabs, function(name)
		currentPage = tonumber(name) or 1
		buildPage(currentPage)
		for pageId, page in pages do
			page.Visible = pageId == currentPage
		end
		refresh()
	end)
	modal.OnOpen = function()
		selectPage(tostring(currentPage))
		task.spawn(fetchStats)
	end
	-- Keep the global numbers fresh while the Index is open
	task.spawn(function()
		while true do
			task.wait(60)
			if modal:IsOpen() then
				fetchStats()
			end
		end
	end)
	State.Changed:Connect(refresh)
	State.OnAttribute("IndexBonus", function()
		if modal:IsOpen() then
			refresh()
		end
	end)
	workspace:GetAttributeChangedSignal("LuckEndsAt"):Connect(function()
		if modal:IsOpen() then
			refresh()
		end
	end)
end

return Index
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">ItemCard</string>
              <string name="Source"><![CDATA[--[[
	ItemCard: the details card that pops up when you hover a donut, pet or egg (the Update Log's
	cards use it). Like an item tooltip in other games:

	  * the name, and its rarity in the rarity's colour
	  * three stat boxes (a donut's money per second, spawn chance and area; a pet's boosts and
	    hatch chance; an egg's hatch time, pets and rarest odds)
	  * a description with the important words coloured (mutations, the egg's pets...)
	  * the real 3D model, spinning, on the right
	  * "How to get" along the bottom

	With a mouse it follows the pointer while you hover. On phones and tablets, tap a card to show
	it next to the card, and tap anywhere else to hide it.

	ItemCard.Attach(button, { Kind = "Donut" | "Pet" | "Egg", Id = "...", Note = "..."? }, onHover?)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Areas = require(Shared.Areas)
local Boxes = require(Shared.Boxes)
local Donuts = require(Shared.Donuts)
local DonutModel = require(Shared.DonutModel)
local Pets = require(Shared.Pets)
local PetModel = require(Shared.PetModel)
local Rarities = require(Shared.Rarities)
local Format = require(Shared.Format)
local Theme = require(script.Parent.Theme)

local ItemCard = {}

export type Item = { Kind: string, Id: string, Note: string? }
export type Stat = { Label: string, Value: string, Color: Color3 }
export type Info = {
	Name: string,
	Kind: string, -- "Legendary Donut", "Epic Pet", "Egg"...
	Rarity: string, -- short tag for small cards
	Color: Color3,
	Stats: { Stat },
	Lines: { string }, -- rich text
	HowTo: string,
}

local rgb = Color3.fromRGB
local WIDTH = 470
local LEFT = 304
local MONEY = rgb(110, 255, 90)
local SPEED = rgb(170, 130, 255)
local CHANCE = rgb(255, 215, 80)
local PLACE = rgb(120, 200, 255)
local MUTATIONS = { "Gold", "Diamond", "Mythic", "Divine", "Rainbow" }

-- Colour some words; dark colours (a Cosmic Egg's purple) are lightened so they read on the card
local function paint(text: string, color: Color3): string
	local brightness = color.R * 0.299 + color.G * 0.587 + color.B * 0.114
	if brightness < 0.55 then
		color = color:Lerp(Color3.new(1, 1, 1), math.clamp((0.55 - brightness) * 1.6, 0, 0.7))
	end
	return `<font color="#{color:ToHex()}">{text}</font>`
end

local function percent(chance: number): string
	if chance >= 0.01 then
		return string.format("%.3g%%", chance * 100)
	elseif chance > 0 then
		return "1 in " .. Format.Commas(math.floor(1 / chance + 0.5))
	end
	return "-"
end

local function areaName(id: number): string
	local area = Areas.Get(id)
	if not area then
		return `Biome {id}`
	end
	return `{area.Name} (biome {area.Id})`
end

-- "Sugar Dunes to Candy Cane Canyon (biomes 3-8)"
local function areaRange(from: number, to: number): string
	local a, b = Areas.Get(from), Areas.Get(to)
	if a and b then
		return `{a.Name} to {b.Name} (biomes {a.Id}-{b.Id})`
	end
	return `{areaName(from)} to {areaName(to)}`
end

-- 180 -> "3m", 90 -> "1m 30s"
local function duration(seconds: number): string
	return (string.gsub(Format.Duration(seconds), " 0s$", ""))
end

---------------------------------------------------------------------------------------------------
-- What a card says about each kind of thing
---------------------------------------------------------------------------------------------------

function ItemCard.Model(item: Item): Model?
	local ok, model = pcall(function(): Model?
		if item.Kind == "Donut" then
			local donut = Donuts.ById[item.Id]
			return if donut then DonutModel.Build(donut, { NoEffects = true }) else nil
		elseif item.Kind == "Pet" then
			local pet = Pets.ById[item.Id]
			return if pet then PetModel.BuildPet(pet, { NoEffects = true }) else nil
		elseif item.Kind == "Egg" then
			local egg = Pets.EggById[item.Id]
			return if egg then PetModel.BuildEgg(egg, { NoEffects = true }) else nil
		end
		return nil
	end)
	return if ok then model else nil
end

function ItemCard.Describe(item: Item): Info
	local info: Info
	if item.Kind == "Donut" and Donuts.ById[item.Id] then
		local donut = Donuts.ById[item.Id]
		local rarity = Rarities.Get(donut.Rarity)
		local area = Areas.Get(donut.Area)
		local spawnable = Donuts.Spawnable(donut)
		local box = if donut.Box then Boxes.Tier(donut.Box) else nil
		local mutations = {}
		for _, id in MUTATIONS do
			local mutation = Rarities.Mutation(id)
			table.insert(mutations, paint(`{id} x{mutation.Multiplier}`, mutation.Color))
		end
		info = {
			Name = donut.Name,
			Kind = `{donut.Rarity} Donut`,
			Rarity = donut.Rarity,
			Color = rarity.Color,
			Stats = {
				{ Label = "Money", Value = `{Format.Money(donut.Income)}/s`, Color = MONEY },
				{ Label = "Box chance", Value = if spawnable then percent(Donuts.Chance(donut)) elseif donut.Crafted then "Crafted" else "Admin only", Color = CHANCE },
				{ Label = "Biome", Value = tostring(donut.Area), Color = PLACE },
			},
			Lines = if donut.Crafted
				then {
					`Never comes out of a box: bring {Config.CosmicDonut.ShardCost} {paint("meteor shards", rgb(200, 130, 255))} to the {paint("Cosmic Forge", rgb(200, 130, 255))} by the spawn to craft it.`,
					`The meteor crashes down halfway through the {paint("Eternal Storm", rgb(170, 90, 255))}. {paint("LIMITED TIME!", rgb(255, 120, 220))}`,
				}
				elseif spawnable and box
				then {
					`Comes out of a {paint(box.Name, box.Color)} from {paint(if area then area.Name else "the lane", if area then area.Trim else PLACE)}. Steal one before {paint(Config.Guard.Name, rgb(255, 90, 90))} wakes up!`,
					`Can come as {table.concat(mutations, ", ")} for more money.`,
				}
				else {
					`Never comes out of a box: only the {paint("admin panel", rarity.Color)} can make one.`,
					`Can come as {table.concat(mutations, ", ")} for more money.`,
				},
			HowTo = if donut.Crafted then "Cosmic Forge (limited)" elseif spawnable and box then `{box.Name}, {areaName(donut.Area)}` else "Admin panel only",
		}
	elseif item.Kind == "Pet" and Pets.ById[item.Id] then
		local pet = Pets.ById[item.Id]
		local rarity = Pets.Rarity(pet.Rarity)
		local egg = Pets.EggOf(pet.Id)
		local chance = if egg then Pets.Chance(egg, pet.Id) else 0
		info = {
			Name = pet.Name,
			Kind = `{pet.Rarity} Pet`,
			Rarity = pet.Rarity,
			Color = rarity.Color,
			Stats = {
				{ Label = "Money", Value = `+{math.floor(pet.Money * 100 + 0.5)}%`, Color = MONEY },
				{ Label = "Speed", Value = `+{math.floor(pet.Speed * 100 + 0.5)}%`, Color = SPEED },
				{ Label = "Hatch chance", Value = if egg then percent(chance) else "-", Color = CHANCE },
			},
			Lines = {
				`Follows you around and gives {paint(Pets.BonusText(pet), MONEY)}.`,
				if egg then `Hatches from the {paint(egg.Name, egg.Color)} ({percent(chance)} chance).` else `A rare find: {paint(pet.Exclusive or "special", CHANCE)} only.`,
			},
			HowTo = if pet.Exclusive then `From the {pet.Exclusive}` elseif egg then `Hatch it from a {egg.Name}` else "Special pet",
		}
	elseif item.Kind == "Egg" and Pets.EggById[item.Id] then
		local egg = Pets.EggById[item.Id]
		local odds = {}
		for _, entry in egg.Pool do
			local pet = Pets.ById[entry.Pet]
			if pet then
				table.insert(odds, `{paint(pet.Name, Pets.Rarity(pet.Rarity).Color)} {percent(Pets.Chance(egg, pet.Id))}`)
			end
		end
		local last = egg.Pool[#egg.Pool]
		info = {
			Name = egg.Name,
			Kind = `Tier {egg.Tier} Egg`,
			Rarity = "Egg",
			Color = egg.Color,
			Stats = {
				{ Label = "Hatch time", Value = duration(egg.HatchSeconds), Color = PLACE },
				{ Label = "Pets inside", Value = tostring(#egg.Pool), Color = MONEY },
				{ Label = "Rarest pet", Value = if last then percent(Pets.Chance(egg, last.Pet)) else "-", Color = CHANCE },
			},
			Lines = {
				`Bring it to your incubator to hatch one of: {table.concat(odds, ", ")}.`,
			},
			HowTo = if egg.CrateOnly then "Only found in crates" else `Grab one in the lane, from {areaRange(egg.MinArea, egg.MaxArea)}`,
		}
	else
		info = { Name = item.Id, Kind = item.Kind, Rarity = "", Color = Theme.Colors.Gray, Stats = {}, Lines = {}, HowTo = "" }
	end
	if item.Note then
		table.insert(info.Lines, 1, paint(item.Note, rgb(255, 235, 140)))
	end
	return info
end

---------------------------------------------------------------------------------------------------
-- The floating card
---------------------------------------------------------------------------------------------------
local gui: ScreenGui? = nil
local card: Frame
local nameLabel: TextLabel
local kindLabel: TextLabel
local statBoxes: { Frame } = {}
local description: TextLabel
local howTo: TextLabel
local viewport: ViewportFrame
local camera: Camera
local cardGradient: UIGradient
local cardStroke: UIStroke

local current: GuiObject? = nil
local currentHover: ((boolean) -> ())? = nil
local pinned = false
local models: { [string]: Model } = {}
local shownModel: Model? = nil
local distance = 10

local function text(props: { [string]: any }): TextLabel
	props.Font = props.Font or Theme.Font
	props.TextScaled = false
	props.TextWrapped = true
	props.AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.Y
	return Theme.Label(props)
end

local function build()
	local screen = Theme.ScreenGui("ItemCard", 40)
	gui = screen
	card = Theme.new("Frame", {
		Name = "Card",
		Size = UDim2.fromOffset(WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		Parent = screen,
	}, {
		Theme.Corner(12),
		Theme.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	cardGradient = Theme.new("UIGradient", { Rotation = 90, Parent = card })
	cardStroke = Theme.Stroke(3)
	cardStroke.Parent = card
	Theme.AutoScale(card)

	local top = Theme.new("Frame", { Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
	local left = Theme.new("Frame", {
		Name = "Info",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(LEFT, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = top,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12) }),
	})
	nameLabel = text({ Name = "ItemName", Font = Theme.Title, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -4, 0, 0), StrokeThickness = 2.5, LayoutOrder = 1, Parent = left })
	kindLabel = text({ Name = "Kind", TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -4, 0, 0), StrokeThickness = 2, LayoutOrder = 2, Parent = left })
	local stats = Theme.new("Frame", { Name = "Stats", BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 54), LayoutOrder = 3, Parent = left }, {
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i = 1, 3 do
		local box = Theme.new("Frame", {
			Name = "Stat" .. i,
			Size = UDim2.new(1 / 3, -4, 1, 0),
			BackgroundColor3 = rgb(12, 11, 20),
			LayoutOrder = i,
			Parent = stats,
		}, { Theme.Corner(8), Theme.Stroke(2, rgb(60, 58, 80)) })
		-- (same size in every box: long labels shrink, short ones don't blow up)
		local label = Theme.Label({ Name = "Label", Font = Theme.Font, TextColor3 = rgb(185, 180, 205), Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 4), StrokeThickness = 1.2, Parent = box })
		Theme.new("UITextSizeConstraint", { MaxTextSize = 14, Parent = label })
		local value = Theme.Label({ Name = "Value", Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 22), StrokeThickness = 2, Parent = box })
		Theme.new("UITextSizeConstraint", { MaxTextSize = 24, Parent = value })
		statBoxes[i] = box
	end
	local descBox = Theme.new("Frame", {
		Name = "Description",
		BackgroundColor3 = rgb(10, 9, 17),
		BackgroundTransparency = 0.15,
		Size = UDim2.new(1, -4, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 4,
		Parent = left,
	}, { Theme.Corner(8), Theme.Stroke(2, rgb(60, 58, 80)), Theme.Padding(8) })
	description = text({ Name = "Text", RichText = true, TextSize = 16, LineHeight = 1.05, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(1, 0), StrokeThickness = 1.5, Parent = descBox })

	viewport = Theme.new("ViewportFrame", {
		Name = "Model",
		BackgroundTransparency = 1,
		Ambient = rgb(190, 185, 205),
		LightColor = rgb(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		Position = UDim2.fromOffset(LEFT + 6, 8),
		Size = UDim2.fromOffset(WIDTH - LEFT - 14, 150),
		Parent = top,
	})
	camera = Instance.new("Camera")
	camera.FieldOfView = 38
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local bar = Theme.new("Frame", {
		Name = "HowTo",
		BackgroundColor3 = rgb(30, 28, 44),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = card,
	}, { Theme.Corner(10), Theme.new("UIPadding", { PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })
	howTo = text({ Name = "Text", RichText = true, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(1, 0), StrokeThickness = 1.5, Parent = bar })
end

-- Is this GUI object actually on screen (it and every parent visible)?
local function onScreen(object: Instance): boolean
	local node: Instance? = object
	while node do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		elseif node:IsA("LayerCollector") then
			return node.Enabled
		end
		node = node.Parent
	end
	return false
end

local function lastInputWasTouch(): boolean
	local ok, kind = pcall(function()
		return UserInputService:GetLastInputType()
	end)
	if ok and kind then
		return kind == Enum.UserInputType.Touch
	end
	return Theme.IsTouch
end

local function guiInset(): Vector2
	local ok, inset = pcall(function()
		return GuiService:GetGuiInset()
	end)
	return if ok and typeof(inset) == "Vector2" then inset else Vector2.zero
end

local function keyOf(item: Item): string
	return item.Kind .. ":" .. item.Id
end

local function show(target: GuiObject, item: Item, pin: boolean, onHover: ((boolean) -> ())?)
	if not gui then
		build()
	end
	if currentHover and current ~= target then
		currentHover(false)
	end
	current = target
	currentHover = onHover
	pinned = pin
	local info = ItemCard.Describe(item)
	nameLabel.Text = info.Name
	kindLabel.Text = info.Kind
	kindLabel.TextColor3 = Theme.Lighten(info.Color, 0.15)
	cardGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Darken(info.Color, 0.62)),
		ColorSequenceKeypoint.new(0.35, rgb(22, 20, 34)),
		ColorSequenceKeypoint.new(1, rgb(16, 15, 26)),
	})
	cardStroke.Color = Theme.Darken(info.Color, 0.25)
	for i, box in statBoxes do
		local stat = info.Stats[i]
		box.Visible = stat ~= nil
		if stat then
			(box:FindFirstChild("Label") :: TextLabel).Text = stat.Label
			local value = box:FindFirstChild("Value") :: TextLabel
			value.Text = stat.Value
			value.TextColor3 = stat.Color
		end
	end
	description.Text = table.concat(info.Lines, "\n")
	howTo.Text = `<font color="#FFD25A">How to get:</font> {info.HowTo}`

	-- the model (built once per item, then kept)
	if shownModel then
		shownModel.Parent = nil
		shownModel = nil
	end
	local key = keyOf(item)
	local model = models[key]
	if not model then
		local built = ItemCard.Model(item)
		if built then
			local box = built:GetBoundingBox()
			built:PivotTo(built:GetPivot() - box.Position)
			models[key] = built
			model = built
		end
	end
	if model then
		local _, size = model:GetBoundingBox()
		distance = math.max(size.X, size.Y, size.Z) * 1.9
		model.Parent = viewport
		shownModel = model
	end
	card.Visible = true
end

function ItemCard.Hide()
	if gui then
		card.Visible = false
	end
	local hover = currentHover
	current = nil
	currentHover = nil
	pinned = false
	if hover then
		hover(false)
	end
end

function ItemCard.IsShowing(): boolean
	return gui ~= nil and card.Visible
end

function ItemCard.Attach(target: GuiButton, item: Item, onHover: ((boolean) -> ())?)
	target.MouseEnter:Connect(function()
		if lastInputWasTouch() then
			return -- phones: tap instead (Activated)
		end
		show(target, item, false, onHover)
		if onHover then
			onHover(true)
		end
	end)
	target.MouseLeave:Connect(function()
		if current == target and not pinned then
			ItemCard.Hide()
		elseif onHover then
			onHover(false)
		end
	end)
	target.Activated:Connect(function()
		if not lastInputWasTouch() then
			return
		end
		if current == target and pinned then
			ItemCard.Hide()
		else
			show(target, item, true, onHover)
			if onHover then
				onHover(true)
			end
		end
	end)
end

local started = false
function ItemCard.Init()
	if started then
		return
	end
	started = true
	-- A tap anywhere but the card's button hides a pinned card
	UserInputService.InputBegan:Connect(function(input: InputObject)
		local target = current
		if not pinned or not target or input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local at = Vector2.new(input.Position.X, input.Position.Y)
		local from, size = target.AbsolutePosition, target.AbsoluteSize
		if at.X < from.X or at.Y < from.Y or at.X > from.X + size.X or at.Y > from.Y + size.Y then
			ItemCard.Hide()
		end
	end)
	RunService.RenderStepped:Connect(function()
		if not gui or not card.Visible then
			return
		end
		local target = current
		if not target or not onScreen(target) then
			ItemCard.Hide()
			return
		end
		local t = os.clock()
		camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(t * 0.9) * distance, distance * 0.2, -math.cos(t * 0.9) * distance), Vector3.zero)

		-- Next to the pointer (or next to the tapped card), kept on screen
		local screenGui = gui :: ScreenGui
		local screen = screenGui.AbsoluteSize
		local size = card.AbsoluteSize
		local x, y
		if pinned then
			local from, targetSize = target.AbsolutePosition, target.AbsoluteSize
			x = from.X + targetSize.X + 10
			if x + size.X > screen.X - 6 then
				x = from.X - size.X - 10
			end
			y = from.Y
		else
			local mouse = UserInputService:GetMouseLocation() - guiInset()
			-- (MouseLeave doesn't always fire, e.g. when the list scrolls under the pointer)
			local from, targetSize = target.AbsolutePosition, target.AbsoluteSize
			if mouse.X < from.X or mouse.Y < from.Y or mouse.X > from.X + targetSize.X or mouse.Y > from.Y + targetSize.Y then
				ItemCard.Hide()
				return
			end
			x = mouse.X + 18
			if x + size.X > screen.X - 6 then
				x = mouse.X - size.X - 18
			end
			y = mouse.Y + 12
		end
		x = math.clamp(x, 6, math.max(6, screen.X - size.X - 6))
		y = math.clamp(y, 6, math.max(6, screen.Y - size.Y - 6))
		card.Position = UDim2.fromOffset(x, y)
	end)
end

return ItemCard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">Leaderboards</string>
              <string name="Source"><![CDATA[--[[
	Leaderboards: the physical boards next to the shop (scrollable, top 500). Leaderboards.Open()
	shows the same data in a full-screen window; nothing on the HUD opens it any more (the Top 500
	button was removed), but it's kept so a button can be added back in one line.
	The donation board starts with a pinned row (a crown instead of a rank, with a note under the name).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local VirtualList = require(script.Parent.VirtualList)

local Leaderboards = {}

local player = Players.LocalPlayer :: Player

type Entry = { Rank: number, UserId: number, Name: string, Display: string, Color: Color3?, Score: number? }
type BoardData = { Entries: { Entry }, UpdatedAt: number, Live: boolean }

local boardConfigs: { [string]: { Id: string, Title: string, Subtitle: string, Color: Color3 } } = {}
for _, board in Config.Leaderboards.Boards do
	boardConfigs[board.Id] = board
end

local data: { [string]: BoardData } = {}
local listeners: { [string]: { (BoardData) -> () } } = {}

local RANK_COLORS = { Color3.fromRGB(255, 215, 0), Color3.fromRGB(210, 220, 235), Color3.fromRGB(215, 140, 70) }

local function fetch(boardId: string)
	local ok, result = pcall(function()
		return Remotes.Function("GetLeaderboard"):InvokeServer(boardId)
	end)
	if ok and type(result) == "table" then
		data[boardId] = result
		local callbacks: { (BoardData) -> () } = listeners[boardId] or {}
		for _, callback in callbacks do
			task.spawn(callback, result)
		end
	end
end

local function listen(boardId: string, callback: (BoardData) -> ())
	listeners[boardId] = listeners[boardId] or {}
	table.insert(listeners[boardId], callback)
	if data[boardId] then
		callback(data[boardId])
	end
end

-- Builds a scrolling list inside `parent`. Returns a function to feed it a board.
local function makeList(parent: Instance, rowHeight: number, textScale: number, accent: Color3): (BoardData) -> ()
	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = math.floor(10 * textScale),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	})
	local function buildRow(): GuiObject
		local row = Theme.new("Frame", { Size = UDim2.new(1, -math.floor(14 * textScale), 0, rowHeight - 4), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.93 }, { Theme.Corner(6) })
		Theme.Label({ Name = "Rank", Font = Theme.Title, Size = UDim2.new(0.16, 0, 0.8, 0), Position = UDim2.fromScale(0.01, 0.1), StrokeThickness = 2 * textScale, Parent = row })
		Theme.Label({ Name = "PlayerName", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.45, 0, 0.75, 0), Position = UDim2.fromScale(0.18, 0.125), StrokeThickness = 1.5 * textScale, Parent = row })
		Theme.Label({ Name = "Value", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.35, 0, 0.75, 0), Position = UDim2.fromScale(0.63, 0.125), StrokeThickness = 1.5 * textScale, Parent = row })
		return row
	end
	local function bindRow(row: GuiObject, entry: Entry)
		local rank = row:FindFirstChild("Rank") :: TextLabel
		local name = row:FindFirstChild("PlayerName") :: TextLabel
		local value = row:FindFirstChild("Value") :: TextLabel
		rank.Text = "#" .. entry.Rank
		rank.TextColor3 = RANK_COLORS[entry.Rank] or Color3.fromRGB(230, 230, 230)
		name.Text = entry.Name
		value.Text = entry.Display
		value.TextColor3 = entry.Color or accent:Lerp(Color3.new(1, 1, 1), 0.35)
		local isMe = entry.UserId == player.UserId
		row.BackgroundColor3 = if isMe then Theme.Colors.Yellow else Color3.new(1, 1, 1)
		row.BackgroundTransparency = if isMe then 0.6 else (if entry.Rank % 2 == 0 then 0.96 else 0.9)
	end
	local list = VirtualList.new(scroll, rowHeight, buildRow, bindRow :: any)
	return function(board: BoardData)
		list:SetEntries(board.Entries)
	end
end

local function findMe(board: BoardData): Entry?
	for _, entry in board.Entries do
		if entry.UserId == player.UserId then
			return entry
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Physical boards next to the shop
--------------------------------------------------------------------------------
local function buildWorldBoard(screen: BasePart, boardId: string)
	local cfg = boardConfigs[boardId]
	if not cfg then
		return
	end
	local surface = Theme.new("SurfaceGui", {
		Name = "Board_" .. boardId,
		Adornee = screen,
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 25,
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = Theme.PlayerGui(),
	})
	local root = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(20, 20, 32), Parent = surface }, { Theme.Padding(14) })
	local header = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = cfg.Color, Parent = root }, {
		Theme.Corner(14),
		Theme.Gradient(Theme.Lighten(cfg.Color, 0.2), Theme.Darken(cfg.Color, 0.15)),
	})
	Theme.Label({ Text = "🏆 " .. cfg.Title, Size = UDim2.new(1, -20, 0, 64), Position = UDim2.fromOffset(10, 6), StrokeThickness = 4, Parent = header })
	Theme.Label({ Text = `{cfg.Subtitle} • TOP {Config.Leaderboards.Size}`, Font = Theme.Font, Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 70), StrokeThickness = 2, Parent = header })
	local listHolder = Theme.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 122), Size = UDim2.new(1, 0, 1, -178), Parent = root })
	local footer = Theme.Label({ Text = "Loading...", Font = Theme.Font, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 1, -44), TextColor3 = Theme.Colors.Yellow, StrokeThickness = 2, Parent = root })
	local feed = makeList(listHolder, 52, 2, cfg.Color)
	listen(boardId, function(board)
		feed(board)
		local me = findMe(board)
		if #board.Entries == 0 then
			footer.Text = "No scores yet - be the first!"
		elseif me then
			footer.Text = `You are #{me.Rank}! • scroll for more`
		else
			footer.Text = if board.Live then "Showing this server (global board loading...)" else "Scroll to see the top " .. Config.Leaderboards.Size
		end
	end)
end

--------------------------------------------------------------------------------
-- Full-screen window
--------------------------------------------------------------------------------
local modal: Modal.Modal

local function buildModal()
	modal = Modal.new("🏆 TOP 500", Theme.Colors.Orange, Vector2.new(640, 540))
	local body = modal.Body
	local current = Config.Leaderboards.Boards[1].Id
	local subtitle = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 50), StrokeThickness = 1.5, Parent = body })
	local listHolder = Theme.new("Frame", { BackgroundColor3 = Color3.fromRGB(20, 20, 32), Position = UDim2.fromOffset(0, 80), Size = UDim2.new(1, 0, 1, -120), Parent = body }, { Theme.Corner(12), Theme.Padding(6) })
	local footer = Theme.Label({ Text = "", Font = Theme.Font, TextColor3 = Theme.Colors.Yellow, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -32), StrokeThickness = 1.5, Parent = body })
	local feeds: { [string]: (BoardData) -> () } = {}
	local holders: { [string]: Frame } = {}

	local function show(boardId: string)
		current = boardId
		for id, holder in holders do
			holder.Visible = id == boardId
		end
		local cfg = boardConfigs[boardId]
		subtitle.Text = cfg.Subtitle
		local board = data[boardId]
		local me = board and findMe(board)
		footer.Text = if me then `Your rank: #{me.Rank}` else "Keep playing to reach the top 500!"
	end

	for _, cfg in Config.Leaderboards.Boards do
		local holder = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = listHolder })
		holders[cfg.Id] = holder
		feeds[cfg.Id] = makeList(holder, 40, 1, cfg.Color)
		listen(cfg.Id, function(board)
			feeds[cfg.Id](board)
			if current == cfg.Id then
				show(cfg.Id)
			end
		end)
	end

	local tabs = {}
	for _, cfg in Config.Leaderboards.Boards do
		table.insert(tabs, { Name = cfg.Id, Text = cfg.Id, Color = cfg.Color })
	end
	local selectTab = Modal.Tabs(body, tabs, show)
	modal.OnOpen = function()
		selectTab(current)
		task.spawn(fetch, current)
	end
end

function Leaderboards.Open()
	modal:Open()
end

function Leaderboards.Init()
	buildModal()

	task.spawn(function()
		local map = workspace:WaitForChild("Map")
		local folder = map:WaitForChild("Hub"):WaitForChild("Leaderboards")
		for _, cfg in Config.Leaderboards.Boards do
			local board = folder:WaitForChild("Board_" .. cfg.Id, 30)
			local screen = board and board:WaitForChild("Screen", 30)
			if screen and screen:IsA("BasePart") then
				buildWorldBoard(screen, cfg.Id)
			end
		end
	end)

	Remotes.Event("LeaderboardUpdated").OnClientEvent:Connect(function(boardId: string)
		task.wait(math.random() * 3) -- spread requests from many clients
		fetch(boardId)
	end)

	task.spawn(function()
		task.wait(3)
		while true do
			for _, cfg in Config.Leaderboards.Boards do
				fetch(cfg.Id)
				task.wait(1)
			end
			task.wait(60)
		end
	end)
end

return Leaderboards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">Modal</string>
              <string name="Source"><![CDATA[--[[
	Modal: a centred pop-up window (Shop, Index, Leaderboards...). Only one is open at a time.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Modal = {}
Modal.__index = Modal

export type Modal = {
	Frame: Frame,
	Body: Frame,
	Title: TextLabel,
	OnOpen: (() -> ())?,
	OnClose: (() -> ())?,
	Open: (self: Modal) -> (),
	Close: (self: Modal) -> (),
	Toggle: (self: Modal) -> (),
	IsOpen: (self: Modal) -> boolean,
}

local gui: ScreenGui? = nil
local current: Modal? = nil

local function getGui(): ScreenGui
	if not gui then
		gui = Theme.ScreenGui("Modals", 10)
	end
	return gui :: ScreenGui
end

function Modal.new(title: string, color: Color3, size: Vector2): Modal
	local holder = Theme.new("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = getGui(),
	}, {
		Theme.Corner(18),
		Theme.Stroke(4),
		Theme.Gradient(Theme.Colors.PanelLight, Theme.Colors.Panel),
	})
	Theme.AutoScale(holder) -- (only one UIScale per object works, so the open "pop" tweens this one too)

	local header = Theme.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = color,
		Parent = holder,
	}, {
		Theme.Corner(18),
		Theme.Gradient(Theme.Lighten(color, 0.2), Theme.Darken(color, 0.1)),
	})
	-- Square off the header's bottom corners
	Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -18), BackgroundColor3 = Theme.Darken(color, 0.1), BorderSizePixel = 0, Parent = header })
	local titleLabel = Theme.Label({ Name = "Title", Text = title, Size = UDim2.new(1, -120, 0, 44), Position = UDim2.fromOffset(20, 7), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 3, Parent = header })

	local close = Theme.Button({ Name = "Close", Text = "X", Color = Theme.Colors.Red, Size = UDim2.fromOffset(46, 46), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 6), Parent = header })

	local body = Theme.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 68),
		Size = UDim2.new(1, -28, 1, -80),
		Parent = holder,
	})

	local self = setmetatable({ Frame = holder, Body = body, Title = titleLabel, OnOpen = nil, OnClose = nil }, Modal) :: any
	close.Activated:Connect(function()
		self:Close()
	end)
	return self
end

function Modal.Open(self: Modal)
	if current and current ~= self then
		current:Close()
	end
	current = self
	if not self.Frame.Visible and Theme.SinceKeyPress() > 0.4 then
		Theme.PlaySound("Open") -- (opened with a button, the button's click is enough)
	end
	local scale = self.Frame:FindFirstChild("AutoScale") :: UIScale
	local target = Theme.CurrentScale()
	scale.Scale = target * 0.85
	self.Frame.Visible = true
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
	if self.OnOpen then
		task.spawn(self.OnOpen)
	end
end

function Modal.Close(self: Modal)
	local wasOpen = self.Frame.Visible
	self.Frame.Visible = false
	if current == self then
		current = nil
	end
	if wasOpen and self.OnClose then
		task.spawn(self.OnClose)
	end
end

function Modal.Toggle(self: Modal)
	if self.Frame.Visible then
		self:Close()
	else
		self:Open()
	end
end

-- Is any window open right now?
function Modal.AnyOpen(): boolean
	return current ~= nil and current.Frame.Visible
end

function Modal.IsOpen(self: Modal): boolean
	return self.Frame.Visible
end

-- Row of tab buttons; returns a function to select a tab by name.
function Modal.Tabs(parent: Instance, tabs: { { Name: string, Text: string, Color: Color3 } }, onSelect: (string) -> ()): (string) -> ()
	local bar = Theme.new("Frame", { Name = "Tabs", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = parent }, {
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local buttons: { [string]: TextButton } = {}
	local function select(name: string)
		for tabName, button in buttons do
			local tab
			for _, t in tabs do
				if t.Name == tabName then
					tab = t
				end
			end
			Theme.SetButtonColor(button, if tabName == name then tab.Color else Theme.Colors.Gray)
		end
		onSelect(name)
	end
	for i, tab in tabs do
		local button = Theme.Button({ Text = tab.Text, Color = tab.Color, Size = UDim2.new(1 / #tabs, -8, 1, 0), LayoutOrder = i, Parent = bar })
		buttons[tab.Name] = button
		button.Activated:Connect(function()
			select(tab.Name)
		end)
	end
	return select
end

return Modal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	Notifications: small toasts and big server-wide announcements. Top of the screen, from the top:
	  y 4    Luck Event pill (HUD) and the server event pill under it (EventBanner, y 46)
	  y 92   big banners (area names, announcements)
	  y 186  chase banner (Chase) - toasts slide below it while it's showing (SetToastOffset)
	  y 186+ toasts
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)

local Notifications = {}

local KIND_COLORS = {
	info = Theme.Colors.Blue,
	success = Theme.Colors.Green,
	error = Theme.Colors.Red,
	rare = Theme.Colors.Yellow,
	event = Theme.Colors.Pink,
}

local KIND_SOUNDS = {
	info = "Notify",
	success = "Success",
	error = "Error",
	rare = "Rare",
	event = "Announce",
}

local toastHolder: Frame
local bannerHolder: Frame
local toastCounter = 0
local TOAST_Y = 186

-- Push the toasts down while something else (the chase banner) uses that spot.
function Notifications.SetToastOffset(extra: number)
	TweenService:Create(toastHolder, TweenInfo.new(0.25), { Position = UDim2.new(0.5, 0, 0, TOAST_Y + extra) }):Play()
end

function Notifications.Toast(text: string, kind: string?)
	local color = KIND_COLORS[kind or "info"] or Theme.Colors.Blue
	toastCounter -= 1 -- newest first
	local toast = Theme.new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.1,
		LayoutOrder = toastCounter,
		Parent = toastHolder,
	}, {
		Theme.Corner(10),
		Theme.Stroke(2.5),
	})
	Theme.new("Frame", { Size = UDim2.new(0, 8, 1, 0), BackgroundColor3 = color, BorderSizePixel = 0, Parent = toast }, { Theme.Corner(10) })
	local label = Theme.Label({ Text = text, Font = Theme.Font, Size = UDim2.new(1, -24, 1, -8), Position = UDim2.fromOffset(16, 4), TextXAlignment = Enum.TextXAlignment.Left, StrokeThickness = 1.5, Parent = toast })
	-- A soft chime for each kind (skipped if another sound just played, like the steal jingle)
	if Theme.SinceSound() > 0.35 then
		Theme.PlaySound(KIND_SOUNDS[kind or "info"] or "Notify")
	end

	-- Keep at most 3 toasts
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 4, #toasts do
		toasts[i]:Destroy()
	end

	task.delay(3.5, function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			task.wait(0.4)
			toast:Destroy()
		end
	end)
end

-- Big banner across the top (Secret donuts, area names...).
function Notifications.Banner(text: string, color: Color3, duration: number?, subtitle: string?)
	for _, child in bannerHolder:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local banner = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -120),
		Size = UDim2.new(1, 0, 0, if subtitle then 82 else 56),
		BackgroundTransparency = 1,
		Parent = bannerHolder,
	})
	local title = Theme.Label({ Text = text, TextColor3 = color, Size = UDim2.new(1, 0, 0, 52), StrokeThickness = 3.5, Parent = banner })
	local sub
	if subtitle then
		sub = Theme.Label({ Text = subtitle, Font = Theme.Font, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 54), TextColor3 = Theme.Colors.White, StrokeThickness = 2, Parent = banner })
	end
	TweenService:Create(banner, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 0) }):Play()
	task.delay(duration or 3, function()
		if banner.Parent then
			TweenService:Create(title, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
			if sub then
				TweenService:Create(sub, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
			end
			task.wait(0.5)
			banner:Destroy()
		end
	end)
end

function Notifications.Init()
	local gui = Theme.ScreenGui("Notifications", 20)
	toastHolder = Theme.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, TOAST_Y),
		Size = UDim2.fromOffset(460, 120),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Theme.AutoScale(toastHolder)
	bannerHolder = Theme.new("Frame", {
		Name = "Banners",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92),
		Size = UDim2.fromOffset(860, 92),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.AutoScale(bannerHolder)

	Remotes.Event("Notify").OnClientEvent:Connect(function(text: string, kind: string?)
		Notifications.Toast(text, kind)
	end)
	Remotes.Event("AreaAnnouncement").OnClientEvent:Connect(function(text: string, color: Color3)
		Notifications.Banner(text, color, 5)
		Theme.PlaySound("Announce")
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">PassOffer</string>
              <string name="Source"><![CDATA[--[[
	PassOffer: during a player's first hour of play (Config.PassOffer), a popup offers the money
	pass once per session: a few minutes after joining, and only when they're not running with a
	donut or looking at another window.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local PassOffer = {}

local player = Players.LocalPlayer

local function findPass(): Config.GamePass?
	for _, pass in Config.GamePasses do
		if pass.Key == Config.PassOffer.PassKey then
			return pass
		end
	end
	return nil
end

local function playTime(): number
	local value = player:GetAttribute("PlayTime")
	return if type(value) == "number" then value else 0
end

function PassOffer.Init()
	local pass = findPass()
	if not pass then
		return
	end
	local offer = pass
	local modal = Modal.new("🎁 SPECIAL OFFER", Theme.Colors.Green, Vector2.new(460, 340))
	local body = modal.Body
	Theme.Label({ Text = "💵", TextScaled = false, TextSize = 64, Size = UDim2.new(1, 0, 0, 70), Parent = body })
	Theme.Label({ Text = `{string.upper(offer.Name)} FOREVER!`, Font = Theme.Title, TextColor3 = Color3.fromRGB(120, 255, 120), Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 72), StrokeThickness = 3, Parent = body })
	Theme.Label({
		Text = `Every donut on your base earns {offer.Multiplier}x money - for good!`,
		Font = Theme.Font, TextScaled = false, TextSize = 20, TextWrapped = true,
		Size = UDim2.new(1, -20, 0, 56), Position = UDim2.fromOffset(10, 118), StrokeThickness = 1.5, Parent = body,
	})
	local buy = Theme.Button({ Text = `BUY  R$ {offer.SuggestedPrice}`, Color = Theme.Colors.Green, Size = UDim2.new(0.6, -6, 0, 52), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = body })
	local later = Theme.Button({ Text = "No thanks", Color = Theme.Colors.Gray, Size = UDim2.new(0.4, -6, 0, 52), AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Parent = body })
	buy.Activated:Connect(function()
		State.Action("BuyPass", offer.Key)
		modal:Close()
	end)
	later.Activated:Connect(function()
		modal:Close()
	end)
	-- Show the real price once Roblox tells us
	task.spawn(function()
		if offer.GamePassId > 0 then
			local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, offer.GamePassId, Enum.InfoType.GamePass)
			if ok and info and info.PriceInRobux then
				Theme.SetButtonText(buy, `BUY  R$ {info.PriceInRobux}`)
			end
		end
	end)

	task.spawn(function()
		task.wait(Config.PassOffer.DelaySeconds)
		-- Wait for a calm moment (not mid-chase, no other window open), for up to 10 minutes
		for _ = 1, 600 do
			if State.Data.Passes[offer.Key] or playTime() > Config.PassOffer.FirstMinutes * 60 then
				return
			end
			if player:GetAttribute("CarryingDonut") == nil and not Modal.AnyOpen() then
				modal:Open()
				return
			end
			task.wait(1)
		end
	end)
end

return PassOffer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">PetsWindow</string>
              <string name="Source"><![CDATA[--[[
	Pets window:
	  Eggs - the eggs in your incubator, each with a countdown, and a HATCH button when it's ready
	         (plus what's inside each egg and the chances)
	  Pets - every pet you own: equip up to Config.Pets.MaxEquipped (they follow you and give their
	         money / treadmill bonus), Equip Best, or release pets you don't want.
	Hatching plays a full-screen animation: the egg shakes harder and harder, cracks, flashes, and
	the pet pops out.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Pets)
local PetModel = require(Shared.PetModel)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local PetsWindow = {}

local modal: Modal.Modal
local pages: { [string]: ScrollingFrame } = {}
local header: TextLabel
local eggCards: { [string]: { Frame: Frame, Bar: Frame, Label: TextLabel, Button: TextButton, HatchAt: number } } = {}
local currentTab = "Eggs"
local overlay: Frame
local confirmRelease: string? = nil

-- A 3D preview of a model in a ViewportFrame (the model's Top/Bottom attributes frame the camera).
local function preview(parent: Instance, model: Model, size: UDim2, position: UDim2): ViewportFrame
	local viewport = Theme.new("ViewportFrame", {
		BackgroundColor3 = Color3.fromRGB(25, 25, 40),
		Size = size,
		Position = position,
		Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		Parent = parent,
	}, { Theme.Corner(10) })
	model:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(200), 0))
	model.Parent = viewport
	local top = (model:GetAttribute("Top") :: number?) or 1.5
	local bottom = (model:GetAttribute("Bottom") :: number?) or 1.5
	local centerY = (top - bottom) / 2
	local height = top + bottom
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(Vector3.new(0, centerY + height * 0.25, -(height * 1.6 + 3)), Vector3.new(0, centerY, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

local function clearPage(page: ScrollingFrame)
	for _, child in page:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function card(page: Instance, order: number, color: Color3): Frame
	return Theme.new("Frame", { BackgroundColor3 = Theme.Colors.PanelLight, LayoutOrder = order, Parent = page }, {
		Theme.Corner(12),
		Theme.Stroke(3, color),
	})
end

--------------------------------------------------------------------------------
-- Eggs
--------------------------------------------------------------------------------
local function refreshEggTimers()
	local now = workspace:GetServerTimeNow()
	for _, entry in eggCards do
		local left = entry.HatchAt - now
		if left <= 0 then
			entry.Label.Text = "READY!"
			entry.Label.TextColor3 = Color3.fromRGB(120, 255, 130)
			entry.Bar.Size = UDim2.fromScale(1, 1)
			entry.Button.Visible = true
		else
			entry.Label.Text = "⏳ " .. Format.Duration(left)
			entry.Label.TextColor3 = Color3.fromRGB(255, 255, 255)
			entry.Button.Visible = false
		end
	end
end

type EggData = { Uid: string, Id: string, HatchAt: number }
type PetData = { Uid: string, Id: string }

local function buildEggs()
	local page = pages.Eggs
	clearPage(page)
	table.clear(eggCards)
	local eggs: { EggData } = State.Data.Eggs or {}
	if #eggs == 0 then
		local empty = card(page, 1, Theme.Colors.Gray)
		Theme.Label({
			Text = "No eggs yet! Eggs show up in Area 4 and further. Grab one (your guard wakes up!) and bring it to your base.",
			Font = Theme.Font, Size = UDim2.new(1, -16, 1, -16), Position = UDim2.fromOffset(8, 8), StrokeThickness = 1.5, Parent = empty,
		})
	end
	for order, eggData in eggs do
		local egg = Pets.EggById[eggData.Id]
		if egg then
			local c = card(page, order, egg.Accent)
			preview(c, PetModel.BuildEgg(egg, { NoEffects = true }), UDim2.new(1, -12, 0, 92), UDim2.fromOffset(6, 6))
			Theme.Label({ Text = egg.Name, TextColor3 = egg.Accent:Lerp(Color3.new(1, 1, 1), 0.4), Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 100), StrokeThickness = 2, Parent = c })
			local barBack = Theme.new("Frame", { Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 126), BackgroundColor3 = Theme.Colors.Outline, Parent = c }, { Theme.Corner(6) })
			local total = egg.HatchSeconds
			local done = math.clamp(1 - (eggData.HatchAt - workspace:GetServerTimeNow()) / total, 0, 1)
			local bar = Theme.new("Frame", { Size = UDim2.fromScale(done, 1), BackgroundColor3 = egg.Accent, Parent = barBack }, { Theme.Corner(6) })
			TweenService:Create(bar, TweenInfo.new(math.max(0, eggData.HatchAt - workspace:GetServerTimeNow()), Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) }):Play()
			local label = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -8, 1, -4), Position = UDim2.fromOffset(4, 2), StrokeThickness = 1.5, Parent = barBack })
			-- What's inside
			local odds = {}
			for _, entry in egg.Pool do
				local pet = Pets.ById[entry.Pet]
				table.insert(odds, `{pet.Name} {string.format("%.3g", Pets.Chance(egg, pet.Id) * 100)}%`)
			end
			Theme.Label({ Text = table.concat(odds, " • "), Font = Theme.Font, TextColor3 = Color3.fromRGB(200, 200, 215), Size = UDim2.new(1, -10, 0, 30), Position = UDim2.fromOffset(5, 152), StrokeThickness = 1, Parent = c })
			local hatch = Theme.Button({ Text = "HATCH!", Color = Theme.Colors.Green, Size = UDim2.new(1, -16, 0, 34), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Parent = c })
			hatch.Visible = false
			hatch.Activated:Connect(function()
				State.Action("HatchEgg", eggData.Uid)
			end)
			eggCards[eggData.Uid] = { Frame = c, Bar = bar, Label = label, Button = hatch, HatchAt = eggData.HatchAt }
		end
	end
	refreshEggTimers()
end

--------------------------------------------------------------------------------
-- Pets
--------------------------------------------------------------------------------
local function buildPets()
	local page = pages.Pets
	clearPage(page)
	local owned: { PetData } = State.Data.Pets or {}
	local equipped: { string } = State.Data.EquippedPets or {}
	local list = table.clone(owned)
	table.sort(list, function(a, b)
		local ea, eb = table.find(equipped, a.Uid) ~= nil, table.find(equipped, b.Uid) ~= nil
		if ea ~= eb then
			return ea
		end
		local pa, pb = Pets.ById[a.Id], Pets.ById[b.Id]
		local sa = if pa then pa.Money + pa.Speed else 0
		local sb = if pb then pb.Money + pb.Speed else 0
		return sa > sb
	end)
	if #list == 0 then
		local empty = card(page, 1, Theme.Colors.Gray)
		Theme.Label({ Text = "No pets yet! Hatch an egg to get your first pet.", Font = Theme.Font, Size = UDim2.new(1, -16, 1, -16), Position = UDim2.fromOffset(8, 8), StrokeThickness = 1.5, Parent = empty })
	end
	for order, petData in list do
		local pet = Pets.ById[petData.Id]
		if pet then
			local rarity = Pets.Rarity(pet.Rarity)
			local isEquipped = table.find(equipped, petData.Uid) ~= nil
			local c = card(page, order, if isEquipped then Theme.Colors.Green else rarity.Color)
			preview(c, PetModel.BuildPet(pet, { NoEffects = true }), UDim2.new(1, -12, 0, 92), UDim2.fromOffset(6, 6))
			Theme.Label({ Text = rarity.Id, TextColor3 = rarity.Color, Font = Theme.Font, Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 100), StrokeThickness = 1.2, Parent = c })
			Theme.Label({ Text = pet.Name, Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 116), StrokeThickness = 2, Parent = c })
			Theme.Label({ Text = Pets.BonusText(pet), Font = Theme.Font, TextColor3 = Theme.Colors.Money, Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 140), StrokeThickness = 1.2, Parent = c })
			local equip = Theme.Button({ Text = if isEquipped then "UNEQUIP" else "EQUIP", Color = if isEquipped then Theme.Colors.Orange else Theme.Colors.Green, Size = UDim2.new(0.72, -10, 0, 32), Position = UDim2.new(0, 6, 1, -38), Parent = c })
			equip.Activated:Connect(function()
				State.Action(if isEquipped then "UnequipPet" else "EquipPet", petData.Uid)
			end)
			local release = Theme.Button({ Text = "✖", Color = Theme.Colors.Red, Size = UDim2.new(0.28, -4, 0, 32), Position = UDim2.new(0.72, -2, 1, -38), Parent = c })
			release.Activated:Connect(function()
				if confirmRelease == petData.Uid then
					confirmRelease = nil
					State.Action("ReleasePet", petData.Uid)
				else
					confirmRelease = petData.Uid
					Theme.SetButtonText(release, "SURE?")
					task.delay(3, function()
						if confirmRelease == petData.Uid then
							confirmRelease = nil
						end
						if release.Parent then
							Theme.SetButtonText(release, "✖")
						end
					end)
				end
			end)
		end
	end
end

local function refreshHeader()
	local equippedIds = {}
	local pets: { PetData } = State.Data.Pets or {}
	local equipped: { string } = State.Data.EquippedPets or {}
	for _, uid in equipped do
		for _, pet in pets do
			if pet.Uid == uid then
				table.insert(equippedIds, pet.Id)
			end
		end
	end
	local money, speed = Economy.PetBonuses(equippedIds)
	if currentTab == "Eggs" then
		local capacity = Config.Pets.MaxEggs + Config.Pets.IncubatorSize.PerLevel * State.Number("IncubatorSize")
		local hatchSpeed = 1 + Config.Pets.IncubatorSpeed.PerLevel * State.Number("IncubatorSpeed")
		header.Text = `🥚 Incubator {#(State.Data.Eggs or {})}/{capacity}  •  ⚡ x{Format.Multiplier(hatchSpeed)} speed  •  upgrade it in the Shop`
	else
		header.Text = `🐾 {#pets}/{Config.Pets.MaxPets} pets   •   Equipped {#equippedIds}/{Config.Pets.MaxEquipped}: +{math.floor(money * 100 + 0.5)}% money, +{math.floor(speed * 100 + 0.5)}% speed`
	end
end

local function refresh()
	refreshHeader()
	if currentTab == "Eggs" then
		buildEggs()
	else
		buildPets()
	end
end

-- How many eggs are ready to hatch (HUD badge).
function PetsWindow.ReadyEggs(): number
	local now = workspace:GetServerTimeNow()
	local count = 0
	local eggs: { EggData } = State.Data.Eggs or {}
	for _, egg in eggs do
		if egg.HatchAt <= now then
			count += 1
		end
	end
	return count
end

--------------------------------------------------------------------------------
-- Hatch animation
--------------------------------------------------------------------------------
local function playHatch(info: { EggId: string, PetId: string })
	local egg = Pets.EggById[info.EggId]
	local pet = Pets.ById[info.PetId]
	if not egg or not pet then
		return
	end
	local rarity = Pets.Rarity(pet.Rarity)
	modal:Close()
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	TweenService:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 0.35 }):Play()
	local stage = Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(340, 340), BackgroundTransparency = 1, Parent = overlay })
	Theme.AutoScale(stage)
	local eggView = preview(stage, PetModel.BuildEgg(egg, { NoEffects = true }), UDim2.fromScale(1, 1), UDim2.new())
	eggView.BackgroundTransparency = 1
	-- Shake harder and harder
	local shaking = true
	local startedAt = os.clock()
	local connection = RunService.RenderStepped:Connect(function()
		if not shaking then
			return
		end
		local p = math.clamp((os.clock() - startedAt) / 2.2, 0, 1)
		eggView.Rotation = math.sin(os.clock() * (8 + p * 30)) * (4 + p * 22)
		eggView.Position = UDim2.fromOffset(math.sin(os.clock() * 40) * p * 6, 0)
	end)
	for i = 1, 3 do
		task.delay(0.6 * i, function()
			Theme.PlaySound("Crack")
		end)
	end
	task.wait(2.2)
	shaking = false
	connection:Disconnect()
	-- Flash!
	local flash = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 5, Parent = overlay })
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	task.delay(0.7, function()
		flash:Destroy()
	end)
	Theme.PlaySound("Hatch")
	eggView:Destroy()
	-- Rays behind the pet for the rare ones
	if rarity.Order >= 4 then
		for i = 1, 8 do
			local ray = Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(18, 460), Rotation = i * 22.5, BackgroundColor3 = rarity.Color, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = stage }, {
				Theme.new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) }) }),
			})
			TweenService:Create(ray, TweenInfo.new(6, Enum.EasingStyle.Linear), { Rotation = ray.Rotation + 90 }):Play()
		end
	end
	local petView = preview(stage, PetModel.BuildPet(pet, { NoEffects = true }), UDim2.fromScale(1, 1), UDim2.new())
	petView.BackgroundTransparency = 1
	local popScale = Theme.new("UIScale", { Scale = 0.2, Parent = petView })
	TweenService:Create(popScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local title = Theme.Label({ Text = `{string.upper(rarity.Id)}!`, TextColor3 = rarity.Color, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -70), Size = UDim2.fromOffset(420, 48), StrokeThickness = 4, Parent = stage })
	Theme.Label({ Text = pet.Name, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.fromOffset(420, 44), StrokeThickness = 3.5, Parent = stage })
	Theme.Label({ Text = `{Pets.BonusText(pet)}  ({string.format("%.3g", Pets.Chance(egg, pet.Id) * 100)}% chance)`, Font = Theme.Font, TextColor3 = Theme.Colors.Money, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 46), Size = UDim2.fromOffset(420, 26), StrokeThickness = 2, Parent = stage })
	if rarity.Order >= 6 then
		task.spawn(function()
			while title.Parent do
				title.TextColor3 = Color3.fromHSV((os.clock() * 0.4) % 1, 0.7, 1)
				task.wait()
			end
		end)
	end
	-- Spin the pet slowly until it closes
	local camera = petView:FindFirstChildOfClass("Camera")
	local spin = RunService.RenderStepped:Connect(function(dt: number)
		if camera then
			camera.CFrame = CFrame.Angles(0, dt * 0.8, 0) * camera.CFrame
		end
	end)
	task.wait(3.2)
	spin:Disconnect()
	TweenService:Create(overlay, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
	stage:Destroy()
	task.wait(0.3)
	overlay.Visible = false
end

function PetsWindow.Open()
	modal:Open()
end

function PetsWindow.Init()
	modal = Modal.new("🐾 PETS", Theme.Colors.Pink, Vector2.new(760, 520))
	local body = modal.Body
	header = Theme.Label({ Text = "", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -330, 0, 28), Position = UDim2.fromOffset(0, 50), StrokeThickness = 1.5, Parent = body })
	local hatchAll = Theme.Button({ Text = "HATCH ALL READY", Color = Theme.Colors.Green, Size = UDim2.fromOffset(170, 34), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -150, 0, 48), Parent = body })
	hatchAll.Activated:Connect(function()
		State.Action("HatchEgg")
	end)
	local best = Theme.Button({ Text = "EQUIP BEST", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(140, 34), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 48), Parent = body })
	best.Activated:Connect(function()
		State.Action("EquipBestPets")
	end)
	for _, name in { "Eggs", "Pets" } do
		pages[name] = Theme.new("ScrollingFrame", {
			Name = name,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 88),
			Size = UDim2.new(1, 0, 1, -88),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 8,
			Visible = false,
			Parent = body,
		}, {
			Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(168, 228), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
			Theme.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
		})
	end
	local selectTab = Modal.Tabs(body, {
		{ Name = "Eggs", Text = "🥚 Eggs", Color = Theme.Colors.Orange },
		{ Name = "Pets", Text = "🐾 Pets", Color = Theme.Colors.Pink },
	}, function(name)
		currentTab = name
		for pageName, page in pages do
			page.Visible = pageName == name
		end
		hatchAll.Visible = name == "Eggs"
		best.Visible = name == "Pets"
		refresh()
	end)
	modal.OnOpen = function()
		selectTab(currentTab)
	end
	State.Changed:Connect(function()
		if modal:IsOpen() then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if modal:IsOpen() and currentTab == "Eggs" then
				refreshEggTimers()
			end
		end
	end)

	local gui = Theme.ScreenGui("Hatching", 30)
	overlay = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Visible = false, Parent = gui })
	gui.IgnoreGuiInset = true
	local queue: { { EggId: string, PetId: string } } = {}
	local playing = false
	Remotes.Event("EggHatched").OnClientEvent:Connect(function(info)
		table.insert(queue, info)
		if playing then
			return
		end
		playing = true
		while #queue > 0 do
			local next = table.remove(queue, 1)
			if next then
				playHatch(next)
			end
		end
		playing = false
	end)
end

return PetsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">Sell</string>
              <string name="Source"><![CDATA[--[[
	Sell window, opened at the sell stall in the lobby (press E there). Lists every donut you have -
	in your inventory and in your pen - with what it earns and what it sells for, best first.
	  * SELL on a row sells that one donut (click twice: the first click asks "SURE?").
	  * The buttons at the top sell every INVENTORY donut of a rarity in one go (also twice).
	    Donuts in your pen are only ever sold one by one, so nothing earning money goes by accident.
	Prices come from the server (Remotes "GetSellList"): Config.SellSeconds of the donut's income.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Donuts = require(Shared.Donuts)
local Rarities = require(Shared.Rarities)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Sell = {}

type SellItem = { Uid: string?, Slot: number?, Id: string, Level: number, Mutation: string?, Size: string?, Price: number, Income: number }

local CONFIRM_SECONDS = 2.5
local SELL_GREEN = Color3.fromRGB(60, 200, 90)
local SURE_RED = Color3.fromRGB(235, 70, 70)

local modal: Modal.Modal
local list: ScrollingFrame
local header: TextLabel
local quick: Frame
local emptyLabel: TextLabel
local loading = false
local queued = false

-- A button that only acts on the second click (within CONFIRM_SECONDS).
local function confirmButton(props: { Text: string, Color: Color3, Size: UDim2, Parent: Instance, LayoutOrder: number? }, onConfirm: () -> ()): TextButton
	local button = Theme.Button({ Text = props.Text, Color = props.Color, Size = props.Size, Parent = props.Parent, LayoutOrder = props.LayoutOrder })
	local armedAt = 0
	button.Activated:Connect(function()
		local now = os.clock()
		if now - armedAt <= CONFIRM_SECONDS then
			armedAt = 0
			Theme.SetButtonText(button, props.Text)
			Theme.SetButtonColor(button, props.Color)
			onConfirm()
			return
		end
		armedAt = now
		Theme.SetButtonText(button, "SURE?")
		Theme.SetButtonColor(button, SURE_RED)
		task.delay(CONFIRM_SECONDS, function()
			if armedAt == now then
				armedAt = 0
				Theme.SetButtonText(button, props.Text)
				Theme.SetButtonColor(button, props.Color)
			end
		end)
	end)
	return button
end

local function clear(parent: Instance)
	for _, child in parent:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function row(item: SellItem, order: number)
	local donut = Donuts.ById[item.Id]
	if not donut then
		return
	end
	local rarity = Rarities.Get(donut.Rarity)
	local mutation = Rarities.Mutation(item.Mutation)
	local frame = Theme.new("Frame", {
		Size = UDim2.new(1, -12, 0, 58),
		BackgroundColor3 = Theme.Colors.Outline,
		BackgroundTransparency = 0.55,
		LayoutOrder = order,
		Parent = list,
	}, {
		Theme.Corner(10),
	})
	Theme.Label({
		Text = Rarities.DisplayName(donut.Name, item.Mutation, item.Size),
		TextColor3 = if mutation.Order > 0 then mutation.Color else rarity.Color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.58, -12, 0, 30),
		Position = UDim2.fromOffset(12, 3),
		StrokeThickness = 2,
		Parent = frame,
	})
	local where = if item.Slot then "🏠 In your pen" else "🎒 Inventory"
	Theme.Label({
		Text = `{rarity.Id} • {where} • {Format.Money(item.Income)}/s`,
		Font = Theme.Font,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.58, -12, 0, 20),
		Position = UDim2.fromOffset(12, 33),
		StrokeThickness = 1.5,
		Parent = frame,
	})
	Theme.Label({
		Text = `💰 {Format.Money(item.Price)}`,
		TextColor3 = Theme.Colors.Yellow,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0.42, -150, 1, -16),
		Position = UDim2.new(0.58, 0, 0, 8),
		StrokeThickness = 2,
		Parent = frame,
	})
	local holder = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(122, 42), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Parent = frame })
	confirmButton({ Text = "SELL", Color = SELL_GREEN, Size = UDim2.fromScale(1, 1), Parent = holder }, function()
		if item.Uid then
			State.Action("SellInventory", item.Uid)
		elseif item.Slot then
			State.Action("SellSlot", item.Slot)
		end
		frame:Destroy()
		Sell.Refresh(0.4)
	end)
end

local function fill(items: { SellItem })
	clear(list)
	clear(quick)
	Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = quick })
	Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	-- What a "sell all" of each rarity would give (inventory only)
	local byRarity: { [string]: { Count: number, Total: number } } = {}
	local inventoryTotal, inventoryCount = 0, 0
	for _, item in items do
		local donut = Donuts.ById[item.Id]
		if item.Uid and donut then
			local entry = byRarity[donut.Rarity] or { Count = 0, Total = 0 }
			byRarity[donut.Rarity] = entry
			entry.Count += 1
			entry.Total += item.Price
			inventoryTotal += item.Price
			inventoryCount += 1
		end
	end
	local order = 0
	for _, rarity in Rarities.List do
		local entry = byRarity[rarity.Id]
		if entry then
			order += 1
			confirmButton({ Text = `All {rarity.Id} ({entry.Count})`, Color = rarity.Color, Size = UDim2.fromOffset(150, 40), Parent = quick, LayoutOrder = order }, function()
				State.Action("SellAllInventory", rarity.Id)
				Sell.Refresh(0.4)
			end)
		end
	end
	if inventoryCount > 1 then
		confirmButton({ Text = `ALL ({Format.Money(inventoryTotal)})`, Color = SELL_GREEN, Size = UDim2.fromOffset(170, 40), Parent = quick, LayoutOrder = 99 }, function()
			State.Action("SellAllInventory", "All")
			Sell.Refresh(0.4)
		end)
	end
	header.Text = if inventoryCount > 0
		then `Sell all your <b>inventory</b> donuts of a rarity ({inventoryCount} in your inventory, worth <font color="#ffd54a"><b>{Format.Money(inventoryTotal)}</b></font>):`
		else "Donuts in your pen are sold one at a time below. Donuts from boxes land in your <b>inventory</b> first."

	for index, item in items do
		row(item, index)
	end
	emptyLabel.Visible = #items == 0
end

-- Ask the server for the list again (after `delay` seconds: give a sale time to go through).
function Sell.Refresh(delay: number?)
	if loading then
		queued = true
		return
	end
	loading = true
	task.delay(delay or 0, function()
		local ok, items = pcall(function()
			return Remotes.Function("GetSellList"):InvokeServer()
		end)
		loading = false
		if ok and type(items) == "table" and modal:IsOpen() then
			fill(items :: { SellItem })
		end
		if queued then
			queued = false
			Sell.Refresh(0.2)
		end
	end)
end

function Sell.Open()
	modal:Open()
end

-- The stall's "Sell donuts" prompt (made here, so it's only on your screen).
local function addStallPrompt()
	local map = workspace:WaitForChild("Map", 120)
	local hub = map and map:WaitForChild("Hub", 60)
	local stall = hub and hub:WaitForChild("SellStall", 60)
	local part = stall and stall:WaitForChild("PromptPart", 60)
	if not part then
		return
	end
	local prompt = Theme.new("ProximityPrompt", {
		Name = "SellPrompt",
		ActionText = "Sell donuts",
		ObjectText = "💰 Sell Stall",
		KeyboardKeyCode = Enum.KeyCode.E,
		GamepadKeyCode = Enum.KeyCode.ButtonX,
		HoldDuration = 0,
		MaxActivationDistance = 16,
		RequiresLineOfSight = false,
		Parent = part,
	}) :: ProximityPrompt
	prompt.Triggered:Connect(Sell.Open)
end

function Sell.Init()
	modal = Modal.new("💰 SELL DONUTS", SELL_GREEN, Vector2.new(780, 560))
	local body = modal.Body
	header = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 28), Parent = body })
	quick = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), Position = UDim2.fromOffset(0, 32), Parent = body })
	list = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 84),
		Size = UDim2.new(1, 0, 1, -84),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = body,
	}) :: ScrollingFrame
	emptyLabel = Theme.Label({
		Text = "No donuts to sell yet!\nSteal a box, open it in your pen, and the donut lands in your inventory.",
		Font = Theme.Font,
		Size = UDim2.new(1, 0, 0, 80),
		Position = UDim2.fromOffset(0, 120),
		Visible = false,
		Parent = body,
	})
	modal.OnOpen = function()
		Sell.Refresh(0)
	end
	State.OnAttribute("InventoryCount", function()
		if modal:IsOpen() then
			Sell.Refresh(0.2)
		end
	end)
	task.spawn(addStallPrompt)
end

return Sell
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[--[[
	Settings window + background music player.
	Music on/off and volume are saved per player. Tracks come from Config.Music.Tracks.
	Run speed: type how fast you want to run (a WalkSpeed, at least Config.Speed.MinRunSpeed); MAX
	runs as fast as you can. Saved per player, the server applies it (Actions.SetSpeedLimit).

	The music never stops on its own: a single song loops, several songs play one after another
	(and start over), and a watchdog restarts playback if Roblox ever drops it. Songs that fail to
	load (a private asset, a deleted asset, or a typo in the ID) are skipped with a warning in the
	Output window; if none of them load, it keeps retrying (a slow connection while the map loads).
]]

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Signal = require(Shared.Signal)

local Theme = require(script.Parent.Theme)
local ChaseMusic = require(script.Parent.ChaseMusic)
local StormMusic = require(script.Parent.StormMusic)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Settings = {}

-- Fires (on: boolean) whenever music is switched on or off (the HUD's music toggle listens).
Settings.MusicChanged = Signal.new()

local modal: Modal.Modal
local sound: Sound
local trackIndex = 1
local volume = Config.Music.DefaultVolume
local musicOn = true
local loaded = false -- becomes true once the saved settings arrive
local refresh: () -> () = function() end
local status = "" -- shown under "Now playing" when something is wrong
local playToken = 0
local failed: { [number]: boolean } = {}
local LOAD_TIMEOUT = 25 -- seconds a song may take to load before it's skipped
local RETRY_DELAY = 30 -- seconds before trying again when no song could be loaded
local retryPending = false

local tracks = Config.Music.Tracks
local usingFallback = false

-- Chase music: while Domer chases you, the normal song fades out and a scary chase loop plays
-- (ChaseMusic, made from Roblox's built-in sounds), or the track in Config.Music.Chase if it has one.
local chaseSound: Sound? = nil
local chasing = false
-- The Eternal Storm: its march (StormMusic) plays instead of the normal song (a chase still wins).
local storming = false

local function chaseReady(): boolean
	return chaseSound ~= nil and chaseSound.IsLoaded and chaseSound.TimeLength > 0
end

local function applyVolume()
	local TweenService = game:GetService("TweenService")
	local fade = TweenInfo.new(0.6)
	local useChase = chasing and chaseReady()
	TweenService:Create(sound, fade, { Volume = if not musicOn or chasing or storming then 0 else volume }):Play()
	sound.PlaybackSpeed = 1
	if chasing and musicOn and not useChase then
		ChaseMusic.Start(volume)
	else
		ChaseMusic.Stop()
	end
	if storming and musicOn and not chasing then
		StormMusic.Start(volume)
	else
		StormMusic.Stop()
	end
	if chaseSound then
		if useChase and not chaseSound.IsPlaying then
			chaseSound.TimePosition = 0
			chaseSound:Play()
		end
		TweenService:Create(chaseSound, fade, { Volume = if useChase and musicOn then volume * 1.3 else 0 }):Play()
		if not chasing then
			task.delay(0.7, function()
				if not chasing and chaseSound then
					chaseSound:Stop()
				end
			end)
		end
	end
end

-- Chase.luau calls this when a chase starts (true) and ends (false).
function Settings.SetChasing(on: boolean)
	if on ~= chasing then
		chasing = on
		applyVolume()
	end
end

-- StormFX calls this when the Eternal Storm starts (true) and ends (false).
function Settings.SetStorm(on: boolean)
	if on ~= storming then
		storming = on
		if on and not musicOn then
			print("[Music] The Eternal Storm's song is muted because music is switched off (the music button or Settings).")
		end
		applyVolume()
	end
end

local function workingTracks(): number
	local count = 0
	for i = 1, #tracks do
		if not failed[i] then
			count += 1
		end
	end
	return count
end

local playTrack: (index: number) -> ()

playTrack = function(index: number)
	if #tracks == 0 then
		return
	end
	if workingTracks() == 0 and not usingFallback and #Config.Music.Fallback > 0 then
		-- None of the chosen songs loads: play the backup song(s) instead
		usingFallback = true
		tracks = Config.Music.Fallback
		table.clear(failed)
		playTrack(1)
		return
	end
	if workingTracks() == 0 then
		-- Nothing loaded (yet): try every song again in a while instead of going silent for good.
		sound:Stop()
		status = "Couldn't load the music - trying again soon"
		refresh()
		if not retryPending then
			retryPending = true
			task.delay(RETRY_DELAY, function()
				retryPending = false
				table.clear(failed)
				playTrack(trackIndex)
			end)
		end
		return
	end
	-- Skip songs that already failed
	for _ = 1, #tracks do
		trackIndex = (index - 1) % #tracks + 1
		if not failed[trackIndex] then
			break
		end
		index += 1
	end
	playToken += 1
	local token = playToken
	local track = tracks[trackIndex]
	sound:Stop()
	-- One song: let Roblox loop it seamlessly. Several: play them in turn (Ended / the watchdog).
	sound.Looped = workingTracks() <= 1
	sound.SoundId = "rbxassetid://" .. tostring(track.Id)
	sound.TimePosition = 0
	sound:Play()
	status = ""
	refresh()
	-- A song that never loads (private/deleted asset) never plays: skip it after a while.
	task.delay(LOAD_TIMEOUT, function()
		if token ~= playToken then
			return
		end
		if not sound.IsLoaded or sound.TimeLength <= 0 then
			failed[trackIndex] = true
			warn(`[Music] Couldn't load "{track.Name}" (rbxassetid://{track.Id}). Audio must be public or uploaded by the game's owner. Skipping it.`)
			playTrack(trackIndex + 1)
		end
	end)
end

local function save()
	State.Action("SetMusic", { Volume = volume, On = musicOn })
end

function Settings.Open()
	modal:Open()
end

function Settings.MusicOn(): boolean
	return musicOn
end

function Settings.SetMusicOn(on: boolean)
	if on == musicOn then
		return
	end
	musicOn = on
	applyVolume()
	refresh()
	save()
	Settings.MusicChanged:Fire(musicOn)
end

function Settings.Init()
	ChaseMusic.Preload()
	StormMusic.Preload()
	sound = Instance.new("Sound")
	sound.Name = "Soundtrack"
	sound.Looped = false
	sound.Parent = SoundService
	if Config.Music.Chase.Id > 0 then
		local chase = Instance.new("Sound")
		chase.Name = "ChaseMusic"
		chase.Looped = true
		chase.Volume = 0
		chase.SoundId = "rbxassetid://" .. tostring(Config.Music.Chase.Id)
		chase.Parent = SoundService
		chaseSound = chase
	end
	applyVolume()
	sound.Ended:Connect(function()
		if not sound.Looped then
			playTrack(trackIndex + 1)
		end
	end)
	-- Watchdog: if the music ever stops by itself (a missed Ended event, the engine dropping the
	-- sound...), start the next song. "Music off" only turns the volume down, so this never fights it.
	task.spawn(function()
		while true do
			task.wait(3)
			if #tracks > 0 and not retryPending and sound.IsLoaded and not sound.IsPlaying then
				playTrack(if sound.Looped then trackIndex else trackIndex + 1)
			end
		end
	end)

	modal = Modal.new("⚙️ SETTINGS", Theme.Colors.Gray, Vector2.new(520, 540))
	local body = modal.Body

	Theme.Label({ Text = "🎵 MUSIC", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 36), Parent = body })
	local nowPlaying = Theme.Label({ Text = "", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 40), StrokeThickness = 1.5, Parent = body })

	local toggle = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.fromOffset(150, 52), Position = UDim2.fromOffset(0, 80), Parent = body })
	local skip = Theme.Button({ Text = "NEXT ⏭", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(150, 52), Position = UDim2.fromOffset(160, 80), Parent = body })

	Theme.Label({ Text = "Volume", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 150), StrokeThickness = 1.5, Parent = body })
	local minus = Theme.Button({ Text = "−", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(0, 182), Parent = body })
	local bar = Theme.new("Frame", { Size = UDim2.fromOffset(300, 26), Position = UDim2.fromOffset(62, 195), BackgroundColor3 = Theme.Colors.Outline, Parent = body }, { Theme.Corner(8), Theme.Stroke(2) })
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(volume, 1), BackgroundColor3 = Theme.Colors.Green, Parent = bar }, { Theme.Corner(8) })
	local plus = Theme.Button({ Text = "+", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(372, 182), Parent = body })
	-- Run speed: a number you type (Enter or clicking away saves it)
	Theme.Label({ Text = "🏃 RUN SPEED", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 246), Parent = body })
	local speedBox = Theme.new("TextBox", {
		Name = "RunSpeed", Size = UDim2.fromOffset(150, 48), Position = UDim2.fromOffset(0, 286),
		BackgroundColor3 = Theme.Colors.PanelLight, TextColor3 = Color3.new(1, 1, 1), PlaceholderText = "type a number",
		PlaceholderColor3 = Color3.fromRGB(170, 170, 190), Text = "", Font = Theme.Font, TextScaled = true, ClearTextOnFocus = true, Parent = body,
	}, { Theme.Corner(10), Theme.Stroke(2), Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }) })
	local maxSpeed = Theme.Button({ Text = "MAX", Color = Theme.Colors.Green, Size = UDim2.fromOffset(100, 48), Position = UDim2.fromOffset(160, 286), Parent = body })
	local speedInfo = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -272, 0, 48), Position = UDim2.fromOffset(272, 286), StrokeThickness = 1.5, Parent = body })
	Theme.Label({
		Text = `Type how fast you want to run ({Config.Speed.MinRunSpeed} or more). MAX = as fast as you can go.`,
		Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 340), StrokeThickness = 1.2, Parent = body,
	})
	local function renderSpeed()
		local limit = State.Number("SpeedLimit")
		local top = math.floor(math.max(State.Number("WalkSpeed"), Config.Speed.BaseWalkSpeed))
		if not speedBox:IsFocused() then
			speedBox.Text = if limit > 0 then tostring(limit) else "MAX"
		end
		local now = if limit > 0 then math.min(limit, top) else top
		speedInfo.Text = `Running at <font color="#9dff7a"><b>{now}</b></font>\n<font size="18">Your top speed: {top}</font>`
		Theme.SetButtonColor(maxSpeed, if limit > 0 then Theme.Colors.Green else Theme.Colors.Gray)
	end
	speedBox.FocusLost:Connect(function()
		local typed = string.lower((string.gsub(speedBox.Text, "[%s,]", "")))
		local number = tonumber(typed)
		if typed == "max" or typed == "" and State.Number("SpeedLimit") == 0 then
			State.Action("SetSpeedLimit", 0)
		elseif number and number == number and number > 0 then
			State.Action("SetSpeedLimit", math.max(math.floor(number), Config.Speed.MinRunSpeed))
		end
		renderSpeed()
	end)
	maxSpeed.Activated:Connect(function()
		State.Action("SetSpeedLimit", 0)
	end)
	State.OnAttribute("SpeedLimit", renderSpeed)
	State.OnAttribute("WalkSpeed", renderSpeed)
	renderSpeed()

	local help = Theme.Button({ Text = "❓ HOW TO PLAY", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(220, 52), Position = UDim2.fromOffset(0, 376), Parent = body })
	help.Activated:Connect(function()
		modal:Close()
		require(script.Parent.Tutorial).Open()
	end)
	local notes = Theme.Button({ Text = "📰 UPDATE LOG", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(220, 52), Position = UDim2.fromOffset(230, 376), Parent = body })
	notes.Activated:Connect(function()
		require(script.Parent.UpdateNotes).Open()
	end)
	local percent = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.fromOffset(60, 30), Position = UDim2.fromOffset(430, 193), StrokeThickness = 1.5, Parent = body })

	refresh = function()
		Theme.SetButtonText(toggle, if musicOn then "MUSIC: ON" else "MUSIC: OFF")
		Theme.SetButtonColor(toggle, if musicOn then Theme.Colors.Green else Theme.Colors.Gray)
		fill.Size = UDim2.fromScale(volume, 1)
		percent.Text = math.floor(volume * 100 + 0.5) .. "%"
		if #tracks == 0 then
			nowPlaying.Text = "No songs added yet (Config.Music.Tracks)"
		elseif status ~= "" then
			nowPlaying.Text = status
		else
			nowPlaying.Text = "Now playing: " .. tracks[trackIndex].Name
		end
	end

	toggle.Activated:Connect(function()
		Settings.SetMusicOn(not musicOn)
	end)
	skip.Activated:Connect(function()
		playTrack(trackIndex + 1)
	end)
	local function changeVolume(delta: number)
		volume = math.clamp(math.floor((volume + delta) * 10 + 0.5) / 10, 0, 1)
		applyVolume()
		refresh()
		save()
	end
	minus.Activated:Connect(function()
		changeVolume(-0.1)
	end)
	plus.Activated:Connect(function()
		changeVolume(0.1)
	end)

	-- Use the player's saved settings once they arrive
	State.Changed:Connect(function(snapshot)
		if loaded then
			return
		end
		loaded = true
		if type(snapshot.MusicVolume) == "number" then
			volume = snapshot.MusicVolume
		end
		if type(snapshot.MusicOn) == "boolean" then
			musicOn = snapshot.MusicOn
		end
		applyVolume()
		refresh()
		Settings.MusicChanged:Fire(musicOn)
	end)

	refresh()
	playTrack(1)
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--[[
	Shop window with four tabs:
	  Upgrades  - Speed Multiplier, Treadmill tiers, a Bigger Base and Incubator upgrades (money)
	  Boosts    - 1.5x / 2x / 3x / 4x / 5x / 10x Money, 2x Speed, Teleporter and the Luck Event (Robux)
	  Crates    - Common / Rare / Epic / Legendary crates (Robux). Every outcome and its exact chance
	              is shown on the card, and "All odds" lists the pets inside every egg too (Roblox's
	              paid random items rules). Hidden purchase for players whose region blocks them.
	  Skins     - base skins (paid with your Speed stat), equip the ones you own
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Crates = require(Shared.Crates)
local CrateModel = require(Shared.CrateModel)
local Pets = require(Shared.Pets)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Shop = {}

local modal: Modal.Modal
local pages: { [string]: ScrollingFrame } = {}
local selectTab: (string) -> ()
local refreshers: { () -> () } = {}
local robuxPrices: { [number]: number } = {}
local priceFailed: { [number]: boolean } = {}

local function refreshAll()
	for _, refresh in refreshers do
		refresh()
	end
end

local function newPage(name: string, parent: Instance, columns: number, cardHeight: number): ScrollingFrame
	local page = Theme.new("ScrollingFrame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 1, -54),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = parent,
	}, {
		Theme.new("UIGridLayout", {
			CellSize = UDim2.new(1 / columns, -10, 0, cardHeight),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
	})
	pages[name] = page
	return page
end

local function card(parent: Instance, order: number, color: Color3): Frame
	return Theme.new("Frame", {
		BackgroundColor3 = Theme.Colors.PanelLight,
		LayoutOrder = order,
		Parent = parent,
	}, {
		Theme.Corner(14),
		Theme.Stroke(3, Theme.Darken(color, 0.3)),
		Theme.Gradient(Theme.Lighten(Theme.Colors.PanelLight, 0.08), Theme.Colors.Panel),
	})
end

--------------------------------------------------------------------------------
-- Upgrades
--------------------------------------------------------------------------------
local function buildUpgrades(page: ScrollingFrame)
	-- Speed multiplier
	local multCard = card(page, 1, Theme.Colors.Purple)
	Theme.Label({ Text = "⚡ SPEED MULTIPLIER", TextColor3 = Color3.fromRGB(200, 160, 255), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = multCard })
	local multInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = multCard })
	local multButton = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = multCard })
	multButton.Activated:Connect(function()
		State.Action("BuySpeedMultiplier")
	end)

	-- Treadmill
	local treadCard = card(page, 2, Theme.Colors.Orange)
	Theme.Label({ Text = "🏃 TREADMILL", TextColor3 = Color3.fromRGB(255, 200, 120), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = treadCard })
	local treadInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = treadCard })
	local treadButton = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = treadCard })
	treadButton.Activated:Connect(function()
		State.Action("BuyTreadmill")
	end)

	-- Bigger base
	local expandCard = card(page, 3, Theme.Colors.Blue)
	local expandTitle = Theme.Label({ Text = "🏢 BIGGER BASE", TextColor3 = Color3.fromRGB(140, 210, 255), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = expandCard })
	local expandInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = expandCard })
	local expandButton = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = expandCard })
	expandButton.Activated:Connect(function()
		if Economy.BaseSizeCost(math.max(1, State.Number("BaseLevel"))) then
			State.Action("BuyBaseSize")
		end
	end)

	-- Incubator upgrades
	local function incubatorCard(order: number, kind: string, title: string, color: Color3): (TextLabel, TextButton)
		local c = card(page, order, color)
		Theme.Label({ Text = title, TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.4), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = c })
		local info = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = c })
		local button = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = c })
		button.Activated:Connect(function()
			State.Action("BuyIncubatorUpgrade", kind)
		end)
		return info, button
	end
	local hatchInfo, hatchButton = incubatorCard(4, "Speed", "⚡ INCUBATOR SPEED", Theme.Colors.Pink)
	local sizeInfo, sizeButton = incubatorCard(5, "Size", "🥚 INCUBATOR SIZE", Theme.Colors.Orange)

	-- Summary
	local summary = card(page, 6, Theme.Colors.Blue)
	local summaryText = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -24, 1, -20), Position = UDim2.fromOffset(12, 10), StrokeThickness = 1.5, Parent = summary })
	local tip = card(page, 7, Theme.Colors.Green)
	Theme.Label({
		Text = "💡 Run on your treadmill to gain Speed. Every biome shows the Speed you need to get away from its Domer - and the further biomes have better boxes with donuts that earn way more! Upgrading your donuts (E on them) is cheap early on.",
		Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -24, 1, -20), Position = UDim2.fromOffset(12, 10), StrokeThickness = 1.5, Parent = tip,
	})

	table.insert(refreshers, function()
		local money = State.Number("Money")
		local passMult = math.max(1, State.Number("SpeedPassMultiplier"))

		local multLevel = State.Number("SpeedMultLevel")
		if multLevel >= Config.SpeedMultiplier.MaxLevel then
			multInfo.Text = `x{Format.Multiplier(Economy.SpeedMultiplier(multLevel))} (MAX)`
			Theme.SetButtonText(multButton, "MAXED")
			Theme.SetButtonColor(multButton, Theme.Colors.Gray)
		else
			local cost = Economy.SpeedMultiplierCost(multLevel)
			local percent = math.floor(Config.SpeedMultiplier.PerLevel * 100 + 0.5)
			multInfo.Text = `x{Format.Multiplier(Economy.SpeedMultiplier(multLevel))}  →  x{Format.Multiplier(Economy.SpeedMultiplier(multLevel + 1))}\n+{percent}% treadmill speed per level (Lv {multLevel}/{Config.SpeedMultiplier.MaxLevel})`
			Theme.SetButtonText(multButton, "Buy " .. Format.Money(cost))
			Theme.SetButtonColor(multButton, if money >= cost then Theme.Colors.Green else Theme.Colors.Gray)
		end

		local level = math.max(1, State.Number("TreadmillLevel"))
		local tier = Economy.TreadmillTier(level)
		if level >= Economy.MaxTreadmillLevel() then
			treadInfo.Text = `{tier.Name} (Tier {level}/{Economy.MaxTreadmillLevel()}) - the best!\n+{Format.Number(tier.PerStep)} speed every step`
			Theme.SetButtonText(treadButton, "MAXED")
			Theme.SetButtonColor(treadButton, Theme.Colors.Gray)
		else
			local nextTier = Economy.TreadmillTier(level + 1)
			treadInfo.Text = `{tier.Name} → {nextTier.Name} (Tier {level + 1}/{Economy.MaxTreadmillLevel()})\n+{Format.Number(tier.PerStep)} → +{Format.Number(nextTier.PerStep)} speed every step`
			Theme.SetButtonText(treadButton, "Buy " .. Format.Money(nextTier.Cost))
			Theme.SetButtonColor(treadButton, if money >= nextTier.Cost then Theme.Colors.Green else Theme.Colors.Gray)
		end

		local baseLevel = math.max(1, State.Number("BaseLevel"))
		local slots = Economy.SlotCount(baseLevel)
		local sizeCost = Economy.BaseSizeCost(baseLevel)
		if sizeCost then
			expandTitle.Text = "🍩 BIGGER BASE"
			expandInfo.Text = `Room for {slots} → {Economy.SlotCount(baseLevel + 1)} donuts\nKept forever`
			Theme.SetButtonText(expandButton, "Buy " .. Format.Money(sizeCost))
			Theme.SetButtonColor(expandButton, if money >= sizeCost then Theme.Colors.Green else Theme.Colors.Gray)
		else
			expandTitle.Text = "🍩 BASE"
			expandInfo.Text = `Room for {slots} donuts - as big as it gets!`
			Theme.SetButtonText(expandButton, "MAXED")
			Theme.SetButtonColor(expandButton, Theme.Colors.Gray)
		end

		local function incubatorRow(kind: string, info: TextLabel, button: TextButton)
			local level = State.Number(if kind == "Speed" then "IncubatorSpeed" else "IncubatorSize")
			local cost = Economy.IncubatorUpgradeCost(kind, level)
			local now = if kind == "Speed" then `x{Format.Multiplier(Economy.IncubatorSpeed(level))} hatch speed` else `{Economy.IncubatorCapacity(level)} eggs at once`
			if cost then
				local nextText = if kind == "Speed" then `x{Format.Multiplier(Economy.IncubatorSpeed(level + 1))}` else `{Economy.IncubatorCapacity(level + 1)} eggs`
				info.Text = `{now}  →  {nextText}\nKept forever`
				Theme.SetButtonText(button, "Buy " .. Format.Money(cost))
				Theme.SetButtonColor(button, if money >= cost then Theme.Colors.Green else Theme.Colors.Gray)
			else
				info.Text = `{now} (MAX)`
				Theme.SetButtonText(button, "MAXED")
				Theme.SetButtonColor(button, Theme.Colors.Gray)
			end
		end
		incubatorRow("Speed", hatchInfo, hatchButton)
		incubatorRow("Size", sizeInfo, sizeButton)

		local indexBonus = State.Number("IndexBonus")
		local petBonus = State.Number("PetSpeedBonus")
		local rate = Economy.TreadmillRate(level, multLevel, passMult, indexBonus, petBonus)
		local walk = State.Number("WalkSpeed")
		local extras = {}
		if indexBonus > 0 then
			table.insert(extras, `📖 +{indexBonus}%`)
		end
		if petBonus > 0 then
			table.insert(extras, `🐾 +{math.floor(petBonus * 100 + 0.5)}%`)
		end
		local extraText = if #extras > 0 then " (" .. table.concat(extras, " ") .. ")" else ""
		summaryText.Text = `<b>YOUR STATS</b>\nTreadmill: <font color="#c9a0ff">+{Format.Rate(rate)} speed/s</font>{extraText}\nSpeed: <font color="#c9a0ff">{Format.Number(State.Number("Speed"))}</font> (walk speed {math.floor(walk)})\nIncome: <font color="#8dff6a">{Format.Money(State.Number("Income"))}/s</font>`
	end)
end

--------------------------------------------------------------------------------
-- Game passes
--------------------------------------------------------------------------------
local function robuxText(passId: number, suggested: number): string
	if passId <= 0 then
		return `R$ {suggested}`
	end
	local price = robuxPrices[passId]
	return if price then `R$ {price}` elseif priceFailed[passId] then "BUY" else "R$ ..."
end

local function fetchPrice(passId: number, infoType: Enum.InfoType?)
	if passId <= 0 or robuxPrices[passId] then
		return
	end
	task.spawn(function()
		for attempt = 1, 3 do
			local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, passId, infoType or Enum.InfoType.GamePass)
			if ok and info and info.PriceInRobux then
				robuxPrices[passId] = info.PriceInRobux
				refreshAll()
				return
			end
			task.wait(attempt * 3)
		end
		priceFailed[passId] = true -- still buyable: the button just says BUY
		refreshAll()
	end)
end

-- Do you own this pass, or one that does exactly the same (Config.GamePasses SameAs)?
local function ownsPass(pass: Config.GamePass): boolean
	if State.Data.Passes[pass.Key] then
		return true
	end
	for _, other in Config.GamePasses do
		if other.SameAs == pass.Key and State.Data.Passes[other.Key] then
			return true
		end
	end
	return false
end

local function buildPasses(page: ScrollingFrame)
	for order, pass in Config.GamePasses do
		if pass.SameAs then
			continue -- (the same as another pass: only that one is sold)
		end
		fetchPrice(pass.GamePassId)
		local c = card(page, order, pass.Color)
		local icon = if pass.Kind == "Money" then "💵" elseif pass.Kind == "Speed" then "⚡" else "🌀"
		local description = if pass.Kind == "Money"
			then `Earn {pass.Multiplier}x money from every donut, forever`
			elseif pass.Kind == "Speed" then "Double speed from your treadmill, forever"
			else "Teleport to any world or area you've unlocked, any time (a 🌀 TELEPORT button)"
		Theme.Label({ Text = icon, Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(10, 10), Parent = c })
		Theme.Label({ Text = string.upper(pass.Name), TextColor3 = pass.Color:Lerp(Color3.new(1, 1, 1), 0.3), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 12), Parent = c })
		Theme.Label({
			Text = description,
			Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 50), StrokeThickness = 1.2, Parent = c,
		})
		local button = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 48), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = c })
		button.Activated:Connect(function()
			if not ownsPass(pass) then
				State.Action("BuyPass", pass.Key)
			end
		end)
		table.insert(refreshers, function()
			if ownsPass(pass) then
				Theme.SetButtonText(button, "OWNED ✓")
				Theme.SetButtonColor(button, Theme.Colors.Gray)
			else
				Theme.SetButtonText(button, robuxText(pass.GamePassId, pass.SuggestedPrice))
				Theme.SetButtonColor(button, Theme.Colors.Green)
			end
		end)
	end
	-- Luck Event (a developer product: can be bought again and again)
	local luck = card(page, 90, Color3.fromRGB(60, 200, 90))
	Theme.Label({ Text = "🍀", Font = Enum.Font.GothamBold, Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(10, 10), Parent = luck })
	Theme.Label({ Text = "LUCK EVENT (10 MIN)", TextColor3 = Color3.fromRGB(140, 255, 160), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 12), Parent = luck })
	Theme.Label({ Text = `Rarer boxes x{Config.LuckEvent.RarityLuck}, mutations x{Config.LuckEvent.MutationLuck}, bigger boxes x{Config.LuckEvent.BigSizeLuck} for EVERYONE (boosted odds show in the Index)`, Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 50), StrokeThickness = 1.2, Parent = luck })
	local luckButton = Theme.Button({ Text = `R$ {Config.LuckEvent.SuggestedPrice}`, Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 48), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = luck })
	luckButton.Activated:Connect(function()
		State.Action("BuyLuck")
	end)

	if Config.MoneyPassStacking == "Additive" then
		local note = card(page, 100, Theme.Colors.Blue)
		Theme.Label({ Text = "💡 Money passes stack! Own 2x + 3x = 4x money.", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10), StrokeThickness = 1.5, Parent = note })
	end
end

--------------------------------------------------------------------------------
-- Crates
--------------------------------------------------------------------------------
local KIND_ICON = { Coins = "💰", SpeedBoost = "⚡", Luck = "🍀", Egg = "🥚", Pet = "🐾" }

-- What an outcome gives, in words (coins are estimated for you right now).
local function outcomeText(outcome: Crates.Outcome): string
	local reward = outcome.Reward
	if reward.Kind == "Coins" then
		local amount = Economy.CrateCoins(reward.Seconds or 60, State.Number("Speed"))
		return `Coins (~{Format.Money(amount)} for you now)`
	elseif reward.Kind == "SpeedBoost" then
		return `Speed Boost: run {math.floor((Config.Crates.SpeedBoostMultiplier - 1) * 100 + 0.5)}% faster for {Format.Duration(reward.Seconds or 600)}`
	elseif reward.Kind == "Luck" then
		return `Luck Event for the whole server ({Format.Duration(reward.Seconds or 600)})`
	elseif outcome.Egg then
		local egg = Pets.EggById[outcome.Egg]
		return if egg then egg.Name .. (if egg.CrateOnly then " (exclusive)" else "") else outcome.Egg
	elseif outcome.Pet then
		local pet = Pets.ById[outcome.Pet]
		return if pet then `{pet.Name} ({pet.Rarity} pet, exclusive)` else outcome.Pet
	end
	return reward.Kind
end

local function buildCrates(page: ScrollingFrame, body: Instance)
	-- "All odds" panel (on top of the shop): every outcome, and the pets inside every egg
	local details = Theme.new("Frame", {
		Name = "CrateOdds",
		BackgroundColor3 = Theme.Colors.Panel,
		Size = UDim2.new(1, 0, 1, -54),
		Position = UDim2.fromOffset(0, 54),
		Visible = false,
		ZIndex = 20,
		Parent = body,
	}, { Theme.Corner(14), Theme.Stroke(3) })
	local detailsTitle = Theme.Label({ Text = "", Size = UDim2.new(1, -130, 0, 36), Position = UDim2.fromOffset(12, 8), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21, Parent = details })
	local close = Theme.Button({ Text = "BACK", Color = Theme.Colors.Red, Size = UDim2.fromOffset(100, 38), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Parent = details })
	close.ZIndex = 21
	close.Activated:Connect(function()
		details.Visible = false
	end)
	local detailsText = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 52),
		Size = UDim2.new(1, -24, 1, -62),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		ZIndex = 21,
		Parent = details,
	})
	local detailsLabel = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextScaled = false, TextSize = 20, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -12, 0, 0), StrokeThickness = 1.2, ZIndex = 21, Parent = detailsText })

	local function showOdds(crate: Crates.Crate)
		detailsTitle.Text = `🎁 {string.upper(crate.Name)} - ALL ODDS`
		local lines = { "You get ONE of these (adds up to 100%). Luck and passes never change these odds.", "" }
		for _, outcome in Crates.Odds(crate) do
			table.insert(lines, `<b>{KIND_ICON[outcome.Reward.Kind] or "🎁"} {outcomeText(outcome)}: {Format.Odds(outcome.Chance)}</b>`)
			local egg = if outcome.Egg then Pets.EggById[outcome.Egg] else nil
			if egg then
				table.insert(lines, `      it hatches (after {Format.Duration(egg.HatchSeconds)}) into:`)
				for _, entry in egg.Pool do
					local pet = Pets.ById[entry.Pet]
					local inEgg = Pets.Chance(egg, entry.Pet)
					table.insert(lines, `      • {pet.Name} ({pet.Rarity}, {Pets.BonusText(pet)}): {Format.Odds(inEgg)} of the egg = {Format.Odds(outcome.Chance * inEgg)} of the crate`)
				end
			end
		end
		detailsLabel.Text = table.concat(lines, "\n")
		details.Visible = true
	end

	local spinning: { Camera } = {}
	for _, crate in Crates.List do
		local product = Config.Crates.Products[crate.Id]
		fetchPrice(product.DeveloperProductId, Enum.InfoType.Product)
		local c = card(page, crate.Order, crate.Color)
		local viewport = Theme.new("ViewportFrame", {
			BackgroundColor3 = Color3.fromRGB(25, 25, 40),
			Size = UDim2.fromOffset(84, 84),
			Position = UDim2.fromOffset(8, 8),
			Ambient = Color3.fromRGB(180, 180, 180),
			LightColor = Color3.fromRGB(255, 255, 255),
			LightDirection = Vector3.new(-0.5, -1, 0.8),
			Parent = c,
		}, { Theme.Corner(10) })
		local model = CrateModel.Build(crate.Id, { NoEffects = true })
		model:PivotTo(CFrame.new(0, -0.3, 0))
		model.Parent = viewport
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		table.insert(spinning, camera)
		Theme.Label({ Text = string.upper(crate.Name), TextColor3 = crate.Color:Lerp(Color3.new(1, 1, 1), 0.35), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -110, 0, 32), Position = UDim2.fromOffset(100, 10), Parent = c })
		Theme.Label({ Text = "Opens right away: ONE of these", Font = Theme.Font, TextColor3 = Color3.fromRGB(200, 200, 210), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -110, 0, 20), Position = UDim2.fromOffset(100, 44), StrokeThickness = 1, Parent = c })
		local odds = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, -20, 0, 118), Position = UDim2.fromOffset(10, 98), StrokeThickness = 1.2, Parent = c })
		local all = Theme.Button({ Text = "📋 All odds", Color = Theme.Colors.Blue, Size = UDim2.new(0.38, -12, 0, 46), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -10), Parent = c })
		all.Activated:Connect(function()
			showOdds(crate)
		end)
		local buy = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(0.62, -12, 0, 46), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -10), Parent = c })
		buy.Activated:Connect(function()
			-- The server double-checks and explains if crates can't be bought here
			State.Action("BuyCrate", crate.Id)
		end)
		table.insert(refreshers, function()
			local lines = {}
			for _, outcome in Crates.Odds(crate) do
				table.insert(lines, `{KIND_ICON[outcome.Reward.Kind] or "🎁"} {outcomeText(outcome)} <b>{Format.Odds(outcome.Chance)}</b>`)
			end
			odds.Text = table.concat(lines, "\n")
			if State.Get("CratesBlocked") == true then
				Theme.SetButtonText(buy, "Not available in your region")
				Theme.SetButtonColor(buy, Theme.Colors.Gray)
			else
				Theme.SetButtonText(buy, robuxText(product.DeveloperProductId, product.Price))
				Theme.SetButtonColor(buy, Theme.Colors.Green)
			end
		end)
	end
	local note = card(page, 10, Theme.Colors.Orange)
	Theme.Label({ Text = "🎁 Crates also show up for free in the lane now and then - hold E to open one! Eggs go straight into your incubator.", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10), StrokeThickness = 1.5, Parent = note })
	RunService.RenderStepped:Connect(function()
		if not page.Visible then
			return
		end
		local angle = os.clock() * 0.8
		for _, camera in spinning do
			camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(angle) * 11, 4, -math.cos(angle) * 11), Vector3.new(0, 0.2, 0))
		end
	end)
	State.OnAttribute("CratesBlocked", refreshAll)
end

--------------------------------------------------------------------------------
-- Skins
--------------------------------------------------------------------------------
local function buildSkins(page: ScrollingFrame)
	local note = card(page, 0, Theme.Colors.Purple)
	Theme.Label({ Text = "🎨 Skins are bought with SPEED ⚡ (you'll be slower until you train it back). They're yours forever!", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10), StrokeThickness = 1.5, Parent = note })
	for order, skin in Config.Skins do
		local c = card(page, order, skin.Trim)
		-- Colour swatch preview of the skin
		local swatch = Theme.new("Frame", { Size = UDim2.new(1, -20, 0, 64), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = skin.Floor, Parent = c }, { Theme.Corner(10), Theme.Stroke(2) })
		for i, color in { skin.FloorAlt, skin.Fence, skin.Trim, skin.Pedestal } do
			Theme.new("Frame", { Size = UDim2.new(0.2, -4, 1, -16), Position = UDim2.new(0.04 + (i - 1) * 0.24, 0, 0, 8), BackgroundColor3 = color, Parent = swatch }, { Theme.Corner(8), Theme.Stroke(1.5) })
		end
		Theme.Label({ Text = string.upper(skin.Name), Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 80), Parent = c })
		if skin.OwnerOnly then
			-- only the game's owner sees this one
			State.OnAttribute("AdminOwner", function(value)
				c.Visible = value == true
			end)
		end
		local button = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 46), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = c })
		button.Activated:Connect(function()
			if State.Data.OwnedSkins[skin.Id] or skin.SpeedCost <= 0 then
				State.Action("EquipSkin", skin.Id)
			else
				State.Action("BuySkin", skin.Id)
			end
		end)
		table.insert(refreshers, function()
			local owned = skin.SpeedCost <= 0 or State.Data.OwnedSkins[skin.Id]
			if skin.OwnerOnly then
				owned = c.Visible
			end
			if State.Data.EquippedSkin == skin.Id then
				Theme.SetButtonText(button, "EQUIPPED")
				Theme.SetButtonColor(button, Theme.Colors.Gray)
			elseif owned then
				Theme.SetButtonText(button, "EQUIP")
				Theme.SetButtonColor(button, Theme.Colors.Blue)
			else
				Theme.SetButtonText(button, "⚡ " .. Format.Number(skin.SpeedCost))
				Theme.SetButtonColor(button, if State.Number("Speed") >= skin.SpeedCost then Theme.Colors.Purple else Theme.Colors.Gray)
			end
		end)
	end
end

function Shop.Open(tab: string?)
	modal:Open()
	selectTab(tab or "Upgrades")
end

function Shop.Init()
	modal = Modal.new("🛒 SHOP", Theme.Colors.Green, Vector2.new(740, 490))
	local body = modal.Body
	selectTab = Modal.Tabs(body, {
		{ Name = "Upgrades", Text = "⚡ Upgrades", Color = Theme.Colors.Purple },
		{ Name = "Passes", Text = "🚀 Boosts", Color = Theme.Colors.Orange },
		{ Name = "Crates", Text = "🎁 Crates", Color = Theme.Colors.Yellow },
		{ Name = "Skins", Text = "🎨 Skins", Color = Theme.Colors.Pink },
	}, function(name)
		for pageName, page in pages do
			page.Visible = pageName == name
		end
		refreshAll()
	end)
	buildUpgrades(newPage("Upgrades", body, 2, 190))
	buildPasses(newPage("Passes", body, 2, 160))
	buildCrates(newPage("Crates", body, 2, 290), body)
	buildSkins(newPage("Skins", body, 3, 180))

	for _, name in { "Money", "Speed", "SpeedMultLevel", "TreadmillLevel", "SpeedPassMultiplier", "Income", "BaseLevel", "IndexBonus", "IncubatorSpeed", "IncubatorSize" } do
		State.OnAttribute(name, function()
			if modal:IsOpen() then
				refreshAll()
			end
		end)
	end
	State.Changed:Connect(refreshAll)

	-- Shop stalls in the lobby (if a baked map still has any): walk onto a glowing circle (or press
	-- E at the counter) to open that stall's tab. Walking off closes it again.
	task.spawn(function()
		local hub = workspace:WaitForChild("Map"):WaitForChild("Hub")
		local player = Players.LocalPlayer :: Player
		local stalls: { { Glow: BasePart, Tab: string, Inside: boolean } } = {}
		local autoOpened = false
		local function addStall(stall: Instance)
			local tab = stall:GetAttribute("ShopTab")
			if type(tab) ~= "string" then
				return
			end
			local glow = stall:WaitForChild("Glow") :: BasePart
			local promptPart = stall:WaitForChild("PromptPart")
			table.insert(stalls, { Glow = glow, Tab = tab, Inside = false })
			local proximity = Theme.new("ProximityPrompt", {
				ActionText = "Open",
				ObjectText = stall.Name,
				HoldDuration = 0,
				MaxActivationDistance = 12,
				RequiresLineOfSight = false,
				Parent = promptPart,
			})
			proximity.Triggered:Connect(function()
				Shop.Open(tab)
			end)
		end
		for _, child in hub:GetChildren() do
			task.spawn(addStall, child)
		end
		while true do
			task.wait(0.15)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			for _, stall in stalls do
				local inside = false
				if root then
					local offset = root.Position - stall.Glow.Position
					inside = Vector2.new(offset.X, offset.Z).Magnitude < stall.Glow.Size.Y / 2 and math.abs(offset.Y) < 8
				end
				if inside and not stall.Inside then
					Shop.Open(stall.Tab)
					autoOpened = true
				elseif not inside and stall.Inside and autoOpened then
					modal:Close()
					autoOpened = false
				end
				stall.Inside = inside
			end
		end
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">SkipOdds</string>
              <string name="Source"><![CDATA[--[[
	SkipOdds: "Open now" on a box in your pen. The donut inside is only picked when the box opens,
	so opening it for Robux is buying a random item, and Roblox's rules want every donut it can
	give, with its chance, shown BEFORE the purchase. The server sends the box here
	(ProductService.SkipBox: only where paid random items are allowed); BUY asks the server for
	the purchase (the "ConfirmSkip" action).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Boxes = require(Shared.Boxes)
local Config = require(Shared.Config)
local Donuts = require(Shared.Donuts)
local Format = require(Shared.Format)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local SkipOdds = {}

-- Every donut a box from `area` of this tier can give, most likely first (adds up to 100%).
function SkipOdds.Lines(area: number, tierId: string): { string }
	local pool = Donuts.ByBox[area] and Donuts.ByBox[area][tierId] or {}
	local list = table.clone(pool)
	table.sort(list, function(a, b)
		return Donuts.Chance(a) > Donuts.Chance(b)
	end)
	local lines = {}
	for _, donut in list do
		local rarity = Rarities.Get(donut.Rarity)
		table.insert(lines, `<font color="#{rarity.Color:ToHex()}">{donut.Name}</font> ({rarity.Id}): <b>{Format.Odds(Donuts.Chance(donut))}</b>`)
	end
	return lines
end

function SkipOdds.Init()
	local modal = Modal.new("📦 OPEN IT NOW?", Theme.Colors.Green, Vector2.new(560, 470))
	local body = modal.Body
	local heading = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 50), StrokeThickness = 1.5, Parent = body })
	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 1, -120),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = body,
	})
	local odds = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextScaled = false, TextSize = 20, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -12, 0, 0), StrokeThickness = 1.2, Parent = scroll })
	local buy = Theme.Button({ Text = `BUY  R$ {Config.Boxes.SkipPrice}`, Color = Theme.Colors.Green, Size = UDim2.new(0.6, -6, 0, 52), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = body })
	local cancel = Theme.Button({ Text = "No thanks", Color = Theme.Colors.Gray, Size = UDim2.new(0.4, -6, 0, 52), AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Parent = body })
	local slot: number? = nil
	buy.Activated:Connect(function()
		if slot then
			State.Action("ConfirmSkip", slot)
		end
		modal:Close()
	end)
	cancel.Activated:Connect(function()
		modal:Close()
	end)
	Remotes.Event("SkipOdds").OnClientEvent:Connect(function(info: any)
		if type(info) ~= "table" or type(info.Slot) ~= "number" or type(info.Area) ~= "number" or type(info.Tier) ~= "string" then
			return
		end
		slot = info.Slot
		local mutation = Rarities.Mutation(info.Mutation)
		local name = Rarities.DisplayName(Boxes.DisplayName(info.Tier, info.Size), mutation.Id, nil)
		heading.Text = `Open your <b>{name}</b> right away. Its size and mutation are already set; the donut inside is ONE of these:`
		odds.Text = table.concat(SkipOdds.Lines(info.Area, info.Tier), "\n")
		modal:Open()
	end)
end

return SkipOdds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">StormMusic</string>
              <string name="Source"><![CDATA[--[[
	StormMusic: the Eternal Storm's song, the Radetzky March (Settings starts and stops it).

	The recording in Config.EternalStorm.MusicId (the Radetzky March from the Creator Store) plays,
	looped. With no id (or if it can't load: a warning says so in the Output window) a built-in version plays,
	made from sounds every Roblox client already has: the march's tune on a bright bell, an
	"oom-pah" bass and chords under it, a bass drum and snare, and a drum roll to start. (It was
	written out from memory, so it's the tune's style more than an exact copy of the score.)
]]

local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local StormMusic = {}

local LOUDNESS = 0.9
local BPM = 112 -- quarter notes a minute
local STEP = 60 / BPM / 4 -- one sixteenth note
local BELL = "rbxasset://sounds/electronicpingshort.wav"
local THUMP = "rbxasset://sounds/action_jump_land.mp3"
local TICK = "rbxasset://sounds/button.wav"
local D5_SPEED = 0.6 -- the bell's speed for the note D5 (every other note is worked out from it)
local LOAD_TIMEOUT = 8 -- seconds the recording may take to load before the built-in march takes over

-- Note names -> MIDI numbers (D major: F# and C# are sharp)
local NOTES: { [string]: number } = {
	A3 = 57, D4 = 62, E4 = 64, Fs4 = 66, G4 = 67, A4 = 69, B4 = 71, Cs5 = 73, D5 = 74, E5 = 76, Fs5 = 78, G5 = 79, A5 = 81, B5 = 83, Cs6 = 85, D6 = 86,
	A2 = 45, D3 = 50, E3 = 52, Fs3 = 54,
}

-- The tune: { note, sixteenths } per bar ("R" = rest). Chords: "D" (D F# A) or "A" (A C# E).
type Bar = { Notes: { { any } }, Chord: string }
local function bar(chord: string, notes: { { any } }): Bar
	return { Notes = notes, Chord = chord }
end
local THEME: { Bar } = {
	bar("D", { { "D5", 2 }, { "D5", 1 }, { "D5", 1 }, { "D5", 1 }, { "Cs5", 1 }, { "D5", 1 }, { "E5", 1 } }),
	bar("D", { { "Fs5", 2 }, { "Fs5", 1 }, { "Fs5", 1 }, { "Fs5", 1 }, { "E5", 1 }, { "Fs5", 1 }, { "G5", 1 } }),
	bar("A", { { "A5", 2 }, { "A5", 1 }, { "A5", 1 }, { "A5", 1 }, { "B5", 1 }, { "A5", 1 }, { "G5", 1 } }),
	bar("D", { { "Fs5", 2 }, { "A5", 2 }, { "D6", 2 }, { "R", 2 } }),
	bar("A", { { "B4", 2 }, { "B4", 1 }, { "B4", 1 }, { "B4", 1 }, { "A4", 1 }, { "B4", 1 }, { "Cs5", 1 } }),
	bar("D", { { "D5", 2 }, { "D5", 1 }, { "D5", 1 }, { "D5", 1 }, { "Cs5", 1 }, { "D5", 1 }, { "E5", 1 } }),
	bar("A", { { "Fs5", 2 }, { "E5", 2 }, { "D5", 2 }, { "Cs5", 2 } }),
	bar("D", { { "D5", 4 }, { "R", 2 }, { "A4", 2 } }),
	-- and louder, up high
	bar("A", { { "A5", 2 }, { "A5", 2 }, { "A5", 2 }, { "A5", 2 } }),
	bar("A", { { "B5", 2 }, { "A5", 2 }, { "G5", 2 }, { "Fs5", 2 } }),
	bar("A", { { "E5", 2 }, { "E5", 2 }, { "E5", 2 }, { "E5", 2 } }),
	bar("A", { { "Fs5", 2 }, { "E5", 2 }, { "D5", 2 }, { "Cs5", 2 } }),
	bar("D", { { "D5", 2 }, { "Fs5", 2 }, { "A5", 2 }, { "D6", 2 } }),
	bar("A", { { "Cs6", 2 }, { "B5", 2 }, { "A5", 2 }, { "G5", 2 } }),
	bar("A", { { "Fs5", 2 }, { "E5", 2 }, { "D5", 2 }, { "Cs5", 2 } }),
	bar("D", { { "D5", 4 }, { "R", 2 }, { "A4", 2 } }),
}
local CHORDS: { [string]: { Root: string, Fifth: string, Upper: { string } } } = {
	D = { Root = "D3", Fifth = "A2", Upper = { "Fs4", "A4" } },
	A = { Root = "A2", Fifth = "E3", Upper = { "E4", "Cs5" } },
}

local group: SoundGroup? = nil
local voices: { [string]: { Sounds: { Sound }, Next: number } } = {}
local recording: Sound? = nil
local recordingFailed = false
local playing = false
local token = 0

local function voice(name: string, id: string, volume: number, count: number)
	local list = {}
	for i = 1, count do
		local sound = Instance.new("Sound")
		sound.Name = name .. i
		sound.SoundId = id
		sound.Volume = volume
		sound.SoundGroup = group
		sound.Parent = group
		table.insert(list, sound)
	end
	voices[name] = { Sounds = list, Next = 1 }
end

-- "1844280451" works as well as "rbxassetid://1844280451"
local function contentId(id: string): string
	if string.match(id, "^%s*%d+%s*$") then
		return "rbxassetid://" .. (string.gsub(id, "%s", ""))
	end
	return id
end

local function setup()
	if group then
		return
	end
	local g = Instance.new("SoundGroup")
	g.Name = "StormMusic"
	g.Volume = 0
	g.Parent = SoundService
	group = g
	local eq = Instance.new("EqualizerSoundEffect")
	eq.LowGain = 3
	eq.MidGain = 0
	eq.HighGain = -9 -- (the bell is bright: soften it)
	eq.Priority = 3
	eq.Parent = g
	local compressor = Instance.new("CompressorSoundEffect")
	compressor.Threshold = -18
	compressor.Ratio = 3
	compressor.Priority = 2
	compressor.Parent = g
	local reverb = Instance.new("ReverbSoundEffect")
	reverb.DecayTime = 1.4
	reverb.WetLevel = -10
	reverb.Priority = 1
	reverb.Parent = g
	voice("Lead", BELL, 0.55, 3)
	voice("Chord", BELL, 0.16, 4)
	voice("Bass", BELL, 0.4, 2)
	voice("Kick", THUMP, 0.45, 2)
	voice("Snare", TICK, 0.12, 3)
	local id = Config.EternalStorm.MusicId
	if id ~= "" then
		local sound = Instance.new("Sound")
		sound.Name = "Recording"
		sound.SoundId = contentId(id)
		sound.Looped = true
		sound.Volume = 0.8
		sound.SoundGroup = g
		sound.Parent = g
		recording = sound
	end
end

local function play(name: string, speed: number)
	local v = voices[name]
	if not v then
		return
	end
	local sound = v.Sounds[v.Next]
	v.Next = v.Next % #v.Sounds + 1
	sound.PlaybackSpeed = speed
	sound.TimePosition = 0
	sound:Play()
end

local function bell(note: string): number
	return D5_SPEED * 2 ^ ((NOTES[note] - NOTES.D5) / 12)
end

-- Make the sounds now (and load them), so the storm's first note isn't late.
function StormMusic.Preload()
	setup()
	task.spawn(function()
		local list: { Instance } = {}
		for _, v in voices do
			table.insert(list, v.Sounds[1])
		end
		if recording then
			table.insert(list, recording)
		end
		pcall(function()
			ContentProvider:PreloadAsync(list, function(id: string, status: Enum.AssetFetchStatus)
				if recording and id == recording.SoundId and status == Enum.AssetFetchStatus.Failure then
					recordingFailed = true
				end
			end)
		end)
	end)
end

function StormMusic.IsPlaying(): boolean
	return playing
end

-- `volume`: the player's music volume (0-1).
function StormMusic.SetVolume(volume: number)
	if group and playing then
		TweenService:Create(group, TweenInfo.new(0.5), { Volume = volume * LOUDNESS * Config.EternalStorm.MusicVolume }):Play()
	end
end

-- The built-in march, looped: a drum roll, then the tune over and over.
local function march(myToken: number)
	local start = os.clock()
	local step = 0
	local function waitSteps(count: number)
		step += count
		local delay = start + step * STEP - os.clock()
		if delay > 0 then
			task.wait(delay)
		end
	end
	-- drum roll (two bars), then a big chord
	for i = 1, 16 do
		if not playing or token ~= myToken then
			return
		end
		play("Snare", 0.9 + (i % 2) * 0.1)
		waitSteps(1)
	end
	play("Kick", 0.42)
	play("Bass", bell("D3"))
	for _, note in CHORDS.D.Upper do
		play("Chord", bell(note))
	end
	waitSteps(6)
	play("Lead", bell("A4")) -- the pick-up into the tune
	waitSteps(2)
	while playing and token == myToken do
		for _, b in THEME do
			local chord = CHORDS[b.Chord]
			-- oom-pah under the tune: bass and drum on the beat, chord on the off-beat
			local accompaniment: { [number]: string } = { [0] = "Root", [2] = "Chord", [4] = "Fifth", [6] = "Chord" }
			local melodyAt: { [number]: string } = {}
			local at = 0
			for _, entry in b.Notes do
				melodyAt[at] = entry[1]
				at += entry[2]
			end
			for s = 0, 7 do
				if not playing or token ~= myToken then
					return
				end
				local note = melodyAt[s]
				if note and note ~= "R" then
					play("Lead", bell(note))
				end
				local part = accompaniment[s]
				if part == "Root" or part == "Fifth" then
					play("Bass", bell(if part == "Root" then chord.Root else chord.Fifth))
					play("Kick", 0.42)
				elseif part == "Chord" then
					for _, upper in chord.Upper do
						play("Chord", bell(upper))
					end
					play("Snare", 1)
				end
				waitSteps(1)
			end
		end
	end
end

function StormMusic.Start(volume: number)
	setup()
	if playing then
		StormMusic.SetVolume(volume)
		return
	end
	playing = true
	token += 1
	local myToken = token
	local g = group :: SoundGroup
	TweenService:Create(g, TweenInfo.new(0.8), { Volume = volume * LOUDNESS * Config.EternalStorm.MusicVolume }):Play()
	local track = recording
	if track and not recordingFailed then
		track.TimePosition = 0
		track:Play()
		print(`[Music] Eternal Storm: playing {track.SoundId}`)
		-- a recording that can't load (private, deleted, not an audio) falls back to the built-in march
		task.spawn(function()
			local function ready(): boolean
				return track.IsLoaded and track.TimeLength > 0
			end
			local waited = 0
			while waited < LOAD_TIMEOUT and not recordingFailed and not ready() do
				waited += task.wait(0.25)
			end
			if playing and token == myToken and not ready() then
				recordingFailed = true
				track:Stop()
				warn(`[Music] Couldn't load the Eternal Storm song ({track.SoundId}). Audio must be public or uploaded by the game's owner. Playing the built-in march instead.`)
				task.spawn(march, myToken)
			end
		end)
	else
		print("[Music] Eternal Storm: playing the built-in march")
		task.spawn(march, myToken)
	end
end

function StormMusic.Stop()
	if not playing then
		return
	end
	playing = false
	token += 1
	local g = group
	if g then
		TweenService:Create(g, TweenInfo.new(0.8), { Volume = 0 }):Play()
		local myToken = token
		task.delay(0.9, function()
			if token == myToken and recording then
				recording:Stop()
			end
		end)
	end
end

return StormMusic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">Teleport</string>
              <string name="Source"><![CDATA[--[[
	Teleport window: every biome and the Speed it needs. With the Teleporter game pass you can jump
	straight to the start of any biome (or home); everyone else sees what's
	ahead of them and what it takes to get there.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Format = require(Shared.Format)
local Economy = require(Shared.Economy)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Teleport = {}

local modal: Modal.Modal
local refreshers: { () -> () } = {}

function Teleport.Open()
	modal:Open()
end

local function refreshAll()
	for _, refresh in refreshers do
		refresh()
	end
end

function Teleport.Init()
	modal = Modal.new("🌀 BIOMES & TELEPORT", Theme.Colors.Blue, Vector2.new(760, 540))
	local body = modal.Body
	local header = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -210, 0, 44), Parent = body })
	local passButton = Theme.Button({ Text = "🌀 Get Teleporter", Color = Theme.Colors.Green, Size = UDim2.fromOffset(200, 44), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Parent = body })
	passButton.Activated:Connect(function()
		State.Action("BuyPass", "Teleporter")
	end)

	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 1, -52),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = body,
	}, {
		Theme.new("UIGridLayout", { CellSize = UDim2.new(0.25, -8, 0, 74), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
	})

	local home = Theme.Button({ Text = "🏠 Home", Color = Theme.Colors.Green, Size = UDim2.new(), LayoutOrder = 0, Parent = scroll })
	home.Activated:Connect(function()
		State.Action("TeleportHome")
	end)
	for _, area in Areas.List do
		local button = Theme.Button({ Text = "", Color = area.Trim, Size = UDim2.new(), LayoutOrder = area.Id, Parent = scroll })
		button.Activated:Connect(function()
			State.Action("TeleportArea", area.Id)
		end)
		table.insert(refreshers, function()
			local hasPass = State.Data.Passes.Teleporter == true
			local escape = Economy.EscapeSpeed(area.Id)
			local need = if escape > 0 then `⚡{Format.Number(escape)} to escape` else "start here"
			Theme.SetButtonText(button, `{area.Id}. {area.Name}\n{need}`)
			Theme.SetButtonColor(button, if hasPass then area.Trim else Theme.Colors.Gray)
		end)
	end

	table.insert(refreshers, function()
		local hasPass = State.Data.Passes.Teleporter == true
		passButton.Visible = not hasPass
		header.Text = if hasPass
			then "🌀 <b>Teleporter active!</b> Jump to any biome."
			else "The <b>Teleporter</b> pass lets you jump to any biome instantly."
	end)

	modal.OnOpen = refreshAll
	State.Changed:Connect(function()
		if modal:IsOpen() then
			refreshAll()
		end
	end)
	State.OnAttribute("Speed", function()
		if modal:IsOpen() then
			refreshAll()
		end
	end)
end

return Teleport
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme: colours, fonts and small UI building helpers (chunky outlined "simulator" style).
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Icons = require(script.Parent.Icons)

local Theme = {}

local rgb = Color3.fromRGB

Theme.Font = Enum.Font.FredokaOne
Theme.Title = Enum.Font.LuckiestGuy

Theme.Colors = {
	Green = rgb(80, 215, 50),
	Blue = rgb(30, 160, 255),
	Orange = rgb(255, 140, 30),
	Red = rgb(235, 55, 55),
	Purple = rgb(150, 70, 255),
	Yellow = rgb(255, 210, 40),
	Pink = rgb(255, 110, 190),
	Gray = rgb(120, 120, 130),
	Money = rgb(90, 255, 70),
	Speed = rgb(120, 60, 255),
	Panel = rgb(35, 35, 55),
	PanelLight = rgb(55, 55, 80),
	Outline = rgb(15, 15, 25),
	White = rgb(255, 255, 255),
}

Theme.IsTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Sound effects: quiet and soft by default. Every UI sound is made from sounds that ship with
-- Roblox (rbxasset://sounds/...), layered and softened with sound effects, so nothing has to be
-- uploaded. Paste Creator Store sounds into Config.Sounds to use your own instead.
--   Id / Volume (0-1) / Pitch (1 = normal, lower = deeper and softer); Id = "" turns it off
--   Notes  = { pitch, ... } plays it once per note, one after the other (a little jingle); a
--            note can be a list of pitches to play together (a chord)
--   Layers = more sounds played at the same time (a key's low "thock" under its click)
--   Vary   = random pitch wobble (0.04 = +-4%) so repeated clicks don't sound robotic
--   Group  = "Keys" (muffled, like a keyboard with soft switches) or "Chimes" (soft, with a bit of
--            room echo)
local PING = "rbxasset://sounds/electronicpingshort.wav"
local WHOOSH = "rbxasset://sounds/Rocket whoosh 01.wav"
local THUD = "rbxasset://sounds/action_jump_land.mp3"
local CLICK = "rbxasset://sounds/button.wav"
export type Layer = { Id: string, Volume: number, Pitch: number }
export type SoundDef = { Id: string, Volume: number, Pitch: number, Notes: { any }?, Gap: number?, Layers: { Layer }?, Vary: number?, Group: string? }
-- Musical steps above the first note (major scale), for the chimes
local THIRD, FIFTH, OCTAVE = 1.26, 1.498, 2
Theme.Sounds = {
	-- Buttons: a soft mechanical keyboard. Pressing = a muffled click over a low wooden "thock";
	-- letting go = the same, lighter and higher, like a key springing back up.
	KeyDown = { Id = CLICK, Volume = 0.09, Pitch = 0.72, Layers = { { Id = THUD, Volume = 0.3, Pitch = 2.5 } }, Vary = 0.05, Group = "Keys" },
	KeyUp = { Id = CLICK, Volume = 0.045, Pitch = 0.95, Layers = { { Id = THUD, Volume = 0.13, Pitch = 3.1 } }, Vary = 0.06, Group = "Keys" },
	-- A window popping up by itself: a deeper "space bar" thock
	Open = { Id = CLICK, Volume = 0.08, Pitch = 0.6, Layers = { { Id = THUD, Volume = 0.32, Pitch = 1.9 } }, Vary = 0.03, Group = "Keys" },
	-- Messages: soft chimes, each kind its own little tune
	Notify = { Id = PING, Volume = 0.1, Pitch = 0.8, Notes = { 1, 1.335 }, Gap = 0.08, Group = "Chimes" },
	Success = { Id = PING, Volume = 0.11, Pitch = 0.8, Notes = { 1, THIRD, FIFTH }, Gap = 0.07, Group = "Chimes" },
	Rare = { Id = PING, Volume = 0.09, Pitch = 0.8, Notes = { FIFTH, OCTAVE, OCTAVE * THIRD, OCTAVE * FIFTH }, Gap = 0.05, Group = "Chimes" },
	Error = { Id = PING, Volume = 0.1, Pitch = 0.5, Notes = { 1, 0.84 }, Gap = 0.1, Group = "Chimes" },
	Announce = { Id = PING, Volume = 0.11, Pitch = 0.72, Notes = { 1, THIRD, FIFTH, { 1, THIRD, OCTAVE } :: any }, Gap = 0.09, Group = "Chimes" },
	-- A server event starting: a rising fanfare ending on a chord, over a soft low boom
	Event = { Id = PING, Volume = 0.13, Pitch = 0.7, Notes = { 1, THIRD, FIFTH, OCTAVE, { FIFTH, OCTAVE, OCTAVE * THIRD } :: any }, Gap = 0.11, Layers = { { Id = THUD, Volume = 0.35, Pitch = 0.45 } }, Group = "Chimes" },
	-- Stealing: a quick "swipe", a rising "got it!" jingle, then the chase starts
	Grab = { Id = WHOOSH, Volume = 0.35, Pitch = 1.8 },
	Steal = { Id = PING, Volume = 0.2, Pitch = 1, Notes = { 1, 1.26, 1.5 }, Gap = 0.07 },
	Hatch = { Id = PING, Volume = 0.3, Pitch = 1.6 },
	Crack = { Id = THUD, Volume = 0.4, Pitch = 1.8 },
	-- Home safe: a bright "cha-ching" arpeggio
	Deposit = { Id = PING, Volume = 0.24, Pitch = 1, Notes = { 1, 1.26, 1.5, 2 }, Gap = 0.08 },
	Collect = { Id = PING, Volume = 0.2, Pitch = 1 },
	-- Caught: a big BONK and a whoosh as you go flying
	Caught = { Id = THUD, Volume = 0.8, Pitch = 0.55 },
	Fling = { Id = WHOOSH, Volume = 0.5, Pitch = 0.8 },
} :: { [string]: SoundDef }
Theme.Sounds.Click = Theme.Sounds.KeyDown

-- Sound groups: effects shared by every sound in them
type GroupEffects = { Equalizer: { HighGain: number, MidGain: number, LowGain: number }?, Reverb: { [string]: number }? }
local GROUPS: { [string]: GroupEffects } = {
	-- muffle the click's sharp top end (soft, "lubed" switches) and add a little body
	Keys = { Equalizer = { HighGain = -12, MidGain = -2, LowGain = 3 } },
	-- round off the ping into a bell, with a small room around it
	Chimes = { Equalizer = { HighGain = -8, MidGain = 0, LowGain = 1 }, Reverb = { DecayTime = 1.3, Density = 1, Diffusion = 1, DryLevel = 0, WetLevel = -13 } },
}
local soundFolder: Folder? = nil
local soundGroups: { [string]: SoundGroup } = {}
local function folder(): Folder
	if not soundFolder then
		local f = Instance.new("Folder")
		f.Name = "UISounds"
		f.Parent = SoundService
		for name, effects in GROUPS do
			local group = Instance.new("SoundGroup")
			group.Name = name
			group.Volume = 1
			local equalizer = effects.Equalizer
			if equalizer then
				local eq = Instance.new("EqualizerSoundEffect")
				eq.HighGain = equalizer.HighGain
				eq.MidGain = equalizer.MidGain
				eq.LowGain = equalizer.LowGain
				eq.Priority = 1
				eq.Parent = group
			end
			local reverb = effects.Reverb
			if reverb then
				local effect = Instance.new("ReverbSoundEffect")
				for key, value in reverb do
					(effect :: any)[key] = value
				end
				effect.Priority = 0
				effect.Parent = group
			end
			group.Parent = f
			soundGroups[name] = group
		end
		soundFolder = f
	end
	return soundFolder :: Folder
end

local random = Random.new()
local function playOnce(id: string, volume: number, pitch: number, group: string?)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.PlaybackSpeed = pitch
	local holder = folder()
	if group then
		sound.SoundGroup = soundGroups[group]
	end
	sound.Parent = holder
	sound:Play()
	task.delay(4, function()
		sound:Destroy()
	end)
end

-- Config.Sounds: pasted Creator Store sounds replace the built-in ones (until one fails to load)
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local custom: { [string]: string } = {}
for name, id in Config.Sounds :: { [string]: any } do
	if type(id) == "string" and id ~= "" then
		custom[name] = id
	end
end
if next(custom) then
	task.spawn(function()
		local list = {}
		for name, id in custom do
			local probe = Instance.new("Sound")
			probe.Name = name
			probe.SoundId = id
			table.insert(list, probe)
		end
		pcall(function()
			ContentProvider:PreloadAsync(list, function(contentId: string, status: Enum.AssetFetchStatus)
				if status == Enum.AssetFetchStatus.Failure then
					for name, id in custom do
						if id == contentId then
							custom[name] = nil
							warn(`[Sounds] Config.Sounds.{name} ({id}) couldn't load, so the built-in sound plays instead.`)
						end
					end
				end
			end)
		end)
	end)
end

local lastSound = 0
function Theme.PlaySound(name: string, _volume: number?)
	if name ~= "KeyDown" and name ~= "KeyUp" then
		lastSound = os.clock()
	end
	local own = custom[name]
	if own then
		playOnce(own, Config.Sounds.CustomVolume, 1, nil)
		return
	end
	local def = Theme.Sounds[name]
	if not def or def.Id == "" then
		return
	end
	local wobble = if def.Vary then 1 + random:NextNumber(-def.Vary, def.Vary) else 1
	if def.Layers then
		for _, layer in def.Layers do
			playOnce(layer.Id, layer.Volume, layer.Pitch * wobble, def.Group)
		end
	end
	local notes = def.Notes
	if notes then
		task.spawn(function()
			for i, note in notes do
				if type(note) == "table" then
					for _, pitch in note do
						playOnce(def.Id, def.Volume * 0.8, def.Pitch * pitch, def.Group)
					end
				else
					playOnce(def.Id, def.Volume, def.Pitch * note * wobble, def.Group)
				end
				if i < #notes then
					task.wait(def.Gap or 0.08)
				end
			end
		end)
	else
		playOnce(def.Id, def.Volume, def.Pitch * wobble, def.Group)
	end
end

-- Every button in `root` (now and later) clicks like a soft keyboard key: down when pressed, up
-- when let go. Give a button the attribute Silent = true to keep it quiet.
local lastKey = 0
local wired: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local function wireButton(button: GuiButton)
	if wired[button] then
		return -- (moved to another frame: already clicks)
	end
	wired[button] = true
	button.MouseButton1Down:Connect(function()
		if not button:GetAttribute("Silent") then
			lastKey = os.clock()
			Theme.PlaySound("KeyDown")
		end
	end)
	button.MouseButton1Up:Connect(function()
		if not button:GetAttribute("Silent") then
			Theme.PlaySound("KeyUp")
		end
	end)
end
function Theme.WireClickSounds(root: Instance)
	for _, child in root:GetDescendants() do
		if child:IsA("GuiButton") then
			wireButton(child)
		end
	end
	root.DescendantAdded:Connect(function(child: Instance)
		if child:IsA("GuiButton") then
			wireButton(child)
		end
	end)
end

-- Seconds since the last button press (a window opened by a click doesn't need its own sound).
function Theme.SinceKeyPress(): number
	return os.clock() - lastKey
end

-- Seconds since the last sound other than a key click (so chimes don't pile up on each other).
function Theme.SinceSound(): number
	return os.clock() - lastSound
end

-- Instance.new with a property table and optional children.
function Theme.new(className: string, props: { [string]: any }?, children: { any }?): any
	local instance = Instance.new(className :: any)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.Corner(radius: number?): any
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Theme.Stroke(thickness: number?, color: Color3?, mode: Enum.ApplyStrokeMode?): any
	return Theme.new("UIStroke", {
		Thickness = thickness or 3,
		Color = color or Theme.Colors.Outline,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
	})
end

function Theme.Gradient(top: Color3, bottom: Color3): any
	return Theme.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = 90 })
end

function Theme.Padding(px: number): any
	local u = UDim.new(0, px)
	return Theme.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

-- Outlined text label (thick black stroke like the reference UI).
function Theme.Label(props: { [string]: any }): TextLabel
	local label = Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Title,
		TextColor3 = Theme.Colors.White,
		TextScaled = true,
		Text = "",
	})
	for key, value in props do
		if key ~= "Parent" and key ~= "StrokeThickness" and key ~= "StrokeColor" then
			(label :: any)[key] = value
		end
	end
	Theme.new("UIStroke", {
		Thickness = props.StrokeThickness or 2.5,
		Color = props.StrokeColor or Theme.Colors.Outline,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = label,
	})
	label.Parent = props.Parent
	return label
end

local function lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

local function darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end
Theme.Lighten = lighten
Theme.Darken = darken

-- Pop animation on press.
function Theme.Bounce(button: GuiObject)
	local scale = button:FindFirstChild("BounceScale") :: UIScale?
	if not scale then
		scale = Theme.new("UIScale", { Name = "BounceScale", Parent = button })
	end
	local s = scale :: UIScale
	s.Scale = 0.9
	TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Big chunky button: coloured gradient, dark outline, outlined text, optional emoji icon.
function Theme.Button(props: {
	Text: string,
	Color: Color3,
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Icon: string?,
	Parent: Instance?,
	LayoutOrder: number?,
	Name: string?,
	TextSize: number?,
}): TextButton
	local button = Theme.new("TextButton", {
		Name = props.Name or "Button",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
	}, {
		Theme.Corner(9),
		Theme.Stroke(3.5),
		Theme.Gradient(lighten(props.Color, 0.3), darken(props.Color, 0.12)),
	})
	button:SetAttribute("BaseColor", props.Color)
	local textX = 0
	if props.Icon then
		local drawn = Icons.For(props.Icon)
		if drawn then
			-- a chunky white outlined icon (UI/Icons) instead of the emoji
			Icons.Draw(drawn, button, props.Color, {
				Size = UDim2.fromScale(0.74, 0.74),
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 8, 0.5, 0),
			})
		else
			Theme.Label({
				Name = "Icon",
				Text = props.Icon,
				Font = Enum.Font.GothamBold,
				Size = UDim2.fromScale(0.8, 0.8), -- square: both relative to the button height
				SizeConstraint = Enum.SizeConstraint.RelativeYY,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 6, 0.5, 0),
				Parent = button,
			})
		end
		textX = 0.3
	end
	Theme.Label({
		Name = "Text",
		Text = props.Text,
		Size = UDim2.new(1 - textX, -10, 0.7, 0),
		Position = UDim2.new(textX, if props.Icon then 0 else 5, 0.15, 0),
		Parent = button,
	})
	button.MouseButton1Down:Connect(function()
		Theme.Bounce(button) -- (the click sound comes from Theme.WireClickSounds)
	end)
	button.Parent = props.Parent
	return button
end

-- Recolour a Theme.Button (e.g. grey when you can't afford something).
function Theme.SetButtonColor(button: TextButton, color: Color3)
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = ColorSequence.new(lighten(color, 0.25), darken(color, 0.1))
	end
end

function Theme.SetButtonText(button: TextButton, text: string)
	local label = button:FindFirstChild("Text") :: TextLabel?
	if label then
		label.Text = text
	end
end

-- Keeps a UIScale in sync with the screen size (UI is designed for 1280x720, then drawn at
-- Theme.UIScale of that so it stays out of the way of the game).
Theme.UIScale = 0.82
local scales: { UIScale } = {}
local function currentScale(): number
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	return math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1.2) * Theme.UIScale
end

function Theme.CurrentScale(): number
	return currentScale()
end

function Theme.AutoScale(target: GuiObject): UIScale
	local scale = Theme.new("UIScale", { Name = "AutoScale", Scale = currentScale(), Parent = target })
	table.insert(scales, scale)
	return scale
end

local function hookCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			local value = currentScale()
			for _, scale in scales do
				scale.Scale = value
			end
		end)
	end
end
hookCamera()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)

function Theme.PlayerGui(): PlayerGui
	return (Players.LocalPlayer :: Player):WaitForChild("PlayerGui") :: PlayerGui
end

function Theme.ScreenGui(name: string, displayOrder: number?): ScreenGui
	return Theme.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		IgnoreGuiInset = false,
		Parent = Theme.PlayerGui(),
	})
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">Trails</string>
              <string name="Source"><![CDATA[--[[
	Trails window (the 💨 Trails button on the HUD): every trail, what it looks like, and how to get
	it. Locked trails show how much Speed they still need; unlocked ones can be put on and taken
	off. The effects themselves are drawn by client/TrailFX. The server checks every press.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Format = require(Shared.Format)
local TrailList = require(Shared.Trails)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Trails = {}

type Card = { Button: TextButton, Status: TextLabel, Fill: Frame, Bar: Frame }

local modal: Modal.Modal
local cards: { [string]: Card } = {}

local function unlocked(trail: TrailList.Trail): boolean
	return TrailList.IsUnlocked(trail, State.Data.OwnedTrails, State.Number("BestSpeed"))
end

function Trails.Open()
	modal:Open()
end

-- True when a trail is unlocked but you wear none (the HUD shows a "!" on the button).
function Trails.IsReady(): boolean
	if State.Get("Trail") ~= nil then
		return false
	end
	for _, trail in TrailList.List do
		if unlocked(trail) then
			return true
		end
	end
	return false
end

-- A little picture of the trail: a runner with fading see-through copies behind them and a glass
-- pane cracking (made of plain UI, so it costs nothing).
local function preview(parent: Instance, trail: TrailList.Trail)
	local box = Theme.new("Frame", { Size = UDim2.fromOffset(150, 150), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = Color3.fromRGB(22, 30, 52), Parent = parent }, {
		Theme.Corner(12),
		Theme.Stroke(2.5, trail.Accent),
		Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(70, 110, 170), Color3.fromRGB(20, 26, 46)) }),
	})
	-- glass pane with cracks, behind the runner
	local pane = Theme.new("Frame", { Size = UDim2.fromOffset(52, 78), Position = UDim2.fromOffset(12, 30), Rotation = -8, BackgroundColor3 = trail.Color, BackgroundTransparency = 0.7, Parent = box }, {
		Theme.new("UIStroke", { Color = trail.Accent, Thickness = 2, Transparency = 0.1 }),
	})
	for i, crack in { { 0.5, 0.45, 40, 0.8 }, { 0.35, 0.6, -35, 0.6 }, { 0.62, 0.3, 70, 0.5 } } do
		Theme.new("Frame", { Name = "Crack" .. i, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(crack[1], crack[2]), Size = UDim2.new(crack[4], 0, 0, 2), Rotation = crack[3], BackgroundColor3 = trail.Accent, BorderSizePixel = 0, Parent = pane })
	end
	-- shards flying off it
	for i, shard in { { 4, 22, 25 }, { 70, 18, -30 }, { 8, 112, 50 }, { 66, 116, -60 }, { 40, 12, 15 } } do
		Theme.new("Frame", { Name = "Shard" .. i, Size = UDim2.fromOffset(9, 5), Position = UDim2.fromOffset(shard[1], shard[2]), Rotation = shard[3], BackgroundColor3 = trail.Color, BackgroundTransparency = 0.35, Parent = box }, {
			Theme.new("UIStroke", { Color = trail.Accent, Thickness = 1 }),
		})
	end
	-- the afterimages, oldest (faintest) first, and the runner in front
	for i = 1, 4 do
		local runner = Theme.Label({ Text = "🏃", Size = UDim2.fromOffset(70, 70), Position = UDim2.fromOffset(18 + i * 13, 44), StrokeThickness = 0, Parent = box })
		runner.TextTransparency = if i == 4 then 0 else 0.85 - i * 0.15
		runner.TextColor3 = trail.Color
		runner.ZIndex = 2 + i
	end
	Theme.Label({ Text = trail.Icon, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(1, -38, 0, 4), StrokeThickness = 0, ZIndex = 8, Parent = box })
end

local function buildCard(list: Instance, trail: TrailList.Trail)
	local card = Theme.new("Frame", { Name = trail.Id, Size = UDim2.new(1, -12, 0, 170), BackgroundColor3 = Theme.Colors.PanelLight, LayoutOrder = trail.Order, Parent = list }, {
		Theme.Corner(14),
		Theme.Stroke(3, trail.Color),
	})
	preview(card, trail)
	Theme.Label({ Text = `{trail.Icon} {string.upper(trail.Name)} TRAIL`, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = trail.Color, Size = UDim2.new(1, -184, 0, 34), Position = UDim2.fromOffset(174, 10), Parent = card })
	Theme.Label({ Text = trail.Description, Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, -184, 0, 44), Position = UDim2.fromOffset(174, 46), StrokeThickness = 1.2, Parent = card })
	local status = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -184, 0, 22), Position = UDim2.fromOffset(174, 92), StrokeThickness = 1.2, Parent = card })
	local bar = Theme.new("Frame", { Size = UDim2.new(1, -330, 0, 22), Position = UDim2.fromOffset(174, 128), BackgroundColor3 = Theme.Colors.Outline, Parent = card }, { Theme.Corner(8), Theme.Stroke(2) })
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Colors.Speed, Parent = bar }, { Theme.Corner(8) })
	local button = Theme.Button({ Text = "WEAR", Color = Theme.Colors.Green, Size = UDim2.fromOffset(140, 46), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -10), Parent = card })
	button.Activated:Connect(function()
		if not unlocked(trail) then
			if trail.Cost then
				State.Action("BuyTrail", trail.Id)
			end
			return
		end
		State.Action("EquipTrail", if State.Get("Trail") == trail.Id then "" else trail.Id)
	end)
	cards[trail.Id] = { Button = button, Status = status, Fill = fill, Bar = bar }
end

local function refresh()
	local best = State.Number("BestSpeed")
	local wearing = State.Get("Trail")
	for _, trail in TrailList.List do
		local card = cards[trail.Id]
		if card then
			local need = TrailList.RequiredSpeed(trail)
			local open = unlocked(trail)
			card.Bar.Visible = not open and need ~= nil
			if open then
				local on = wearing == trail.Id
				card.Status.Text = if on then `<font color="#8dff6a">✓ You're wearing it</font>` else "✓ Unlocked"
				Theme.SetButtonText(card.Button, if on then "TAKE OFF" else "WEAR")
				Theme.SetButtonColor(card.Button, if on then Theme.Colors.Orange else Theme.Colors.Green)
			elseif trail.Cost then
				card.Status.Text = `Costs <font color="#8dff6a"><b>{Format.Money(trail.Cost)}</b></font>`
				Theme.SetButtonText(card.Button, "BUY " .. Format.Money(trail.Cost))
				Theme.SetButtonColor(card.Button, Theme.Colors.Green)
			elseif need then
				local area = trail.UnlockBiome and Areas.List[trail.UnlockBiome]
				card.Status.Text = `🔒 Reach <font color="#c9a0ff"><b>⚡{Format.Number(need)}</b></font> Speed{if area then ` (biome {area.Id}: {area.Name})` else ""}`
				card.Fill.Size = UDim2.fromScale(math.clamp(best / need, 0, 1), 1)
				Theme.SetButtonText(card.Button, "LOCKED")
				Theme.SetButtonColor(card.Button, Theme.Colors.Gray)
			else
				card.Status.Text = "🔒 Coming soon"
				Theme.SetButtonText(card.Button, "LOCKED")
				Theme.SetButtonColor(card.Button, Theme.Colors.Gray)
			end
		end
	end
end

function Trails.Init()
	modal = Modal.new("💨 TRAILS", Theme.Colors.Blue, Vector2.new(640, 420))
	Theme.Label({
		Text = "Trails show behind you while you run fast. Everyone near you can see them!",
		Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 24), StrokeThickness = 1.4, Parent = modal.Body,
	})
	local list = Theme.new("ScrollingFrame", {
		Name = "List", Size = UDim2.new(1, 0, 1, -34), Position = UDim2.fromOffset(0, 34), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 8, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = modal.Body,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4) }),
	})
	for _, trail in TrailList.List do
		buildCard(list, trail)
	end
	State.Changed:Connect(refresh)
	State.OnAttribute("Trail", refresh)
	State.OnAttribute("BestSpeed", function()
		if modal:IsOpen() then
			refresh()
		end
	end)
	modal.OnOpen = refresh
	refresh()
end

return Trails
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--[[
	Tutorial: a guided first game. A small line of text at the top of the screen says what to do
	next, with a Skip Tutorial button beside it, and a red arrow floating over your head points the
	way (a second red arrow bobs over the target):
	  1. follow the arrow to the first biome
	  2. steal a donut box (walk up to one next to Domer and press E)
	  3. run back to the lobby before Domer catches you (caught? steal another one)
	  4. go into your pen, hold the box and click to put it down
	  5. wait for its timer, then click it to open it (the donut lands in your inventory)
	  6. hold the donut and click in your pen: it walks around and makes money
	  7. run on your treadmill to get faster
	Then a Claim button gives you a free egg (once ever; the server checks).
	It starts on your first join and keeps coming back until you finish or skip it; Settings >
	How to play starts it again.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Remotes = require(Shared.Remotes)
local Theme = require(script.Parent.Theme)
local UpdateNotes = require(script.Parent.UpdateNotes)
local State = require(script.Parent.Parent.State)
local AreaTracker = require(script.Parent.Parent.AreaTracker)
local Bases = require(script.Parent.Parent.Bases)

local Tutorial = {}

local player = Players.LocalPlayer :: Player
local RED = Color3.fromRGB(235, 40, 40)
local STEPS = { "Lane", "Steal", "RunHome", "PlaceBox", "Wait", "PlaceDonut", "Treadmill" }
local TEXT: { [string]: string } = {
	Lane = "Follow the red arrow to the first biome",
	Steal = `Walk up to a donut box next to {Config.Guard.Name} and press E to steal it`,
	RunHome = `Run back to the lobby before {Config.Guard.Name} catches you!`,
	Caught = `{Config.Guard.Name} caught you! Steal another box and try again`,
	PlaceBox = "Go into your pen, hold the box and click to put it down",
	Wait = "Wait for the timer over your box, then click the box to open it!",
	PlaceDonut = "Your donut is in your inventory! Hold it and click in your pen",
	Treadmill = "Your donut makes money! Now run on your treadmill to get faster",
	Done = "Tutorial complete! Claim your free egg",
	Claimed = "Tutorial complete!",
}

local step: string? = nil -- nil while the tutorial isn't running
local caught = false
local boxesAtStart = 0
local donutsAtStart = 0
local speedAtStart = 0
local refresh: () -> ()

local function number(name: string): number
	local value = player:GetAttribute(name)
	return if type(value) == "number" then value else 0
end

local function go(nextStep: string?)
	step = nextStep
	if nextStep == "PlaceBox" then
		boxesAtStart = number("BoxesPlaced")
	elseif nextStep == "PlaceDonut" then
		donutsAtStart = number("DonutsPlaced")
	elseif nextStep == "Treadmill" then
		speedAtStart = number("Speed")
	end
	refresh()
end

function Tutorial.Start()
	caught = false
	go("Lane")
end
Tutorial.Open = Tutorial.Start -- Settings > How to play

function Tutorial.IsRunning(): boolean
	return step ~= nil
end

--------------------------------------------------------------------------------
-- The red arrows: one over your head pointing the way, one bobbing over the target
--------------------------------------------------------------------------------
type Arrow = { Parts: { BasePart }, Offsets: { CFrame } }

local function newArrow(parent: Instance, scale: number): Arrow
	local arrow: Arrow = { Parts = {}, Offsets = {} }
	local function piece(size: Vector3, offset: CFrame)
		local part = Instance.new("Part")
		part.Name = "TutorialArrow"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = RED
		part.Size = size * scale
		part.Parent = parent
		table.insert(arrow.Parts, part)
		table.insert(arrow.Offsets, CFrame.new(offset.Position * scale) * offset.Rotation)
	end
	-- points along -Z: a shaft and a chevron at the tip
	piece(Vector3.new(0.7, 0.7, 5), CFrame.new(0, 0, 0.5))
	for _, side in { -1, 1 } do
		piece(Vector3.new(0.7, 0.7, 2.8), CFrame.new(side * 0.9, 0, -2.13) * CFrame.Angles(0, side * math.rad(40), 0))
	end
	return arrow
end

local function place(arrow: Arrow, cf: CFrame?)
	for i, part in arrow.Parts do
		if cf then
			part.CFrame = cf * arrow.Offsets[i]
			part.Transparency = 0
		else
			part.Transparency = 1
		end
	end
end

-- Where the arrows should point for the current step.
local nearestBox: Vector3? = nil
local lastScan = 0
local function laneStart(): Vector3
	return Vector3.new(0, 0, Layout.AreaStart(1) + 15)
end

-- The nearest box you can steal in the biome you're in.
local function findBox(from: Vector3): Vector3?
	local area = AreaTracker.Current
	local map = workspace:FindFirstChild("Map")
	local lane = map and map:FindFirstChild("Lane")
	local folder = lane and lane:FindFirstChild("Area" .. area)
	if area <= 0 or not folder then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for _, prompt in folder:GetDescendants() do
		if prompt:IsA("ProximityPrompt") and prompt.Name == "StealPrompt" and prompt.Enabled then
			local holder = prompt.Parent
			if holder and holder:IsA("BasePart") then
				local distance = (holder.Position - from).Magnitude
				if distance < bestDistance then
					best, bestDistance = holder.Position, distance
				end
			end
		end
	end
	return best
end

local function target(from: Vector3): Vector3?
	local plot = Bases.Mine()
	if step == "Lane" then
		return laneStart()
	elseif step == "Steal" then
		local now = os.clock()
		if now - lastScan > 0.75 then
			lastScan = now
			nearestBox = findBox(from)
		end
		return nearestBox or laneStart()
	elseif step == "RunHome" then
		return Vector3.new(from.X, 0, Config.Map.SafeZoneZ - 30)
	elseif (step == "PlaceBox" or step == "PlaceDonut") and plot then
		return plot:GetPivot().Position
	elseif step == "Wait" and plot then
		for _, child in plot:GetChildren() do
			if child:IsA("Model") and string.sub(child.Name, 1, 6) == "PenBox" then
				return child:GetPivot().Position
			end
		end
		return plot:GetPivot().Position
	elseif step == "Treadmill" and plot then
		local treadmill = plot:FindFirstChild("Treadmill")
		local belt = treadmill and treadmill:FindFirstChild("Belt")
		return if belt and belt:IsA("BasePart") then belt.Position else plot:GetPivot().Position
	end
	return nil
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------
function Tutorial.Init()
	-- The line of text at the top, with Skip / Claim beside it
	local gui = Theme.ScreenGui("Tutorial", 6)
	local strip = Theme.new("Frame", {
		Name = "Strip",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 48),
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0.45,
		Visible = false,
		Parent = gui,
	}, {
		Theme.Corner(10),
		Theme.Stroke(2),
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 6) }),
	})
	Theme.AutoScale(strip)
	local counter = Theme.Label({ Name = "Counter", Text = "", Font = Theme.Font, TextScaled = false, TextSize = 16, TextColor3 = Color3.fromRGB(255, 120, 120), AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), StrokeThickness = 1.5, LayoutOrder = 1, Parent = strip })
	local label = Theme.Label({ Name = "Text", Text = "", Font = Theme.Font, TextScaled = false, TextSize = 18, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), StrokeThickness = 1.5, LayoutOrder = 2, Parent = strip })
	local skip = Theme.Button({ Text = "Skip Tutorial", Color = Theme.Colors.Gray, Size = UDim2.fromOffset(130, 30), Parent = strip })
	skip.Name = "Skip"
	skip.LayoutOrder = 3
	local claim = Theme.Button({ Text = "Claim", Color = Theme.Colors.Green, Size = UDim2.fromOffset(110, 30), Parent = strip })
	claim.Name = "Claim"
	claim.LayoutOrder = 4
	local close = Theme.Button({ Text = "Close", Color = Theme.Colors.Gray, Size = UDim2.fromOffset(90, 30), Parent = strip })
	close.Name = "Close"
	close.LayoutOrder = 5

	local arrows = Instance.new("Folder")
	arrows.Name = "TutorialArrows"
	arrows.Parent = workspace
	local guide = newArrow(arrows, 1)
	local marker = newArrow(arrows, 1.4)
	place(guide, nil)
	place(marker, nil)

	refresh = function()
		strip.Visible = step ~= nil
		if not step then
			return
		end
		local index = table.find(STEPS, step)
		counter.Text = if index then `{index}/{#STEPS}` else ""
		counter.Visible = index ~= nil
		local claimed = State.Data.TutorialEggClaimed == true
		if step == "Done" then
			label.Text = if claimed then TEXT.Claimed else TEXT.Done
		else
			label.Text = if step == "Steal" and caught then TEXT.Caught else TEXT[step]
		end
		skip.Visible = step ~= "Done"
		claim.Visible = step == "Done" and not claimed
		close.Visible = step == "Done" and claimed
	end

	skip.Activated:Connect(function()
		State.Action("SeenTutorial")
		go(nil)
	end)
	claim.Activated:Connect(function()
		State.Action("ClaimTutorialEgg")
		label.Text = TEXT.Claimed
		claim.Visible = false
		task.delay(2.5, function()
			if step == "Done" then
				go(nil)
			end
		end)
	end)
	close.Activated:Connect(function()
		State.Action("SeenTutorial")
		go(nil)
	end)

	-- Stealing a box, getting caught and bringing it back
	Remotes.Event("ChaseEnded").OnClientEvent:Connect(function(info: any)
		if type(info) ~= "table" or info.Kind ~= "Box" then
			return
		end
		if step == "RunHome" or step == "Steal" then
			if info.Result == "Deposited" then
				go("PlaceBox")
			elseif info.Result == "Caught" or info.Result == "Lost" then
				caught = true
				go("Steal")
			end
		end
	end)
	-- Your box opened
	Remotes.Event("BoxOpened").OnClientEvent:Connect(function(info: any)
		if type(info) == "table" and info.Owner == player and (step == "Wait" or step == "PlaceBox") then
			go("PlaceDonut")
		end
	end)

	RunService.RenderStepped:Connect(function()
		if not step then
			place(guide, nil)
			place(marker, nil)
			return
		end
		-- move on when the step is done
		if step == "Lane" and AreaTracker.Current > 0 then
			go("Steal")
		elseif step == "Steal" and player:GetAttribute("CarryKind") == "Box" then
			caught = false
			go("RunHome")
		elseif step == "PlaceBox" and number("BoxesPlaced") > boxesAtStart then
			go("Wait")
		elseif step == "PlaceDonut" and number("DonutsPlaced") > donutsAtStart then
			go("Treadmill")
		elseif step == "Treadmill" and number("Speed") >= speedAtStart + 3 then
			go("Done")
		end
		-- point the way
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local goal = if root and step ~= "Done" then target(root.Position) else nil
		if not root or not goal then
			place(guide, nil)
			place(marker, nil)
			return
		end
		local t = os.clock()
		local bob = math.sin(t * 3) * 0.4
		local here = root.Position + Vector3.new(0, 6.5 + bob, 0)
		local flat = Vector3.new(goal.X - here.X, 0, goal.Z - here.Z)
		if flat.Magnitude > 4 then
			local ahead = flat.Unit
			local right = Vector3.yAxis:Cross(-ahead)
			place(guide, CFrame.fromMatrix(here, right, Vector3.yAxis, -ahead))
		else
			place(guide, nil)
		end
		-- pointing straight down over the target, turning slowly
		local over = goal + Vector3.new(0, 10 + math.sin(t * 2.5) * 1.2, 0)
		place(marker, CFrame.fromMatrix(over, Vector3.xAxis, Vector3.new(0, 0, -1), Vector3.yAxis) * CFrame.Angles(0, 0, t * 1.5))
	end)

	-- First join: start it (it keeps coming back until finished or skipped)
	local checked = false
	State.Changed:Connect(function(snapshot)
		if not checked then
			checked = true
			if snapshot.SeenTutorial == false then
				-- after the Update Log that opens on joining has been closed
				UpdateNotes.AfterJoinLog(function()
					if not Tutorial.IsRunning() then
						Tutorial.Start()
					end
				end)
			end
		elseif step == "Done" then
			refresh() -- the claim went through
		end
	end)
	refresh()
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">UpdateDecor</string>
              <string name="Source"><![CDATA[--[[
	UpdateDecor: the decorations that theme the Update Log to each update (UI/UpdateNotes).

	  * Emblem  - the corner badge: a real 3D donut in the update's frosting and sprinkles, rocking
	              gently on a medallion, inside a slowly turning wheel of sprinkle "handles"
	  * Motes   - things floating around the notes, one style per update (UpdateNotes Decor):
	              Rise (golden diamonds + sparkles drifting up), Embers (sparks rising from a lava
	              glow), Stars (twinkling stars and the odd shooting star), Sparkles (soft bubbles)
	  * Swirl   - faint curly arcs in the corners (they turn slowly for Stars)
	  * Glow    - a soft band of colour along the bottom of the notes
	  * Divider - a thin line with a little gem in the middle, between sections

	Everything is drawn with plain frames, strokes and gradients (no images to upload). Each builder
	returns a step function: UpdateNotes calls them every frame while the window is open.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Notes = require(Shared.UpdateNotes)
local DonutModel = require(Shared.DonutModel)
local Theme = require(script.Parent.Theme)

local UpdateDecor = {}

export type Step = (t: number, dt: number) -> ()

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)
local DOUGH = rgb(222, 165, 95)
local TAU = math.pi * 2

local function circle(props: { [string]: any }): Frame
	local frame = Theme.new("Frame", props)
	Theme.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = frame })
	return frame
end

-- A ring drawn as a stroke, faded out along part of its length so it reads as an arc.
-- `cut` = how much of the ring is hidden (0..1), `rotation` turns the visible part.
local function arc(parent: Instance, center: UDim2, diameter: number, thickness: number, color: Color3, transparency: number, cut: number, rotation: number, z: number): Frame
	local ring = circle({
		Name = "Arc",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = center,
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	local stroke = Theme.new("UIStroke", { Thickness = thickness, Color = color, Transparency = 0, Parent = ring })
	local a = math.clamp(1 - cut, 0.05, 0.95)
	Theme.new("UIGradient", {
		Rotation = rotation,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, transparency),
			NumberSequenceKeypoint.new(a * 0.5, transparency),
			NumberSequenceKeypoint.new(math.min(a * 0.5 + 0.12, 0.99), 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = stroke,
	})
	return ring
end

---------------------------------------------------------------------------------------------------
-- Emblem
---------------------------------------------------------------------------------------------------
local HANDLES = 10

-- The donut the emblem shows (a plain donut: no face, sprinkles all round).
local function emblemDonut(update: Notes.Update): any
	local emblem = update.Emblem
	return {
		Id = "update" .. update.Version,
		Name = update.Name,
		Rarity = "Common",
		Area = 1,
		Income = 0,
		Weight = 0,
		Dough = if emblem and emblem.Dough then emblem.Dough else DOUGH,
		Frosting = if emblem then emblem.Frosting else update.Accent,
		Sprinkles = if emblem then emblem.Sprinkles else { WHITE, update.Accent },
		Parts = {},
		Score = 0,
		Index = 0,
	}
end

-- Builds the badge (size x size) into `parent`; returns its frame and a step function.
function UpdateDecor.Emblem(parent: Instance, update: Notes.Update, size: number, z: number): (Frame, Step)
	local color, accent = update.Color, update.Accent
	local holder = Theme.new("Frame", {
		Name = "Emblem",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		ZIndex = z,
		Parent = parent,
	})
	local mid = UDim2.fromScale(0.5, 0.5)
	-- Soft glow behind everything
	local glow = circle({
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = mid,
		Size = UDim2.fromScale(1.25, 1.25),
		BackgroundColor3 = accent,
		BackgroundTransparency = 0.8,
		ZIndex = z,
		Parent = holder,
	})
	-- The wheel: a rim and sprinkle-shaped handles all the way round (they turn slowly)
	local rim = circle({
		Name = "Rim",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = mid,
		Size = UDim2.fromScale(0.86, 0.86),
		BackgroundTransparency = 1,
		ZIndex = z + 1,
		Parent = holder,
	})
	Theme.new("UIStroke", { Thickness = size * 0.06, Color = WHITE, Parent = rim }, {
		Theme.new("UIGradient", { Rotation = 45, Color = ColorSequence.new(Theme.Lighten(accent, 0.35), Theme.Darken(accent, 0.3)) }),
	})
	local handles: { Frame } = {}
	local sprinkles = if update.Emblem then update.Emblem.Sprinkles else { accent }
	for i = 1, HANDLES do
		local tint = if i % 2 == 0 then accent else sprinkles[(i // 2) % #sprinkles + 1]
		local handle = Theme.new("Frame", {
			Name = "Handle",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(size * 0.1, size * 0.24),
			BackgroundColor3 = WHITE,
			ZIndex = z + 1,
			Parent = holder,
		}, {
			Theme.new("UICorner", { CornerRadius = UDim.new(1, 0) }),
			Theme.Stroke(2.5),
			Theme.new("UIGradient", { Rotation = 0, Color = ColorSequence.new(Theme.Lighten(tint, 0.45), Theme.Darken(tint, 0.15)) }),
		})
		table.insert(handles, handle)
	end
	-- The medallion the donut sits on
	local medallion = circle({
		Name = "Medallion",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = mid,
		Size = UDim2.fromScale(0.74, 0.74),
		BackgroundColor3 = WHITE,
		ZIndex = z + 2,
		Parent = holder,
	})
	Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Lighten(color, 0.3), Theme.Darken(color, 0.55)), Parent = medallion })
	Theme.Stroke(4).Parent = medallion
	local inner = arc(holder, mid, size * 0.64, 2, Theme.Lighten(accent, 0.4), 0.2, 0.25, 0, z + 3)
	-- The donut itself
	local viewport = Theme.new("ViewportFrame", {
		Name = "Donut",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = mid,
		Size = UDim2.fromScale(0.9, 0.9),
		BackgroundTransparency = 1,
		Ambient = rgb(175, 165, 185),
		LightColor = WHITE,
		LightDirection = Vector3.new(-0.5, -1, 0.6),
		ZIndex = z + 4,
		Parent = holder,
	})
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local distance = 15
	local ok, model = pcall(DonutModel.Build, emblemDonut(update), { NoEffects = true, NoFace = true })
	if ok and model then
		local box = model:GetBoundingBox()
		model:PivotTo(model:GetPivot() - box.Position)
		model.Parent = viewport
		local _, extents = model:GetBoundingBox()
		distance = math.max(extents.X, extents.Y) * 2.1
	end
	camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, -distance), Vector3.zero)

	local radius = size * 0.43
	local function step(t: number, _dt: number)
		local spin = t * 0.25
		for i, handle in handles do
			local angle = spin + (i - 1) / HANDLES * TAU
			handle.Position = UDim2.new(0.5, math.cos(angle) * radius, 0.5, math.sin(angle) * radius)
			handle.Rotation = math.deg(angle) + 90
		end
		glow.BackgroundTransparency = 0.78 + math.sin(t * 2) * 0.06
		inner.Rotation = -t * 20
		-- the donut rocks and bobs (a full spin would show its thin edge)
		local yaw = math.sin(t * 0.9) * 0.45
		local pitch = 0.18 + math.sin(t * 0.6) * 0.08
		camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(yaw) * distance, math.sin(pitch) * distance, -math.cos(yaw) * distance), Vector3.new(0, math.sin(t * 1.6) * 0.15, 0))
	end
	step(0, 0)
	return holder, step
end

---------------------------------------------------------------------------------------------------
-- Ornaments
---------------------------------------------------------------------------------------------------

-- Curly corner ornament: three arcs that wind inwards like a swirl.
function UpdateDecor.Swirl(parent: Instance, center: UDim2, size: number, color: Color3, transparency: number, z: number): Step
	local rings = {
		arc(parent, center, size, 3, color, transparency, 0.3, 30, z),
		arc(parent, center, size * 0.7, 2.5, color, transparency + 0.08, 0.4, 150, z),
		arc(parent, center, size * 0.42, 2, color, transparency + 0.15, 0.5, 260, z),
	}
	local dot = circle({ AnchorPoint = Vector2.new(0.5, 0.5), Position = center, Size = UDim2.fromOffset(size * 0.1, size * 0.1), BackgroundColor3 = color, BackgroundTransparency = transparency, ZIndex = z, Parent = parent })
	return function(t: number, _dt: number)
		for i, ring in rings do
			ring.Rotation = t * (6 + i * 4) * (if i % 2 == 0 then -1 else 1)
		end
		dot.BackgroundTransparency = transparency + math.sin(t * 1.5) * 0.08
	end
end

-- A soft band of colour fading up from the bottom of `parent`.
function UpdateDecor.Glow(parent: Instance, color: Color3, height: number, strength: number, z: number): Step
	local band = Theme.new("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = parent,
	})
	local gradient = Theme.new("UIGradient", { Rotation = 90, Parent = band })
	return function(t: number, _dt: number)
		local s = strength * (0.85 + math.sin(t * 1.3) * 0.15)
		gradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 1 - s) })
	end
end

-- A slowly turning sunburst of soft rays (behind the update's title).
function UpdateDecor.Rays(parent: Instance, center: UDim2, length: number, count: number, color: Color3, transparency: number, z: number): Step
	local rays: { Frame } = {}
	for i = 1, count do
		local ray = Theme.new("Frame", {
			Name = "Ray",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = center,
			Size = UDim2.fromOffset(length * 2, if i % 2 == 0 then 10 else 16),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = z,
			Parent = parent,
		}, {
			Theme.new("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.3, transparency),
					NumberSequenceKeypoint.new(0.5, 1),
					NumberSequenceKeypoint.new(0.7, transparency),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}),
		})
		table.insert(rays, ray)
	end
	return function(t: number, _dt: number)
		for i, ray in rays do
			ray.Rotation = (i - 1) * 180 / count + t * 4
		end
	end
end

-- Thin line with a gem in the middle (between sections).
function UpdateDecor.Divider(color: Color3, width: number): Frame
	local holder = Theme.new("Frame", { Name = "Divider", BackgroundTransparency = 1, Size = UDim2.new(0, width, 0, 14) })
	local line = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = holder,
	})
	Theme.new("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Parent = line,
	})
	for i, scale in { 1, 0.55 } do
		Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(12 * scale, 12 * scale),
			Rotation = 45,
			BackgroundColor3 = if i == 1 then color else WHITE,
			BorderSizePixel = 0,
			ZIndex = i + 1,
			Parent = holder,
		}, if i == 1 then { Theme.Stroke(2) } else nil)
	end
	return holder
end

---------------------------------------------------------------------------------------------------
-- Motes: things floating around the notes
---------------------------------------------------------------------------------------------------
type Style = {
	Count: number,
	Shapes: { string }, -- "Dot", "Diamond", "Spark"
	Colors: { Color3 },
	Size: NumberRange, -- pixels
	Motion: string, -- "Rise", "Twinkle", "Drift"
	Speed: NumberRange, -- fraction of the height per second
	Glow: Color3?, -- bottom glow colour
	Shooting: boolean?, -- the odd shooting star
	Spin: boolean?, -- the corner swirls turn
}

local STYLES: { [string]: Style } = {
	Rise = {
		Count = 18, Shapes = { "Diamond", "Diamond", "Spark" },
		Colors = { rgb(255, 225, 90), rgb(255, 245, 180), rgb(150, 255, 160) },
		Size = NumberRange.new(6, 13), Motion = "Rise", Speed = NumberRange.new(0.05, 0.11),
		Glow = rgb(255, 215, 80),
	},
	Embers = {
		Count = 28, Shapes = { "Dot", "Dot", "Dot", "Spark" },
		Colors = { rgb(255, 220, 90), rgb(255, 140, 30), rgb(255, 90, 10) },
		Size = NumberRange.new(4, 10), Motion = "Rise", Speed = NumberRange.new(0.08, 0.18),
		Glow = rgb(255, 90, 10),
	},
	Stars = {
		Count = 32, Shapes = { "Dot", "Dot", "Spark" },
		Colors = { rgb(255, 255, 255), rgb(210, 190, 255), rgb(255, 215, 150) },
		Size = NumberRange.new(3, 10), Motion = "Twinkle", Speed = NumberRange.new(1, 2.6),
		Glow = rgb(140, 80, 255), Shooting = true, Spin = true,
	},
	Sparkles = {
		Count = 18, Shapes = { "Bubble", "Bubble", "Spark" },
		Colors = { rgb(255, 170, 220), rgb(255, 230, 150), rgb(255, 255, 255) },
		Size = NumberRange.new(8, 20), Motion = "Drift", Speed = NumberRange.new(0.03, 0.07),
		Glow = rgb(255, 120, 200),
	},
}

function UpdateDecor.Style(update: Notes.Update): Style
	return STYLES[update.Decor or ""] or STYLES.Sparkles
end

local function shape(kind: string, size: number, color: Color3, z: number): Frame
	local holder = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		ZIndex = z,
	})
	if kind == "Diamond" then
		holder.BackgroundTransparency = 0
		holder.BackgroundColor3 = color
		holder.Rotation = 45
		holder.BorderSizePixel = 0
	elseif kind == "Spark" then
		-- four-pointed twinkle: two thin crossed bars
		for _, rotation in { 0, 90 } do
			Theme.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.new(1.6, 0, 0, math.max(2, size * 0.22)),
				Rotation = rotation,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = z,
				Parent = holder,
			}, {
				Theme.new("UICorner", { CornerRadius = UDim.new(1, 0) }),
				Theme.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }),
			})
		end
	elseif kind == "Bubble" then
		Theme.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = holder })
		holder.BackgroundTransparency = 0.75
		holder.BackgroundColor3 = color
		Theme.new("UIStroke", { Thickness = 1.5, Color = color, Transparency = 0.3, Parent = holder })
	else -- Dot
		holder.BackgroundTransparency = 0
		holder.BackgroundColor3 = color
		holder.BorderSizePixel = 0
		Theme.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = holder })
		Theme.new("UIStroke", { Thickness = math.max(1, size * 0.35), Color = color, Transparency = 0.6, Parent = holder })
	end
	return holder
end

type Mote = { Frame: Frame, X: number, Y: number, Speed: number, Phase: number, Base: number, Sway: number }

-- Fills `parent` (which should clip) with the update's floating motes; returns the step function.
function UpdateDecor.Motes(parent: Instance, update: Notes.Update, z: number): Step
	local style = UpdateDecor.Style(update)
	local rng = Random.new(update.Version * 7919)
	local motes: { Mote } = {}
	local function place(mote: Mote, anywhere: boolean)
		mote.X = rng:NextNumber(0.02, 0.98)
		mote.Y = if anywhere or style.Motion ~= "Rise" then rng:NextNumber(0, 1) else rng:NextNumber(1.02, 1.12)
		mote.Speed = rng:NextNumber(style.Speed.Min, style.Speed.Max)
		mote.Phase = rng:NextNumber(0, TAU)
	end
	for i = 1, style.Count do
		local kind = style.Shapes[(i - 1) % #style.Shapes + 1]
		local size = rng:NextNumber(style.Size.Min, style.Size.Max)
		local color = style.Colors[rng:NextInteger(1, #style.Colors)]
		local frame = shape(kind, size, color, z)
		frame.Name = "Mote"
		frame.Parent = parent
		local mote = { Frame = frame, X = 0, Y = 0, Speed = 0, Phase = 0, Base = frame.BackgroundTransparency, Sway = rng:NextNumber(0.006, 0.02) }
		place(mote, true)
		table.insert(motes, mote)
	end

	-- The odd shooting star (Stars)
	local streak: Frame? = nil
	local streakAt, streakFrom, streakTo = -10, Vector2.zero, Vector2.zero
	if style.Shooting then
		local s = Theme.new("Frame", {
			Name = "ShootingStar",
			AnchorPoint = Vector2.new(1, 0.5),
			Size = UDim2.fromOffset(90, 2),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = z,
			Parent = parent,
		})
		Theme.new("UIGradient", { Transparency = NumberSequence.new(1, 0), Parent = s })
		streak = s
	end

	local function setTransparency(mote: Mote, alpha: number)
		local frame = mote.Frame
		if frame.BackgroundTransparency < 1 or mote.Base < 1 then
			frame.BackgroundTransparency = 1 - (1 - mote.Base) * alpha
		end
		for _, child in frame:GetChildren() do
			if child:IsA("Frame") then
				child.BackgroundTransparency = 1 - alpha
			elseif child:IsA("UIStroke") then
				child.Transparency = 1 - alpha * 0.5
			end
		end
	end

	return function(t: number, dt: number)
		for _, mote in motes do
			local alpha = 1
			if style.Motion == "Rise" then
				mote.Y -= mote.Speed * dt
				if mote.Y < -0.05 then
					place(mote, false)
				end
				-- fade in at the bottom, out near the top, and flicker a little
				alpha = math.clamp((1.05 - mote.Y) * 5, 0, 1) * math.clamp(mote.Y * 3, 0, 1) * (0.75 + 0.25 * math.sin(t * 9 + mote.Phase))
				mote.Frame.Position = UDim2.fromScale(mote.X + math.sin(t * 1.4 + mote.Phase) * mote.Sway, mote.Y)
				mote.Frame.Rotation = if mote.Frame.Rotation ~= 0 then 45 + math.sin(t + mote.Phase) * 20 else 0
			elseif style.Motion == "Twinkle" then
				local wave = 0.5 + 0.5 * math.sin(t * mote.Speed + mote.Phase)
				alpha = 0.15 + 0.85 * wave * wave * wave
				if wave < 0.02 then
					mote.X = rng:NextNumber(0.02, 0.98)
					mote.Y = rng:NextNumber(0.02, 0.98)
				end
				mote.Frame.Position = UDim2.fromScale(mote.X, mote.Y)
			else -- Drift: slow bubbles
				mote.Y -= mote.Speed * dt
				if mote.Y < -0.08 then
					place(mote, false)
					mote.Y = 1.08
				end
				alpha = math.clamp((1.08 - mote.Y) * 4, 0, 1) * math.clamp((mote.Y + 0.08) * 4, 0, 1)
				mote.Frame.Position = UDim2.fromScale(mote.X + math.sin(t * 0.7 + mote.Phase) * mote.Sway * 2, mote.Y)
			end
			setTransparency(mote, alpha)
		end
		if streak then
			local age = t - streakAt
			if age > 7 then
				streakAt = t + rng:NextNumber(0, 3)
				streakFrom = Vector2.new(rng:NextNumber(0.2, 1), rng:NextNumber(-0.05, 0.35))
				streakTo = streakFrom + Vector2.new(-0.45, 0.3)
			end
			local p = (t - streakAt) / 0.8
			streak.Visible = p >= 0 and p <= 1
			if streak.Visible then
				local at = streakFrom:Lerp(streakTo, p)
				streak.Position = UDim2.fromScale(at.X, at.Y)
				streak.Rotation = 180 - 33
				streak.BackgroundTransparency = p * p
			end
		end
	end
end

return UpdateDecor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">UpdateNotes</string>
              <string name="Source"><![CDATA[--[[
	UpdateNotes: the Update Log window (the notes themselves are in Shared/UpdateNotes).

	  * the corner emblem: a 3D donut in the update's colours on a turning wheel (UpdateDecor), a
	    ribbon tab "Update Log", an "Update N" picker
	    and a round close button along the top
	  * left: the game's logo, the update's name, "Update N Patch Notes", a box listing everything new,
	    then each section (heading, tag and bullet lines) with a gem divider between them, over a big
	    faded model, the update's floating decorations, corner swirls and a soft glow
	  * right: groups of new things as cards with spinning 3D models of the real donuts / pets / eggs
	    (built from the game's own models, so there are no images to upload). Hover a card (tap it
	    on a phone) for its details card (ItemCard).
	Everything (window border, ribbon, panels, emblem, decorations) takes the update's own colours.

	It opens every time a player joins (after the "Welcome back" window if there is one). On a
	player's first visit the tutorial starts once they close it. The UPDATES button on the side and
	Settings > Update Log open it any time.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Notes = require(Shared.UpdateNotes)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local ItemCard = require(script.Parent.ItemCard)
local UpdateDecor = require(script.Parent.UpdateDecor)
local State = require(script.Parent.Parent.State)

local UpdateNotes = {}

local WIDTH, HEIGHT = 900, 540
local SIDEBAR = 256
local EMBLEM = 132
local rgb = Color3.fromRGB

type Spinner = { Camera: Camera, Distance: number, Height: number, Phase: number }

local modal: Modal.Modal
local show: (version: number) -> ()

-- The log that opens on joining: things that wait for it to be closed (the first-join tutorial)
local joinShown = false
local joinDone = false
local joinWaiters: { () -> () } = {}
local function finishJoin()
	if joinDone then
		return
	end
	joinDone = true
	for _, waiter in joinWaiters do
		task.spawn(waiter)
	end
	table.clear(joinWaiters)
end

-- Runs `callback` once the Update Log that opened on joining has been closed (right away if it
-- already was).
function UpdateNotes.AfterJoinLog(callback: () -> ())
	if joinDone then
		task.spawn(callback)
	else
		table.insert(joinWaiters, callback)
	end
end

function UpdateNotes.Open(version: number?)
	show(version or Notes.Latest)
	modal:Open()
end

local function text(props: { [string]: any }): TextLabel
	props.Font = props.Font or Theme.Font
	props.TextScaled = false
	props.TextWrapped = true
	props.AutomaticSize = Enum.AutomaticSize.Y
	return Theme.Label(props)
end

-- Put a model in a ViewportFrame, centred, and return a spinner for its camera.
local function stage(viewport: ViewportFrame, model: Model, zoom: number): Spinner
	local box, size = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() - box.Position)
	model.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local distance = math.max(size.X, size.Y, size.Z) * zoom
	local spinner = { Camera = camera, Distance = distance, Height = distance * 0.18, Phase = math.random() * 6 }
	camera.CFrame = CFrame.lookAt(Vector3.new(0, spinner.Height, -distance), Vector3.zero)
	return spinner
end

local function clear(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UICorner") and not child:IsA("UIStroke") and not child:IsA("UIGradient") then
			child:Destroy()
		end
	end
end

function UpdateNotes.Init()
	ItemCard.Init()
	modal = Modal.new("UPDATE LOG", Theme.Colors.Orange, Vector2.new(WIDTH, HEIGHT))
	local frame = modal.Frame
	-- Our own top bar instead of the usual window header
	local header = frame:FindFirstChild("Header")
	if header and header:IsA("GuiObject") then
		header.Visible = false
	end
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	local windowGradient = frame:FindFirstChildOfClass("UIGradient") or Theme.new("UIGradient", { Parent = frame })
	windowGradient.Rotation = 90
	modal.Body.Position = UDim2.new()
	modal.Body.Size = UDim2.fromScale(1, 1)
	local body = modal.Body

	-- Left: the patch notes, over a big faded model and the update's decorations
	local left = Theme.new("Frame", {
		Name = "Notes",
		Position = UDim2.fromOffset(12, 64),
		Size = UDim2.new(1, -(SIDEBAR + 34), 1, -76),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Parent = body,
	}, { Theme.Corner(12), Theme.Stroke(3) })
	local leftGradient = Theme.new("UIGradient", { Rotation = 90, Parent = left })
	local backdrop = Theme.new("ViewportFrame", {
		Name = "Backdrop",
		BackgroundTransparency = 1,
		ImageTransparency = 0.6,
		Ambient = rgb(200, 190, 220),
		LightColor = rgb(255, 255, 255),
		LightDirection = Vector3.new(-0.4, -1, 0.7),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -10),
		Size = UDim2.new(1, 40, 0, 260),
		ZIndex = 1,
		Parent = left,
	})
	local decor = Theme.new("Frame", { Name = "Decor", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = left })
	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 3,
		Parent = left,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 16) }),
	})

	-- Right: the new things, as cards
	local right = Theme.new("Frame", {
		Name = "Sidebar",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 64),
		Size = UDim2.new(0, SIDEBAR, 1, -76),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = body,
	}, { Theme.Corner(12), Theme.Stroke(3) })
	local rightGradient = Theme.new("UIGradient", { Rotation = 90, Parent = right })
	local cards = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = right,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 12) }),
	})

	-- Top bar
	local topBar = Theme.new("Frame", { Name = "TopBar", Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = body }, { Theme.Corner(18) })
	local topGradient = Theme.new("UIGradient", { Rotation = 90, Parent = topBar })

	-- The glowing border, in the update's colours (it slowly runs round the window)
	local border = Theme.new("Frame", {
		Name = "Border",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		ZIndex = 2,
		Parent = body,
	}, { Theme.Corner(16) })
	local borderStroke = Theme.new("UIStroke", { Thickness = 3, Color = Color3.new(1, 1, 1), Parent = border })
	local borderGradient = Theme.new("UIGradient", { Parent = borderStroke })

	-- The ribbon tab, with a pointed end
	local ribbon = Theme.new("Frame", {
		Name = "Ribbon",
		Position = UDim2.fromOffset(-30, -24),
		Size = UDim2.fromOffset(380, 70),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 4,
		Parent = body,
	}, { Theme.Corner(12), Theme.Stroke(3.5) })
	local ribbonGradient = Theme.new("UIGradient", { Rotation = 90, Parent = ribbon })
	local tip = Theme.new("Frame", {
		Name = "Tip",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 350, 0, 11),
		Size = UDim2.fromOffset(48, 48),
		Rotation = 45,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = body,
	}, { Theme.Corner(6), Theme.Stroke(3.5) })
	local tipGradient = Theme.new("UIGradient", { Rotation = 45, Parent = tip })
	local ribbonTrim = Theme.new("Frame", { Name = "Trim", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 96, 1, -7), Size = UDim2.new(1, -120, 0, 3), BorderSizePixel = 0, ZIndex = 5, Parent = ribbon }, {
		Theme.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) }) }),
	})
	Theme.Label({ Text = "Update Log", TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(104, 10), Size = UDim2.new(1, -120, 0, 46), StrokeThickness = 3.5, ZIndex = 6, Parent = ribbon })
	local ribbonDecor = Theme.new("Frame", { Name = "Decor", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = 5, Parent = ribbon })

	local close = Theme.Button({ Text = "X", Color = Theme.Colors.Red, Size = UDim2.fromOffset(58, 58), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -8, 0, 8), Parent = body })
	close.ZIndex = 5
	for _, child in close:GetDescendants() do
		if child:IsA("UICorner") then
			child.CornerRadius = UDim.new(1, 0)
		end
	end
	close.Activated:Connect(function()
		modal:Close()
	end)
	local versionButton = Theme.Button({ Text = "", Color = rgb(55, 55, 70), Size = UDim2.fromOffset(170, 42), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -52, 0, 8), Parent = body })

	-- "Update N" picker: a little menu of every update
	local menu = Theme.new("Frame", {
		Name = "VersionMenu",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -52, 0, 54),
		Size = UDim2.fromOffset(170, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = rgb(30, 30, 44),
		Visible = false,
		ZIndex = 10,
		Parent = body,
	}, { Theme.Corner(10), Theme.Stroke(2.5), Theme.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }), Theme.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }) })
	for i, update in Notes.List do
		local option = Theme.Button({ Text = `Update {update.Version}`, Color = update.Color, Size = UDim2.new(1, 0, 0, 36), Parent = menu })
		option.LayoutOrder = i
		option.ZIndex = 11
		option.Activated:Connect(function()
			menu.Visible = false
			show(update.Version)
		end)
	end
	versionButton.Activated:Connect(function()
		menu.Visible = not menu.Visible
	end)

	local spinners: { Spinner } = {}
	local steps: { UpdateDecor.Step } = {}
	local emblem: Frame? = nil
	show = function(version: number)
		local update = Notes.Get(version) or Notes.List[1]
		local color, accent = update.Color, update.Accent
		local style = UpdateDecor.Style(update)
		menu.Visible = false
		ItemCard.Hide()
		table.clear(spinners)
		table.clear(steps)
		clear(scroll)
		clear(cards)
		clear(decor)
		clear(ribbonDecor)
		backdrop:ClearAllChildren()
		Theme.SetButtonText(versionButton, `▼ Update {update.Version}`)

		-- Colours: everything takes the update's theme
		windowGradient.Color = ColorSequence.new(Theme.Darken(color, 0.55), Theme.Darken(color, 0.85))
		leftGradient.Color = ColorSequence.new(Theme.Lighten(color, 0.12), Theme.Darken(color, 0.45))
		rightGradient.Color = ColorSequence.new(Theme.Darken(color, 0.6), rgb(8, 7, 14))
		topGradient.Color = ColorSequence.new(Theme.Darken(color, 0.5), Theme.Darken(color, 0.78))
		ribbonGradient.Color = ColorSequence.new(Theme.Lighten(color, 0.25), Theme.Darken(color, 0.15))
		tipGradient.Color = ColorSequence.new(Theme.Lighten(color, 0.1), Theme.Darken(color, 0.2))
		ribbonTrim.BackgroundColor3 = accent
		borderGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, accent),
			ColorSequenceKeypoint.new(0.25, Theme.Lighten(color, 0.35)),
			ColorSequenceKeypoint.new(0.5, Theme.Lighten(accent, 0.4)),
			ColorSequenceKeypoint.new(0.75, Theme.Lighten(color, 0.35)),
			ColorSequenceKeypoint.new(1, accent),
		})
		Theme.SetButtonColor(versionButton, Theme.Darken(color, 0.2))

		-- The corner emblem and the decorations
		if emblem then
			emblem:Destroy()
		end
		local badge, emblemStep = UpdateDecor.Emblem(body, update, EMBLEM, 6)
		badge.Position = UDim2.fromOffset(-58, -52)
		emblem = badge
		table.insert(steps, emblemStep)
		table.insert(steps, UpdateDecor.Glow(decor, style.Glow or accent, 150, 0.45, 2))
		local swirlA = UpdateDecor.Swirl(decor, UDim2.fromScale(0, 1), 230, accent, 0.7, 2)
		local swirlB = UpdateDecor.Swirl(decor, UDim2.fromScale(1, 0), 190, accent, 0.72, 2)
		if style.Spin then
			table.insert(steps, swirlA)
			table.insert(steps, swirlB)
		end
		table.insert(steps, UpdateDecor.Rays(decor, UDim2.new(0.5, 0, 0, 120), 300, 10, Theme.Lighten(accent, 0.3), 0.82, 2))
		table.insert(steps, UpdateDecor.Motes(decor, update, 2))
		UpdateDecor.Swirl(ribbonDecor, UDim2.new(1, -36, 0.5, 0), 70, accent, 0.65, 5)

		-- Left column
		local order = 0
		local function add(instance: GuiObject)
			order += 1
			instance.LayoutOrder = order
			instance.Parent = scroll
		end
		local logo = Theme.Label({ Text = "STEAL A DONUT", Size = UDim2.new(1, -30, 0, 70), StrokeThickness = 5 })
		Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(rgb(255, 255, 255), Theme.Lighten(accent, 0.55)), Parent = logo })
		add(logo)
		local title = Theme.Label({ Text = update.Name, TextColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, -30, 0, 50), StrokeThickness = 4 })
		Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Lighten(accent, 0.45), Theme.Darken(accent, 0.1)), Parent = title })
		add(title)
		add(Theme.Label({ Text = `Update {update.Version} Patch Notes  •  {update.Date}`, Font = Theme.Font, TextColor3 = rgb(225, 220, 235), Size = UDim2.new(1, -30, 0, 24), StrokeThickness = 2 }))
		-- The box listing everything new
		local titles = {}
		for _, section in update.Sections do
			table.insert(titles, section.Title)
		end
		local box = Theme.new("Frame", {
			Size = UDim2.new(1, -60, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.4,
		}, {
			Theme.Corner(10),
			Theme.Stroke(2.5, Theme.Darken(accent, 0.3)),
			Theme.Padding(12),
			Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Darken(color, 0.55), rgb(0, 0, 0)) }),
		})
		text({ Text = table.concat(titles, `  <font color="#{accent:ToHex()}">✦</font>  `), RichText = true, TextSize = 22, LineHeight = 1.1, Size = UDim2.fromScale(1, 0), StrokeThickness = 2, Parent = box })
		add(Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 6) }))
		add(box)
		add(Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 8) }))
		for _, section in update.Sections do
			add(UpdateDecor.Divider(accent, 300))
			local heading = Theme.Label({ Text = section.Title, TextColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, -30, 0, 34), StrokeThickness = 3 })
			Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Lighten(accent, 0.35), accent), Parent = heading })
			add(heading)
			add(Theme.Label({ Text = string.upper(section.Tag), Font = Theme.Font, TextColor3 = Theme.Lighten(color, 0.6), Size = UDim2.new(1, -30, 0, 20), StrokeThickness = 2 }))
			for _, line in section.Lines do
				add(text({ Text = `<font color="#{accent:ToHex()}">•</font> {line}`, RichText = true, TextSize = 21, Size = UDim2.new(1, -60, 0, 0), StrokeThickness = 2 }))
			end
			add(Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 8) }))
		end

		-- Right column: groups of cards (hover one for its details)
		local cardOrder = 0
		local firstModel: Model? = nil
		for _, group in update.Sidebar do
			cardOrder += 1
			local groupTitle = Theme.Label({ Text = group.Title, TextColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, -16, 0, 30), StrokeThickness = 3, LayoutOrder = cardOrder, Parent = cards })
			Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Lighten(accent, 0.35), accent), Parent = groupTitle })
			cardOrder += 1
			local grid = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = cardOrder, Parent = cards }, {
				Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(112, 112), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
			})
			for i, item in group.Items do
				local info = ItemCard.Describe(item)
				local model = ItemCard.Model(item)
				local itemColor = info.Color
				local card = Theme.new("Frame", { Name = "Card", LayoutOrder = i, BackgroundColor3 = Color3.new(1, 1, 1), Parent = grid }, {
					Theme.Corner(12),
					Theme.Gradient(Theme.Lighten(itemColor, 0.1), Theme.Darken(itemColor, 0.55)),
				})
				local cardStroke = Theme.Stroke(3, Theme.Lighten(itemColor, 0.35))
				cardStroke.Parent = card
				Theme.Label({ Text = string.upper(info.Rarity), TextColor3 = Theme.Lighten(itemColor, 0.5), TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(7, 4), Size = UDim2.new(0.8, 0, 0, 15), StrokeThickness = 1.5, ZIndex = 3, Parent = card })
				Theme.Label({ Text = info.Name, Font = Theme.Font, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, -8, 0, 30), StrokeThickness = 2, ZIndex = 3, Parent = card })
				if model then
					if not firstModel then
						firstModel = model:Clone()
					end
					local viewport = Theme.new("ViewportFrame", {
						BackgroundTransparency = 1,
						Ambient = rgb(190, 185, 205),
						LightColor = rgb(255, 255, 255),
						LightDirection = Vector3.new(-0.5, -1, 0.8),
						Position = UDim2.fromOffset(4, 10),
						Size = UDim2.new(1, -8, 1, -30),
						ZIndex = 2,
						Parent = card,
					})
					table.insert(spinners, stage(viewport, model, 1.6))
				end
				-- Hover (or tap) for the details card; the card lights up while you do
				local hit = Theme.new("TextButton", { Name = "Hover", Text = "", BackgroundTransparency = 1, AutoButtonColor = false, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = card })
				ItemCard.Attach(hit, item, function(on: boolean)
					cardStroke.Color = if on then Theme.Lighten(itemColor, 0.75) else Theme.Lighten(itemColor, 0.35)
					cardStroke.Thickness = if on then 4.5 else 3
				end)
			end
		end
		if firstModel then
			table.insert(spinners, stage(backdrop, firstModel, 1.2))
		end
		scroll.CanvasPosition = Vector2.zero
		cards.CanvasPosition = Vector2.zero
	end

	-- The models sway and the decorations move while the window is open
	local started = os.clock()
	local last = started
	RunService.RenderStepped:Connect(function()
		if not modal:IsOpen() then
			return
		end
		local now = os.clock()
		local t, dt = now - started, math.min(now - last, 0.1)
		last = now
		for _, spinner in spinners do
			local angle = math.sin(t * 0.8 + spinner.Phase) * 0.6
			spinner.Camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(angle) * spinner.Distance, spinner.Height, -math.cos(angle) * spinner.Distance), Vector3.zero)
		end
		for _, step in steps do
			step(t, dt)
		end
		borderGradient.Rotation = (t * 40) % 360
	end)

	-- Every join: the log opens as soon as the screen is free (the "Welcome back" offline earnings
	-- arrive together with the save, and only one window shows at a time). Brand-new players see
	-- it too; their tutorial starts once they close it (UpdateNotes.AfterJoinLog).
	modal.OnClose = function()
		if joinShown then
			finishJoin()
		end
	end
	local checked = false
	State.Changed:Connect(function(snapshot)
		if checked then
			return
		end
		checked = true
		if (snapshot.SeenUpdate or 0) < Notes.Latest then
			State.Action("SeenUpdate", Notes.Latest)
		end
		task.spawn(function()
			-- wait for the loading screen to finish first
			local player = game:GetService("Players").LocalPlayer
			local loading = 0
			while player:GetAttribute("LoadingScreen") and loading < 60 do
				task.wait(0.25)
				loading += 0.25
			end
			task.wait(1.5)
			local waited = 0
			while Modal.AnyOpen() and waited < 600 do
				task.wait(0.5)
				waited += 0.5
			end
			if Modal.AnyOpen() then
				finishJoin() -- (somebody's been in a window for 10 minutes: don't hold the tutorial)
				return
			end
			joinShown = true
			UpdateNotes.Open()
		end)
	end)
end

return UpdateNotes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">VirtualList</string>
              <string name="Source"><![CDATA[--[[
	VirtualList: a scrolling list that can show thousands of rows while only creating enough row
	frames to fill the visible window (rows are recycled as you scroll).
]]

local VirtualList = {}
VirtualList.__index = VirtualList

export type VirtualList = {
	Frame: ScrollingFrame,
	RowHeight: number,
	Entries: { any },
	Pool: { GuiObject },
	Build: () -> GuiObject,
	Bind: (GuiObject, any, number) -> (),
	SetEntries: (self: VirtualList, entries: { any }) -> (),
	Refresh: (self: VirtualList) -> (),
}

function VirtualList.new(frame: ScrollingFrame, rowHeight: number, build: () -> GuiObject, bind: (GuiObject, any, number) -> ()): VirtualList
	local self = setmetatable({
		Frame = frame,
		RowHeight = rowHeight,
		Entries = {},
		Pool = {},
		Build = build,
		Bind = bind,
	}, VirtualList) :: any
	frame.AutomaticCanvasSize = Enum.AutomaticSize.None
	frame:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		self:Refresh()
	end)
	frame:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(function()
		self:Refresh()
	end)
	return self
end

function VirtualList.SetEntries(self: VirtualList, entries: { any })
	self.Entries = entries
	self.Frame.CanvasSize = UDim2.new(0, 0, 0, #entries * self.RowHeight)
	self:Refresh()
end

function VirtualList.Refresh(self: VirtualList)
	local windowHeight = self.Frame.AbsoluteWindowSize.Y
	if windowHeight <= 0 then
		windowHeight = self.Frame.AbsoluteSize.Y
	end
	-- AbsoluteWindowSize is in screen pixels; convert to canvas units if the list is scaled.
	local canvasHeight = self.Frame.AbsoluteCanvasSize.Y
	local ratio = if self.Frame.CanvasSize.Y.Offset > 0 and canvasHeight > 0 then self.Frame.CanvasSize.Y.Offset / canvasHeight else 1
	local needed = math.ceil(windowHeight * ratio / self.RowHeight) + 2
	while #self.Pool < needed do
		local row = self.Build()
		row.Parent = self.Frame
		table.insert(self.Pool, row)
	end
	local first = math.max(1, math.floor(self.Frame.CanvasPosition.Y / self.RowHeight) + 1)
	for i, row in self.Pool do
		local index = first + i - 1
		local entry = self.Entries[index]
		if entry then
			row.Visible = true
			row.Position = UDim2.fromOffset(0, (index - 1) * self.RowHeight)
			self.Bind(row, entry, index)
		else
			row.Visible = false
		end
	end
end

return VirtualList
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="121">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--[[
	Weather: the client-side look of server events (see Events.luau / EventService).
	While an event runs you get its weather around you wherever you are (sand, snow, rain, embers,
	bubbles, sparkles, shooting stars, confetti, ghosts, coins, leaves, rainbows, eggs) and a colour
	tint. A Sandstorm or Blizzard also adds some haze.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Events = require(Shared.Events)


local Weather = {}

local player = Players.LocalPlayer :: Player
local rgb = Color3.fromRGB

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, rgb(255, 70, 70)),
	ColorSequenceKeypoint.new(0.25, rgb(255, 220, 60)),
	ColorSequenceKeypoint.new(0.5, rgb(70, 220, 100)),
	ColorSequenceKeypoint.new(0.75, rgb(70, 150, 255)),
	ColorSequenceKeypoint.new(1, rgb(200, 90, 255)),
})

type Style = {
	Rate: number,
	Speed: NumberRange,
	Size: NumberSequence,
	Lifetime: NumberRange,
	Color: ColorSequence?,
	Direction: Enum.NormalId,
	Acceleration: Vector3?,
	Squash: number?,
	Light: number?,
	Spin: boolean?,
	Transparency: NumberSequence?,
	Height: number,
}

local STYLES: { [string]: Style } = {
	Sand = { Rate = 350, Speed = NumberRange.new(20, 40), Size = NumberSequence.new(0.35, 0.2), Lifetime = NumberRange.new(1.5, 2.5), Color = ColorSequence.new(rgb(225, 190, 130)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(60, 0, 20), Height = 25 },
	Snow = { Rate = 220, Speed = NumberRange.new(6, 12), Size = NumberSequence.new(0.45, 0.3), Lifetime = NumberRange.new(4, 6), Color = ColorSequence.new(rgb(255, 255, 255)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(6, 0, 3), Light = 0.3, Height = 40 },
	Rain = { Rate = 500, Speed = NumberRange.new(70, 90), Size = NumberSequence.new(0.12), Lifetime = NumberRange.new(0.6, 0.9), Direction = Enum.NormalId.Bottom, Squash = -3, Height = 45 },
	Embers = { Rate = 140, Speed = NumberRange.new(4, 10), Size = NumberSequence.new(0.35, 0), Lifetime = NumberRange.new(3, 5), Color = ColorSequence.new(rgb(255, 170, 40), rgb(255, 60, 0)), Direction = Enum.NormalId.Top, Light = 1, Height = -2 },
	Bubbles = { Rate = 90, Speed = NumberRange.new(3, 7), Size = NumberSequence.new(0.4, 0.8), Lifetime = NumberRange.new(4, 6), Color = ColorSequence.new(rgb(210, 245, 255)), Direction = Enum.NormalId.Top, Transparency = NumberSequence.new(0.3, 0.8), Height = -2 },
	Sparkles = { Rate = 120, Speed = NumberRange.new(1, 4), Size = NumberSequence.new(0.5, 0), Lifetime = NumberRange.new(2, 3), Direction = Enum.NormalId.Bottom, Light = 1, Height = 20 },
	Stars = { Rate = 30, Speed = NumberRange.new(90, 130), Size = NumberSequence.new(0.6, 0.2), Lifetime = NumberRange.new(0.8, 1.2), Color = ColorSequence.new(rgb(255, 240, 180)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(80, 0, 40), Squash = -4, Light = 1, Height = 70 },
	Confetti = { Rate = 180, Speed = NumberRange.new(6, 12), Size = NumberSequence.new(0.35), Lifetime = NumberRange.new(4, 6), Color = RAINBOW, Direction = Enum.NormalId.Bottom, Spin = true, Height = 35 },
	Ghosts = { Rate = 8, Speed = NumberRange.new(2, 5), Size = NumberSequence.new(2.5, 4), Lifetime = NumberRange.new(4, 7), Color = ColorSequence.new(rgb(220, 255, 220)), Direction = Enum.NormalId.Top, Transparency = NumberSequence.new(0.7, 1), Light = 0.5, Height = 0 },
	Coins = { Rate = 70, Speed = NumberRange.new(10, 18), Size = NumberSequence.new(0.45), Lifetime = NumberRange.new(2.5, 4), Color = ColorSequence.new(rgb(255, 210, 60)), Direction = Enum.NormalId.Bottom, Spin = true, Light = 0.4, Height = 35 },
	Leaves = { Rate = 90, Speed = NumberRange.new(4, 8), Size = NumberSequence.new(0.5), Lifetime = NumberRange.new(5, 7), Color = ColorSequence.new(rgb(255, 150, 50), rgb(200, 80, 30)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(5, 0, 2), Spin = true, Height = 35 },
	Rainbow = { Rate = 200, Speed = NumberRange.new(4, 10), Size = NumberSequence.new(0.5, 0), Lifetime = NumberRange.new(3, 5), Color = RAINBOW, Direction = Enum.NormalId.Bottom, Light = 1, Spin = true, Height = 30 },
	Void = { Rate = 150, Speed = NumberRange.new(3, 9), Size = NumberSequence.new(0.55, 0), Lifetime = NumberRange.new(3, 5), Color = ColorSequence.new(rgb(225, 170, 255), rgb(120, 30, 230)), Direction = Enum.NormalId.Top, Light = 1, Spin = true, Height = -2 },
	Eggs = { Rate = 40, Speed = NumberRange.new(10, 16), Size = NumberSequence.new(0.7), Lifetime = NumberRange.new(2.5, 4), Color = ColorSequence.new(rgb(255, 240, 200), rgb(255, 190, 230)), Direction = Enum.NormalId.Bottom, Spin = true, Height = 35 },
}

local holder: Part? = nil
local tint: ColorCorrectionEffect
local activeId: string? = nil

local function stop()
	activeId = nil
	if holder then
		holder:Destroy()
		holder = nil
	end
	TweenService:Create(tint, TweenInfo.new(2), { TintColor = Color3.new(1, 1, 1) }):Play()
end

local function start(event: Events.Event)
	stop()
	activeId = event.Id
	local style = STYLES[event.Weather] or STYLES.Sparkles
	local part = Instance.new("Part")
	part.Name = "EventWeather"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(110, 1, 110)
	part:SetAttribute("Height", style.Height)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = style.Rate
	emitter.Speed = style.Speed
	emitter.Size = style.Size
	emitter.Lifetime = style.Lifetime
	emitter.Color = style.Color or ColorSequence.new(event.Color)
	emitter.EmissionDirection = style.Direction
	emitter.SpreadAngle = Vector2.new(10, 10)
	emitter.Acceleration = style.Acceleration or Vector3.zero
	emitter.LightEmission = style.Light or 0
	emitter.Transparency = style.Transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0.1), NumberSequenceKeypoint.new(1, 0.6) })
	if style.Squash then
		emitter.Squash = NumberSequence.new(style.Squash)
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
	end
	if style.Spin then
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-180, 180)
	end
	emitter.Parent = part
	if event.Fog > 0 then
		-- Thick haze close to you (the lane further away disappears into it)
		local haze = Instance.new("ParticleEmitter")
		haze.Rate = 25 * event.Fog * 2
		haze.Speed = NumberRange.new(2, 6)
		haze.Size = NumberSequence.new(14, 20)
		haze.Lifetime = NumberRange.new(4, 6)
		haze.Color = ColorSequence.new(event.Color)
		haze.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 1 - event.Fog), NumberSequenceKeypoint.new(1, 1) })
		haze.SpreadAngle = Vector2.new(180, 180)
		haze.Parent = part
	end
	part.Parent = workspace
	holder = part
	TweenService:Create(tint, TweenInfo.new(2), { TintColor = event.Tint }):Play()
end

function Weather.Init()
	tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "EventTint"
	tint.Parent = Lighting

	-- Follow the player
	RunService.RenderStepped:Connect(function()
		local part = holder
		if not part then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local height = (part:GetAttribute("Height") :: number?) or 30
			part.CFrame = CFrame.new(root.Position + Vector3.new(0, height, 0))
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			local eventId = workspace:GetAttribute("EventId")
			local event = if type(eventId) == "string" then Events.ById[eventId] else nil
			if event and event.Id ~= activeId then
				start(event)
			elseif not event and activeId then
				stop()
			end
		end
	end)
end

return Weather
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
