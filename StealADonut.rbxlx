	{
		Id = "Neon", Name = "Neon Nights", SpeedCost = 2_000_000,
		Floor = Color3.fromRGB(25, 20, 40), FloorAlt = Color3.fromRGB(35, 30, 55), FloorMaterial = Enum.Material.SmoothPlastic,
