	{ Id = "LavaDragon", Name = "Lava Dragon", Rarity = "Legendary", Money = 0.35, Speed = 0.2, Shape = "Dragon", Body = rgb(90, 30, 20), Accent = rgb(255, 140, 0), Features = { "Wings", "Horns", "Tail", "Flames", "Glow" } },
