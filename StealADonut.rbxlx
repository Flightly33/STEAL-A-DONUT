          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">VirtualList</string>
              <string name="Source"><![CDATA[--[[
	VirtualList: a scrolling list that can show thousands of rows while only creating enough row
	frames to fill the visible window (rows are recycled as you scroll).
]]

local VirtualList = {}
VirtualList.__index = VirtualList

export type VirtualList = {
	Frame: ScrollingFrame,
	RowHeight: number,
	Entries: { any },
	Pool: { GuiObject },
	Build: () -> GuiObject,
	Bind: (GuiObject, any, number) -> (),
	SetEntries: (self: VirtualList, entries: { any }) -> (),
	Refresh: (self: VirtualList) -> (),
}

function VirtualList.new(frame: ScrollingFrame, rowHeight: number, build: () -> GuiObject, bind: (GuiObject, any, number) -> ()): VirtualList
	local self = setmetatable({
		Frame = frame,
		RowHeight = rowHeight,
		Entries = {},
		Pool = {},
		Build = build,
		Bind = bind,
	}, VirtualList) :: any
	frame.AutomaticCanvasSize = Enum.AutomaticSize.None
	frame:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		self:Refresh()
	end)
	frame:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(function()
		self:Refresh()
	end)
	return self
end

function VirtualList.SetEntries(self: VirtualList, entries: { any })
	self.Entries = entries
	self.Frame.CanvasSize = UDim2.new(0, 0, 0, #entries * self.RowHeight)
	self:Refresh()
end

function VirtualList.Refresh(self: VirtualList)
	local windowHeight = self.Frame.AbsoluteWindowSize.Y
	if windowHeight <= 0 then
		windowHeight = self.Frame.AbsoluteSize.Y
	end
	-- AbsoluteWindowSize is in screen pixels; convert to canvas units if the list is scaled.
	local canvasHeight = self.Frame.AbsoluteCanvasSize.Y
	local ratio = if self.Frame.CanvasSize.Y.Offset > 0 and canvasHeight > 0 then self.Frame.CanvasSize.Y.Offset / canvasHeight else 1
	local needed = math.ceil(windowHeight * ratio / self.RowHeight) + 2
	while #self.Pool < needed do
		local row = self.Build()
		row.Parent = self.Frame
		table.insert(self.Pool, row)
	end
	local first = math.max(1, math.floor(self.Frame.CanvasPosition.Y / self.RowHeight) + 1)
	for i, row in self.Pool do
		local index = first + i - 1
		local entry = self.Entries[index]
		if entry then
			row.Visible = true
			row.Position = UDim2.fromOffset(0, (index - 1) * self.RowHeight)
			self.Bind(row, entry, index)
		else
			row.Visible = false
		end
	end
end

return VirtualList
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Worlds</string>
              <string name="Source"><![CDATA[--[[
	Worlds window: every world and what it takes to get there. Anyone can walk through the portals
	in the hub; with the Teleporter game pass you can also jump straight to any world, or to the
	start of any area you're fast enough for.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Worlds = {}

local modal: Modal.Modal
local refreshers: { () -> () } = {}

function Worlds.Open()
	modal:Open()
end

local function refreshAll()
	for _, refresh in refreshers do
		refresh()
	end
end

function Worlds.Init()
	modal = Modal.new("🌀 WORLDS & TELEPORT", Theme.Colors.Blue, Vector2.new(760, 540))
	local body = modal.Body
	local header = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -210, 0, 44), Parent = body })
	local passButton = Theme.Button({ Text = "🌀 Get Teleporter", Color = Theme.Colors.Green, Size = UDim2.fromOffset(200, 44), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Parent = body })
	passButton.Activated:Connect(function()
		State.Action("BuyPass", "Teleporter")
	end)

	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 1, -52),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = body,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
	})

	for _, world in Areas.Worlds do
		local card = Theme.new("Frame", { BackgroundColor3 = Theme.Colors.PanelLight, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = world.Id, Parent = scroll }, {
			Theme.Corner(14),
			Theme.Stroke(3, world.Color),
			Theme.new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
			Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		local top = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1, Parent = card })
		Theme.Label({ Text = `{world.Icon} WORLD {world.Id}: {string.upper(world.Name)}`, TextColor3 = world.Color:Lerp(Color3.new(1, 1, 1), 0.3), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 30), Parent = top })
		local status = Theme.Label({ Text = "", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 16), Position = UDim2.fromOffset(0, 30), StrokeThickness = 1.2, Parent = top })
		local go = Theme.Button({ Text = "GO", Color = Theme.Colors.Green, Size = UDim2.fromOffset(160, 42), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Parent = top })
		go.Activated:Connect(function()
			State.Action("TeleportWorld", world.Id)
		end)
		local grid = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = card }, {
			Theme.new("UIGridLayout", { CellSize = UDim2.new(0.2, -6, 0, 60), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		})
		local areaButtons: { { Button: TextButton, Area: Areas.Area } } = {}
		for _, area in Areas.ByWorld[world.Id] do
			local button = Theme.Button({ Text = `{area.Id}. {area.Name}`, Color = area.Trim, Size = UDim2.new(), LayoutOrder = area.Id, Parent = grid })
			button.Activated:Connect(function()
				State.Action("TeleportArea", area.Id)
			end)
			table.insert(areaButtons, { Button = button, Area = area })
		end

		table.insert(refreshers, function()
			local rebirths = State.Number("Rebirths")
			local hasPass = State.Data.Passes.Teleporter == true
			local unlocked = Economy.WorldUnlocked(world.Id, rebirths, State.Number("UltimateRebirths"))
			local walk = Economy.WalkSpeedFromStat(State.Number("Speed"))
			if unlocked then
				status.Text = if world.Id == 1 then "Your home world" else `Unlocked! Everyone is x{world.WalkMultiplier} faster here`
				status.TextColor3 = Color3.fromRGB(150, 255, 150)
			else
				status.Text = if (world.RequiredUltimate or 0) > 0
					then "🔒 Needs an ULTIMATE REBIRTH (in The Black Hole)"
					else `🔒 Needs {world.RequiredRebirths} rebirth{if world.RequiredRebirths == 1 then "" else "s"} (you have {rebirths})`
				status.TextColor3 = Color3.fromRGB(255, 150, 150)
			end
			Theme.SetButtonText(go, if not unlocked then "🔒 LOCKED" elseif hasPass then "🌀 GO" else "🌀 PASS")
			Theme.SetButtonColor(go, if unlocked and hasPass then Theme.Colors.Green else Theme.Colors.Gray)
			for _, entry in areaButtons do
				local fastEnough = walk + 0.01 >= Economy.WalkSpeedFromStat(Economy.RecommendedSpeed(entry.Area.Id))
				local open = unlocked and fastEnough
				Theme.SetButtonText(entry.Button, if open then `{entry.Area.Id}. {entry.Area.Name}` else `🔒 ⚡{Format.Number(Economy.RecommendedSpeed(entry.Area.Id))}`)
				Theme.SetButtonColor(entry.Button, if open and hasPass then entry.Area.Trim else Theme.Colors.Gray)
			end
		end)
	end

	table.insert(refreshers, function()
		local hasPass = State.Data.Passes.Teleporter == true
		passButton.Visible = not hasPass
		header.Text = if hasPass
			then "🌀 <b>Teleporter active!</b> Jump to any world or area you've unlocked."
			else "Walk through the portals in the hub to travel. The <b>Teleporter</b> pass lets you jump anywhere instantly."
	end)

	modal.OnOpen = refreshAll
	State.Changed:Connect(function()
		if modal:IsOpen() then
			refreshAll()
		end
	end)
	for _, name in { "Speed", "Rebirths" } do
		State.OnAttribute(name, function()
			if modal:IsOpen() then
				refreshAll()
			end
		end)
	end
end

return Worlds
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">UnderworldFX</string>
            <string name="Source"><![CDATA[--[[
	UnderworldFX: The Underworld's (World 2's) living lava and firelight, on the client.
	  * lava (tagged "Lava" by Decor) churns: its glow swells and fades, each piece in its own rhythm
	  * geysers (tagged "Geyser") erupt every few seconds
	  * while you're in The Underworld the colour grading flickers warmly, like firelight
	Only things near the camera are animated.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local AreaTracker = require(script.Parent.AreaTracker)
local State = require(script.Parent.State)

local UnderworldFX = {}

local WORLD = 2
local LAVA_DISTANCE = 450
local GEYSER_DISTANCE = 400
local HOT = Color3.new(1, 1, 0.8)

type Lava = { Base: Color3, Phase: number, Speed: number }
type Geyser = { Emitter: ParticleEmitter, Position: Vector3, NextAt: number, StopAt: number }

local function track<T>(tag: string, onAdd: (Instance) -> T?): { [Instance]: T }
	local set: { [Instance]: T } = {}
	local function add(instance: Instance)
		local value = onAdd(instance)
		if value ~= nil and instance.Parent then
			set[instance] = value
		end
	end
	for _, instance in CollectionService:GetTagged(tag) do
		task.spawn(add, instance)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance)
		set[instance] = nil
	end)
	return set
end

local function inUnderworld(): boolean
	local area = AreaTracker.Current
	if area > 0 then
		local info = Areas.List[area]
		return info ~= nil and info.World == WORLD
	end
	return area == 0 and State.Number("World") == WORLD
end

function UnderworldFX.Init()
	local rng = Random.new()
	local lavas: { [Instance]: Lava } = track("Lava", function(instance): Lava?
		if not instance:IsA("BasePart") then
			return nil
		end
		return { Base = instance.Color, Phase = rng:NextNumber(0, 6.28), Speed = rng:NextNumber(0.8, 1.6) }
	end)
	local geysers: { [Instance]: Geyser } = track("Geyser", function(instance): Geyser?
		local emitter = instance:WaitForChild("Eruption", 10)
		if not instance:IsA("BasePart") or not emitter or not emitter:IsA("ParticleEmitter") then
			return nil
		end
		return { Emitter = emitter, Position = instance.Position, NextAt = os.clock() + rng:NextNumber(1, 6), StopAt = 0 }
	end)

	local firelight = Instance.new("ColorCorrectionEffect")
	firelight.Name = "Firelight"
	firelight.Enabled = false
	firelight.Parent = Lighting
	local strength = 0
	local sinceLava = 0

	RunService.RenderStepped:Connect(function(dt: number)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local cam = camera.CFrame.Position
		local t = os.clock()

		-- Lava churns (20 times a second is plenty)
		sinceLava += dt
		if sinceLava >= 0.05 then
			sinceLava = 0
			for instance, lava in lavas do
				local part = instance :: BasePart
				if not part.Parent then
					lavas[instance] = nil
				elseif (part.Position - cam).Magnitude < LAVA_DISTANCE then
					local wave = 0.5 + 0.5 * math.sin(t * lava.Speed + lava.Phase)
					part.Color = lava.Base:Lerp(HOT, 0.06 + 0.22 * wave)
				end
			end
		end

		-- Geysers erupt now and then
		for instance, geyser in geysers do
			if not instance.Parent then
				geysers[instance] = nil
			elseif (geyser.Position - cam).Magnitude < GEYSER_DISTANCE then
				if t >= geyser.NextAt then
					geyser.Emitter.Enabled = true
					geyser.StopAt = t + 1.2
					geyser.NextAt = t + rng:NextNumber(4, 8)
				elseif geyser.Emitter.Enabled and t >= geyser.StopAt then
					geyser.Emitter.Enabled = false
				end
			elseif geyser.Emitter.Enabled then
				geyser.Emitter.Enabled = false
			end
		end

		-- Firelight: a warm, flickering grade that fades in when you arrive
		local target = if inUnderworld() then 1 else 0
		strength += (target - strength) * math.min(1, dt * 1.5)
		firelight.Enabled = strength > 0.01
		if firelight.Enabled then
			local flicker = math.noise(t * 3.1, 0.37)
			firelight.Brightness = strength * 0.025 * flicker
			firelight.Contrast = strength * (0.05 + 0.03 * math.noise(t * 1.7, 4.2))
			firelight.TintColor = Color3.new(1, 1 - strength * (0.04 + 0.02 * flicker), 1 - strength * 0.1)
		end
	end)
end

return UnderworldFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--[[
	Weather: the client-side look of server events (see Events.luau / EventService).
	While an event runs you get its weather around you wherever you are (sand, snow, rain, embers,
	bubbles, sparkles, shooting stars, confetti, ghosts, coins, leaves, rainbows, eggs) and a colour
	tint. A Sandstorm or Blizzard also adds some haze.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Events = require(Shared.Events)


local Weather = {}

local player = Players.LocalPlayer :: Player
local rgb = Color3.fromRGB

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, rgb(255, 70, 70)),
	ColorSequenceKeypoint.new(0.25, rgb(255, 220, 60)),
	ColorSequenceKeypoint.new(0.5, rgb(70, 220, 100)),
	ColorSequenceKeypoint.new(0.75, rgb(70, 150, 255)),
	ColorSequenceKeypoint.new(1, rgb(200, 90, 255)),
})

type Style = {
	Rate: number,
	Speed: NumberRange,
	Size: NumberSequence,
	Lifetime: NumberRange,
	Color: ColorSequence?,
	Direction: Enum.NormalId,
	Acceleration: Vector3?,
	Squash: number?,
	Light: number?,
	Spin: boolean?,
	Transparency: NumberSequence?,
	Height: number,
}

local STYLES: { [string]: Style } = {
	Sand = { Rate = 350, Speed = NumberRange.new(20, 40), Size = NumberSequence.new(0.35, 0.2), Lifetime = NumberRange.new(1.5, 2.5), Color = ColorSequence.new(rgb(225, 190, 130)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(60, 0, 20), Height = 25 },
	Snow = { Rate = 220, Speed = NumberRange.new(6, 12), Size = NumberSequence.new(0.45, 0.3), Lifetime = NumberRange.new(4, 6), Color = ColorSequence.new(rgb(255, 255, 255)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(6, 0, 3), Light = 0.3, Height = 40 },
	Rain = { Rate = 500, Speed = NumberRange.new(70, 90), Size = NumberSequence.new(0.12), Lifetime = NumberRange.new(0.6, 0.9), Direction = Enum.NormalId.Bottom, Squash = -3, Height = 45 },
	Embers = { Rate = 140, Speed = NumberRange.new(4, 10), Size = NumberSequence.new(0.35, 0), Lifetime = NumberRange.new(3, 5), Color = ColorSequence.new(rgb(255, 170, 40), rgb(255, 60, 0)), Direction = Enum.NormalId.Top, Light = 1, Height = -2 },
	Bubbles = { Rate = 90, Speed = NumberRange.new(3, 7), Size = NumberSequence.new(0.4, 0.8), Lifetime = NumberRange.new(4, 6), Color = ColorSequence.new(rgb(210, 245, 255)), Direction = Enum.NormalId.Top, Transparency = NumberSequence.new(0.3, 0.8), Height = -2 },
	Sparkles = { Rate = 120, Speed = NumberRange.new(1, 4), Size = NumberSequence.new(0.5, 0), Lifetime = NumberRange.new(2, 3), Direction = Enum.NormalId.Bottom, Light = 1, Height = 20 },
	Stars = { Rate = 30, Speed = NumberRange.new(90, 130), Size = NumberSequence.new(0.6, 0.2), Lifetime = NumberRange.new(0.8, 1.2), Color = ColorSequence.new(rgb(255, 240, 180)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(80, 0, 40), Squash = -4, Light = 1, Height = 70 },
	Confetti = { Rate = 180, Speed = NumberRange.new(6, 12), Size = NumberSequence.new(0.35), Lifetime = NumberRange.new(4, 6), Color = RAINBOW, Direction = Enum.NormalId.Bottom, Spin = true, Height = 35 },
	Ghosts = { Rate = 8, Speed = NumberRange.new(2, 5), Size = NumberSequence.new(2.5, 4), Lifetime = NumberRange.new(4, 7), Color = ColorSequence.new(rgb(220, 255, 220)), Direction = Enum.NormalId.Top, Transparency = NumberSequence.new(0.7, 1), Light = 0.5, Height = 0 },
	Coins = { Rate = 70, Speed = NumberRange.new(10, 18), Size = NumberSequence.new(0.45), Lifetime = NumberRange.new(2.5, 4), Color = ColorSequence.new(rgb(255, 210, 60)), Direction = Enum.NormalId.Bottom, Spin = true, Light = 0.4, Height = 35 },
	Leaves = { Rate = 90, Speed = NumberRange.new(4, 8), Size = NumberSequence.new(0.5), Lifetime = NumberRange.new(5, 7), Color = ColorSequence.new(rgb(255, 150, 50), rgb(200, 80, 30)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(5, 0, 2), Spin = true, Height = 35 },
	Rainbow = { Rate = 200, Speed = NumberRange.new(4, 10), Size = NumberSequence.new(0.5, 0), Lifetime = NumberRange.new(3, 5), Color = RAINBOW, Direction = Enum.NormalId.Bottom, Light = 1, Spin = true, Height = 30 },
	Eggs = { Rate = 40, Speed = NumberRange.new(10, 16), Size = NumberSequence.new(0.7), Lifetime = NumberRange.new(2.5, 4), Color = ColorSequence.new(rgb(255, 240, 200), rgb(255, 190, 230)), Direction = Enum.NormalId.Bottom, Spin = true, Height = 35 },
}

local holder: Part? = nil
local tint: ColorCorrectionEffect
local activeId: string? = nil

local function stop()
	activeId = nil
	if holder then
		holder:Destroy()
		holder = nil
	end
	TweenService:Create(tint, TweenInfo.new(2), { TintColor = Color3.new(1, 1, 1) }):Play()
end

local function start(event: Events.Event)
	stop()
	activeId = event.Id
	local style = STYLES[event.Weather] or STYLES.Sparkles
	local part = Instance.new("Part")
	part.Name = "EventWeather"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(110, 1, 110)
	part:SetAttribute("Height", style.Height)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = style.Rate
	emitter.Speed = style.Speed
	emitter.Size = style.Size
	emitter.Lifetime = style.Lifetime
	emitter.Color = style.Color or ColorSequence.new(event.Color)
	emitter.EmissionDirection = style.Direction
	emitter.SpreadAngle = Vector2.new(10, 10)
	emitter.Acceleration = style.Acceleration or Vector3.zero
	emitter.LightEmission = style.Light or 0
	emitter.Transparency = style.Transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0.1), NumberSequenceKeypoint.new(1, 0.6) })
	if style.Squash then
		emitter.Squash = NumberSequence.new(style.Squash)
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
	end
	if style.Spin then
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-180, 180)
	end
	emitter.Parent = part
	if event.Fog > 0 then
		-- Thick haze close to you (the lane further away disappears into it)
		local haze = Instance.new("ParticleEmitter")
		haze.Rate = 25 * event.Fog * 2
		haze.Speed = NumberRange.new(2, 6)
		haze.Size = NumberSequence.new(14, 20)
		haze.Lifetime = NumberRange.new(4, 6)
		haze.Color = ColorSequence.new(event.Color)
		haze.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 1 - event.Fog), NumberSequenceKeypoint.new(1, 1) })
		haze.SpreadAngle = Vector2.new(180, 180)
		haze.Parent = part
	end
	part.Parent = workspace
	holder = part
	TweenService:Create(tint, TweenInfo.new(2), { TintColor = event.Tint }):Play()
end

function Weather.Init()
	tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "EventTint"
	tint.Parent = Lighting

	-- Follow the player
	RunService.RenderStepped:Connect(function()
		local part = holder
		if not part then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local height = (part:GetAttribute("Height") :: number?) or 30
			part.CFrame = CFrame.new(root.Position + Vector3.new(0, height, 0))
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			local eventId = workspace:GetAttribute("EventId")
			local event = if type(eventId) == "string" then Events.ById[eventId] else nil
			if event and event.Id ~= activeId then
				start(event)
			elseif not event and activeId then
				stop()
			end
		end
	end)
end

return Weather
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
