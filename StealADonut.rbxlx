      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">PlayerAnimData</string>
          <string name="Source"><![CDATA[--[[
	PlayerAnimData: your character's cutscene moves (the opening scene, the Mythic box opening),
	keyframed in Blender: art/player_anims/player_anims.py writes this file - change them there
	and run it again, don't edit by hand.

	Anims[name] = { Length (seconds), Loop, Frames }: Frames are sampled 20 times a second; each
	frame is every R15 joint's rotation (in Joints order) as a quaternion { x, y, z, w } in Roblox's
	axes - its Motor6D.Transform (client/PlayerAnims plays them).
]]

local PlayerAnimData = {}

PlayerAnimData.Rate = 20
PlayerAnimData.Joints = { "LowerTorso", "UpperTorso", "Head", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperLeg", "RightLowerLeg", "RightFoot", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot" }
