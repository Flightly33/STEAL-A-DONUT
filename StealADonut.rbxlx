-- Two round smiling faces, one peeking out from behind the other (the Friend Boost). The back
-- face's eyes, mouth and cheeks sit on its own layer, so the front face covers them where it
-- overlaps; the mouths are open half-moons (an ellipse with its top half cut off).
local FACE = Color3.fromRGB(255, 168, 52)
local CHEEK = Color3.fromRGB(255, 120, 120)
SHAPES.friends = (function(): { Shape }
	local _, _, _, backInk = depthLayers(1)
	local function face(x: number, y: number, d: number, back: boolean): { Shape }
		local s = d / 0.54 -- (the front face is 0.54 across: everything else is in step with it)
		local depth = if back then 1 else nil
		local detail = if back then backInk else nil
		local mouthY = y + 0.09 * s
		return {
			circle(x, y, d, { color = FACE, back = depth }),
			ellipse(x - 0.075 * s, y - 0.05 * s, 0.065 * s, 0.1 * s, { fill = "ink", back = depth }),
			ellipse(x + 0.075 * s, y - 0.05 * s, 0.065 * s, 0.1 * s, { fill = "ink", back = depth }),
			ellipse(x, mouthY, 0.17 * s, 0.13 * s, { fill = "ink", back = depth, clip = { x - 0.1 * s, mouthY, x + 0.1 * s, mouthY + 0.08 * s } }),
			ellipse(x - 0.16 * s, y + 0.06 * s, 0.08 * s, 0.05 * s, { fill = CHEEK, plain = true, z = detail }),
			ellipse(x + 0.16 * s, y + 0.06 * s, 0.08 * s, 0.05 * s, { fill = CHEEK, plain = true, z = detail }),
		}
	end
	local list: { Shape } = {}
	for _, shape in face(0.66, 0.34, 0.5, true) do
		table.insert(list, shape)
	end
	for _, shape in face(0.38, 0.6, 0.54, false) do
		table.insert(list, shape)
	end
	table.insert(list, shine(0.25, 0.45, 0.1, 0.05, -40))
	table.insert(list, shine(0.55, 0.18, 0.08, 0.04, -40))
	return list
end)()

-- The icon's name, if there's a drawn icon for it.
function Icons.For(name: string): string?
	return if SHAPES[name] then name else nil
end

-- A see-through step: opaque before `at` (0-1 along the gradient), invisible after it.
local function cut(f: Frame, rotation: number, at: number)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = rotation
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(at, 0),
		NumberSequenceKeypoint.new(math.min(1, at + 0.005), 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = f
end

-- One shape as a Frame, `grow` (a share of the icon) bigger on every side, moved by `offset`.
local function frame(parent: Instance, shape: Shape, color: Color3, grow: number, z: number, offset: Vector2?): Frame
	local f = Instance.new("Frame")
	f.Name = "Shape"
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	local move = offset or Vector2.zero
	local x, y = shape.x + move.X, shape.y + move.Y
	local w, h = shape.w + grow * 2, shape.h + grow * 2
	f.Rotation = shape.rot or 0
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.ZIndex = z
	local r = shape.r or 0
	if r > 0 or grow > 0 then
		-- A corner's scale is a share of the shorter side. Grown copies (outlines, shadows) keep
		-- the same curve, and get one even on square corners, so outlines never have sharp corners.
		local short = math.min(shape.w, shape.h)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(if r >= 0.5 then 0.5 else (r * short + grow) / math.min(w, h), 0)
		corner.Parent = f
	end
	if shape.tri then
		-- only the front half of the square: a triangle
		cut(f, 225, 0.5)
	elseif shape.keepTop then
		cut(f, 90, shape.keepTop)
	end
	local clip = shape.clip
	if clip then
		-- drawn inside a box that cuts off the rest (grown copies get a grown box)
		local pad = if offset then shape.clipPad or 0 else math.max(grow, shape.clipPad or 0)
		local x0, y0 = clip[1] - pad + move.X, clip[2] - pad + move.Y
		local x1, y1 = clip[3] + pad + move.X, clip[4] + pad + move.Y
		local holder = Instance.new("Frame")
		holder.Name = "Clip"
		holder.BackgroundTransparency = 1
		holder.ClipsDescendants = true
		holder.Position = UDim2.fromScale(x0, y0)
		holder.Size = UDim2.fromScale(x1 - x0, y1 - y0)
		holder.ZIndex = z
		holder.Parent = parent
		f.Position = UDim2.fromScale((x - x0) / (x1 - x0), (y - y0) / (y1 - y0))
		f.Size = UDim2.fromScale(w / (x1 - x0), h / (y1 - y0))
		f.Parent = holder
	else
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromScale(w, h)
		f.Parent = parent
	end
	return f
end

-- How far a shape (grown by `grow`) reaches above and below its centre.
local function halfHeight(shape: Shape, grow: number): number
	local rot = math.rad(shape.rot or 0)
	return (math.abs((shape.w + grow * 2) * math.sin(rot)) + math.abs((shape.h + grow * 2) * math.cos(rot))) / 2
end

-- Paint a frame top-to-bottom with colours picked by `at(y)` (y from the top of the icon), so the
-- shading runs across every shape as one.
local function verticalGradient(f: Frame, shape: Shape, top: number, bottom: number, at: (number) -> Color3)
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	local gradient = f:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
	gradient.Rotation = 90 - (shape.rot or 0)
	gradient.Color = ColorSequence.new(at(top), at(bottom))
	gradient.Parent = f
end

-- White to grey from the top of the icon to the bottom. A coloured body shape (`base`) goes from a
-- lighter tint of its colour at the top to a deeper shade at the bottom.
local WHITE = Color3.new(1, 1, 1)
local function shade(f: Frame, shape: Shape, base: Color3?)
	local function at(y: number): Color3
		local t = math.clamp(y, 0, 1)
		if base then
			return base:Lerp(WHITE, 0.32 * (1 - t)):Lerp(BLACK, 0.16 * t)
		end
		return TOP:Lerp(BOTTOM, t)
	end
	if shape.tri or shape.keepTop then
		-- (these already use their gradient for the cut: one flat colour from their middle)
		f.BackgroundColor3 = at(shape.y)
		return
	end
	local half = halfHeight(shape, 0)
	verticalGradient(f, shape, shape.y - half, shape.y + half, at)
end

local function sample(sequence: ColorSequence, t: number): Color3
	local points = sequence.Keypoints
	t = math.clamp(t, 0, 1)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		if t <= b.Time then
			local span = b.Time - a.Time
			return a.Value:Lerp(b.Value, if span > 0 then (t - a.Time) / span else 0)
		end
	end
	return points[#points].Value
end

-- Draw an icon into a new square Frame (named "Icon") inside `parent`, placed by `layout` (or
-- position and size the returned frame yourself, like an image). `background` is the button's
-- colour. When the parent is a Theme.Button and `layout` is given, holes and shadows follow the
-- button's own top-to-bottom gradient, so holes really look see-through.
function Icons.Draw(name: string, parent: Instance, background: Color3?, layout: Layout?): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Icon"
	holder.BackgroundTransparency = 1
	holder.SizeConstraint = Enum.SizeConstraint.RelativeYY
	holder.ZIndex = 2
	-- where the icon sits on the button, in shares of the button's height (for see-through colours)
	local placeTop: number?, placeHeight: number? = nil, nil
	if layout then
		holder.Size = layout.Size
		holder.Position = layout.Position
		holder.AnchorPoint = layout.AnchorPoint or Vector2.zero
		if layout.Size.Y.Offset == 0 and layout.Position.Y.Offset == 0 then
			placeHeight = layout.Size.Y.Scale
			placeTop = layout.Position.Y.Scale - holder.AnchorPoint.Y * layout.Size.Y.Scale
		end
	end
	-- a picture instead (Config.IconImages), when there is one. The drawn icon is made too and
	-- shows until the picture has really loaded - so a picture that won't load (a decal's id, one
	-- still waiting for moderation, a deleted one) never leaves the button blank
	local image = Config.IconImages[name]
	local picture: ImageLabel? = nil
	if image ~= nil and image ~= "" then
		local p = Instance.new("ImageLabel")
		p.Name = "Picture"
		p.BackgroundTransparency = 1
		p.Image = image
		p.ScaleType = Enum.ScaleType.Fit
		p.AnchorPoint = Vector2.new(0.5, 0.5)
		p.Position = UDim2.fromScale(0.5, 0.52)
		p.Size = UDim2.fromScale(1.15, 1.15) -- (the pictures leave room round them for their outline and shadow)
		p.ZIndex = 2
		p.Visible = false
		p.Parent = holder
		picture = p
	end
	local back = background or NO_BACKGROUND
	local buttonGradient = parent:FindFirstChildOfClass("UIGradient")

	-- Frames painted with what's behind the icon (holes) or a darker copy of it (shadows)
	local painted: { { frame: Frame, shape: Shape, top: number, bottom: number, dark: number } } = {}
	local function seeThrough(f: Frame, shape: Shape, grow: number, move: Vector2?, dark: number)
		local half = halfHeight(shape, grow)
		local y = shape.y + (if move then move.Y else 0)
		table.insert(painted, { frame = f, shape = shape, top = y - half, bottom = y + half, dark = dark })
	end
	local function repaint()
		for _, entry in painted do
			if buttonGradient and placeTop and placeHeight and parent:IsA("GuiObject") then
				local tint = (parent :: GuiObject).BackgroundColor3
				local sequence = buttonGradient.Color
				local top, height = placeTop, placeHeight
				verticalGradient(entry.frame, entry.shape, entry.top, entry.bottom, function(y: number): Color3
					local c = sample(sequence, top + y * height)
					return Color3.new(c.R * tint.R, c.G * tint.G, c.B * tint.B):Lerp(BLACK, entry.dark)
				end)
			else
				entry.frame.BackgroundColor3 = back:Lerp(BLACK, entry.dark)
			end
		end
	end

	local shapes: { Shape } = SHAPES[name] or {}
	-- shadows and outlines first...
	for _, shape in shapes do
		local fill = shape.fill or "white"
		if shape.plain or fill == "ink" or fill == "shine" then
			continue
		end
		if fill == "white" then
			local outlineZ, edgeZ = depthLayers(shape.back or 0)
			seeThrough(frame(holder, shape, back, OUTLINE, Z.Shadow, SHADOW), shape, OUTLINE, SHADOW, SHADOW_DARKNESS)
			frame(holder, shape, BLACK, OUTLINE, outlineZ)
			-- the edge under it (a darker copy, a little lower), inside the same outline
			frame(holder, shape, BLACK, OUTLINE, outlineZ, EDGE)
			local base = shape.color
			frame(holder, shape, if base then base:Lerp(BLACK, 0.4) else EDGE_WHITE, 0, edgeZ, EDGE)
		elseif fill == "hole" then
			frame(holder, shape, BLACK, OUTLINE, Z.SpotOutline)
		else
			-- a coloured spot: its own (slightly thinner) outline
			local spot = OUTLINE * 0.75
			seeThrough(frame(holder, shape, back, spot, Z.Shadow, SHADOW), shape, spot, SHADOW, SHADOW_DARKNESS)
			frame(holder, shape, BLACK, spot, Z.SpotOutline)
		end
	end
	-- ...then every fill on top
	for _, shape in shapes do
		local fill = shape.fill or "white"
		local _, _, fillZ, inkZ = depthLayers(shape.back or 0)
		local z = if typeof(shape.z) == "string" then Z[shape.z] else shape.z
		if fill == "white" then
			shade(frame(holder, shape, TOP, 0, z or fillZ), shape, shape.color)
		elseif fill == "ink" then
			frame(holder, shape, BLACK, 0, z or (if shape.back then inkZ else Z.Detail))
		elseif fill == "shine" then
			local f = frame(holder, shape, TOP, 0, Z.Shine)
			f.BackgroundTransparency = 0.1
		elseif fill == "hole" then
			if not shape.outlineOnly then
				seeThrough(frame(holder, shape, back, 0, z or Z.Detail), shape, 0, nil, 0)
			end
		elseif typeof(fill) == "Color3" then
			frame(holder, shape, fill, 0, z or Z.Detail)
		end
	end
	repaint()
	if buttonGradient then
		-- the button changed colour (Theme.SetButtonColor): repaint the holes and shadows
		buttonGradient:GetPropertyChangedSignal("Color"):Connect(repaint)
	end
	holder.Parent = parent
	if picture then
		local p = picture
		local function swap(loaded: boolean)
			if not p.Parent then
				return
			end
			if loaded then
				for _, child in holder:GetChildren() do
					if child ~= p and child:IsA("GuiObject") then
						child.Visible = false
					end
				end
				p.Visible = true
			else
				p:Destroy()
			end
		end
		local function isLoaded(): boolean
			local ok, loaded = pcall(function()
				return p.IsLoaded
			end)
			return ok and loaded == true
		end
		if isLoaded() then
			swap(true)
		else
			task.spawn(function()
				local status: Enum.AssetFetchStatus? = nil
				pcall(function()
					ContentProvider:PreloadAsync({ p }, function(_, fetched: Enum.AssetFetchStatus)
						status = fetched
					end)
				end)
				swap(isLoaded() or status == Enum.AssetFetchStatus.Success)
			end)
		end
	end
	return holder
end

return Icons
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">Index</string>
              <string name="Source"><![CDATA[--[[
	Donut Index: every donut in the game, one biome at a time (the arrows on the biome's banner
	flip between biomes), laid out like the boxes they come from:

	  [ the box and its chance ]  ->  [ donut ] [ donut ] [ donut ] ...

	one row per box the biome's Domer guards, with the chance of that box and of each donut inside
	it; then two rows every biome shares: box sizes and box mutations, with their chances (and, for
	mutations, how many the whole game has found). The window's title counts the donuts you've
	found: "Index (12/88)".

	A card: the donut's name on a dark strip, the donut in 3D on studs in its box's colour (a dark
	see-through silhouette called "???" until you find it), then its rarity and chance, what it
	earns, dots for the mutations of it you've found, and its reward.

	Rewards: every donut you've found can be claimed once for cash. Epic and rarer donuts let you
	pick a permanent treadmill speed bonus instead. "Claim All" claims every reward at once: the
	speed bonus where a donut offers one (until the bonus is capped), cash for the rest.

	Global rarity scale: Legendary and rarer donuts show how many times they've spawned and been
	found in the WHOLE game (every server), and what share of all spawns that is (StatsService on
	the server keeps the counts). Each biome's banner wears its own colours and details
	(UI/IndexThemes).

	A page is built the first time you look at it, and only the last two you looked at are kept.

	Tabs down the window's right side: Donuts (this page) and Updates (the Update Log, which the
	HUD used to have its own button for). Index.SetUpdatesOpener(fn) wires Updates up.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Boxes = require(Shared.Boxes)
local BoxModel = require(Shared.BoxModel)
local Donuts = require(Shared.Donuts)
local Rarities = require(Shared.Rarities)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local DonutModel = require(Shared.DonutModel)
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Icons = require(script.Parent.Icons)
local IndexThemes = require(script.Parent.IndexThemes)
local State = require(script.Parent.Parent.State)

local Index = {}

type Card = {
	Viewport: ViewportFrame,
	Name: TextLabel,
	Info: TextLabel,
	Rarity: TextLabel,
	Global: TextLabel,
	Dots: { [string]: Frame },
	Cash: TextButton,
	Speed: TextButton?,
	Status: TextLabel,
}
type Page = {
	Frame: ScrollingFrame,
	Donuts: { string },
	Boxes: { { Label: TextLabel, Tier: Boxes.Tier } },
	Mutations: { [string]: TextLabel },
}

local WIDTH, HEIGHT = 880, 600
local CARD = Vector2.new(140, 226) -- a donut card
local HEAD, BODY = 26, 104 -- its name strip and its picture
local SMALL = Vector2.new(140, 168) -- a size or mutation card
local LEFT = 150 -- the box's panel at the start of a row
local GAP = 8
local KEEP = 2 -- pages kept built

local modal: Modal.Modal
local pages: { [number]: Page } = {}
local recent: { number } = {}
local cards: { [string]: Card } = {}
local summary: TextLabel
local claimAll: TextButton
local banner: Frame
local bannerTitle: TextLabel
local bannerInfo: TextLabel
local bannerBack: Frame
local current = 1

type Counts = { [string]: { number } }
local globalStats: { D: Counts, M: Counts }? = nil

local STRIP_TOP = Color3.fromRGB(62, 62, 62)
local STRIP_BOTTOM = Color3.fromRGB(36, 36, 36)
local ARROW = Color3.fromRGB(20, 215, 100)

-- Share of all spawns, as a readable percentage ("0.0031%")
local function percent(part: number, total: number): string
	if total <= 0 or part <= 0 then
		return "0%"
	end
	local p = part / total * 100
	return if p >= 1 then string.format("%.1f%%", p) elseif p >= 0.01 then string.format("%.2f%%", p) else string.format("%.2g%%", p)
end

local function lucky(): boolean
	local luckEndsAt = workspace:GetAttribute("LuckEndsAt")
	return type(luckEndsAt) == "number" and luckEndsAt > workspace:GetServerTimeNow()
end

-- Donuts found but not claimed yet (the HUD shows this as a badge on the Index button).
function Index.UnclaimedCount(): number
	local discovered: { [string]: boolean } = State.Data.Discovered or {}
	local claims: { [string]: string } = State.Data.IndexClaims or {}
	local count = 0
	for id in discovered do
		if Donuts.ById[id] and not claims[id] then
			count += 1
		end
	end
	return count
end

--------------------------------------------------------------------------------
-- Pieces
--------------------------------------------------------------------------------
local function label(props: { [string]: any }): TextLabel
	if props.Font == nil then
		props.Font = Theme.Font
	end
	return Theme.Label(props)
end

-- A model in a see-through viewport, looked at from the front.
local function viewport(parent: Instance, model: Model, top: number, bottom: number, size: UDim2, position: UDim2): ViewportFrame
	local view = Theme.new("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = size,
		Position = position,
		Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		ZIndex = 3,
		Parent = parent,
	})
	model.Parent = view
	local centerY = (top - bottom) / 2
	local height = top + bottom
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(Vector3.new(2.2, centerY + 1, -(height * 1.35 + 4)), Vector3.new(0, centerY, 0))
	camera.Parent = view
	view.CurrentCamera = camera
	return view
end

-- A card like the reference: the dark name strip (with two slanted marks at its left), and under
-- it a picture area on studs in `color`. Returns (card, name label, picture area).
local function cardFrame(parent: Instance, order: number, size: Vector2, color: Color3): (Frame, TextLabel, Frame)
	local card = Theme.new("Frame", {
		Name = "Card",
		BackgroundColor3 = Theme.Colors.Panel,
		Size = UDim2.fromOffset(size.X, size.Y),
		LayoutOrder = order,
		Parent = parent,
	}, {
		Theme.Corner(6),
		Theme.Stroke(2.5),
	})
	local strip = Theme.new("Frame", {
		Name = "Strip",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 0, 0, HEAD),
		ClipsDescendants = true,
		ZIndex = 2,
		Parent = card,
	}, {
		Theme.Corner(6),
		Theme.Gradient(STRIP_TOP, STRIP_BOTTOM),
	})
	for i, x in { 8, 20 } do
		Theme.new("Frame", {
			Name = "Mark" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, x, 0.5, 0),
			Size = UDim2.fromOffset(7, HEAD + 10),
			Rotation = 20,
			BackgroundColor3 = Color3.fromRGB(120, 120, 120),
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = strip,
		})
	end
	local name = label({ Name = "CardName", Text = "", Size = UDim2.new(1, -44, 1, -6), Position = UDim2.fromOffset(30, 3), StrokeThickness = 2, ZIndex = 3, Parent = strip })
	local body = Theme.new("Frame", {
		Name = "Picture",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(0, HEAD),
		Size = UDim2.new(1, 0, 0, BODY),
		ZIndex = 2,
		Parent = card,
	})
	Theme.Studs(body, Vector2.new(size.X, BODY), { Cell = 20, Transparency = 0.72, ZIndex = 2 })
	return card, name, body
end

-- The green arrow between a box and what comes out of it.
local function arrow(parent: Instance, x: number)
	local holder = Theme.new("Frame", { Name = "Arrow", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, x, 0.5, 0), Size = UDim2.fromOffset(40, 40), Parent = parent })
	Theme.new("Frame", { Name = "Shaft", BackgroundColor3 = ARROW, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 12), Size = UDim2.fromOffset(22, 16), Parent = holder }, { Theme.Stroke(2.5) })
	local tip = Theme.new("Frame", { Name = "Tip", BackgroundTransparency = 1, ClipsDescendants = true, Position = UDim2.fromOffset(18, 0), Size = UDim2.fromOffset(22, 40), Parent = holder })
	Theme.new("Frame", { BackgroundColor3 = ARROW, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 20), Size = UDim2.fromOffset(27, 27), Rotation = 45, Parent = tip }, { Theme.Stroke(2.5) })
	-- (covers the shaft's outline where it meets the tip)
	Theme.new("Frame", { BackgroundColor3 = ARROW, BorderSizePixel = 0, Position = UDim2.fromOffset(16, 13.5), Size = UDim2.fromOffset(8, 13), ZIndex = 2, Parent = holder })
end

-- One row: the box (or a title) on the left, the arrow, and the cards. Returns (left panel, cards).
local function row(page: ScrollingFrame, order: number, name: string, cell: Vector2?): (Frame, Frame)
	local frame = Theme.new("Frame", {
		Name = name,
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.08,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = page,
	}, {
		Theme.Corner(6),
		Theme.Stroke(3),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
	})
	local left = Theme.new("Frame", { Name = "Left", BackgroundTransparency = 1, Size = UDim2.new(0, LEFT, 1, 0), Parent = frame })
	arrow(frame, LEFT + 6)
	local grid = Theme.new("Frame", {
		Name = "Cards",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(LEFT + 56, 0),
		Size = UDim2.new(1, -(LEFT + 56), 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = frame,
	}, {
		Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset((cell or CARD).X, (cell or CARD).Y), CellPadding = UDim2.fromOffset(GAP, GAP), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	return left, grid
end

--------------------------------------------------------------------------------
-- Donut cards
--------------------------------------------------------------------------------
local function donutCard(grid: Instance, donut: Donuts.Donut, order: number, color: Color3)
	local rarity = Rarities.Get(donut.Rarity)
	local card, name, body = cardFrame(grid, order, CARD, color)
	card.Name = donut.Id
	local model = DonutModel.Build(donut, { NoEffects = true })
	local view = viewport(body, model, (model:GetAttribute("Top") :: number?) or 2.5, (model:GetAttribute("Bottom") :: number?) or 2.5, UDim2.fromScale(1, 1), UDim2.new())
	view.Name = "Donut"
	local foot = Theme.new("Frame", { Name = "Footer", BackgroundTransparency = 1, Position = UDim2.fromOffset(4, HEAD + BODY + 2), Size = UDim2.new(1, -8, 1, -(HEAD + BODY + 6)), Parent = card })
	local rarityLabel = label({ Name = "Rarity", Text = "", TextColor3 = rarity.Color, Size = UDim2.new(1, 0, 0, 16), StrokeThickness = 1.5, Parent = foot })
	local info = label({ Name = "Info", Text = "", TextColor3 = Theme.Colors.Money, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 17), StrokeThickness = 1.5, Parent = foot })
	local global = label({ Name = "Global", Text = "", TextColor3 = Color3.fromRGB(170, 220, 255), Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 34), StrokeThickness = 1, Parent = foot })
	-- the mutations of it you've found
	local dotRow = Theme.new("Frame", { Name = "Dots", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 10), Position = UDim2.fromOffset(0, 48), Parent = foot }, {
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local dots: { [string]: Frame } = {}
	for _, mutation in Rarities.Mutations do
		if mutation.Order > 0 then
			dots[mutation.Id] = Theme.new("Frame", { Name = mutation.Id, Size = UDim2.fromOffset(10, 10), BackgroundColor3 = mutation.Color, BackgroundTransparency = 0.75, LayoutOrder = mutation.Order, Parent = dotRow }, {
				Theme.Corner(5),
				Theme.Stroke(1.2),
			})
		end
	end
	-- its reward
	local speed = Economy.IndexSpeedReward(donut.Id)
	local cash = Theme.Button({ Name = "ClaimCash", Text = Format.Money(Economy.IndexCashReward(donut.Id)), Color = Theme.Colors.Green, Size = UDim2.new(if speed then 0.5 else 1, -2, 0, 26), Position = UDim2.new(0, 0, 1, -27), Parent = foot })
	cash.Activated:Connect(function()
		State.Action("ClaimIndex", { DonutId = donut.Id, Kind = "Cash" })
	end)
	local speedButton: TextButton? = nil
	if speed then
		local button = Theme.Button({ Name = "ClaimSpeed", Text = `+{speed}%`, Color = Theme.Colors.Purple, Size = UDim2.new(0.5, -2, 0, 26), Position = UDim2.new(0.5, 2, 1, -27), Parent = foot })
		button.Activated:Connect(function()
			State.Action("ClaimIndex", { DonutId = donut.Id, Kind = "Speed" })
		end)
		speedButton = button
	end
	local status = label({ Name = "Status", Text = "", Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -25), StrokeThickness = 1.5, Parent = foot })
	cards[donut.Id] = { Viewport = view, Name = name, Info = info, Rarity = rarityLabel, Global = global, Dots = dots, Cash = cash, Speed = speedButton, Status = status }
end

-- The left of a box's row: the box itself, its name, how often it turns up and how long it takes.
local function boxPanel(left: Frame, tier: Boxes.Tier): TextLabel
	local model = BoxModel.Build(tier.Id, "Small")
	local top = (model:GetAttribute("Top") :: number?) or 3
	local view = viewport(left, model, top, 0, UDim2.fromOffset(LEFT, 112), UDim2.fromOffset(0, 4))
	view.Name = "Box"
	label({ Name = "BoxName", Text = Format.Plain(tier.Name), Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 118), StrokeThickness = 2.5, Parent = left })
	local chance = label({ Name = "Chance", Text = "", TextColor3 = Theme.Colors.Gold, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 144), StrokeThickness = 2, Parent = left })
	label({ Name = "Opens", Text = `Opens in {Format.Duration(Boxes.HatchSeconds(tier.Id, "Small"))}`, TextColor3 = Color3.fromRGB(220, 220, 220), Size = UDim2.new(1, 0, 0, 15), Position = UDim2.fromOffset(0, 164), StrokeThickness = 1.5, Parent = left })
	return chance
end

-- "70% of boxes", with the boosted chance while a Luck Event runs.
local function boxChance(biome: number, tier: Boxes.Tier, isLucky: boolean): string
	local chance = Boxes.TierChance(biome, tier.Id)
	if chance >= 1 then
		return "Every box"
	end
	local text = `{math.floor(chance * 1000 + 0.5) / 10}% of boxes`
	if isLucky then
		text ..= ` ({math.floor(Boxes.TierChance(biome, tier.Id, Config.LuckEvent.RarityLuck) * 1000 + 0.5) / 10}% luck)`
	end
	return text
end

-- A title on the left of a row that isn't a box (sizes, mutations, crafted...).
local function titlePanel(left: Frame, title: string, detail: string, color: Color3)
	label({ Name = "Title", Text = title, TextColor3 = color, TextWrapped = true, Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 20), StrokeThickness = 2.5, Parent = left })
	label({ Name = "Detail", Text = detail, TextColor3 = Color3.fromRGB(225, 225, 225), TextWrapped = true, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 84), StrokeThickness = 1.5, Parent = left })
end

-- A smaller card for a box size or a mutation: a big word on studs, and lines under it.
local function smallCard(grid: Instance, order: number, title: string, color: Color3, big: string, lines: { string }): { TextLabel }
	local card, name, body = cardFrame(grid, order, SMALL, color)
	card.Name = title
	name.Text = title
	label({ Name = "Big", Font = Theme.Title, Text = big, Size = UDim2.new(1, -16, 0, 50), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), StrokeThickness = 3.5, ZIndex = 3, Parent = body })
	local out = {}
	for i, text in lines do
		table.insert(out, label({ Name = "Line" .. i, Text = text, TextColor3 = if i == 1 then Theme.Colors.Gold else Color3.fromRGB(225, 225, 225), Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, HEAD + BODY + 2 + (i - 1) * 18), StrokeThickness = 1.5, Parent = card }))
	end
	return out
end

--------------------------------------------------------------------------------
-- Pages
--------------------------------------------------------------------------------
local function buildPage(biome: number): Page
	local scroll = Theme.new("ScrollingFrame", {
		Name = "Biome" .. biome,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 112),
		Size = UDim2.new(1, 0, 1, -112),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Visible = false,
		Parent = modal.Body,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingRight = UDim.new(0, 14), PaddingLeft = UDim.new(0, 4), PaddingBottom = UDim.new(0, 10) }),
	})
	local page: Page = { Frame = scroll, Donuts = {}, Boxes = {}, Mutations = {} }
	local order = 0
	local function add(list: { Donuts.Donut }, grid: Frame, color: Color3)
		for i, donut in list do
			donutCard(grid, donut, i, color)
			table.insert(page.Donuts, donut.Id)
		end
	end
	-- a row for each box this biome's Domer guards
	for _, tier in Boxes.TiersFor(biome) do
		local list = Donuts.ByBox[biome] and Donuts.ByBox[biome][tier.Id]
		if list and #list > 0 then
			order += 1
			local left, grid = row(scroll, order, "Box" .. tier.Id)
			table.insert(page.Boxes, { Label = boxPanel(left, tier), Tier = tier })
			add(list, grid, tier.Color:Lerp(Color3.new(1, 1, 1), 0.2))
		end
	end
	-- donuts crafted at the Cosmic Forge (limited time), and donuts only the admin panel makes
	local crafted, extra = {}, {}
	local inBiome: { Donuts.Donut } = Donuts.ByArea[biome] or {}
	for _, donut in inBiome do
		if donut.Crafted then
			table.insert(crafted, donut)
		elseif not donut.Box then
			table.insert(extra, donut)
		end
	end
	if #crafted > 0 then
		order += 1
		local left, grid = row(scroll, order, "Crafted")
		titlePanel(left, "Cosmic Forge", "Crafted from meteor shards. Limited time!", Color3.fromRGB(200, 140, 255))
		add(crafted, grid, Color3.fromRGB(120, 70, 200))
	end
	if #extra > 0 then
		order += 1
		local left, grid = row(scroll, order, "AdminOnly")
		titlePanel(left, "Admin Only", "Only the admin panel makes these", Rarities.Get("Admin").Color)
		add(extra, grid, Color3.fromRGB(150, 150, 160))
	end
	-- box sizes (the same in every biome)
	order += 1
	local sizeLeft, sizeGrid = row(scroll, order, "Sizes", SMALL)
	titlePanel(sizeLeft, "Box Sizes", "Bigger boxes hold bigger donuts that earn more, but you carry them slower", Color3.fromRGB(255, 200, 120))
	local totalWeight = 0
	for _, size in Boxes.Sizes do
		totalWeight += size.Weight
	end
	for i, size in Boxes.Sizes do
		local donutSize = Rarities.Size(size.DonutSize)
		smallCard(sizeGrid, i, size.Name, Color3.fromRGB(150, 120, 90):Lerp(Color3.fromRGB(255, 190, 80), (i - 1) / 3), `x{donutSize.Multiplier}`, {
			percent(size.Weight, totalWeight),
			if size.CarrySpeed < 1 then `{math.floor((1 - size.CarrySpeed) * 100 + 0.5)}% slower to carry` else "Normal speed",
		})
	end
	-- box mutations: any box can be one
	order += 1
	local mutationLeft, mutationGrid = row(scroll, order, "Mutations", SMALL)
	titlePanel(mutationLeft, "Box Mutations", "Any box can come out mutated: its donut earns that many times more", Color3.fromRGB(255, 150, 230))
	for _, mutation in Rarities.Mutations do
		if mutation.Order > 0 then
			local lines = smallCard(mutationGrid, mutation.Order, mutation.Id, mutation.Color:Lerp(Color3.new(0, 0, 0), 0.15), `x{mutation.Multiplier}`, { "", "" })
			page.Mutations[mutation.Id] = lines[1]
			page.Mutations[mutation.Id .. "Found"] = lines[2]
		end
	end
	return page
end

-- Forget the pages looked at longest ago (their cards go too).
local function trim()
	while #recent > KEEP do
		local old = table.remove(recent, 1) :: number
		local page = pages[old]
		if page then
			for _, id in page.Donuts do
				cards[id] = nil
			end
			page.Frame:Destroy()
			pages[old] = nil
		end
	end
end

--------------------------------------------------------------------------------
-- Refresh
--------------------------------------------------------------------------------
local function refresh()
	local discovered: { [string]: boolean } = State.Data.Discovered or {}
	local claims: { [string]: string } = State.Data.IndexClaims or {}
	local mutations: { [string]: { [string]: boolean } } = State.Data.DiscoveredMutations or {}
	local found, claimed = 0, 0
	for id in discovered do
		if Donuts.ById[id] then
			found += 1
			if claims[id] then
				claimed += 1
			end
		end
	end
	modal:SetCount(`({found}/{#Donuts.List})`)
	local stats = globalStats
	local totalSpawns = 0
	if stats then
		for _, counts in stats.D do
			totalSpawns += counts[1] or 0
		end
	end
	-- While a Luck Event runs, show the boosted odds too (Roblox wants boosted odds shown when the
	-- boost was paid for).
	local isLucky = lucky()
	for id, card in cards do
		local donut = Donuts.ById[id]
		local rarity = Rarities.Get(donut.Rarity)
		local cash = Economy.IndexCashReward(id)
		local speed = Economy.IndexSpeedReward(id)
		local chance = if donut.Crafted then "Crafted"
			elseif not Donuts.Spawnable(donut) then "Admin only"
			else `{string.format("%.2g", Donuts.Chance(donut) * 100)}%`
		card.Rarity.Text = `{rarity.Id} • {chance}`
		local counts = stats and stats.D[id]
		if rarity.Order >= Config.GlobalStats.ShowFromRarity and Donuts.Spawnable(donut) then
			local spawned = if counts then counts[1] or 0 else 0
			local gotHome = if counts then counts[2] or 0 else 0
			card.Global.Text = if stats then `{Format.Number(spawned)} spawned ({percent(spawned, totalSpawns)}) • {Format.Number(gotHome)} found` else "loading..."
		else
			card.Global.Text = ""
		end
		for mutationId, dot in card.Dots do
			local has = mutations[id] and mutations[id][mutationId]
			dot.BackgroundTransparency = if has then 0 else 0.75
		end
		if discovered[id] then
			card.Viewport.ImageColor3 = Color3.new(1, 1, 1)
			card.Viewport.ImageTransparency = 0
			card.Name.Text = donut.Name
			card.Info.Text = `{Format.Money(donut.Income)}/s`
		else
			-- a dark silhouette you can see the studs through
			card.Viewport.ImageColor3 = Color3.new(0, 0, 0)
			card.Viewport.ImageTransparency = 0.25
			card.Name.Text = "???"
			card.Info.Text = "Not found yet"
		end
		local claimedKind = claims[id]
		local canClaim = discovered[id] and not claimedKind
		card.Cash.Visible = canClaim == true
		if card.Speed then
			card.Speed.Visible = canClaim == true
		end
		card.Status.Visible = not canClaim
		if claimedKind == "Speed" then
			card.Status.Text = `Claimed +{speed or 0}% speed`
			card.Status.TextColor3 = Color3.fromRGB(200, 160, 255)
		elseif claimedKind then
			card.Status.Text = `Claimed {Format.Money(cash)}`
			card.Status.TextColor3 = Theme.Colors.Money
		else
			card.Status.Text = if speed then `{Format.Money(cash)} or +{speed}%` else `Reward {Format.Money(cash)}`
			card.Status.TextColor3 = Color3.fromRGB(200, 200, 210)
		end
	end
	-- the box chances and the mutations on the pages that are built
	for biome, page in pages do
		for _, entry in page.Boxes do
			entry.Label.Text = boxChance(biome, entry.Tier, isLucky)
		end
		for _, mutation in Rarities.Mutations do
			local chanceLabel = page.Mutations[mutation.Id]
			local foundLabel = page.Mutations[mutation.Id .. "Found"]
			if chanceLabel and foundLabel then
				local counts = stats and stats.M[mutation.Id]
				local foundCount = if counts then counts[2] or 0 else 0
				chanceLabel.Text = if mutation.EventOnly then "Eternal Storm only"
					elseif isLucky then `{percent(mutation.Chance * Config.LuckEvent.MutationLuck, 1)} (luck)`
					else percent(mutation.Chance, 1)
				foundLabel.Text = if stats then `{Format.Number(foundCount)} found in game` else "loading..."
			end
		end
	end
	-- the banner: the biome you're looking at and how many of its donuts you've found
	local area = Areas.List[current]
	local inBiome: { Donuts.Donut } = Donuts.ByArea[current] or {}
	local foundHere = 0
	for _, donut in inBiome do
		if discovered[donut.Id] then
			foundHere += 1
		end
	end
	local escape = Economy.EscapeSpeed(current)
	bannerTitle.Text = `{current}. {string.upper(area.Name)}`
	bannerInfo.Text = `{foundHere}/{#inBiome} found  •  ` .. (if escape > 0 then `{Format.Number(escape)} Speed to escape` else "any speed escapes")
	local bonus = State.Number("IndexBonus")
	local unclaimed = Index.UnclaimedCount()
	summary.Text = `Rewards claimed {claimed}/{found}  •  Speed bonus +{bonus}%` .. (if isLucky then `  •  Luck Event: rarer boxes x{Config.LuckEvent.RarityLuck}!` else "")
	Theme.SetButtonText(claimAll, if unclaimed > 0 then `Claim All ({unclaimed})` else "Claim All")
	Theme.SetButtonColor(claimAll, if unclaimed > 0 then Theme.Colors.Green else Theme.Colors.Gray)
end

local function fetchStats()
	local ok, result = pcall(function()
		return Remotes.Function("GetGlobalStats"):InvokeServer()
	end)
	if ok and type(result) == "table" and type(result.D) == "table" and type(result.M) == "table" then
		globalStats = result
		refresh()
	end
end

-- Show a biome's page (building it if needed) and dress the banner in its colours.
local function show(biome: number)
	current = math.clamp(biome, 1, #Areas.List)
	if not pages[current] then
		pages[current] = buildPage(current)
	end
	local index = table.find(recent, current)
	if index then
		table.remove(recent, index)
	end
	table.insert(recent, current)
	trim()
	for id, page in pages do
		page.Frame.Visible = id == current
	end
	local area = Areas.List[current]
	local palette = IndexThemes.Get(area.Theme)
	local gradient = banner:FindFirstChildOfClass("UIGradient") :: UIGradient
	gradient.Color = ColorSequence.new(palette.Top, palette.Bottom)
	bannerInfo.TextColor3 = palette.Accent:Lerp(Color3.new(1, 1, 1), 0.3)
	bannerBack:ClearAllChildren()
	IndexThemes.Decorate(bannerBack, area.Theme, current * 7919)
	refresh()
end

function Index.Open()
	modal:Open()
end

-- Look at a biome's page (the arrows; tests).
function Index.Show(biome: number)
	show(biome)
end

local openUpdates: (() -> ())? = nil

-- What the Updates tab opens (init.client: the Update Log)
function Index.SetUpdatesOpener(fn: () -> ())
	openUpdates = fn
end

-- The tabs down the window's right side: a big drawn icon with its name under it, like the Shop's
local function sideTabs()
	local column = Theme.new("Frame", {
		Name = "SideTabs",
		BackgroundTransparency = 1,
		Position = UDim2.new(1, 8, 0, 62),
		Size = UDim2.fromOffset(100, 2 * 82),
		Parent = modal.Frame,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	local tabs = {
		{ Name = "Donuts", Icon = "indexBook", Caption = "Donuts" },
		{ Name = "Updates", Icon = "newsYellow", Caption = "Updates" },
	}
	for order, tab in tabs do
		local button = Theme.new("TextButton", {
			Name = tab.Name,
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(100, 80),
			LayoutOrder = order,
			Parent = column,
		}) :: TextButton
		Icons.Draw(tab.Icon, button, nil, {
			Size = UDim2.fromOffset(56, 56),
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0),
		})
		Theme.Label({
			Name = "Caption",
			Text = tab.Caption,
			-- (the page you're on: its name in gold)
			TextColor3 = if tab.Name == "Donuts" then Theme.Colors.Gold else Theme.Colors.White,
			Size = UDim2.new(1, 0, 0, 24),
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 1),
			StrokeThickness = 3,
			ZIndex = 3,
			Parent = button,
		})
		button.MouseButton1Down:Connect(function()
			Theme.Bounce(button)
		end)
		button.Activated:Connect(function()
			if tab.Name == "Updates" and openUpdates then
				modal:Close()
				openUpdates()
			end
		end)
	end
end

function Index.Init()
	modal = Modal.new("Index", Theme.Colors.Orange, Vector2.new(WIDTH, HEIGHT))
	-- (a little left of centre: the tabs stand down its right side)
	modal.Frame.Position = UDim2.new(0.5, -54, 0.52, 0)
	sideTabs()
	summary = label({ Name = "Summary", Text = "", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -200, 0, 26), Position = UDim2.fromOffset(2, 4), StrokeThickness = 2, Parent = modal.Body })
	claimAll = Theme.Button({ Name = "ClaimAll", Text = "Claim All", Color = Theme.Colors.Gray, Size = UDim2.fromOffset(186, 34), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -2, 0, 0), Parent = modal.Body })
	claimAll.Activated:Connect(function()
		if Index.UnclaimedCount() > 0 then
			State.Action("ClaimIndexAll")
		end
	end)
	-- the biome's banner: its colours and details, its name, and arrows to the others
	banner = Theme.new("Frame", {
		Name = "Banner",
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 0, 62),
		Parent = modal.Body,
	}, {
		Theme.Corner(8),
		Theme.Stroke(3),
		Theme.Gradient(Color3.new(1, 1, 1), Color3.new(1, 1, 1)),
	})
	bannerBack = Theme.new("Frame", { Name = "Backdrop", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = banner })
	Theme.Band({ Name = "Shade", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0.7, 1), Darkness = 0.45, ZIndex = 2, Parent = banner })
	bannerTitle = label({ Name = "Title", Font = Theme.Title, Text = "", Size = UDim2.new(1, -140, 0, 34), Position = UDim2.fromOffset(70, 3), StrokeThickness = 3, ZIndex = 3, Parent = banner })
	bannerInfo = label({ Name = "Info", Text = "", Size = UDim2.new(1, -140, 0, 20), Position = UDim2.fromOffset(70, 38), StrokeThickness = 2, ZIndex = 3, Parent = banner })
	for _, side in { -1, 1 } do
		local button = Theme.Button({
			Name = if side < 0 then "Previous" else "Next",
			Text = if side < 0 then "<" else ">",
			Color = Theme.Colors.Orange,
			Size = UDim2.fromOffset(48, 48),
			AnchorPoint = Vector2.new(if side < 0 then 0 else 1, 0.5),
			Position = UDim2.new(if side < 0 then 0 else 1, side * -7, 0.5, 0),
			Parent = banner,
		})
		button.ZIndex = 4
		button.Activated:Connect(function()
			local count = #Areas.List
			show((current - 1 + side) % count + 1)
		end)
	end
	modal.OnOpen = function()
		show(current)
		task.spawn(fetchStats)
	end
	-- Keep the global numbers fresh while the Index is open
	task.spawn(function()
		while true do
			task.wait(60)
			if modal:IsOpen() then
				fetchStats()
			end
		end
	end)
	State.Changed:Connect(function()
		if modal:IsOpen() then
			refresh()
		end
	end)
	State.OnAttribute("IndexBonus", function()
		if modal:IsOpen() then
			refresh()
		end
	end)
	workspace:GetAttributeChangedSignal("LuckEndsAt"):Connect(function()
		if modal:IsOpen() then
			refresh()
		end
	end)
end

return Index
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">IndexThemes</string>
              <string name="Source"><![CDATA[--[[
	IndexThemes: every biome's page section in the Donut Index (UI/Index) gets its own colour
	scheme and a background full of little details that match the biome: sprinkles in Sprinkle
	Park, waves on Frosting Falls, snow on Glacier Glaze, peppermint stripes in Candy Cane Canyon,
	a neon grid on Neon Streets, gears in the Clockwork Void, a starfield and a swirl round The
	Black Hole...

	Everything is drawn with plain UI frames - no emoji, nothing to upload. The details sit behind
	the donut cards, faded, so the cards stay easy to read.

	  Palette  - Top / Bottom: the panel's gradient; Accent: its border, header and chips;
	             Card / CardTop: the donut cards; Sky: behind the 3D donuts; Bits: detail colours
	  Pattern  - which background (see PATTERNS below); down both edges: gems, rings and
	             sparkles in the biome's colours
]]

local Theme = require(script.Parent.Theme)

local IndexThemes = {}

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)

export type Palette = {
	Top: Color3,
	Bottom: Color3,
	Accent: Color3,
	Card: Color3,
	CardTop: Color3,
	Sky: Color3,
	Bits: { Color3 },
	Pattern: string,
}

local SPRINKLES = { rgb(255, 90, 120), rgb(255, 220, 70), rgb(90, 200, 255), rgb(255, 255, 255), rgb(140, 230, 110) }

IndexThemes.Palettes = {
	Park = { Top = rgb(86, 170, 74), Bottom = rgb(34, 92, 46), Accent = rgb(255, 150, 210), Card = rgb(30, 70, 40), CardTop = rgb(52, 112, 60), Sky = rgb(150, 210, 255), Bits = SPRINKLES, Pattern = "Sprinkles" },
	Lake = { Top = rgb(80, 170, 235), Bottom = rgb(150, 70, 140), Accent = rgb(255, 180, 225), Card = rgb(40, 60, 110), CardTop = rgb(70, 100, 165), Sky = rgb(190, 225, 255), Bits = { rgb(255, 255, 255), rgb(255, 170, 215), rgb(170, 230, 255) }, Pattern = "Waves" },
	Desert = { Top = rgb(238, 196, 112), Bottom = rgb(176, 98, 46), Accent = rgb(255, 236, 170), Card = rgb(110, 62, 30), CardTop = rgb(160, 100, 52), Sky = rgb(255, 224, 170), Bits = { rgb(255, 245, 225), rgb(255, 225, 160), rgb(230, 170, 100) }, Pattern = "Dunes" },
	Jungle = { Top = rgb(40, 150, 90), Bottom = rgb(16, 66, 48), Accent = rgb(255, 210, 60), Card = rgb(18, 60, 42), CardTop = rgb(36, 104, 66), Sky = rgb(170, 230, 170), Bits = { rgb(255, 80, 100), rgb(255, 205, 50), rgb(90, 210, 100), rgb(170, 100, 255), rgb(255, 150, 50), rgb(70, 180, 255) }, Pattern = "Jellybeans" },
	Ice = { Top = rgb(150, 215, 250), Bottom = rgb(48, 100, 180), Accent = rgb(225, 245, 255), Card = rgb(36, 70, 130), CardTop = rgb(70, 120, 190), Sky = rgb(225, 240, 255), Bits = { rgb(255, 255, 255), rgb(210, 240, 255) }, Pattern = "Snow" },
	Lava = { Top = rgb(250, 120, 40), Bottom = rgb(90, 18, 18), Accent = rgb(255, 210, 90), Card = rgb(70, 22, 18), CardTop = rgb(130, 44, 26), Sky = rgb(255, 190, 140), Bits = { rgb(255, 220, 90), rgb(255, 140, 40), rgb(255, 80, 30) }, Pattern = "Embers" },
	Chocolate = { Top = rgb(130, 78, 48), Bottom = rgb(42, 22, 14), Accent = rgb(255, 190, 90), Card = rgb(52, 30, 20), CardTop = rgb(92, 56, 36), Sky = rgb(210, 170, 140), Bits = { rgb(90, 52, 32), rgb(150, 95, 60) }, Pattern = "ChocolateBar" },
	Candy = { Top = rgb(232, 60, 84), Bottom = rgb(120, 18, 44), Accent = rgb(255, 255, 255), Card = rgb(96, 18, 40), CardTop = rgb(160, 40, 70), Sky = rgb(255, 210, 225), Bits = { rgb(255, 255, 255), rgb(255, 180, 200) }, Pattern = "Peppermint" },
	Toys = { Top = rgb(70, 140, 245), Bottom = rgb(36, 50, 150), Accent = rgb(255, 215, 50), Card = rgb(34, 46, 120), CardTop = rgb(60, 90, 190), Sky = rgb(200, 225, 255), Bits = { rgb(235, 60, 60), rgb(255, 205, 50), rgb(70, 190, 90), rgb(255, 140, 40), rgb(170, 90, 230) }, Pattern = "Blocks" },
	Haunted = { Top = rgb(110, 60, 160), Bottom = rgb(24, 40, 32), Accent = rgb(150, 255, 130), Card = rgb(36, 28, 54), CardTop = rgb(70, 48, 100), Sky = rgb(170, 160, 210), Bits = { rgb(230, 240, 255), rgb(150, 255, 130) }, Pattern = "Mist" },
	Clouds = { Top = rgb(140, 200, 255), Bottom = rgb(230, 140, 200), Accent = rgb(255, 255, 255), Card = rgb(70, 90, 160), CardTop = rgb(110, 140, 215), Sky = rgb(235, 245, 255), Bits = { rgb(255, 255, 255), rgb(255, 230, 245) }, Pattern = "Clouds" },
	CyberStreets = { Top = rgb(30, 24, 70), Bottom = rgb(8, 8, 22), Accent = rgb(0, 230, 255), Card = rgb(16, 16, 40), CardTop = rgb(36, 30, 80), Sky = rgb(40, 30, 80), Bits = { rgb(0, 230, 255), rgb(255, 60, 200), rgb(255, 230, 0) }, Pattern = "NeonGrid" },
	RobotFactory = { Top = rgb(120, 126, 140), Bottom = rgb(40, 42, 50), Accent = rgb(255, 195, 0), Card = rgb(44, 46, 56), CardTop = rgb(80, 84, 98), Sky = rgb(200, 205, 215), Bits = { rgb(255, 195, 0), rgb(25, 25, 30) }, Pattern = "Hazard" },
	Clockwork = { Top = rgb(90, 64, 120), Bottom = rgb(30, 20, 40), Accent = rgb(230, 180, 80), Card = rgb(40, 28, 54), CardTop = rgb(76, 54, 96), Sky = rgb(220, 200, 170), Bits = { rgb(230, 180, 80), rgb(190, 140, 60) }, Pattern = "Gears" },
	Heaven = { Top = rgb(255, 236, 170), Bottom = rgb(200, 150, 70), Accent = rgb(255, 255, 255), Card = rgb(120, 86, 40), CardTop = rgb(180, 140, 70), Sky = rgb(255, 250, 230), Bits = { rgb(255, 255, 255), rgb(255, 240, 160) }, Pattern = "Glow" },
	Glitch = { Top = rgb(30, 10, 40), Bottom = rgb(4, 4, 8), Accent = rgb(255, 0, 220), Card = rgb(18, 8, 26), CardTop = rgb(44, 16, 60), Sky = rgb(30, 20, 40), Bits = { rgb(255, 0, 220), rgb(0, 230, 255), rgb(255, 255, 255), rgb(20, 20, 20) }, Pattern = "Pixels" },
	BlackHole = { Top = rgb(40, 20, 80), Bottom = rgb(4, 2, 12), Accent = rgb(190, 120, 255), Card = rgb(18, 10, 38), CardTop = rgb(44, 26, 84), Sky = rgb(14, 8, 30), Bits = { rgb(255, 255, 255), rgb(200, 170, 255), rgb(255, 170, 90) }, Pattern = "Space" },
} :: { [string]: Palette }

local FALLBACK: Palette = IndexThemes.Palettes.Park

function IndexThemes.Get(theme: string): Palette
	return IndexThemes.Palettes[theme] or FALLBACK
end

--------------------------------------------------------------------------------
-- Drawing helpers (positions are fractions of the panel, so details spread over all of it)
--------------------------------------------------------------------------------
type Ctx = { Parent: Instance, Rng: Random, Palette: Palette }

local function bit(ctx: Ctx): Color3
	local bits = ctx.Palette.Bits
	return bits[ctx.Rng:NextInteger(1, #bits)]
end

local function shape(ctx: Ctx, x: number, y: number, w: number, h: number, color: Color3, transparency: number, corner: number?, rotation: number?): Frame
	local frame = Theme.new("Frame", {
		Name = "Detail",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = color,
		BackgroundTransparency = transparency,
		BorderSizePixel = 0,
		Rotation = rotation or 0,
		Parent = ctx.Parent,
	})
	if corner then
		Theme.new("UICorner", { CornerRadius = UDim.new(corner, 0), Parent = frame })
	end
	return frame
end

-- A ring: a circle drawn as its outline only.
local function ring(ctx: Ctx, x: number, y: number, size: number, color: Color3, thickness: number, transparency: number): Frame
	local frame = shape(ctx, x, y, size, size, color, 1, 1)
	Theme.new("UIStroke", { Color = color, Thickness = thickness, Transparency = transparency, Parent = frame })
	return frame
end

-- A band right across the panel at height y (fraction) - for stripes and grid lines.
local function band(ctx: Ctx, y: number, height: number, color: Color3, transparency: number): Frame
	local frame = Theme.new("Frame", {
		Name = "Detail",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, y),
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = color,
		BackgroundTransparency = transparency,
		BorderSizePixel = 0,
		Parent = ctx.Parent,
	})
	return frame
end

local function column(ctx: Ctx, x: number, width: number, color: Color3, transparency: number): Frame
	return Theme.new("Frame", {
		Name = "Detail",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(x, 0),
		Size = UDim2.new(0, width, 1, 0),
		BackgroundColor3 = color,
		BackgroundTransparency = transparency,
		BorderSizePixel = 0,
		Parent = ctx.Parent,
	})
end

local function scatter(ctx: Ctx, count: number, fn: (x: number, y: number) -> ())
	for i = 1, count do
		-- (spread evenly down the panel, randomly across it)
		local y = (i - ctx.Rng:NextNumber(0.1, 0.9)) / count
		fn(ctx.Rng:NextNumber(0.02, 0.98), y)
	end
end

local PATTERNS: { [string]: (Ctx) -> () } = {
	Sprinkles = function(ctx)
		scatter(ctx, 46, function(x, y)
			shape(ctx, x, y, 5, 16, bit(ctx), 0.35, 1, ctx.Rng:NextNumber(0, 180))
		end)
	end,
	Waves = function(ctx)
		for i = 1, 7 do
			local y = i / 8
			for k = 0, 5 do
				local w = 130
				local wave = shape(ctx, (k + (i % 2) * 0.5) / 5, y, w, 34, WHITE, 1, 1)
				Theme.new("UIStroke", { Color = bit(ctx), Thickness = 3, Transparency = 0.65, Parent = wave })
			end
		end
	end,
	Dunes = function(ctx)
		for i = 1, 6 do
			shape(ctx, ctx.Rng:NextNumber(0.1, 0.9), i / 6.5, ctx.Rng:NextNumber(260, 420), 70, rgb(255, 230, 170), 0.82, 1)
		end
		scatter(ctx, 40, function(x, y)
			local s = ctx.Rng:NextNumber(3, 6)
			shape(ctx, x, y, s, s, bit(ctx), 0.4, 0.25, 45)
		end)
	end,
	Jellybeans = function(ctx)
		scatter(ctx, 30, function(x, y)
			shape(ctx, x, y, 26, 14, bit(ctx), 0.45, 1, ctx.Rng:NextNumber(-40, 40))
		end)
	end,
	Snow = function(ctx)
		scatter(ctx, 70, function(x, y)
			local s = ctx.Rng:NextNumber(3, 8)
			shape(ctx, x, y, s, s, bit(ctx), ctx.Rng:NextNumber(0.2, 0.6), 1)
		end)
	end,
	Embers = function(ctx)
		band(ctx, 1, 90, rgb(255, 120, 30), 0.75)
		scatter(ctx, 50, function(x, y)
			local s = ctx.Rng:NextNumber(3, 7)
			local ember = shape(ctx, x, y, s, s, bit(ctx), 0.15, 1)
			Theme.new("UIStroke", { Color = rgb(255, 160, 60), Thickness = 2, Transparency = 0.6, Parent = ember })
		end)
	end,
	ChocolateBar = function(ctx)
		-- a big chocolate bar's squares down the right-hand side, and chocolate chips everywhere else
		for row = 0, 11 do
			for col = 0, 1 do
				shape(ctx, 0.9 + col * 0.06, (row + 0.5) / 12, 46, 46, ctx.Palette.Bits[1], 0.55, 0.15)
			end
		end
		scatter(ctx, 26, function(x, y)
			shape(ctx, x * 0.82, y, 10, 8, ctx.Palette.Bits[2], 0.5, 0.4, ctx.Rng:NextNumber(0, 90))
		end)
	end,
	Peppermint = function(ctx)
		for i = 0, 15 do
			band(ctx, (i + 0.5) / 16, 26, WHITE, if i % 2 == 0 then 0.86 else 1)
		end
		scatter(ctx, 12, function(x, y)
			local swirl = shape(ctx, x, y, 34, 34, WHITE, 0.6, 1)
			Theme.new("UIStroke", { Color = rgb(255, 80, 100), Thickness = 4, Transparency = 0.4, Parent = swirl })
		end)
	end,
	Blocks = function(ctx)
		scatter(ctx, 26, function(x, y)
			local color = bit(ctx)
			local block = shape(ctx, x, y, 34, 26, color, 0.45, 0.12, ctx.Rng:NextNumber(-12, 12))
			for k = 0, 1 do
				local stud = Theme.new("Frame", { Name = "Stud", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.28 + k * 0.44, 0, 0, 1), Size = UDim2.fromOffset(10, 6), BackgroundColor3 = color, BackgroundTransparency = 0.45, BorderSizePixel = 0, Parent = block })
				Theme.new("UICorner", { CornerRadius = UDim.new(0.4, 0), Parent = stud })
			end
		end)
	end,
	Mist = function(ctx)
		scatter(ctx, 16, function(x, y)
			shape(ctx, x, y, ctx.Rng:NextNumber(120, 240), ctx.Rng:NextNumber(40, 80), bit(ctx), 0.9, 1)
		end)
		scatter(ctx, 20, function(x, y)
			local s = ctx.Rng:NextNumber(4, 7)
			local eye = shape(ctx, x, y, s, s, rgb(150, 255, 130), 0.35, 1)
			Theme.new("UIStroke", { Color = rgb(150, 255, 130), Thickness = 2, Transparency = 0.7, Parent = eye })
		end)
	end,
	Clouds = function(ctx)
		scatter(ctx, 14, function(x, y)
			local s = ctx.Rng:NextNumber(40, 70)
			for k = -1, 1 do
				shape(ctx, x, y, s * (if k == 0 then 1.3 else 1), s * (if k == 0 then 1 else 0.8), WHITE, 0.78, 1).Position = UDim2.new(x, k * s * 0.6, y, if k == 0 then -s * 0.15 else 0)
			end
		end)
	end,
	NeonGrid = function(ctx)
		for i = 1, 24 do
			band(ctx, i / 25, 2, ctx.Palette.Bits[(i % 2) + 1], 0.75)
		end
		for i = 1, 11 do
			column(ctx, i / 12, 2, ctx.Palette.Bits[(i % 2) + 1], 0.8)
		end
		scatter(ctx, 18, function(x, y)
			local s = ctx.Rng:NextNumber(5, 9)
			local light = shape(ctx, x, y, s, s, bit(ctx), 0.1, 1)
			Theme.new("UIStroke", { Color = light.BackgroundColor3, Thickness = 3, Transparency = 0.55, Parent = light })
		end)
	end,
	Hazard = function(ctx)
		for _, y in { 0, 1 } do
			for k = 0, 24 do
				shape(ctx, k / 24, y, 22, 22, if k % 2 == 0 then ctx.Palette.Bits[1] else ctx.Palette.Bits[2], 0.15, nil, 45)
			end
		end
		scatter(ctx, 24, function(x, y)
			local bolt = shape(ctx, x, y, 12, 12, rgb(170, 175, 190), 0.5, 1)
			Theme.new("UIStroke", { Color = rgb(60, 62, 72), Thickness = 2, Transparency = 0.5, Parent = bolt })
		end)
	end,
	Gears = function(ctx)
		scatter(ctx, 18, function(x, y)
			local s = ctx.Rng:NextNumber(40, 110)
			ring(ctx, x, y, s, bit(ctx), ctx.Rng:NextNumber(5, 9), 0.6)
			shape(ctx, x, y, s * 0.24, s * 0.24, bit(ctx), 0.55, 1)
		end)
	end,
	Glow = function(ctx)
		-- soft light pouring down from the top, and sparkles
		for i = 1, 5 do
			shape(ctx, 0.5, 0, 160 * i, 160 * i, WHITE, 0.82 + i * 0.03, 1)
		end
		scatter(ctx, 40, function(x, y)
			local s = ctx.Rng:NextNumber(4, 9)
			shape(ctx, x, y, s, s, bit(ctx), 0.25, nil, 45)
		end)
	end,
	Pixels = function(ctx)
		scatter(ctx, 50, function(x, y)
			local w, h = ctx.Rng:NextInteger(1, 5) * 8, ctx.Rng:NextInteger(1, 3) * 8
			local color = bit(ctx)
			shape(ctx, x, y, w, h, color, 0.45)
			-- (a colour-split copy next to it, like a broken screen)
			local split = shape(ctx, x, y, w, h, if color == ctx.Palette.Bits[1] then ctx.Palette.Bits[2] else ctx.Palette.Bits[1], 0.7)
			split.Position = UDim2.new(x, 4, y, 2)
		end)
		for i = 1, 6 do
			band(ctx, ctx.Rng:NextNumber(0.05, 0.95), 3, ctx.Palette.Bits[(i % 2) + 1], 0.6)
		end
	end,
	Space = function(ctx)
		scatter(ctx, 90, function(x, y)
			local s = ctx.Rng:NextNumber(2, 4)
			shape(ctx, x, y, s, s, bit(ctx), ctx.Rng:NextNumber(0, 0.5), 1)
		end)
		-- the black hole in the corner: a dark core in a glowing, tilted swirl
		type Swirl = { Size: number, Color: Color3, Transparency: number }
		local swirls: { Swirl } = {
			{ Size = 260, Color = rgb(255, 170, 90), Transparency = 0.75 },
			{ Size = 200, Color = rgb(200, 120, 255), Transparency = 0.6 },
			{ Size = 150, Color = rgb(255, 210, 150), Transparency = 0.5 },
		}
		for i, info in swirls do
			local swirl = ring(ctx, 0.88, 0.08, info.Size, info.Color, 10 - i * 2, info.Transparency)
			swirl.Size = UDim2.fromOffset(info.Size, info.Size * 0.4)
			swirl.Rotation = -14
		end
		shape(ctx, 0.88, 0.08, 90, 90, rgb(0, 0, 0), 0.05, 1)
	end,
}

-- Fill `backdrop` (a frame filling the biome's panel) with the biome's details. `seed` keeps them
-- the same every time.
function IndexThemes.Decorate(backdrop: Instance, theme: string, seed: number)
	local palette = IndexThemes.Get(theme)
	local ctx: Ctx = { Parent = backdrop, Rng = Random.new(seed), Palette = palette }
	local pattern = PATTERNS[palette.Pattern]
	if pattern then
		pattern(ctx)
	end
	-- gems, rings and sparkles down both edges (where the cards don't cover them), in the biome's
	-- colours
	for i = 1, 14 do
		local left = i % 2 == 0
		local x = if left then ctx.Rng:NextNumber(0.025, 0.065) else ctx.Rng:NextNumber(0.935, 0.975)
		local y = (i - 0.5) / 14
		local size = ctx.Rng:NextNumber(26, 40)
		local color = if i % 4 == 0 then palette.Accent else bit(ctx)
		local kind = i % 3
		if kind == 0 then
			-- a gem: a diamond with a lighter facet in it
			shape(ctx, x, y, size * 0.75, size * 0.75, color, 0.35, 0.18, 45)
			shape(ctx, x - 0.004, y - 0.004, size * 0.3, size * 0.3, color:Lerp(WHITE, 0.6), 0.3, 0.2, 45)
		elseif kind == 1 then
			-- a ring with a dot in the middle
			ring(ctx, x, y, size * 0.8, color, 4, 0.35)
			shape(ctx, x, y, size * 0.22, size * 0.22, color, 0.3, 1)
		else
			-- a sparkle: a tall and a short beam crossed, a little diamond where they meet
			local turn = ctx.Rng:NextNumber(-12, 12)
			shape(ctx, x, y, size * 0.16, size, color, 0.35, 1, turn)
			shape(ctx, x, y, size * 0.62, size * 0.14, color, 0.35, 1, turn)
			shape(ctx, x, y, size * 0.26, size * 0.26, color:Lerp(WHITE, 0.5), 0.25, 0.2, 45 + turn)
		end
	end
end

return IndexThemes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">ItemCard</string>
              <string name="Source"><![CDATA[--[[
	ItemCard: the details card that pops up when you hover a donut, pet or egg (the Update Log's
	cards use it). Like an item tooltip in other games:

	  * the name, and its rarity in the rarity's colour
	  * three stat boxes (a donut's money per second, spawn chance and area; a pet's boosts and
	    hatch chance; an egg's hatch time, pets and rarest odds)
	  * a description with the important words coloured (mutations, the egg's pets...)
	  * the real 3D model, spinning, on the right
	  * "How to get" along the bottom

	With a mouse it follows the pointer while you hover. On phones and tablets, tap a card to show
	it next to the card, and tap anywhere else to hide it.

	ItemCard.Attach(button, { Kind = "Donut" | "Pet" | "Egg", Id = "...", Note = "..."? }, onHover?)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Areas = require(Shared.Areas)
local Boxes = require(Shared.Boxes)
local Donuts = require(Shared.Donuts)
local DonutModel = require(Shared.DonutModel)
local Pets = require(Shared.Pets)
local PetModel = require(Shared.PetModel)
local Rarities = require(Shared.Rarities)
local Format = require(Shared.Format)
local Theme = require(script.Parent.Theme)

local ItemCard = {}

export type Item = { Kind: string, Id: string, Note: string? }
export type Stat = { Label: string, Value: string, Color: Color3 }
export type Info = {
	Name: string,
	Kind: string, -- "Legendary Donut", "Epic Pet", "Egg"...
	Rarity: string, -- short tag for small cards
	Color: Color3,
	Stats: { Stat },
	Lines: { string }, -- rich text
	HowTo: string,
}

local rgb = Color3.fromRGB
local WIDTH = 470
local LEFT = 304
local MONEY = rgb(110, 255, 90)
local SPEED = rgb(170, 130, 255)
local CHANCE = rgb(255, 215, 80)
local PLACE = rgb(120, 200, 255)
local MUTATIONS = { "Gold", "Diamond", "Mythic", "Divine", "Rainbow" }

-- Colour some words; dark colours (a Cosmic Egg's purple) are lightened so they read on the card
local function paint(text: string, color: Color3): string
	local brightness = color.R * 0.299 + color.G * 0.587 + color.B * 0.114
	if brightness < 0.55 then
		color = color:Lerp(Color3.new(1, 1, 1), math.clamp((0.55 - brightness) * 1.6, 0, 0.7))
	end
	return `<font color="#{color:ToHex()}">{text}</font>`
end

local function percent(chance: number): string
	if chance >= 0.01 then
		return string.format("%.3g%%", chance * 100)
	elseif chance > 0 then
		return "1 in " .. Format.Commas(math.floor(1 / chance + 0.5))
	end
	return "-"
end

local function areaName(id: number): string
	local area = Areas.Get(id)
	if not area then
		return `Biome {id}`
	end
	return `{area.Name} (biome {area.Id})`
end

-- "Sugar Dunes to Candy Cane Canyon (biomes 3-8)"
local function areaRange(from: number, to: number): string
	local a, b = Areas.Get(from), Areas.Get(to)
	if a and b then
		return `{a.Name} to {b.Name} (biomes {a.Id}-{b.Id})`
	end
	return `{areaName(from)} to {areaName(to)}`
end

-- 180 -> "3m", 90 -> "1m 30s"
local function duration(seconds: number): string
	return (string.gsub(Format.Duration(seconds), " 0s$", ""))
end

---------------------------------------------------------------------------------------------------
-- What a card says about each kind of thing
---------------------------------------------------------------------------------------------------

function ItemCard.Model(item: Item): Model?
	local ok, model = pcall(function(): Model?
		if item.Kind == "Donut" then
			local donut = Donuts.ById[item.Id]
			return if donut then DonutModel.Build(donut, { NoEffects = true }) else nil
		elseif item.Kind == "Pet" then
			local pet = Pets.ById[item.Id]
			return if pet then PetModel.BuildPet(pet, { NoEffects = true }) else nil
		elseif item.Kind == "Egg" then
			local egg = Pets.EggById[item.Id]
			return if egg then PetModel.BuildEgg(egg, { NoEffects = true }) else nil
		end
		return nil
	end)
	return if ok then model else nil
end

function ItemCard.Describe(item: Item): Info
	local info: Info
	if item.Kind == "Donut" and Donuts.ById[item.Id] then
		local donut = Donuts.ById[item.Id]
		local rarity = Rarities.Get(donut.Rarity)
		local area = Areas.Get(donut.Area)
		local spawnable = Donuts.Spawnable(donut)
		local box = if donut.Box then Boxes.Tier(donut.Box) else nil
		local mutations = {}
		for _, id in MUTATIONS do
			local mutation = Rarities.Mutation(id)
			table.insert(mutations, paint(`{id} x{mutation.Multiplier}`, mutation.Color))
		end
		info = {
			Name = donut.Name,
			Kind = `{donut.Rarity} Donut`,
			Rarity = donut.Rarity,
			Color = rarity.Color,
			Stats = {
				{ Label = "Money", Value = `{Format.Money(donut.Income)}/s`, Color = MONEY },
				{ Label = "Box chance", Value = if spawnable then percent(Donuts.Chance(donut)) elseif donut.Crafted then "Crafted" else "Admin only", Color = CHANCE },
				{ Label = "Biome", Value = tostring(donut.Area), Color = PLACE },
			},
			Lines = if donut.Crafted
				then {
					`Never comes out of a box: bring {Config.CosmicDonut.ShardCost} {paint("meteor shards", rgb(200, 130, 255))} to the {paint("Cosmic Forge", rgb(200, 130, 255))} by the spawn to craft it.`,
					`The meteor crashes down 45 seconds into the {paint("Eternal Storm", rgb(170, 90, 255))}. {paint("LIMITED TIME!", rgb(255, 120, 220))}`,
				}
				elseif spawnable and box
				then {
					`Comes out of a {paint(box.Name, box.Color)} from {paint(if area then area.Name else "the lane", if area then area.Trim else PLACE)}. Steal one before {paint(Config.Guard.Name, rgb(255, 90, 90))} wakes up!`,
					`Can come as {table.concat(mutations, ", ")} for more money.`,
				}
				else {
					`Never comes out of a box: only the {paint("admin panel", rarity.Color)} can make one.`,
					`Can come as {table.concat(mutations, ", ")} for more money.`,
				},
			HowTo = if donut.Crafted then "Cosmic Forge (limited)" elseif spawnable and box then `{box.Name}, {areaName(donut.Area)}` else "Admin panel only",
		}
	elseif item.Kind == "Pet" and Pets.ById[item.Id] then
		local pet = Pets.ById[item.Id]
		local rarity = Pets.Rarity(pet.Rarity)
		local egg = Pets.EggOf(pet.Id)
		local chance = if egg then Pets.Chance(egg, pet.Id) else 0
		info = {
			Name = pet.Name,
			Kind = `{pet.Rarity} Pet`,
			Rarity = pet.Rarity,
			Color = rarity.Color,
			Stats = {
				{ Label = "Money", Value = `+{math.floor(pet.Money * 100 + 0.5)}%`, Color = MONEY },
				{ Label = "Speed", Value = `+{math.floor(pet.Speed * 100 + 0.5)}%`, Color = SPEED },
				{ Label = "Hatch chance", Value = if egg then percent(chance) else "-", Color = CHANCE },
			},
			Lines = {
				`Follows you around and gives {paint(Pets.BonusText(pet), MONEY)}.`,
				if egg then `Hatches from the {paint(egg.Name, egg.Color)} ({percent(chance)} chance).` else `A rare find: {paint(pet.Exclusive or "special", CHANCE)} only.`,
			},
			HowTo = if pet.Exclusive then `From the {pet.Exclusive}` elseif egg then `Hatch it from a {egg.Name}` else "Special pet",
		}
	elseif item.Kind == "Egg" and Pets.EggById[item.Id] then
		local egg = Pets.EggById[item.Id]
		local odds = {}
		for _, entry in egg.Pool do
			local pet = Pets.ById[entry.Pet]
			if pet then
				table.insert(odds, `{paint(pet.Name, Pets.Rarity(pet.Rarity).Color)} {percent(Pets.Chance(egg, pet.Id))}`)
			end
		end
		local last = egg.Pool[#egg.Pool]
		info = {
			Name = egg.Name,
			Kind = `Tier {egg.Tier} Egg`,
			Rarity = "Egg",
			Color = egg.Color,
			Stats = {
				{ Label = "Hatch time", Value = duration(egg.HatchSeconds), Color = PLACE },
				{ Label = "Pets inside", Value = tostring(#egg.Pool), Color = MONEY },
				{ Label = "Rarest pet", Value = if last then percent(Pets.Chance(egg, last.Pet)) else "-", Color = CHANCE },
			},
			Lines = {
				`Bring it to your incubator to hatch one of: {table.concat(odds, ", ")}.`,
			},
			HowTo = if egg.CrateOnly then "Only found in crates" else `Grab one in the lane, from {areaRange(egg.MinArea, egg.MaxArea)}`,
		}
	else
		info = { Name = item.Id, Kind = item.Kind, Rarity = "", Color = Theme.Colors.Gray, Stats = {}, Lines = {}, HowTo = "" }
	end
	if item.Note then
		table.insert(info.Lines, 1, paint(item.Note, rgb(255, 235, 140)))
	end
	return info
end

---------------------------------------------------------------------------------------------------
-- The floating card
---------------------------------------------------------------------------------------------------
local gui: ScreenGui? = nil
local card: Frame
local nameLabel: TextLabel
local kindLabel: TextLabel
local statBoxes: { Frame } = {}
local description: TextLabel
local howTo: TextLabel
local viewport: ViewportFrame
local camera: Camera
local cardGradient: UIGradient
local cardStroke: UIStroke

local current: GuiObject? = nil
local currentHover: ((boolean) -> ())? = nil
local pinned = false
local models: { [string]: Model } = {}
local shownModel: Model? = nil
local distance = 10

local function text(props: { [string]: any }): TextLabel
	props.Font = props.Font or Theme.Font
	props.TextScaled = false
	props.TextWrapped = true
	props.AutomaticSize = props.AutomaticSize or Enum.AutomaticSize.Y
	return Theme.Label(props)
end

local function build()
	local screen = Theme.ScreenGui("ItemCard", 40)
	gui = screen
	card = Theme.new("Frame", {
		Name = "Card",
		Size = UDim2.fromOffset(WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		Parent = screen,
	}, {
		Theme.Corner(12),
		Theme.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	cardGradient = Theme.new("UIGradient", { Rotation = 90, Parent = card })
	cardStroke = Theme.Stroke(3)
	cardStroke.Parent = card
	Theme.AutoScale(card)

	local top = Theme.new("Frame", { Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
	local left = Theme.new("Frame", {
		Name = "Info",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(LEFT, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = top,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12) }),
	})
	nameLabel = text({ Name = "ItemName", Font = Theme.Title, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -4, 0, 0), StrokeThickness = 2.5, LayoutOrder = 1, Parent = left })
	kindLabel = text({ Name = "Kind", TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -4, 0, 0), StrokeThickness = 2, LayoutOrder = 2, Parent = left })
	local stats = Theme.new("Frame", { Name = "Stats", BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 54), LayoutOrder = 3, Parent = left }, {
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i = 1, 3 do
		local box = Theme.new("Frame", {
			Name = "Stat" .. i,
			Size = UDim2.new(1 / 3, -4, 1, 0),
			BackgroundColor3 = rgb(12, 11, 20),
			LayoutOrder = i,
			Parent = stats,
		}, { Theme.Corner(8), Theme.Stroke(2, rgb(60, 58, 80)) })
		-- (same size in every box: long labels shrink, short ones don't blow up)
		local label = Theme.Label({ Name = "Label", Font = Theme.Font, TextColor3 = rgb(185, 180, 205), Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 4), StrokeThickness = 1.2, Parent = box })
		Theme.new("UITextSizeConstraint", { MaxTextSize = 14, Parent = label })
		local value = Theme.Label({ Name = "Value", Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 22), StrokeThickness = 2, Parent = box })
		Theme.new("UITextSizeConstraint", { MaxTextSize = 24, Parent = value })
		statBoxes[i] = box
	end
	local descBox = Theme.new("Frame", {
		Name = "Description",
		BackgroundColor3 = rgb(10, 9, 17),
		BackgroundTransparency = 0.15,
		Size = UDim2.new(1, -4, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 4,
		Parent = left,
	}, { Theme.Corner(8), Theme.Stroke(2, rgb(60, 58, 80)), Theme.Padding(8) })
	description = text({ Name = "Text", RichText = true, TextSize = 16, LineHeight = 1.05, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(1, 0), StrokeThickness = 1.5, Parent = descBox })

	viewport = Theme.new("ViewportFrame", {
		Name = "Model",
		BackgroundTransparency = 1,
		Ambient = rgb(190, 185, 205),
		LightColor = rgb(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		Position = UDim2.fromOffset(LEFT + 6, 8),
		Size = UDim2.fromOffset(WIDTH - LEFT - 14, 150),
		Parent = top,
	})
	camera = Instance.new("Camera")
	camera.FieldOfView = 38
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local bar = Theme.new("Frame", {
		Name = "HowTo",
		BackgroundColor3 = rgb(30, 28, 44),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = card,
	}, { Theme.Corner(10), Theme.new("UIPadding", { PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })
	howTo = text({ Name = "Text", RichText = true, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromScale(1, 0), StrokeThickness = 1.5, Parent = bar })
end

-- Is this GUI object actually on screen (it and every parent visible)?
local function onScreen(object: Instance): boolean
	local node: Instance? = object
	while node do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		elseif node:IsA("LayerCollector") then
			return node.Enabled
		end
		node = node.Parent
	end
	return false
end

local function lastInputWasTouch(): boolean
	local ok, kind = pcall(function()
		return UserInputService:GetLastInputType()
	end)
	if ok and kind then
		return kind == Enum.UserInputType.Touch
	end
	return Theme.IsTouch
end

local function guiInset(): Vector2
	local ok, inset = pcall(function()
		return GuiService:GetGuiInset()
	end)
	return if ok and typeof(inset) == "Vector2" then inset else Vector2.zero
end

local function keyOf(item: Item): string
	return item.Kind .. ":" .. item.Id
end

local function show(target: GuiObject, item: Item, pin: boolean, onHover: ((boolean) -> ())?)
	if not gui then
		build()
	end
	if currentHover and current ~= target then
		currentHover(false)
	end
	current = target
	currentHover = onHover
	pinned = pin
	local info = ItemCard.Describe(item)
	nameLabel.Text = info.Name
	kindLabel.Text = info.Kind
	kindLabel.TextColor3 = Theme.Lighten(info.Color, 0.15)
	cardGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Darken(info.Color, 0.62)),
		ColorSequenceKeypoint.new(0.35, rgb(22, 20, 34)),
		ColorSequenceKeypoint.new(1, rgb(16, 15, 26)),
	})
	cardStroke.Color = Theme.Darken(info.Color, 0.25)
	for i, box in statBoxes do
		local stat = info.Stats[i]
		box.Visible = stat ~= nil
		if stat then
			(box:FindFirstChild("Label") :: TextLabel).Text = stat.Label
			local value = box:FindFirstChild("Value") :: TextLabel
			value.Text = stat.Value
			value.TextColor3 = stat.Color
		end
	end
	description.Text = table.concat(info.Lines, "\n")
	howTo.Text = `<font color="#FFD25A">How to get:</font> {info.HowTo}`

	-- the model (built once per item, then kept)
	if shownModel then
		shownModel.Parent = nil
		shownModel = nil
	end
	local key = keyOf(item)
	local model = models[key]
	if not model then
		local built = ItemCard.Model(item)
		if built then
			local box = built:GetBoundingBox()
			built:PivotTo(built:GetPivot() - box.Position)
			models[key] = built
			model = built
		end
	end
	if model then
		local _, size = model:GetBoundingBox()
		distance = math.max(size.X, size.Y, size.Z) * 1.9
		model.Parent = viewport
		shownModel = model
	end
	card.Visible = true
end

function ItemCard.Hide()
	if gui then
		card.Visible = false
	end
	local hover = currentHover
	current = nil
	currentHover = nil
	pinned = false
	if hover then
		hover(false)
	end
end

function ItemCard.IsShowing(): boolean
	return gui ~= nil and card.Visible
end

function ItemCard.Attach(target: GuiButton, item: Item, onHover: ((boolean) -> ())?)
	target.MouseEnter:Connect(function()
		if lastInputWasTouch() then
			return -- phones: tap instead (Activated)
		end
		show(target, item, false, onHover)
		if onHover then
			onHover(true)
		end
	end)
	target.MouseLeave:Connect(function()
		if current == target and not pinned then
			ItemCard.Hide()
		elseif onHover then
			onHover(false)
		end
	end)
	target.Activated:Connect(function()
		if not lastInputWasTouch() then
			return
		end
		if current == target and pinned then
			ItemCard.Hide()
		else
			show(target, item, true, onHover)
			if onHover then
				onHover(true)
			end
		end
	end)
end

local started = false
function ItemCard.Init()
	if started then
		return
	end
	started = true
	-- A tap anywhere but the card's button hides a pinned card
	UserInputService.InputBegan:Connect(function(input: InputObject)
		local target = current
		if not pinned or not target or input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local at = Vector2.new(input.Position.X, input.Position.Y)
		local from, size = target.AbsolutePosition, target.AbsoluteSize
		if at.X < from.X or at.Y < from.Y or at.X > from.X + size.X or at.Y > from.Y + size.Y then
			ItemCard.Hide()
		end
	end)
	RunService.RenderStepped:Connect(function()
		if not gui or not card.Visible then
			return
		end
		local target = current
		if not target or not onScreen(target) then
			ItemCard.Hide()
			return
		end
		local t = os.clock()
		camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(t * 0.9) * distance, distance * 0.2, -math.cos(t * 0.9) * distance), Vector3.zero)

		-- Next to the pointer (or next to the tapped card), kept on screen
		local screenGui = gui :: ScreenGui
		local screen = screenGui.AbsoluteSize
		local size = card.AbsoluteSize
		local x, y
		if pinned then
			local from, targetSize = target.AbsolutePosition, target.AbsoluteSize
			x = from.X + targetSize.X + 10
			if x + size.X > screen.X - 6 then
				x = from.X - size.X - 10
			end
			y = from.Y
		else
			local mouse = UserInputService:GetMouseLocation() - guiInset()
			-- (MouseLeave doesn't always fire, e.g. when the list scrolls under the pointer)
			local from, targetSize = target.AbsolutePosition, target.AbsoluteSize
			if mouse.X < from.X or mouse.Y < from.Y or mouse.X > from.X + targetSize.X or mouse.Y > from.Y + targetSize.Y then
				ItemCard.Hide()
				return
			end
			x = mouse.X + 18
			if x + size.X > screen.X - 6 then
				x = mouse.X - size.X - 18
			end
			y = mouse.Y + 12
		end
		x = math.clamp(x, 6, math.max(6, screen.X - size.X - 6))
		y = math.clamp(y, 6, math.max(6, screen.Y - size.Y - 6))
		card.Position = UDim2.fromOffset(x, y)
	end)
end

return ItemCard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">Leaderboards</string>
              <string name="Source"><![CDATA[--[[
	Leaderboards: the physical boards next to the shop (scrollable, top 500). Leaderboards.Open()
	shows the same data in a full-screen window; nothing on the HUD opens it any more (the Top 500
	button was removed), but it's kept so a button can be added back in one line.
	The donation board starts with a pinned row (a crown instead of a rank, with a note under the name).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local VirtualList = require(script.Parent.VirtualList)

local Leaderboards = {}

local player = Players.LocalPlayer :: Player

type Entry = { Rank: number, UserId: number, Name: string, Display: string, Color: Color3?, Score: number? }
type BoardData = { Entries: { Entry }, UpdatedAt: number, Live: boolean }

local boardConfigs: { [string]: { Id: string, Title: string, Subtitle: string, Color: Color3 } } = {}
for _, board in Config.Leaderboards.Boards do
	boardConfigs[board.Id] = board
end

local data: { [string]: BoardData } = {}
local listeners: { [string]: { (BoardData) -> () } } = {}

local RANK_COLORS = { Color3.fromRGB(255, 215, 0), Color3.fromRGB(210, 220, 235), Color3.fromRGB(215, 140, 70) }

local function fetch(boardId: string)
	local ok, result = pcall(function()
		return Remotes.Function("GetLeaderboard"):InvokeServer(boardId)
	end)
	if ok and type(result) == "table" then
		data[boardId] = result
		local callbacks: { (BoardData) -> () } = listeners[boardId] or {}
		for _, callback in callbacks do
			task.spawn(callback, result)
		end
	end
end

local function listen(boardId: string, callback: (BoardData) -> ())
	listeners[boardId] = listeners[boardId] or {}
	table.insert(listeners[boardId], callback)
	if data[boardId] then
		callback(data[boardId])
	end
end

-- Builds a scrolling list inside `parent`. Returns a function to feed it a board.
local function makeList(parent: Instance, rowHeight: number, textScale: number, accent: Color3): (BoardData) -> ()
	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = math.floor(10 * textScale),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	})
	local function buildRow(): GuiObject
		local row = Theme.new("Frame", { Size = UDim2.new(1, -math.floor(14 * textScale), 0, rowHeight - 4), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0.93 }, { Theme.Corner(6) })
		Theme.Label({ Name = "Rank", Font = Theme.Title, Size = UDim2.new(0.16, 0, 0.8, 0), Position = UDim2.fromScale(0.01, 0.1), StrokeThickness = 2 * textScale, Parent = row })
		Theme.Label({ Name = "PlayerName", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.45, 0, 0.75, 0), Position = UDim2.fromScale(0.18, 0.125), StrokeThickness = 1.5 * textScale, Parent = row })
		Theme.Label({ Name = "Value", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.35, 0, 0.75, 0), Position = UDim2.fromScale(0.63, 0.125), StrokeThickness = 1.5 * textScale, Parent = row })
		return row
	end
	local function bindRow(row: GuiObject, entry: Entry)
		local rank = row:FindFirstChild("Rank") :: TextLabel
		local name = row:FindFirstChild("PlayerName") :: TextLabel
		local value = row:FindFirstChild("Value") :: TextLabel
		rank.Text = "#" .. entry.Rank
		rank.TextColor3 = RANK_COLORS[entry.Rank] or Color3.fromRGB(230, 230, 230)
		name.Text = entry.Name
		value.Text = entry.Display
		value.TextColor3 = entry.Color or accent:Lerp(Color3.new(1, 1, 1), 0.35)
		local isMe = entry.UserId == player.UserId
		row.BackgroundColor3 = if isMe then Theme.Colors.Yellow else Color3.new(1, 1, 1)
		row.BackgroundTransparency = if isMe then 0.6 else (if entry.Rank % 2 == 0 then 0.96 else 0.9)
	end
	local list = VirtualList.new(scroll, rowHeight, buildRow, bindRow :: any)
	return function(board: BoardData)
		list:SetEntries(board.Entries)
	end
end

local function findMe(board: BoardData): Entry?
	for _, entry in board.Entries do
		if entry.UserId == player.UserId then
			return entry
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Physical boards next to the shop
--------------------------------------------------------------------------------
local function buildWorldBoard(screen: BasePart, boardId: string)
	local cfg = boardConfigs[boardId]
	if not cfg then
		return
	end
	local surface = Theme.new("SurfaceGui", {
		Name = "Board_" .. boardId,
		Adornee = screen,
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		-- (the same picture on a smaller board: a screen narrower than the full 28 studs gets more pixels per stud)
		PixelsPerStud = 25 * 28 / math.max(screen.Size.X, 1),
		LightInfluence = 0,
		ResetOnSpawn = false,
		Parent = Theme.PlayerGui(),
	})
	local root = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(20, 20, 32), Parent = surface }, { Theme.Padding(14) })
	local header = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = cfg.Color, Parent = root }, {
		Theme.Corner(14),
		Theme.Gradient(Theme.Lighten(cfg.Color, 0.2), Theme.Darken(cfg.Color, 0.15)),
	})
	Theme.Label({ Text = cfg.Title, Size = UDim2.new(1, -20, 0, 64), Position = UDim2.fromOffset(10, 6), StrokeThickness = 4, Parent = header })
	Theme.Label({ Text = `{cfg.Subtitle} • TOP {Config.Leaderboards.Size}`, Font = Theme.Font, Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 70), StrokeThickness = 2, Parent = header })
	local listHolder = Theme.new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 122), Size = UDim2.new(1, 0, 1, -178), Parent = root })
	local footer = Theme.Label({ Text = "Loading...", Font = Theme.Font, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 1, -44), TextColor3 = Theme.Colors.Yellow, StrokeThickness = 2, Parent = root })
	local feed = makeList(listHolder, 52, 2, cfg.Color)
	listen(boardId, function(board)
		feed(board)
		local me = findMe(board)
		if #board.Entries == 0 then
			footer.Text = "No scores yet - be the first!"
		elseif me then
			footer.Text = `You are #{me.Rank}! • scroll for more`
		else
			footer.Text = if board.Live then "Showing this server (global board loading...)" else "Scroll to see the top " .. Config.Leaderboards.Size
		end
	end)
end

--------------------------------------------------------------------------------
-- Full-screen window
--------------------------------------------------------------------------------
local modal: Modal.Modal

local function buildModal()
	modal = Modal.new("Top 500", Theme.Colors.Orange, Vector2.new(640, 540))
	local body = modal.Body
	local current = Config.Leaderboards.Boards[1].Id
	local subtitle = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 50), StrokeThickness = 1.5, Parent = body })
	local listHolder = Theme.new("Frame", { BackgroundColor3 = Color3.fromRGB(20, 20, 32), Position = UDim2.fromOffset(0, 80), Size = UDim2.new(1, 0, 1, -120), Parent = body }, { Theme.Corner(12), Theme.Padding(6) })
	local footer = Theme.Label({ Text = "", Font = Theme.Font, TextColor3 = Theme.Colors.Yellow, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 1, -32), StrokeThickness = 1.5, Parent = body })
	local feeds: { [string]: (BoardData) -> () } = {}
	local holders: { [string]: Frame } = {}

	local function show(boardId: string)
		current = boardId
		for id, holder in holders do
			holder.Visible = id == boardId
		end
		local cfg = boardConfigs[boardId]
		subtitle.Text = cfg.Subtitle
		local board = data[boardId]
		local me = board and findMe(board)
		footer.Text = if me then `Your rank: #{me.Rank}` else "Keep playing to reach the top 500!"
	end

	for _, cfg in Config.Leaderboards.Boards do
		local holder = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = listHolder })
		holders[cfg.Id] = holder
		feeds[cfg.Id] = makeList(holder, 40, 1, cfg.Color)
		listen(cfg.Id, function(board)
			feeds[cfg.Id](board)
			if current == cfg.Id then
				show(cfg.Id)
			end
		end)
	end

	local tabs = {}
	for _, cfg in Config.Leaderboards.Boards do
		table.insert(tabs, { Name = cfg.Id, Text = cfg.Id, Color = cfg.Color })
	end
	local selectTab = Modal.Tabs(body, tabs, show)
	modal.OnOpen = function()
		selectTab(current)
		task.spawn(fetch, current)
	end
end

function Leaderboards.Open()
	modal:Open()
end

function Leaderboards.Init()
	buildModal()

	task.spawn(function()
		local map = workspace:WaitForChild("Map")
		local folder = map:WaitForChild("Hub"):WaitForChild("Leaderboards")
		for _, cfg in Config.Leaderboards.Boards do
			local board = folder:WaitForChild("Board_" .. cfg.Id, 30)
			local screen = board and board:WaitForChild("Screen", 30)
			if screen and screen:IsA("BasePart") then
				buildWorldBoard(screen, cfg.Id)
			end
		end
	end)

	Remotes.Event("LeaderboardUpdated").OnClientEvent:Connect(function(boardId: string)
		task.wait(math.random() * 3) -- spread requests from many clients
		fetch(boardId)
	end)

	task.spawn(function()
		task.wait(3)
		while true do
			for _, cfg in Config.Leaderboards.Boards do
				fetch(cfg.Id)
				task.wait(1)
			end
			task.wait(60)
		end
	end)
end

return Leaderboards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">Modal</string>
              <string name="Source"><![CDATA[--[[
	Modal: a centred pop-up window (Shop, Index, Leaderboards...). Only one is open at a time.

	Every window looks the same: an orange header with the stud pattern and two streaks of light,
	its title in big white outlined letters (and a gold count after it, SetCount: "Index (12/88)"),
	a red X, and a dark green body with faint studs. (The studs are drawn the first time the window
	opens, so windows nobody opens cost nothing.) A window can pick other colours (Modal.Style):
	Daily Rewards is dark grey all over.
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Modal = {}
Modal.__index = Modal

export type Modal = {
	Style: Style,
	Frame: Frame,
	Body: Frame,
	Title: TextLabel,
	Count: TextLabel,
	Size: Vector2,
	Studded: boolean,
	OnOpen: (() -> ())?,
	OnClose: (() -> ())?,
	Open: (self: Modal) -> (),
	Close: (self: Modal) -> (),
	Toggle: (self: Modal) -> (),
	IsOpen: (self: Modal) -> boolean,
	SetCount: (self: Modal, text: string?) -> (),
}

local HEADER = 58

-- Other colours for a window (anything left out stays as usual).
export type Style = {
	HeaderTop: Color3?,
	HeaderBottom: Color3?,
	HeaderStuds: Color3?,
	BodyTop: Color3?,
	BodyBottom: Color3?,
}

local gui: ScreenGui? = nil
local current: Modal? = nil

local function getGui(): ScreenGui
	if not gui then
		gui = Theme.ScreenGui("Modals", 10)
	end
	return gui :: ScreenGui
end

-- (`_color` is from before every window had the same orange header.)
function Modal.new(title: string, _color: Color3, size: Vector2, style: Style?): Modal
	local look: Style = style or {}
	local headerBottom = look.HeaderBottom or Theme.Colors.HeaderBottom
	local holder = Theme.new("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		Parent = getGui(),
	}, {
		Theme.Corner(12),
		Theme.Stroke(4),
		Theme.Gradient(look.BodyTop or Theme.Colors.Window, look.BodyBottom or Theme.Colors.WindowDark),
	})
	Theme.AutoScale(holder) -- (only one UIScale per object works, so the open "pop" tweens this one too)

	local header = Theme.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HEADER),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Parent = holder,
	}, {
		Theme.Corner(12),
		Theme.Gradient(look.HeaderTop or Theme.Colors.HeaderTop, headerBottom),
	})
	-- Square off the header's bottom corners, with a dark line under it
	Theme.new("Frame", { Name = "Square", Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -14), BackgroundColor3 = headerBottom, BorderSizePixel = 0, Parent = header })
	Theme.new("Frame", { Name = "Line", Size = UDim2.new(1, 0, 0, 4), Position = UDim2.fromOffset(0, HEADER - 2), BackgroundColor3 = Theme.Colors.Outline, BorderSizePixel = 0, ZIndex = 3, Parent = holder })
	-- two streaks of light across it, behind the title
	for i, streak in { { X = 150, W = 26 }, { X = 188, W = 12 } } do
		Theme.new("Frame", {
			Name = "Streak" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, streak.X, 0.5, 0),
			Size = UDim2.fromOffset(streak.W, HEADER * 2),
			Rotation = 24,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = header,
		})
	end

	local titleRow = Theme.new("Frame", {
		Name = "TitleRow",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 4),
		Size = UDim2.new(1, -90, 1, -8),
		ZIndex = 3,
		Parent = header,
	}, {
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local titleLabel = Theme.Label({ Name = "Title", Text = title, TextScaled = false, TextSize = 40, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), StrokeThickness = 3.5, ZIndex = 3, LayoutOrder = 1, Parent = titleRow })
	local count = Theme.Label({ Name = "Count", Text = "", TextColor3 = Theme.Colors.Gold, TextScaled = false, TextSize = 34, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 1, 0), StrokeThickness = 3, ZIndex = 3, LayoutOrder = 2, Visible = false, Parent = titleRow })

	local close = Theme.Button({ Name = "Close", Text = "X", Color = Theme.Colors.Red, Size = UDim2.fromOffset(46, 46), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 6), Parent = header })
	close.ZIndex = 3

	local body = Theme.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, HEADER + 10),
		Size = UDim2.new(1, -28, 1, -(HEADER + 22)),
		ZIndex = 2,
		Parent = holder,
	})

	local self = setmetatable({ Style = look, Frame = holder, Body = body, Title = titleLabel, Count = count, Size = size, Studded = false, OnOpen = nil, OnClose = nil }, Modal) :: any
	close.Activated:Connect(function()
		self:Close()
	end)
	return self
end

-- "(12/88)" in gold after the title (nil: none).
function Modal.SetCount(self: Modal, text: string?)
	self.Count.Text = text or ""
	self.Count.Visible = text ~= nil and text ~= ""
end

-- The studs: on the header, and faintly on the body (the first time the window opens).
local function addStuds(self: Modal)
	if self.Studded then
		return
	end
	self.Studded = true
	local header = self.Frame:FindFirstChild("Header") :: Frame
	local headerStuds = Theme.Studs(header, Vector2.new(self.Size.X, HEADER), { Cell = 22, Color = self.Style.HeaderStuds or Color3.fromRGB(150, 70, 0), Transparency = 0.72 })
	headerStuds.ZIndex = 1
	local area = Theme.new("Frame", {
		Name = "BodyStuds",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(0, HEADER),
		Size = UDim2.new(1, 0, 1, -HEADER),
		ZIndex = 1,
		Parent = self.Frame,
	})
	Theme.Studs(area, Vector2.new(self.Size.X, self.Size.Y - HEADER), { Cell = 30, Transparency = 0.86 })
end

function Modal.Open(self: Modal)
	if current and current ~= self then
		current:Close()
	end
	current = self
	addStuds(self)
	if not self.Frame.Visible and Theme.SinceKeyPress() > 0.4 then
		Theme.PlaySound("Open") -- (opened with a button, the button's click is enough)
	end
	local scale = self.Frame:FindFirstChild("AutoScale") :: UIScale
	local target = Theme.CurrentScale()
	scale.Scale = target * 0.85
	self.Frame.Visible = true
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
	if self.OnOpen then
		task.spawn(self.OnOpen)
	end
end

function Modal.Close(self: Modal)
	local wasOpen = self.Frame.Visible
	self.Frame.Visible = false
	if current == self then
		current = nil
	end
	if wasOpen and self.OnClose then
		task.spawn(self.OnClose)
	end
end

function Modal.Toggle(self: Modal)
	if self.Frame.Visible then
		self:Close()
	else
		self:Open()
	end
end

-- Is any window open right now?
function Modal.AnyOpen(): boolean
	return current ~= nil and current.Frame.Visible
end

function Modal.IsOpen(self: Modal): boolean
	return self.Frame.Visible
end

-- Row of tab buttons; returns a function to select a tab by name.
function Modal.Tabs(parent: Instance, tabs: { { Name: string, Text: string, Color: Color3 } }, onSelect: (string) -> ()): (string) -> ()
	local bar = Theme.new("Frame", { Name = "Tabs", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = parent }, {
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local buttons: { [string]: TextButton } = {}
	local function select(name: string)
		for tabName, button in buttons do
			local tab
			for _, t in tabs do
				if t.Name == tabName then
					tab = t
				end
			end
			Theme.SetButtonColor(button, if tabName == name then tab.Color else Theme.Colors.Gray)
		end
		onSelect(name)
	end
	for i, tab in tabs do
		local button = Theme.Button({ Text = tab.Text, Color = tab.Color, Size = UDim2.new(1 / #tabs, -8, 1, 0), LayoutOrder = i, Parent = bar })
		buttons[tab.Name] = button
		button.Activated:Connect(function()
			select(tab.Name)
		end)
	end
	return select
end

return Modal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	Notifications: everything that tells you something at the top of the screen, in ONE column down
	its middle, so nothing ever lands on top of anything else. From the top:
	  * pills (Notifications.Pill): small lines that stay up a while - the Luck Event, the server
	    event, the box timer, the countdown to the next Eternal Storm, Cosmic Domer's boss bar
	  * the header: ONE big message at a time (Notifications.Banner, ShowHeader): a biome's name as
	    you walk in, announcements, a server event starting, "BOX SECURED!"... A new one fades out
	    whatever was there instead of landing on top of it. The tutorial is the header for as long
	    as it runs (SetPersistentHeader): biome names wait their turn, and anything more important
	    takes over for a few seconds, then the tutorial fades back in
	  * the chase banner (Chase: ChaseSlot)
	  * toasts (Notifications.Toast), newest first
	All of it is big outlined letters on dark bands that fade out at their ends - never a box, never
	an emoji (Format.Plain takes them out of anything the server sends).
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Format = require(Shared.Format)

local Theme = require(script.Parent.Theme)

local Notifications = {}

-- How important a header is: a less important one never replaces a more important one.
Notifications.Priority = {
	News = 1, -- a biome's name as you walk in
	Tutorial = 2,
	Announcement = 3, -- everything else
}

-- The text's colour for each kind of toast
local KIND_COLORS = {
	info = Color3.fromRGB(255, 255, 255),
	success = Color3.fromRGB(140, 255, 120),
	error = Color3.fromRGB(255, 120, 110),
	rare = Color3.fromRGB(255, 220, 90),
	event = Color3.fromRGB(255, 150, 220),
}

local KIND_SOUNDS = {
	info = "Notify",
	success = "Success",
	error = "Error",
	rare = "Rare",
	event = "Announce",
}

local WIDTH = 960 -- the column (before the screen's UI scale)
local FADE = 0.3

type Header = { Group: CanvasGroup, Priority: number, Height: number }

local column: Frame
local pills: Frame
local headerSlot: Frame
local chaseSlot: Frame
local toastHolder: Frame
local toastCounter = 0
local current: Header? = nil -- the header showing now (not the tutorial)
local persistent: Header? = nil -- the tutorial's
local persistentShown = false
local token = 0

--------------------------------------------------------------------------------
-- The header
--------------------------------------------------------------------------------
-- The slot is as tall as what's in it (nothing: it folds away, and everything under it moves up).
local function resize()
	local height = 0
	if current then
		height = current.Height
	elseif persistent and persistentShown then
		height = persistent.Height
	end
	headerSlot.Size = UDim2.new(1, 0, 0, height)
	headerSlot.Visible = height > 0
end

local function fade(header: Header, visible: boolean, after: (() -> ())?)
	local group = header.Group
	if visible then
		group.Visible = true
	end
	local tween = TweenService:Create(group, TweenInfo.new(FADE, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { GroupTransparency = if visible then 0 else 1 })
	tween:Play()
	if not visible or after then
		task.delay(FADE, function()
			if not visible and group.GroupTransparency >= 0.99 then
				group.Visible = false
			end
			if after then
				after()
			end
		end)
	end
end

local function wrap(content: GuiObject, priority: number, name: string): Header
	local height = content.Size.Y.Offset
	local group = Theme.new("CanvasGroup", {
		Name = name,
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Size = UDim2.new(1, 0, 0, height),
		Visible = false,
		Parent = headerSlot,
	})
	content.AnchorPoint = Vector2.new(0.5, 0)
	content.Position = UDim2.fromScale(0.5, 0)
	content.Parent = group
	return { Group = group, Priority = priority, Height = height }
end

-- Show `content` (a full-width frame, its height in pixels) as the header for `duration` seconds.
-- Whatever was there fades out first (the tutorial fades back in afterwards). Something less
-- important than what's showing is dropped (returns false).
function Notifications.ShowHeader(content: GuiObject, priority: number, duration: number): boolean
	local blocked = (current and current.Priority > priority) or (persistent and persistentShown and persistent.Priority > priority)
	if blocked then
		content:Destroy()
		return false
	end
	local old = current
	if old then
		fade(old, false, function()
			old.Group:Destroy()
		end)
	end
	if persistent and persistentShown then
		fade(persistent, false)
	end
	local header = wrap(content, priority, "Header")
	current = header
	resize()
	fade(header, true)
	token += 1
	local myToken = token
	task.delay(duration, function()
		if current == header and token == myToken then
			current = nil
			fade(header, false, function()
				header.Group:Destroy()
				resize()
			end)
			if persistent and persistentShown then
				fade(persistent, true)
			end
		end
	end)
	return true
end

-- The tutorial: `content` is the header whenever `shown` (under anything more important that
-- comes and goes). Always the same content: it's kept between steps.
function Notifications.SetPersistentHeader(content: GuiObject, shown: boolean)
	if not persistent or persistent.Group ~= content.Parent then
		if persistent then
			persistent.Group:Destroy()
		end
		persistent = wrap(content, Notifications.Priority.Tutorial, "Persistent")
	end
	local header = persistent :: Header
	if shown == persistentShown then
		return
	end
	persistentShown = shown
	if shown then
		if not current then
			fade(header, true)
		end
		resize()
	else
		-- (the slot folds away once it has faded out)
		fade(header, false, resize)
	end
end

-- Is something other than the tutorial in the header right now? (tests)
function Notifications.HeaderBusy(): boolean
	return current ~= nil
end

--------------------------------------------------------------------------------
-- Pills, the chase banner and toasts
--------------------------------------------------------------------------------
-- Put a small pill (a frame with its own fixed size) in the stack at the top. `order`: where in it.
function Notifications.Pill(pill: GuiObject, order: number)
	pill.LayoutOrder = order
	pill.Parent = pills
end

-- Where the chase banner goes (under the header).
function Notifications.ChaseSlot(): Frame
	return chaseSlot
end

function Notifications.Toast(text: string, kind: string?)
	local color = KIND_COLORS[kind or "info"] or KIND_COLORS.info
	toastCounter -= 1 -- newest first
	local toast = Theme.Band({ Name = "Toast", Size = UDim2.fromOffset(620, 36), LayoutOrder = toastCounter, Darkness = 0.62, Parent = toastHolder })
	local label = Theme.Label({ Name = "Text", Text = Format.Plain(text), Font = Theme.Font, TextColor3 = color, Size = UDim2.new(1, -120, 1, -6), Position = UDim2.fromOffset(60, 3), StrokeThickness = 2.5, Parent = toast })
	-- A soft chime for each kind (skipped if another sound just played, like the steal jingle)
	if Theme.SinceSound() > 0.35 then
		Theme.PlaySound(KIND_SOUNDS[kind or "info"] or "Notify")
	end

	-- Keep at most 3 toasts
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 4, #toasts do
		toasts[i]:Destroy()
	end

	task.delay(3.5, function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			task.wait(0.4)
			toast:Destroy()
		end
	end)
end

-- A big message in the header: `text` big in `color`, `subtitle` under it. Big = even bigger
-- letters ("BOX SECURED!"). Priority: Notifications.Priority (Announcement unless given).
export type BannerOptions = { Priority: number?, Big: boolean? }
function Notifications.Banner(text: string, color: Color3, duration: number?, subtitle: string?, options: BannerOptions?)
	local o: BannerOptions = options or {}
	local titleHeight = if o.Big then 66 else 50
	local height = titleHeight + (if subtitle then 34 else 0) + 14
	local banner = Theme.Band({ Name = "Banner", Size = UDim2.new(1, 0, 0, height), Darkness = 0.55 })
	local title = Theme.Label({ Name = "Title", Text = Format.Plain(text), TextColor3 = color, Size = UDim2.new(1, -180, 0, titleHeight), Position = UDim2.fromOffset(90, 6), StrokeThickness = if o.Big then 5 else 3.5, Parent = banner })
	if subtitle then
		Theme.Label({ Name = "Subtitle", Text = Format.Plain(subtitle), Font = Theme.Font, Size = UDim2.new(1, -180, 0, 28), Position = UDim2.fromOffset(90, titleHeight + 8), TextColor3 = Theme.Colors.White, StrokeThickness = 2.5, Parent = banner })
	end
	if o.Big then
		-- (it pops in)
		local scale = Theme.new("UIScale", { Scale = 0.6, Parent = title })
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	Notifications.ShowHeader(banner, o.Priority or Notifications.Priority.Announcement, duration or 3)
end

function Notifications.Init()
	local gui = Theme.ScreenGui("Notifications", 20)
	column = Theme.new("Frame", {
		Name = "Column",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.fromOffset(WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Theme.AutoScale(column)
	local function slot(name: string, order: number, padding: number): Frame
		return Theme.new("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			Parent = column,
		}, {
			Theme.new("UIListLayout", { Padding = UDim.new(0, padding), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		})
	end
	pills = slot("Pills", 1, 4)
	headerSlot = Theme.new("Frame", { Name = "HeaderSlot", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), Visible = false, LayoutOrder = 2, Parent = column })
	chaseSlot = slot("ChaseSlot", 3, 0)
	toastHolder = slot("Toasts", 4, 6)

	Remotes.Event("Notify").OnClientEvent:Connect(function(text: string, kind: string?)
		Notifications.Toast(text, kind)
	end)
	Remotes.Event("AreaAnnouncement").OnClientEvent:Connect(function(text: string, color: Color3)
		Notifications.Banner(text, color, 5)
		Theme.PlaySound("Announce")
	end)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">PassOffer</string>
              <string name="Source"><![CDATA[--[[
	PassOffer: during a player's first hour of play (Config.PassOffer), a popup offers the money
	pass once per session: a few minutes after joining, and only when they're not running with a
	donut or looking at another window.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local PassOffer = {}

local player = Players.LocalPlayer

local function findPass(): Config.GamePass?
	for _, pass in Config.GamePasses do
		if pass.Key == Config.PassOffer.PassKey then
			return pass
		end
	end
	return nil
end

local function playTime(): number
	local value = player:GetAttribute("PlayTime")
	return if type(value) == "number" then value else 0
end

function PassOffer.Init()
	local pass = findPass()
	if not pass then
		return
	end
	local offer = pass
	local modal = Modal.new("Special Offer", Theme.Colors.Green, Vector2.new(460, 340))
	local body = modal.Body
	local cash = Icons.Draw("cash", body, nil, nil)
	cash.Size = UDim2.fromOffset(66, 66)
	cash.AnchorPoint = Vector2.new(0.5, 0)
	cash.Position = UDim2.new(0.5, 0, 0, 2)
	Theme.Label({ Text = `{string.upper(offer.Name)} FOREVER!`, Font = Theme.Title, TextColor3 = Color3.fromRGB(120, 255, 120), Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 72), StrokeThickness = 3, Parent = body })
	Theme.Label({
		Text = `Every donut on your base earns {offer.Multiplier}x money - for good!`,
		Font = Theme.Font, TextScaled = false, TextSize = 20, TextWrapped = true,
		Size = UDim2.new(1, -20, 0, 56), Position = UDim2.fromOffset(10, 118), StrokeThickness = 1.5, Parent = body,
	})
	local buy = Theme.Button({ Text = `BUY  R$ {offer.SuggestedPrice}`, Color = Theme.Colors.Green, Size = UDim2.new(0.6, -6, 0, 52), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = body })
	local later = Theme.Button({ Text = "No thanks", Color = Theme.Colors.Gray, Size = UDim2.new(0.4, -6, 0, 52), AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Parent = body })
	buy.Activated:Connect(function()
		State.Action("BuyPass", offer.Key)
		modal:Close()
	end)
	later.Activated:Connect(function()
		modal:Close()
	end)
	-- Show the real price once Roblox tells us
	task.spawn(function()
		if offer.GamePassId > 0 then
			local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, offer.GamePassId, Enum.InfoType.GamePass)
			if ok and info and info.PriceInRobux then
				Theme.SetButtonText(buy, `BUY  R$ {info.PriceInRobux}`)
			end
		end
	end)

	task.spawn(function()
		task.wait(Config.PassOffer.DelaySeconds)
		-- Wait for a calm moment (not mid-chase, no other window open), for up to 10 minutes
		for _ = 1, 600 do
			if State.Data.Passes[offer.Key] or playTime() > Config.PassOffer.FirstMinutes * 60 then
				return
			end
			if player:GetAttribute("CarryingDonut") == nil and not Modal.AnyOpen() then
				modal:Open()
				return
			end
			task.wait(1)
		end
	end)
end

return PassOffer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="142">
            <Properties>
              <string name="Name">PetsWindow</string>
              <string name="Source"><![CDATA[--[[
	Pets window:
	  Eggs - the eggs in your incubator, each with a countdown, and a HATCH button when it's ready
	         (plus what's inside each egg and the chances)
	  Pets - every pet you own: equip up to Config.Pets.MaxEquipped, plus a slot from Daily Rewards (they follow you and give their
	         money / treadmill bonus), Equip Best, or release pets you don't want.
	Hatching plays a full-screen animation in a vignette: the egg drops in, wobbles and cracks three
	times as the light behind it grows, glows from inside (in the pet's colour if it's Epic or
	better), bursts in a flash of shell, and the pet pops out spinning under its rarity. Click to
	skip ahead. PetsWindow.PreviewHatch() plays one just to watch (the admin panel).
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Pets = require(Shared.Pets)
local PetModel = require(Shared.PetModel)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local PetsWindow = {}

local modal: Modal.Modal
local pages: { [string]: ScrollingFrame } = {}
local header: TextLabel
local eggCards: { [string]: { Frame: Frame, Bar: Frame, Label: TextLabel, Button: TextButton, HatchAt: number } } = {}
local currentTab = "Eggs"
local overlay: Frame
local confirmRelease: string? = nil

-- A 3D preview of a model in a ViewportFrame (the model's Top/Bottom attributes frame the camera).
-- With a `color`, it sits on studs of that colour (like the Index's pictures).
local function preview(parent: Instance, model: Model, size: UDim2, position: UDim2, color: Color3?): ViewportFrame
	local viewport = Theme.new("ViewportFrame", {
		BackgroundColor3 = Color3.fromRGB(25, 25, 40),
		Size = size,
		Position = position,
		Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.5, -1, 0.8),
		Parent = parent,
	}, { Theme.Corner(10) })
	if color then
		local picture = Theme.Picture(parent, size, position, color, Vector2.new(170, 110))
		viewport.BackgroundTransparency = 1
		viewport.Size = UDim2.fromScale(1, 1)
		viewport.Position = UDim2.new()
		viewport.ZIndex = 2
		viewport.Parent = picture
	end
	model:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(200), 0))
	model.Parent = viewport
	local top = (model:GetAttribute("Top") :: number?) or 1.5
	local bottom = (model:GetAttribute("Bottom") :: number?) or 1.5
	local centerY = (top - bottom) / 2
	local height = top + bottom
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(Vector3.new(0, centerY + height * 0.25, -(height * 1.6 + 3)), Vector3.new(0, centerY, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

local function clearPage(page: ScrollingFrame)
	for _, child in page:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function card(page: Instance, order: number, color: Color3): Frame
	return Theme.Card(page, order, color)
end

--------------------------------------------------------------------------------
-- Eggs
--------------------------------------------------------------------------------
local function refreshEggTimers()
	local now = workspace:GetServerTimeNow()
	for _, entry in eggCards do
		local left = entry.HatchAt - now
		if left <= 0 then
			entry.Label.Text = "READY!"
			entry.Label.TextColor3 = Color3.fromRGB(120, 255, 130)
			entry.Bar.Size = UDim2.fromScale(1, 1)
			entry.Button.Visible = true
		else
			entry.Label.Text = Format.Duration(left)
			entry.Label.TextColor3 = Color3.fromRGB(255, 255, 255)
			entry.Button.Visible = false
		end
	end
end

type EggData = { Uid: string, Id: string, HatchAt: number }
type PetData = { Uid: string, Id: string }

local function buildEggs()
	local page = pages.Eggs
	clearPage(page)
	table.clear(eggCards)
	local eggs: { EggData } = State.Data.Eggs or {}
	if #eggs == 0 then
		local empty = card(page, 1, Theme.Colors.Gray)
		Theme.Label({
			Text = "No eggs yet! Eggs show up in Area 4 and further. Grab one (your guard wakes up!) and bring it to your base.",
			Font = Theme.Font, Size = UDim2.new(1, -16, 1, -16), Position = UDim2.fromOffset(8, 8), StrokeThickness = 1.5, Parent = empty,
		})
	end
	for order, eggData in eggs do
		local egg = Pets.EggById[eggData.Id]
		if egg then
			local c = card(page, order, egg.Accent)
			preview(c, PetModel.BuildEgg(egg, { NoEffects = true }), UDim2.new(1, -12, 0, 92), UDim2.fromOffset(6, 8), egg.Accent:Lerp(Color3.new(1, 1, 1), 0.25))
			Theme.Label({ Text = egg.Name, TextColor3 = egg.Accent:Lerp(Color3.new(1, 1, 1), 0.4), Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 100), StrokeThickness = 2, Parent = c })
			local barBack = Theme.new("Frame", { Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 126), BackgroundColor3 = Theme.Colors.Outline, Parent = c }, { Theme.Corner(6) })
			local total = egg.HatchSeconds
			local done = math.clamp(1 - (eggData.HatchAt - workspace:GetServerTimeNow()) / total, 0, 1)
			local bar = Theme.new("Frame", { Size = UDim2.fromScale(done, 1), BackgroundColor3 = egg.Accent, Parent = barBack }, { Theme.Corner(6) })
			TweenService:Create(bar, TweenInfo.new(math.max(0, eggData.HatchAt - workspace:GetServerTimeNow()), Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) }):Play()
			local label = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -8, 1, -4), Position = UDim2.fromOffset(4, 2), StrokeThickness = 1.5, Parent = barBack })
			-- What's inside
			local odds = {}
			for _, entry in egg.Pool do
				local pet = Pets.ById[entry.Pet]
				table.insert(odds, `{pet.Name} {string.format("%.3g", Pets.Chance(egg, pet.Id) * 100)}%`)
			end
			Theme.Label({ Text = table.concat(odds, " • "), Font = Theme.Font, TextColor3 = Color3.fromRGB(200, 200, 215), Size = UDim2.new(1, -10, 0, 30), Position = UDim2.fromOffset(5, 152), StrokeThickness = 1, Parent = c })
			local hatch = Theme.Button({ Text = "HATCH!", Color = Theme.Colors.Green, Size = UDim2.new(1, -16, 0, 34), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6), Parent = c })
			hatch.Visible = false
			hatch.Activated:Connect(function()
				State.Action("HatchEgg", eggData.Uid)
			end)
			eggCards[eggData.Uid] = { Frame = c, Bar = bar, Label = label, Button = hatch, HatchAt = eggData.HatchAt }
		end
	end
	refreshEggTimers()
end

--------------------------------------------------------------------------------
-- Pets
--------------------------------------------------------------------------------
local function buildPets()
	local page = pages.Pets
	clearPage(page)
	local owned: { PetData } = State.Data.Pets or {}
	local equipped: { string } = State.Data.EquippedPets or {}
	local list = table.clone(owned)
	table.sort(list, function(a, b)
		local ea, eb = table.find(equipped, a.Uid) ~= nil, table.find(equipped, b.Uid) ~= nil
		if ea ~= eb then
			return ea
		end
		local pa, pb = Pets.ById[a.Id], Pets.ById[b.Id]
		local sa = if pa then pa.Money + pa.Speed else 0
		local sb = if pb then pb.Money + pb.Speed else 0
		return sa > sb
	end)
	if #list == 0 then
		local empty = card(page, 1, Theme.Colors.Gray)
		Theme.Label({ Text = "No pets yet! Hatch an egg to get your first pet.", Font = Theme.Font, Size = UDim2.new(1, -16, 1, -16), Position = UDim2.fromOffset(8, 8), StrokeThickness = 1.5, Parent = empty })
	end
	for order, petData in list do
		local pet = Pets.ById[petData.Id]
		if pet then
			local rarity = Pets.Rarity(pet.Rarity)
			local isEquipped = table.find(equipped, petData.Uid) ~= nil
			local c = card(page, order, if isEquipped then Theme.Colors.Green else rarity.Color)
			preview(c, PetModel.BuildPet(pet, { NoEffects = true }), UDim2.new(1, -12, 0, 92), UDim2.fromOffset(6, 8), rarity.Color:Lerp(Color3.new(1, 1, 1), 0.2))
			Theme.Label({ Text = rarity.Id, TextColor3 = rarity.Color, Font = Theme.Font, Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 100), StrokeThickness = 1.2, Parent = c })
			Theme.Label({ Text = pet.Name, Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 116), StrokeThickness = 2, Parent = c })
			Theme.Label({ Text = Pets.BonusText(pet), Font = Theme.Font, TextColor3 = Theme.Colors.Money, Size = UDim2.new(1, -8, 0, 18), Position = UDim2.fromOffset(4, 140), StrokeThickness = 1.2, Parent = c })
			local equip = Theme.Button({ Text = if isEquipped then "UNEQUIP" else "EQUIP", Color = if isEquipped then Theme.Colors.Orange else Theme.Colors.Green, Size = UDim2.new(0.72, -10, 0, 32), Position = UDim2.new(0, 6, 1, -38), Parent = c })
			equip.Activated:Connect(function()
				State.Action(if isEquipped then "UnequipPet" else "EquipPet", petData.Uid)
			end)
			local release = Theme.Button({ Text = "X", Color = Theme.Colors.Red, Size = UDim2.new(0.28, -4, 0, 32), Position = UDim2.new(0.72, -2, 1, -38), Parent = c })
			release.Activated:Connect(function()
				if confirmRelease == petData.Uid then
					confirmRelease = nil
					State.Action("ReleasePet", petData.Uid)
				else
					confirmRelease = petData.Uid
					Theme.SetButtonText(release, "SURE?")
					task.delay(3, function()
						if confirmRelease == petData.Uid then
							confirmRelease = nil
						end
						if release.Parent then
							Theme.SetButtonText(release, "X")
						end
					end)
				end
			end)
		end
	end
end

local function refreshHeader()
	local equippedIds = {}
	local pets: { PetData } = State.Data.Pets or {}
	local equipped: { string } = State.Data.EquippedPets or {}
	for _, uid in equipped do
		for _, pet in pets do
			if pet.Uid == uid then
				table.insert(equippedIds, pet.Id)
			end
		end
	end
	local money, speed = Economy.PetBonuses(equippedIds)
	if currentTab == "Eggs" then
		local capacity = Config.Pets.MaxEggs + Config.Pets.IncubatorSize.PerLevel * State.Number("IncubatorSize")
		local hatchSpeed = 1 + Config.Pets.IncubatorSpeed.PerLevel * State.Number("IncubatorSpeed")
		header.Text = `Incubator {#(State.Data.Eggs or {})}/{capacity}  •  x{Format.Multiplier(hatchSpeed)} speed  •  upgrade it in the Shop`
	else
		header.Text = `{#pets}/{Config.Pets.MaxPets} pets   •   Equipped {#equippedIds}/{Economy.MaxEquippedPets(State.Data.ExtraPetSlots)}: +{math.floor(money * 100 + 0.5)}% money, +{math.floor(speed * 100 + 0.5)}% speed`
	end
end

local function refresh()
	refreshHeader()
	if currentTab == "Eggs" then
		buildEggs()
	else
		buildPets()
	end
end

-- How many eggs are ready to hatch (HUD badge).
function PetsWindow.ReadyEggs(): number
	local now = workspace:GetServerTimeNow()
	local count = 0
	local eggs: { EggData } = State.Data.Eggs or {}
	for _, egg in eggs do
		if egg.HatchAt <= now then
			count += 1
		end
	end
	return count
end

--------------------------------------------------------------------------------
-- Hatch animation
--------------------------------------------------------------------------------
-- On its own clock (seconds): the egg drops in and bounces, wobbles three times (a crack and a
-- punch-in each time, the glow behind it growing), shakes like mad while it glows from inside -
-- in the pet's rarity colour if it's Epic or better, a hint of what's coming - then bursts in a
-- flash with bits of shell flying, and the pet pops out spinning, its rarity slammed on top.
-- Click to skip ahead (to the burst, then to the end).
local HATCH = { Drop = 0.55, Wobbles = { 0.8, 1.5, 2.15 }, Wobble = 0.42, Shake = 2.65, Burst = 3.3, Title = 3.5, Hold = 6.7, Close = 7.05 }

local function smooth(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * a * (a * (a * 6 - 15) + 10)
end

-- Overshoots past 1 and settles back (for pops)
local function backOut(a: number, s: number?): number
	a = math.clamp(a, 0, 1) - 1
	local c = s or 1.7
	return 1 + (c + 1) * a * a * a + c * a * a
end

-- Pulls back a little before it goes (for closing)
local function backIn(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (2.7 * a - 1.7)
end

local function bounceOut(a: number): number
	a = math.clamp(a, 0, 1)
	if a < 1 / 2.75 then
		return 7.5625 * a * a
	elseif a < 2 / 2.75 then
		a -= 1.5 / 2.75
		return 7.5625 * a * a + 0.75
	elseif a < 2.5 / 2.75 then
		a -= 2.25 / 2.75
		return 7.5625 * a * a + 0.9375
	end
	a -= 2.625 / 2.75
	return 7.5625 * a * a + 0.984375
end

-- The cracks across the egg (x1, y1, x2, y2 in the 340x340 stage), the ones each wobble opens
local CRACKS = {
	{ { 114, 168, 134, 183 }, { 134, 183, 151, 160 }, { 151, 160, 146, 137 } },
	{ { 151, 160, 170, 185 }, { 170, 185, 188, 158 }, { 170, 185, 165, 207 } },
	{ { 188, 158, 206, 181 }, { 206, 181, 226, 165 }, { 188, 158, 196, 132 }, { 206, 181, 213, 204 } },
}

local WHITE = Color3.new(1, 1, 1)

local function crackLine(parent: Instance, x1: number, y1: number, x2: number, y2: number): Frame
	local dx, dy = x2 - x1, y2 - y1
	return Theme.new("Frame", {
		Name = "Crack",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
		Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 3, 4),
		Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = Color3.fromRGB(255, 250, 225),
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 4,
		Parent = parent,
	}, { Theme.new("UIStroke", { Thickness = 1.5, Color = Color3.fromRGB(45, 28, 22), Transparency = 0.15 }) })
end

local function circle(parent: Instance, name: string, size: Vector2, color: Color3, z: number): Frame
	return Theme.new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = color,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = parent,
	}, { Theme.new("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
end

-- Dark edges round the screen (like a film), faded in with `alpha`
local function vignette(parent: Instance): { Frame }
	local edges = {}
	for _, side in { { 0, 0, 0.27, 1, 0 }, { 1, 0, 0.27, 1, 180 }, { 0, 0, 1, 0.32, 90 }, { 0, 1, 1, 0.32, 270 } } do
		table.insert(
			edges,
			Theme.new("Frame", {
				Name = "Vignette",
				AnchorPoint = Vector2.new(side[1], side[2]),
				Position = UDim2.fromScale(side[1], side[2]),
				Size = UDim2.fromScale(side[3], side[4]),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 8,
				Parent = parent,
			}, {
				Theme.new("UIGradient", {
					Rotation = side[5],
					Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.65), NumberSequenceKeypoint.new(1, 1) }),
				}),
			})
		)
	end
	return edges
end

-- A label's text and outline, `alpha` 0 (hidden) .. 1 (shown)
local function showText(label: TextLabel, alpha: number)
	label.TextTransparency = 1 - alpha
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 1 - alpha
	end
end

local function playHatch(info: { EggId: string, PetId: string }, speed: number?)
	local egg = Pets.EggById[info.EggId]
	local pet = Pets.ById[info.PetId]
	if not egg or not pet then
		return
	end
	local rarity = Pets.Rarity(pet.Rarity)
	local rate = speed or 1
	if modal then
		modal:Close()
	end
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	local rng = Random.new()
	local eggGlow = egg.Accent:Lerp(WHITE, 0.45)
	-- (Epic and better: the glow turns their colour just before it bursts)
	local teaseGlow = if rarity.Order >= 4 then rarity.Color else eggGlow

	local show = Theme.new("Frame", { Name = "Show", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = overlay })
	local stage = Theme.new("Frame", { Name = "Stage", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(340, 340), BackgroundTransparency = 1, Parent = show })
	Theme.AutoScale(stage)
	-- (everything on the stage moves together in here: the slow push-in, the punches, the shakes)
	local inner = Theme.new("Frame", { Name = "Inner", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = stage })
	local zoom = Theme.new("UIScale", { Scale = 1, Parent = inner })
	local edges = vignette(show)
	local flash = Theme.new("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 9, Parent = show })
	local skip = Theme.new("TextButton", { Name = "Skip", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 10, Parent = show })
	skip:SetAttribute("Silent", true)
	local hint = Theme.Label({ Text = "Click to skip", Font = Theme.Font, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.fromOffset(240, 24), StrokeThickness = 2, ZIndex = 10, Parent = show })
	showText(hint, 0)

	-- The glow behind the egg (rings of light), and rays turning round it
	local glows = {}
	for i, spec in { { 340, 0.9 }, { 250, 0.8 }, { 165, 0.68 } } do
		glows[i] = { Frame = circle(inner, "Glow", Vector2.new(spec[1], spec[1]), eggGlow, 1), Size = spec[1], Alpha = 1 - spec[2] }
	end
	local rays = {}
	local rayCount = 6 + rarity.Order * 2
	for i = 1, rayCount do
		rays[i] = Theme.new("Frame", {
			Name = "Ray",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(if i % 2 == 0 then 16 else 30, 640),
			BackgroundColor3 = eggGlow,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 1,
			Parent = inner,
		}, {
			Theme.new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }),
		})
	end
	-- Shockwaves when it bursts
	local rings = {}
	for i = 1, 2 do
		local ring = circle(inner, "Shockwave", Vector2.new(40, 40), WHITE, 2)
		rings[i] = { Frame = ring, Stroke = Theme.new("UIStroke", { Thickness = if i == 1 then 12 else 5, Color = if i == 1 then WHITE else rarity.Color, Transparency = 1, Parent = ring }), Delay = (i - 1) * 0.09 }
	end

	-- The egg, the light inside it and its cracks
	local eggHolder = Theme.new("Frame", { Name = "Egg", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -560), Size = UDim2.fromOffset(340, 340), BackgroundTransparency = 1, ZIndex = 3, Parent = inner })
	local eggView = preview(eggHolder, PetModel.BuildEgg(egg, { NoEffects = true }), UDim2.fromScale(1, 1), UDim2.new())
	eggView.BackgroundTransparency = 1
	local inside = circle(eggHolder, "InnerGlow", Vector2.new(124, 168), eggGlow, 2)
	local cracks: { { Frame } } = {}
	for wobble, list in CRACKS do
		cracks[wobble] = {}
		for _, s in list do
			table.insert(cracks[wobble], crackLine(eggHolder, s[1], s[2], s[3], s[4]))
		end
	end

	-- The pet (built now, hidden, so the burst doesn't stutter)
	local petHolder = Theme.new("Frame", { Name = "Pet", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(340, 340), BackgroundTransparency = 1, Visible = false, ZIndex = 3, Parent = inner })
	local petView = preview(petHolder, PetModel.BuildPet(pet, { NoEffects = true }), UDim2.fromScale(1, 1), UDim2.new())
	petView.BackgroundTransparency = 1
	local pop = Theme.new("UIScale", { Scale = 0.15, Parent = petHolder })
	local petCamera = petView:FindFirstChildOfClass("Camera")
	local petCameraStart = if petCamera then petCamera.CFrame else CFrame.identity

	-- Twinkles round the pet (more for rarer pets)
	local sparkles = {}
	for i = 1, 4 + rarity.Order * 2 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(110, 180)
		local color = if i % 2 == 0 then rarity.Color:Lerp(WHITE, 0.45) else WHITE
		local star = Theme.new("Frame", {
			Name = "Sparkle",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(170 + math.cos(angle) * radius, 170 + math.sin(angle) * radius * 0.85),
			Size = UDim2.fromOffset(28, 28),
			Rotation = rng:NextNumber(-20, 20),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 4,
			Parent = inner,
		}, {
			Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = color, BorderSizePixel = 0 }, { Theme.Corner(2) }),
			Theme.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.7, 0, 0, 4), BackgroundColor3 = color, BorderSizePixel = 0 }, { Theme.Corner(2) }),
		})
		sparkles[i] = { Frame = star, Scale = Theme.new("UIScale", { Scale = 0, Parent = star }), Phase = rng:NextNumber(0, 1), Speed = rng:NextNumber(2.2, 3.6) }
	end

	-- What it is
	local title = Theme.Label({ Text = `{string.upper(rarity.Id)}!`, TextColor3 = rarity.Color, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, -38), Size = UDim2.fromOffset(460, 62), StrokeThickness = 4, ZIndex = 5, Parent = inner })
	local titleScale = Theme.new("UIScale", { Scale = 1, Parent = title })
	local name = Theme.Label({ Text = pet.Name, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.fromOffset(420, 44), StrokeThickness = 3.5, ZIndex = 5, Parent = inner })
	local bonus = Theme.Label({
		Text = `{Pets.BonusText(pet)}  ({string.format("%.3g", Pets.Chance(egg, pet.Id) * 100)}% chance)`,
		Font = Theme.Font,
		TextColor3 = Theme.Colors.Money,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 46),
		Size = UDim2.fromOffset(420, 26),
		StrokeThickness = 2,
		ZIndex = 5,
		Parent = inner,
	})
	for _, label in { title, name, bonus } do
		showText(label, 0)
	end

	local chips = {}
	local function burstShell()
		for i = 1, 18 do
			local angle = rng:NextNumber(0, math.pi * 2)
			local fling = rng:NextNumber(320, 720)
			local chip = Theme.new("Frame", {
				Name = "Shell",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(rng:NextInteger(12, 28), rng:NextInteger(10, 22)),
				BackgroundColor3 = if i % 3 == 0 then egg.Accent else egg.Color,
				BorderSizePixel = 0,
				ZIndex = 4,
				Parent = inner,
			}, { Theme.Corner(4) })
			chips[i] = {
				Frame = chip,
				Stroke = Theme.new("UIStroke", { Thickness = 1.5, Color = Color3.fromRGB(35, 22, 22), Parent = chip }),
				X = 170 + math.cos(angle) * 20,
				Y = 170 + math.sin(angle) * 30,
				VX = math.cos(angle) * fling,
				VY = math.sin(angle) * fling - 260,
				Turn = rng:NextNumber(0, 360),
				Spin = rng:NextNumber(-540, 540),
			}
		end
	end

	-- Moments that happen once (sounds, the burst), in order
	local events = {}
	for i, at in HATCH.Wobbles do
		table.insert(events, { At = at + HATCH.Wobble * 0.45, Name = "Crack", Index = i })
	end
	table.insert(events, { At = HATCH.Burst, Name = "Burst" })
	table.insert(events, { At = HATCH.Title + 0.14, Name = "Slam" })
	local nextEvent = 1
	local punchAt = -10 -- (when the last punch-in happened: cracks and the title slam)
	local shakeAt = -10

	local skipTo: number? = nil
	skip.Activated:Connect(function()
		skipTo = -1 -- (worked out on the next frame, on the hatch's own clock)
	end)

	local startedAt = os.clock()
	local offset = 0
	local last = 0
	local run = function()
		while true do
			task.wait()
			local t = (os.clock() - startedAt) * rate + offset
			if skipTo then
				-- before the burst: straight to it; after it: to the end
				local goal = if t < HATCH.Burst - 0.05 then HATCH.Burst - 0.05 elseif t > HATCH.Burst + 0.5 and t < HATCH.Hold then HATCH.Hold else t
				if goal > t then
					offset += goal - t
					t = goal
					-- (the cracks we skipped past open without their sounds)
					while events[nextEvent] and events[nextEvent].At < t and events[nextEvent].Name == "Crack" do
						for _, line in cracks[events[nextEvent].Index] do
							line.Visible = true
						end
						nextEvent += 1
					end
				end
				skipTo = nil
			end
			local dt = math.max(t - last, 0)
			last = t
			if t >= HATCH.Close then
				break
			end

			-- Moments
			while events[nextEvent] and t >= events[nextEvent].At do
				local event = events[nextEvent]
				nextEvent += 1
				if event.Name == "Crack" then
					for _, line in cracks[event.Index] do
						line.Visible = true
					end
					Theme.PlaySound("Crack")
					punchAt = t
				elseif event.Name == "Burst" then
					Theme.PlaySound("Hatch")
					eggHolder.Visible = false
					petHolder.Visible = true
					burstShell()
					shakeAt = t
				elseif event.Name == "Slam" then
					Theme.PlaySound(if rarity.Order >= 4 then "Rare" else "Success")
					punchAt = t
					shakeAt = t
				end
			end

			-- The backdrop and the vignette
			local closing = smooth((t - HATCH.Hold) / (HATCH.Close - HATCH.Hold))
			overlay.BackgroundTransparency = 1 - 0.72 * smooth(t / 0.35) * (1 - closing)
			for _, edge in edges do
				edge.BackgroundTransparency = 1 - 0.85 * smooth(t / 0.4) * (1 - closing)
			end
			showText(hint, smooth((t - 0.5) / 0.4) * (1 - closing) * 0.8)

			-- The slow push-in, punches and shakes
			local burst = t - HATCH.Burst
			local push = if burst < 0 then 1 + 0.14 * smooth(t / HATCH.Burst) else 1.14 - 0.1 * smooth(burst / 0.6)
			local sincePunch = t - punchAt
			local punch = if sincePunch >= 0 and sincePunch < 0.4 then 0.06 * math.exp(-sincePunch * 9) else 0
			zoom.Scale = (push + punch) * (1 - backIn(closing))
			local sinceShake = t - shakeAt
			local shake = if sinceShake >= 0 and sinceShake < 0.45 then 14 * math.exp(-sinceShake * 7) else 0
			if t > HATCH.Shake and burst < 0 then
				shake += 2 + 6 * smooth((t - HATCH.Shake) / (HATCH.Burst - HATCH.Shake))
			end
			inner.Position = UDim2.new(0.5, math.sin(t * 71) * shake, 0.5, math.cos(t * 63) * shake * 0.7)

			-- The egg: drop, bounce, wobbles, the shake before it bursts
			if burst < 0 then
				local drop = bounceOut(t / HATCH.Drop)
				local land = t - HATCH.Drop
				local squash = if land >= 0 then 0.16 * math.exp(-land * 9) * math.cos(land * 28) else 0
				local rot, hop = math.sin(t * 2.1) * 2, 0
				for i, at in HATCH.Wobbles do
					local w = (t - at) / HATCH.Wobble
					if w >= 0 and w < 1 then
						local amount = 9 + i * 6
						rot = math.sin(w * math.pi * 5) * amount * (1 - w)
						hop = -math.abs(math.sin(w * math.pi * 2)) * amount * 0.9 * (1 - w)
					end
				end
				local fury = smooth((t - HATCH.Shake) / (HATCH.Burst - HATCH.Shake))
				if fury > 0 then
					rot = math.sin(t * 58) * (6 + fury * 12)
					hop = math.cos(t * 47) * fury * 6
				end
				eggHolder.Position = UDim2.new(0.5, 0, 0.5, -560 * (1 - drop) + hop)
				eggHolder.Size = UDim2.fromOffset(340 * (1 + squash), 340 * (1 - squash))
				eggHolder.Rotation = rot
				-- (light from inside: a flicker at each crack, white-hot just before the burst)
				local crackGlow = if sincePunch >= 0 and sincePunch < 0.35 then 0.35 * (1 - sincePunch / 0.35) else 0
				inside.BackgroundColor3 = eggGlow:Lerp(teaseGlow, fury):Lerp(WHITE, fury * fury * 0.6)
				inside.BackgroundTransparency = 1 - math.clamp(crackGlow + fury * 0.85, 0, 0.92)
				inside.Size = UDim2.fromOffset(124 * (1 + fury * 0.25), 168 * (1 + fury * 0.25))
			end

			-- The glow and the rays: growing with every crack, full blast at the burst
			local build = smooth((t - HATCH.Wobbles[1]) / (HATCH.Burst - HATCH.Wobbles[1]))
			local fury = smooth((t - HATCH.Shake) / (HATCH.Burst - HATCH.Shake))
			local glowColor = if burst < 0 then eggGlow:Lerp(teaseGlow, fury) else rarity.Color
			local glowAmount = if burst < 0 then 0.25 + build * 0.6 else 1
			local pulse = 1 + 0.05 * math.sin(t * 5)
			for _, glow in glows do
				local grow = if burst < 0 then 0.55 + build * 0.45 else 1 + 0.25 * math.exp(-burst * 3)
				glow.Frame.BackgroundColor3 = glowColor
				glow.Frame.BackgroundTransparency = 1 - glow.Alpha * glowAmount * (1 - closing)
				glow.Frame.Size = UDim2.fromOffset(glow.Size * grow * pulse, glow.Size * grow * pulse)
			end
			local rayAlpha = if burst < 0 then smooth((t - HATCH.Wobbles[2]) / 1.2) * 0.45 else 0.75
			local spin = t * 18 + (if burst > 0 then 140 * (1 - math.exp(-burst * 2.5)) else 0)
			for i, ray in rays do
				ray.BackgroundColor3 = glowColor
				ray.BackgroundTransparency = 1 - rayAlpha * (1 - closing) * (if i % 2 == 0 then 0.7 else 1)
				ray.Rotation = i / rayCount * 180 + spin
				local reach = if burst < 0 then 0.55 + build * 0.3 else 1
				ray.Size = UDim2.fromOffset(if i % 2 == 0 then 16 else 30, 640 * reach)
			end

			-- The burst: a white flash, shockwaves, bits of shell
			if burst >= 0 then
				flash.BackgroundTransparency = 1 - math.clamp(1 - burst / 0.55, 0, 1) ^ 2
				for _, ring in rings do
					local k = (burst - ring.Delay) / 0.55
					if k >= 0 and k <= 1 then
						local size = 40 + 760 * (1 - (1 - k) ^ 3)
						ring.Frame.Size = UDim2.fromOffset(size, size)
						ring.Stroke.Transparency = k
					else
						ring.Stroke.Transparency = 1
					end
				end
				for _, chip in chips do
					chip.VY += 1150 * dt
					chip.X += chip.VX * dt
					chip.Y += chip.VY * dt
					chip.Turn += chip.Spin * dt
					local fade = math.clamp((burst - 0.55) / 0.5, 0, 1)
					chip.Frame.Position = UDim2.fromOffset(chip.X, chip.Y)
					chip.Frame.Rotation = chip.Turn
					chip.Frame.BackgroundTransparency = fade
					chip.Stroke.Transparency = fade
					chip.Frame.Visible = fade < 1
				end

				-- The pet pops out (squash and stretch), spins round once and floats
				local k = burst / 0.5
				pop.Scale = 0.15 + 0.85 * backOut(k, 2.6)
				local stretch = 0.2 * math.exp(-burst * 7) * math.cos(burst * 24)
				petHolder.Size = UDim2.fromOffset(340 * (1 - stretch), 340 * (1 + stretch))
				petHolder.Position = UDim2.new(0.5, 0, 0.5, math.sin(burst * 2.2) * 5)
				if petCamera then
					local whirl = math.pi * 2 * (1 - (1 - math.clamp(burst / 0.9, 0, 1)) ^ 3)
					petCamera.CFrame = CFrame.Angles(0, whirl + burst * 0.7, 0) * petCameraStart
				end
				for _, sparkle in sparkles do
					sparkle.Frame.Visible = true
					local twinkle = math.max(0, math.sin((burst * sparkle.Speed + sparkle.Phase) * math.pi * 2))
					sparkle.Scale.Scale = twinkle * smooth(burst / 0.4) * (1 - closing)
					sparkle.Frame.Rotation += dt * 40
				end
			end

			-- The rarity slams down, then the name and what it gives slide in
			local slam = (t - HATCH.Title) / 0.14
			if slam >= 0 then
				showText(title, smooth(slam * 2) * (1 - closing))
				-- (drops from big onto the screen, then squashes and springs back)
				titleScale.Scale = if slam < 1 then 2.6 - 1.6 * slam * slam else 1 - 0.14 * math.exp(-(slam - 1) * 0.9) * math.sin((slam - 1) * 1.6)
				if rarity.Order >= 6 then
					title.TextColor3 = Color3.fromHSV((t * 0.4) % 1, 0.7, 1)
				end
			end
			for i, label in { name, bonus } do
				local k = smooth((t - HATCH.Title - 0.2 - i * 0.12) / 0.3)
				showText(label, k * (1 - closing))
				label.Position = UDim2.new(0.5, 0, 1, (i - 1) * 46 + 24 * (1 - k))
			end
		end
	end
	local ok, err = pcall(function()
		run()
	end)
	if not ok then
		warn(`[Hatch] {err}`)
	end
	show:Destroy()
	overlay.BackgroundTransparency = 1
	overlay.Visible = false
end

-- One hatch after another (Hatch All): quicker while more are waiting
local queue: { { EggId: string, PetId: string } } = {}
local hatching = false
local function enqueue(info: { EggId: string, PetId: string })
	table.insert(queue, info)
	if hatching then
		return
	end
	hatching = true
	while #queue > 0 do
		local nextHatch = table.remove(queue, 1)
		if nextHatch then
			local ok, err = pcall(function()
				playHatch(nextHatch, if #queue > 0 then 1.5 else 1)
			end)
			if not ok then
				-- (never leave the show - and its full-screen skip button - over the game)
				warn(`[Hatch] {err}`)
				for _, child in overlay:GetChildren() do
					child:Destroy()
				end
				overlay.Visible = false
			end
		end
	end
	hatching = false
end

-- For the admin panel: hatch a random pet from a random egg, just to watch (nothing is given). Every
-- pet in the egg is as likely as the next, so the rare reveals show up too.
function PetsWindow.PreviewHatch(): boolean
	if not overlay or #Pets.Eggs == 0 then
		return false
	end
	local rng = Random.new()
	local egg = Pets.Eggs[rng:NextInteger(1, #Pets.Eggs)]
	local entry = egg.Pool[rng:NextInteger(1, #egg.Pool)]
	task.spawn(enqueue, { EggId = egg.Id, PetId = entry.Pet })
	return true
end

function PetsWindow.Open()
	modal:Open()
end

function PetsWindow.Init()
	modal = Modal.new("Pets", Theme.Colors.Pink, Vector2.new(760, 520))
	local body = modal.Body
	header = Theme.Label({ Text = "", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -330, 0, 28), Position = UDim2.fromOffset(0, 50), StrokeThickness = 1.5, Parent = body })
	local hatchAll = Theme.Button({ Text = "HATCH ALL READY", Color = Theme.Colors.Green, Size = UDim2.fromOffset(170, 34), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -150, 0, 48), Parent = body })
	hatchAll.Activated:Connect(function()
		State.Action("HatchEgg")
	end)
	local best = Theme.Button({ Text = "EQUIP BEST", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(140, 34), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 48), Parent = body })
	best.Activated:Connect(function()
		State.Action("EquipBestPets")
	end)
	for _, name in { "Eggs", "Pets" } do
		pages[name] = Theme.new("ScrollingFrame", {
			Name = name,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, 88),
			Size = UDim2.new(1, 0, 1, -88),
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 8,
			Visible = false,
			Parent = body,
		}, {
			Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(168, 228), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
			Theme.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
		})
	end
	local selectTab = Modal.Tabs(body, {
		{ Name = "Eggs", Text = "Eggs", Color = Theme.Colors.Orange },
		{ Name = "Pets", Text = "Pets", Color = Theme.Colors.Pink },
	}, function(name)
		currentTab = name
		for pageName, page in pages do
			page.Visible = pageName == name
		end
		hatchAll.Visible = name == "Eggs"
		best.Visible = name == "Pets"
		refresh()
	end)
	modal.OnOpen = function()
		selectTab(currentTab)
	end
	State.Changed:Connect(function()
		if modal:IsOpen() then
			refresh()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if modal:IsOpen() and currentTab == "Eggs" then
				refreshEggTimers()
			end
		end
	end)

	local gui = Theme.ScreenGui("Hatching", 30)
	overlay = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Visible = false, Parent = gui })
	gui.IgnoreGuiInset = true
	Remotes.Event("EggHatched").OnClientEvent:Connect(enqueue)
end

return PetsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">Sell</string>
              <string name="Source"><![CDATA[--[[
	Sell window, opened at the sell stall in the lobby (press E there). Lists every donut you have -
	in your inventory and in your pen - with what it earns and what it sells for, best first.
	  * SELL on a row sells that one donut (click twice: the first click asks "SURE?").
	  * The buttons at the top sell every INVENTORY donut of a rarity in one go (also twice).
	    Donuts in your pen are only ever sold one by one, so nothing earning money goes by accident.
	Prices come from the server (Remotes "GetSellList"): Config.SellSeconds of the donut's income.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Donuts = require(Shared.Donuts)
local Rarities = require(Shared.Rarities)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Sell = {}

type SellItem = { Uid: string?, Slot: number?, Id: string, Level: number, Mutation: string?, Size: string?, Price: number, Income: number }

local CONFIRM_SECONDS = 2.5
local SELL_GREEN = Color3.fromRGB(60, 200, 90)
local SURE_RED = Color3.fromRGB(235, 70, 70)

local modal: Modal.Modal
local list: ScrollingFrame
local header: TextLabel
local quick: Frame
local emptyLabel: TextLabel
local loading = false
local queued = false

-- A button that only acts on the second click (within CONFIRM_SECONDS).
local function confirmButton(props: { Text: string, Color: Color3, Size: UDim2, Parent: Instance, LayoutOrder: number? }, onConfirm: () -> ()): TextButton
	local button = Theme.Button({ Text = props.Text, Color = props.Color, Size = props.Size, Parent = props.Parent, LayoutOrder = props.LayoutOrder })
	local armedAt = 0
	button.Activated:Connect(function()
		local now = os.clock()
		if now - armedAt <= CONFIRM_SECONDS then
			armedAt = 0
			Theme.SetButtonText(button, props.Text)
			Theme.SetButtonColor(button, props.Color)
			onConfirm()
			return
		end
		armedAt = now
		Theme.SetButtonText(button, "SURE?")
		Theme.SetButtonColor(button, SURE_RED)
		task.delay(CONFIRM_SECONDS, function()
			if armedAt == now then
				armedAt = 0
				Theme.SetButtonText(button, props.Text)
				Theme.SetButtonColor(button, props.Color)
			end
		end)
	end)
	return button
end

local function clear(parent: Instance)
	for _, child in parent:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function row(item: SellItem, order: number)
	local donut = Donuts.ById[item.Id]
	if not donut then
		return
	end
	local rarity = Rarities.Get(donut.Rarity)
	local mutation = Rarities.Mutation(item.Mutation)
	local frame = Theme.new("Frame", {
		Size = UDim2.new(1, -12, 0, 58),
		BackgroundColor3 = Theme.Colors.Outline,
		BackgroundTransparency = 0.55,
		LayoutOrder = order,
		Parent = list,
	}, {
		Theme.Corner(10),
	})
	Theme.Label({
		Text = Rarities.DisplayName(donut.Name, item.Mutation, item.Size),
		TextColor3 = if mutation.Order > 0 then mutation.Color else rarity.Color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.58, -12, 0, 30),
		Position = UDim2.fromOffset(12, 3),
		StrokeThickness = 2,
		Parent = frame,
	})
	local where = if item.Slot then "In your pen" else "Inventory"
	Theme.Label({
		Text = `{rarity.Id} • {where} • {Format.Money(item.Income)}/s`,
		Font = Theme.Font,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.58, -12, 0, 20),
		Position = UDim2.fromOffset(12, 33),
		StrokeThickness = 1.5,
		Parent = frame,
	})
	Theme.Label({
		Text = `{Format.Money(item.Price)}`,
		TextColor3 = Theme.Colors.Yellow,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0.42, -150, 1, -16),
		Position = UDim2.new(0.58, 0, 0, 8),
		StrokeThickness = 2,
		Parent = frame,
	})
	local holder = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(122, 42), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Parent = frame })
	confirmButton({ Text = "SELL", Color = SELL_GREEN, Size = UDim2.fromScale(1, 1), Parent = holder }, function()
		if item.Uid then
			State.Action("SellInventory", item.Uid)
		elseif item.Slot then
			State.Action("SellSlot", item.Slot)
		end
		frame:Destroy()
		Sell.Refresh(0.4)
	end)
end

local function fill(items: { SellItem })
	clear(list)
	clear(quick)
	Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = quick })
	Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	-- What a "sell all" of each rarity would give (inventory only)
	local byRarity: { [string]: { Count: number, Total: number } } = {}
	local inventoryTotal, inventoryCount = 0, 0
	for _, item in items do
		local donut = Donuts.ById[item.Id]
		if item.Uid and donut then
			local entry = byRarity[donut.Rarity] or { Count = 0, Total = 0 }
			byRarity[donut.Rarity] = entry
			entry.Count += 1
			entry.Total += item.Price
			inventoryTotal += item.Price
			inventoryCount += 1
		end
	end
	local order = 0
	for _, rarity in Rarities.List do
		local entry = byRarity[rarity.Id]
		if entry then
			order += 1
			confirmButton({ Text = `All {rarity.Id} ({entry.Count})`, Color = rarity.Color, Size = UDim2.fromOffset(150, 40), Parent = quick, LayoutOrder = order }, function()
				State.Action("SellAllInventory", rarity.Id)
				Sell.Refresh(0.4)
			end)
		end
	end
	if inventoryCount > 1 then
		confirmButton({ Text = `ALL ({Format.Money(inventoryTotal)})`, Color = SELL_GREEN, Size = UDim2.fromOffset(170, 40), Parent = quick, LayoutOrder = 99 }, function()
			State.Action("SellAllInventory", "All")
			Sell.Refresh(0.4)
		end)
	end
	header.Text = if inventoryCount > 0
		then `Sell all your <b>inventory</b> donuts of a rarity ({inventoryCount} in your inventory, worth <font color="#ffd54a"><b>{Format.Money(inventoryTotal)}</b></font>):`
		else "Donuts in your pen are sold one at a time below. Donuts from boxes land in your <b>inventory</b> first."

	for index, item in items do
		row(item, index)
	end
	emptyLabel.Visible = #items == 0
end

-- Ask the server for the list again (after `delay` seconds: give a sale time to go through).
function Sell.Refresh(delay: number?)
	if loading then
		queued = true
		return
	end
	loading = true
	task.delay(delay or 0, function()
		local ok, items = pcall(function()
			return Remotes.Function("GetSellList"):InvokeServer()
		end)
		loading = false
		if ok and type(items) == "table" and modal:IsOpen() then
			fill(items :: { SellItem })
		end
		if queued then
			queued = false
			Sell.Refresh(0.2)
		end
	end)
end

function Sell.Open()
	modal:Open()
end

-- The stall's "Sell donuts" prompt (made here, so it's only on your screen).
local function addStallPrompt()
	local map = workspace:WaitForChild("Map", 120)
	local hub = map and map:WaitForChild("Hub", 60)
	local stall = hub and hub:WaitForChild("SellStall", 60)
	local part = stall and stall:WaitForChild("PromptPart", 60)
	if not part then
		return
	end
	local prompt = Theme.new("ProximityPrompt", {
		Name = "SellPrompt",
		ActionText = "Sell donuts",
		ObjectText = "Sell Stall",
		KeyboardKeyCode = Enum.KeyCode.E,
		GamepadKeyCode = Enum.KeyCode.ButtonX,
		HoldDuration = 0,
		MaxActivationDistance = 16,
		RequiresLineOfSight = false,
		Parent = part,
	}) :: ProximityPrompt
	prompt.Triggered:Connect(Sell.Open)
end

function Sell.Init()
	modal = Modal.new("Sell Donuts", SELL_GREEN, Vector2.new(780, 560))
	local body = modal.Body
	header = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 28), Parent = body })
	quick = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), Position = UDim2.fromOffset(0, 32), Parent = body })
	list = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 84),
		Size = UDim2.new(1, 0, 1, -84),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = body,
	}) :: ScrollingFrame
	emptyLabel = Theme.Label({
		Text = "No donuts to sell yet!\nSteal a box, open it in your pen, and the donut lands in your inventory.",
		Font = Theme.Font,
		Size = UDim2.new(1, 0, 0, 80),
		Position = UDim2.fromOffset(0, 120),
		Visible = false,
		Parent = body,
	})
	modal.OnOpen = function()
		Sell.Refresh(0)
	end
	State.OnAttribute("InventoryCount", function()
		if modal:IsOpen() then
			Sell.Refresh(0.2)
		end
	end)
	task.spawn(addStallPrompt)
end

return Sell
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[--[[
	Settings window + background music player.
	Music on/off and volume are saved per player. Tracks come from Config.Music.Tracks.
	Run speed: type how fast you want to run (a WalkSpeed, at least Config.Speed.MinRunSpeed); MAX
	runs as fast as you can. Saved per player, the server applies it (Actions.SetSpeedLimit).
	Buttons along the bottom: How to Play, the Update Log, and Hide UI (clears the screen for
	screenshots; X on a keyboard does the same, see UI/HideUI). The gear for this window is at the
	top right of the screen (UI/HUD).

	The song is for the lobby: out in the lane (any biome) it fades out and the biomes' own ambience
	(client/BiomeAmbience) takes over, and it fades back in when you come back.

	The music never stops on its own: a single song loops, several songs play one after another
	(and start over), and a watchdog restarts playback if Roblox ever drops it. Songs that fail to
	load (a private asset, a deleted asset, or a typo in the ID) are skipped with a warning in the
	Output window; if none of them load, it keeps retrying (a slow connection while the map loads).
]]

local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Signal = require(Shared.Signal)

local Theme = require(script.Parent.Theme)
local StormMusic = require(script.Parent.StormMusic)
local Modal = require(script.Parent.Modal)
local HideUI = require(script.Parent.HideUI)
local State = require(script.Parent.Parent.State)
local AreaTracker = require(script.Parent.Parent.AreaTracker)

local Settings = {}

-- Fires (on: boolean) whenever music is switched on or off (the HUD's music toggle listens).
Settings.MusicChanged = Signal.new()

local modal: Modal.Modal
local sound: Sound
local trackIndex = 1
local volume = Config.Music.DefaultVolume
local musicOn = true
local loaded = false -- becomes true once the saved settings arrive
local refresh: () -> () = function() end
local status = "" -- shown under "Now playing" when something is wrong
local playToken = 0
local failed: { [number]: boolean } = {}
local LOAD_TIMEOUT = 25 -- seconds a song may take to load before it's skipped
local RETRY_DELAY = 30 -- seconds before trying again when no song could be loaded
local retryPending = false

local tracks = Config.Music.Tracks
local usingFallback = false

-- (No chase music: grabbing a box plays its own sounds, Config.Guard.GrabSounds, and that's all.)
-- The Eternal Storm: its march (StormMusic) plays instead of the normal song.
local storming = false
-- Out in the lane: the song fades out (it keeps playing silently, so it picks up again in the lobby).
local inLane = false

local function applyVolume()
	local TweenService = game:GetService("TweenService")
	local fade = TweenInfo.new(0.6)
	TweenService:Create(sound, fade, { Volume = if not musicOn or storming or inLane then 0 else volume }):Play()
	sound.PlaybackSpeed = 1
	if storming and musicOn then
		StormMusic.Start(volume)
	else
		StormMusic.Stop()
	end
end

-- StormFX calls this when the Eternal Storm starts (true) and ends (false).
function Settings.SetStorm(on: boolean)
	if on ~= storming then
		storming = on
		if on and not musicOn then
			print("[Music] The Eternal Storm's song is muted because music is switched off (the music button or Settings).")
		end
		applyVolume()
	end
end

local function workingTracks(): number
	local count = 0
	for i = 1, #tracks do
		if not failed[i] then
			count += 1
		end
	end
	return count
end

local playTrack: (index: number) -> ()

playTrack = function(index: number)
	if #tracks == 0 then
		return
	end
	if workingTracks() == 0 and not usingFallback and #Config.Music.Fallback > 0 then
		-- None of the chosen songs loads: play the backup song(s) instead
		usingFallback = true
		tracks = Config.Music.Fallback
		table.clear(failed)
		playTrack(1)
		return
	end
	if workingTracks() == 0 then
		-- Nothing loaded (yet): try every song again in a while instead of going silent for good.
		sound:Stop()
		status = "Couldn't load the music - trying again soon"
		refresh()
		if not retryPending then
			retryPending = true
			task.delay(RETRY_DELAY, function()
				retryPending = false
				table.clear(failed)
				playTrack(trackIndex)
			end)
		end
		return
	end
	-- Skip songs that already failed
	for _ = 1, #tracks do
		trackIndex = (index - 1) % #tracks + 1
		if not failed[trackIndex] then
			break
		end
		index += 1
	end
	playToken += 1
	local token = playToken
	local track = tracks[trackIndex]
	sound:Stop()
	-- One song: let Roblox loop it seamlessly. Several: play them in turn (Ended / the watchdog).
	sound.Looped = workingTracks() <= 1
	sound.SoundId = "rbxassetid://" .. tostring(track.Id)
	sound.TimePosition = 0
	sound:Play()
	status = ""
	refresh()
	-- A song that never loads (private/deleted asset) never plays: skip it after a while.
	task.delay(LOAD_TIMEOUT, function()
		if token ~= playToken then
			return
		end
		if not sound.IsLoaded or sound.TimeLength <= 0 then
			failed[trackIndex] = true
			warn(`[Music] Couldn't load "{track.Name}" (rbxassetid://{track.Id}). Audio must be public or uploaded by the game's owner. Skipping it.`)
			playTrack(trackIndex + 1)
		end
	end)
end

local function save()
	State.Action("SetMusic", { Volume = volume, On = musicOn })
end

function Settings.Open()
	modal:Open()
end

function Settings.MusicOn(): boolean
	return musicOn
end

function Settings.SetMusicOn(on: boolean)
	if on == musicOn then
		return
	end
	musicOn = on
	applyVolume()
	refresh()
	save()
	Settings.MusicChanged:Fire(musicOn)
end

function Settings.Init()
	StormMusic.Preload()
	sound = Instance.new("Sound")
	sound.Name = "Soundtrack"
	sound.Looped = false
	sound.Parent = SoundService
	inLane = AreaTracker.Current > 0
	AreaTracker.Changed:Connect(function(areaId: number)
		if (areaId > 0) ~= inLane then
			inLane = areaId > 0
			applyVolume()
		end
	end)
	applyVolume()
	sound.Ended:Connect(function()
		if not sound.Looped then
			playTrack(trackIndex + 1)
		end
	end)
	-- Watchdog: if the music ever stops by itself (a missed Ended event, the engine dropping the
	-- sound...), start the next song. "Music off" only turns the volume down, so this never fights it.
	task.spawn(function()
		while true do
			task.wait(3)
			if #tracks > 0 and not retryPending and sound.IsLoaded and not sound.IsPlaying then
				playTrack(if sound.Looped then trackIndex else trackIndex + 1)
			end
		end
	end)

	modal = Modal.new("Settings", Theme.Colors.Gray, Vector2.new(520, 600))
	local body = modal.Body

	Theme.Label({ Text = "MUSIC", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 36), Parent = body })
	local nowPlaying = Theme.Label({ Text = "", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 40), StrokeThickness = 1.5, Parent = body })

	local toggle = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.fromOffset(150, 52), Position = UDim2.fromOffset(0, 80), Parent = body })
	local skip = Theme.Button({ Text = "NEXT", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(150, 52), Position = UDim2.fromOffset(160, 80), Parent = body })

	Theme.Label({ Text = "Volume", Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 150), StrokeThickness = 1.5, Parent = body })
	local minus = Theme.Button({ Text = "−", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(0, 182), Parent = body })
	local bar = Theme.new("Frame", { Size = UDim2.fromOffset(300, 26), Position = UDim2.fromOffset(62, 195), BackgroundColor3 = Theme.Colors.Outline, Parent = body }, { Theme.Corner(8), Theme.Stroke(2) })
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(volume, 1), BackgroundColor3 = Theme.Colors.Green, Parent = bar }, { Theme.Corner(8) })
	local plus = Theme.Button({ Text = "+", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(372, 182), Parent = body })
	-- Run speed: a number you type (Enter or clicking away saves it). The box says "Type Here" until
	-- you've set one; the line under it says how fast you can go.
	Theme.Label({ Text = "RUN SPEED", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 246), Parent = body })
	local speedBox = Theme.new("TextBox", {
		Name = "RunSpeed", Size = UDim2.fromOffset(150, 48), Position = UDim2.fromOffset(0, 286),
		BackgroundColor3 = Theme.Colors.PanelLight, TextColor3 = Color3.new(1, 1, 1), PlaceholderText = "Type Here",
		PlaceholderColor3 = Color3.fromRGB(170, 170, 190), Text = "", Font = Theme.Font, TextScaled = true, ClearTextOnFocus = true, Parent = body,
	}, { Theme.Corner(10), Theme.Stroke(2), Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }) })
	local maxSpeed = Theme.Button({ Text = "MAX", Color = Theme.Colors.Green, Size = UDim2.fromOffset(100, 48), Position = UDim2.fromOffset(160, 286), Parent = body })
	local speedHint = Theme.Label({
		Name = "RunSpeedHint",
		Text = "",
		Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 340), StrokeThickness = 1.2, Parent = body,
	})
	local function renderSpeed()
		local limit = State.Number("SpeedLimit")
		local top = math.floor(math.max(State.Number("WalkSpeed"), Config.Speed.BaseWalkSpeed))
		if not speedBox:IsFocused() then
			-- (empty shows "Type Here": no speed set, you run as fast as you can)
			speedBox.Text = if limit > 0 then tostring(limit) else ""
		end
		speedHint.Text = `Type how fast you want to run ({Config.Speed.MinRunSpeed} to {math.max(top, Config.Speed.MinRunSpeed)}). MAX = as fast as you can go.`
		Theme.SetButtonColor(maxSpeed, if limit > 0 then Theme.Colors.Green else Theme.Colors.Gray)
	end
	speedBox.FocusLost:Connect(function()
		local typed = string.lower((string.gsub(speedBox.Text, "[%s,]", "")))
		local number = tonumber(typed)
		if typed == "max" or typed == "" and State.Number("SpeedLimit") == 0 then
			State.Action("SetSpeedLimit", 0)
		elseif number and number == number and number > 0 then
			State.Action("SetSpeedLimit", math.max(math.floor(number), Config.Speed.MinRunSpeed))
		end
		renderSpeed()
	end)
	maxSpeed.Activated:Connect(function()
		State.Action("SetSpeedLimit", 0)
	end)
	State.OnAttribute("SpeedLimit", renderSpeed)
	State.OnAttribute("WalkSpeed", renderSpeed)
	renderSpeed()

	-- (three buttons along the bottom)
	local help = Theme.Button({ Text = "HOW TO PLAY", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(158, 52), Position = UDim2.fromOffset(0, 376), Parent = body })
	help.Activated:Connect(function()
		modal:Close()
		require(script.Parent.Tutorial).Open()
	end)
	local notes = Theme.Button({ Text = "UPDATE LOG", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(158, 52), Position = UDim2.fromOffset(167, 376), Parent = body })
	notes.Activated:Connect(function()
		require(script.Parent.UpdateNotes).Open()
	end)
	-- Clear the screen for screenshots (the SHOW UI pill, or X again, brings it back)
	local hide = Theme.Button({
		Name = "HideUI",
		Text = if UserInputService.KeyboardEnabled then "HIDE UI (X)" else "HIDE UI",
		Color = Theme.Colors.Gray,
		Size = UDim2.fromOffset(158, 52),
		Position = UDim2.fromOffset(334, 376),
		Parent = body,
	})
	hide.Activated:Connect(function()
		modal:Close()
		HideUI.Set(true)
	end)
	-- Watch the opening cinematic again (client/Intro)
	local intro = Theme.Button({ Name = "WatchIntro", Text = "WATCH INTRO", Color = Theme.Colors.Purple, Size = UDim2.fromOffset(158, 52), Position = UDim2.fromOffset(0, 436), Parent = body })
	intro.Activated:Connect(function()
		local ok, why = require(script.Parent.Parent.Intro).Watch()
		if ok then
			modal:Close()
		elseif why then
			require(script.Parent.Notifications).Toast(why, "error")
		end
	end)
	local percent = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.fromOffset(60, 30), Position = UDim2.fromOffset(430, 193), StrokeThickness = 1.5, Parent = body })

	refresh = function()
		Theme.SetButtonText(toggle, if musicOn then "MUSIC: ON" else "MUSIC: OFF")
		Theme.SetButtonColor(toggle, if musicOn then Theme.Colors.Green else Theme.Colors.Gray)
		fill.Size = UDim2.fromScale(volume, 1)
		percent.Text = math.floor(volume * 100 + 0.5) .. "%"
		if #tracks == 0 then
			nowPlaying.Text = "No songs added yet (Config.Music.Tracks)"
		elseif status ~= "" then
			nowPlaying.Text = status
		else
			nowPlaying.Text = "Now playing: " .. tracks[trackIndex].Name
		end
	end

	toggle.Activated:Connect(function()
		Settings.SetMusicOn(not musicOn)
	end)
	skip.Activated:Connect(function()
		playTrack(trackIndex + 1)
	end)
	local function changeVolume(delta: number)
		volume = math.clamp(math.floor((volume + delta) * 10 + 0.5) / 10, 0, 1)
		applyVolume()
		refresh()
		save()
	end
	minus.Activated:Connect(function()
		changeVolume(-0.1)
	end)
	plus.Activated:Connect(function()
		changeVolume(0.1)
	end)

	-- Use the player's saved settings once they arrive
	State.Changed:Connect(function(snapshot)
		if loaded then
			return
		end
		loaded = true
		if type(snapshot.MusicVolume) == "number" then
			volume = snapshot.MusicVolume
		end
		if type(snapshot.MusicOn) == "boolean" then
			musicOn = snapshot.MusicOn
		end
		applyVolume()
		refresh()
		Settings.MusicChanged:Fire(musicOn)
	end)

	refresh()
	playTrack(1)
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="145">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--[[
	Shop: one long page you scroll down through, section after section, each under its own big
	coloured heading ("-- BOOSTS --"), like the simulator games' shops:
	  Upgrades  - Speed Multiplier, Treadmill tiers, a Bigger Base and Incubator upgrades (money)
	  Boosts    - 1.5x / 2x / 3x / 4x / 5x / 10x Money, 2x Speed, Teleporter and the Luck Event (Robux)
	  Crates    - Common / Rare / Epic / Legendary crates (Robux). Every outcome and its exact chance
	              is shown on the card, and "All odds" lists the pets inside every egg too (Roblox's
	              paid random items rules). Hidden purchase for players whose region blocks them.
	  Skins     - base skins (paid with your Speed stat), equip the ones you own
	  Trails    - trails behind you while you run (UI/Trails)
	  Donate    - tips for the developer (UI/Donate)
	A column of big icons down the right side of the window jumps to each section (the one you're
	looking at has a gold name). Shop.Open(section) opens it scrolled to that section.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Crates = require(Shared.Crates)
local CrateModel = require(Shared.CrateModel)
local Pets = require(Shared.Pets)

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local Icons = require(script.Parent.Icons)
local Modal = require(script.Parent.Modal)
local Trails = require(script.Parent.Trails)
local Donate = require(script.Parent.Donate)
local State = require(script.Parent.Parent.State)

local Shop = {}

local rgb = Color3.fromRGB

-- The sections, top to bottom: Name (what Shop.Open takes), its heading, colour, and its button
type Section = { Name: string, Title: string, Color: Color3, Icon: string, Caption: string }
local SECTIONS: { Section } = {
	{ Name = "Upgrades", Title = "UPGRADES", Color = rgb(205, 165, 255), Icon = "bolt", Caption = "Upgrades" },
	{ Name = "Passes", Title = "BOOSTS", Color = rgb(255, 200, 70), Icon = "rocket", Caption = "Boosts" },
	{ Name = "Crates", Title = "CRATES", Color = rgb(255, 225, 90), Icon = "gift", Caption = "Crates" },
	{ Name = "Skins", Title = "SKINS", Color = rgb(255, 130, 200), Icon = "paletteWood", Caption = "Skins" },
	{ Name = "Trails", Title = "TRAILS", Color = rgb(120, 205, 255), Icon = "cycle", Caption = "Trails" },
	{ Name = "Donate", Title = "DONATE", Color = rgb(255, 120, 170), Icon = "heart", Caption = "Donate" },
}
local ALIASES: { [string]: string } = { Boosts = "Passes" }

local modal: Modal.Modal
local scroller: ScrollingFrame
local pages: { [string]: Frame } = {}
local headers: { [string]: TextLabel } = {}
local navButtons: { [string]: TextButton } = {}
local refreshers: { () -> () } = {}
local robuxPrices: { [number]: number } = {}
local priceFailed: { [number]: boolean } = {}

local function refreshAll()
	for _, refresh in refreshers do
		refresh()
	end
end

-- A section of the page: its big heading, then a grid of `columns` cards `cardHeight` tall, or
-- (columns = 0) a list of whatever sizes the cards are. It grows to fit its cards.
local function newSection(def: Section, order: number, columns: number, cardHeight: number): Frame
	headers[def.Name] = Theme.Label({
		Name = def.Name .. "Heading",
		Text = `-- {def.Title} --`,
		TextColor3 = def.Color,
		Size = UDim2.new(1, -40, 0, 46),
		LayoutOrder = order * 2 - 1,
		StrokeThickness = 3.5,
		Parent = scroller,
	})
	local section = Theme.new("Frame", {
		Name = def.Name,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order * 2,
		Parent = scroller,
	}, {
		if columns > 0
			then Theme.new("UIGridLayout", {
				CellSize = UDim2.new(1 / columns, -10, 0, cardHeight),
				CellPadding = UDim2.fromOffset(10, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			})
			else Theme.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingBottom = UDim.new(0, 14) }),
	}) :: Frame
	pages[def.Name] = section
	return section
end

local function card(parent: Instance, order: number, color: Color3): Frame
	return Theme.Card(parent, order, color)
end

--------------------------------------------------------------------------------
-- Upgrades
--------------------------------------------------------------------------------
local function buildUpgrades(page: Frame)
	-- Speed multiplier
	local multCard = card(page, 1, Theme.Colors.Purple)
	Theme.Label({ Text = "SPEED MULTIPLIER", TextColor3 = Color3.fromRGB(200, 160, 255), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = multCard })
	local multInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = multCard })
	local multButton = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = multCard })
	multButton.Activated:Connect(function()
		State.Action("BuySpeedMultiplier")
	end)

	-- Treadmill
	local treadCard = card(page, 2, Theme.Colors.Orange)
	Theme.Label({ Text = "TREADMILL", TextColor3 = Color3.fromRGB(255, 200, 120), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = treadCard })
	local treadInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = treadCard })
	local treadButton = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = treadCard })
	treadButton.Activated:Connect(function()
		State.Action("BuyTreadmill")
	end)

	-- Bigger base
	local expandCard = card(page, 3, Theme.Colors.Blue)
	local expandTitle = Theme.Label({ Text = "BIGGER BASE", TextColor3 = Color3.fromRGB(140, 210, 255), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = expandCard })
	local expandInfo = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = expandCard })
	local expandButton = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = expandCard })
	expandButton.Activated:Connect(function()
		if Economy.BaseSizeCost(math.max(1, State.Number("BaseLevel"))) then
			State.Action("BuyBaseSize")
		end
	end)

	-- Incubator upgrades
	local function incubatorCard(order: number, kind: string, title: string, color: Color3): (TextLabel, TextButton)
		local c = card(page, order, color)
		Theme.Label({ Text = title, TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.4), Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 8), Parent = c })
		local info = Theme.Label({ Text = "", Font = Theme.Font, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 46), StrokeThickness = 1.5, Parent = c })
		local button = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 54), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = c })
		button.Activated:Connect(function()
			State.Action("BuyIncubatorUpgrade", kind)
		end)
		return info, button
	end
	local hatchInfo, hatchButton = incubatorCard(4, "Speed", "INCUBATOR SPEED", Theme.Colors.Pink)
	local sizeInfo, sizeButton = incubatorCard(5, "Size", "INCUBATOR SIZE", Theme.Colors.Orange)

	-- Summary
	local summary = card(page, 6, Theme.Colors.Blue)
	local summaryText = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -24, 1, -20), Position = UDim2.fromOffset(12, 10), StrokeThickness = 1.5, Parent = summary })
	local tip = card(page, 7, Theme.Colors.Green)
	Theme.Label({
		Text = "Run on your treadmill to gain Speed. Every biome shows the Speed you need to get away from its Domer - and the further biomes have better boxes with donuts that earn way more! Upgrading your donuts (E on them) is cheap early on.",
		Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -24, 1, -20), Position = UDim2.fromOffset(12, 10), StrokeThickness = 1.5, Parent = tip,
	})

	table.insert(refreshers, function()
		local money = State.Number("Money")
		local passMult = math.max(1, State.Number("SpeedPassMultiplier"))

		local multLevel = State.Number("SpeedMultLevel")
		if multLevel >= Config.SpeedMultiplier.MaxLevel then
			multInfo.Text = `x{Format.Multiplier(Economy.SpeedMultiplier(multLevel))} (MAX)`
			Theme.SetButtonText(multButton, "MAXED")
			Theme.SetButtonColor(multButton, Theme.Colors.Gray)
		else
			local cost = Economy.SpeedMultiplierCost(multLevel)
			local percent = math.floor(Config.SpeedMultiplier.PerLevel * 100 + 0.5)
			multInfo.Text = `x{Format.Multiplier(Economy.SpeedMultiplier(multLevel))}  →  x{Format.Multiplier(Economy.SpeedMultiplier(multLevel + 1))}\n+{percent}% treadmill speed per level (Lv {multLevel}/{Config.SpeedMultiplier.MaxLevel})`
			Theme.SetButtonText(multButton, "Buy " .. Format.Money(cost))
			Theme.SetButtonColor(multButton, if money >= cost then Theme.Colors.Green else Theme.Colors.Gray)
		end

		local level = math.max(1, State.Number("TreadmillLevel"))
		local tier = Economy.TreadmillTier(level)
		if level >= Economy.MaxTreadmillLevel() then
			treadInfo.Text = `{tier.Name} (Tier {level}/{Economy.MaxTreadmillLevel()}) - the best!\n+{Format.Number(tier.PerStep)} speed every step`
			Theme.SetButtonText(treadButton, "MAXED")
			Theme.SetButtonColor(treadButton, Theme.Colors.Gray)
		else
			local nextTier = Economy.TreadmillTier(level + 1)
			treadInfo.Text = `{tier.Name} → {nextTier.Name} (Tier {level + 1}/{Economy.MaxTreadmillLevel()})\n+{Format.Number(tier.PerStep)} → +{Format.Number(nextTier.PerStep)} speed every step`
			Theme.SetButtonText(treadButton, "Buy " .. Format.Money(nextTier.Cost))
			Theme.SetButtonColor(treadButton, if money >= nextTier.Cost then Theme.Colors.Green else Theme.Colors.Gray)
		end

		local baseLevel = math.max(1, State.Number("BaseLevel"))
		local slots = Economy.SlotCount(baseLevel)
		local sizeCost = Economy.BaseSizeCost(baseLevel)
		if sizeCost then
			expandTitle.Text = "BIGGER BASE"
			expandInfo.Text = `Room for {slots} → {Economy.SlotCount(baseLevel + 1)} donuts\nKept forever`
			Theme.SetButtonText(expandButton, "Buy " .. Format.Money(sizeCost))
			Theme.SetButtonColor(expandButton, if money >= sizeCost then Theme.Colors.Green else Theme.Colors.Gray)
		else
			expandTitle.Text = "BASE"
			expandInfo.Text = `Room for {slots} donuts - as big as it gets!`
			Theme.SetButtonText(expandButton, "MAXED")
			Theme.SetButtonColor(expandButton, Theme.Colors.Gray)
		end

		local function incubatorRow(kind: string, info: TextLabel, button: TextButton)
			local level = State.Number(if kind == "Speed" then "IncubatorSpeed" else "IncubatorSize")
			local cost = Economy.IncubatorUpgradeCost(kind, level)
			local now = if kind == "Speed" then `x{Format.Multiplier(Economy.IncubatorSpeed(level))} hatch speed` else `{Economy.IncubatorCapacity(level)} eggs at once`
			if cost then
				local nextText = if kind == "Speed" then `x{Format.Multiplier(Economy.IncubatorSpeed(level + 1))}` else `{Economy.IncubatorCapacity(level + 1)} eggs`
				info.Text = `{now}  →  {nextText}\nKept forever`
				Theme.SetButtonText(button, "Buy " .. Format.Money(cost))
				Theme.SetButtonColor(button, if money >= cost then Theme.Colors.Green else Theme.Colors.Gray)
			else
				info.Text = `{now} (MAX)`
				Theme.SetButtonText(button, "MAXED")
				Theme.SetButtonColor(button, Theme.Colors.Gray)
			end
		end
		incubatorRow("Speed", hatchInfo, hatchButton)
		incubatorRow("Size", sizeInfo, sizeButton)

		local indexBonus = State.Number("IndexBonus")
		local petBonus = State.Number("PetSpeedBonus")
		local rate = Economy.TreadmillRate(level, multLevel, passMult, indexBonus, petBonus)
		local walk = State.Number("WalkSpeed")
		local extras = {}
		if indexBonus > 0 then
			table.insert(extras, `+{indexBonus}%`)
		end
		if petBonus > 0 then
			table.insert(extras, `+{math.floor(petBonus * 100 + 0.5)}%`)
		end
		local extraText = if #extras > 0 then " (" .. table.concat(extras, " ") .. ")" else ""
		summaryText.Text = `<b>YOUR STATS</b>\nTreadmill: <font color="#c9a0ff">+{Format.Rate(rate)} speed/s</font>{extraText}\nSpeed: <font color="#c9a0ff">{Format.Number(State.Number("Speed"))}</font> (walk speed {math.floor(walk)})\nIncome: <font color="#8dff6a">{Format.Money(State.Number("Income"))}/s</font>`
	end)
end

--------------------------------------------------------------------------------
-- Game passes
--------------------------------------------------------------------------------
local function robuxText(passId: number, suggested: number): string
	if passId <= 0 then
		return `R$ {suggested}`
	end
	local price = robuxPrices[passId]
	return if price then `R$ {price}` elseif priceFailed[passId] then "BUY" else "R$ ..."
end

local function fetchPrice(passId: number, infoType: Enum.InfoType?)
	if passId <= 0 or robuxPrices[passId] then
		return
	end
	task.spawn(function()
		for attempt = 1, 3 do
			local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, passId, infoType or Enum.InfoType.GamePass)
			if ok and info and info.PriceInRobux then
				robuxPrices[passId] = info.PriceInRobux
				refreshAll()
				return
			end
			task.wait(attempt * 3)
		end
		priceFailed[passId] = true -- still buyable: the button just says BUY
		refreshAll()
	end)
end

-- Do you own this pass, or one that does exactly the same (Config.GamePasses SameAs)?
local function ownsPass(pass: Config.GamePass): boolean
	if State.Data.Passes[pass.Key] then
		return true
	end
	for _, other in Config.GamePasses do
		if other.SameAs == pass.Key and State.Data.Passes[other.Key] then
			return true
		end
	end
	return false
end

local function buildPasses(page: Frame)
	for order, pass in Config.GamePasses do
		if pass.SameAs then
			continue -- (the same as another pass: only that one is sold)
		end
		fetchPrice(pass.GamePassId)
		local c = card(page, order, pass.Color)
		local icon = if pass.Kind == "Money" then "cash" elseif pass.Kind == "Speed" then "bolt" else "globe"
		local description = if pass.Kind == "Money"
			then `Earn {pass.Multiplier}x money from every donut, forever`
			elseif pass.Kind == "Speed" then "Double speed from your treadmill, forever"
			else "Teleport to any world or area you've unlocked, any time (a TELEPORT button)"
		local drawn = Icons.Draw(icon, c, nil, nil)
		drawn.Size = UDim2.fromOffset(56, 56)
		drawn.Position = UDim2.fromOffset(10, 10)
		Theme.Label({ Text = string.upper(pass.Name), TextColor3 = pass.Color:Lerp(Color3.new(1, 1, 1), 0.3), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 12), Parent = c })
		Theme.Label({
			Text = description,
			Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 50), StrokeThickness = 1.2, Parent = c,
		})
		local button = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 48), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = c })
		button.Activated:Connect(function()
			if not ownsPass(pass) then
				State.Action("BuyPass", pass.Key)
			end
		end)
		table.insert(refreshers, function()
			if ownsPass(pass) then
				Theme.SetButtonText(button, "OWNED")
				Theme.SetButtonColor(button, Theme.Colors.Gray)
			else
				Theme.SetButtonText(button, robuxText(pass.GamePassId, pass.SuggestedPrice))
				Theme.SetButtonColor(button, Theme.Colors.Green)
			end
		end)
	end
	-- Luck Event (a developer product: can be bought again and again)
	local luck = card(page, 90, Color3.fromRGB(60, 200, 90))
	local clover = Icons.Draw("clover", luck, nil, nil)
	clover.Size = UDim2.fromOffset(56, 56)
	clover.Position = UDim2.fromOffset(10, 10)
	Theme.Label({ Text = "LUCK EVENT (10 MIN)", TextColor3 = Color3.fromRGB(140, 255, 160), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 12), Parent = luck })
	Theme.Label({ Text = `Rarer boxes x{Config.LuckEvent.RarityLuck}, mutations x{Config.LuckEvent.MutationLuck}, bigger boxes x{Config.LuckEvent.BigSizeLuck} for EVERYONE (boosted odds show in the Index)`, Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -86, 0, 36), Position = UDim2.fromOffset(74, 50), StrokeThickness = 1.2, Parent = luck })
	local luckButton = Theme.Button({ Text = `R$ {Config.LuckEvent.SuggestedPrice}`, Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 48), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = luck })
	luckButton.Activated:Connect(function()
		State.Action("BuyLuck")
	end)

	if Config.MoneyPassStacking == "Additive" then
		local note = card(page, 100, Theme.Colors.Blue)
		Theme.Label({ Text = "Money passes stack! Own 2x + 3x = 4x money.", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10), StrokeThickness = 1.5, Parent = note })
	end
end

--------------------------------------------------------------------------------
-- Crates
--------------------------------------------------------------------------------

-- What an outcome gives, in words (coins are estimated for you right now).
local function outcomeText(outcome: Crates.Outcome): string
	local reward = outcome.Reward
	if reward.Kind == "Coins" then
		local amount = Economy.CrateCoins(reward.Seconds or 60, State.Number("Speed"))
		return `Coins (~{Format.Money(amount)} for you now)`
	elseif reward.Kind == "SpeedBoost" then
		return `Speed Boost: run {math.floor((Config.Crates.SpeedBoostMultiplier - 1) * 100 + 0.5)}% faster for {Format.Duration(reward.Seconds or 600)}`
	elseif reward.Kind == "Luck" then
		return `Luck Event for the whole server ({Format.Duration(reward.Seconds or 600)})`
	elseif outcome.Egg then
		local egg = Pets.EggById[outcome.Egg]
		return if egg then egg.Name .. (if egg.CrateOnly then " (exclusive)" else "") else outcome.Egg
	elseif outcome.Pet then
		local pet = Pets.ById[outcome.Pet]
		return if pet then `{pet.Name} ({pet.Rarity} pet, exclusive)` else outcome.Pet
	end
	return reward.Kind
end

local function buildCrates(page: Frame, body: Instance)
	-- "All odds" panel (on top of the shop): every outcome, and the pets inside every egg
	local details = Theme.new("Frame", {
		Name = "CrateOdds",
		BackgroundColor3 = Theme.Colors.Panel,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 20,
		Parent = body,
	}, { Theme.Corner(14), Theme.Stroke(3) })
	local detailsTitle = Theme.Label({ Text = "", Size = UDim2.new(1, -130, 0, 36), Position = UDim2.fromOffset(12, 8), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21, Parent = details })
	local close = Theme.Button({ Text = "BACK", Color = Theme.Colors.Red, Size = UDim2.fromOffset(100, 38), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Parent = details })
	close.ZIndex = 21
	close.Activated:Connect(function()
		details.Visible = false
	end)
	local detailsText = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 52),
		Size = UDim2.new(1, -24, 1, -62),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		ZIndex = 21,
		Parent = details,
	})
	local detailsLabel = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextScaled = false, TextSize = 20, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -12, 0, 0), StrokeThickness = 1.2, ZIndex = 21, Parent = detailsText })

	local function showOdds(crate: Crates.Crate)
		detailsTitle.Text = `{string.upper(crate.Name)} - ALL ODDS`
		local lines = { "You get ONE of these (adds up to 100%). Luck and passes never change these odds.", "" }
		for _, outcome in Crates.Odds(crate) do
			table.insert(lines, `<b>{outcomeText(outcome)}: {Format.Odds(outcome.Chance)}</b>`)
			local egg = if outcome.Egg then Pets.EggById[outcome.Egg] else nil
			if egg then
				table.insert(lines, `      it hatches (after {Format.Duration(egg.HatchSeconds)}) into:`)
				for _, entry in egg.Pool do
					local pet = Pets.ById[entry.Pet]
					local inEgg = Pets.Chance(egg, entry.Pet)
					table.insert(lines, `      • {pet.Name} ({pet.Rarity}, {Pets.BonusText(pet)}): {Format.Odds(inEgg)} of the egg = {Format.Odds(outcome.Chance * inEgg)} of the crate`)
				end
			end
		end
		detailsLabel.Text = table.concat(lines, "\n")
		details.Visible = true
	end

	local spinning: { Camera } = {}
	for _, crate in Crates.List do
		local product = Config.Crates.Products[crate.Id]
		fetchPrice(product.DeveloperProductId, Enum.InfoType.Product)
		local c = card(page, crate.Order, crate.Color)
		local picture = Theme.Picture(c, UDim2.fromOffset(84, 84), UDim2.fromOffset(8, 10), crate.Color:Lerp(Color3.new(1, 1, 1), 0.2), Vector2.new(84, 84))
		local viewport = Theme.new("ViewportFrame", {
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Ambient = Color3.fromRGB(180, 180, 180),
			LightColor = Color3.fromRGB(255, 255, 255),
			LightDirection = Vector3.new(-0.5, -1, 0.8),
			ZIndex = 2,
			Parent = picture,
		})
		local model = CrateModel.Build(crate.Id, { NoEffects = true })
		model:PivotTo(CFrame.new(0, -0.3, 0))
		model.Parent = viewport
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		table.insert(spinning, camera)
		Theme.Label({ Text = string.upper(crate.Name), TextColor3 = crate.Color:Lerp(Color3.new(1, 1, 1), 0.35), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -110, 0, 32), Position = UDim2.fromOffset(100, 10), Parent = c })
		Theme.Label({ Text = "Opens right away: ONE of these", Font = Theme.Font, TextColor3 = Color3.fromRGB(200, 200, 210), TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -110, 0, 20), Position = UDim2.fromOffset(100, 44), StrokeThickness = 1, Parent = c })
		local odds = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, -20, 0, 118), Position = UDim2.fromOffset(10, 98), StrokeThickness = 1.2, Parent = c })
		local all = Theme.Button({ Text = "All odds", Color = Theme.Colors.Blue, Size = UDim2.new(0.38, -12, 0, 46), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -10), Parent = c })
		all.Activated:Connect(function()
			showOdds(crate)
		end)
		local buy = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(0.62, -12, 0, 46), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -10), Parent = c })
		buy.Activated:Connect(function()
			-- The server double-checks and explains if crates can't be bought here
			State.Action("BuyCrate", crate.Id)
		end)
		table.insert(refreshers, function()
			local lines = {}
			for _, outcome in Crates.Odds(crate) do
				table.insert(lines, `{outcomeText(outcome)} <b>{Format.Odds(outcome.Chance)}</b>`)
			end
			odds.Text = table.concat(lines, "\n")
			if State.Get("CratesBlocked") == true then
				Theme.SetButtonText(buy, "Not available in your region")
				Theme.SetButtonColor(buy, Theme.Colors.Gray)
			else
				Theme.SetButtonText(buy, robuxText(product.DeveloperProductId, product.Price))
				Theme.SetButtonColor(buy, Theme.Colors.Green)
			end
		end)
	end
	local note = card(page, 10, Theme.Colors.Orange)
	Theme.Label({ Text = "Crates also show up for free in the lane now and then - hold E to open one! Eggs go straight into your incubator.", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10), StrokeThickness = 1.5, Parent = note })
	RunService.RenderStepped:Connect(function()
		if not modal:IsOpen() then
			return
		end
		local angle = os.clock() * 0.8
		for _, camera in spinning do
			camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(angle) * 11, 4, -math.cos(angle) * 11), Vector3.new(0, 0.2, 0))
		end
	end)
	State.OnAttribute("CratesBlocked", refreshAll)
end

--------------------------------------------------------------------------------
-- Skins
--------------------------------------------------------------------------------
local function buildSkins(page: Frame)
	local note = card(page, 0, Theme.Colors.Purple)
	Theme.Label({ Text = "Skins are bought with SPEED (you'll be slower until you train it back). They're yours forever!", Font = Theme.Font, Size = UDim2.new(1, -20, 1, -20), Position = UDim2.fromOffset(10, 10), StrokeThickness = 1.5, Parent = note })
	for order, skin in Config.Skins do
		local c = card(page, order, skin.Trim)
		-- Colour swatch preview of the skin
		local swatch = Theme.new("Frame", { Size = UDim2.new(1, -20, 0, 64), Position = UDim2.fromOffset(10, 10), BackgroundColor3 = skin.Floor, Parent = c }, { Theme.Corner(10), Theme.Stroke(2) })
		for i, color in { skin.FloorAlt, skin.Fence, skin.Trim, skin.Pedestal } do
			Theme.new("Frame", { Size = UDim2.new(0.2, -4, 1, -16), Position = UDim2.new(0.04 + (i - 1) * 0.24, 0, 0, 8), BackgroundColor3 = color, Parent = swatch }, { Theme.Corner(8), Theme.Stroke(1.5) })
		end
		Theme.Label({ Text = string.upper(skin.Name), Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 80), Parent = c })
		if skin.OwnerOnly then
			-- only the game's owner sees this one
			State.OnAttribute("AdminOwner", function(value)
				c.Visible = value == true
			end)
		end
		local button = Theme.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, -20, 0, 46), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Parent = c })
		button.Activated:Connect(function()
			if State.Data.OwnedSkins[skin.Id] or skin.SpeedCost <= 0 then
				State.Action("EquipSkin", skin.Id)
			else
				State.Action("BuySkin", skin.Id)
			end
		end)
		table.insert(refreshers, function()
			local owned = skin.SpeedCost <= 0 or State.Data.OwnedSkins[skin.Id]
			if skin.OwnerOnly then
				owned = c.Visible
			end
			if State.Data.EquippedSkin == skin.Id then
				Theme.SetButtonText(button, "EQUIPPED")
				Theme.SetButtonColor(button, Theme.Colors.Gray)
			elseif owned then
				Theme.SetButtonText(button, "EQUIP")
				Theme.SetButtonColor(button, Theme.Colors.Blue)
			else
				Theme.SetButtonText(button, Format.Number(skin.SpeedCost))
				Theme.SetButtonColor(button, if State.Number("Speed") >= skin.SpeedCost then Theme.Colors.Purple else Theme.Colors.Gray)
			end
		end)
	end
end

-- Where a section starts on the page (its heading at the top of the window), in canvas pixels
local function sectionTop(name: string): number
	local heading = headers[name]
	if not heading then
		return 0
	end
	-- (positions on screen are scaled with the window; the canvas isn't)
	local ok, top = pcall(function(): number
		local holder = modal.Frame
		local k = if holder.Size.Y.Offset > 0 then holder.AbsoluteSize.Y / holder.Size.Y.Offset else 1
		if k <= 0 then
			k = 1
		end
		return (heading.AbsolutePosition.Y - scroller.AbsolutePosition.Y) / k + scroller.CanvasPosition.Y - 4
	end)
	return if ok then math.max(0, top) else 0
end

-- The section you're looking at gets a gold name on its button
local function highlight()
	local seen = SECTIONS[1].Name
	local y = scroller.CanvasPosition.Y + 40
	for _, def in SECTIONS do
		if sectionTop(def.Name) <= y then
			seen = def.Name
		end
	end
	for name, button in navButtons do
		local caption = button:FindFirstChild("Caption") :: TextLabel?
		if caption then
			caption.TextColor3 = if name == seen then Theme.Colors.Gold else Theme.Colors.White
		end
	end
end

-- Scroll to a section: gliding there (a button on the side), or straight there (opening the shop)
local lastSection = SECTIONS[1].Name
function Shop.ScrollTo(name: string, instant: boolean?)
	name = ALIASES[name] or name
	if not headers[name] then
		name = SECTIONS[1].Name
	end
	lastSection = name
	local function go(smooth: boolean)
		local target = Vector2.new(0, sectionTop(name))
		if smooth then
			TweenService:Create(scroller, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CanvasPosition = target }):Play()
		else
			scroller.CanvasPosition = target
		end
	end
	go(not instant)
	if instant then
		-- (again once the page has laid itself out: the very first time it opens it hasn't yet)
		task.delay(0.05, function()
			go(false)
		end)
	end
end

-- The section it last went to (for the tests)
function Shop.Section(): string
	return lastSection
end

function Shop.Open(tab: string?)
	modal:Open()
	refreshAll()
	Shop.ScrollTo(tab or SECTIONS[1].Name, true)
end

-- A big drawn icon with its name under it, for a section (the same look as the HUD's buttons)
local function navButton(parent: Instance, def: Section, order: number): TextButton
	local button = Theme.new("TextButton", {
		Name = def.Name,
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(100, 80),
		LayoutOrder = order,
		Parent = parent,
	}) :: TextButton
	Icons.Draw(def.Icon, button, nil, {
		Size = UDim2.fromOffset(56, 56),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
	})
	Theme.Label({ Name = "Caption", Text = def.Caption, Size = UDim2.new(1, 0, 0, 24), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), StrokeThickness = 3, ZIndex = 3, Parent = button })
	button.MouseButton1Down:Connect(function()
		Theme.Bounce(button)
	end)
	button.Activated:Connect(function()
		Shop.ScrollTo(def.Name)
	end)
	navButtons[def.Name] = button
	return button
end

function Shop.Init()
	modal = Modal.new("Shop", Theme.Colors.Green, Vector2.new(760, 500))
	-- (a little left of centre: the section buttons stand down its right side)
	modal.Frame.Position = UDim2.new(0.5, -54, 0.52, 0)
	local body = modal.Body
	scroller = Theme.new("ScrollingFrame", {
		Name = "Sections",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 20) }),
	}) :: ScrollingFrame
	local columns: { [string]: { number } } = {
		Upgrades = { 2, 190 },
		Passes = { 2, 160 },
		Crates = { 2, 290 },
		Skins = { 3, 180 },
		Trails = { 0, 0 },
		Donate = { 0, 0 },
	}
	local sections: { [string]: Frame } = {}
	for order, def in SECTIONS do
		local layout = columns[def.Name]
		sections[def.Name] = newSection(def, order, layout[1], layout[2])
	end
	buildUpgrades(sections.Upgrades)
	buildPasses(sections.Passes)
	buildCrates(sections.Crates, body)
	buildSkins(sections.Skins)
	table.insert(refreshers, Trails.Build(sections.Trails))
	table.insert(refreshers, Donate.Build(sections.Donate))
	Donate.SetOpener(function()
		Shop.Open("Donate")
	end)

	-- the section buttons, down the right side of the window
	local nav = Theme.new("Frame", {
		Name = "SectionButtons",
		BackgroundTransparency = 1,
		Position = UDim2.new(1, 8, 0, 62),
		Size = UDim2.fromOffset(100, #SECTIONS * 82),
		Parent = modal.Frame,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	for order, def in SECTIONS do
		navButton(nav, def, order)
	end
	-- (a "!" on Trails when you've unlocked one but wear none)
	local trailBadge = Theme.Label({
		Name = "Badge",
		Text = "!",
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Red,
		Size = UDim2.fromOffset(24, 24),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 28, 0, 6),
		StrokeThickness = 1.5,
		ZIndex = 5,
		Visible = false,
		Parent = navButtons.Trails,
	})
	Theme.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = trailBadge })
	table.insert(refreshers, function()
		trailBadge.Visible = Trails.IsReady()
	end)
	scroller:GetPropertyChangedSignal("CanvasPosition"):Connect(highlight)
	highlight()

	for _, name in { "Money", "Speed", "SpeedMultLevel", "TreadmillLevel", "SpeedPassMultiplier", "Income", "BaseLevel", "IndexBonus", "IncubatorSpeed", "IncubatorSize" } do
		State.OnAttribute(name, function()
			if modal:IsOpen() then
				refreshAll()
			end
		end)
	end
	State.Changed:Connect(refreshAll)

	-- Shop stalls in the lobby (if a baked map still has any): walk onto a glowing circle (or press
	-- E at the counter) to open that stall's tab. Walking off closes it again.
	task.spawn(function()
		local hub = workspace:WaitForChild("Map"):WaitForChild("Hub")
		local player = Players.LocalPlayer :: Player
		local stalls: { { Glow: BasePart, Tab: string, Inside: boolean } } = {}
		local autoOpened = false
		local function addStall(stall: Instance)
			local tab = stall:GetAttribute("ShopTab")
			if type(tab) ~= "string" then
				return
			end
			local glow = stall:WaitForChild("Glow") :: BasePart
			local promptPart = stall:WaitForChild("PromptPart")
			table.insert(stalls, { Glow = glow, Tab = tab, Inside = false })
			local proximity = Theme.new("ProximityPrompt", {
				ActionText = "Open",
				ObjectText = stall.Name,
				HoldDuration = 0,
				MaxActivationDistance = 12,
				RequiresLineOfSight = false,
				Parent = promptPart,
			})
			proximity.Triggered:Connect(function()
				Shop.Open(tab)
			end)
		end
		for _, child in hub:GetChildren() do
			task.spawn(addStall, child)
		end
		while true do
			task.wait(0.15)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			for _, stall in stalls do
				local inside = false
				if root then
					local offset = root.Position - stall.Glow.Position
					inside = Vector2.new(offset.X, offset.Z).Magnitude < stall.Glow.Size.Y / 2 and math.abs(offset.Y) < 8
				end
				if inside and not stall.Inside then
					Shop.Open(stall.Tab)
					autoOpened = true
				elseif not inside and stall.Inside and autoOpened then
					modal:Close()
					autoOpened = false
				end
				stall.Inside = inside
			end
		end
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="146">
            <Properties>
              <string name="Name">SkipButton</string>
              <string name="Source"><![CDATA[--[[
	SkipButton: the SKIP button every cutscene shares (the opening scene, the Mythic box film, the
	storm and Cosmic Domer cinematics). It stays out of the way: click or tap anywhere while a
	cutscene plays and it pops up in the bottom-right corner, on the black bar, for a few seconds.

	  SkipButton.Attach(gui, onSkip) -> the button (named "Skip"), inside `gui`. Clicking it calls
	  onSkip. Everything it listens to is let go when `gui` goes.
	  SkipButton.Show(button)          pop it up now (it hides again after SkipButton.Linger)
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)

local SkipButton = {}

SkipButton.Linger = 4 -- seconds it stays up after the last click

local hideAt: { [GuiButton]: number } = {}

function SkipButton.Show(button: GuiButton)
	local wasVisible = button.Visible
	button.Visible = true
	hideAt[button] = os.clock() + SkipButton.Linger
	if not wasVisible then
		local scale = button:FindFirstChild("PopScale") :: UIScale?
		if scale then
			scale.Scale = 0.6
			TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
	end
	local until_ = hideAt[button]
	task.delay(SkipButton.Linger + 0.05, function()
		if hideAt[button] == until_ and button.Parent then
			button.Visible = false
		end
	end)
end

function SkipButton.Attach(gui: Instance, onSkip: () -> ()): TextButton
	local button = Theme.Button({
		Name = "Skip",
		Text = "SKIP  >>",
		Color = Theme.Colors.Gray,
		Size = UDim2.fromOffset(118, 38),
		AnchorPoint = Vector2.new(1, 1),
		-- (bottom right, on the black bar)
		Position = UDim2.new(1, -18, 1, -12),
		Parent = gui,
	})
	button.Visible = false
	button.ZIndex = 20
	for _, d in button:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = 21
		end
	end
	local scale = Instance.new("UIScale")
	scale.Name = "PopScale"
	scale.Parent = button
	button.Activated:Connect(function()
		hideAt[button] = nil
		onSkip()
	end)
	local input = UserInputService.InputBegan:Connect(function(io: InputObject)
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			SkipButton.Show(button)
		end
	end)
	gui.AncestryChanged:Connect(function()
		if not gui.Parent then
			input:Disconnect()
			hideAt[button] = nil
		end
	end)
	return button
end

return SkipButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="147">
            <Properties>
              <string name="Name">SkipOdds</string>
              <string name="Source"><![CDATA[--[[
	SkipOdds: "Open now" on a box in your pen. The donut inside is only picked when the box opens,
	so opening it for Robux is buying a random item, and Roblox's rules want every donut it can
	give, with its chance, shown BEFORE the purchase. The server sends the box here
	(ProductService.SkipBox: only where paid random items are allowed); BUY asks the server for
	the purchase (the "ConfirmSkip" action).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Boxes = require(Shared.Boxes)
local Config = require(Shared.Config)
local Donuts = require(Shared.Donuts)
local Format = require(Shared.Format)
local Rarities = require(Shared.Rarities)
local Remotes = require(Shared.Remotes)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local SkipOdds = {}

-- Every donut a box from `area` of this tier can give, most likely first (adds up to 100%).
function SkipOdds.Lines(area: number, tierId: string): { string }
	local pool = Donuts.ByBox[area] and Donuts.ByBox[area][tierId] or {}
	local list = table.clone(pool)
	table.sort(list, function(a, b)
		return Donuts.Chance(a) > Donuts.Chance(b)
	end)
	local lines = {}
	for _, donut in list do
		local rarity = Rarities.Get(donut.Rarity)
		table.insert(lines, `<font color="#{rarity.Color:ToHex()}">{donut.Name}</font> ({rarity.Id}): <b>{Format.Odds(Donuts.Chance(donut))}</b>`)
	end
	return lines
end

function SkipOdds.Init()
	local modal = Modal.new("Open It Now?", Theme.Colors.Green, Vector2.new(560, 470))
	local body = modal.Body
	local heading = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 50), StrokeThickness = 1.5, Parent = body })
	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.new(1, 0, 1, -120),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = body,
	})
	local odds = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextScaled = false, TextSize = 20, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, -12, 0, 0), StrokeThickness = 1.2, Parent = scroll })
	local buy = Theme.Button({ Text = `BUY  R$ {Config.Boxes.SkipPrice}`, Color = Theme.Colors.Green, Size = UDim2.new(0.6, -6, 0, 52), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = body })
	local cancel = Theme.Button({ Text = "No thanks", Color = Theme.Colors.Gray, Size = UDim2.new(0.4, -6, 0, 52), AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Parent = body })
	local slot: number? = nil
	buy.Activated:Connect(function()
		if slot then
			State.Action("ConfirmSkip", slot)
		end
		modal:Close()
	end)
	cancel.Activated:Connect(function()
		modal:Close()
	end)
	Remotes.Event("SkipOdds").OnClientEvent:Connect(function(info: any)
		if type(info) ~= "table" or type(info.Slot) ~= "number" or type(info.Area) ~= "number" or type(info.Tier) ~= "string" then
			return
		end
		slot = info.Slot
		local mutation = Rarities.Mutation(info.Mutation)
		local name = Rarities.DisplayName(Boxes.DisplayName(info.Tier, info.Size), mutation.Id, nil)
		heading.Text = `Open your <b>{name}</b> right away. Its size and mutation are already set; the donut inside is ONE of these:`
		odds.Text = table.concat(SkipOdds.Lines(info.Area, info.Tier), "\n")
		modal:Open()
	end)
end

return SkipOdds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="148">
            <Properties>
              <string name="Name">StormMusic</string>
              <string name="Source"><![CDATA[--[[
	StormMusic: the Eternal Storm's song, the Radetzky March (Settings starts and stops it).

	The recording in Config.EternalStorm.MusicId (the Radetzky March from the Creator Store) plays,
	looped. With no id (or if it can't load: a warning says so in the Output window) a built-in version plays,
	made from sounds every Roblox client already has: the march's tune on a bright bell, an
	"oom-pah" bass and chords under it, a bass drum and snare, and a drum roll to start. (It was
	written out from memory, so it's the tune's style more than an exact copy of the score.)
]]

local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local StormMusic = {}

local LOUDNESS = 0.9
local BPM = 112 -- quarter notes a minute
local STEP = 60 / BPM / 4 -- one sixteenth note
local BELL = "rbxasset://sounds/electronicpingshort.wav"
local THUMP = "rbxasset://sounds/action_jump_land.mp3"
local TICK = "rbxasset://sounds/button.wav"
local D5_SPEED = 0.6 -- the bell's speed for the note D5 (every other note is worked out from it)
local LOAD_TIMEOUT = 8 -- seconds the recording may take to load before the built-in march takes over

-- Note names -> MIDI numbers (D major: F# and C# are sharp)
local NOTES: { [string]: number } = {
	A3 = 57, D4 = 62, E4 = 64, Fs4 = 66, G4 = 67, A4 = 69, B4 = 71, Cs5 = 73, D5 = 74, E5 = 76, Fs5 = 78, G5 = 79, A5 = 81, B5 = 83, Cs6 = 85, D6 = 86,
	A2 = 45, D3 = 50, E3 = 52, Fs3 = 54,
}

-- The tune: { note, sixteenths } per bar ("R" = rest). Chords: "D" (D F# A) or "A" (A C# E).
type Bar = { Notes: { { any } }, Chord: string }
local function bar(chord: string, notes: { { any } }): Bar
	return { Notes = notes, Chord = chord }
end
local THEME: { Bar } = {
	bar("D", { { "D5", 2 }, { "D5", 1 }, { "D5", 1 }, { "D5", 1 }, { "Cs5", 1 }, { "D5", 1 }, { "E5", 1 } }),
	bar("D", { { "Fs5", 2 }, { "Fs5", 1 }, { "Fs5", 1 }, { "Fs5", 1 }, { "E5", 1 }, { "Fs5", 1 }, { "G5", 1 } }),
	bar("A", { { "A5", 2 }, { "A5", 1 }, { "A5", 1 }, { "A5", 1 }, { "B5", 1 }, { "A5", 1 }, { "G5", 1 } }),
	bar("D", { { "Fs5", 2 }, { "A5", 2 }, { "D6", 2 }, { "R", 2 } }),
	bar("A", { { "B4", 2 }, { "B4", 1 }, { "B4", 1 }, { "B4", 1 }, { "A4", 1 }, { "B4", 1 }, { "Cs5", 1 } }),
	bar("D", { { "D5", 2 }, { "D5", 1 }, { "D5", 1 }, { "D5", 1 }, { "Cs5", 1 }, { "D5", 1 }, { "E5", 1 } }),
	bar("A", { { "Fs5", 2 }, { "E5", 2 }, { "D5", 2 }, { "Cs5", 2 } }),
	bar("D", { { "D5", 4 }, { "R", 2 }, { "A4", 2 } }),
	-- and louder, up high
	bar("A", { { "A5", 2 }, { "A5", 2 }, { "A5", 2 }, { "A5", 2 } }),
	bar("A", { { "B5", 2 }, { "A5", 2 }, { "G5", 2 }, { "Fs5", 2 } }),
	bar("A", { { "E5", 2 }, { "E5", 2 }, { "E5", 2 }, { "E5", 2 } }),
	bar("A", { { "Fs5", 2 }, { "E5", 2 }, { "D5", 2 }, { "Cs5", 2 } }),
	bar("D", { { "D5", 2 }, { "Fs5", 2 }, { "A5", 2 }, { "D6", 2 } }),
	bar("A", { { "Cs6", 2 }, { "B5", 2 }, { "A5", 2 }, { "G5", 2 } }),
	bar("A", { { "Fs5", 2 }, { "E5", 2 }, { "D5", 2 }, { "Cs5", 2 } }),
	bar("D", { { "D5", 4 }, { "R", 2 }, { "A4", 2 } }),
}
local CHORDS: { [string]: { Root: string, Fifth: string, Upper: { string } } } = {
	D = { Root = "D3", Fifth = "A2", Upper = { "Fs4", "A4" } },
	A = { Root = "A2", Fifth = "E3", Upper = { "E4", "Cs5" } },
}

local group: SoundGroup? = nil
local voices: { [string]: { Sounds: { Sound }, Next: number } } = {}
local recording: Sound? = nil
local recordingFailed = false
local playing = false
local token = 0

local function voice(name: string, id: string, volume: number, count: number)
	local list = {}
	for i = 1, count do
		local sound = Instance.new("Sound")
		sound.Name = name .. i
		sound.SoundId = id
		sound.Volume = volume
		sound.SoundGroup = group
		sound.Parent = group
		table.insert(list, sound)
	end
	voices[name] = { Sounds = list, Next = 1 }
end

-- "1844280451" works as well as "rbxassetid://1844280451"
local function contentId(id: string): string
	if string.match(id, "^%s*%d+%s*$") then
		return "rbxassetid://" .. (string.gsub(id, "%s", ""))
	end
	return id
end

local function setup()
	if group then
		return
	end
	local g = Instance.new("SoundGroup")
	g.Name = "StormMusic"
	g.Volume = 0
	g.Parent = SoundService
	group = g
	local eq = Instance.new("EqualizerSoundEffect")
	eq.LowGain = 3
	eq.MidGain = 0
	eq.HighGain = -9 -- (the bell is bright: soften it)
	eq.Priority = 3
	eq.Parent = g
	local compressor = Instance.new("CompressorSoundEffect")
	compressor.Threshold = -18
	compressor.Ratio = 3
	compressor.Priority = 2
	compressor.Parent = g
	local reverb = Instance.new("ReverbSoundEffect")
	reverb.DecayTime = 1.4
	reverb.WetLevel = -10
	reverb.Priority = 1
	reverb.Parent = g
	voice("Lead", BELL, 0.55, 3)
	voice("Chord", BELL, 0.16, 4)
	voice("Bass", BELL, 0.4, 2)
	voice("Kick", THUMP, 0.45, 2)
	voice("Snare", TICK, 0.12, 3)
	local id = Config.EternalStorm.MusicId
	if id ~= "" then
		local sound = Instance.new("Sound")
		sound.Name = "Recording"
		sound.SoundId = contentId(id)
		sound.Looped = true
		sound.Volume = 0.8
		sound.SoundGroup = g
		sound.Parent = g
		recording = sound
	end
end

local function play(name: string, speed: number)
	local v = voices[name]
	if not v then
		return
	end
	local sound = v.Sounds[v.Next]
	v.Next = v.Next % #v.Sounds + 1
	sound.PlaybackSpeed = speed
	sound.TimePosition = 0
	sound:Play()
end

local function bell(note: string): number
	return D5_SPEED * 2 ^ ((NOTES[note] - NOTES.D5) / 12)
end

-- Make the sounds now (and load them), so the storm's first note isn't late.
function StormMusic.Preload()
	setup()
	task.spawn(function()
		local list: { Instance } = {}
		for _, v in voices do
			table.insert(list, v.Sounds[1])
		end
		if recording then
			table.insert(list, recording)
		end
		pcall(function()
			ContentProvider:PreloadAsync(list, function(id: string, status: Enum.AssetFetchStatus)
				if recording and id == recording.SoundId and status == Enum.AssetFetchStatus.Failure then
					recordingFailed = true
				end
			end)
		end)
	end)
end

function StormMusic.IsPlaying(): boolean
	return playing
end

-- `volume`: the player's music volume (0-1).
function StormMusic.SetVolume(volume: number)
	if group and playing then
		TweenService:Create(group, TweenInfo.new(0.5), { Volume = volume * LOUDNESS * Config.EternalStorm.MusicVolume }):Play()
	end
end

-- The built-in march, looped: a drum roll, then the tune over and over.
local function march(myToken: number)
	local start = os.clock()
	local step = 0
	local function waitSteps(count: number)
		step += count
		local delay = start + step * STEP - os.clock()
		if delay > 0 then
			task.wait(delay)
		end
	end
	-- drum roll (two bars), then a big chord
	for i = 1, 16 do
		if not playing or token ~= myToken then
			return
		end
		play("Snare", 0.9 + (i % 2) * 0.1)
		waitSteps(1)
	end
	play("Kick", 0.42)
	play("Bass", bell("D3"))
	for _, note in CHORDS.D.Upper do
		play("Chord", bell(note))
	end
	waitSteps(6)
	play("Lead", bell("A4")) -- the pick-up into the tune
	waitSteps(2)
	while playing and token == myToken do
		for _, b in THEME do
			local chord = CHORDS[b.Chord]
			-- oom-pah under the tune: bass and drum on the beat, chord on the off-beat
			local accompaniment: { [number]: string } = { [0] = "Root", [2] = "Chord", [4] = "Fifth", [6] = "Chord" }
			local melodyAt: { [number]: string } = {}
			local at = 0
			for _, entry in b.Notes do
				melodyAt[at] = entry[1]
				at += entry[2]
			end
			for s = 0, 7 do
				if not playing or token ~= myToken then
					return
				end
				local note = melodyAt[s]
				if note and note ~= "R" then
					play("Lead", bell(note))
				end
				local part = accompaniment[s]
				if part == "Root" or part == "Fifth" then
					play("Bass", bell(if part == "Root" then chord.Root else chord.Fifth))
					play("Kick", 0.42)
				elseif part == "Chord" then
					for _, upper in chord.Upper do
						play("Chord", bell(upper))
					end
					play("Snare", 1)
				end
				waitSteps(1)
			end
		end
	end
end

function StormMusic.Start(volume: number)
	setup()
	if playing then
		StormMusic.SetVolume(volume)
		return
	end
	playing = true
	token += 1
	local myToken = token
	local g = group :: SoundGroup
	TweenService:Create(g, TweenInfo.new(0.8), { Volume = volume * LOUDNESS * Config.EternalStorm.MusicVolume }):Play()
	local track = recording
	if track and not recordingFailed then
		track.TimePosition = 0
		track:Play()
		print(`[Music] Eternal Storm: playing {track.SoundId}`)
		-- a recording that can't load (private, deleted, not an audio) falls back to the built-in march
		task.spawn(function()
			local function ready(): boolean
				return track.IsLoaded and track.TimeLength > 0
			end
			local waited = 0
			while waited < LOAD_TIMEOUT and not recordingFailed and not ready() do
				waited += task.wait(0.25)
			end
			if playing and token == myToken and not ready() then
				recordingFailed = true
				track:Stop()
				warn(`[Music] Couldn't load the Eternal Storm song ({track.SoundId}). Audio must be public or uploaded by the game's owner. Playing the built-in march instead.`)
				task.spawn(march, myToken)
			end
		end)
	else
		print("[Music] Eternal Storm: playing the built-in march")
		task.spawn(march, myToken)
	end
end

function StormMusic.Stop()
	if not playing then
		return
	end
	playing = false
	token += 1
	local g = group
	if g then
		TweenService:Create(g, TweenInfo.new(0.8), { Volume = 0 }):Play()
		local myToken = token
		task.delay(0.9, function()
			if token == myToken and recording then
				recording:Stop()
			end
		end)
	end
end

return StormMusic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="149">
            <Properties>
              <string name="Name">Teleport</string>
              <string name="Source"><![CDATA[--[[
	Teleport window: every biome and the Speed it needs. With the Teleporter game pass you can jump
	straight to the start of any biome (or home); everyone else sees what's
	ahead of them and what it takes to get there.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Format = require(Shared.Format)
local Economy = require(Shared.Economy)

local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local State = require(script.Parent.Parent.State)

local Teleport = {}

local modal: Modal.Modal
local refreshers: { () -> () } = {}

function Teleport.Open()
	modal:Open()
end

local function refreshAll()
	for _, refresh in refreshers do
		refresh()
	end
end

function Teleport.Init()
	modal = Modal.new("Biomes & Teleport", Theme.Colors.Blue, Vector2.new(760, 540))
	local body = modal.Body
	local header = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -210, 0, 44), Parent = body })
	local passButton = Theme.Button({ Text = "Get Teleporter", Color = Theme.Colors.Green, Size = UDim2.fromOffset(200, 44), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Parent = body })
	passButton.Activated:Connect(function()
		State.Action("BuyPass", "Teleporter")
	end)

	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 1, -52),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ScrollBarThickness = 8,
		Parent = body,
	}, {
		Theme.new("UIGridLayout", { CellSize = UDim2.new(0.25, -8, 0, 74), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 8) }),
	})

	local home = Theme.Button({ Text = "Home", Color = Theme.Colors.Green, Size = UDim2.new(), LayoutOrder = 0, Parent = scroll })
	home.Activated:Connect(function()
		State.Action("TeleportHome")
	end)
	for _, area in Areas.List do
		local button = Theme.Button({ Text = "", Color = area.Trim, Size = UDim2.new(), LayoutOrder = area.Id, Parent = scroll })
		button.Activated:Connect(function()
			State.Action("TeleportArea", area.Id)
		end)
		table.insert(refreshers, function()
			local hasPass = State.Data.Passes.Teleporter == true
			local escape = Economy.EscapeSpeed(area.Id)
			local need = if escape > 0 then `{Format.Number(escape)} to escape` else "start here"
			Theme.SetButtonText(button, `{area.Id}. {area.Name}\n{need}`)
			Theme.SetButtonColor(button, if hasPass then area.Trim else Theme.Colors.Gray)
		end)
	end

	table.insert(refreshers, function()
		local hasPass = State.Data.Passes.Teleporter == true
		passButton.Visible = not hasPass
		header.Text = if hasPass
			then "<b>Teleporter active!</b> Jump to any biome."
			else "The <b>Teleporter</b> pass lets you jump to any biome instantly."
	end)

	modal.OnOpen = refreshAll
	State.Changed:Connect(function()
		if modal:IsOpen() then
			refreshAll()
		end
	end)
	State.OnAttribute("Speed", function()
		if modal:IsOpen() then
			refreshAll()
		end
	end)
end

return Teleport
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme: colours, fonts and small UI building helpers - the game's own look: chunky rounded white
	text with a thick black outline (Fredoka One), windows with an orange header and a dark green
	body, and the stud pattern of the bricks everything is built from (Theme.Studs) on headers and
	cards. Messages and instructions are that text on a dark band that fades out at its ends
	(Theme.Band).
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Icons = require(script.Parent.Icons)

local Theme = {}

local rgb = Color3.fromRGB

Theme.Font = Enum.Font.FredokaOne
Theme.Title = Enum.Font.FredokaOne

Theme.Colors = {
	Green = rgb(80, 215, 50),
	Blue = rgb(30, 160, 255),
	Orange = rgb(255, 140, 30),
	Red = rgb(235, 55, 55),
	Purple = rgb(150, 70, 255),
	Yellow = rgb(255, 210, 40),
	Pink = rgb(255, 110, 190),
	Gray = rgb(120, 120, 130),
	Money = rgb(90, 255, 70),
	Speed = rgb(120, 60, 255),
	Panel = rgb(42, 45, 39), -- rows and cards inside a window: dark grey with a hint of green
	PanelLight = rgb(64, 68, 60),
	Window = rgb(64, 96, 44), -- a window's body (dark green)...
	WindowDark = rgb(36, 56, 26), -- ...darker towards the bottom
	HeaderTop = rgb(255, 202, 110), -- a window's header (orange)...
	HeaderBottom = rgb(250, 166, 46),
	Gold = rgb(255, 214, 92), -- counts next to a title: "Index (12/88)"
	Outline = rgb(15, 15, 15),
	White = rgb(255, 255, 255),
}

Theme.IsTouch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- Sound effects: quiet and soft by default. Every UI sound is made from sounds that ship with
-- Roblox (rbxasset://sounds/...), layered and softened with sound effects, so nothing has to be
-- uploaded. Paste Creator Store sounds into Config.Sounds to use your own instead.
--   Id / Volume (0-1) / Pitch (1 = normal, lower = deeper and softer); Id = "" turns it off
--   Notes  = { pitch, ... } plays it once per note, one after the other (a little jingle); a
--            note can be a list of pitches to play together (a chord)
--   Layers = more sounds played at the same time (a key's low "thock" under its click)
--   Vary   = random pitch wobble (0.04 = +-4%) so repeated clicks don't sound robotic
--   Group  = "Keys" (muffled, like a keyboard with soft switches) or "Chimes" (soft, with a bit of
--            room echo)
local PING = "rbxasset://sounds/electronicpingshort.wav"
local WHOOSH = "rbxasset://sounds/Rocket whoosh 01.wav"
local THUD = "rbxasset://sounds/action_jump_land.mp3"
local CLICK = "rbxasset://sounds/button.wav"
export type Layer = { Id: string, Volume: number, Pitch: number }
export type SoundDef = { Id: string, Volume: number, Pitch: number, Notes: { any }?, Gap: number?, Layers: { Layer }?, Vary: number?, Group: string? }
-- Musical steps above the first note (major scale), for the chimes
local THIRD, FIFTH, OCTAVE = 1.26, 1.498, 2
Theme.Sounds = {
	-- Buttons: a soft mechanical keyboard. Pressing = a muffled click over a low wooden "thock";
	-- letting go = the same, lighter and higher, like a key springing back up.
	KeyDown = { Id = CLICK, Volume = 0.09, Pitch = 0.72, Layers = { { Id = THUD, Volume = 0.3, Pitch = 2.5 } }, Vary = 0.05, Group = "Keys" },
	KeyUp = { Id = CLICK, Volume = 0.045, Pitch = 0.95, Layers = { { Id = THUD, Volume = 0.13, Pitch = 3.1 } }, Vary = 0.06, Group = "Keys" },
	-- A window popping up by itself: a deeper "space bar" thock
	Open = { Id = CLICK, Volume = 0.08, Pitch = 0.6, Layers = { { Id = THUD, Volume = 0.32, Pitch = 1.9 } }, Vary = 0.03, Group = "Keys" },
	-- Messages: soft chimes, each kind its own little tune
	Notify = { Id = PING, Volume = 0.1, Pitch = 0.8, Notes = { 1, 1.335 }, Gap = 0.08, Group = "Chimes" },
	Success = { Id = PING, Volume = 0.11, Pitch = 0.8, Notes = { 1, THIRD, FIFTH }, Gap = 0.07, Group = "Chimes" },
	Rare = { Id = PING, Volume = 0.09, Pitch = 0.8, Notes = { FIFTH, OCTAVE, OCTAVE * THIRD, OCTAVE * FIFTH }, Gap = 0.05, Group = "Chimes" },
	Error = { Id = PING, Volume = 0.1, Pitch = 0.5, Notes = { 1, 0.84 }, Gap = 0.1, Group = "Chimes" },
	Announce = { Id = PING, Volume = 0.11, Pitch = 0.72, Notes = { 1, THIRD, FIFTH, { 1, THIRD, OCTAVE } :: any }, Gap = 0.09, Group = "Chimes" },
	-- A server event starting: a rising fanfare ending on a chord, over a soft low boom
	Event = { Id = PING, Volume = 0.13, Pitch = 0.7, Notes = { 1, THIRD, FIFTH, OCTAVE, { FIFTH, OCTAVE, OCTAVE * THIRD } :: any }, Gap = 0.11, Layers = { { Id = THUD, Volume = 0.35, Pitch = 0.45 } }, Group = "Chimes" },
	-- Stealing: a quick "swipe", a rising "got it!" jingle, then the chase starts
	Grab = { Id = WHOOSH, Volume = 0.35, Pitch = 1.8 },
	Steal = { Id = PING, Volume = 0.2, Pitch = 1, Notes = { 1, 1.26, 1.5 }, Gap = 0.07 },
	Hatch = { Id = PING, Volume = 0.3, Pitch = 1.6 },
	Crack = { Id = THUD, Volume = 0.4, Pitch = 1.8 },
	-- Home safe: a bright "cha-ching" arpeggio
	Deposit = { Id = PING, Volume = 0.24, Pitch = 1, Notes = { 1, 1.26, 1.5, 2 }, Gap = 0.08 },
	Collect = { Id = PING, Volume = 0.2, Pitch = 1 },
	-- Caught: a big BONK and a whoosh as you go flying
	Caught = { Id = THUD, Volume = 0.8, Pitch = 0.55 },
	Fling = { Id = WHOOSH, Volume = 0.5, Pitch = 0.8 },
} :: { [string]: SoundDef }
Theme.Sounds.Click = Theme.Sounds.KeyDown

-- Sound groups: effects shared by every sound in them
type GroupEffects = { Equalizer: { HighGain: number, MidGain: number, LowGain: number }?, Reverb: { [string]: number }? }
local GROUPS: { [string]: GroupEffects } = {
	-- muffle the click's sharp top end (soft, "lubed" switches) and add a little body
	Keys = { Equalizer = { HighGain = -12, MidGain = -2, LowGain = 3 } },
	-- round off the ping into a bell, with a small room around it
	Chimes = { Equalizer = { HighGain = -8, MidGain = 0, LowGain = 1 }, Reverb = { DecayTime = 1.3, Density = 1, Diffusion = 1, DryLevel = 0, WetLevel = -13 } },
}
local soundFolder: Folder? = nil
local soundGroups: { [string]: SoundGroup } = {}
local function folder(): Folder
	if not soundFolder then
		local f = Instance.new("Folder")
		f.Name = "UISounds"
		f.Parent = SoundService
		for name, effects in GROUPS do
			local group = Instance.new("SoundGroup")
			group.Name = name
			group.Volume = 1
			local equalizer = effects.Equalizer
			if equalizer then
				local eq = Instance.new("EqualizerSoundEffect")
				eq.HighGain = equalizer.HighGain
				eq.MidGain = equalizer.MidGain
				eq.LowGain = equalizer.LowGain
				eq.Priority = 1
				eq.Parent = group
			end
			local reverb = effects.Reverb
			if reverb then
				local effect = Instance.new("ReverbSoundEffect")
				for key, value in reverb do
					(effect :: any)[key] = value
				end
				effect.Priority = 0
				effect.Parent = group
			end
			group.Parent = f
			soundGroups[name] = group
		end
		soundFolder = f
	end
	return soundFolder :: Folder
end

local random = Random.new()
local function playOnce(id: string, volume: number, pitch: number, group: string?)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.PlaybackSpeed = pitch
	local holder = folder()
	if group then
		sound.SoundGroup = soundGroups[group]
	end
	sound.Parent = holder
	sound:Play()
	task.delay(4, function()
		sound:Destroy()
	end)
end

-- Config.Sounds: pasted Creator Store sounds replace the built-in ones (until one fails to load)
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local custom: { [string]: string } = {}
for name, id in Config.Sounds :: { [string]: any } do
	if type(id) == "string" and id ~= "" then
		custom[name] = id
	end
end
if next(custom) then
	task.spawn(function()
		local list = {}
		for name, id in custom do
			local probe = Instance.new("Sound")
			probe.Name = name
			probe.SoundId = id
			table.insert(list, probe)
		end
		pcall(function()
			ContentProvider:PreloadAsync(list, function(contentId: string, status: Enum.AssetFetchStatus)
				if status == Enum.AssetFetchStatus.Failure then
					for name, id in custom do
						if id == contentId then
							custom[name] = nil
							warn(`[Sounds] Config.Sounds.{name} ({id}) couldn't load, so the built-in sound plays instead.`)
						end
					end
				end
			end)
		end)
	end)
end

local lastSound = 0
function Theme.PlaySound(name: string, _volume: number?)
	if name ~= "KeyDown" and name ~= "KeyUp" then
		lastSound = os.clock()
	end
	local own = custom[name]
	if own then
		playOnce(own, Config.Sounds.CustomVolume, 1, nil)
		return
	end
	local def = Theme.Sounds[name]
	if not def or def.Id == "" then
		return
	end
	local wobble = if def.Vary then 1 + random:NextNumber(-def.Vary, def.Vary) else 1
	if def.Layers then
		for _, layer in def.Layers do
			playOnce(layer.Id, layer.Volume, layer.Pitch * wobble, def.Group)
		end
	end
	local notes = def.Notes
	if notes then
		task.spawn(function()
			for i, note in notes do
				if type(note) == "table" then
					for _, pitch in note do
						playOnce(def.Id, def.Volume * 0.8, def.Pitch * pitch, def.Group)
					end
				else
					playOnce(def.Id, def.Volume, def.Pitch * note * wobble, def.Group)
				end
				if i < #notes then
					task.wait(def.Gap or 0.08)
				end
			end
		end)
	else
		playOnce(def.Id, def.Volume, def.Pitch * wobble, def.Group)
	end
end

-- Every button in `root` (now and later) clicks like a soft keyboard key: down when pressed, up
-- when let go. Give a button the attribute Silent = true to keep it quiet.
local lastKey = 0
local wired: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local function wireButton(button: GuiButton)
	if wired[button] then
		return -- (moved to another frame: already clicks)
	end
	wired[button] = true
	button.MouseButton1Down:Connect(function()
		if not button:GetAttribute("Silent") then
			lastKey = os.clock()
			Theme.PlaySound("KeyDown")
		end
	end)
	button.MouseButton1Up:Connect(function()
		if not button:GetAttribute("Silent") then
			Theme.PlaySound("KeyUp")
		end
	end)
end
function Theme.WireClickSounds(root: Instance)
	for _, child in root:GetDescendants() do
		if child:IsA("GuiButton") then
			wireButton(child)
		end
	end
	root.DescendantAdded:Connect(function(child: Instance)
		if child:IsA("GuiButton") then
			wireButton(child)
		end
	end)
end

-- Seconds since the last button press (a window opened by a click doesn't need its own sound).
function Theme.SinceKeyPress(): number
	return os.clock() - lastKey
end

-- Seconds since the last sound other than a key click (so chimes don't pile up on each other).
function Theme.SinceSound(): number
	return os.clock() - lastSound
end

-- Instance.new with a property table and optional children.
function Theme.new(className: string, props: { [string]: any }?, children: { any }?): any
	local instance = Instance.new(className :: any)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.Corner(radius: number?): any
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Theme.Stroke(thickness: number?, color: Color3?, mode: Enum.ApplyStrokeMode?): any
	return Theme.new("UIStroke", {
		Thickness = thickness or 3,
		Color = color or Theme.Colors.Outline,
		ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
	})
end

function Theme.Gradient(top: Color3, bottom: Color3): any
	return Theme.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = 90 })
end

function Theme.Padding(px: number): any
	local u = UDim.new(0, px)
	return Theme.new("UIPadding", { PaddingTop = u, PaddingBottom = u, PaddingLeft = u, PaddingRight = u })
end

-- Outlined text label (thick black stroke like the reference UI).
function Theme.Label(props: { [string]: any }): TextLabel
	local label = Theme.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Theme.Title,
		TextColor3 = Theme.Colors.White,
		TextScaled = true,
		Text = "",
	})
	for key, value in props do
		if key ~= "Parent" and key ~= "StrokeThickness" and key ~= "StrokeColor" then
			(label :: any)[key] = value
		end
	end
	Theme.new("UIStroke", {
		Thickness = props.StrokeThickness or 2.5,
		Color = props.StrokeColor or Theme.Colors.Outline,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = label,
	})
	label.Parent = props.Parent
	return label
end

-- The stud pattern: a grid of studs filling `parent` (`size` = the area to cover, in pixels), each
-- drawn as the little shadow on its left and bottom edges, over whatever is behind it - like the
-- top of a brick. `Cell` = stud spacing, `Color`/`Transparency` = the shadows'.
export type StudOptions = { Cell: number?, Color: Color3?, Transparency: number?, ZIndex: number? }
function Theme.Studs(parent: Instance, size: Vector2, options: StudOptions?): Frame
	local o: StudOptions = options or {}
	local cell = o.Cell or 18
	local color = o.Color or Color3.new(0, 0, 0)
	local transparency = o.Transparency or 0.78
	local zIndex = o.ZIndex or 1
	local holder = Instance.new("Frame")
	holder.Name = "Studs"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	holder.ClipsDescendants = true
	holder.ZIndex = zIndex
	local stud = math.floor(cell * 0.58 + 0.5) -- a stud's width
	local line = math.max(1, math.floor(cell * 0.12 + 0.5)) -- its shadow's thickness
	local offset = math.floor((cell - stud) / 2)
	local function bar(x: number, y: number, w: number, h: number)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = color
		f.BackgroundTransparency = transparency
		f.Position = UDim2.fromOffset(x, y)
		f.Size = UDim2.fromOffset(w, h)
		f.ZIndex = zIndex
		f.Parent = holder
	end
	for i = 0, math.ceil(size.X / cell) - 1 do
		for j = 0, math.ceil(size.Y / cell) - 1 do
			local x, y = i * cell + offset, j * cell + offset
			bar(x, y, line, stud - line) -- its left edge
			bar(x, y + stud - line, stud, line) -- its bottom edge
		end
	end
	holder.Parent = parent
	return holder
end

-- A card inside a window, like the rows of the reference: dark, a thick black outline, slightly
-- rounded, with a line of `accent` along its top.
function Theme.Card(parent: Instance, order: number, accent: Color3): Frame
	local card = Theme.new("Frame", {
		BackgroundColor3 = Theme.Colors.Panel,
		BackgroundTransparency = 0.05,
		LayoutOrder = order,
	}, {
		Theme.Corner(6),
		Theme.Stroke(3),
	})
	Theme.new("Frame", { Name = "Accent", BackgroundColor3 = accent, BorderSizePixel = 0, Position = UDim2.fromOffset(6, 0), Size = UDim2.new(1, -12, 0, 4), Parent = card })
	card.Parent = parent
	return card
end

-- A picture area on studs in `color` (the reference's item pictures): put a see-through
-- ViewportFrame in it. `area` = how much of it the studs cover (its biggest size, in pixels).
function Theme.Picture(parent: Instance, size: UDim2, position: UDim2, color: Color3, area: Vector2): Frame
	local picture = Theme.new("Frame", {
		Name = "Picture",
		BackgroundColor3 = color,
		ClipsDescendants = true,
		Size = size,
		Position = position,
	}, {
		Theme.Corner(6),
		Theme.Stroke(2),
	})
	Theme.Studs(picture, area, { Cell = 22, Transparency = 0.72 })
	picture.Parent = parent
	return picture
end

-- A dark band behind a line of text (messages, instructions, the tutorial): see-through black that
-- fades away towards both ends, with no edge - like a shadow the text sits on.
function Theme.Band(props: { [string]: any }): Frame
	local band = Theme.new("Frame", {
		Name = "Band",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
	})
	for key, value in props do
		if key ~= "Parent" and key ~= "Darkness" then
			(band :: any)[key] = value
		end
	end
	local dark = 1 - (props.Darkness or 0.6)
	Theme.new("UIGradient", {
		Name = "Fade",
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, dark),
			NumberSequenceKeypoint.new(0.8, dark),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = band,
	})
	band.Parent = props.Parent
	return band
end

local function lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

local function darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end
Theme.Lighten = lighten
Theme.Darken = darken

-- Pop animation on press.
function Theme.Bounce(button: GuiObject)
	local scale = button:FindFirstChild("BounceScale") :: UIScale?
	if not scale then
		scale = Theme.new("UIScale", { Name = "BounceScale", Parent = button })
	end
	local s = scale :: UIScale
	s.Scale = 0.9
	TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Big chunky button: coloured gradient, dark outline, outlined text, optional icon (a UI/Icons name).
function Theme.Button(props: {
	Text: string,
	Color: Color3,
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Icon: string?,
	Parent: Instance?,
	LayoutOrder: number?,
	Name: string?,
	TextSize: number?,
}): TextButton
	local button = Theme.new("TextButton", {
		Name = props.Name or "Button",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
	}, {
		Theme.Corner(9),
		Theme.Stroke(3.5),
		Theme.Gradient(lighten(props.Color, 0.3), darken(props.Color, 0.12)),
	})
	button:SetAttribute("BaseColor", props.Color)
	local textX = 0
	if props.Icon then
		local drawn = Icons.For(props.Icon)
		if drawn then
			-- a chunky white outlined icon (UI/Icons)
			Icons.Draw(drawn, button, props.Color, {
				Size = UDim2.fromScale(0.74, 0.74),
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 8, 0.5, 0),
			})
		end
		textX = 0.3
	end
	Theme.Label({
		Name = "Text",
		Text = props.Text,
		Size = UDim2.new(1 - textX, -10, 0.7, 0),
		Position = UDim2.new(textX, if props.Icon then 0 else 5, 0.15, 0),
		Parent = button,
	})
	button.MouseButton1Down:Connect(function()
		Theme.Bounce(button) -- (the click sound comes from Theme.WireClickSounds)
	end)
	button.Parent = props.Parent
	return button
end

-- Recolour a Theme.Button (e.g. grey when you can't afford something).
function Theme.SetButtonColor(button: TextButton, color: Color3)
	local gradient = button:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = ColorSequence.new(lighten(color, 0.25), darken(color, 0.1))
	end
end

function Theme.SetButtonText(button: TextButton, text: string)
	local label = button:FindFirstChild("Text") :: TextLabel?
	if label then
		label.Text = text
	end
end

-- Keeps a UIScale in sync with the screen size (UI is designed for 1280x720, then drawn at
-- Theme.UIScale of that so it stays out of the way of the game).
Theme.UIScale = 0.82
local scales: { UIScale } = {}
local function currentScale(): number
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	return math.clamp(math.min(size.X / 1280, size.Y / 720), 0.55, 1.2) * Theme.UIScale
end

function Theme.CurrentScale(): number
	return currentScale()
end

function Theme.AutoScale(target: GuiObject): UIScale
	local scale = Theme.new("UIScale", { Name = "AutoScale", Scale = currentScale(), Parent = target })
	table.insert(scales, scale)
	return scale
end

local function hookCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			local value = currentScale()
			for _, scale in scales do
				scale.Scale = value
			end
		end)
	end
end
hookCamera()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)

function Theme.PlayerGui(): PlayerGui
	return (Players.LocalPlayer :: Player):WaitForChild("PlayerGui") :: PlayerGui
end

function Theme.ScreenGui(name: string, displayOrder: number?): ScreenGui
	return Theme.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		IgnoreGuiInset = false,
		Parent = Theme.PlayerGui(),
	})
end

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">Trails</string>
              <string name="Source"><![CDATA[--[[
	Trails: the Trails section of the Shop, right after Skins (its button on the Shop's side shows a
	"!" when one is unlocked but you wear none, and so does the HUD's Shop button). Every trail, what it looks like,
	and how to get it. Locked trails show how much Speed they still need; unlocked ones can be put
	on and taken off. The effects themselves are drawn by client/TrailFX. The server checks every press.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Areas = require(Shared.Areas)
local Format = require(Shared.Format)
local TrailList = require(Shared.Trails)

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Trails = {}

type Card = { Button: TextButton, Status: TextLabel, Fill: Frame, Bar: Frame }

local page: GuiObject
local cards: { [string]: Card } = {}

local function unlocked(trail: TrailList.Trail): boolean
	return TrailList.IsUnlocked(trail, State.Data.OwnedTrails, State.Number("BestSpeed"))
end

-- True when a trail is unlocked but you wear none (a "!" on the Shop button and its Trails button).
function Trails.IsReady(): boolean
	if State.Get("Trail") ~= nil then
		return false
	end
	for _, trail in TrailList.List do
		if unlocked(trail) then
			return true
		end
	end
	return false
end

-- A little picture of the trail: a runner with fading see-through copies behind them and a glass
-- pane cracking (made of plain UI, so it costs nothing).
local function preview(parent: Instance, trail: TrailList.Trail)
	-- on studs, like every picture in the game's windows
	local box = Theme.Picture(parent, UDim2.fromOffset(150, 150), UDim2.fromOffset(10, 10), Color3.fromRGB(60, 96, 150), Vector2.new(150, 150))
	-- glass pane with cracks, behind the runner
	local pane = Theme.new("Frame", { Size = UDim2.fromOffset(52, 78), Position = UDim2.fromOffset(12, 30), Rotation = -8, BackgroundColor3 = trail.Color, BackgroundTransparency = 0.7, Parent = box }, {
		Theme.new("UIStroke", { Color = trail.Accent, Thickness = 2, Transparency = 0.1 }),
	})
	for i, crack in { { 0.5, 0.45, 40, 0.8 }, { 0.35, 0.6, -35, 0.6 }, { 0.62, 0.3, 70, 0.5 } } do
		Theme.new("Frame", { Name = "Crack" .. i, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(crack[1], crack[2]), Size = UDim2.new(crack[4], 0, 0, 2), Rotation = crack[3], BackgroundColor3 = trail.Accent, BorderSizePixel = 0, Parent = pane })
	end
	-- shards flying off it
	for i, shard in { { 4, 22, 25 }, { 70, 18, -30 }, { 8, 112, 50 }, { 66, 116, -60 }, { 40, 12, 15 } } do
		Theme.new("Frame", { Name = "Shard" .. i, Size = UDim2.fromOffset(9, 5), Position = UDim2.fromOffset(shard[1], shard[2]), Rotation = shard[3], BackgroundColor3 = trail.Color, BackgroundTransparency = 0.35, Parent = box }, {
			Theme.new("UIStroke", { Color = trail.Accent, Thickness = 1 }),
		})
	end
	-- the afterimages, oldest (faintest) first, and the runner in front: a blocky figure mid-stride
	for i = 1, 4 do
		local x, y = 30 + i * 13, 50
		local transparency = if i == 4 then 0 else 0.85 - i * 0.15
		for _, piece in {
			{ 22, 0, 16, 16, 0 }, -- head
			{ 20, 17, 20, 24, 8 }, -- body (leaning into the run)
			{ 8, 20, 8, 20, 50 }, -- back arm
			{ 40, 18, 8, 20, -45 }, -- front arm
			{ 14, 40, 9, 24, 35 }, -- back leg
			{ 34, 40, 9, 24, -30 }, -- front leg
		} do
			Theme.new("Frame", {
				Name = "Runner",
				Position = UDim2.fromOffset(x + piece[1], y + piece[2]),
				Size = UDim2.fromOffset(piece[3], piece[4]),
				Rotation = piece[5],
				BackgroundColor3 = trail.Color,
				BackgroundTransparency = transparency,
				BorderSizePixel = 0,
				ZIndex = 2 + i,
				Parent = box,
			})
		end
	end
end

local function buildCard(list: Instance, trail: TrailList.Trail)
	local card = Theme.Card(list, trail.Order, trail.Color)
	card.Name = trail.Id
	card.Size = UDim2.new(1, -12, 0, 170)
	preview(card, trail)
	Theme.Label({ Text = `{string.upper(trail.Name)} TRAIL`, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = trail.Color, Size = UDim2.new(1, -184, 0, 34), Position = UDim2.fromOffset(174, 10), Parent = card })
	Theme.Label({ Text = trail.Description, Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.new(1, -184, 0, 44), Position = UDim2.fromOffset(174, 46), StrokeThickness = 1.2, Parent = card })
	local status = Theme.Label({ Text = "", Font = Theme.Font, RichText = true, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -184, 0, 22), Position = UDim2.fromOffset(174, 92), StrokeThickness = 1.2, Parent = card })
	local bar = Theme.new("Frame", { Size = UDim2.new(1, -330, 0, 22), Position = UDim2.fromOffset(174, 128), BackgroundColor3 = Theme.Colors.Outline, Parent = card }, { Theme.Corner(8), Theme.Stroke(2) })
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Colors.Speed, Parent = bar }, { Theme.Corner(8) })
	local button = Theme.Button({ Text = "WEAR", Color = Theme.Colors.Green, Size = UDim2.fromOffset(140, 46), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -10, 1, -10), Parent = card })
	button.Activated:Connect(function()
		if not unlocked(trail) then
			if trail.Cost then
				State.Action("BuyTrail", trail.Id)
			end
			return
		end
		State.Action("EquipTrail", if State.Get("Trail") == trail.Id then "" else trail.Id)
	end)
	cards[trail.Id] = { Button = button, Status = status, Fill = fill, Bar = bar }
end

local function refresh()
	local best = State.Number("BestSpeed")
	local wearing = State.Get("Trail")
	for _, trail in TrailList.List do
		local card = cards[trail.Id]
		if card then
			local need = TrailList.RequiredSpeed(trail)
			local open = unlocked(trail)
			card.Bar.Visible = not open and need ~= nil
			if open then
				local on = wearing == trail.Id
				card.Status.Text = if on then `<font color="#8dff6a">You're wearing it</font>` else "Unlocked"
				Theme.SetButtonText(card.Button, if on then "TAKE OFF" else "WEAR")
				Theme.SetButtonColor(card.Button, if on then Theme.Colors.Orange else Theme.Colors.Green)
			elseif trail.Cost then
				card.Status.Text = `Costs <font color="#8dff6a"><b>{Format.Money(trail.Cost)}</b></font>`
				Theme.SetButtonText(card.Button, "BUY " .. Format.Money(trail.Cost))
				Theme.SetButtonColor(card.Button, Theme.Colors.Green)
			elseif need then
				local area = trail.UnlockBiome and Areas.List[trail.UnlockBiome]
				card.Status.Text = `Reach <font color="#c9a0ff"><b>{Format.Number(need)}</b></font> Speed{if area then ` (biome {area.Id}: {area.Name})` else ""}`
				card.Fill.Size = UDim2.fromScale(math.clamp(best / need, 0, 1), 1)
				Theme.SetButtonText(card.Button, "LOCKED")
				Theme.SetButtonColor(card.Button, Theme.Colors.Gray)
			else
				card.Status.Text = "Coming soon"
				Theme.SetButtonText(card.Button, "LOCKED")
				Theme.SetButtonColor(card.Button, Theme.Colors.Gray)
			end
		end
	end
end

-- Fills the Shop's Trails section (a list) and returns its refresh, which the Shop runs whenever
-- it opens.
function Trails.Build(list: GuiObject): () -> ()
	page = list
	Theme.Label({
		Name = "About", LayoutOrder = 0,
		Text = "Trails show behind you while you run fast. Everyone near you can see them!",
		Font = Theme.Font, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -12, 0, 26), StrokeThickness = 1.4, Parent = list,
	})
	for _, trail in TrailList.List do
		buildCard(list, trail)
	end
	State.Changed:Connect(refresh)
	State.OnAttribute("Trail", refresh)
	State.OnAttribute("BestSpeed", function()
		if page.Visible then
			refresh()
		end
	end)
	refresh()
	return refresh
end

return Trails
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--[[
	Tutorial: a guided first game. While it runs it's the header at the top of the screen
	(UI/Notifications): "TUTORIAL 3/7" and then what to do next in big outlined letters on a dark
	band that fades out at its ends, with a Skip Tutorial button under it. Biome names don't
	interrupt it; announcements fade it out for a few seconds and it comes back. And and a red arrow floating over your head points the
	way (a second red arrow bobs over the target):
	  1. follow the arrow to the first biome
	  2. steal a donut box (walk up to one next to Domer and press E)
	  3. run back to the lobby before Domer catches you (caught? steal another one)
	  4. go into your pen, hold the box and click to put it down
	  5. wait for its timer, then click it to open it (the donut lands in your inventory)
	  6. hold the donut and click in your pen: it walks around and makes money
	  7. run on your treadmill to get faster
	Then a Claim button gives you a free egg (once ever; the server checks).
	It starts on your first join and keeps coming back until you finish or skip it; Settings >
	How to play starts it again.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Remotes = require(Shared.Remotes)
local Theme = require(script.Parent.Theme)
local Notifications = require(script.Parent.Notifications)
local UpdateNotes = require(script.Parent.UpdateNotes)
local State = require(script.Parent.Parent.State)
local AreaTracker = require(script.Parent.Parent.AreaTracker)
local Bases = require(script.Parent.Parent.Bases)

local Tutorial = {}

local player = Players.LocalPlayer :: Player
local RED = Color3.fromRGB(235, 40, 40)
local STEPS = { "Lane", "Steal", "RunHome", "PlaceBox", "Wait", "PlaceDonut", "Treadmill" }
local TREADMILL_GOAL = 3 -- Speed to gain on the treadmill to finish
local TEXT: { [string]: string } = {
	Lane = "Follow the red arrow to the first biome",
	Steal = `Walk up to a donut box next to {Config.Guard.Name} and press E to steal it`,
	RunHome = `Run back to the lobby before {Config.Guard.Name} catches you!`,
	Caught = `{Config.Guard.Name} caught you! Steal another box and try again`,
	PlaceBox = "Go into your pen, hold the box and click to put it down",
	Wait = "Wait for the timer over your box, then click the box to open it!",
	PlaceDonut = "Your donut is in your inventory! Hold it and click in your pen",
	Treadmill = "Your donut makes money! Now run on your treadmill!",
	Done = "Tutorial complete! Claim your free egg",
	Claimed = "Tutorial complete!",
}

local step: string? = nil -- nil while the tutorial isn't running
local caught = false
local boxesAtStart = 0
local donutsAtStart = 0
local speedAtStart = 0
local refresh: () -> ()

local function number(name: string): number
	local value = player:GetAttribute(name)
	return if type(value) == "number" then value else 0
end

-- Speed gained on the treadmill since the Treadmill step began (0 to TREADMILL_GOAL).
local function treadmillGained(): number
	return math.clamp(math.floor(number("Speed") - speedAtStart), 0, TREADMILL_GOAL)
end

local function go(nextStep: string?)
	step = nextStep
	if nextStep == "PlaceBox" then
		boxesAtStart = number("BoxesPlaced")
	elseif nextStep == "PlaceDonut" then
		donutsAtStart = number("DonutsPlaced")
	elseif nextStep == "Treadmill" then
		speedAtStart = number("Speed")
	end
	refresh()
end

function Tutorial.Start()
	caught = false
	go("Lane")
end
Tutorial.Open = Tutorial.Start -- Settings > How to play

function Tutorial.IsRunning(): boolean
	return step ~= nil
end

--------------------------------------------------------------------------------
-- The red arrows: one over your head pointing the way, one bobbing over the target
--------------------------------------------------------------------------------
type Arrow = { Parts: { BasePart }, Offsets: { CFrame } }

local function newArrow(parent: Instance, scale: number): Arrow
	local arrow: Arrow = { Parts = {}, Offsets = {} }
	local function piece(size: Vector3, offset: CFrame)
		local part = Instance.new("Part")
		part.Name = "TutorialArrow"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = RED
		part.Size = size * scale
		part.Parent = parent
		table.insert(arrow.Parts, part)
		table.insert(arrow.Offsets, CFrame.new(offset.Position * scale) * offset.Rotation)
	end
	-- points along -Z: a shaft and a chevron at the tip
	piece(Vector3.new(0.7, 0.7, 5), CFrame.new(0, 0, 0.5))
	for _, side in { -1, 1 } do
		piece(Vector3.new(0.7, 0.7, 2.8), CFrame.new(side * 0.9, 0, -2.13) * CFrame.Angles(0, side * math.rad(40), 0))
	end
	return arrow
end

local function place(arrow: Arrow, cf: CFrame?)
	for i, part in arrow.Parts do
		if cf then
			part.CFrame = cf * arrow.Offsets[i]
			part.Transparency = 0
		else
			part.Transparency = 1
		end
	end
end

-- Where the arrows should point for the current step.
local nearestBox: Vector3? = nil
local lastScan = 0
local function laneStart(): Vector3
	return Vector3.new(0, 0, Layout.AreaStart(1) + 15)
end

-- The nearest box you can steal in the biome you're in.
local function findBox(from: Vector3): Vector3?
	local area = AreaTracker.Current
	local map = workspace:FindFirstChild("Map")
	local lane = map and map:FindFirstChild("Lane")
	local folder = lane and lane:FindFirstChild("Area" .. area)
	if area <= 0 or not folder then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for _, prompt in folder:GetDescendants() do
		if prompt:IsA("ProximityPrompt") and prompt.Name == "StealPrompt" and prompt.Enabled then
			local holder = prompt.Parent
			if holder and holder:IsA("BasePart") then
				local distance = (holder.Position - from).Magnitude
				if distance < bestDistance then
					best, bestDistance = holder.Position, distance
				end
			end
		end
	end
	return best
end

local function target(from: Vector3): Vector3?
	local plot = Bases.Mine()
	if step == "Lane" then
		return laneStart()
	elseif step == "Steal" then
		local now = os.clock()
		if now - lastScan > 0.75 then
			lastScan = now
			nearestBox = findBox(from)
		end
		return nearestBox or laneStart()
	elseif step == "RunHome" then
		return Vector3.new(from.X, 0, Config.Map.SafeZoneZ - 30)
	elseif (step == "PlaceBox" or step == "PlaceDonut") and plot then
		return plot:GetPivot().Position
	elseif step == "Wait" and plot then
		for _, child in plot:GetChildren() do
			if child:IsA("Model") and string.sub(child.Name, 1, 6) == "PenBox" then
				return child:GetPivot().Position
			end
		end
		return plot:GetPivot().Position
	elseif step == "Treadmill" and plot then
		local treadmill = plot:FindFirstChild("Treadmill")
		local belt = treadmill and treadmill:FindFirstChild("Belt")
		return if belt and belt:IsA("BasePart") then belt.Position else plot:GetPivot().Position
	end
	return nil
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------
function Tutorial.Init()
	-- The header: what to do, big, with Skip / Claim under it
	local strip = Theme.Band({
		Name = "Strip",
		Size = UDim2.new(1, 0, 0, 124),
		Darkness = 0.62,
		Visible = false,
	})
	local counter = Theme.Label({ Name = "Counter", Text = "", Font = Theme.Font, TextColor3 = Theme.Colors.Gold, Size = UDim2.new(1, -180, 0, 24), Position = UDim2.fromOffset(90, 6), StrokeThickness = 2.5, Parent = strip })
	local label = Theme.Label({ Name = "Text", Text = "", Size = UDim2.new(1, -180, 0, 50), Position = UDim2.fromOffset(90, 32), StrokeThickness = 4, Parent = strip })
	local buttons = Theme.new("Frame", { Name = "Buttons", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 88), Parent = strip }, {
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local skip = Theme.Button({ Name = "Skip", Text = "Skip Tutorial", Color = Theme.Colors.Gray, Size = UDim2.fromOffset(150, 30), LayoutOrder = 1, Parent = buttons })
	local claim = Theme.Button({ Name = "Claim", Text = "Claim your egg", Color = Theme.Colors.Green, Size = UDim2.fromOffset(170, 30), LayoutOrder = 2, Parent = buttons })
	local close = Theme.Button({ Name = "Close", Text = "Close", Color = Theme.Colors.Gray, Size = UDim2.fromOffset(110, 30), LayoutOrder = 3, Parent = buttons })
	Notifications.SetPersistentHeader(strip, false)

	local arrows = Instance.new("Folder")
	arrows.Name = "TutorialArrows"
	arrows.Parent = workspace
	local guide = newArrow(arrows, 1)
	local marker = newArrow(arrows, 1.4)
	place(guide, nil)
	place(marker, nil)

	refresh = function()
		strip.Visible = step ~= nil
		Notifications.SetPersistentHeader(strip, step ~= nil)
		if not step then
			return
		end
		local index = table.find(STEPS, step)
		counter.Text = if index then `TUTORIAL {index}/{#STEPS}` else "TUTORIAL"
		local claimed = State.Data.TutorialEggClaimed == true
		if step == "Done" then
			label.Text = if claimed then TEXT.Claimed else TEXT.Done
		elseif step == "Treadmill" then
			-- how far along you are, like "Run on your treadmill! 1/3 Speed"
			label.Text = `{TEXT.Treadmill} {treadmillGained()}/{TREADMILL_GOAL} Speed`
		else
			label.Text = if step == "Steal" and caught then TEXT.Caught else TEXT[step]
		end
		skip.Visible = step ~= "Done"
		claim.Visible = step == "Done" and not claimed
		close.Visible = step == "Done" and claimed
	end

	skip.Activated:Connect(function()
		State.Action("SeenTutorial")
		go(nil)
	end)
	claim.Activated:Connect(function()
		State.Action("ClaimTutorialEgg")
		label.Text = TEXT.Claimed
		claim.Visible = false
		task.delay(2.5, function()
			if step == "Done" then
				go(nil)
			end
		end)
	end)
	close.Activated:Connect(function()
		State.Action("SeenTutorial")
		go(nil)
	end)

	-- Stealing a box, getting caught and bringing it back
	Remotes.Event("ChaseEnded").OnClientEvent:Connect(function(info: any)
		if type(info) ~= "table" or info.Kind ~= "Box" then
			return
		end
		if step == "RunHome" or step == "Steal" then
			if info.Result == "Deposited" then
				go("PlaceBox")
			elseif info.Result == "Caught" or info.Result == "Lost" then
				caught = true
				go("Steal")
			end
		end
	end)
	-- Your box opened
	Remotes.Event("BoxOpened").OnClientEvent:Connect(function(info: any)
		if type(info) == "table" and info.Owner == player and (step == "Wait" or step == "PlaceBox") then
			go("PlaceDonut")
		end
	end)

	RunService.RenderStepped:Connect(function()
		if not step then
			place(guide, nil)
			place(marker, nil)
			return
		end
		-- move on when the step is done
		if step == "Lane" and AreaTracker.Current > 0 then
			go("Steal")
		elseif step == "Steal" and player:GetAttribute("CarryKind") == "Box" then
			caught = false
			go("RunHome")
		elseif step == "PlaceBox" and number("BoxesPlaced") > boxesAtStart then
			go("Wait")
		elseif step == "PlaceDonut" and number("DonutsPlaced") > donutsAtStart then
			go("Treadmill")
		elseif step == "Treadmill" then
			if number("Speed") >= speedAtStart + TREADMILL_GOAL then
				go("Done")
			elseif not string.find(label.Text, `{treadmillGained()}/{TREADMILL_GOAL}`, 1, true) then
				refresh() -- (the Speed count went up)
			end
		end
		-- point the way
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local goal = if root and step ~= "Done" then target(root.Position) else nil
		if not root or not goal then
			place(guide, nil)
			place(marker, nil)
			return
		end
		local t = os.clock()
		local bob = math.sin(t * 3) * 0.4
		local here = root.Position + Vector3.new(0, 6.5 + bob, 0)
		local flat = Vector3.new(goal.X - here.X, 0, goal.Z - here.Z)
		if flat.Magnitude > 4 then
			local ahead = flat.Unit
			local right = Vector3.yAxis:Cross(-ahead)
			place(guide, CFrame.fromMatrix(here, right, Vector3.yAxis, -ahead))
		else
			place(guide, nil)
		end
		-- pointing straight down over the target, turning slowly
		local over = goal + Vector3.new(0, 10 + math.sin(t * 2.5) * 1.2, 0)
		place(marker, CFrame.fromMatrix(over, Vector3.xAxis, Vector3.new(0, 0, -1), Vector3.yAxis) * CFrame.Angles(0, 0, t * 1.5))
	end)

	-- First join: start it (it keeps coming back until finished or skipped)
	local checked = false
	State.Changed:Connect(function(snapshot)
		if not checked then
			checked = true
			if snapshot.SeenTutorial == false then
				-- after the Update Log that opens on joining has been closed
				UpdateNotes.AfterJoinLog(function()
					if not Tutorial.IsRunning() then
						Tutorial.Start()
					end
				end)
			end
		elseif step == "Done" then
			refresh() -- the claim went through
		end
	end)
	refresh()
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">UpdateDecor</string>
              <string name="Source"><![CDATA[--[[
	UpdateDecor: the decorations that theme the Update Log to each update (UI/UpdateNotes).

	  * Emblem  - the corner badge: a real 3D donut in the update's frosting and sprinkles, rocking
	              gently on a medallion, inside a slowly turning wheel of sprinkle "handles"
	  * Motes   - things floating around the notes, one style per update (UpdateNotes Decor):
	              Rise (golden diamonds + sparkles drifting up), Embers (sparks rising from a lava
	              glow), Stars (twinkling stars and the odd shooting star), Sparkles (soft bubbles)
	  * Swirl   - faint curly arcs in the corners (they turn slowly for Stars)
	  * Glow    - a soft band of colour along the bottom of the notes
	  * Divider - a thin line with a little gem in the middle, between sections

	Everything is drawn with plain frames, strokes and gradients (no images to upload). Each builder
	returns a step function: UpdateNotes calls them every frame while the window is open.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Notes = require(Shared.UpdateNotes)
local DonutModel = require(Shared.DonutModel)
local Theme = require(script.Parent.Theme)

local UpdateDecor = {}

export type Step = (t: number, dt: number) -> ()

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)
local DOUGH = rgb(222, 165, 95)
local TAU = math.pi * 2

local function circle(props: { [string]: any }): Frame
	local frame = Theme.new("Frame", props)
	Theme.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = frame })
	return frame
end

-- A ring drawn as a stroke, faded out along part of its length so it reads as an arc.
-- `cut` = how much of the ring is hidden (0..1), `rotation` turns the visible part.
local function arc(parent: Instance, center: UDim2, diameter: number, thickness: number, color: Color3, transparency: number, cut: number, rotation: number, z: number): Frame
	local ring = circle({
		Name = "Arc",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = center,
		Size = UDim2.fromOffset(diameter, diameter),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	})
	local stroke = Theme.new("UIStroke", { Thickness = thickness, Color = color, Transparency = 0, Parent = ring })
	local a = math.clamp(1 - cut, 0.05, 0.95)
	Theme.new("UIGradient", {
		Rotation = rotation,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, transparency),
			NumberSequenceKeypoint.new(a * 0.5, transparency),
			NumberSequenceKeypoint.new(math.min(a * 0.5 + 0.12, 0.99), 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = stroke,
	})
	return ring
end

---------------------------------------------------------------------------------------------------
-- Emblem
---------------------------------------------------------------------------------------------------
local HANDLES = 10

-- The donut the emblem shows (a plain donut: no face, sprinkles all round).
local function emblemDonut(update: Notes.Update): any
	local emblem = update.Emblem
	return {
		Id = "update" .. update.Version,
		Name = update.Name,
		Rarity = "Common",
		Area = 1,
		Income = 0,
		Weight = 0,
		Dough = if emblem and emblem.Dough then emblem.Dough else DOUGH,
		Frosting = if emblem then emblem.Frosting else update.Accent,
		Sprinkles = if emblem then emblem.Sprinkles else { WHITE, update.Accent },
		Parts = {},
		Score = 0,
		Index = 0,
	}
end

-- Builds the badge (size x size) into `parent`; returns its frame and a step function.
function UpdateDecor.Emblem(parent: Instance, update: Notes.Update, size: number, z: number): (Frame, Step)
	local color, accent = update.Color, update.Accent
	local holder = Theme.new("Frame", {
		Name = "Emblem",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		ZIndex = z,
		Parent = parent,
	})
	local mid = UDim2.fromScale(0.5, 0.5)
	-- Soft glow behind everything
	local glow = circle({
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = mid,
		Size = UDim2.fromScale(1.25, 1.25),
		BackgroundColor3 = accent,
		BackgroundTransparency = 0.8,
		ZIndex = z,
		Parent = holder,
	})
	-- The wheel: a rim and sprinkle-shaped handles all the way round (they turn slowly)
	local rim = circle({
		Name = "Rim",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = mid,
		Size = UDim2.fromScale(0.86, 0.86),
		BackgroundTransparency = 1,
		ZIndex = z + 1,
		Parent = holder,
	})
	Theme.new("UIStroke", { Thickness = size * 0.06, Color = WHITE, Parent = rim }, {
		Theme.new("UIGradient", { Rotation = 45, Color = ColorSequence.new(Theme.Lighten(accent, 0.35), Theme.Darken(accent, 0.3)) }),
	})
	local handles: { Frame } = {}
	local sprinkles = if update.Emblem then update.Emblem.Sprinkles else { accent }
	for i = 1, HANDLES do
		local tint = if i % 2 == 0 then accent else sprinkles[(i // 2) % #sprinkles + 1]
		local handle = Theme.new("Frame", {
			Name = "Handle",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(size * 0.1, size * 0.24),
			BackgroundColor3 = WHITE,
			ZIndex = z + 1,
			Parent = holder,
		}, {
			Theme.new("UICorner", { CornerRadius = UDim.new(1, 0) }),
			Theme.Stroke(2.5),
			Theme.new("UIGradient", { Rotation = 0, Color = ColorSequence.new(Theme.Lighten(tint, 0.45), Theme.Darken(tint, 0.15)) }),
		})
		table.insert(handles, handle)
	end
	-- The medallion the donut sits on
	local medallion = circle({
		Name = "Medallion",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = mid,
		Size = UDim2.fromScale(0.74, 0.74),
		BackgroundColor3 = WHITE,
		ZIndex = z + 2,
		Parent = holder,
	})
	Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Lighten(color, 0.3), Theme.Darken(color, 0.55)), Parent = medallion })
	Theme.Stroke(4).Parent = medallion
	local inner = arc(holder, mid, size * 0.64, 2, Theme.Lighten(accent, 0.4), 0.2, 0.25, 0, z + 3)
	-- The donut itself
	local viewport = Theme.new("ViewportFrame", {
		Name = "Donut",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = mid,
		Size = UDim2.fromScale(0.9, 0.9),
		BackgroundTransparency = 1,
		Ambient = rgb(175, 165, 185),
		LightColor = WHITE,
		LightDirection = Vector3.new(-0.5, -1, 0.6),
		ZIndex = z + 4,
		Parent = holder,
	})
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local distance = 15
	local ok, model = pcall(DonutModel.Build, emblemDonut(update), { NoEffects = true, NoFace = true })
	if ok and model then
		local box = model:GetBoundingBox()
		model:PivotTo(model:GetPivot() - box.Position)
		model.Parent = viewport
		local _, extents = model:GetBoundingBox()
		distance = math.max(extents.X, extents.Y) * 2.1
	end
	camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, -distance), Vector3.zero)

	local radius = size * 0.43
	local function step(t: number, _dt: number)
		local spin = t * 0.25
		for i, handle in handles do
			local angle = spin + (i - 1) / HANDLES * TAU
			handle.Position = UDim2.new(0.5, math.cos(angle) * radius, 0.5, math.sin(angle) * radius)
			handle.Rotation = math.deg(angle) + 90
		end
		glow.BackgroundTransparency = 0.78 + math.sin(t * 2) * 0.06
		inner.Rotation = -t * 20
		-- the donut rocks and bobs (a full spin would show its thin edge)
		local yaw = math.sin(t * 0.9) * 0.45
		local pitch = 0.18 + math.sin(t * 0.6) * 0.08
		camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(yaw) * distance, math.sin(pitch) * distance, -math.cos(yaw) * distance), Vector3.new(0, math.sin(t * 1.6) * 0.15, 0))
	end
	step(0, 0)
	return holder, step
end

---------------------------------------------------------------------------------------------------
-- Ornaments
---------------------------------------------------------------------------------------------------

-- Curly corner ornament: three arcs that wind inwards like a swirl.
function UpdateDecor.Swirl(parent: Instance, center: UDim2, size: number, color: Color3, transparency: number, z: number): Step
	local rings = {
		arc(parent, center, size, 3, color, transparency, 0.3, 30, z),
		arc(parent, center, size * 0.7, 2.5, color, transparency + 0.08, 0.4, 150, z),
		arc(parent, center, size * 0.42, 2, color, transparency + 0.15, 0.5, 260, z),
	}
	local dot = circle({ AnchorPoint = Vector2.new(0.5, 0.5), Position = center, Size = UDim2.fromOffset(size * 0.1, size * 0.1), BackgroundColor3 = color, BackgroundTransparency = transparency, ZIndex = z, Parent = parent })
	return function(t: number, _dt: number)
		for i, ring in rings do
			ring.Rotation = t * (6 + i * 4) * (if i % 2 == 0 then -1 else 1)
		end
		dot.BackgroundTransparency = transparency + math.sin(t * 1.5) * 0.08
	end
end

-- A soft band of colour fading up from the bottom of `parent`.
function UpdateDecor.Glow(parent: Instance, color: Color3, height: number, strength: number, z: number): Step
	local band = Theme.new("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = parent,
	})
	local gradient = Theme.new("UIGradient", { Rotation = 90, Parent = band })
	return function(t: number, _dt: number)
		local s = strength * (0.85 + math.sin(t * 1.3) * 0.15)
		gradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 1 - s) })
	end
end

-- A slowly turning sunburst of soft rays (behind the update's title).
function UpdateDecor.Rays(parent: Instance, center: UDim2, length: number, count: number, color: Color3, transparency: number, z: number): Step
	local rays: { Frame } = {}
	for i = 1, count do
		local ray = Theme.new("Frame", {
			Name = "Ray",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = center,
			Size = UDim2.fromOffset(length * 2, if i % 2 == 0 then 10 else 16),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = z,
			Parent = parent,
		}, {
			Theme.new("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.3, transparency),
					NumberSequenceKeypoint.new(0.5, 1),
					NumberSequenceKeypoint.new(0.7, transparency),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}),
		})
		table.insert(rays, ray)
	end
	return function(t: number, _dt: number)
		for i, ray in rays do
			ray.Rotation = (i - 1) * 180 / count + t * 4
		end
	end
end

-- Thin line with a gem in the middle (between sections).
function UpdateDecor.Divider(color: Color3, width: number): Frame
	local holder = Theme.new("Frame", { Name = "Divider", BackgroundTransparency = 1, Size = UDim2.new(0, width, 0, 14) })
	local line = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 0, 0, 2),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = holder,
	})
	Theme.new("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Parent = line,
	})
	for i, scale in { 1, 0.55 } do
		Theme.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(12 * scale, 12 * scale),
			Rotation = 45,
			BackgroundColor3 = if i == 1 then color else WHITE,
			BorderSizePixel = 0,
			ZIndex = i + 1,
			Parent = holder,
		}, if i == 1 then { Theme.Stroke(2) } else nil)
	end
	return holder
end

---------------------------------------------------------------------------------------------------
-- Motes: things floating around the notes
---------------------------------------------------------------------------------------------------
type Style = {
	Count: number,
	Shapes: { string }, -- "Dot", "Diamond", "Spark"
	Colors: { Color3 },
	Size: NumberRange, -- pixels
	Motion: string, -- "Rise", "Twinkle", "Drift"
	Speed: NumberRange, -- fraction of the height per second
	Glow: Color3?, -- bottom glow colour
	Shooting: boolean?, -- the odd shooting star
	Spin: boolean?, -- the corner swirls turn
}

local STYLES: { [string]: Style } = {
	Rise = {
		Count = 18, Shapes = { "Diamond", "Diamond", "Spark" },
		Colors = { rgb(255, 225, 90), rgb(255, 245, 180), rgb(150, 255, 160) },
		Size = NumberRange.new(6, 13), Motion = "Rise", Speed = NumberRange.new(0.05, 0.11),
		Glow = rgb(255, 215, 80),
	},
	Embers = {
		Count = 28, Shapes = { "Dot", "Dot", "Dot", "Spark" },
		Colors = { rgb(255, 220, 90), rgb(255, 140, 30), rgb(255, 90, 10) },
		Size = NumberRange.new(4, 10), Motion = "Rise", Speed = NumberRange.new(0.08, 0.18),
		Glow = rgb(255, 90, 10),
	},
	Stars = {
		Count = 32, Shapes = { "Dot", "Dot", "Spark" },
		Colors = { rgb(255, 255, 255), rgb(210, 190, 255), rgb(255, 215, 150) },
		Size = NumberRange.new(3, 10), Motion = "Twinkle", Speed = NumberRange.new(1, 2.6),
		Glow = rgb(140, 80, 255), Shooting = true, Spin = true,
	},
	Sparkles = {
		Count = 18, Shapes = { "Bubble", "Bubble", "Spark" },
		Colors = { rgb(255, 170, 220), rgb(255, 230, 150), rgb(255, 255, 255) },
		Size = NumberRange.new(8, 20), Motion = "Drift", Speed = NumberRange.new(0.03, 0.07),
		Glow = rgb(255, 120, 200),
	},
}

function UpdateDecor.Style(update: Notes.Update): Style
	return STYLES[update.Decor or ""] or STYLES.Sparkles
end

local function shape(kind: string, size: number, color: Color3, z: number): Frame
	local holder = Theme.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		ZIndex = z,
	})
	if kind == "Diamond" then
		holder.BackgroundTransparency = 0
		holder.BackgroundColor3 = color
		holder.Rotation = 45
		holder.BorderSizePixel = 0
	elseif kind == "Spark" then
		-- four-pointed twinkle: two thin crossed bars
		for _, rotation in { 0, 90 } do
			Theme.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.new(1.6, 0, 0, math.max(2, size * 0.22)),
				Rotation = rotation,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = z,
				Parent = holder,
			}, {
				Theme.new("UICorner", { CornerRadius = UDim.new(1, 0) }),
				Theme.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }),
			})
		end
	elseif kind == "Bubble" then
		Theme.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = holder })
		holder.BackgroundTransparency = 0.75
		holder.BackgroundColor3 = color
		Theme.new("UIStroke", { Thickness = 1.5, Color = color, Transparency = 0.3, Parent = holder })
	else -- Dot
		holder.BackgroundTransparency = 0
		holder.BackgroundColor3 = color
		holder.BorderSizePixel = 0
		Theme.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = holder })
		Theme.new("UIStroke", { Thickness = math.max(1, size * 0.35), Color = color, Transparency = 0.6, Parent = holder })
	end
	return holder
end

type Mote = { Frame: Frame, X: number, Y: number, Speed: number, Phase: number, Base: number, Sway: number }

-- Fills `parent` (which should clip) with the update's floating motes; returns the step function.
function UpdateDecor.Motes(parent: Instance, update: Notes.Update, z: number): Step
	local style = UpdateDecor.Style(update)
	local rng = Random.new(update.Version * 7919)
	local motes: { Mote } = {}
	local function place(mote: Mote, anywhere: boolean)
		mote.X = rng:NextNumber(0.02, 0.98)
		mote.Y = if anywhere or style.Motion ~= "Rise" then rng:NextNumber(0, 1) else rng:NextNumber(1.02, 1.12)
		mote.Speed = rng:NextNumber(style.Speed.Min, style.Speed.Max)
		mote.Phase = rng:NextNumber(0, TAU)
	end
	for i = 1, style.Count do
		local kind = style.Shapes[(i - 1) % #style.Shapes + 1]
		local size = rng:NextNumber(style.Size.Min, style.Size.Max)
		local color = style.Colors[rng:NextInteger(1, #style.Colors)]
		local frame = shape(kind, size, color, z)
		frame.Name = "Mote"
		frame.Parent = parent
		local mote = { Frame = frame, X = 0, Y = 0, Speed = 0, Phase = 0, Base = frame.BackgroundTransparency, Sway = rng:NextNumber(0.006, 0.02) }
		place(mote, true)
		table.insert(motes, mote)
	end

	-- The odd shooting star (Stars)
	local streak: Frame? = nil
	local streakAt, streakFrom, streakTo = -10, Vector2.zero, Vector2.zero
	if style.Shooting then
		local s = Theme.new("Frame", {
			Name = "ShootingStar",
			AnchorPoint = Vector2.new(1, 0.5),
			Size = UDim2.fromOffset(90, 2),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = z,
			Parent = parent,
		})
		Theme.new("UIGradient", { Transparency = NumberSequence.new(1, 0), Parent = s })
		streak = s
	end

	local function setTransparency(mote: Mote, alpha: number)
		local frame = mote.Frame
		if frame.BackgroundTransparency < 1 or mote.Base < 1 then
			frame.BackgroundTransparency = 1 - (1 - mote.Base) * alpha
		end
		for _, child in frame:GetChildren() do
			if child:IsA("Frame") then
				child.BackgroundTransparency = 1 - alpha
			elseif child:IsA("UIStroke") then
				child.Transparency = 1 - alpha * 0.5
			end
		end
	end

	return function(t: number, dt: number)
		for _, mote in motes do
			local alpha = 1
			if style.Motion == "Rise" then
				mote.Y -= mote.Speed * dt
				if mote.Y < -0.05 then
					place(mote, false)
				end
				-- fade in at the bottom, out near the top, and flicker a little
				alpha = math.clamp((1.05 - mote.Y) * 5, 0, 1) * math.clamp(mote.Y * 3, 0, 1) * (0.75 + 0.25 * math.sin(t * 9 + mote.Phase))
				mote.Frame.Position = UDim2.fromScale(mote.X + math.sin(t * 1.4 + mote.Phase) * mote.Sway, mote.Y)
				mote.Frame.Rotation = if mote.Frame.Rotation ~= 0 then 45 + math.sin(t + mote.Phase) * 20 else 0
			elseif style.Motion == "Twinkle" then
				local wave = 0.5 + 0.5 * math.sin(t * mote.Speed + mote.Phase)
				alpha = 0.15 + 0.85 * wave * wave * wave
				if wave < 0.02 then
					mote.X = rng:NextNumber(0.02, 0.98)
					mote.Y = rng:NextNumber(0.02, 0.98)
				end
				mote.Frame.Position = UDim2.fromScale(mote.X, mote.Y)
			else -- Drift: slow bubbles
				mote.Y -= mote.Speed * dt
				if mote.Y < -0.08 then
					place(mote, false)
					mote.Y = 1.08
				end
				alpha = math.clamp((1.08 - mote.Y) * 4, 0, 1) * math.clamp((mote.Y + 0.08) * 4, 0, 1)
				mote.Frame.Position = UDim2.fromScale(mote.X + math.sin(t * 0.7 + mote.Phase) * mote.Sway * 2, mote.Y)
			end
			setTransparency(mote, alpha)
		end
		if streak then
			local age = t - streakAt
			if age > 7 then
				streakAt = t + rng:NextNumber(0, 3)
				streakFrom = Vector2.new(rng:NextNumber(0.2, 1), rng:NextNumber(-0.05, 0.35))
				streakTo = streakFrom + Vector2.new(-0.45, 0.3)
			end
			local p = (t - streakAt) / 0.8
			streak.Visible = p >= 0 and p <= 1
			if streak.Visible then
				local at = streakFrom:Lerp(streakTo, p)
				streak.Position = UDim2.fromScale(at.X, at.Y)
				streak.Rotation = 180 - 33
				streak.BackgroundTransparency = p * p
			end
		end
	end
end

return UpdateDecor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">UpdateNotes</string>
              <string name="Source"><![CDATA[--[[
	UpdateNotes: the Update Log window (the notes themselves are in Shared/UpdateNotes).

	  * the corner emblem: a 3D donut in the update's colours on a turning wheel (UpdateDecor), a
	    ribbon tab "Update Log", an "Update N" picker
	    and a round close button along the top
	  * left: the game's logo, the update's name, "Update N Patch Notes", a box listing everything new,
	    then each section (heading, tag and bullet lines) with a gem divider between them, over a big
	    faded model, the update's floating decorations, corner swirls and a soft glow
	  * right: groups of new things as cards with spinning 3D models of the real donuts / pets / eggs
	    (built from the game's own models, so there are no images to upload). Hover a card (tap it
	    on a phone) for its details card (ItemCard).
	Everything (window border, ribbon, panels, emblem, decorations) takes the update's own colours.

	It opens every time a player joins (after the "Welcome back" window if there is one). On a
	player's first visit the tutorial starts once they close it. The UPDATES button on the side and
	Settings > Update Log open it any time.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Notes = require(Shared.UpdateNotes)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local ItemCard = require(script.Parent.ItemCard)
local UpdateDecor = require(script.Parent.UpdateDecor)
local State = require(script.Parent.Parent.State)

local UpdateNotes = {}

local WIDTH, HEIGHT = 900, 540
local SIDEBAR = 256
local EMBLEM = 132
local rgb = Color3.fromRGB

type Spinner = { Camera: Camera, Distance: number, Height: number, Phase: number }

local modal: Modal.Modal
local show: (version: number) -> ()

-- The log that opens on joining: things that wait for it to be closed (the first-join tutorial)
local joinShown = false
local joinDone = false
local joinWaiters: { () -> () } = {}
local function finishJoin()
	if joinDone then
		return
	end
	joinDone = true
	for _, waiter in joinWaiters do
		task.spawn(waiter)
	end
	table.clear(joinWaiters)
end

-- Runs `callback` once the Update Log that opened on joining has been closed (right away if it
-- already was).
function UpdateNotes.AfterJoinLog(callback: () -> ())
	if joinDone then
		task.spawn(callback)
	else
		table.insert(joinWaiters, callback)
	end
end

function UpdateNotes.Open(version: number?)
	show(version or Notes.Latest)
	modal:Open()
end

local function text(props: { [string]: any }): TextLabel
	props.Font = props.Font or Theme.Font
	props.TextScaled = false
	props.TextWrapped = true
	props.AutomaticSize = Enum.AutomaticSize.Y
	return Theme.Label(props)
end

-- Put a model in a ViewportFrame, centred, and return a spinner for its camera.
local function stage(viewport: ViewportFrame, model: Model, zoom: number): Spinner
	local box, size = model:GetBoundingBox()
	model:PivotTo(model:GetPivot() - box.Position)
	model.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local distance = math.max(size.X, size.Y, size.Z) * zoom
	local spinner = { Camera = camera, Distance = distance, Height = distance * 0.18, Phase = math.random() * 6 }
	camera.CFrame = CFrame.lookAt(Vector3.new(0, spinner.Height, -distance), Vector3.zero)
	return spinner
end

local function clear(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UICorner") and not child:IsA("UIStroke") and not child:IsA("UIGradient") then
			child:Destroy()
		end
	end
end

function UpdateNotes.Init()
	ItemCard.Init()
	modal = Modal.new("Update Log", Theme.Colors.Orange, Vector2.new(WIDTH, HEIGHT))
	local frame = modal.Frame
	-- Our own top bar instead of the usual window header
	local header = frame:FindFirstChild("Header")
	if header and header:IsA("GuiObject") then
		header.Visible = false
	end
	frame.BackgroundColor3 = Color3.new(1, 1, 1)
	local windowGradient = frame:FindFirstChildOfClass("UIGradient") or Theme.new("UIGradient", { Parent = frame })
	windowGradient.Rotation = 90
	modal.Body.Position = UDim2.new()
	modal.Body.Size = UDim2.fromScale(1, 1)
	local body = modal.Body

	-- Left: the patch notes, over a big faded model and the update's decorations
	local left = Theme.new("Frame", {
		Name = "Notes",
		Position = UDim2.fromOffset(12, 64),
		Size = UDim2.new(1, -(SIDEBAR + 34), 1, -76),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Parent = body,
	}, { Theme.Corner(12), Theme.Stroke(3) })
	local leftGradient = Theme.new("UIGradient", { Rotation = 90, Parent = left })
	local backdrop = Theme.new("ViewportFrame", {
		Name = "Backdrop",
		BackgroundTransparency = 1,
		ImageTransparency = 0.6,
		Ambient = rgb(200, 190, 220),
		LightColor = rgb(255, 255, 255),
		LightDirection = Vector3.new(-0.4, -1, 0.7),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -10),
		Size = UDim2.new(1, 40, 0, 260),
		ZIndex = 1,
		Parent = left,
	})
	local decor = Theme.new("Frame", { Name = "Decor", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = left })
	local scroll = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ZIndex = 3,
		Parent = left,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 16) }),
	})

	-- Right: the new things, as cards
	local right = Theme.new("Frame", {
		Name = "Sidebar",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 64),
		Size = UDim2.new(0, SIDEBAR, 1, -76),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = body,
	}, { Theme.Corner(12), Theme.Stroke(3) })
	local rightGradient = Theme.new("UIGradient", { Rotation = 90, Parent = right })
	local cards = Theme.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Parent = right,
	}, {
		Theme.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		Theme.new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 12) }),
	})

	-- Top bar
	local topBar = Theme.new("Frame", { Name = "TopBar", Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = body }, { Theme.Corner(18) })
	local topGradient = Theme.new("UIGradient", { Rotation = 90, Parent = topBar })

	-- The glowing border, in the update's colours (it slowly runs round the window)
	local border = Theme.new("Frame", {
		Name = "Border",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		ZIndex = 2,
		Parent = body,
	}, { Theme.Corner(16) })
	local borderStroke = Theme.new("UIStroke", { Thickness = 3, Color = Color3.new(1, 1, 1), Parent = border })
	local borderGradient = Theme.new("UIGradient", { Parent = borderStroke })

	-- The ribbon tab, with a pointed end
	local ribbon = Theme.new("Frame", {
		Name = "Ribbon",
		Position = UDim2.fromOffset(-30, -24),
		Size = UDim2.fromOffset(380, 70),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 4,
		Parent = body,
	}, { Theme.Corner(12), Theme.Stroke(3.5) })
	local ribbonGradient = Theme.new("UIGradient", { Rotation = 90, Parent = ribbon })
	local tip = Theme.new("Frame", {
		Name = "Tip",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 350, 0, 11),
		Size = UDim2.fromOffset(48, 48),
		Rotation = 45,
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = body,
	}, { Theme.Corner(6), Theme.Stroke(3.5) })
	local tipGradient = Theme.new("UIGradient", { Rotation = 45, Parent = tip })
	local ribbonTrim = Theme.new("Frame", { Name = "Trim", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 96, 1, -7), Size = UDim2.new(1, -120, 0, 3), BorderSizePixel = 0, ZIndex = 5, Parent = ribbon }, {
		Theme.new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) }) }),
	})
	Theme.Label({ Text = "Update Log", TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(104, 10), Size = UDim2.new(1, -120, 0, 46), StrokeThickness = 3.5, ZIndex = 6, Parent = ribbon })
	local ribbonDecor = Theme.new("Frame", { Name = "Decor", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = 5, Parent = ribbon })

	local close = Theme.Button({ Text = "X", Color = Theme.Colors.Red, Size = UDim2.fromOffset(58, 58), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -8, 0, 8), Parent = body })
	close.ZIndex = 5
	for _, child in close:GetDescendants() do
		if child:IsA("UICorner") then
			child.CornerRadius = UDim.new(1, 0)
		end
	end
	close.Activated:Connect(function()
		modal:Close()
	end)
	local versionButton = Theme.Button({ Text = "", Color = rgb(55, 55, 70), Size = UDim2.fromOffset(170, 42), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -52, 0, 8), Parent = body })

	-- "Update N" picker: a little menu of every update
	local menu = Theme.new("Frame", {
		Name = "VersionMenu",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -52, 0, 54),
		Size = UDim2.fromOffset(170, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = rgb(30, 30, 44),
		Visible = false,
		ZIndex = 10,
		Parent = body,
	}, { Theme.Corner(10), Theme.Stroke(2.5), Theme.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }), Theme.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }) })
	for i, update in Notes.List do
		local option = Theme.Button({ Text = `Update {update.Version}`, Color = update.Color, Size = UDim2.new(1, 0, 0, 36), Parent = menu })
		option.LayoutOrder = i
		option.ZIndex = 11
		option.Activated:Connect(function()
			menu.Visible = false
			show(update.Version)
		end)
	end
	versionButton.Activated:Connect(function()
		menu.Visible = not menu.Visible
	end)

	local spinners: { Spinner } = {}
	local steps: { UpdateDecor.Step } = {}
	local emblem: Frame? = nil
	show = function(version: number)
		local update = Notes.Get(version) or Notes.List[1]
		local color, accent = update.Color, update.Accent
		local style = UpdateDecor.Style(update)
		menu.Visible = false
		ItemCard.Hide()
		table.clear(spinners)
		table.clear(steps)
		clear(scroll)
		clear(cards)
		clear(decor)
		clear(ribbonDecor)
		backdrop:ClearAllChildren()
		Theme.SetButtonText(versionButton, `▼ Update {update.Version}`)

		-- Colours: everything takes the update's theme
		windowGradient.Color = ColorSequence.new(Theme.Darken(color, 0.55), Theme.Darken(color, 0.85))
		leftGradient.Color = ColorSequence.new(Theme.Lighten(color, 0.12), Theme.Darken(color, 0.45))
		rightGradient.Color = ColorSequence.new(Theme.Darken(color, 0.6), rgb(8, 7, 14))
		topGradient.Color = ColorSequence.new(Theme.Darken(color, 0.5), Theme.Darken(color, 0.78))
		ribbonGradient.Color = ColorSequence.new(Theme.Lighten(color, 0.25), Theme.Darken(color, 0.15))
		tipGradient.Color = ColorSequence.new(Theme.Lighten(color, 0.1), Theme.Darken(color, 0.2))
		ribbonTrim.BackgroundColor3 = accent
		borderGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, accent),
			ColorSequenceKeypoint.new(0.25, Theme.Lighten(color, 0.35)),
			ColorSequenceKeypoint.new(0.5, Theme.Lighten(accent, 0.4)),
			ColorSequenceKeypoint.new(0.75, Theme.Lighten(color, 0.35)),
			ColorSequenceKeypoint.new(1, accent),
		})
		Theme.SetButtonColor(versionButton, Theme.Darken(color, 0.2))

		-- The corner emblem and the decorations
		if emblem then
			emblem:Destroy()
		end
		local badge, emblemStep = UpdateDecor.Emblem(body, update, EMBLEM, 6)
		badge.Position = UDim2.fromOffset(-58, -52)
		emblem = badge
		table.insert(steps, emblemStep)
		table.insert(steps, UpdateDecor.Glow(decor, style.Glow or accent, 150, 0.45, 2))
		local swirlA = UpdateDecor.Swirl(decor, UDim2.fromScale(0, 1), 230, accent, 0.7, 2)
		local swirlB = UpdateDecor.Swirl(decor, UDim2.fromScale(1, 0), 190, accent, 0.72, 2)
		if style.Spin then
			table.insert(steps, swirlA)
			table.insert(steps, swirlB)
		end
		table.insert(steps, UpdateDecor.Rays(decor, UDim2.new(0.5, 0, 0, 120), 300, 10, Theme.Lighten(accent, 0.3), 0.82, 2))
		table.insert(steps, UpdateDecor.Motes(decor, update, 2))
		UpdateDecor.Swirl(ribbonDecor, UDim2.new(1, -36, 0.5, 0), 70, accent, 0.65, 5)

		-- Left column
		local order = 0
		local function add(instance: GuiObject)
			order += 1
			instance.LayoutOrder = order
			instance.Parent = scroll
		end
		local logo = Theme.Label({ Text = "STEAL A DONUT", Size = UDim2.new(1, -30, 0, 70), StrokeThickness = 5 })
		Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(rgb(255, 255, 255), Theme.Lighten(accent, 0.55)), Parent = logo })
		add(logo)
		local title = Theme.Label({ Text = update.Name, TextColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, -30, 0, 50), StrokeThickness = 4 })
		Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Lighten(accent, 0.45), Theme.Darken(accent, 0.1)), Parent = title })
		add(title)
		add(Theme.Label({ Text = `Update {update.Version} Patch Notes  •  {update.Date}`, Font = Theme.Font, TextColor3 = rgb(225, 220, 235), Size = UDim2.new(1, -30, 0, 24), StrokeThickness = 2 }))
		-- The box listing everything new
		local titles = {}
		for _, section in update.Sections do
			table.insert(titles, section.Title)
		end
		local box = Theme.new("Frame", {
			Size = UDim2.new(1, -60, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.4,
		}, {
			Theme.Corner(10),
			Theme.Stroke(2.5, Theme.Darken(accent, 0.3)),
			Theme.Padding(12),
			Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Darken(color, 0.55), rgb(0, 0, 0)) }),
		})
		text({ Text = table.concat(titles, `  <font color="#{accent:ToHex()}"></font>  `), RichText = true, TextSize = 22, LineHeight = 1.1, Size = UDim2.fromScale(1, 0), StrokeThickness = 2, Parent = box })
		add(Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 6) }))
		add(box)
		add(Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 8) }))
		for _, section in update.Sections do
			add(UpdateDecor.Divider(accent, 300))
			local heading = Theme.Label({ Text = section.Title, TextColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, -30, 0, 34), StrokeThickness = 3 })
			Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Lighten(accent, 0.35), accent), Parent = heading })
			add(heading)
			add(Theme.Label({ Text = string.upper(section.Tag), Font = Theme.Font, TextColor3 = Theme.Lighten(color, 0.6), Size = UDim2.new(1, -30, 0, 20), StrokeThickness = 2 }))
			for _, line in section.Lines do
				add(text({ Text = `<font color="#{accent:ToHex()}">•</font> {line}`, RichText = true, TextSize = 21, Size = UDim2.new(1, -60, 0, 0), StrokeThickness = 2 }))
			end
			add(Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 8) }))
		end

		-- Right column: groups of cards (hover one for its details)
		local cardOrder = 0
		local firstModel: Model? = nil
		for _, group in update.Sidebar do
			cardOrder += 1
			local groupTitle = Theme.Label({ Text = group.Title, TextColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, -16, 0, 30), StrokeThickness = 3, LayoutOrder = cardOrder, Parent = cards })
			Theme.new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Theme.Lighten(accent, 0.35), accent), Parent = groupTitle })
			cardOrder += 1
			local grid = Theme.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = cardOrder, Parent = cards }, {
				Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(112, 112), CellPadding = UDim2.fromOffset(8, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
			})
			for i, item in group.Items do
				local info = ItemCard.Describe(item)
				local model = ItemCard.Model(item)
				local itemColor = info.Color
				local card = Theme.new("Frame", { Name = "Card", LayoutOrder = i, BackgroundColor3 = Color3.new(1, 1, 1), Parent = grid }, {
					Theme.Corner(12),
					Theme.Gradient(Theme.Lighten(itemColor, 0.1), Theme.Darken(itemColor, 0.55)),
				})
				local cardStroke = Theme.Stroke(3, Theme.Lighten(itemColor, 0.35))
				cardStroke.Parent = card
				Theme.Label({ Text = string.upper(info.Rarity), TextColor3 = Theme.Lighten(itemColor, 0.5), TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(7, 4), Size = UDim2.new(0.8, 0, 0, 15), StrokeThickness = 1.5, ZIndex = 3, Parent = card })
				Theme.Label({ Text = info.Name, Font = Theme.Font, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, -8, 0, 30), StrokeThickness = 2, ZIndex = 3, Parent = card })
				if model then
					if not firstModel then
						firstModel = model:Clone()
					end
					local viewport = Theme.new("ViewportFrame", {
						BackgroundTransparency = 1,
						Ambient = rgb(190, 185, 205),
						LightColor = rgb(255, 255, 255),
						LightDirection = Vector3.new(-0.5, -1, 0.8),
						Position = UDim2.fromOffset(4, 10),
						Size = UDim2.new(1, -8, 1, -30),
						ZIndex = 2,
						Parent = card,
					})
					table.insert(spinners, stage(viewport, model, 1.6))
				end
				-- Hover (or tap) for the details card; the card lights up while you do
				local hit = Theme.new("TextButton", { Name = "Hover", Text = "", BackgroundTransparency = 1, AutoButtonColor = false, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = card })
				ItemCard.Attach(hit, item, function(on: boolean)
					cardStroke.Color = if on then Theme.Lighten(itemColor, 0.75) else Theme.Lighten(itemColor, 0.35)
					cardStroke.Thickness = if on then 4.5 else 3
				end)
			end
		end
		if firstModel then
			table.insert(spinners, stage(backdrop, firstModel, 1.2))
		end
		scroll.CanvasPosition = Vector2.zero
		cards.CanvasPosition = Vector2.zero
	end

	-- The models sway and the decorations move while the window is open
	local started = os.clock()
	local last = started
	RunService.RenderStepped:Connect(function()
		if not modal:IsOpen() then
			return
		end
		local now = os.clock()
		local t, dt = now - started, math.min(now - last, 0.1)
		last = now
		for _, spinner in spinners do
			local angle = math.sin(t * 0.8 + spinner.Phase) * 0.6
			spinner.Camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(angle) * spinner.Distance, spinner.Height, -math.cos(angle) * spinner.Distance), Vector3.zero)
		end
		for _, step in steps do
			step(t, dt)
		end
		borderGradient.Rotation = (t * 40) % 360
	end)

	-- Every join: the log opens as soon as the screen is free (the "Welcome back" offline earnings
	-- arrive together with the save, and only one window shows at a time). Brand-new players see
	-- it too; their tutorial starts once they close it (UpdateNotes.AfterJoinLog).
	modal.OnClose = function()
		if joinShown then
			finishJoin()
		end
	end
	local checked = false
	State.Changed:Connect(function(snapshot)
		if checked then
			return
		end
		checked = true
		if (snapshot.SeenUpdate or 0) < Notes.Latest then
			State.Action("SeenUpdate", Notes.Latest)
		end
		task.spawn(function()
			-- wait for the loading screen to finish first
			local player = game:GetService("Players").LocalPlayer
			local loading = 0
			while player:GetAttribute("LoadingScreen") and loading < 60 do
				task.wait(0.25)
				loading += 0.25
			end
			task.wait(1.5)
			-- ...and the opening cinematic (client/Intro), for new players
			local intro = 0
			while player:GetAttribute("Intro") and intro < 120 do
				task.wait(0.25)
				intro += 0.25
			end
			local waited = 0
			while Modal.AnyOpen() and waited < 600 do
				task.wait(0.5)
				waited += 0.5
			end
			if Modal.AnyOpen() then
				finishJoin() -- (somebody's been in a window for 10 minutes: don't hold the tutorial)
				return
			end
			joinShown = true
			UpdateNotes.Open()
		end)
	end)
end

return UpdateNotes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">VirtualList</string>
              <string name="Source"><![CDATA[--[[
	VirtualList: a scrolling list that can show thousands of rows while only creating enough row
	frames to fill the visible window (rows are recycled as you scroll).
]]

local VirtualList = {}
VirtualList.__index = VirtualList

export type VirtualList = {
	Frame: ScrollingFrame,
	RowHeight: number,
	Entries: { any },
	Pool: { GuiObject },
	Build: () -> GuiObject,
	Bind: (GuiObject, any, number) -> (),
	SetEntries: (self: VirtualList, entries: { any }) -> (),
	Refresh: (self: VirtualList) -> (),
}

function VirtualList.new(frame: ScrollingFrame, rowHeight: number, build: () -> GuiObject, bind: (GuiObject, any, number) -> ()): VirtualList
	local self = setmetatable({
		Frame = frame,
		RowHeight = rowHeight,
		Entries = {},
		Pool = {},
		Build = build,
		Bind = bind,
	}, VirtualList) :: any
	frame.AutomaticCanvasSize = Enum.AutomaticSize.None
	frame:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		self:Refresh()
	end)
	frame:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(function()
		self:Refresh()
	end)
	return self
end

function VirtualList.SetEntries(self: VirtualList, entries: { any })
	self.Entries = entries
	self.Frame.CanvasSize = UDim2.new(0, 0, 0, #entries * self.RowHeight)
	self:Refresh()
end

function VirtualList.Refresh(self: VirtualList)
	local windowHeight = self.Frame.AbsoluteWindowSize.Y
	if windowHeight <= 0 then
		windowHeight = self.Frame.AbsoluteSize.Y
	end
	-- AbsoluteWindowSize is in screen pixels; convert to canvas units if the list is scaled.
	local canvasHeight = self.Frame.AbsoluteCanvasSize.Y
	local ratio = if self.Frame.CanvasSize.Y.Offset > 0 and canvasHeight > 0 then self.Frame.CanvasSize.Y.Offset / canvasHeight else 1
	local needed = math.ceil(windowHeight * ratio / self.RowHeight) + 2
	while #self.Pool < needed do
		local row = self.Build()
		row.Parent = self.Frame
		table.insert(self.Pool, row)
	end
	local first = math.max(1, math.floor(self.Frame.CanvasPosition.Y / self.RowHeight) + 1)
	for i, row in self.Pool do
		local index = first + i - 1
		local entry = self.Entries[index]
		if entry then
			row.Visible = true
			row.Position = UDim2.fromOffset(0, (index - 1) * self.RowHeight)
			self.Bind(row, entry, index)
		else
			row.Visible = false
		end
	end
end

return VirtualList
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="156">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[--[[
	Weather: the client-side look of server events (see Events.luau / EventService).
	While an event runs you get its weather around you wherever you are (sand, snow, rain, embers,
	bubbles, sparkles, shooting stars, confetti, ghosts, coins, leaves, rainbows, eggs) and a colour
	tint. A Sandstorm or Blizzard also adds some haze.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Events = require(Shared.Events)


local Weather = {}

local player = Players.LocalPlayer :: Player
local rgb = Color3.fromRGB

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, rgb(255, 70, 70)),
	ColorSequenceKeypoint.new(0.25, rgb(255, 220, 60)),
	ColorSequenceKeypoint.new(0.5, rgb(70, 220, 100)),
	ColorSequenceKeypoint.new(0.75, rgb(70, 150, 255)),
	ColorSequenceKeypoint.new(1, rgb(200, 90, 255)),
})

type Style = {
	Rate: number,
	Speed: NumberRange,
	Size: NumberSequence,
	Lifetime: NumberRange,
	Color: ColorSequence?,
	Direction: Enum.NormalId,
	Acceleration: Vector3?,
	Squash: number?,
	Light: number?,
	Spin: boolean?,
	Transparency: NumberSequence?,
	Height: number,
}

local STYLES: { [string]: Style } = {
	Sand = { Rate = 350, Speed = NumberRange.new(20, 40), Size = NumberSequence.new(0.35, 0.2), Lifetime = NumberRange.new(1.5, 2.5), Color = ColorSequence.new(rgb(225, 190, 130)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(60, 0, 20), Height = 25 },
	Snow = { Rate = 220, Speed = NumberRange.new(6, 12), Size = NumberSequence.new(0.45, 0.3), Lifetime = NumberRange.new(4, 6), Color = ColorSequence.new(rgb(255, 255, 255)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(6, 0, 3), Light = 0.3, Height = 40 },
	Rain = { Rate = 500, Speed = NumberRange.new(70, 90), Size = NumberSequence.new(0.12), Lifetime = NumberRange.new(0.6, 0.9), Direction = Enum.NormalId.Bottom, Squash = -3, Height = 45 },
	Embers = { Rate = 140, Speed = NumberRange.new(4, 10), Size = NumberSequence.new(0.35, 0), Lifetime = NumberRange.new(3, 5), Color = ColorSequence.new(rgb(255, 170, 40), rgb(255, 60, 0)), Direction = Enum.NormalId.Top, Light = 1, Height = -2 },
	Bubbles = { Rate = 90, Speed = NumberRange.new(3, 7), Size = NumberSequence.new(0.4, 0.8), Lifetime = NumberRange.new(4, 6), Color = ColorSequence.new(rgb(210, 245, 255)), Direction = Enum.NormalId.Top, Transparency = NumberSequence.new(0.3, 0.8), Height = -2 },
	Sparkles = { Rate = 120, Speed = NumberRange.new(1, 4), Size = NumberSequence.new(0.5, 0), Lifetime = NumberRange.new(2, 3), Direction = Enum.NormalId.Bottom, Light = 1, Height = 20 },
	Stars = { Rate = 30, Speed = NumberRange.new(90, 130), Size = NumberSequence.new(0.6, 0.2), Lifetime = NumberRange.new(0.8, 1.2), Color = ColorSequence.new(rgb(255, 240, 180)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(80, 0, 40), Squash = -4, Light = 1, Height = 70 },
	Confetti = { Rate = 180, Speed = NumberRange.new(6, 12), Size = NumberSequence.new(0.35), Lifetime = NumberRange.new(4, 6), Color = RAINBOW, Direction = Enum.NormalId.Bottom, Spin = true, Height = 35 },
	Ghosts = { Rate = 8, Speed = NumberRange.new(2, 5), Size = NumberSequence.new(2.5, 4), Lifetime = NumberRange.new(4, 7), Color = ColorSequence.new(rgb(220, 255, 220)), Direction = Enum.NormalId.Top, Transparency = NumberSequence.new(0.7, 1), Light = 0.5, Height = 0 },
	Coins = { Rate = 70, Speed = NumberRange.new(10, 18), Size = NumberSequence.new(0.45), Lifetime = NumberRange.new(2.5, 4), Color = ColorSequence.new(rgb(255, 210, 60)), Direction = Enum.NormalId.Bottom, Spin = true, Light = 0.4, Height = 35 },
	Leaves = { Rate = 90, Speed = NumberRange.new(4, 8), Size = NumberSequence.new(0.5), Lifetime = NumberRange.new(5, 7), Color = ColorSequence.new(rgb(255, 150, 50), rgb(200, 80, 30)), Direction = Enum.NormalId.Bottom, Acceleration = Vector3.new(5, 0, 2), Spin = true, Height = 35 },
	Rainbow = { Rate = 200, Speed = NumberRange.new(4, 10), Size = NumberSequence.new(0.5, 0), Lifetime = NumberRange.new(3, 5), Color = RAINBOW, Direction = Enum.NormalId.Bottom, Light = 1, Spin = true, Height = 30 },
	Void = { Rate = 150, Speed = NumberRange.new(3, 9), Size = NumberSequence.new(0.55, 0), Lifetime = NumberRange.new(3, 5), Color = ColorSequence.new(rgb(225, 170, 255), rgb(120, 30, 230)), Direction = Enum.NormalId.Top, Light = 1, Spin = true, Height = -2 },
	Eggs = { Rate = 40, Speed = NumberRange.new(10, 16), Size = NumberSequence.new(0.7), Lifetime = NumberRange.new(2.5, 4), Color = ColorSequence.new(rgb(255, 240, 200), rgb(255, 190, 230)), Direction = Enum.NormalId.Bottom, Spin = true, Height = 35 },
}

local holder: Part? = nil
local tint: ColorCorrectionEffect
local activeId: string? = nil

local function stop()
	activeId = nil
	if holder then
		holder:Destroy()
		holder = nil
	end
	TweenService:Create(tint, TweenInfo.new(2), { TintColor = Color3.new(1, 1, 1) }):Play()
end

local function start(event: Events.Event)
	stop()
	activeId = event.Id
	local style = STYLES[event.Weather] or STYLES.Sparkles
	local part = Instance.new("Part")
	part.Name = "EventWeather"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(110, 1, 110)
	part:SetAttribute("Height", style.Height)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = style.Rate
	emitter.Speed = style.Speed
	emitter.Size = style.Size
	emitter.Lifetime = style.Lifetime
	emitter.Color = style.Color or ColorSequence.new(event.Color)
	emitter.EmissionDirection = style.Direction
	emitter.SpreadAngle = Vector2.new(10, 10)
	emitter.Acceleration = style.Acceleration or Vector3.zero
	emitter.LightEmission = style.Light or 0
	emitter.Transparency = style.Transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0.1), NumberSequenceKeypoint.new(1, 0.6) })
	if style.Squash then
		emitter.Squash = NumberSequence.new(style.Squash)
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
	end
	if style.Spin then
		emitter.Rotation = NumberRange.new(0, 360)
		emitter.RotSpeed = NumberRange.new(-180, 180)
	end
	emitter.Parent = part
	if event.Fog > 0 then
		-- Thick haze close to you (the lane further away disappears into it)
		local haze = Instance.new("ParticleEmitter")
		haze.Rate = 25 * event.Fog * 2
		haze.Speed = NumberRange.new(2, 6)
		haze.Size = NumberSequence.new(14, 20)
		haze.Lifetime = NumberRange.new(4, 6)
		haze.Color = ColorSequence.new(event.Color)
		haze.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 1 - event.Fog), NumberSequenceKeypoint.new(1, 1) })
		haze.SpreadAngle = Vector2.new(180, 180)
		haze.Parent = part
	end
	part.Parent = workspace
	holder = part
	TweenService:Create(tint, TweenInfo.new(2), { TintColor = event.Tint }):Play()
end

function Weather.Init()
	tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "EventTint"
	tint.Parent = Lighting

	-- Follow the player
	RunService.RenderStepped:Connect(function()
		local part = holder
		if not part then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local height = (part:GetAttribute("Height") :: number?) or 30
			part.CFrame = CFrame.new(root.Position + Vector3.new(0, height, 0))
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			local eventId = workspace:GetAttribute("EventId")
			local event = if type(eventId) == "string" then Events.ById[eventId] else nil
			if event and event.Id ~= activeId then
				start(event)
			elseif not event and activeId then
				stop()
			end
		end
	end)
end

return Weather
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="157">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>