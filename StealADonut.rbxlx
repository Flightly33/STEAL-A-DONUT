-- Hell donuts in a pen are held down by glowing chains: four iron stakes round them with chains
-- to the donut, a sealing circle glowing on the ground, embers and hellfire - and every few
-- seconds the donut tugs at its chains (it stays on its own patch instead of wandering about).
-- Any donut's id can go in the list. The chains look like real chain links once the Chain texture
-- is uploaded (Config.AnimeFX.Textures); until then they're glowing beaded tethers.
Config.HellChains = {
	Donuts = { "infernolo", "tralalerobeach", "mangolino", "lagunamax", "tikiglaze", "poseidonut" } :: { string },
	ChainColor = Color3.fromRGB(255, 132, 40), -- hot iron
	GlowColor = Color3.fromRGB(255, 64, 24), -- the seal, the shackles, the embers
	TugEvery = { 5, 10 }, -- seconds between tugs (picked at random in between)
}

Config.Particles = {
	ParticleScale = 0.4,
	MaxParticleRate = 20,
}

-- The HUD's icons as pictures: glossy 3D icons made in Blender (art/hud_icons/png, one PNG per
-- icon, named like these keys). Empty = the game draws its own (client/UI/Icons). To use the
-- pictures: upload the PNGs (Studio: View > Asset Manager > Bulk Import, or Creator Hub >
-- Development Items > Images), copy each one's image id and paste it here, e.g.
-- basket = "rbxassetid://1234567". Any icon left empty keeps the drawn one.
Config.IconImages = {
	basket = "rbxassetid://132362357133019", -- Shop
	indexBook = "rbxassetid://138870067533686", -- Index
	pawPink = "rbxassetid://121678580823455", -- Pets
	gift = "rbxassetid://71624427464984", -- Daily
	houseRed = "rbxassetid://118907455361555", -- Home
	globeBlue = "rbxassetid://129128216135915", -- Teleport
	rocket = "rbxassetid://94010699227145", -- Boosts
	paletteWood = "rbxassetid://104980775998061", -- Skins
	heart = "rbxassetid://137145327483118", -- Donate
	newsYellow = "rbxassetid://89515507928300", -- Updates
	gearSteel = "rbxassetid://110388595144046", -- Settings
	toolsSteel = "rbxassetid://72729742187809", -- Admin
	buildingBlue = "rbxassetid://126923405507256", -- Base
	bolt = "rbxassetid://77350040474200", -- Speed
	cash = "rbxassetid://132677338228300", -- Money
} :: { [string]: string }

Config.Music = {
	DefaultVolume = 0.25, -- 0 to 1 (players change it, or turn music off, in Settings)
	Tracks = {
		{ Name = "Morning Mood", Id = 1846088038 }, -- Grieg, Peer Gynt (Roblox's licensed music)
	} :: { { Name: string, Id: number } },
	-- Played only if none of the Tracks above can be loaded (a deleted or private audio id).
	Fallback = {
		{ Name = "Relaxed Scene", Id = 1848354536 },
	} :: { { Name: string, Id: number } },
}

--------------------------------------------------------------------------------
-- Saving
--------------------------------------------------------------------------------
-- The most money and Speed anyone can have (the admin panel's money and Speed buttons stop here).
-- Far past anything you can earn, and safely inside what the game can handle: a save can't hold
-- "infinite" money, and past about 1e80 the money counter can't be shown.
Config.Limits = {
	Money = 1e60,
	Speed = 1e12,
}

Config.Data = {
	StoreName = "StealADonut_PlayerData_v1",
	AutosaveInterval = 90,
	SessionLockSeconds = 180, -- a lock older than this is treated as a crashed server and taken over
}

--------------------------------------------------------------------------------
-- Studio testing helpers (never active in live servers)
--------------------------------------------------------------------------------
Config.Debug = {
	-- In Studio, pressing buy on something WITHOUT an ID yet (0) grants it for that test session.
	-- Things with a real ID always show Roblox's purchase window; in Studio that's a free test purchase.
	StudioFreePurchases = true,
	StudioStartMoney = 0, -- give yourself money in Studio to test late-game content
	StudioStartSpeed = 0,
	-- Studio only: pretend this many of your friends are in the server, to see the Friend Boost
	-- while testing alone (test players are never each other's friends).
	StudioFakeFriends = 0,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CrateModel</string>
          <string name="Source"><![CDATA[--[[
	CrateModel: builds a crate out of plain parts. The better the crate, the fancier it looks:
	  Common     wooden crate with metal corners
	  Rare       blue steel crate, glowing seams, sparkles
	  Epic       purple crystal crate, neon edges, a soft light and swirling sparkles
	  Legendary  golden crate with a crown, light rays and golden sparks
	Every face has a big "?" so it reads as a mystery box from any side.

	Same rules as PetModel: one rigid assembly welded to an anchored, invisible "Root" part, so moving
	Root moves everything. Attributes Top / Bottom tell callers how to stand it on a surface. The lid
	is a separate part named "Lid" (the opening animation pops it off).
]]

local Crates = require(script.Parent.Crates)

local CrateModel = {}

local rgb = Color3.fromRGB

export type Options = {
	Scale: number?,
	NoEffects: boolean?, -- no lights/particles (UI previews)
}

type Look = { Body: Color3, BodyMaterial: Enum.Material, Trim: Color3, TrimMaterial: Enum.Material, Glow: Color3?, Question: Color3 }

local LOOKS: { [string]: Look } = {
	Common = { Body = rgb(170, 115, 65), BodyMaterial = Enum.Material.WoodPlanks, Trim = rgb(120, 120, 130), TrimMaterial = Enum.Material.Metal, Glow = nil, Question = rgb(255, 240, 200) },
	Rare = { Body = rgb(45, 95, 190), BodyMaterial = Enum.Material.DiamondPlate, Trim = rgb(150, 220, 255), TrimMaterial = Enum.Material.Neon, Glow = rgb(120, 200, 255), Question = rgb(200, 240, 255) },
	Epic = { Body = rgb(110, 40, 180), BodyMaterial = Enum.Material.Glass, Trim = rgb(255, 130, 255), TrimMaterial = Enum.Material.Neon, Glow = rgb(220, 120, 255), Question = rgb(255, 200, 255) },
	Legendary = { Body = rgb(255, 190, 40), BodyMaterial = Enum.Material.Foil, Trim = rgb(255, 245, 190), TrimMaterial = Enum.Material.Neon, Glow = rgb(255, 210, 90), Question = rgb(255, 60, 60) },
}

local function emitter(parent: Instance, color: Color3, rate: number, size: number, speed: number, lifetime: number)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = 1
	e.Rate = rate
	e.Lifetime = NumberRange.new(lifetime * 0.6, lifetime)
	e.Speed = NumberRange.new(speed * 0.4, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new(size, 0)
	e.Transparency = NumberSequence.new(0.1, 1)
	e.Parent = parent
end

function CrateModel.Build(crateId: string, options: Options?): Model
	local opts: Options = options or {}
	local s = opts.Scale or 1
	local crate = Crates.ById[crateId] or Crates.List[1]
	local look = LOOKS[crate.Id] or LOOKS.Common

	local model = Instance.new("Model")
	model.Name = crate.Name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.one * s
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Massless = true
	root.CFrame = CFrame.identity
	root.Parent = model
	model.PrimaryPart = root

	local function part(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * s
		p.CFrame = CFrame.new(cf.Position * s) * cf.Rotation
		p.Color = color
		p.Material = material
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape then
			p.Shape = shape
		end
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.CastShadow = false
		if material == Enum.Material.Glass then
			p.Transparency = 0.15
		end
		local weld = Instance.new("Weld")
		weld.Part0 = root
		weld.Part1 = p
		weld.C0 = p.CFrame
		weld.Parent = p
		p.Parent = model
		return p
	end

	-- Body (the crate is 4 wide, 3.2 tall, centred on the root) and lid
	local body = part("Body", Vector3.new(4, 2.6, 4), CFrame.new(0, -0.3, 0), look.Body, look.BodyMaterial)
	part("Lid", Vector3.new(4.3, 0.7, 4.3), CFrame.new(0, 1.35, 0), look.Body:Lerp(Color3.new(0, 0, 0), 0.15), look.BodyMaterial)
	-- Trim: the 4 vertical edges, a band round the middle and one under the lid
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			part("Corner", Vector3.new(0.45, 2.7, 0.45), CFrame.new(x * 1.9, -0.3, z * 1.9), look.Trim, look.TrimMaterial)
		end
	end
	part("Band", Vector3.new(4.12, 0.35, 4.12), CFrame.new(0, -0.3, 0), look.Trim, look.TrimMaterial)
	part("LidBand", Vector3.new(4.4, 0.25, 4.4), CFrame.new(0, 1.05, 0), look.Trim, look.TrimMaterial)
	part("Latch", Vector3.new(0.7, 0.8, 0.3), CFrame.new(0, 0.85, -2.2), look.Trim, look.TrimMaterial)

	-- A big "?" on every side
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0.3
		gui.Parent = body
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Text = "?"
		label.TextScaled = true
		label.Font = Enum.Font.LuckiestGuy
		label.TextColor3 = look.Question
		label.TextStrokeTransparency = 0
		label.Parent = gui
	end

	if crate.Id == "Legendary" then
		-- Crown on the lid
		part("CrownBase", Vector3.new(0.4, 2.2, 2.2), CFrame.new(0, 1.9, 0) * CFrame.Angles(0, 0, math.pi / 2), look.Trim, Enum.Material.Neon, Enum.PartType.Cylinder)
		for i = 0, 4 do
			local angle = i / 5 * math.pi * 2
			part("CrownSpike", Vector3.new(0.35, 0.8, 0.35), CFrame.new(math.cos(angle) * 0.9, 2.45, math.sin(angle) * 0.9), rgb(255, 215, 60), Enum.Material.Neon)
		end
		part("CrownGem", Vector3.new(0.5, 0.5, 0.5), CFrame.new(0, 2.3, 0), rgb(255, 50, 60), Enum.Material.Neon, Enum.PartType.Ball)
	end

	if not opts.NoEffects then
		if look.Glow then
			local light = Instance.new("PointLight")
			light.Color = look.Glow
			light.Range = 10 + crate.Order * 4
			light.Brightness = 1 + crate.Order * 0.4
			light.Shadows = false
			light.Parent = body
		end
		if crate.Order >= 2 then
			emitter(body, look.Trim, 2 + crate.Order * 3, 0.35 * s, 2, 1.5)
		end
		if crate.Order >= 3 then
			emitter(body, look.Glow or look.Trim, 6, 0.6 * s, 4, 1.2)
		end
		if crate.Order >= 4 then
			-- Light rays fanning out behind it
			for i = 1, 8 do
				local ray = part("Ray", Vector3.new(0.3, 7, 0.05), CFrame.new(0, 0.3, 0.2) * CFrame.Angles(0, 0, i / 8 * math.pi * 2) * CFrame.new(0, 3.5, 0), rgb(255, 225, 120), Enum.Material.Neon)
				ray.Transparency = 0.55
			end
		end
	end

	model:SetAttribute("CrateId", crate.Id)
	model:SetAttribute("Top", (if crate.Id == "Legendary" then 2.9 else 1.7) * s)
	model:SetAttribute("Bottom", 1.6 * s)
	return model
end

return CrateModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Crates</string>
          <string name="Source"><![CDATA[--[[
	Crates: open one and get ONE random reward from its list.

	You can find crates now and then in the lane (Config.Crates.Found), or buy them for Robux in the
	shop (developer products, Config.Crates.Products).

	Rewards:
	  Coins      -> Seconds of income from a typical donut of the furthest biome your Speed gets you into
	                (so the amount keeps up with how far you are).
	  SpeedBoost -> you run x Config.Crates.SpeedBoostMultiplier faster for Seconds (counts down only
	                while you're in the game; more boosts add more time)
	  Luck       -> starts / extends the server-wide Luck Event for Seconds (everyone benefits)
	  Egg        -> one egg from Eggs (weighted), straight into your incubator
	  Pet        -> that pet, straight into your pets

	!! Roblox rules for paid random items: every outcome and its exact chance must be shown BEFORE
	the purchase, adding up to 100%. The shop builds that list from this file (Crates.Odds), so
	whatever you change here is what players see. Nothing (luck, passes) changes these odds.
]]

local rgb = Color3.fromRGB

export type Reward = {
	Kind: string, -- "Coins" | "SpeedBoost" | "Luck" | "Egg" | "Pet"
	Weight: number,
	Seconds: number?, -- Coins: seconds of income; SpeedBoost / Luck: duration
	Eggs: { { Egg: string, Weight: number } }?,
	Pet: string?,
}

export type Crate = {
	Id: string,
	Name: string,
	Order: number,
	Color: Color3,
	Accent: Color3,
	FoundWeight: number, -- how often this kind shows up in the lane (relative to the others)
	Rewards: { Reward },
}

-- One line of the odds list: what you get, the chance (0-1), and for eggs the chance of each pet.
export type Outcome = { Reward: Reward, Label: string, Chance: number, Egg: string?, Pet: string? }

local Crates = {}

Crates.List = {
	{
		Id = "Common", Name = "Common Crate", Order = 1, Color = rgb(170, 120, 70), Accent = rgb(230, 230, 230), FoundWeight = 75,
		Rewards = {
			{ Kind = "Coins", Weight = 65, Seconds = 600 },
			{ Kind = "Egg", Weight = 35, Eggs = { { Egg = "Sprinkle", Weight = 70 }, { Egg = "Frosted", Weight = 30 } } },
		},
	},
	{
		Id = "Rare", Name = "Rare Crate", Order = 2, Color = rgb(50, 120, 230), Accent = rgb(150, 220, 255), FoundWeight = 20,
		Rewards = {
			{ Kind = "Coins", Weight = 45, Seconds = 1800 },
			{ Kind = "SpeedBoost", Weight = 30, Seconds = 600 },
			{ Kind = "Egg", Weight = 25, Eggs = { { Egg = "Frosted", Weight = 45 }, { Egg = "Molten", Weight = 40 }, { Egg = "Cosmic", Weight = 15 } } },
		},
	},
	{
		Id = "Epic", Name = "Epic Crate", Order = 3, Color = rgb(150, 60, 230), Accent = rgb(255, 150, 255), FoundWeight = 4.5,
		Rewards = {
			{ Kind = "Coins", Weight = 35, Seconds = 5400 },
			{ Kind = "SpeedBoost", Weight = 25, Seconds = 600 },
			{ Kind = "Luck", Weight = 20, Seconds = 600 },
			{ Kind = "Egg", Weight = 20, Eggs = { { Egg = "Cosmic", Weight = 40 }, { Egg = "Tropical", Weight = 35 }, { Egg = "Dream", Weight = 25 } } },
		},
	},
	{
		Id = "Legendary", Name = "Legendary Crate", Order = 4, Color = rgb(255, 190, 30), Accent = rgb(255, 80, 80), FoundWeight = 0.5,
		Rewards = {
			{ Kind = "Coins", Weight = 50, Seconds = 36000 },
			{ Kind = "Egg", Weight = 40, Eggs = { { Egg = "Royal", Weight = 1 } } },
			{ Kind = "Pet", Weight = 10, Pet = "CrateKing" },
		},
	},
} :: { Crate }

Crates.ById = {} :: { [string]: Crate }
for _, crate in Crates.List do
	Crates.ById[crate.Id] = crate
end

local function weightsOf(list: { any }): { number }
	local weights = {}
	for _, entry in list do
		table.insert(weights, entry.Weight :: number)
	end
	return weights
end

local function total(weights: { number }): number
	local sum = 0
	for _, weight in weights do
		sum += weight
	end
	return sum
end

-- Index of a weighted random entry.
local function pickIndex(weights: { number }, rng: Random): number
	local roll = rng:NextNumber() * total(weights)
	for index, weight in weights do
		roll -= weight
		if roll <= 0 then
			return index
		end
	end
	return #weights
end

-- Roll a crate: the reward, plus the egg id for egg rewards.
function Crates.Roll(crate: Crate, rng: Random): (Reward, string?)
	local reward = crate.Rewards[pickIndex(weightsOf(crate.Rewards), rng)]
	local eggs = reward.Eggs
	local eggId = if eggs then eggs[pickIndex(weightsOf(eggs), rng)].Egg else nil
	return reward, eggId
end

-- Roll which kind of crate shows up in the lane.
function Crates.RollFound(rng: Random): Crate
	local weights = {}
	for _, crate in Crates.List do
		table.insert(weights, crate.FoundWeight)
	end
	return Crates.List[pickIndex(weights, rng)]
end

-- Every possible outcome of a crate with its exact chance (eggs are split per egg). Adds up to 1.
function Crates.Odds(crate: Crate): { Outcome }
	local result: { Outcome } = {}
	local sum = total(weightsOf(crate.Rewards))
	for _, reward in crate.Rewards do
		local chance = reward.Weight / sum
		if reward.Eggs then
			local eggs = reward.Eggs
			local eggSum = total(weightsOf(eggs))
			for _, entry in eggs do
				table.insert(result, { Reward = reward, Label = entry.Egg, Chance = chance * entry.Weight / eggSum, Egg = entry.Egg })
			end
		else
			table.insert(result, { Reward = reward, Label = reward.Kind, Chance = chance, Pet = reward.Pet })
		end
	end
	return result
end

return Crates
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">DailyRewards</string>
          <string name="Source"><![CDATA[--[[
	DailyRewards: the rules of the Daily Rewards (Config.DailyRewards), the same on the server, which
	hands them out (server/DailyService), and on your screen (UI/DailyRewards).

	Saved per player: DailyClaims (how many rewards you've claimed, ever) and DailyLastDay (the day
	you claimed the last one). The next reward is Day (DailyClaims % 7) + 1, and it's ready as soon
	as the day has changed since DailyLastDay. So missing days never loses your streak: it just
	waits for you, and your next claim is the next day in the list.

	Days change at midnight on the Eternal Storm's clock (US Pacific, daylight saving included).
]]

local Config = require(script.Parent.Config)
local StormClock = require(script.Parent.StormClock)

local DailyRewards = {}

DailyRewards.Days = Config.DailyRewards.Days

local HOUR, DAY = 3600, 86400

-- Which day it is at Unix time `t` (days since 1970 on the clock).
function DailyRewards.DayNumber(t: number): number
	return math.floor((t + StormClock.Offset(t) * HOUR) / DAY)
end

-- When the next day starts (Unix time), after `t`.
function DailyRewards.NextDayAt(t: number): number
	local day = DailyRewards.DayNumber(t)
	local at = (day + 1) * DAY - StormClock.Offset(t) * HOUR
	-- (the clocks may change between now and midnight: step to the hour where the day really turns)
	if DailyRewards.DayNumber(at) <= day then
		at += HOUR
	elseif DailyRewards.DayNumber(at - HOUR) > day then
		at -= HOUR
	end
	return at
end

-- Which day (1 to 7) is claimed next, after `claims` rewards.
function DailyRewards.NextDay(claims: number): number
	return claims % #DailyRewards.Days + 1
end

-- Can the next reward be claimed at `now`?
function DailyRewards.Ready(lastDay: number, now: number): boolean
	return lastDay < DailyRewards.DayNumber(now)
end

-- What `day` gives in round `round` (0 = the first time through the 7 days). The extra pet slot
-- is only given the first time round: after that its day gives its Instead.
function DailyRewards.Reward(day: number, round: number): Config.DailyReward
	local reward = DailyRewards.Days[day]
	if reward.Kind == "PetSlot" and round > 0 and reward.Instead then
		return reward.Instead
	end
	return reward
end

-- The round the next claim is in, after `claims` rewards.
function DailyRewards.Round(claims: number): number
	return claims // #DailyRewards.Days
end

-- What a Money reward gives when you earn `income` per second.
function DailyRewards.Amount(reward: Config.DailyReward, income: number): number
	return math.max(reward.Min or 0, math.floor(math.max(0, income) * (reward.Minutes or 0) * 60))
end

-- How the 7 days look right now: how many of this round are claimed already, which one can be
-- claimed (nil if none: come back tomorrow) and which round it is.
export type View = { Claimed: number, Claimable: number?, Round: number }
function DailyRewards.View(claims: number, lastDay: number, now: number): View
	if DailyRewards.Ready(lastDay, now) then
		local day = DailyRewards.NextDay(claims)
		return { Claimed = day - 1, Claimable = day, Round = DailyRewards.Round(claims) }
	end
	-- claimed today: every day up to today's stays ticked (all 7 after Day 7) until tomorrow
	if claims <= 0 then
		return { Claimed = 0, Claimable = nil, Round = 0 }
	end
	local today = (claims - 1) % #DailyRewards.Days + 1
	return { Claimed = today, Claimable = nil, Round = DailyRewards.Round(claims - 1) }
end

return DailyRewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">DonutAuras</string>
          <string name="Source"><![CDATA[--[[
	DonutAuras
	==========
	Every Epic-and-up donut gets its OWN signature aura, read from its name, its accessories and the
	biome it comes from - no two rare donuts share the same set of effects.

	  * Its main ELEMENT comes from its name ("Magma..." -> Inferno, "Ghost..." -> Phantom,
	    "...Maximus" -> Power), else its accessories (a halo -> Divine, gears -> Clockwork), else
	    its biome (The Black Hole -> Void). A second element (the next match, or its biome's) mixes
	    in, so two fire donuts still look different.
	  * Each element has its own effects, best first: Inferno has flames, rising embers, bolts from
	    the ground...; Frost has falling snow, snowflakes circling it, a cold haze...
	  * Rarer donuts get more of them: Epic 2, Legendary 3, Celestial 4, Secret and Admin 5, Icon 6.
	    Which of its element's effects it gets, how fast and which way they turn depend on the donut
	    itself, and no two donuts get the same set (each is checked against all the donuts before it).
	  * The anime effects (AnimeFX: power-up auras, toon fire, slashes, kira twinkles, lightning
	    zaps, impact frames, cherry petals) come first in most elements' lists, so every rare donut
	    leads with one.
	  * Common, Uncommon and Rare donuts get a small aura too (1, 2 and 2 light effects: twinkles,
	    petals, snow, bubbles...), still different for every donut, kept soft so a pen full of them
	    doesn't lag or glare.
	  * The colours are the element's, tinted with the donut's own glaze.

	A mutation's effects (FXThemes) are added on top: they show what was rolled. DonutLooks can turn
	a donut's own effects off (Effects = false).

	Pure data: DonutModel (server parts) and client/DonutFX (moving parts) build the same thing.
]]

local Areas = require(script.Parent.Areas)
local FXThemes = require(script.Parent.FXThemes)
local DonutLooks = require(script.Parent.DonutLooks)
local Rarities = require(script.Parent.Rarities)
local Donuts = require(script.Parent.Donuts)

type Theme = FXThemes.Theme

local DonutAuras = {}

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)

type Donut = { Id: string, Name: string, Rarity: string, Area: number, Frosting: Color3, Dough: Color3, Sprinkles: { Color3 }?, Parts: { string } }

-- A move fills in a few theme fields. `i` = intensity (0.6 for Epic ... 1.6 for Icon), `r` = the
-- donut's own random numbers, `c` = the aura's colours.
type Move = (t: Theme, i: number, r: Random, c: { Color3 }) -> ()

local function spin(r: Random): number
	return (if r:NextNumber() < 0.5 then -1 else 1) * r:NextNumber(0.25, 0.6)
end

local Moves: { [string]: Move } = {
	flames = function(t, _i, _r, c)
		t.Flames = { c[2]:Lerp(WHITE, 0.3), c[1], c[3] }
	end,
	aura = function(t, _i, _r, c)
		-- a rising "power up" aura of energy flames in its own colours
		t.Flames = { WHITE, c[1]:Lerp(WHITE, 0.3), c[1] }
	end,
	embers = function(t, i, _r, _c)
		t.Drift = { Mode = "Rise", Rate = 12 * i, Size = 0.22, Texture = "Spark" }
	end,
	snow = function(t, i, _r, _c)
		t.Drift = { Mode = "Fall", Rate = 10 * i, Size = 0.32, Texture = "Spark" }
	end,
	petals = function(t, i, _r, _c)
		t.Drift = { Mode = "Fall", Rate = 7 * i, Size = 0.4, Texture = "Smoke" }
	end,
	feathers = function(t, i, _r, _c)
		t.Drift = { Mode = "Fall", Rate = 4 * i, Size = 0.6, Texture = "Smoke" }
	end,
	bubbles = function(t, i, _r, _c)
		t.Drift = { Mode = "Rise", Rate = 6 * i, Size = 0.45, Texture = "Smoke" }
	end,
	steam = function(t, i, _r, _c)
		t.Drift = { Mode = "Rise", Rate = 3 * i, Size = 1.4, Texture = "Smoke" }
	end,
	confetti = function(t, i, _r, _c)
		t.Drift = { Mode = "Burst", Rate = 14 * i, Size = 0.3, Texture = "Spark" }
	end,
	streaks = function(t, i, _r, _c)
		t.Drift = { Mode = "Streak", Rate = 14 * i, Size = 0.35, Texture = "Spark" }
	end,
	electric = function(t, i, _r, c)
		t.Electric = { Rate = 1.5 * i, Colors = { WHITE, c[1] } }
	end,
	arcs = function(t, i, r, _c)
		t.Lightning = { Min = r:NextNumber(0.8, 1.4) / i, Max = r:NextNumber(2, 3) / i, Mode = "Arc" }
	end,
	strike = function(t, i, r, _c)
		t.Lightning = { Min = r:NextNumber(1.6, 2.4) / i, Max = r:NextNumber(3.5, 5) / i, Mode = "Strike" }
	end,
	rise = function(t, i, r, _c)
		t.Lightning = { Min = r:NextNumber(1, 1.6) / i, Max = r:NextNumber(2.4, 3.4) / i, Mode = "Rise" }
	end,
	shockwave = function(t, i, r, _c)
		t.Shockwave = { Min = r:NextNumber(2.5, 3.5) / i, Max = r:NextNumber(4.5, 6) / i }
	end,
	swirl = function(t)
		t.Swirl = true
	end,
	smoke = function(t, _i, _r, c)
		t.Smoke = c[3]:Lerp(rgb(0, 0, 0), 0.5)
	end,
	shards = function(t, i, _r, c)
		t.Shards = { Count = math.max(3, math.round(6 * i)), Colors = { c[1], c[2], c[3] } }
	end,
	runes = function(t)
		t.Runes = true
	end,
	wisps = function(t, i)
		t.Wisps = math.max(2, math.round(3 * i))
	end,
	rays = function(t, _i, r, _c)
		t.Rays = { Count = 8 + 2 * r:NextInteger(0, 2), Length = r:NextNumber(4, 5.4), Spin = spin(r) }
	end,
	godrays = function(t)
		t.GodRays = true
	end,
	stars = function(t, i, r, _c)
		t.Stars = { Rate = 9 * i, Radius = r:NextNumber(3, 4) }
	end,
	vortex = function(t, i, r, _c)
		t.Vortex = { Rate = 18 * i, Radius = r:NextNumber(3, 3.8) }
	end,
	glitter = function(t, i, r, _c)
		t.Glitter = { Rate = 14 * i, Radius = r:NextNumber(2.6, 3.4) }
	end,
	mist = function(t, _i, _r, c)
		t.Mist = c[1]
	end,
	crystals = function(t)
		t.Crystals = true
	end,
	galaxy = function(t)
		t.Tint = "Galaxy"
	end,
	-- the anime ones (AnimeFX)
	kiaura = function(t, i, _r, _c)
		t.Ki = { Size = 3 + 1.1 * i, Rate = 12 + 10 * i }
	end,
	toonfire = function(t, _i, _r, c)
		t.ToonFire = { c[1]:Lerp(WHITE, 0.35), c[1], c[3] }
	end,
	slashes = function(t, i, _r, _c)
		t.Slashes = { Rate = 2.2 * i }
	end,
	kira = function(t, i, _r, _c)
		t.Kira = { Rate = 5 * i }
	end,
	zaps = function(t, i, _r, _c)
		t.Zaps = { Rate = 7 * i }
	end,
	impact = function(t, i, r, _c)
		t.Impact = { Min = r:NextNumber(2.5, 3.5) / i, Max = r:NextNumber(5, 7) / i }
	end,
	sakura = function(t, i, _r, _c)
		t.Drift = { Mode = "Fall", Rate = 6 * i, Size = 0.38, Texture = "Petal" }
	end,
	rainbow = function(t)
		t.Tint = "Rainbow"
	end,
}
for _, shape in { "Heart", "Star", "Coin", "Bubble", "Cube", "Note", "Leaf", "Snowflake", "Gear", "Bolt", "Feather" } do
	Moves["orbit" .. shape] = function(t, i)
		t.Orbiters = { Shape = shape, Count = math.max(3, math.round(5 * i)) }
	end
end

-- The field each move fills (a donut never gets two moves that fill the same one).
local function field(move: string): string
	if string.sub(move, 1, 5) == "orbit" then
		return "Orbiters"
	end
	local fields = {
		flames = "Flames", aura = "Flames", embers = "Drift", snow = "Drift", petals = "Drift", feathers = "Drift",
		bubbles = "Drift", steam = "Drift", confetti = "Drift", streaks = "Drift", arcs = "Lightning",
		strike = "Lightning", rise = "Lightning", galaxy = "Tint", rainbow = "Tint", kiaura = "Ki",
		toonfire = "Flames", sakura = "Drift",
	}
	return fields[move] or move
end

export type Element = {
	Id: string,
	Keys: { string }, -- name keywords (the start of a word)
	Parts: { string }, -- accessories that bring it
	Biomes: { string }, -- biome themes that bring it
	Colors: { Color3 },
	Pulse: string,
	Moves: { string }, -- best first
	Drift: { Color3 }?, -- the drifting particles' colours (default: the aura's)
}

-- In order: the first one a name matches is its main element.
