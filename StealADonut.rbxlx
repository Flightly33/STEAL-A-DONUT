	{ Id = "MagmaHound", Name = "Magma Hound", Rarity = "Rare", Money = 0.2, Speed = 0, Shape = "Quad", Body = rgb(60, 40, 40), Accent = rgb(255, 110, 0), Features = { "PointyEars", "Tail", "Flames", "Glow" } },
